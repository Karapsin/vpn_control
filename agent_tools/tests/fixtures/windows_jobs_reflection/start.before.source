$process=$arguments[9]
try{
 $childPid=[int]$processType.GetField('Pid').GetValue($process)
 $launch=[Collections.Generic.Dictionary[string,object]]::new();foreach($key in @('operationId','machine','boot','rootGeneration','parentPid','parentBirth')){$launch[$key]=$intent[$key]}
 $launch['childPid']=$childPid;$launch['childBirth']=N 'Birth' @($childPid);$launch['flags']=[uint32]0x08000000;$launch['inheritHandles']=$false
 [void](N 'Write' @((Join-Path $c.root 'launch.json'),$launch))
}finally{
 [void](N 'CloseHandle' @($processType.GetField('Thread').GetValue($process)))
 [void](N 'CloseHandle' @($processType.GetField('Process').GetValue($process)))
}
$out=@{schemaVersion=1;state='submitted';operationId=$c.operationId;machine=$c.machine;boot=$c.boot;root=$c.root;rootGeneration=$c.rootGeneration;parentPid=$c.parentPid;parentBirth=$c.parentBirth;childPid=$childPid;childBirth=$launch['childBirth'];flags=[uint32]0x08000000;inheritHandles=$false;replayAllowed=$false}
[Console]::WriteLine(($out|ConvertTo-Json -Depth 6 -Compress))
