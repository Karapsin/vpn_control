$ErrorActionPreference='Stop';$ProgressPreference='SilentlyContinue';[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false)

function Read-ProgramBootstrap {
 $os=Get-CimInstance Win32_OperatingSystem;$self=Get-Process -Id $PID;$machine=(Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Cryptography' -Name MachineGuid).MachineGuid;$hardware=(Get-CimInstance Win32_ComputerSystemProduct).UUID;$identity=[Security.Principal.WindowsIdentity]::GetCurrent()
 try{return [ordered]@{pid=$PID;birthFileTimeUtc=$self.StartTime.ToUniversalTime().ToFileTimeUtc().ToString([Globalization.CultureInfo]::InvariantCulture);sessionId=$self.SessionId;path=$self.Path;principalSid=$identity.User.Value;is64BitProcess=[Environment]::Is64BitProcess;powerShellMajor=$PSVersionTable.PSVersion.Major;powerShellEdition=$PSVersionTable.PSEdition;boot=[ordered]@{lastBootUpTimeFileTimeUtc=$os.LastBootUpTime.ToUniversalTime().ToFileTimeUtc().ToString([Globalization.CultureInfo]::InvariantCulture);machineGuid=[string]$machine;hardwareUuid=[string]$hardware}}}finally{$identity.Dispose()}
}
$expectedBoot='134368653065000000';$expectedMachine='7b109066-c50e-4138-8969-f83555499b60';$expectedHardware='D493A373-1D2C-4AB0-BFD4-E93575019DCE';$expectedPowerShell='C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'

$bootstrapOpening=Read-ProgramBootstrap
if($bootstrapOpening.boot.lastBootUpTimeFileTimeUtc -cne $expectedBoot -or $bootstrapOpening.boot.machineGuid -cne $expectedMachine -or $bootstrapOpening.boot.hardwareUuid -cne $expectedHardware -or $bootstrapOpening.path -cne $expectedPowerShell -or $bootstrapOpening.sessionId -ne 0 -or $bootstrapOpening.principalSid -cne 'S-1-5-18' -or -not $bootstrapOpening.is64BitProcess -or $bootstrapOpening.powerShellMajor -ne 5 -or $bootstrapOpening.powerShellEdition -cne 'Desktop'){[Console]::WriteLine((@{state='refused-before-file-effects';code='GUEST_BOOT_OR_ACTOR_MISMATCH';fileEffects=$false;bootstrapOpening=$bootstrapOpening;expectedBoot=$expectedBoot;productOperation=$false;taskOperation=$false}|ConvertTo-Json -Depth 8 -Compress));exit 3}
