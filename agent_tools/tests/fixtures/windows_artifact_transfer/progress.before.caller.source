def call(sock, command, args, _deadline=None):
    received = bytearray()
    primary = None
    deadline = min(time.monotonic() + 20, _deadline) if _deadline is not None else time.monotonic() + 20
    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)

    def budget():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError('collection-deadline')
        c.settimeout(min(20, remaining))

    def receive():
        budget()
        return c.recv(1)

    def send(data):
        budget()
        c.sendall(data)
    try:
        budget()
        c.connect(sock)
        peer = struct.unpack('3i', c.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if peer[:2] != (QGA_PEER_PID, os.geteuid()):
            raise ValueError('instance_qga_peer')
