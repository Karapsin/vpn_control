def _enter_phase_program(record,typed):
    if typed.get('state')!='observed'or typed.get('qemu')!=record['result']['qemu']:raise ValueError('login-typed-prior')
    answer=typed['facts'];view=dict(answer);view['facts']={k:v for k,v in answer['facts'].items()if k!='providerWrite'};role.validate_semantic(view)
    if answer['facts'].get('providerWrite')!={'cleared':True,'typed':True,'contentRead':False,'credentialLogged':False}or len(view['facts']['secureInput']['nodes'])!=5 or answer['reader']['nonce']!=NONCE or answer['reader']['sourceSha256']!=CHILD_SHA:raise ValueError('login-typed-proof')
    prior={'reader':answer['reader'],'roles':[n['runtimeId']for n in view['facts']['secureInput']['nodes']],'qemu':typed['qemu'],'writeSourceSha256':PARENT_SHA}
    source,sha=_readonly_phase_program(record,'enter');marker='\ntry:\n children='
    if source.count(marker)!=1:raise ValueError('login-enter-source-placement')
    source=source.replace(marker,'\nFLOW='+repr(LOGIN_FLOW)+'\nTRANSFER='+repr(login.TRANSFER)+'\nPRIOR='+repr(prior)+'\n'+inspect.getsource(login.validate_ppm)+inspect.getsource(_submit_role_gate)+inspect.getsource(_remote_submit)+marker)
    launch=" guards();child=call(LEAF+'/qga.sock','guest-exec',"
    if source.count(launch)!=1:raise ValueError('login-enter-reader-placement')
    source=source.replace(launch," guards();focus_started=time.monotonic();child=call(LEAF+'/qga.sock','guest-exec',")
    result=" result({'state':'observed','facts':answer,'qemu':children[1]['child'],'guestChildPid':pid,'appAdmission':False,'installerAction':False})"
    if source.count(result)!=1:raise ValueError('login-enter-terminal-placement')
    source=source.replace(result,' result(_remote_submit(answer,focus_started,PRIOR))')
    source=source.replace("'installerAction':False,'replayAllowed':False})","'installerAction':False,'replayAllowed':False,'frameAuthority':getattr(e,'frameAuthority',None)})")
    compile(source,'fixed-provider-login-submit','exec');return source,sha

_PIPE_PROOF_LEAF='windows-cp117-provider-pipe-derived-proof-7449'
_PIPE_PROOF_PIN={'sha256':'ed13d5c833628dcca8efc41033ece66ca74b6bfa6171e75ea7e85ef65fa430ad','generation':[16777234,112807106,33152,503,20,1,5736,1791137465368652223,1791137465368652223]}

def start(root):
    """One complete fixed login attempt; every partial/unknown stops the flow."""
    root=Path(root).resolve(strict=True);leaf='windows-cp117-provider-login-'+LOGIN_FLOW;r=login.guest.recovery
    if(root/'.runtime/parity-evidence'/leaf).exists():return {'state':'unknown','phase':'provider-login-consumed','replayAllowed':False}
    (root/'.runtime/parity-evidence'/leaf).mkdir(mode=0o700);capture=AuthorityCapture(root,leaf);original=AuthorityCapture(root,'windows-cp117-recovery-'+r.CORRELATION);inert=AuthorityCapture(root,_PIPE_PROOF_LEAF);secret=b'';events=[]
    try:
        raw=r._local_read(original,login.guest.ORIGINAL['name'],login.guest.ORIGINAL['pin']);record=json.loads(raw)
        inert_raw=r._local_read(inert,'proof.json',_PIPE_PROOF_PIN);proof=json.loads(inert_raw)
        expected={'version':1,'originalStdinPipe':True,'publicFramesPassed':True,'providerCompiled':True,'credentialInput':False,'providerInvoked':False,'keyboardAction':False}
        if proof['state']!='derived' or proof['originalNativeFacts']['facts']!=expected or proof['currentVmAdmission']is not False or proof['inputAdmission']is not False or proof['originalUnknownPreserved']is not True:raise ValueError('login-pipe-proof')
        modules=(role,geometry,owner_reader,role.original_semantic,role.secure,login,login.guest,login.session,r,r.authority,r.authority.closure,r.authority.closure.base)
        pins={str(Path(module.__file__)):r.authority._read_bound_file(Path(module.__file__))for module in modules};own=r.authority._read_bound_file(Path(__file__));outer=r.authority._outer_authority(root)
        secret,credential_path,credential_pin=login._configured_secret(root);validate_secret(secret)
        execution_sources=_execution_source_proof(root,record)
        config,target,_=r.authority.closure.base._descriptor(root)
        if str(target.fixture_transfer_root)!=login.TRANSFER:raise ValueError('login-transfer-root')
        typed_bytes=None;typed_pin=None
        def verify():
            _sources();_wake_check_factories()
            if r.authority._read_bound_file(Path(__file__))!=own or any(r.authority._read_bound_file(Path(path))!=pin for path,pin in pins.items()):raise ValueError('login-source-generation')
            if r._local_read(original,login.guest.ORIGINAL['name'],login.guest.ORIGINAL['pin'])!=raw or r._local_read(inert,'proof.json',_PIPE_PROOF_PIN)!=inert_raw:raise ValueError('login-original-proof-drift')
            for i,item in enumerate(record['authority']):
                r._validate_frame(item['frame'],record['request'],record['authority'][:i])
                if json.loads(r._local_read(original,'authority-%d.json'%i,item['localPin']))!=item['frame']:raise ValueError('login-original-frame')
            if _execution_source_proof(root,record)!=execution_sources:raise ValueError('login-execution-source-drift')
            if r.authority._read_bound_file(credential_path)!=credential_pin:raise ValueError('login-credential-generation')
            r.authority._verify_outer(root,{'outerAuthority':outer})
            if typed_pin is not None and r._local_read(capture,'write-result.json',typed_pin)!=typed_bytes:raise ValueError('login-typed-local-authority')
        verify();capture.create('intent.json',json.dumps({'state':'consumed','flow':LOGIN_FLOW,'original':login.guest.ORIGINAL,'source':own,'sources':pins,'outerAuthority':outer,'credentialGeneration':credential_pin['generation'],'historicalPipeProof':_PIPE_PROOF_PIN,'executionSourceProof':execution_sources,'installerAction':False},sort_keys=True).encode());os.fsync(capture.fd)
        def retain(name,value):capture.create(name+'-result.json',json.dumps(value,sort_keys=True).encode());os.fsync(capture.fd)
        def dispatch(name,source,sha,correlation,nonce,private=None):
            verify();capture.create(name+'-remote.py',source.encode());capture.create(name+'-request.json',json.dumps({'flow':LOGIN_FLOW,'diagnosticId':correlation,'nonce':nonce,'sourceSha256':sha,'programSha256':hashlib.sha256(source.encode()).hexdigest(),'original':login.guest.ORIGINAL},sort_keys=True).encode());os.fsync(capture.fd)
            argv=r.authority.closure.base.ssh_transport.build_ssh_argv(config,r.HOST,60,command=r.authority.closure.base.windows_credential_probe_ssh._remote_command(source))
            capture.create(name+'-attempt.json',json.dumps({'state':'consumed','flow':LOGIN_FLOW,'phase':name,'diagnosticId':correlation,'nonce':nonce},sort_keys=True).encode());os.fsync(capture.fd);verify()
            value,current_events=_stream(argv,capture,correlation,nonce,sha,record['result']['qemu'],private);events.extend(current_events);verify();return value
        def read(slot):
            source,sha=_readonly_phase_program(record,slot);correlation,nonce=_LOGIN_SLOTS[slot];value=dispatch(slot,source,sha,correlation,nonce);return {'value':value,'observedAtNs':time.time_ns()}
        def auth():
            source,sha,bootstrap_pins=_credential_phase_program(root,record)
            for path,pin in bootstrap_pins.items():
                if r.authority._read_bound_file(Path(path))!=pin:raise ValueError('login-auth-bootstrap')
            value=dispatch('auth',source,sha,AUTH_CORRELATION,AUTH_NONCE,secret)
            for path,pin in bootstrap_pins.items():
                if r.authority._read_bound_file(Path(path))!=pin:raise ValueError('login-auth-bootstrap-drift')
            return value
        def prepare():
            first=read('before1');retain('before1',first)
            if first['value'].get('state')!='observed':raise ValueError('login-before-unknown')
            geometry.validate_semantic(first['value']['facts']);nodes=first['value']['facts']['facts']['secureInput']['nodes']
            if any(n['controlId']==50004 for n in nodes):return {'state':'observed','qemu':record['result']['qemu'],'clockDismissed':False}
            second=read('before2');retain('before2',second);_admit_pair(first,second,time.time_ns());verify();source=_wake_program(record,second)
            capture.create('wake-remote.py',source.encode());capture.create('wake-attempt.json',json.dumps({'state':'consumed','flow':LOGIN_FLOW,'sourceSha256':hashlib.sha256(source.encode()).hexdigest()},sort_keys=True).encode());os.fsync(capture.fd);verify()
            argv=r.authority.closure.base.ssh_transport.build_ssh_argv(config,r.HOST,60,command=r.authority.closure.base.windows_credential_probe_ssh._remote_command(source))
            import subprocess
            try:completed=subprocess.run(argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=60,check=False)
            except subprocess.TimeoutExpired as error:
                capture.create('wake-stdout-partial',(error.stdout or b'')[:1000000]);capture.create('wake-stderr-partial',(error.stderr or b'')[:131072]);os.fsync(capture.fd);raise ValueError('login-wake-unknown')from None
            capture.create('wake-stdout.private',completed.stdout[:1000000]);capture.create('wake-stderr.private',completed.stderr[:131072]);os.fsync(capture.fd);verify()
            if completed.returncode!=0 or len(completed.stdout)>1000000 or len(completed.stderr)>131072:raise ValueError('login-wake-transport')
            value=json.loads(completed.stdout)
            if value.get('state')!='observed' or value.get('qemu')!=record['result']['qemu']:raise ValueError('login-wake-result')
            _wake_frame_authority(value,record['result']['qemu']);retain('wake',value);return {'state':'observed','qemu':record['result']['qemu'],'clockDismissed':True}
        def write():
            source,sha=program(record);return dispatch('write',source,sha,CORRELATION,NONCE,secret)
        def retained(name,value):
            nonlocal typed_bytes,typed_pin
            rawvalue=json.dumps(value,sort_keys=True).encode();pin=capture.create(name+'-result.json',rawvalue);os.fsync(capture.fd)
            if name=='write':typed_bytes=rawvalue;typed_pin=pin
        def submit(typed):
            verify()
            if r._local_read(capture,'write-result.json',typed_pin)!=typed_bytes:raise ValueError('login-typed-local-authority')
            source,sha=_enter_phase_program(record,typed);correlation,nonce=_LOGIN_SLOTS['enter'];return dispatch('enter',source,sha,correlation,nonce)
        def owner():return read('owner')['value']
        value=_login_sequence(auth,prepare,write,submit,owner,retained,record['result']['qemu']);verify();pin=capture.create('result.json',json.dumps({'result':value,'events':events},sort_keys=True).encode());os.fsync(capture.fd)
        return dict(value,evidenceLeaf=leaf,receipt=pin)
    except Exception as error:
        events.extend(getattr(error,'events',[]));pin=capture.create('unknown.json',json.dumps({'state':'unknown','phase':str(error)if isinstance(error,ValueError)else type(error).__name__,'events':events},sort_keys=True).encode());os.fsync(capture.fd)
        return {'state':'unknown','phase':str(error)if isinstance(error,ValueError)else type(error).__name__,'evidenceLeaf':leaf,'receipt':pin,'replayAllowed':False,'installerAction':False}
    finally:secret=b'';inert.close();original.close();capture.close()

_COMPAT_SOURCES={'base': {'archive': '.runtime/parity-evidence/windows-fcntl-import-pre-fix-22628997-f3b9-41fe-9e71-9540aa95ccde/windows_msi_base_prepare.py', 'originalPin': {'sha256': 'da3862602d906cb6146ce351fb2c3ee8697e82506f4253e39085263aecf3c9d3', 'generation': [16777234, 112808632, 33152, 503, 20, 1, 199991, 1790996685619880868, 1791138186684841952]}, 'currentSha256': '5d06ef745bbaba0208f08907a9b1c8ed7a3c8c549a940ecf5a4f127744d47cb7', 'currentPath': 'agent_tools/windows_msi_base_prepare.py'}, 'recovery': {'archive': '.runtime/parity-evidence/windows-fcntl-import-pre-fix-22628997-f3b9-41fe-9e71-9540aa95ccde/windows_cp117_fixture_recovery_short_socket.py', 'originalPin': {'sha256': '51538dad4c2fa6591384081f5a0aabacada1e752c1afd6a6ed50ebed9596663e', 'generation': [16777234, 112808633, 33152, 503, 20, 1, 42086, 1791038806867426589, 1791138186685006991]}, 'currentSha256': '55b562ef9d3c1ac4315b64d8838d500c6975073cf27ee29bdbb0faa779ec00bc', 'currentPath': 'agent_tools/windows_cp117_fixture_recovery_short_socket.py'}, 'lease': {'archive': '.runtime/parity-evidence/windows-lease-fcntl-pre-fix-b4b55214-f1a6-4980-a7eb-af1f19af4e35/windows_cp117_lease.py', 'originalPin': {'sha256': '720c74fc03b945155377741431218661cf855ea78ff64731d13e2bdb5dde1cbe', 'generation': [16777234, 112810428, 33152, 503, 20, 1, 33256, 1790760962063288020, 1791138426638777955]}, 'currentSha256': '2b0e6fc1727377b7bdefc7c17c4385f617f1f52563c0356b7da670dc8235944b', 'currentPath': 'agent_tools/windows_cp117_lease.py'}, 'completion': {'archive': '.runtime/parity-evidence/bound-absence-default-pre-fix-f388436e-8301-40fd-936d-398a8978597d/windows_cp117_bound_absence_completion.py', 'originalPin': {'sha256': 'ed85cff600d3b33c4aed37927df1d1b5c62fba660b24d5a46b804b9dfe46b939', 'generation': [16777234, 112810850, 33152, 503, 20, 1, 42842, 1791015453576787313, 1791139003610668422]}, 'currentSha256': '48234c12de9d48e61919fa981daacd03bf681ce56348bae2f381e9ab84b15ee0', 'currentPath': 'agent_tools/windows_cp117_bound_absence_completion.py'}}


def _compatibility_ast(profile,original_bytes,current_bytes):
    """Closed four-file import-only compatibility; native literals stay exact."""
    if profile not in _COMPAT_SOURCES:raise ValueError('login-compatibility-profile')
    old=ast.parse(original_bytes.decode('utf-8',errors='strict'));new=ast.parse(current_bytes.decode('utf-8',errors='strict'))
    if profile in('base','recovery','lease'):
        functions={'base':('_reserve','WindowsMsiBasePrepareError','Base preparation requires POSIX locking.'),'recovery':('_claim','RecoveryUnknown','posix-locking-unsupported'),'lease':('_locked','Cp117LeaseError','CP117 campaign locking is unsupported.')}
        name,error,message=functions[profile]
        imports=[n for n in old.body if isinstance(n,ast.Import)and any(a.name=='fcntl'for a in n.names)]
        if len(imports)!=1:raise ValueError('login-compatibility-original-import')
        importnode=imports[0];importnode.names=[a for a in importnode.names if a.name!='fcntl']
        if not importnode.names:old.body.remove(importnode)
        targets=[n for n in new.body if isinstance(n,ast.FunctionDef)and n.name==name]
        expected=ast.parse('try:\n import fcntl\nexcept ModuleNotFoundError as exc:\n raise '+error+'('+repr(message)+') from exc').body[0]
        if len(targets)!=1 or not targets[0].body or ast.dump(targets[0].body[0])!=ast.dump(expected):raise ValueError('login-compatibility-exact-lazy-import')
        targets[0].body.pop(0)
    else:
        oldfn=[n for n in old.body if isinstance(n,ast.FunctionDef)and n.name=='_readonly_unknown_archive'];newfn=[n for n in new.body if isinstance(n,ast.FunctionDef)and n.name=='_readonly_unknown_archive']
        if len(oldfn)!=1 or len(newfn)!=1:raise ValueError('login-compatibility-default-function')
        oldfn=oldfn[0];newfn=newfn[0]
        if len(oldfn.args.defaults)!=1 or len(newfn.args.defaults)!=1 or not isinstance(newfn.args.defaults[0],ast.Constant)or newfn.args.defaults[0].value is not None:raise ValueError('login-compatibility-default')
        newfn.args.defaults[0]=oldfn.args.defaults[0]
        expected1=ast.parse('if base is None:\n return False').body[0]
        expected2=ast.parse('if correlation is None:\n correlation=base._UNKNOWN_CLOSURE_CORRELATION').body[0]
        indexes=[]
        for expected in(expected1,expected2):
            matches=[i for i,node in enumerate(newfn.body)if ast.dump(node)==ast.dump(expected)]
            if len(matches)!=1:raise ValueError('login-compatibility-deferred-default')
            indexes.extend(matches)
        for index in sorted(indexes,reverse=True):newfn.body.pop(index)
    if ast.dump(old)!=ast.dump(new):raise ValueError('login-compatibility-unexpected-change')
    # Equality after only approved import/refusal normalization also preserves
    # every embedded PS/native/remote literal, not merely public function names.
    return {'profile':profile,'nativeLiteralContinuity':True,'effectPredicateContinuity':True,'historicalSourceDifferent':True}


def _execution_source_proof(root,record):
    r=login.guest.recovery;historical=record['request']['sources'];current={};proofs={};archives={}
    for key,profile in _COMPAT_SOURCES.items():
        path=root/profile['archive'];pin,old=r.authority._read_bound_file(path,private=True,retain_bytes=True)
        if pin!=profile['originalPin']:raise ValueError('login-compatibility-original-authority')
        now,new=r.authority._read_bound_file(root/profile['currentPath'],retain_bytes=True)
        if now['sha256']!=profile['currentSha256']:raise ValueError('login-compatibility-current-authority')
        if key in historical and historical[key]['sha256']!=pin['sha256']:raise ValueError('login-compatibility-historical-source')
        proofs[key]=_compatibility_ast(key,old,new);current[key]=now;archives[key]=pin
        if r.authority._read_bound_file(path,private=True)!=pin or r.authority._read_bound_file(root/profile['currentPath'])!=now:raise ValueError('login-compatibility-source-drift')
    unchanged={'closure':Path(r.authority.closure.__file__),'capture':root/'agent_tools/windows_diagnostic_authority_capture.py','consumedIntent':root/r.authority.closure._DIR/'intent.json'}
    for key,path in unchanged.items():
        pin=r.authority._read_bound_file(path,private=key=='consumedIntent')
        if pin!=historical[key]:raise ValueError('login-original-unchanged-source')
        current[key]=pin
    if set(historical)!=set(current)-{'lease'}:raise ValueError('login-historical-source-keys')
    return {'historicalVmSources':historical,'currentExecutingSources':current,'originalArchives':archives,'compatibility':proofs,'historicalVmAuthorityRewritten':False}
