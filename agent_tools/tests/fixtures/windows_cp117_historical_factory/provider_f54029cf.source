def _fixed_slot_bodies(slot):
    if slot not in('before1','before2','enter'):raise ValueError('login-read-slot')
    reader=role if slot=='enter'else geometry;expected=ROLE_SHA if reader is role else GEOMETRY_SHA
    pin,raw=login.guest.recovery.authority._read_bound_file(Path(reader.__file__),retain_bytes=True)
    if pin['sha256']!=expected:raise ValueError('login-read-source')
    nodes=[n for n in ast.parse(raw.decode()).body if isinstance(n,ast.FunctionDef)and n.name=='bodies']
    if len(nodes)!=1:raise ValueError('login-read-factory')
    node=nodes[0]
    # The prior source comparison pertains to the old correlation. Preserve
    # every prior factory/privilege/cap check; fixed new render hashes are checked
    # by this new catalog before any native dispatch.
    last=node.body[-2]
    if not isinstance(last,ast.If)or ast.unparse(last.test)!="sha != CHILD_SHA or hashlib.sha256(parent.encode('utf-16le')).hexdigest() != PARENT_SHA":raise ValueError('login-read-final-source-guard')
    node.body.pop(-2);namespace=dict(vars(reader));namespace['CORRELATION'],namespace['NONCE']=_LOGIN_SLOTS[slot]
    exec(compile(ast.Module([node],type_ignores=[]),'fixed-new-login-reader','exec'),namespace)
    answer=namespace['bodies']()
    if login.guest.recovery.authority._read_bound_file(Path(reader.__file__))!=pin:raise ValueError('login-read-source-drift')
    return answer


def _readonly_phase_program(record,slot):
    if slot not in _LOGIN_SLOTS:raise ValueError('login-fixed-read-phase')
    correlation,nonce=_LOGIN_SLOTS[slot]
    if slot=='owner':
        if login.guest.recovery.authority._read_bound_file(Path(owner_reader.__file__))['sha256']!=OWNER_SHA:raise ValueError('login-owner-source')
        source,sha=owner_reader.program(record);source=source.replace(owner_reader.CORRELATION,correlation).replace(owner_reader.NONCE,nonce)
        tree=ast.parse(source);encoded=next(ast.literal_eval(n.value)for n in tree.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='ENCODED'for t in n.targets))
        plain=base64.b64decode(encoded).decode('utf-16le');new=plain.replace(owner_reader.NONCE,nonce)
        if new==plain:raise ValueError('login-owner-header')
        source=source.replace(repr(encoded),repr(base64.b64encode(new.encode('utf-16le')).decode()));compile(source,'fixed-new-owner-reader','exec');return source,sha
    reader=role if slot=='enter'else geometry
    parent,child,childsha=_fixed_slot_bodies(slot);sha=hashlib.sha256(parent.encode('utf-16le')).hexdigest()
    if (sha,childsha)!=_READ_PHASE_HASHES.get(slot):raise ValueError('login-read-rendered-catalog')
    source,_=reader.program(record);oldparent,oldchild,oldchildsha=reader.bodies()
    tree=ast.parse(source);encoded=next(ast.literal_eval(n.value)for n in tree.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='ENCODED'for t in n.targets))
    bootstrap=base64.b64decode(encoded).decode('utf-16le').replace(reader.NONCE,nonce).replace(reader.PARENT_SHA,sha)
    oldinput=base64.b64encode(len(oldparent.encode()).to_bytes(4,'big')+oldparent.encode()).decode();newinput=base64.b64encode(len(parent.encode()).to_bytes(4,'big')+parent.encode()).decode()
    replacements={'D='+repr(reader.CORRELATION):'D='+repr(correlation),'NONCE='+repr(reader.NONCE):'NONCE='+repr(nonce),'BODY_SHA='+repr(reader.PARENT_SHA):'BODY_SHA='+repr(sha),'CHILD_SHA='+repr(oldchildsha):'CHILD_SHA='+repr(childsha),'ENCODED='+repr(encoded):'ENCODED='+repr(base64.b64encode(bootstrap.encode('utf-16le')).decode()),repr(oldinput):repr(newinput)}
    for old,new in replacements.items():
        if source.count(old)!=1:raise ValueError('login-read-rebind-factory')
        source=source.replace(old,new)
    compile(source,'fixed-new-login-read-phase','exec');return source,sha


