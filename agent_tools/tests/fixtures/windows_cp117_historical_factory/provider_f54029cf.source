        _submit_role_gate(current,prior,time.monotonic()-focus_started);need(0<=time.monotonic()-sampled<=5,'login-enter-frame-expired');guard()
        command('send-key',{'keys':[{'type':'qcode','data':'ret'}],'hold-time':100})
