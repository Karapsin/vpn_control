SECURE_SHA='bbcb1de84c89b44d7e541a35a2634ba0cf644e89f5cef7d9061e3a33e6499782'
login=role.login
CORRELATION='ab9a3ed5-b49f-4b4f-8efb-2f590fb0370d'
NONCE='7a12a8bd-c74e-4509-8f06-4fc5407bda1a'
INERT_CORRELATION='74494867-a46a-4b2d-af11-853c69aef984'
INERT_NONCE='e83751d5-9471-41d9-980b-cbb8a24a473a'
PUBLIC_SENTINEL=b'CP117-PUBLIC-INERT-PIPE'

_DUPLICATE_CS=r'''
 [DllImport("kernel32.dll",SetLastError=true)] static extern IntPtr GetStdHandle(int kind);
 [DllImport("kernel32.dll",SetLastError=true)] static extern uint GetFileType(IntPtr handle);
 [DllImport("kernel32.dll",SetLastError=true)] static extern bool DuplicateHandle(IntPtr source,IntPtr input,IntPtr target,out IntPtr duplicate,uint access,bool inherit,uint options);
 static bool inputDuplicated;
 public static long DuplicateInput(PI p,string birth){lock(ownership){
  Held(p);if(expired||inputDuplicated)throw new InvalidOperationException("PROVIDER_INPUT_CONSUMED");
  if(Session(p)!=1||Birth(p)!=birth)throw new InvalidOperationException("PROVIDER_INPUT_CHILD");
  IntPtr input=GetStdHandle(-10);if(input==IntPtr.Zero||input==new IntPtr(-1)||GetFileType(input)!=3)throw new InvalidOperationException("PROVIDER_INPUT_PIPE");
  inputDuplicated=true;IntPtr duplicate;
  if(!DuplicateHandle(GetCurrentProcess(),input,p.process,out duplicate,0,false,2))throw new InvalidOperationException("PROVIDER_INPUT_DUPLICATE");
  if(duplicate==IntPtr.Zero||duplicate==new IntPtr(-1)||Birth(p)!=birth||GetStdHandle(-10)!=input||GetFileType(input)!=3)throw new InvalidOperationException("PROVIDER_INPUT_CHANGED");
  return duplicate.ToInt64();
 }}
'''


def _sources():
    if hashlib.sha256(Path(role.__file__).read_bytes()).hexdigest()!=ROLE_SHA or hashlib.sha256(Path(role.secure.__file__).read_bytes()).hexdigest()!=SECURE_SHA:raise ValueError('provider-source')
    role._factories()


def native_source():
    _sources();source=role.secure._NATIVE
    marker=' public static PI Suspended(string application,string encoded,string directory) {'
    if source.count(marker)!=1:raise ValueError('provider-native-factory')
    source=source.replace(marker,_DUPLICATE_CS+'\n'+marker)
    # The new class remains a fixed derivative; original watchdog/Held/Birth and
    # cleanup predicates are byte-identical. No inherited generic handles.
    if 'IntPtr.Zero,false,0x08000004'not in source:raise ValueError('provider-no-inheritance')
    return source


def validate_secret(secret):
    """Validate bounded framed input internally without publishing its length."""
    if not isinstance(secret,bytes)or not 1<=len(secret)<=512:raise ValueError('provider-private-input')
    try:value=secret.decode('utf-8',errors='strict')
    except UnicodeError:raise ValueError('provider-private-input')from None
    if '\0'in value:raise ValueError('provider-private-input')
    return secret


def private_stdin(parent,secret):
    """Only used at dispatch; never part of a retained source/request record."""
    validate_secret(secret);return _public_frames(parent)+len(secret).to_bytes(4,'big')+secret

_INPUT_CS='using System;using System.IO;using System.Runtime.InteropServices;using System.Text;using Microsoft.Win32.SafeHandles;public static class CP117OriginalInput{\n [DllImport("kernel32.dll",SetLastError=true)] static extern uint GetFileType(IntPtr handle);\n public static Stream Open(long number){if(number<=0)throw new InvalidOperationException("PROVIDER_INPUT_HANDLE");IntPtr handle=new IntPtr(number);if(GetFileType(handle)!=3)throw new InvalidOperationException("PROVIDER_INPUT_PIPE");return new FileStream(new SafeFileHandle(handle,true),FileAccess.Read);}\n public static byte[] ReadSecret(Stream file){try{\n  int count=0;for(int i=0;i<4;i++){int b=file.ReadByte();if(b<0)throw new InvalidOperationException("PROVIDER_INPUT_SHORT");count=checked(count*256+b);}if(count<1||count>512)throw new InvalidOperationException("PROVIDER_INPUT_BOUND");\n  byte[] bytes=new byte[count];try{int offset=0;while(offset<count){int n=file.Read(bytes,offset,count-offset);if(n<=0)throw new InvalidOperationException("PROVIDER_INPUT_SHORT");offset+=n;}if(file.ReadByte()!=-1)throw new InvalidOperationException("PROVIDER_INPUT_TRAILING");string value=new UTF8Encoding(false,true).GetString(bytes);if(value.IndexOf(\'\\0\')>=0)throw new InvalidOperationException("PROVIDER_INPUT_UTF8");return bytes;}catch{Array.Clear(bytes,0,bytes.Length);throw;}\n }catch{throw new InvalidOperationException("PROVIDER_INPUT_FAILED");}\n }}'

_INPUT_READ=r'''
Add-Type -TypeDefinition @'
__INPUT_CS__
'@
$inputPath=Join-Path $dir 'stdin.json'
if(([IO.File]::GetAttributes($inputPath) -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'PROVIDER_INPUT_REPARSE'}
$inputFile=[IO.FileStream]::new($inputPath,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
try{
 $acl=[IO.File]::GetAccessControl($inputPath);$sid=[Security.Principal.SecurityIdentifier];$rules=@($acl.GetAccessRules($true,$true,$sid));$sddl=$acl.GetSecurityDescriptorSddlForm([Security.AccessControl.AccessControlSections]::All)
 if(-not $acl.AreAccessRulesProtected -or $acl.GetOwner($sid).Value -cne 'S-1-5-18' -or $acl.GetGroup($sid).Value -cne 'S-1-5-18' -or $rules.Count -ne 1 -or @($acl.GetAuditRules($true,$true,$sid)).Count -ne 0){throw 'PROVIDER_INPUT_ACL'}
 $rule=$rules[0];if($rule.IdentityReference.Value -cne 'S-1-5-18' -or $rule.IsInherited -or $rule.AccessControlType -ne [Security.AccessControl.AccessControlType]::Allow -or [int]$rule.FileSystemRights -ne 2032127 -or [int]$rule.InheritanceFlags -ne 0 -or [int]$rule.PropagationFlags -ne 0){throw 'PROVIDER_INPUT_ACL'}
 $info=[IO.FileInfo]::new($inputPath);$generation=@($info.CreationTimeUtc.Ticks,$info.LastWriteTimeUtc.Ticks,$info.Length,[int]$info.Attributes)
 if($inputFile.Length -le 0 -or $inputFile.Length -gt 2048){throw 'PROVIDER_INPUT_METADATA_BOUND'};$inputRaw=[byte[]]::new([int]$inputFile.Length);if($inputFile.Read($inputRaw,0,$inputRaw.Length) -ne $inputRaw.Length){throw 'PROVIDER_INPUT_METADATA_SHORT'};$inputRecord=[Text.Encoding]::UTF8.GetString($inputRaw)|ConvertFrom-Json
 $after=[IO.FileInfo]::new($inputPath);if(($generation -join ',') -cne ((@($after.CreationTimeUtc.Ticks,$after.LastWriteTimeUtc.Ticks,$after.Length,[int]$after.Attributes))-join ',') -or [IO.File]::GetAccessControl($inputPath).GetSecurityDescriptorSddlForm([Security.AccessControl.AccessControlSections]::All) -cne $sddl){throw 'PROVIDER_INPUT_METADATA_CHANGED'}
 if((($inputRecord.PSObject.Properties.Name|Sort-Object)-join ',') -cne 'creationFileTime,handle,nonce,parentPid,pid,sessionId,sourceSha256'){throw 'PROVIDER_INPUT_METADATA_SCHEMA'}
 foreach($key in @('creationFileTime','nonce','parentPid','pid','sessionId','sourceSha256')){if($inputRecord.$key -cne $birth.$key){throw 'PROVIDER_INPUT_METADATA_BINDING'}}
