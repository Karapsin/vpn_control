 $privateInput=[CP117OriginalInput]::Open([long]$inputRecord.handle)
}finally{$inputFile.Dispose()}
'''

_WRITE_METHOD=r'''public static void SetExact(uint[] threads,Facts previous,string value){
 var elapsed=System.Diagnostics.Stopwatch.StartNew();Facts fresh=Read(threads);Need(fresh.nodes.Length>=5&&previous.nodes.Length>=5&&fresh.valuePatternSupported&&!fresh.valuePatternReadOnly,"ROLE_WRITE_PROVIDER");
 for(int i=0;i<5;i++)Need(Equal(fresh.nodes[i].runtimeId,previous.nodes[i].runtimeId),"ROLE_WRITE_IDENTITY");
 AutomationElement edit=AutomationElement.FocusedElement;Need(edit!=null,"ROLE_WRITE_FOCUS");var p=edit.Current;Need(p.ProcessId==1096&&p.ControlType==ControlType.Edit&&p.IsPassword&&p.HasKeyboardFocus&&p.IsKeyboardFocusable&&p.IsEnabled&&!p.IsOffscreen&&Equal(edit.GetRuntimeId(),fresh.nodes[3].runtimeId),"ROLE_WRITE_FIELD");
 object pattern;Need(edit.TryGetCurrentPattern(ValuePattern.Pattern,out pattern)&&pattern is ValuePattern&&!((ValuePattern)pattern).Current.IsReadOnly,"ROLE_WRITE_PROVIDER");uint thread;Need(Focus(threads,out thread).ToInt64()==65626&&thread==fresh.threadId&&elapsed.ElapsedMilliseconds<=5000,"ROLE_WRITE_CURRENT");
 try{((ValuePattern)pattern).SetValue(value);}catch{throw new InvalidOperationException("ROLE_WRITE_FAILED");}
}'''

_WRITE_PS=r'''
 if($cf.nodes.Count -notin @(5,6) -or -not $cf.valuePatternSupported -or $cf.valuePatternReadOnly){throw 'ROLE_WRITE_PROVIDER'}
 $action=@{nonce=$nonce;sourceSha256=$sourceHash;pid=$PID;parentPid=[int]$self.ParentProcessId;creationFileTime=$selfCreation;sessionId=1;state='consumed'}
 WritePrivate 'clear-attempt.json' $action
