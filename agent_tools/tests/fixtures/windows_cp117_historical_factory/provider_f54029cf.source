 WritePrivate 'cleared.json' @{nonce=$nonce;sourceSha256=$sourceHash;state='cleared';field=$cf.nodes[3].runtimeId}
 WritePrivate 'typing-attempt.json' $action
 try{$privateValue=[Text.UTF8Encoding]::new($false,$true).GetString($privateBytes);[CP117InputRead]::SetExact([uint32[]]$ids,$cf,$privateValue)}finally{[Array]::Clear($privateBytes,0,$privateBytes.Length);$privateValue=$null;$privateBytes=$null}
 $cf=[CP117InputRead]::Read([uint32[]]$ids)
 if($cf.nodes.Count -ne 5){throw 'ROLE_TYPED_OBSERVATION'}
 WritePrivate 'typed.json' @{nonce=$nonce;sourceSha256=$sourceHash;state='typed';field=$cf.nodes[3].runtimeId}
'''


_ROLE_NATIVE_SHA='8a9701b709223573191f44dc4417ee50358bec5aacb471da493f5ccb7afa6cfb'
_BASE_NATIVE_SHA='ca66d3aead0c278b4a69b2baf02628acf4c906d2d9d227cf053483e236137858'
_ROLE_PARENT_SHA='143e2d9c6f64907e53038c771b7ba6bf30539f937a954515b7fcd68c3a622cc3'
_ROLE_CHILD_SHA='afee661398d235c6a15d2dac957fc469cf4e21c3991e85b541c8e7524d0ae24e'


def _parts(inert=False):
    """Fixed derivative; source contains no credential bytes or credential hash."""
    import re
    if type(inert)is not bool:raise ValueError('provider-fixed-mode')
    correlation=INERT_CORRELATION if inert else CORRELATION;nonce=INERT_NONCE if inert else NONCE
    _sources()
    if hashlib.sha256(role.secure._NATIVE.encode()).hexdigest()!=_BASE_NATIVE_SHA or hashlib.sha256(role._SEMANTIC_CS.encode()).hexdigest()!=_ROLE_NATIVE_SHA:raise ValueError('provider-fixed-native')
    oldparent,oldchild,oldsha=role.bodies()
    if oldsha!=_ROLE_CHILD_SHA or hashlib.sha256(oldparent.encode('utf-16le')).hexdigest()!=_ROLE_PARENT_SHA:raise ValueError('provider-fixed-reader')
    match=re.search(r"FromBase64String\('([^']+)'\)",oldchild)
    if match is None:raise ValueError('provider-reader-loader')
    with gzip.GzipFile(fileobj=__import__('io').BytesIO(base64.b64decode(match.group(1))))as z:plain=z.read(16385)
    if len(plain)>16384:raise ValueError('provider-original-bound')
    child=plain.decode('utf-8').replace(role.CORRELATION,correlation).replace(role.NONCE,nonce)
    head="if($sourceHash -cne $birth.sourceSha256){throw 'SECURE_READER_SOURCE'}"
    if child.count(head)!=1:raise ValueError('provider-input-placement')
    prefix,sep,child=child.partition(head)
    if not sep:raise ValueError('provider-child-source-head')
    prefix+=sep+'\n'
    child='$privateBytes=[CP117OriginalInput]::ReadSecret($privateInput)\n'+child
    native=role._SEMANTIC_CS[:-1]+_WRITE_METHOD+'}'
    packed=base64.b64encode(gzip.compress(role._SEMANTIC_CS.encode(),mtime=0)).decode();newpacked=base64.b64encode(gzip.compress(native.encode(),mtime=0)).decode()
    if child.count(packed)!=1 or child.count(_ROLE_NATIVE_SHA)!=1:raise ValueError('provider-native-placement')
    expected_count="if($o -ne "+str(len(role._SEMANTIC_CS.encode()))+"){throw 'CENSUS_CS_BOUND'}"
    if len(native.encode())>16384 or child.count(expected_count)!=1:raise ValueError('provider-fixed-cs-loader')
    child=child.replace(packed,newpacked).replace(_ROLE_NATIVE_SHA,hashlib.sha256(native.encode()).hexdigest())
    child=child.replace(expected_count,"if($o -ne "+str(len(native.encode()))+"){throw 'CENSUS_CS_BOUND'}")
    marker='$cf=[CP117InputRead]::Read([uint32[]]$ids)' 
    if child.count(marker)!=1:raise ValueError('provider-write-placement')
    child=child.replace(marker,marker+'\n'+_WRITE_PS)
    child=child.replace('secureInput=$cf};WritePrivate','secureInput=$cf;providerWrite=@{cleared=$true;typed=$true;contentRead=$false;credentialLogged=$false}};WritePrivate')
    # Provider exceptions may mention their input. Never persist error details
    # from a secret-bearing execution, even in protected failure receipts.
    detail="$d=($_|Out-String);if($d.Length -gt 2048){$d=$d.Substring(0,2048)};"
    if child.count(detail)!=1:raise ValueError('provider-private-error-placement')
    child=child.replace(detail,"$d='';")
    if inert:child=_inert_public()
    public='\n'.join(line.lstrip(' ')for line in child.splitlines())+'\n'
    if not 0<len(public.encode())<=16384:raise ValueError('provider-child-public-source-bound')
    child=prefix+_INPUT_READ.replace('__INPUT_CS__',_INPUT_CS)+_PUBLIC_STAGE.replace('__PUBLIC_SHA__',hashlib.sha256(public.encode()).hexdigest())
    childsha=hashlib.sha256(child.encode('utf-16le')).hexdigest()
    parent=oldparent.replace(role.CORRELATION,correlation).replace(role.NONCE,nonce).replace(_ROLE_CHILD_SHA,childsha).replace(base64.b64encode(oldchild.encode('utf-16le')).decode(),base64.b64encode(child.encode('utf-16le')).decode())
    if parent.count(role.secure._NATIVE)!=1:raise ValueError('provider-parent-native-placement')
    parent=parent.replace(role.secure._NATIVE,native_source())
    marker=" WritePrivate 'child.json' $record;GuardUI"
    if parent.count(marker)!=1:raise ValueError('provider-parent-input-placement')
    parent=parent.replace(marker,marker+"\n $inputHandle=[CP117SessionRead]::DuplicateInput($pi,$birth);GuardUI;if([CP117SessionRead]::Birth($pi) -cne $birth){throw 'PROVIDER_INPUT_CHILD'};WritePrivate 'stdin.json' @{nonce=$nonce;sourceSha256=$childSha;pid=[int]$pi.pid;parentPid=$PID;creationFileTime=$birth;sessionId=1;handle=[long]$inputHandle};"+_STDIN_PROTECT+";GuardUI")
    # Only finite source-controlled parent classifications may reach output.
    old="phase=$_.Exception.Message;readerCreated="
    if parent.count(old)!=1:raise ValueError('provider-parent-private-catch')
    parent=parent.replace(old,"phase='PROVIDER_PARENT_UNKNOWN';readerCreated=")
    if len(parent.encode())>65536 or len(base64.b64encode(child.encode('utf-16le')))>30000:raise ValueError('provider-fixed-command-bound')
    return parent,child,childsha,public


_PUBLIC_STAGE=r"""
try{
 $sourceCount=0;for($index=0;$index -lt 4;$index++){$byte=$privateInput.ReadByte();if($byte -lt 0){throw 'PROVIDER_CHILD_SOURCE_HEADER'};$sourceCount=$sourceCount*256+$byte}
 if($sourceCount -le 0 -or $sourceCount -gt 16384){throw 'PROVIDER_CHILD_SOURCE_BOUND'}
 $publicBytes=[byte[]]::new($sourceCount);$offset=0;while($offset -lt $sourceCount){$read=$privateInput.Read($publicBytes,$offset,$sourceCount-$offset);if($read -le 0){throw 'PROVIDER_CHILD_SOURCE_SHORT'};$offset+=$read}
 $hash=[Security.Cryptography.SHA256]::Create();try{$actual=([BitConverter]::ToString($hash.ComputeHash($publicBytes))).Replace('-','').ToLowerInvariant()}finally{$hash.Dispose()}
 if($actual -cne '__PUBLIC_SHA__'){throw 'PROVIDER_CHILD_SOURCE_HASH'}
 &([ScriptBlock]::Create([Text.UTF8Encoding]::new($false,$true).GetString($publicBytes)))
}finally{$privateInput.Dispose()}
"""


def bodies():
    parent,child,sha,_=_parts();return parent,child,sha


def _public_frames(parent,inert=False):
    fixed,_,_,public=_parts(inert)
    if parent!=fixed:raise ValueError('provider-fixed-parent')
    a=parent.encode();b=public.encode()
    return len(a).to_bytes(4,'big')+a+len(b).to_bytes(4,'big')+b

CHILD_SHA='652610a25c6c983855023fb0f6d86aa2707a32a4ebfca995de8b7e627e078871'
PARENT_SHA='1db103cde7e12d20eb7a151fd3eab5a6bf4883af96c0e9bcef96338f94550c3e'


def _provider_terminal(value,nonce,sha,pid):
    if value.get('exited')is not True:return None
    if value.get('out-truncated')or value.get('err-truncated'):raise ValueError('provider-terminal-truncated')
    raw=base64.b64decode(value.get('out-data',''),validate=True)
    if len(raw)>32768:raise ValueError('provider-terminal-bound')
    first,sep,body=raw.partition(b'\n')
    if not sep or first.rstrip(b'\r')!=('CP117-READ %s %s %d'%(nonce,sha,pid)).encode():return None
    if value.get('exitcode')!=0:raise ValueError('provider-terminal-exit')
    answer=json.loads(body);write=answer.get('facts',{}).pop('providerWrite',None)
    if not isinstance(write,dict)or set(write)!={'cleared','typed','contentRead','credentialLogged'}or any(type(v)is not bool for v in write.values())or write!={'cleared':True,'typed':True,'contentRead':False,'credentialLogged':False}:raise ValueError('provider-action-proof')
    # Execute only the unchanged explicitly pinned strict parser with the fixed
    # new child hash; no mutation of the consumed imported reader namespace.
    namespace={'base64':base64,'json':json,'secure':role.secure,'CHILD_SHA':CHILD_SHA};exec(compile(inspect.getsource(role._bound_terminal),'fixed-provider-binding','exec'),namespace)
    bound=dict(value);bound['out-data']=base64.b64encode(first+sep+json.dumps(answer).encode()).decode()
    answer=namespace['_bound_terminal'](bound,nonce,sha,pid)
    if answer is None:raise ValueError('provider-binding')
    role.validate_semantic(answer);answer['facts']['providerWrite']=write;return answer


def program(record):
    return _program(record,False)

def inert_program(record):
    return _program(record,True)

def _program(record,inert):
    """One guarded fixed parent/child submit; secret is received only at run time."""
    _sources();parent,child,childsha,_=_parts(inert)
    parent_sha=hashlib.sha256(parent.encode('utf-16le')).hexdigest();nonce=INERT_NONCE if inert else NONCE;correlation=INERT_CORRELATION if inert else CORRELATION
    if not inert and(childsha!=CHILD_SHA or parent_sha!=PARENT_SHA):raise ValueError('provider-rendered-source')
    source,_=role.program(record);oldparent,oldchild,_=role.bodies()
    tree=ast.parse(source);encoded=next(ast.literal_eval(n.value)for n in tree.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='ENCODED'for t in n.targets))
    bootstrap=base64.b64decode(encoded).decode('utf-16le').replace(role.NONCE,nonce).replace(_ROLE_PARENT_SHA,parent_sha)
    oldinput=base64.b64encode(len(oldparent.encode()).to_bytes(4,'big')+oldparent.encode()).decode()
    replacements={'D='+repr(role.CORRELATION):'D='+repr(correlation),'NONCE='+repr(role.NONCE):'NONCE='+repr(nonce),'BODY_SHA='+repr(_ROLE_PARENT_SHA):'BODY_SHA='+repr(parent_sha),'CHILD_SHA='+repr(_ROLE_CHILD_SHA):'CHILD_SHA='+repr(childsha),'ENCODED='+repr(encoded):'ENCODED='+repr(base64.b64encode(bootstrap.encode('utf-16le')).decode()),"'input-data':"+repr(oldinput):"'input-data':private_input_data"}
    for old,new in replacements.items():
        if source.count(old)!=1:raise ValueError('provider-fixed-reader-factory')
        source=source.replace(old,new)
    marker='\ntry:\n children='
    source=source.replace(marker,'\n'+inspect.getsource(validate_secret)+inspect.getsource(_provider_terminal).replace('role.secure','secure').replace('role.validate_semantic','validate_semantic').replace("    namespace={'base64':base64,'json':json,'secure':secure,'CHILD_SHA':CHILD_SHA};exec(compile(inspect.getsource(role._bound_terminal),'fixed-provider-binding','exec'),namespace)","    namespace=globals()")+marker)
    # Use the source-bound original parser definition already inside this fixed
    # generated reader; invoke it directly after removing only action metadata.
    source=source.replace("answer=parse_terminal(value,NONCE,BODY_SHA,pid)","answer=_provider_terminal(value,NONCE,BODY_SHA,pid)")
    if inert:
        source=source.replace(inspect.getsource(validate_secret),inspect.getsource(validate_secret)+inspect.getsource(_inert_terminal))
        source=source.replace('answer=_provider_terminal(value,NONCE,BODY_SHA,pid)','answer=_inert_terminal(value,NONCE,BODY_SHA,pid)')
    launch=" guards();child=call(LEAF+'/qga.sock','guest-exec',"
    prefix=" guards();header=sys.stdin.buffer.read(4);need(len(header)==4,'provider-private-header');length=int.from_bytes(header,'big');need(1<=length<=512,'provider-private-bound');private_input=sys.stdin.buffer.read(length);need(len(private_input)==length,'provider-private-short');validate_secret(private_input);private_input_data=base64.b64encode("+repr(_public_frames(parent,inert))+"+length.to_bytes(4,'big')+private_input).decode();private_input=b'';child=call(LEAF+'/qga.sock','guest-exec',"
    if source.count(launch)!=1:raise ValueError('provider-original-stdin-factory')
    source=source.replace(launch,prefix)
    source=source.replace(" need(isinstance(child,dict)and type(child.get('pid'))is int", " private_input_data='';need(isinstance(child,dict)and type(child.get('pid'))is int",1)
    source=source.replace("'phase':str(e)if isinstance(e,ValueError)else type(e).__name__", "'phase':'PROVIDER_OBSERVATION_UNKNOWN'")
    compile(source,'fixed-private-provider-reader','exec');return source,parent_sha


def _inert_public():
    # Fixed public test input only. The exact production reader and provider
    # class are compiled, but no provider/UIA/keyboard/auth method is invoked.
    native=role._SEMANTIC_CS[:-1]+_WRITE_METHOD+'}'
    return """$bytes=[CP117OriginalInput]::ReadSecret($privateInput)
try{if([Text.Encoding]::UTF8.GetString($bytes) -cne 'CP117-PUBLIC-INERT-PIPE'){throw 'ROLE_INERT_SENTINEL'}}finally{[Array]::Clear($bytes,0,$bytes.Length)}
Add-Type -AssemblyName UIAutomationClient,UIAutomationTypes,WindowsBase
Add-Type -ReferencedAssemblies @('System.dll','System.Core.dll',[Windows.Automation.AutomationElement].Assembly.Location,[Windows.Automation.ControlType].Assembly.Location,[Windows.Rect].Assembly.Location) -TypeDefinition @'
"""+native+"""
'@
$reader=@{nonce=$nonce;pid=$PID;parentPid=[int]$self.ParentProcessId;sessionId=[int]$self.SessionId;expectedSystem=$true;creationFileTime=$selfCreation;sourceSha256=$sourceHash}
WritePrivate 'result.json' @{reader=$reader;facts=@{version=1;originalStdinPipe=$true;publicFramesPassed=$true;providerCompiled=$true;credentialInput=$false;providerInvoked=$false;keyboardAction=$false}}
"""


def _retained_inert_terminal(helper_bytes,helper_sha,child_sha,value,nonce,sha,pid):
    """Interpret a fixed terminal using the caller's already authenticated bytes."""
    if not isinstance(helper_bytes,bytes)or hashlib.sha256(helper_bytes).hexdigest()!=helper_sha:raise ValueError('retained-parser-source')
    nodes=[n for n in ast.parse(helper_bytes.decode()).body if isinstance(n,ast.FunctionDef)and n.name=='_inert_terminal']
    if len(nodes)!=1:raise ValueError('retained-parser-definition')
    namespace={'base64':base64,'json':json,'CHILD_SHA':child_sha}
    exec(compile(ast.Module(nodes,type_ignores=[]),'authenticated-inert-parser','exec'),namespace)
    return namespace['_inert_terminal'](value,nonce,sha,pid)

def _inert_terminal(value,nonce,sha,pid):
    if value.get('exited')is not True:return None
    if value.get('out-truncated')or value.get('err-truncated'):raise ValueError('pipe-inert-truncated')
    raw=base64.b64decode(value.get('out-data',''),validate=True)
    if len(raw)>32768:raise ValueError('pipe-inert-cap')
    first,sep,body=raw.partition(b'\n')
    if not sep or first.rstrip(b'\r')!=('CP117-READ %s %s %d'%(nonce,sha,pid)).encode():return None
    if value.get('exitcode')!=0:raise ValueError('pipe-inert-exit')
    answer=json.loads(body)
    if not isinstance(answer,dict)or set(answer)!={'facts','reader','birth'}:raise ValueError('pipe-inert-schema')
    expected={'version':1,'originalStdinPipe':True,'publicFramesPassed':True,'providerCompiled':True,'credentialInput':False,'providerInvoked':False,'keyboardAction':False}
    if answer['facts']!=expected or any(type(answer['facts'].get(k))is not type(v)for k,v in expected.items()):raise ValueError('pipe-inert-facts')
    reader=answer['reader'];birth=answer['birth']
    if not isinstance(reader,dict)or set(reader)!={'nonce','pid','parentPid','sessionId','expectedSystem','creationFileTime','sourceSha256'}or not isinstance(birth,dict)or set(birth)!={'nonce','pid','parentPid','creationFileTime','sessionId','sourceSha256','applicationSha256'}:raise ValueError('pipe-inert-child-schema')
    if reader['nonce']!=nonce or reader['sourceSha256']!=CHILD_SHA or reader['sessionId']!=1 or reader['expectedSystem']is not True or reader['parentPid']!=pid or type(reader['pid'])is not int or reader['pid']<=0 or type(reader['creationFileTime'])is not str or not reader['creationFileTime'].isdigit():raise ValueError('pipe-inert-child')
    if any(birth[k]!=reader[k]for k in('nonce','pid','parentPid','creationFileTime','sessionId','sourceSha256'))or not isinstance(birth['applicationSha256'],str)or len(birth['applicationSha256'])!=64 or any(c not in'0123456789abcdef'for c in birth['applicationSha256'].lower()):raise ValueError('pipe-inert-birth')
    return answer


ROLE_STREAM_SHA='f31d295b9b1692eb53d31672577bdd77af4dd5c20c0320b1b1f59e0f44ea6d1a'
def _stream(argv,capture,diagnostic,nonce,sha,qemu,secret):
    _sources()
    if hashlib.sha256(inspect.getsource(role._stream).encode()).hexdigest()!=ROLE_STREAM_SHA:raise ValueError('provider-fixed-stream')
    import selectors,subprocess
    r=login.guest.recovery
    if secret is not None and(not isinstance(secret,bytes)or len(secret)>512):raise ValueError('gui-private-input-bound')
    process=subprocess.Popen(argv,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    selector=selectors.DefaultSelector();chunks={'stdout':bytearray(),'stderr':bytearray()};pending=bytearray();events=[];child=None;deadline=time.monotonic()+60
    selector.register(process.stdout,selectors.EVENT_READ,'stdout');selector.register(process.stderr,selectors.EVENT_READ,'stderr')
    try:
        if secret is not None:
            process.stdin.write(len(secret).to_bytes(4,'big')+secret);process.stdin.flush();secret=b''
        while selector.get_map():
            if time.monotonic()>=deadline:raise ValueError('gui-observer-deadline')
            for key,_ in selector.select(.25):
                data=os.read(key.fileobj.fileno(),4096)
                if not data:selector.unregister(key.fileobj);continue
                chunks[key.data].extend(data)
                if len(chunks[key.data])>262144:raise ValueError('gui-observer-byte-cap')
                if key.data=='stderr':
                    pending.extend(data)
                    while b'\n'in pending:
                        line,rest=pending.split(b'\n',1);pending=bytearray(rest)
                        if not line.startswith(b'CP117-OBSERVE '):continue
                        event=json.loads(line[14:])
                        if any(event.get(k)!=v for k,v in{'diagnosticId':diagnostic,'nonce':nonce,'sourceSha256':sha,'qemu':qemu}.items()):raise ValueError('gui-event-binding')
                        if event['kind']=='submitted':
                            if child is not None or type(event.get('pid'))is not int or event['pid']<=0:raise ValueError('gui-one-child')
                            child=event['pid']
                        elif event['kind']in('poll','terminal'):
                            if child is None or event.get('pid')!=child:raise ValueError('gui-same-child')
                        elif event['kind']!='exception':raise ValueError('gui-event-kind')
                        pin=capture.create(diagnostic+'-event-%d.json'%len(events),json.dumps(event,sort_keys=True).encode());os.fsync(capture.fd);events.append({'event':event,'pin':pin})
                        if event['kind']=='submitted':
                            ack=r._digest({'diagnosticId':diagnostic,'nonce':nonce,'sourceSha256':sha,'pid':child});process.stdin.write((ack+'\n').encode());process.stdin.flush()
        if process.wait(timeout=max(.001,deadline-time.monotonic()))!=0:raise ValueError('gui-observer-exit')
        value=json.loads(chunks['stdout']);return value,events
    except BaseException as e:
        e.events=events
        if process.poll()is None:process.kill()  # Only this local observer, never VM/app.
        process.wait(timeout=3);raise
    finally:
        capture.create(diagnostic+'-transport.stdout.private',bytes(chunks['stdout']));capture.create(diagnostic+'-transport.stderr.private',bytes(chunks['stderr']));os.fsync(capture.fd)
        selector.close();process.stdin.close();process.stdout.close();process.stderr.close()


_STDIN_PROTECT="$inputAcl=[Security.AccessControl.FileSecurity]::new();$inputAcl.SetSecurityDescriptorSddlForm('O:SYG:SYD:P(A;;FA;;;SY)');[IO.File]::SetAccessControl((Join-Path $dir 'stdin.json'),$inputAcl);\n$inputPath=Join-Path $dir 'stdin.json';if(([IO.File]::GetAttributes($inputPath) -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'PROVIDER_INPUT_REPARSE'}\n$inputCheck=[IO.FileStream]::new($inputPath,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read);try{\n$acl=$inputCheck.GetAccessControl();$sid=[Security.Principal.SecurityIdentifier];$rules=@($acl.GetAccessRules($true,$true,$sid));$sddl=$acl.GetSecurityDescriptorSddlForm([Security.AccessControl.AccessControlSections]::All)\n if(-not $acl.AreAccessRulesProtected -or $acl.GetOwner($sid).Value -cne 'S-1-5-18' -or $acl.GetGroup($sid).Value -cne 'S-1-5-18' -or $rules.Count -ne 1 -or @($acl.GetAuditRules($true,$true,$sid)).Count -ne 0){throw 'PROVIDER_INPUT_ACL'}\n $rule=$rules[0];if($rule.IdentityReference.Value -cne 'S-1-5-18' -or $rule.IsInherited -or $rule.AccessControlType -ne [Security.AccessControl.AccessControlType]::Allow -or [int]$rule.FileSystemRights -ne 2032127 -or [int]$rule.InheritanceFlags -ne 0 -or [int]$rule.PropagationFlags -ne 0){throw 'PROVIDER_INPUT_ACL'}\n\n}finally{$inputCheck.Dispose()}"

# Prospective login phases: these correlations have never been dispatched.
AUTH_CORRELATION='f047bf5a-4f12-40cc-af11-36c8cb485b97'
AUTH_NONCE='b8629de5-9e97-4f9b-9885-670a9e102dc5'
LOGIN_FLOW='9dbd4008-7f34-4e1d-85a6-f3f30ea7fdc0'

def _credential_phase_program(root,record):
    """Fixed fresh auth derivative; never replay the historical credential probe."""
    _sources();source,oldsha,pins=login.credential_program(root,record,AUTH_NONCE)
    tree=ast.parse(source);encoded=next(ast.literal_eval(n.value)for n in tree.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='ENCODED'for t in n.targets))
    original=base64.b64decode(encoded,validate=True).decode('utf-16le');first,sep,body=original.partition('\n')
    if not sep or oldsha!=login._BOOTSTRAP_SHA or first!="[Console]::Out.WriteLine(('CP117-READ "+AUTH_NONCE+" "+oldsha+" '+$PID))" or login.CREDENTIAL_CORRELATION not in body:raise ValueError('login-auth-fixed-source')
    body=body.replace(login.CREDENTIAL_CORRELATION,AUTH_CORRELATION);sha=hashlib.sha256(body.encode('utf-16le')).hexdigest()
    header="[Console]::Out.WriteLine(('CP117-READ "+AUTH_NONCE+" "+sha+" '+$PID))\n"
    replacements=[('ENCODED='+repr(encoded),'ENCODED='+repr(base64.b64encode((header+body).encode('utf-16le')).decode())),('BODY_SHA='+repr(oldsha),'BODY_SHA='+repr(sha))]
    for old,new in replacements:
        if source.count(old)!=1:raise ValueError('login-auth-render-factory')
        source=source.replace(old,new)
    source=source.replace(login.CREDENTIAL_CORRELATION,AUTH_CORRELATION)
    if login.CREDENTIAL_CORRELATION in source or len(base64.b64encode((header+body).encode('utf-16le')))>30000:raise ValueError('login-auth-render-bound')
    compile(source,'fixed-fresh-credential-validation','exec');return source,sha,pins


def _validate_fresh_auth(value,qemu):
    expected={'operation':'windows-credential-validity-v1','correlationId':AUTH_CORRELATION,'expectedSid':login.guest.SID,'success':True,'errorCategory':'none'}
    if not isinstance(value,dict)or value.get('state')!='observed' or value.get('credential')!=expected or value.get('qemu')!=qemu or type(value.get('guestChildPid'))is not int or value['guestChildPid']<=0 or type(value['credential'].get('success'))is not bool:raise ValueError('login-fresh-auth')


def _login_sequence(auth,prepare,write,submit,owner,retain,qemu):
    """Finite complete control flow: any unknown stops before the next effect."""
    validated=auth();retain('auth',validated);_validate_fresh_auth(validated,qemu)
    prepared=prepare();retain('prepare',prepared)
    if prepared.get('state')!='observed' or prepared.get('qemu')!=qemu:raise ValueError('login-prepare')
    typed=write();retain('write',typed)
    if typed.get('state')!='observed' or typed.get('qemu')!=qemu:raise ValueError('login-write')
    view=dict(typed['facts']);view['facts']={k:v for k,v in view['facts'].items()if k!='providerWrite'};role.validate_semantic(view);s=view['facts']['secureInput']
    if len(s['nodes'])!=5 or typed['facts']['facts'].get('providerWrite')!={'cleared':True,'typed':True,'contentRead':False,'credentialLogged':False}:raise ValueError('login-write-authority')
    entered=submit(typed);retain('enter',entered)
    if entered.get('state')!='observed' or entered.get('phase')!='entered' or entered.get('qemu')!=qemu:raise ValueError('login-submit')
    current=owner();retain('owner',current)
    if current.get('state')!='observed' or current.get('qemu')!=qemu:raise ValueError('login-owner')
    return {'state':'observed','phase':'entered','typingAcknowledged':True,'loginSubmitted':True,'ownerObservation':current,'installerAction':False,'replayAllowed':False}

