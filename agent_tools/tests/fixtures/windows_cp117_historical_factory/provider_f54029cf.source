    def guard():
        guards();need(identity(os.fstat(parentfd))==identity(os.lstat(parent))==identity(parentinfo),'login-enter-parent-drift')
        need(identity(os.fstat(jobfd))==identity(os.stat(job,dir_fd=parentfd,follow_symlinks=False))==jobidentity,'login-enter-job-drift')
        for leaf,pin in pins.items():
            fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=jobfd)
            try:
                info=os.fstat(fd);need(stat.S_ISREG(info.st_mode)and info.st_uid==os.geteuid()and info.st_nlink==1 and stat.S_IMODE(info.st_mode)==0o600 and fp(info)==pin['fingerprint'],'login-enter-record')
                raw=os.read(fd,32769);need(len(raw)==info.st_size and hashlib.sha256(raw).hexdigest()==pin['sha256']and fp(info)==fp(os.fstat(fd))==fp(os.stat(leaf,dir_fd=jobfd,follow_symlinks=False)),'login-enter-record-drift')
            finally:os.close(fd)
        need(identity(os.fstat(parentfd))==identity(os.lstat(parent))==identity(parentinfo)and identity(os.fstat(jobfd))==identity(os.stat(job,dir_fd=parentfd,follow_symlinks=False))==jobidentity,'login-enter-final-ancestry');guards()
    def create(name,value):
        guard();raw=json.dumps(value,sort_keys=True,separators=(',',':')).encode();need(0<len(raw)<=32768,'login-enter-record-bound')
        fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=jobfd)
        try:
            need(os.write(fd,raw)==len(raw),'login-enter-write');os.fsync(fd);info=os.fstat(fd);need(fp(info)==fp(os.stat(name,dir_fd=jobfd,follow_symlinks=False)),'login-enter-name');pins[name]={'fingerprint':fp(info),'sha256':hashlib.sha256(raw).hexdigest()};os.fsync(jobfd)
        finally:os.close(fd)
        guard()
    channel=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);channel.settimeout(5);stream=None;serial=0
    try:
        create('intent.json',{'flow':FLOW,'nonce':NONCE,'sourceSha256':BODY_SHA,'qemu':children[1]['child'],'prior':prior,'state':'consumed'})
        guard();channel.connect(LEAF+'/qmp.sock');peer=struct.unpack('3i',channel.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12));need(peer[0]==children[1]['child']['pid']and peer[1]==os.geteuid(),'login-enter-qmp-peer');stream=channel.makefile('rb');guard()
        def receive(wanted):
            for _ in range(16):
                raw=stream.readline(32769);need(0<len(raw)<=32768 and raw.endswith(b'\n'),'login-enter-qmp-bound');value=json.loads(raw)
                if wanted is None:need('QMP'in value,'login-enter-greeting');return
                if value.get('id')==wanted:need('return'in value and 'error'not in value,'login-enter-qmp-result');return
                need('event'in value,'login-enter-qmp-id')
            raise ValueError('login-enter-qmp-event-cap')
        def command(kind,args=None):
            nonlocal serial
            guard();serial+=1;packet={'execute':kind,'id':serial}
            if args is not None:packet['arguments']=args
            channel.sendall(json.dumps(packet,separators=(',',':')).encode()+b'\n');receive(serial);guard()
        receive(None);command('qmp_capabilities')
        def capture(name):
            guard();need(not os.path.lexists(parent+'/'+job+'/'+name),'login-enter-frame-existing');command('screendump',{'filename':parent+'/'+job+'/'+name});sampled=time.monotonic()
            fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=jobfd)
            try:
                info=os.fstat(fd);need(stat.S_ISREG(info.st_mode)and info.st_nlink==1 and info.st_uid==os.geteuid()and 0<info.st_size<=16777216,'login-enter-frame');os.fchmod(fd,0o600);info=os.fstat(fd);raw=os.read(fd,16777217)
                need(len(raw)==info.st_size and fp(info)==fp(os.fstat(fd))==fp(os.stat(name,dir_fd=jobfd,follow_symlinks=False)),'login-enter-frame-drift');validate_ppm(raw);os.fsync(fd);os.fsync(jobfd);frames[name]={'fingerprint':fp(info),'sha256':hashlib.sha256(raw).hexdigest()};create(name+'.json',frames[name]);guard();return sampled
