"""Actual334 kernel guard/canonical caller coupling on owned temporary files.

Only the source guard's OS/public boundaries are owned controls. Its whole
function body is taken byte-exact from the authentic generic qualification
source. No failed0e75/e96/b7e authority is loaded or granted. The preexisting
schema fixture projects root principals; this proves no native authorization.
"""
import ast
import copy
import hashlib
import json
import os
from pathlib import Path
import types
import uuid

HERE = Path(__file__).parent
TEMPLATE_SHA = '0e2a18b93a9d421c4fe6e5478c278ede7af41a87b8605bc4bcd993405142db07'


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode() + b'\n'


def fp(info):
    return [info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
            info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns]


def write(path, raw):
    with path.open('xb') as stream:stream.write(raw)
    path.chmod(0o600)


def read(path):
    parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
        try:
            first = fp(os.fstat(fd));raw = os.read(fd, 65537)
            if first != fp(os.fstat(fd)) or first != fp(os.stat(path.name, dir_fd=parent, follow_symlinks=False)) or len(raw) != first[6]:
                raise ValueError('owned_actual_kernel_record_changed')
            return raw
        finally:os.close(fd)
    finally:os.close(parent)


class Probe:
    def __init__(self, core, case, root, *, drift=None):
        self.core = core;self.case = case;self.root = root;self.drift = drift;self.reads = 0
        root.mkdir(mode=0o700)
        self.machine = root / 'owned-machine-id';write(self.machine, b'owned-kernel-composition-machine\n')
        self.account = root / 'owned-root-principal.json'
        principal = {'uid': 0, 'euid': 0, 'gid': 0, 'egid': 0, 'groups': [0]}
        write(self.account, canonical(principal))
        self.status = root / 'original-status.json'
        status = {'state': 'guest-generation-admitted', 'guestAdmitted': True,
                  'correlationId': case.start, **copy.deepcopy(case.generation),
                  'retainedEnvelopeNote': {'sequence': 1}}
        if drift == 'first-generation':status['device']['guestBootId'] = str(uuid.uuid4())
        write(self.status, canonical(status))
        self.journal = root / 'coldboot';self.journal.mkdir(mode=0o700)
        observed = {'schema': 1, 'correlationId': case.start, 'supervisor': status['child'],
                    'guest': status['guest'], 'source': case.plan['launch']['intent']['source'],
                    'intentSha256': case.plan['launch']['intentSha256']}
        write(self.journal / 'qemu-observed.json', canonical(observed))
        self.namespace = namespace = case.runtime()
        namespace['LAUNCH'] = dict(namespace['LAUNCH'], avd='vpn-control-parity113-api35')
        namespace['COMMAND_HOST'] = principal
        namespace['POSTSTART_CONTRACT'] = {'rootDirectory': str(root), 'rootIdentity': fp(root.stat())[:5],
            'oldGeneration': copy.deepcopy(case.candidate['contract']['oldGeneration']),
            'host': {'bootId': case.host['bootId'], 'machineSha256': hashlib.sha256(read(self.machine)).hexdigest()},
            'journalDirectory': str(self.journal), 'operationId': case.start}
        namespace['POSTSTART_ROOT_CHAIN'] = [(str(root), fp(root.stat())[:5])]
        def guard_parents(chain):
            if chain != [(str(root), fp(root.stat())[:5])]:raise ValueError('owned_actual_kernel_root_changed')
        def command_host_guard():
            if json.loads(read(self.account)) != namespace['COMMAND_HOST']:
                raise ValueError('owned_actual_kernel_principal_changed')
        def original_status(directory):
            if Path(directory) != self.journal:raise ValueError('owned_actual_kernel_journal_crossed')
            self.reads += 1
            value = json.loads(read(self.status))
            if self.reads == 1 and drift == 'closing-document':
                changed = copy.deepcopy(value);changed['retainedEnvelopeNote']['sequence'] += 1
                self.status.write_bytes(canonical(changed))
            return value
        def read_fixed(path, limit):
            if Path(path) != Path('/etc/machine-id') or limit != 256:
                raise ValueError('owned_actual_kernel_machine_crossed')
            raw = read(self.machine)
            return {'hashScope': 'full', 'sha256': hashlib.sha256(raw).hexdigest()}
        def journal_read(directory, name):
            if Path(directory) != self.journal or name != 'qemu-observed.json':
                raise ValueError('owned_actual_kernel_journal_crossed')
            return json.loads(read(self.journal / name))
        namespace.update(poststart_need=core.need, guard_parents=guard_parents,
                         command_host_guard=command_host_guard, original_status=original_status,
                         read_fixed=read_fixed, journal_read=journal_read,
                         os=os, pathlib=__import__('pathlib'))
        template = (HERE / 'qualification-template.authentic.source').read_bytes()
        if hashlib.sha256(template).hexdigest() != TEMPLATE_SHA:
            raise ValueError('owned_actual_kernel_template_changed')
        text = template.decode();tree = ast.parse(template)
        node = next(node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == 'poststart_kernel_guard')
        self.guard_source = (ast.get_source_segment(text, node) + '\n').encode()
        self.guard_path = root / 'authentic-poststart-kernel-guard.source';write(self.guard_path, self.guard_source)
        exec(compile(self.guard_source, str(self.guard_path), 'exec', dont_inherit=True), namespace)
        self.guard_function = namespace['poststart_kernel_guard']
        context = core.CurrentContext.__new__(core.CurrentContext)
        context.native = namespace;context.plan = {'launch': namespace['LAUNCH']}
        context.candidate = case.candidate;context.output_map = case.map
        context.runtime_codes = {name: core.code_signature(core.attribute(namespace, name).__code__)
                                 for name in core.REQUIRED_RUNTIME_REFS}
        context.effect_tables = {name: core.digest(core.canonical(namespace[name]))
                                 for name in ('EFFECT_PLANE_FIXED', 'CURRENT1E15_EFFECT_PLANE_FIXED')}
        self.context = context
