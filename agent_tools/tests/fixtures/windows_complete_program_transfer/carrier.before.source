def _complete_windows_fixture_carrier(public):
 # Reuse the production authenticated length/SHA/ParseInput/ScriptBlock loader.
 # Only this unit-test carrier has a 262144-byte ceiling for the complete
 # worst-case log-projection fixtures; production's 65536 cap is unchanged.
 if type(public)is not bytes or not 0<len(public)<=262144:raise ValueError('test-source-bound')
 tree=ast.parse(Path(refresh.__file__).read_bytes())
 method=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='repair_program')
 expression=next(n.value for n in method.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='loader'for t in n.targets))
 loader=eval(compile(ast.Expression(expression),'actual-fixed-test-loader','eval'),{'hashlib':hashlib,'str':str,'len':len,'__builtins__':{}},{'public':public})
 if loader.count('$length -gt 65536')!=1:raise ValueError('test-loader-slot')
 loader=loader.replace('$length -gt 65536','$length -gt 262144')
 encoded=base64.b64encode(loader.encode('utf-16le')).decode()
 if len(encoded)>=30000:raise ValueError('test-command-bound')
 return ['powershell','-NoProfile','-NonInteractive','-EncodedCommand',encoded],len(public).to_bytes(4,'little')+public

def _run_complete_windows_fixture(public,*,timeout):
 import subprocess
 argv,packet=_complete_windows_fixture_carrier(public)
 return subprocess.run(argv,input=packet,capture_output=True,timeout=timeout)
