 exec(compile(fixed['validatorSource'],'<held-original9da-process-projector>','exec'),v)
 scans=[]
 for _ in range(2):
  n['boundary_pass']();scans.append(n['attempt_workers']())
 counts=v['validate_workers'](n['ATTEMPT_PROC_RAW'],scans,fixed['binding'])
 record={'kind':'original1e15-current-effect-plane','binding':fixed['binding'],'passes':n['BOUNDARY_PASSES'],'workerPasses':scans,'procRawRecords':n['ATTEMPT_PROC_RAW']}
 COMPONENT_RETIRE_OBSERVATIONS.append(record)
 if len(counts)!=2 or any(any(value!=0 for value in row.values())for row in counts)or any(scan['censusComplete']is not True for scan in scans)or len({scan['bootId']for scan in scans})!=1:raise ValueError('effect_plane_current_interval_unknown')
 if n['BOUNDARY_PASSES']!=[fixed['priorPass'],fixed['priorPass']]:raise ValueError('effect_plane_footprint_changed')
 return record
