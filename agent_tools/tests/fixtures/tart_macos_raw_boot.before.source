"""Inert Mac-specific Tart backend; registration requires separate native proof.

No production custody implementation or registry route constructs this backend.
The private custody authority must verify actual immutable qualification records,
source pins, VM artifacts, original owners and endpoint generations. A caller DTO
or constructor boolean never supplies that authority. Linux Tart predicates are
deliberately independent.
"""
from __future__ import annotations

from contextlib import contextmanager
from dataclasses import dataclass
import hashlib
import math
from pathlib import Path, PurePosixPath
import re
import sys
import time
from uuid import UUID

from . import readiness
from . import readiness_providers as providers
from . import readiness_qemu_jobs as guest_protocol
from . import readiness_tart_vnc as rfb


class MacBlocked(providers.ProviderError):
    """Fixed reason identifiers only; no private callback exception text."""


class MacAgentStarting(Exception):
    """Private custody authenticated the same VM's expected agent startup."""
    def __init__(self):
        super().__init__("macos_guest_agent_starting")


def _need(condition, reason):
    if not condition:
        raise MacBlocked(reason)


def _uuid(value):
    try:
        if type(value) is str and str(UUID(value)) == value:
            return value
    except ValueError:
        pass
    raise MacBlocked("macos_identity_invalid")


def _public_path(value):
    _need(type(value) is str and value.startswith("/") and ".." not in PurePosixPath(value).parts
          and not any(ord(char) < 32 for char in value), "macos_binding_invalid")
    return value


def _deadline(value):
    _need(type(value) in {int, float} and math.isfinite(value) and value > time.monotonic(),
          "macos_readiness_deadline")
    return value


def _call(method, *args, **kwargs):
    try:
        return method(*args, **kwargs)
    except (readiness.AdapterBlocked, MacAgentStarting):
        raise
    except Exception:
        raise MacBlocked("macos_custody_unavailable") from None


def _actor(value):
    _need(type(value) is dict and set(value) == {"pid", "birth"} and type(value["pid"]) is int
          and value["pid"] > 0 and type(value["birth"]) is str
          and re.fullmatch(r"darwin:[1-9][0-9]*:[0-9]{1,6}", value["birth"]), "macos_actor_invalid")
    return value


def source_pins():
    """Public source only; credential, disk and saved-memory bytes are excluded."""
    paths = [Path(__file__), Path(rfb.__file__), Path(guest_protocol.__file__),
             Path(readiness.__file__), Path(providers.__file__),
             *(Path(__file__).with_name(name) for name in
               ("tart_macos_probe.py", "durable_remote_job.py", "private_inventory_lock.py"))]
    return {path.name: hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}


_LOADED_SOURCES = source_pins()
if sys._getframe().f_code != compile(Path(__file__).read_bytes(), __file__, "exec", dont_inherit=True, optimize=sys.flags.optimize):
    raise MacBlocked("macos_backend_source_changed")


@dataclass(frozen=True)
class MacBinding:
    target: str
    machine: str
    vm_name: str
    tart_binary: str
    fixture_root: str
    ordinary_account: str
    ordinary_uid: int
    ordinary_home: str
    guest_python: str
    memory_mib: int
    storage_fixture_id: str

    def __post_init__(self):
        _uuid(self.machine)
        _need(type(self.target) is str and re.fullmatch(r"local-tart-macos-[a-f0-9]{24}", self.target)
              and type(self.vm_name) is str and re.fullmatch(r"vpn-tool-recovery-tart-macos-[a-z0-9-]{1,64}", self.vm_name),
              "macos_binding_invalid")
        for value in (self.tart_binary, self.fixture_root, self.ordinary_home, self.guest_python):
            _public_path(value)
        _need(PurePosixPath(self.fixture_root).name == self.vm_name
              and type(self.ordinary_uid) is int and self.ordinary_uid >= 501
              and type(self.ordinary_account) is str and re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,63}", self.ordinary_account)
              and self.ordinary_account not in {"root", "loginwindow", "_mbsetupuser"}
              and self.ordinary_home == "/Users/" + self.ordinary_account
              and type(self.memory_mib) is int and self.memory_mib >= 4096
              and type(self.storage_fixture_id) is str and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", self.storage_fixture_id),
              "macos_binding_invalid")


def guest_facts(value, binding):
    """Validate the fixed Mac root probe without inferring absent GUI facts."""
    fields = {"machine", "boot", "bootTime", "uid", "account", "home", "observerUid", "observerAccount", "observerHome",
              "console", "display", "processVisibilityComplete", "processes", "protectedProcesses",
              "installerVisibilityComplete", "installerBlockers", "jobVisibilityComplete", "runningJobs", "unknownJobs"}
    _need(type(value) is dict and set(value) == fields, "macos_guest_probe_invalid")
    _need(value["machine"] == binding.machine and _uuid(value["boot"]), "macos_machine_identity_changed")
    _need(type(value["uid"]) is int and (value["uid"], value["account"], value["home"]) ==
          (binding.ordinary_uid, binding.ordinary_account, binding.ordinary_home), "macos_wrong_account")
    _need(type(value["observerUid"]) is int and (value["observerUid"], value["observerAccount"], value["observerHome"]) == (0, "root", "/var/root"),
          "macos_root_probe_unqualified")
    boot_time = value["bootTime"]
    _need(type(boot_time) is dict and set(boot_time) == {"seconds", "microseconds"}
          and type(boot_time["seconds"]) is int and boot_time["seconds"] > 0
          and type(boot_time["microseconds"]) is int and 0 <= boot_time["microseconds"] < 1000000,
          "macos_guest_probe_invalid")
    console = value["console"]
    console_fields = {"name", "uid", "onConsole", "locked", "session"}
    _need(type(console) is dict and set(console) in (console_fields, console_fields | {"loginDone"}),
          "macos_console_invalid")
    _need(console["name"] is None or type(console["name"]) is str and 0 < len(console["name"]) <= 256
          and not any(ord(c) < 32 for c in console["name"]), "macos_console_invalid")
    _need(console["uid"] is None or type(console["uid"]) is int and console["uid"] >= 0, "macos_console_invalid")
    _need(all(console[key] is None or type(console[key]) is bool for key in ("onConsole", "locked"))
          and (console["session"] is None or type(console["session"]) is str and re.fullmatch(r"[0-9]{1,20}", console["session"])),
          "macos_console_invalid")
    _need("loginDone" not in console or console["loginDone"] is None or type(console["loginDone"]) is bool,
          "macos_console_invalid")
    _need(type(value["display"]) is str and value["display"] in {"ready", "sleeping", "unknown"}
          and all(type(value[key]) is bool for key in ("processVisibilityComplete", "installerVisibilityComplete", "jobVisibilityComplete")),
          "macos_guest_probe_invalid")
    for key in ("processes", "protectedProcesses", "installerBlockers", "runningJobs", "unknownJobs"):
        _need(type(value[key]) is list and len(value[key]) <= 65536, "macos_guest_probe_overflow")
    pids = set()
    for row in value["processes"]:
        _need(type(row) is dict and set(row) == {"pid", "uid", "birth", "executableRole"}
              and type(row["pid"]) is int and row["pid"] > 0 and row["pid"] not in pids
              and type(row["uid"]) is int and row["uid"] >= 0 and type(row["birth"]) is str
              and re.fullmatch(r"darwin:[1-9][0-9]*:[0-9]{1,6}", row["birth"])
              and type(row["executableRole"]) is str
              and row["executableRole"] in {"verified_probe", "protected_runtime", "installer", "unmanaged"},
              "macos_process_projection_invalid")
        pids.add(row["pid"])
    for key, role in (("protectedProcesses", "protected_runtime"), ("installerBlockers", "installer")):
        _need(all(type(pid) is int and pid > 0 for pid in value[key])
              and len(set(value[key])) == len(value[key])
              and set(value[key]) == {row["pid"] for row in value["processes"] if row["executableRole"] == role},
              "macos_process_projection_invalid")
    _need(all(type(row) is dict and type(row.get("role")) is str and 0 < len(row["role"]) <= 128
              for key in ("runningJobs", "unknownJobs") for row in value[key]), "macos_job_projection_invalid")
    return value


def _session(facts, binding):
    console = facts["console"]
    if (type(console["uid"]) is int and console["uid"] >= 501
            and (console["uid"], console["name"]) != (binding.ordinary_uid, binding.ordinary_account)):
        return "wrong_account", None
    if ((console["uid"], console["name"]) == (binding.ordinary_uid, binding.ordinary_account)
            and console["onConsole"] is True and console["session"] is not None and console.get("loginDone") is True):
        session = facts["boot"] + ":console:" + console["session"]
        if console["locked"] is True:
            return "locked", session
        if console["locked"] is False:
            return "ready", session
    # Loginwindow/setup/root are not a recognized account-entry screen. The
    # separate source-qualified recognizer must make that decision before input.
    return "unknown", None


class MacTartBackend:
    """Private adapter contract; no production Mac custody is supplied yet.

    qualifications(binding, sourcePins) returns None, or a source-owned proof
    object whose guard reopens immutable native evidence and whose actions are a
    frozenset. No public request may construct or substitute that object.
    """
    def __init__(self, binding, custody):
        _need(type(binding) is MacBinding, "macos_binding_invalid")
        self.binding, self.custody = binding, custody
        self._proof = _call(custody.qualifications, binding, dict(_LOADED_SOURCES))
        self.capabilities = frozenset()
        if self._proof is not None:
            _call(self._proof.guard, binding, dict(_LOADED_SOURCES))
            actions = self._proof.actions
            _need(type(actions) is frozenset and actions <= readiness.RECOVERIES - {"reconnect"},
                  "macos_qualification_invalid")
            self.capabilities = actions

    def _sources(self):
        _need(source_pins() == _LOADED_SOURCES, "macos_backend_source_changed")

    def _host(self, deadline):
        self._sources(); _deadline(deadline)
        value = _call(self.custody.guard, deadline=deadline)
        _need(type(value) is dict and set(value) == {"state", "connection", "actor", "operator", "operationId", "jobState"}
              and type(value["state"]) is str and value["state"] in {"running", "stopped", "suspended", "paused", "booting"}
              and type(value["jobState"]) is str and value["jobState"] in {"running", "terminal"}
              and type(value["connection"]) is str and 0 < len(value["connection"]) <= 256
              and not any(ord(c) < 32 for c in value["connection"]),
              "macos_original_owner_unknown")
        _uuid(value["operationId"]); _actor(value["actor"]); _actor(value["operator"])
        _need(value["state"] != "running" or value["jobState"] == "running", "macos_original_owner_unknown")
        return value

    def dispatch_binding(self, family):
        _need(family == "tart", "macos_dispatch_family_invalid")
        self._host(time.monotonic() + 10)
        return {"vmName": self.binding.vm_name}

    @contextmanager
    def operation_scope(self, *, deadline=None, cancelled=lambda: False):
        deadline = time.monotonic() + readiness.NORMAL_BUDGET if deadline is None else _deadline(deadline)
        try:
            with self.custody.operator(deadline=deadline, cancelled=cancelled):
                self._host(deadline)
                yield
        except (MacBlocked, rfb.VncBlocked, readiness.AdapterBlocked):
            raise
        except Exception:
            raise MacBlocked("macos_operation_unknown") from None

    def reconcile_ready(self, ready, deadline):
        self.revalidate_ready(ready, deadline)
        return _call(self.custody.reconcile_ready, ready, deadline)

    def observe(self, requirements, deadline):
        current = self._host(deadline)
        base = dict(target=self.binding.target, machine=self.binding.machine, connection=current["connection"],
                    transport="ready", trusted=True, owned=True, integrity=True, coordinator_host=False)
        if current["state"] != "running":
            return readiness.Observation(**base, guest=current["state"])
        # This API runs the pinned, zero-argument, root-owned helper. It never
        # accepts source/argv/path or invokes readiness recursively.
        try:
            packet = _call(self.custody.guest_probe, self.binding, deadline)
        except MacAgentStarting:
            _need(self._host(deadline) == current, "macos_connection_generation_changed")
            return readiness.Observation(**base, guest="booting", guest_agent=False)
        _need(type(packet) is dict and set(packet) == {"facts", "agent"}, "macos_guest_probe_invalid")
        facts = guest_facts(packet["facts"], self.binding)
        agent = packet["agent"]
        _need(type(agent) is dict and set(agent) == {"actor", "uid", "principal", "home", "python"}, "macos_agent_invalid")
        actor = _actor(agent["actor"])
        _need(type(agent["uid"]) is int and (agent["uid"], agent["principal"], agent["home"], agent["python"]) ==
              (self.binding.ordinary_uid, self.binding.ordinary_account, self.binding.ordinary_home, self.binding.guest_python),
              "macos_agent_identity_changed")
        _need(self._host(deadline) == current, "macos_connection_generation_changed")
        base["connection"] += ":agent:" + str(actor["pid"]) + ":" + actor["birth"]
        state, session = _session(facts, self.binding)
        idle = _call(self.custody.idle_facts, facts, deadline)
        _need(type(idle) is dict and set(idle) == {"visibility", "blockers"}
              and type(idle["visibility"]) is frozenset and idle["visibility"] <= readiness.IDLE_VISIBILITY
              and type(idle["blockers"]) is frozenset and idle["blockers"] <= readiness.IDLE_VISIBILITY,
              "macos_idle_projection_invalid")
        visibility, blockers = set(idle["visibility"]), set(idle["blockers"])
        # A custody summary cannot turn an incomplete fixed probe into positive
        # idle proof. Actual Mac launchd/durable namespaces still need native
        # qualification and a complete fixed producer before enabling reboot.
        if not facts["processVisibilityComplete"]:
            visibility.discard("protected_processes")
        if not facts["installerVisibilityComplete"]:
            visibility.discard("installers")
        if not facts["jobVisibilityComplete"]:
            visibility -= {"running_jobs", "unknown_jobs"}
        if facts["protectedProcesses"]: blockers.add("protected_processes")
        if facts["installerBlockers"]: blockers.add("installers")
        if facts["runningJobs"]: blockers.add("running_jobs")
        if facts["unknownJobs"]: blockers.add("unknown_jobs")
        return readiness.Observation(**base, boot=facts["boot"], account=self.binding.ordinary_account,
                                     session=session, guest="running", guest_agent=True, ordinary_session=state,
                                     display=facts["display"], idle_visibility=frozenset(visibility), idle_blockers=frozenset(blockers))

    def revalidate_ready(self, ready, deadline):
        current = self.observe(ready.requirements, deadline)
        _need((current.target, current.machine, current.connection, current.boot, current.account, current.session) == ready.identities(),
              "macos_ready_identity_changed")
        return current

    def recover(self, action, recovery_identity, observed, deadline):
        _need(type(action) is str and action in self.capabilities and type(recovery_identity) is str
              and re.fullmatch(r"[a-f0-9]{64}", recovery_identity), "macos_recovery_unqualified")
        _call(self._proof.guard, self.binding, dict(_LOADED_SOURCES))
        _need(self._proof.actions == self.capabilities, "macos_qualification_changed")
        with self.operation_scope(deadline=deadline):
            current = self.observe(readiness.Requirements(frozenset({"guest_agent"})), deadline)
            fields = ("target", "machine", "connection", "boot", "account", "session")
            _need(all(getattr(current, key) == getattr(observed, key) for key in fields), "macos_ready_identity_changed")
            if action == "reboot":
                _need(current.idle_visibility == readiness.IDLE_VISIBILITY and not current.idle_blockers,
                      "macos_idle_proof_incomplete")
            if action == "start": _need(current.guest == "stopped", "macos_power_state_changed")
            if action == "resume": _need(current.guest in {"suspended", "paused"}, "macos_power_state_changed")
            if action == "login":
                _need(current.ordinary_session in {"locked", "signed_out"} and current.display == "ready",
                      "macos_login_screen_unrecognized")
            if action == "wake_display": _need(current.display == "sleeping", "macos_display_state_changed")
            # The source-owned custody method must atomically consume this RID
            # before power/credentials, and only observe it after a lost ACK.
            return _call(self.custody.dispatch_recovery, action, recovery_identity, current, deadline)

    @contextmanager
    def guest_job_executor(self, *, deadline, operation_id=None):
        if operation_id is not None: _uuid(operation_id)
        with self.operation_scope(deadline=deadline):
            observed = self.observe(readiness.Requirements(frozenset({"guest_agent"})), deadline)
            _need(observed.guest_agent and observed.guest == "running", "macos_guest_executor_unavailable")
            yield MacGuestExecutor(self, observed, deadline)

    def vnc_action(self, commands, operation_identity, ready, timeout):
        """Only finite public GUI commands; passwords have a different FD API."""
        operation = _uuid(operation_identity)
        _need(type(timeout) in {int, float} and math.isfinite(timeout) and 0 < timeout <= 600, "macos_gui_deadline_invalid")
        _need(type(commands) in {list, tuple} and 1 <= len(commands) <= 128, "macos_gui_commands_invalid")
        for command in commands:
            _need(type(command) is tuple and command, "macos_gui_commands_invalid")
            if command == ("capture",):
                continue
            if command[0] == "key" and len(command) == 3:
                key, modifiers = command[1:]
                _need(type(key) is str and (key in rfb._PUBLIC_KEYS or len(key) == 1 and 32 <= ord(key) <= 126)
                      and type(modifiers) is tuple and len(modifiers) <= 4
                      and all(type(value) is str and value in rfb._MODIFIERS for value in modifiers)
                      and len(set(modifiers)) == len(modifiers), "macos_gui_commands_invalid")
            elif command[0] == "mouse" and len(command) == 4:
                _need(all(type(value) is int for value in command[1:]) and all(0 <= value <= 4095 for value in command[1:3])
                      and 0 <= command[3] <= 7, "macos_gui_commands_invalid")
            else:
                raise MacBlocked("macos_gui_command_unqualified")
        deadline = time.monotonic() + timeout
        with self.operation_scope(deadline=deadline):
            current = self.revalidate_ready(ready, deadline)
            _need(current.ordinary_session == "ready" and current.display == "ready", "macos_gui_not_ready")
            endpoint = _call(self.custody.gui_endpoint, ready, deadline)
            _need(type(endpoint) is MacGuiEndpoint, "macos_gui_endpoint_unqualified")
            _call(endpoint.guard)
            if ("capture",) in commands:
                _need(_call(endpoint.capture_safe) is True, "macos_capture_private_input_possible")
            result = None
            with rfb.ProtectedVncSession(port=endpoint.port, credential_fd=endpoint.credential_fd,
                                         guard=endpoint.guard, timeout=min(30, timeout, deadline-time.monotonic())) as session:
                for command in commands:
                    _need(type(command) is tuple and command, "macos_gui_commands_invalid")
                    if command == ("capture",):
                        _need(_call(endpoint.capture_safe) is True, "macos_capture_private_input_possible")
                        result = session.capture_png()
                    elif command[0] == "key" and len(command) == 3:
                        session.key(command[1], modifiers=command[2])
                    elif command[0] == "mouse" and len(command) == 4:
                        session.mouse(command[1], command[2], buttons=command[3])
                    else:
                        raise MacBlocked("macos_gui_command_unqualified")
            return {"operationId": operation, "capture": result, "replayAllowed": False}

    def ordinary_account_name(self, ready):
        self.revalidate_ready(ready, time.monotonic() + 30)
        return self.binding.ordinary_account

    def submit_ordinary_credential_from_fd(self, secret_fd, *, operation_identity, observed, journal, timeout=30):
        """Internal login primitive, disabled without original native login proof.

        The provider holds the operator, recognizes the exact account-entry
        screen, and supplies a once journal distinct from VNC authentication.
        The result is UNKNOWN until independent intended-session observation.
        No post-input framebuffer is returned, persisted or hashed here.
        """
        _need("login" in self.capabilities and self._proof is not None, "macos_login_unqualified")
        _call(self._proof.guard, self.binding, dict(_LOADED_SOURCES))
        operation = _uuid(operation_identity)
        _need(type(timeout) in {int, float} and math.isfinite(timeout) and 0 < timeout <= 30,
              "macos_gui_deadline_invalid")
        _need(type(observed) is readiness.Observation and observed.ordinary_session in {"locked", "signed_out"}
              and observed.account == self.binding.ordinary_account, "macos_login_screen_unrecognized")
        deadline = time.monotonic() + timeout
        with self.operation_scope(deadline=deadline):
            current = self.observe(readiness.Requirements(frozenset({"guest_agent"})), deadline)
            fields = ("target", "machine", "connection", "boot", "account", "session")
            _need(all(getattr(current, key) == getattr(observed, key) for key in fields)
                  and current.ordinary_session == observed.ordinary_session, "macos_ready_identity_changed")
            endpoint = _call(self.custody.gui_endpoint, observed, deadline)
            _need(type(endpoint) is MacGuiEndpoint and secret_fd != endpoint.credential_fd, "macos_gui_endpoint_unqualified")
            _call(endpoint.recognized_screen_guard)
            with rfb.ProtectedVncSession(port=endpoint.port, credential_fd=endpoint.credential_fd,
                                         guard=endpoint.guard, timeout=min(timeout, deadline-time.monotonic())) as session:
                return session.type_secret_from_fd(secret_fd, operation_id=operation, journal=journal,
                                                   guard=endpoint.recognized_screen_guard)


@dataclass(frozen=True)
class MacGuiEndpoint:
    """Private provider product; never a public endpoint/credential DTO."""
    port: int
    credential_fd: int
    guard: object
    recognized_screen_guard: object
    capture_safe: object

    def __post_init__(self):
        _need(type(self.port) is int and 1 <= self.port <= 65535 and type(self.credential_fd) is int
              and self.credential_fd >= 3 and all(callable(value) for value in
                  (self.guard, self.recognized_screen_guard, self.capture_safe)), "macos_gui_endpoint_unqualified")


@dataclass(frozen=True)
class MacGuestExecutor:
    _backend: MacTartBackend
    _observed: readiness.Observation
    _deadline: float

    @property
    def provider(self): return "tart-macos"
    @property
    def target(self): return self._observed.target
    @property
    def machine(self): return self._observed.machine
    @property
    def boot(self): return self._observed.boot
    @property
    def uid(self): return self._backend.binding.ordinary_uid
    @property
    def principal(self): return self._backend.binding.ordinary_account
    @property
    def home(self): return self._backend.binding.ordinary_home

    def execute(self, argv, *, payload=None):
        # Guest job protocol is finite canonical Python with public selectors;
        # any source/private bytes travel in the reviewed framed stdin channel.
        _need(type(argv) in {tuple, list} and type(payload) is bytes and 0 < len(payload) <= 262144,
              "macos_guest_program_unqualified")
        try:
            canonical, _ = guest_protocol.stdin_command(payload.decode("utf-8", errors="strict"))
        except Exception:
            raise MacBlocked("macos_guest_program_unqualified") from None
        _need(tuple(argv) == canonical, "macos_guest_program_unqualified")
        ready = readiness.ReadyContext("internal", self.target, self.machine, self._observed.connection, self.boot,
                                       self._observed.account, self._observed.session,
                                       readiness.Requirements(frozenset({"guest_agent"})))
        self._backend.revalidate_ready(ready, self._deadline)
        return _call(self._backend.custody.ordinary_guest_call, self._backend.binding, tuple(argv), payload, self._deadline)
