from pathlib import Path
import base64,hashlib,json,os,subprocess,time,uuid
from agent_tools import ssh_transport as transport,readiness
from agent_tools.native_review_source_closure import _Held
from agent_tools.ssh_source_file_stage_direct import _retain
root=Path.cwd();operation=OPERATION;directory=root/'.runtime/tool-recovery-windows/direct'/('admitted-'+operation);directory.mkdir(mode=0o700)
_retain(directory,'caller.py',CALLER);_retain(directory,'operation.json',{'operationId':operation,'procedure':PROCEDURE,'secretsSubmitted':False})
held=_Held()
try:
 held.read(str(directory/'caller.py'),hashlib.sha256(CALLER).hexdigest(),max_bytes=1048576)
 held.read(str(Path(__file__).absolute()),hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
 with transport.admitted_transport(root,'archlinux',operation,deadline=time.monotonic()+180,requirements=readiness.Requirements(frozenset({'transport'}),frozenset({'reconnect'}))) as admission:
  command=['python3','-I','-B','-c','import base64;exec(base64.b64decode('+repr(base64.b64encode(CALLER).decode())+'))']
  argv=transport.build_ssh_argv(transport.load_config(root),'archlinux',command=command)
  held.finish();held.final_identity_pass()
  result=transport.run_ssh(argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=50,check=False)
  _retain(directory,'stdout.private',result.stdout);_retain(directory,'stderr.private',result.stderr);_retain(directory,'callback.json',{'code':result.returncode,'stdoutBytes':len(result.stdout),'stderrBytes':len(result.stderr)})
  held.finish();held.final_identity_pass()
  if result.returncode or len(result.stdout)>1048576 or len(result.stderr)>65536:raise ValueError('original_transport_outcome_unknown')
  value=json.loads(result.stdout);_retain(directory,'result.json',value)
  print(json.dumps({'state':value.get('state'),'operationId':operation,'evidence':str(directory)}))
finally:held.close()
