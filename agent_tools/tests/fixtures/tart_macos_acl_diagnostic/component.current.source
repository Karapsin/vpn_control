 reasons={'permission_denied','invalid_argument','bad_descriptor','allocation_failed','not_found','attribute_absent','unsupported','other_error','acl_invalid','acl_entry_unavailable','acl_entry_overflow','acl_tag_unavailable','acl_permissions_unavailable','acl_qualifier_unavailable','acl_qualifier_release_failed','acl_flags_unavailable','acl_release_failed','volume_reply_size','volume_reply_length'}
