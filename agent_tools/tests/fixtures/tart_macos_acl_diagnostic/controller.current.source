dinary_account)==(VM,MACHINE,502,\'toolrecovery\'),\'catalog_selected_binding_changed\')\n        deadline=GROUP_DEADLINE\n        with backend.guest_job_executor(deadline=deadline,operation_id=OP)as executor:\n            need(executor.machine==MACHINE and executor.boot==RAW_BOOT and int(executor.uid)==502,\n                 \'catalog_actual_identity_changed\')\n            def root_probe(label):\n                phase[\'value\']=label\n                source=mac_registry.guest_probe_source(backend.binding,prefix=backend.custody.guest_proof[\'prefix\'],\n                    public_files=backend.custody.guest_proof[\'publicFiles\'])\n                if type(source)is str:source=source.encode()\n                record(label+\'.source.py\',source)\n                argv,payload=protocol.stdin_command(source.decode());guard()\n                request_record(out,label,argv,payload);guard()\n                result=executor.execute(argv,payload=payload)\n                callback_record(out,label,result);guard()\n                need(result.returncode==0 and not result.stderr,\'catalog_root_observer_failed\')\n                packet=parse(result.stdout);need(type(packet)is dict and set(packet)=={\'facts\',\'agent\'},\'catalog_root_reply_invalid\')\n                mac.guest_facts(packet[\'facts\'],backend.binding)\n                need(packet[\'facts\'][\'machine\']==MACHINE and packet[\'agent\'][\'rawBoot\']==RAW_BOOT,\n                     \'catalog_root_identity_changed\')\n                record(label+\'.result.json\',{\'returncode\':result.returncode,\'stdoutBytes\':len(result.stdout),\n                    \'stdoutSha256\':hashlib.sha256(result.stdout).hexdigest(),\'stderrBytes\':0})\n                return packet\n            before=root_probe(\'root-before\');actor=before[\'agent\'][\'actor\']\n            _,seconds,microseconds=actor[\'birth\'].split(\':\')\n            agent=(actor[\'pid\'],502,1,int(seconds),int(microseconds))\n            sources={Path(path).name:raw for path,raw in session.cache.values()if Path(path).name in producer.PINS}\n            need(set(sources)==set(producer.PINS),\'catalog_captured_sources_missing\')\n            source=producer.build(sources,agent,component_source.body)\n            record(\'catalog.source.py\',source);record(\'catalog-admission.json\',{\'operationId\':OP,\n                \'sourceSha256\':hashlib.sha256(source).hexdigest(),\'agent\':actor,\'actualRawBoot\':RAW_BOOT})\n            record(\'source-capsule-before.json\',{\'sources\':[{ \'path\':path,\'sha256\':hashlib.sha256(raw).hexdigest()}\n                for path,raw in session.cache.values()]})\n            phase[\'value\']=\'catalog\'\n            guard();argv,payload=protocol.stdin_command(source.decode())\n            request_record(out,\'catalog\',argv,payload);guard()\n            result=executor.execute(argv,payload=payload)\n            callback_record(out,\'catalog\',result);guard()\n            after=root_probe(\'root-after\')\n            need(after[\'agent\']==before[\'agent\'],\'catalog_agent_generation_changed\')\n        envelope=parse(result.stdout)\n        need(type(envelope)is dict and \'public\'in envelope and set(envelope)<= {\'public\',\'privateComponentProof\'}\n             and type(envelope[\'public\'])is dict,\'catalog_target_reply_invalid\')\n        if \'privateComponentProof\'in envelope:\n            proof=envelope[\'privateComponentProof\']\n            need(type(proof)is dict and set(proof)=={\'schemaVersion\',\'kind\',\'originalFailureProofSha256\',\'credentials\',\'items\'}\n                 and proof[\'schemaVersion\']==1 and proof[\'kind\']==\'private_exact_component_acl_volume\'and proof[\'originalFailureProofSha256\']==producer.PROOF_SHA\n                 and type(proof[\'items\'])is list and len(proof[\'items\'])<=64\n                 and len(json.dumps(proof).encode())<=1048576,\'catalog_private_proof_invalid\')\n            record(\'private-component-acl-metadata.json\',proof)\n        # Raw stdout/private artifact stay600. Only finite public summary is\n        # parsed into result.json or printed; never print the raw envelope.\n        value=public_reply(envelope,producer)\n        record(\'source-capsule-closed.json\',{\'sources\':[{ \'path\':path,\'sha256\':hashlib.sha256(raw).hexdigest()}\n            for path,raw in session.cache.values()]})\n        record(\'native-rpc-closure.json\',{\'actors\':[value[\'actor\']for value in native_calls],\'allOriginalActorsAbsent\':all(jobs._birth(value[\'actor\'][\'pid\'])!=value[\'actor\'][\'birth\']for value in native_calls),\'allRawEof\':all(value[\'stdoutEof\']and value[\'stderrEof\']for value in native_calls),\'dispatchCount\':len(native_calls)})\n        record(\'result.json\',{\'schemaVersion\':1,\'operationId\':OP,\'returncode\':result.returncode,\n            \'stderrBytes\':len(result.stderr),\'reply\':value,\'inputSubmitted\':False,\'powerSubmitted\':False,\n            \'rootInstalled\':False,\'idleAuthority\':False})\n        print(json.dumps({\'operationId\':OP,\'folder\':str(RUN/name),\'returncode\':result.returncode,\'reply\':value},sort_keys=True))\nif __name__==\'__main__\':main()\n'
