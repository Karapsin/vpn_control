JOB_RAW=b'"""Internal POSIX durable execution owner for fixed, trusted Python adapters.\n\nThis is not a public command API. An adapter owns its reviewed ``Program`` and\nmachine admission; callers must not turn user input into program source. No\ncredentials, caller environment or interactive input are accepted. Streams are\nprivate and are never included in status or exception messages.\n\nCopy ``owner_source()`` to the admitted remote host and use these same functions\nthere. Submit once using a pre-recorded operation UUID, then reconnect through\n``observe``/``collect``. A consumed admission without a terminal receipt is never\nreplayed. Missing records only prove non-submission on the same verified private\nroot; replacing or losing that root invalidates that proof. The caller must pin\nits root generation across connections. There is deliberately no kill API.\n\nCapability: POSIX Linux and Darwin process generations. Other platforms refuse\nbefore admission. Native SSH, Windows and provider acceptance remain separate.\n"""\nfrom __future__ import annotations\n\nfrom dataclasses import asdict, dataclass\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport selectors\nimport stat\nimport subprocess\nimport sys\nimport time\nimport threading\nimport uuid\nfrom typing import Any\n\nMAX_PROGRAM_BYTES = 8 * 1024 * 1024\nMAX_STREAM_BYTES = 4 * 1024 * 1024\nMAX_RECORD_BYTES = 16_384\n_TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\\Z")\n_HEX = re.compile(r"[0-9a-f]{64}\\Z")\n\n\nclass DurableJobError(ValueError):\n    """Finite public reason only; never attach a raw private exception."""\n\n\ndef _need(condition: bool, reason: str) -> None:\n    if not condition:\n        raise DurableJobError(reason)\n\n\ndef _uuid(value: str) -> str:\n    try:\n        _need(type(value) is str and str(uuid.UUID(value)) == value, "operation_identity_invalid")\n    except (ValueError, AttributeError, TypeError):\n        raise DurableJobError("operation_identity_invalid") from None\n    return value\n\n\ndef _token(value: str) -> str:\n    _need(type(value) is str and bool(_TOKEN.fullmatch(value)), "binding_invalid")\n    return value\n\n\n@dataclass(frozen=True)\nclass MachineBinding:\n    target: str\n    machine: str\n    boot: str\n    account: str\n\n    def __post_init__(self) -> None:\n        for value in asdict(self).values():\n            _token(value)\n\n    @classmethod\n    def from_dict(cls, value: dict[str, str]) -> "MachineBinding":\n        _need(type(value) is dict and set(value) == {"target", "machine", "boot", "account"}, "binding_invalid")\n        return cls(**value)\n\n\n@dataclass(frozen=True)\nclass Program:\n    """Trusted adapter-owned source; private input must use a separate channel."""\n    purpose: str\n    source: bytes\n    stream_limit: int = 1024 * 1024\n\n    def __post_init__(self) -> None:\n        _token(self.purpose)\n        _need(type(self.source) is bytes and 0 < len(self.source) <= MAX_PROGRAM_BYTES, "program_invalid")\n        _need(type(self.stream_limit) is int and 1 <= self.stream_limit <= MAX_STREAM_BYTES, "stream_limit_invalid")\n        try:\n            compile(self.source, "fixed-purpose-program", "exec")\n        except (SyntaxError, ValueError, UnicodeError):\n            raise DurableJobError("program_invalid") from None\n\n    @property\n    def digest(self) -> str:\n        return hashlib.sha256(self.source).hexdigest()\n\n\ndef _boot() -> str:\n    if sys.platform.startswith("linux"):\n        try:\n            return _token(Path("/proc/sys/kernel/random/boot_id").read_text().strip())\n        except (OSError, ValueError):\n            raise DurableJobError("boot_identity_unavailable") from None\n    if sys.platform == "darwin":\n        try:\n            result = subprocess.run(["/usr/sbin/sysctl", "-n", "kern.bootsessionuuid"],\n                                    capture_output=True, timeout=3, check=True)\n            return _token(result.stdout.decode("ascii").strip())\n        except (OSError, ValueError, subprocess.SubprocessError):\n            raise DurableJobError("boot_identity_unavailable") from None\n    raise DurableJobError("platform_unsupported")\n\n\ndef current_binding(target: str, machine: str) -> MachineBinding:\n    """``machine`` must come from the coordinator\'s trusted target admission."""\n    _need(os.name == "posix", "platform_unsupported")\n    return MachineBinding(target, machine, _boot(), str(os.geteuid()))\n\n\ndef _birth(pid: int) -> str | None:\n    if sys.platform.startswith("linux"):\n        try:\n            tail = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()\n            return None if tail[0] == "Z" else "linux:" + str(int(tail[19]))\n        except (OSError, IndexError, ValueError):\n            return None\n    if sys.platform == "darwin":\n        try:\n            # proc_bsdinfo, XNU sys/proc_info.h. Kernel start microseconds are\n            # required; ps/lstart\'s one-second resolution cannot prevent reuse.\n            import ctypes\n            class BsdInfo(ctypes.Structure):\n                _fields_ = [("head", ctypes.c_uint32 * 12), ("comm", ctypes.c_char * 16),\n                            ("name", ctypes.c_char * 32), ("tail", ctypes.c_uint32 * 6),\n                            ("seconds", ctypes.c_uint64), ("microseconds", ctypes.c_uint64)]\n            library = ctypes.CDLL("/usr/lib/libproc.dylib")\n            function = library.proc_pidinfo\n            function.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]\n            function.restype = ctypes.c_int\n            info = BsdInfo()\n            count = function(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info))\n            if count != ctypes.sizeof(info) or info.head[3] != pid or info.head[1] == 5:\n                return None\n            return f"darwin:{info.seconds}:{info.microseconds}"\n        except (OSError, ValueError, AttributeError):\n            return None\n    return None\n\n\ndef _private(path: Path, *, directory: bool) -> os.stat_result:\n    try:\n        info = path.lstat()\n    except OSError:\n        raise DurableJobError("private_state_unavailable") from None\n    expected = stat.S_ISDIR if directory else stat.S_ISREG\n    _need(expected(info.st_mode) and info.st_uid == os.geteuid()\n          and stat.S_IMODE(info.st_mode) == (0o700 if directory else 0o600)\n          and (directory or info.st_nlink == 1), "private_state_unsafe")\n    return info\n\n\ndef _root(path: Path | str, generation: tuple[int, int] | None = None) -> Path:\n    path = Path(path)\n    _need(path.is_absolute() and ".." not in path.parts, "root_invalid")\n    info = _private(path, directory=True)\n    _need(path.resolve() == path, "root_invalid")\n    if generation is not None:\n        _need(tuple(generation) == (info.st_dev, info.st_ino), "root_generation_changed")\n    return path\n\n\ndef root_generation(path: Path | str) -> tuple[int, int]:\n    """Pin durably outside the transport before the first submission."""\n    path = _root(path)\n    info = path.stat()\n    return info.st_dev, info.st_ino\n\n\ndef _sync_directory(path: Path) -> None:\n    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n    try:\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n\ndef _create(path: Path, raw: bytes) -> None:\n    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    with os.fdopen(fd, "wb") as stream:\n        stream.write(raw)\n        stream.flush()\n        os.fsync(stream.fileno())\n    _sync_directory(path.parent)\n\n\ndef _publish(path: Path, value: dict[str, Any]) -> None:\n    temp = path.with_name(path.name + "." + str(uuid.uuid4()) + ".tmp")\n    _create(temp, json.dumps(value, sort_keys=True, separators=(",", ":")).encode())\n    # Receipt names are single-writer; link creates them without replacing a\n    # pre-existing terminal receipt or adopting an unrelated file.\n    os.link(temp, path, follow_symlinks=False)\n    temp.unlink()\n    _sync_directory(path.parent)\n\n\ndef _read(path: Path, limit: int) -> bytes:\n    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)\n    with os.fdopen(fd, "rb") as stream:\n        info = os.fstat(stream.fileno())\n        _need(stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid()\n              and stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == 1\n              and info.st_size <= limit, "private_state_unsafe")\n        raw = stream.read(limit + 1)\n    _need(len(raw) <= limit, "private_state_oversized")\n    return raw\n\n\ndef _record(path: Path) -> dict[str, Any]:\n    try:\n        def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:\n            value: dict[str, Any] = {}\n            for key, item in rows:\n                _need(key not in value, "record_invalid")\n                value[key] = item\n            return value\n        value = json.loads(_read(path, MAX_RECORD_BYTES), object_pairs_hook=pairs)\n        _need(type(value) is dict, "record_invalid")\n        return value\n    except (OSError, ValueError, UnicodeError):\n        raise DurableJobError("record_unavailable") from None\n\n\ndef _binding_live(binding: MachineBinding) -> None:\n    _need(binding.account == str(os.geteuid()), "account_changed")\n    _need(binding.boot == _boot(), "boot_changed")\n\n\ndef _intent(path: Path, operation_id: str, binding: MachineBinding) -> dict[str, Any]:\n    value = _record(path / "intent.json")\n    _need(set(value) == {"schemaVersion", "operationId", "binding", "purpose", "programSha256", "streamLimit", "generation"}\n          and value["schemaVersion"] == 1 and value["operationId"] == operation_id,\n          "intent_invalid")\n    actual = MachineBinding.from_dict(value["binding"])\n    _need(actual == binding, "operation_binding_mismatch")\n    _token(value["purpose"])\n    _uuid(value["generation"])\n    _need(type(value["programSha256"]) is str and bool(_HEX.fullmatch(value["programSha256"])), "intent_invalid")\n    _need(type(value["streamLimit"]) is int and 1 <= value["streamLimit"] <= MAX_STREAM_BYTES, "intent_invalid")\n    return value\n\n\ndef _base(operation_id: str, state: str, reason: str) -> dict[str, Any]:\n    return {"schemaVersion": 1, "operationId": operation_id, "state": state,\n            "reason": reason, "replayAllowed": False}\n\n\ndef _correlate(value: dict[str, Any], intent: dict[str, Any]) -> None:\n    _need(value.get("operationId") == intent["operationId"] and value.get("generation") == intent["generation"]\n          and value.get("binding") == intent["binding"] and value.get("programSha256") == intent["programSha256"],\n          "owner_identity_mismatch")\n\n\ndef _owner_identity(owner: dict[str, Any]) -> dict[str, Any]:\n    _need(set(owner) == {"operationId", "generation", "binding", "programSha256", "owner"}, "owner_identity_invalid")\n    identity = owner.get("owner")\n    _need(type(identity) is dict and set(identity) == {"pid", "birth"} and type(identity["pid"]) is int\n          and identity["pid"] > 0 and type(identity["birth"]) is str and len(identity["birth"]) <= 128,\n          "owner_identity_invalid")\n    return identity\n\n\ndef observe(root: Path | str, operation_id: str, binding: MachineBinding, *,\n            generation: tuple[int, int]) -> dict[str, Any]:\n    """Read-only status. A new connection must retain the same root generation."""\n    operation_id = _uuid(operation_id)\n    try:\n        root = _root(root, generation)\n        job = root / operation_id\n        if not job.exists() and not job.is_symlink():\n            _binding_live(binding)\n            return _base(operation_id, "unsubmitted", "admission_absent")\n        _private(job, directory=True)\n        intent = _intent(job, operation_id, binding)\n        receipt = job / "terminal.json"\n        if receipt.exists() or receipt.is_symlink():\n            value = _record(receipt)\n            _correlate(value, intent)\n            _need(set(value) == {"operationId", "generation", "binding", "programSha256", "owner",\n                                 "exitCode", "streamsClosed", "stdout", "stderr"}\n                  and type(value.get("exitCode")) is int and value.get("streamsClosed") is True,\n                  "terminal_invalid")\n            owner = _record(job / "owner.json")\n            _correlate(owner, intent)\n            _owner_identity(owner)\n            _need(value.get("owner") == owner.get("owner"), "owner_identity_mismatch")\n            for name in ("stdout", "stderr"):\n                stream = value.get(name)\n                _need(type(stream) is dict and set(stream) == {"overflow", "retainedBytes", "totalBytes", "sha256"}\n                      and type(stream.get("overflow")) is bool\n                      and type(stream.get("retainedBytes")) is int and 0 <= stream["retainedBytes"] <= intent["streamLimit"]\n                      and type(stream.get("totalBytes")) is int and stream["totalBytes"] >= stream["retainedBytes"]\n                      and type(stream.get("sha256")) is str and bool(_HEX.fullmatch(stream["sha256"])), "terminal_invalid")\n            result = _base(operation_id, "unknown" if value["stdout"]["overflow"] or value["stderr"]["overflow"] else "terminal",\n                           "output_overflow" if value["stdout"]["overflow"] or value["stderr"]["overflow"] else "correlated_terminal")\n            result.update(binding=intent["binding"], owner=value["owner"], terminal=value)\n            return result\n        _binding_live(binding)\n        owner = _record(job / "owner.json")\n        _correlate(owner, intent)\n        identity = _owner_identity(owner)\n        if _birth(identity["pid"]) == identity["birth"]:\n            result = _base(operation_id, "running", "original_owner_running")\n            result.update(binding=intent["binding"], owner=identity)\n            return result\n        return _base(operation_id, "unknown", "original_owner_missing")\n    except (OSError, DurableJobError) as error:\n        reason = str(error) if isinstance(error, DurableJobError) else "observation_unavailable"\n        return _base(operation_id, "unknown", reason)\n\n\ndef submit(root: Path | str, operation_id: str, binding: MachineBinding, program: Program, *,\n           generation: tuple[int, int]) -> dict[str, Any]:\n    """Admit at most once. Duplicate submission only observes the original job.\n\n    Any failure after create-only directory admission consumes the operation;\n    even a lost owner launch is UNKNOWN. A subsequent caller may only observe.\n    """\n    operation_id = _uuid(operation_id)\n    root = _root(root, generation)\n    _binding_live(binding)\n    job = root / operation_id\n    try:\n        job.mkdir(mode=0o700)\n    except FileExistsError:\n        result = observe(root, operation_id, binding, generation=generation)\n        try:\n            original = _intent(job, operation_id, binding)\n            _need(original["purpose"] == program.purpose and original["programSha256"] == program.digest\n                  and original["streamLimit"] == program.stream_limit, "operation_program_mismatch")\n        except (OSError, DurableJobError):\n            return _base(operation_id, "unknown", "operation_admission_conflict")\n        return result\n    try:\n        _sync_directory(root)\n        intent = {"schemaVersion": 1, "operationId": operation_id, "binding": asdict(binding),\n                  "purpose": program.purpose, "programSha256": program.digest,\n                  "streamLimit": program.stream_limit, "generation": str(uuid.uuid4())}\n        _publish(job / "intent.json", intent)\n        _create(job / "program.py", program.source)\n        _create(job / "owner.py", owner_source())\n        # Everything is durably admitted before one launch; no SSH/client file\n        # descriptor survives in the detached owner or its child.\n        process = subprocess.Popen([sys.executable, "-I", "-B", str(job / "owner.py"), "--own", str(job)],\n                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n                                   close_fds=True, start_new_session=True, env={"PATH": os.defpath})\n        # Reap the short-lived process if already terminal. Long-running owners\n        # belong to the OS, not the submitting connection. Popen deliberately\n        # must not be used as a context manager (which waits on disconnect).\n        # A daemon reaper retains this same Popen handle without tying the\n        # detached job\'s lifetime to the submitting client/server.\n        try:\n            threading.Thread(target=process.wait, daemon=True, name="durable-job-reaper").start()\n        except RuntimeError:\n            # Failed thread creation must not lose or replace the original\n            # process. Waiting is safe although this exceptional path is slow.\n            process.wait()\n    except (OSError, DurableJobError):\n        return _base(operation_id, "unknown", "admission_consumed")\n    return observe(root, operation_id, binding, generation=generation)\n\n\ndef collect(root: Path | str, operation_id: str, binding: MachineBinding, *,\n            generation: tuple[int, int]) -> tuple[dict[str, Any], bytes, bytes]:\n    """Collect complete private streams only after the original terminal receipt."""\n    status = observe(root, operation_id, binding, generation=generation)\n    _need(status["state"] == "terminal", "collection_not_terminal")\n    job = _root(root, generation) / _uuid(operation_id)\n    streams: list[bytes] = []\n    for name in ("stdout", "stderr"):\n        try:\n            raw = _read(job / (name + ".bin"), MAX_STREAM_BYTES)\n        except OSError:\n            raise DurableJobError("stream_unavailable") from None\n        expected = status["terminal"][name]\n        _need(len(raw) == expected["retainedBytes"] == expected["totalBytes"]\n              and hashlib.sha256(raw).hexdigest() == expected["sha256"], "stream_integrity_mismatch")\n        streams.append(raw)\n    return status, streams[0], streams[1]\n\n\ndef owner_source() -> bytes:\n    """Self-contained source snapshot for saved-script transfer, never argv."""\n    return Path(__file__).read_bytes()\n\n\ndef _own(job: Path) -> int:\n    """Detached single owner. Errors disclose no source, inputs or raw streams."""\n    os.umask(0o077)\n    try:\n        _private(job, directory=True)\n        original = _record(job / "intent.json")\n        binding = MachineBinding.from_dict(original["binding"])\n        intent = _intent(job, job.name, binding)\n        _binding_live(binding)\n        source = _read(job / "program.py", MAX_PROGRAM_BYTES)\n        _need(hashlib.sha256(source).hexdigest() == intent["programSha256"], "program_integrity_mismatch")\n        birth = _birth(os.getpid())\n        _need(birth is not None, "owner_generation_unavailable")\n        identity = {"pid": os.getpid(), "birth": birth}\n        correlation = {key: intent[key] for key in ("operationId", "binding", "programSha256", "generation")}\n        _publish(job / "owner.json", {**correlation, "owner": identity})\n        # This create-only child launch fence also protects against accidental\n        # second owner invocation, including after owner/client death.\n        _create(job / "child-admission", b"consumed\\n")\n        files = {name: os.fdopen(os.open(job / (name + ".bin"), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600), "wb")\n                 for name in ("stdout", "stderr")}\n        counts = {name: {"retainedBytes": 0, "totalBytes": 0, "sha256": hashlib.sha256()} for name in files}\n        # Snapshot source is transferred privately through stdin; it is never\n        # placed in argv and the payload sees EOF. No inherited environment.\n        bootstrap = "import sys; s=sys.stdin.buffer.read(); exec(compile(s,\'fixed-purpose-program\',\'exec\'),{\'__name__\':\'__main__\'})"\n        child = subprocess.Popen([sys.executable, "-I", "-B", "-c", bootstrap], stdin=subprocess.PIPE,\n                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, close_fds=True,\n                                 start_new_session=True, env={"PATH": os.defpath})\n        assert child.stdin is not None and child.stdout is not None and child.stderr is not None\n        child.stdin.write(source)\n        child.stdin.close()\n        selector = selectors.DefaultSelector()\n        selector.register(child.stdout, selectors.EVENT_READ, "stdout")\n        selector.register(child.stderr, selectors.EVENT_READ, "stderr")\n        while selector.get_map():\n            for key, _ in selector.select(timeout=1):\n                chunk = os.read(key.fileobj.fileno(), 65536)\n                name = key.data\n                if not chunk:\n                    selector.unregister(key.fileobj)\n                    key.fileobj.close()\n                    continue\n                row = counts[name]\n                row["totalBytes"] += len(chunk)\n                retained = chunk[:max(0, intent["streamLimit"] - row["retainedBytes"])]\n                files[name].write(retained)\n                row["retainedBytes"] += len(retained)\n                row["sha256"].update(retained)\n        selector.close()\n        code = child.wait()\n        for stream in files.values():\n            stream.flush()\n            os.fsync(stream.fileno())\n            stream.close()\n        output = {name: {**row, "sha256": row["sha256"].hexdigest(),\n                         "overflow": row["totalBytes"] > row["retainedBytes"]} for name, row in counts.items()}\n        _publish(job / "terminal.json", {**correlation, "owner": identity, "exitCode": code,\n                                       "streamsClosed": True, **output})\n        return 0\n    except Exception:\n        # No terminal assertion is made after an uncertain launch or incomplete\n        # collection; the consumed admission remains UNKNOWN for reconciliation.\n        return 70\n\n\nif __name__ == "__main__":\n    if len(sys.argv) == 3 and sys.argv[1] == "--own":\n        raise SystemExit(_own(Path(sys.argv[2])))\n    raise SystemExit(64)\n'
LOADER_RAW=b'"""Fresh source-backed native adapter imports with transitive custody.\n\nCompiled captured bytes bypass timestamp-valid .pyc files and process-global\nmodule caches. A private package isolates each request; all consumed local\nsources stay held through calls and are checked before and after effects.\n"""\nfrom __future__ import annotations\nimport contextvars\nfrom contextlib import contextmanager, _GeneratorContextManager\nimport ast,builtins,functools,hashlib,importlib,importlib.abc,importlib.util,inspect,os,re,stat,sys,types,uuid\nfrom pathlib import Path\n\n_LOADED_BYTES=Path(__file__).read_bytes()\n_LOADED_CODE=sys._getframe().f_code\nif _LOADED_CODE!=compile(_LOADED_BYTES,__file__,\'exec\',dont_inherit=True,optimize=sys.flags.optimize):\n    raise ValueError(\'Loaded adapter loader differs from its source\')\n_LOADED_SHA=hashlib.sha256(_LOADED_BYTES).hexdigest()\n_BOOTSTRAP_MAX_BYTES=4*1024**2\n\n\n@contextmanager\ndef _bootstrap_source(path, expected_sha=None):\n    """Authenticate the custody primitive before any of its code can execute."""\n    if os.name==\'nt\':\n        from . import windows_source_custody as windows\n        held=windows.WindowsHeld()\n        try:\n            held.read(str(Path(windows.__file__).absolute()),windows.LOADED_SHA)\n            # This preliminary byte read supplies a digest, never executable\n            # authority. Native held names/handles authenticate it before yield.\n            with path.open(\'rb\') as stream:raw=stream.read(_BOOTSTRAP_MAX_BYTES+1)\n            if not 0<len(raw)<=_BOOTSTRAP_MAX_BYTES:raise ValueError(\'bootstrap_source_bound\')\n            raw=held.read(str(path),expected_sha or hashlib.sha256(raw).hexdigest(),max_bytes=_BOOTSTRAP_MAX_BYTES)\n            held.finish();held.final_identity_pass()\n            yield raw,held.finish\n            held.finish();held.final_identity_pass()\n        finally:held.close()\n        return\n    if os.name!=\'posix\':raise ValueError(\'unsupported_source_bootstrap_platform\')\n    if not path.is_absolute() or \'..\' in path.parts or \'\\\\\' in str(path) or \'\\0\' in str(path):\n        raise ValueError(\'bootstrap_source_path\')\n    descriptors=[];parents=[]\n    structural=lambda info:(info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid)\n    generation=lambda info:(*structural(info),info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns)\n    def bounded_read(fd):\n        os.lseek(fd,0,os.SEEK_SET);parts=[];size=0\n        while size<=_BOOTSTRAP_MAX_BYTES:\n            part=os.read(fd,min(65536,_BOOTSTRAP_MAX_BYTES+1-size))\n            if not part:break\n            parts.append(part);size+=len(part)\n        if not 0<size<=_BOOTSTRAP_MAX_BYTES:raise ValueError(\'bootstrap_source_bound\')\n        return b\'\'.join(parts)\n    try:\n        parent=os.open(\'/\',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW);descriptors.append(parent)\n        parents.append((parent,None,None,structural(os.fstat(parent))))\n        for name in path.parts[1:-1]:\n            fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent);descriptors.append(fd)\n            info=os.fstat(fd)\n            if not stat.S_ISDIR(info.st_mode):raise ValueError(\'bootstrap_source_ancestor\')\n            parents.append((fd,parent,name,structural(info)));parent=fd\n        fd=os.open(path.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent);descriptors.append(fd)\n        info=os.fstat(fd);pin=generation(info)\n        if not stat.S_ISREG(info.st_mode) or info.st_uid!=os.getuid() or info.st_nlink!=1:\n            raise ValueError(\'bootstrap_source_requires_regular_current_uid_single_link\')\n        if not 0<info.st_size<=_BOOTSTRAP_MAX_BYTES:raise ValueError(\'bootstrap_source_bound\')\n        raw=bounded_read(fd)\n        if expected_sha is not None and hashlib.sha256(raw).hexdigest()!=expected_sha:\n            raise ValueError(\'expected_source_bytes_changed\')\n        def guard():\n            if bounded_read(fd)!=raw:raise ValueError(\'bootstrap_source_bytes_changed\')\n            for held,ancestor,name,identity in parents:\n                named=os.lstat(\'/\') if ancestor is None else os.stat(name,dir_fd=ancestor,follow_symlinks=False)\n                if structural(os.fstat(held))!=identity or structural(named)!=identity:\n                    raise ValueError(\'bootstrap_source_ancestor_changed\')\n            if len(raw)!=pin[6] or generation(os.fstat(fd))!=pin or generation(os.stat(path.name,dir_fd=parent,follow_symlinks=False))!=pin:\n                raise ValueError(\'bootstrap_source_generation_changed\')\n        guard();yield raw,guard;guard()\n    finally:\n        for fd in reversed(descriptors):os.close(fd)\n\n\ndef _expected_sources(directory, value):\n    if value is None:return None\n    if os.name!=\'posix\':raise ValueError(\'expected_source_manifest_platform\')\n    if type(value)is not dict or not 0<len(value)<=4096:raise ValueError(\'expected_source_manifest\')\n    roots=(directory,directory.parent/\'scripts\');result={}\n    for name,digest in value.items():\n        if (type(name)is not str or not name.startswith(\'/\') or \'\\\\\'in name or \'\\0\'in name\n                or any(part in (\'\',\'.\',\'..\')for part in name.split(\'/\')[1:])\n                or not any(Path(name).is_relative_to(root)for root in roots)\n                or type(digest)is not str or re.fullmatch(\'[0-9a-f]{64}\',digest)is None):\n            raise ValueError(\'expected_source_manifest_entry\')\n        result[name]=digest\n    if str(directory/\'native_review_source_closure.py\')not in result:\n        raise ValueError(\'expected_source_bootstrap_missing\')\n    return result\n\n\nclass _GuardedGeneratorContext:\n    """A source-owned suspended generator retains its original session guard."""\n    def __init__(self, session, context):\n        self.session,self.context,self.entered,self.closed=session,context,False,False\n    def __enter__(self):\n        self.session.guard()\n        if self.entered or self.closed:raise ValueError(\'adapter_context_already_consumed\')\n        result=self.context.__enter__();self.entered=True\n        try:\n            self.session.guard();result=self.session.hold_result(result);self.session.guard()\n            return result\n        except BaseException:\n            self.__exit__(*sys.exc_info())\n            raise\n    def __exit__(self,*error):\n        if not self.entered or self.closed:raise ValueError(\'adapter_context_not_entered\')\n        try:return self.context.__exit__(*error)\n        finally:\n            self.closed=True\n            self.session.guard()\n\n\nclass SourceSession:\n    def __init__(self,directory,entry,*,expected_sources=None):\n        if type(entry)is not str or not entry.isidentifier():raise ValueError(\'adapter_module_name\')\n        self.directory=Path(directory).absolute();self.expected_sources=_expected_sources(self.directory,expected_sources);self.prefix=\'_vpn_source_\'+uuid.uuid4().hex\n        self.cache={};self.closed=False;self.finder=None;self.held=None;self.instrumented=set();self.original_sys_path=tuple(sys.path)\n        package=types.ModuleType(self.prefix);package.__path__=[];sys.modules[self.prefix]=package\n        scripts=types.ModuleType(self.prefix+\'._scripts\');scripts.__path__=[];sys.modules[scripts.__name__]=scripts\n        try:\n            path=self.directory/\'native_review_source_closure.py\'\n            expected=self.expected_sources[str(path)] if self.expected_sources is not None else None\n            with _bootstrap_source(path,expected) as (raw,bootstrap_guard):\n                custody=types.ModuleType(self.prefix+\'.native_review_source_closure\');custody.__file__=str(path);custody.__package__=self.prefix\n                sys.modules[custody.__name__]=custody;code=compile(raw,str(path),\'exec\',dont_inherit=True)\n                bootstrap_guard();exec(code,custody.__dict__);bootstrap_guard()\n                if os.name==\'nt\':\n                    from . import windows_source_custody as windows\n                    self.held=windows.WindowsHeld()\n                    self.held.read(str(Path(windows.__file__).absolute()),windows.LOADED_SHA)\n                else:self.held=custody._Held()\n                self.held.read(str(path),hashlib.sha256(raw).hexdigest(),max_bytes=_BOOTSTRAP_MAX_BYTES)\n                self.held.finish();self.held.final_identity_pass()\n            self.held.read(str(Path(__file__).absolute()),_LOADED_SHA)\n            self.cache[custody.__name__]=(str(path),raw)\n            inspect_view=types.ModuleType(\'inspect\');inspect_view.__dict__.update(vars(inspect))\n            def lines(target):\n                module=getattr(target,\'__module__\',getattr(target,\'__name__\',\'\'))\n                if not module.startswith(self.prefix+\'.\'):return inspect.getsourcelines(target)\n                name=module;path,body=self.cache[name]\n                if inspect.ismodule(target):return body.decode().splitlines(True),1\n                node=ast.parse(body)\n                for part in target.__qualname__.split(\'.\'):\n                    matches=[n for n in node.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)) and n.name==part]\n                    if len(matches)!=1:raise ValueError(\'adapter_source_target\')\n                    node=matches[0]\n                first=min([node.lineno]+[d.lineno for d in node.decorator_list])\n                return body.decode().splitlines(True)[first-1:node.end_lineno],first\n            inspect_view.getsourcelines=lines;inspect_view.getsource=lambda target:\'\'.join(lines(target)[0])\n            import_view=types.ModuleType(\'importlib\');import_view.__dict__.update(vars(importlib))\n            def script_alias(name):\n                if (type(name)is str and name.isidentifier() and name not in sys.stdlib_module_names\n                        and (self.directory.parent/\'scripts\'/(name+\'.py\')).is_file()):\n                    return self.prefix+\'._scripts.\'+name\n                return None\n            def import_module(name,package=None):\n                if name==\'agent_tools\':name=self.prefix\n                elif name.startswith(\'agent_tools.\'):name=self.prefix+name[len(\'agent_tools\'):]\n                elif name==\'scripts\' or name.startswith(\'scripts.\'):name=self.prefix+\'._scripts\'+name[len(\'scripts\'):]\n                if package==\'agent_tools\':package=self.prefix\n                name=script_alias(name) or name\n                return importlib.import_module(name,package)\n            import_view.import_module=import_module\n            sys_view=types.ModuleType(\'sys\');sys_view.path=list(sys.path)\n            sys_view.__getattr__=lambda name:getattr(sys,name)\n            def importing(name,globals=None,locals=None,fromlist=(),level=0):\n                if level==0:\n                    if name==\'inspect\':return inspect_view\n                    if name==\'sys\':return sys_view\n                    if name==\'importlib\' or name.startswith(\'importlib.\'):\n                        actual=builtins.__import__(name,globals,locals,fromlist,0)\n                        # Import the requested stdlib submodule before exposing\n                        # our import_module wrapper. A startup snapshot alone\n                        # misses modules first imported later in this request.\n                        for key,value in vars(importlib).items():\n                            if key!=\'import_module\':setattr(import_view,key,value)\n                        return actual if name!=\'importlib\' and fromlist else import_view\n                    if name==\'agent_tools\' or name.startswith(\'agent_tools.\'):\n                        name=self.prefix+name[len(\'agent_tools\'):]\n                    if name==\'scripts\' or name.startswith(\'scripts.\'):\n                        mapped=self.prefix+\'._scripts\'+name[len(\'scripts\'):]\n                        result=builtins.__import__(mapped,globals,locals,fromlist,0)\n                        return result if fromlist else sys.modules[self.prefix+\'._scripts\']\n                    script=script_alias(name)\n                    if script:return builtins.__import__(script,globals,locals,fromlist or (\'*\',),0)\n                return builtins.__import__(name,globals,locals,fromlist,level)\n            owner=self\n            class Loader(importlib.abc.Loader):\n                def create_module(self,spec):return None\n                def exec_module(self,module):\n                    leaf=module.__name__.removeprefix(owner.prefix+\'.\');base=owner.directory\n                    if leaf.startswith(\'_scripts.\'):\n                        leaf=leaf.removeprefix(\'_scripts.\');base=owner.directory.parent/\'scripts\'\n                    if not all(part.isidentifier() for part in leaf.split(\'.\')):raise ImportError(\'undeclared_adapter_module\')\n                    path=base.joinpath(*leaf.split(\'.\'))\n                    path=path/\'__init__.py\' if path.is_dir() else path.with_suffix(\'.py\')\n                    raw=path.read_bytes();digest=hashlib.sha256(raw).hexdigest()\n                    if owner.expected_sources is not None:\n                        if owner.expected_sources.get(str(path))!=digest:raise ValueError(\'expected_source_bytes_changed\')\n                        digest=owner.expected_sources[str(path)]\n                    raw=owner.held.read(str(path),digest);owner.cache[module.__name__]=(str(path),raw)\n                    module.__file__=str(path);module.__builtins__={**vars(builtins),\'__import__\':importing}\n                    owner.guard();exec(compile(raw,str(path),\'exec\',dont_inherit=True),module.__dict__);owner.guard()\n            class Finder(importlib.abc.MetaPathFinder):\n                def find_spec(self,name,path=None,target=None):\n                    if name.startswith(owner.prefix+\'.\'):\n                        leaf=name.removeprefix(owner.prefix+\'.\').removeprefix(\'_scripts.\')\n                        if not all(part.isidentifier() for part in leaf.split(\'.\')):raise ImportError(\'undeclared_adapter_module\')\n                        base=owner.directory.parent/\'scripts\' if name.startswith(owner.prefix+\'._scripts.\') else owner.directory\n                        path=base.joinpath(*leaf.split(\'.\'));is_package=path.is_dir()\n                        if is_package and not (path/\'__init__.py\').is_file():\n                            spec=importlib.machinery.ModuleSpec(name,None,is_package=True);spec.submodule_search_locations=[];return spec\n                        source=path/\'__init__.py\' if is_package else path.with_suffix(\'.py\')\n                        return importlib.util.spec_from_loader(name,Loader(),origin=str(source),is_package=is_package)\n            self.finder=Finder();sys.meta_path.insert(0,self.finder)\n            self.module=importlib.import_module(self.prefix+\'.\'+entry);self.guard()\n        except BaseException:self.close();raise\n    def load(self,entry):\n        if type(entry)is not str or not entry.isidentifier():raise ValueError(\'adapter_module_name\')\n        self.guard();module=importlib.import_module(self.prefix+\'.\'+entry);self.guard();return module\n    def hold_result(self,value,seen=None):\n        if type(value)is _GeneratorContextManager:\n            function=value.func;generator=value.gen\n            name=getattr(function,\'__module__\',\'\');module=sys.modules.get(name)\n            source=self.cache.get(name)\n            if (not name.startswith(self.prefix+\'.\') or source is None or module is None\n                    or not inspect.isgeneratorfunction(function) or not inspect.isgenerator(generator)\n                    or generator.gi_frame is None or generator.gi_frame.f_globals is not vars(module)\n                    or function.__globals__ is not vars(module) or generator.gi_code is not function.__code__):\n                raise ValueError(\'foreign_adapter_context\')\n            path,raw=source\n            def codes(code):\n                yield code\n                for child in code.co_consts:\n                    if isinstance(child,types.CodeType):yield from codes(child)\n            if function.__code__ not in codes(compile(raw,path,\'exec\',dont_inherit=True)):\n                raise ValueError(\'foreign_adapter_context\')\n            self.guard()\n            return _GuardedGeneratorContext(self,value)\n        # A list-compatible inline carrier also holds a saved-plan capability.\n        # Ordinary container traversal cannot see that attribute. Keep both the\n        # carrier methods and its retained plan under this request\'s custody.\n        if (isinstance(value,list) and type(value).__name__==\'BoundInlineArgv\' and\n                type(value).__module__==self.prefix+\'.ssh_transport\'):\n            self.instrument(type(value))\n            self.hold_result(value.saved_plan)\n            self.hold_result(value.dispatch_admission)\n        if isinstance(value,(dict,list,tuple,set,frozenset,types.MappingProxyType)):\n            seen=set() if seen is None else seen\n            if id(value) in seen:return value\n            seen.add(id(value))\n            children=value.values() if isinstance(value,(dict,types.MappingProxyType)) else value\n            for item in children:\n                checked=self.hold_result(item,seen)\n                if checked is not item:raise ValueError(\'nested_adapter_capability_requires_guarded_owner\')\n            return value\n        if inspect.isgenerator(value) or inspect.isasyncgen(value):raise ValueError(\'lazy_adapter_results_require_explicit_custody\')\n        if inspect.ismodule(value) and value.__name__.startswith(self.prefix+\'.\'):\n            proxy=Adapter.__new__(Adapter);proxy._owned=False;proxy._session=self;proxy._module=value\n            proxy.__name__=\'agent_tools.\'+value.__name__.removeprefix(self.prefix+\'.\')\n            return proxy\n        cls=value if inspect.isclass(value) else type(value)\n        if (getattr(cls,\'__module__\',\'\').startswith(self.prefix+\'.\') and cls.__module__!=self.prefix+\'.native_review_source_closure\'\n                and not issubclass(cls,BaseException)):\n            self.instrument(cls)\n        elif callable(value) and not inspect.isclass(value):return self.wrap(value)\n        return value\n    def wrap(self,function,*,cleanup=False,destructor=False):\n        session=self\n        if inspect.isgeneratorfunction(function) or inspect.isasyncgenfunction(function):\n            def rejected(*args,**kwargs):raise ValueError(\'lazy_adapter_exports_require_explicit_custody\')\n            return rejected\n        if inspect.iscoroutinefunction(function):\n            @functools.wraps(function)\n            async def awaited(*args,**kwargs):\n                if not cleanup:session.guard()\n                try:return session.hold_result(await function(*args,**kwargs))\n                finally:session.guard()\n            return awaited\n        @functools.wraps(function)\n        def call(*args,**kwargs):\n            if not cleanup:session.guard()\n            try:return session.hold_result(function(*args,**kwargs))\n            finally:\n                if destructor:\n                    try:session.guard()\n                    except Exception:pass\n                else:session.guard()\n        return call\n    def instrument(self,cls):\n        if cls in self.instrumented:return\n        self.instrumented.add(cls)\n        for base in cls.__bases__:\n            if getattr(base,\'__module__\',\'\').startswith(self.prefix+\'.\'):self.instrument(base)\n        for name,value in tuple(vars(cls).items()):\n            if inspect.isfunction(value):setattr(cls,name,self.wrap(value,cleanup=name in (\'close\',\'__exit__\',\'__aexit__\',\'__del__\'),destructor=name==\'__del__\'))\n            elif isinstance(value,(staticmethod,classmethod)):setattr(cls,name,type(value)(self.wrap(value.__func__)))\n            elif isinstance(value,property):setattr(cls,name,property(*(self.wrap(f) if f else None for f in (value.fget,value.fset,value.fdel)),doc=value.__doc__))\n    def guard(self):\n        if self.closed:raise ValueError(\'closed_adapter_source\')\n        self.held.finish();self.held.final_identity_pass()\n    def close(self):\n        if not self.closed:\n            self.closed=True\n            if self.finder is not None and self.finder in sys.meta_path:sys.meta_path.remove(self.finder)\n            if self.held is not None:self.held.close()\n            for name in list(sys.modules):\n                if name==self.prefix or name.startswith(self.prefix+\'.\'):sys.modules.pop(name,None)\n\n\nclass Adapter:\n    def __init__(self,directory,entry,*,session=None,expected_sources=None):\n        if session is not None and expected_sources is not None:raise ValueError(\'expected_source_session_already_bound\')\n        self._owned=session is None\n        self._session=SourceSession(directory,entry,expected_sources=expected_sources) if self._owned else session\n        self._module=self._session.module if self._owned else self._session.load(entry)\n        self.__name__=\'agent_tools.\'+entry\n    def __getattr__(self,name):\n        session=self._session;session.guard();value=getattr(self._module,name)\n        if inspect.isclass(value):session.hold_result(value);return value\n        if inspect.isgeneratorfunction(value) or inspect.isasyncgenfunction(value):raise ValueError(\'lazy_adapter_exports_require_explicit_custody\')\n        if inspect.iscoroutinefunction(value):\n            @functools.wraps(value)\n            async def async_call(*args,**kwargs):\n                owner=self\n                return await owner._session.wrap(value)(*args,**kwargs)\n            return async_call\n        if inspect.isfunction(value):\n            @functools.wraps(value)\n            def call(*args,**kwargs):\n                owner=self\n                return owner._session.wrap(value)(*args,**kwargs)\n            return call\n        return value\n    def close(self):\n        if self._owned:self._session.close()\n    def __del__(self):\n        if self.__dict__.get(\'_owned\'):\n            session=self.__dict__.get(\'_session\')\n            if session is not None:\n                try:session.close()\n                except Exception:pass\n\n_ACTIVE=contextvars.ContextVar(\'vpn_control_native_source_request\',default=None)\n\n\nclass RequestSources:\n    def __init__(self,directory,expected_sources=None):\n        self.directory=Path(directory).resolve();self.expected_sources=_expected_sources(self.directory,expected_sources);self.session=None\n    def module(self,entry):\n        if self.session is None:self.session=SourceSession(self.directory,entry,expected_sources=self.expected_sources)\n        return Adapter(self.directory,entry,session=self.session)\n    def guard(self):\n        if self.session is not None:self.session.guard()\n    def close(self):\n        if self.session is not None:self.session.close()\n\n\n@contextmanager\ndef request_scope(directory,*,expected_sources=None):\n    directory=Path(directory).resolve();active=_ACTIVE.get()\n    if active is not None:\n        if active.directory!=directory:raise ValueError(\'adapter_request_root_changed\')\n        if expected_sources is not None and _expected_sources(directory,expected_sources)!=active.expected_sources:\n            raise ValueError(\'expected_source_request_changed\')\n        active.guard();yield;active.guard();return\n    session=RequestSources(directory,expected_sources);token=_ACTIVE.set(session)\n    try:\n        yield\n    finally:\n        try:session.guard()\n        finally:_ACTIVE.reset(token);session.close()\n\ndef adapter(directory,entry,*,expected_sources=None):\n    session=_ACTIVE.get()\n    if session is not None:\n        if session.directory!=Path(directory).resolve():raise ValueError(\'adapter_request_root_changed\')\n        if expected_sources is not None and _expected_sources(session.directory,expected_sources)!=session.expected_sources:\n            raise ValueError(\'expected_source_request_changed\')\n        return session.module(entry)\n    return Adapter(directory,entry,expected_sources=expected_sources)\n'
DRIVER_RAW=b'"""Prepared fixed ordinary catalog GET; dispatch requires coordinator GO."""\nfrom pathlib import Path\nfrom contextlib import ExitStack\nimport hashlib,json,os,stat,sys,time,types,uuid\nfrom agent_tools import source_module_loader as loader\nGROUP_DEADLINE=time.monotonic()+90\nEXECUTING=sys._getframe().f_code\nPROJECT=Path.cwd()\nOP=\'9143d37e-1a30-4773-bb6d-fb6f706bb07b\'\nALIAS=\'tart-macos-independent-observer-namespace-v12\'\nVM=\'vpn-tool-recovery-tart-macos-7686d4aa\'\nRUN=PROJECT/\'.runtime/tool-recovery/tart/macos-existing-start-after-rfb-2d933a39-0fb6-46a4-9fd9-02221d81c4b9\'\nPRODUCER=\'4cb68d4228d395fc272271965a88cdab7a490c372b5b250e7a37ec5f21f71590\'\nPOLICY=\'09d410597ba2bec4f5e8ae74a4a46e0f9dfebde41c806065a69bba38b25e8a1e\'\nMACHINE=\'ecdc399a-8f2b-5410-b85d-e4db56ddc6c1\'\nRAW_BOOT=\'87AC272F-619B-4CC0-B9FC-3E32DAEE5B18\'\ndef need(value,reason):\n    if not value:raise RuntimeError(reason)\ndef parse(raw):\n    def pairs(rows):\n        result={}\n        for key,value in rows:\n            need(key not in result,\'catalog_duplicate_reply\');result[key]=value\n        return result\n    return json.loads(raw,object_pairs_hook=pairs,\n        parse_constant=lambda _:(_ for _ in ()).throw(ValueError(\'catalog_nonfinite_reply\')))\ndef output_record(out,name,raw,limit):\n    """Retain returned public bytes independently of consumed source custody."""\n    need(type(raw)is bytes and len(raw)<=limit,\'catalog_raw_retention_overflow\')\n    need(type(name)is str and \'/\'not in name and name not in {\'.\',\'..\'},\'catalog_raw_name_invalid\')\n    out.guard()\n    fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=out.fd)\n    with os.fdopen(fd,\'wb\')as stream:\n        before=os.fstat(stream.fileno())\n        need(stat.S_ISREG(before.st_mode)and before.st_uid==os.geteuid()and before.st_nlink==1\n             and before.st_mode&0o777==0o600,\'catalog_raw_file_invalid\')\n        need(stream.write(raw)==len(raw),\'catalog_raw_write_incomplete\');stream.flush();os.fsync(stream.fileno())\n        fields=(\'st_dev\',\'st_ino\',\'st_mode\',\'st_nlink\',\'st_uid\',\'st_gid\',\'st_size\',\'st_mtime_ns\',\'st_ctime_ns\')\n        current=os.fstat(stream.fileno());named=os.stat(name,dir_fd=out.fd,follow_symlinks=False)\n        need(current.st_size==len(raw)and all(getattr(current,key)==getattr(named,key)for key in fields),\n             \'catalog_raw_file_changed\')\n    os.fsync(out.fd);out.guard()\ndef request_record(out,label,argv,payload):\n    need(label in {\'catalog\',\'root-before\',\'root-after\'}and type(argv)in {tuple,list}\n         and all(type(value)is str for value in argv)and type(payload)is bytes,\'catalog_raw_request_invalid\')\n    output_record(out,label+\'.request.argv.json\',json.dumps(list(argv),separators=(\',\',\':\')).encode(),65536)\n    output_record(out,label+\'.request.stdin\',payload,262144)\n    context={\'schemaVersion\':1,\'operationId\':OP,\'fixtureId\':ALIAS,\'vmName\':VM,\'machine\':MACHINE,\n        \'actualRawBootRequired\':RAW_BOOT,\'uid\':502,\'kind\':label,\'readOnly\':True,\n        \'guestWallSeconds\':60,\'callerSeconds\':90,\'sourceValidation\':\'pending\',\'semanticValidation\':\'pending\'}\n    output_record(out,label+\'.request-context.json\',json.dumps(context,sort_keys=True).encode(),16384)\ndef callback_record(out,label,result):\n    need(label in {\'catalog\',\'root-before\',\'root-after\'}and type(result.stdout)is bytes\n         and type(result.stderr)is bytes and type(result.returncode)is int,\'catalog_raw_callback_invalid\')\n    limit=8*1024*1024\n    output_record(out,label+\'.stdout.json\',result.stdout[:limit],limit)\n    output_record(out,label+\'.stderr.txt\',result.stderr[:limit],limit)\n    receipt={\'schemaVersion\':1,\'operationId\':OP,\'kind\':label,\'returncode\':result.returncode,\n        \'stdoutBytes\':len(result.stdout),\'stderrBytes\':len(result.stderr),\n        \'stdoutRetainedBytes\':min(len(result.stdout),limit),\'stderrRetainedBytes\':min(len(result.stderr),limit),\n        \'completeRaw\':len(result.stdout)<=limit and len(result.stderr)<=limit,\n        \'sourceValidation\':\'pending\',\'semanticValidation\':\'pending\'}\n    output_record(out,label+\'.callback.json\',json.dumps(receipt,sort_keys=True).encode(),16384)\n    need(receipt[\'completeRaw\'],\'catalog_raw_retention_overflow\')\ndef public_reply(envelope,producer):\n    need(type(envelope)is dict and type(envelope.get(\'public\'))is dict,\'component_public_invalid\')\n    value=envelope[\'public\']\n    if value.get(\'state\')==\'blocked\':\n        need(set(envelope)=={\'public\'}and set(value)=={\'state\',\'reason\'}and value[\'reason\']==\'macos_component_acl_diagnostic_unavailable\',\'component_public_invalid\')\n        return value\n    fields={\'schemaVersion\',\'state\',\'machine\',\'boot\',\'uid\',\'nativeQualified\',\'idleAuthority\',\'targetContentRead\',\'directoryContentsRead\',\'componentAuthentication\',\'namespaceIntegrity\',\'aclEffectiveAccess\',\'rootVolume\',\'uniqueComponentsObserved\',\'componentsVerified\',\'failureCounts\',\'aclAvailableCount\',\'aclEmptyCount\',\'volumeAvailableCount\',\'volumeSealedKnownCount\',\'volumeSealedCount\',\'aclUnavailableReasons\',\'volumeUnavailableReasons\'}\n    need(set(envelope)=={\'public\',\'privateComponentProof\'}and set(value)==fields,\'component_public_invalid\')\n    need(type(value[\'schemaVersion\'])is int and value[\'schemaVersion\']==1 and value[\'state\']==\'diagnostic\'and value[\'machine\']==MACHINE and value[\'boot\']==str(uuid.UUID(RAW_BOOT))and type(value[\'uid\'])is int and value[\'uid\']==502,\'component_public_invalid\')\n    need(all(value[key]is False for key in (\'nativeQualified\',\'idleAuthority\',\'targetContentRead\',\'directoryContentsRead\'))and value[\'componentAuthentication\']==value[\'namespaceIntegrity\']==\'unqualified\'and value[\'aclEffectiveAccess\']==\'not_evaluated\',\'component_public_invalid\')\n    need(value[\'rootVolume\']=={\'rootMount\':\'readonly_apfs_snapshot\',\'authenticatedRootPolicy\':\'enabled\',\'systemIntegrityPolicy\':\'standard\'},\'component_public_invalid\')\n    need(type(value[\'failureCounts\'])is dict and set(value[\'failureCounts\'])==set(producer.REASONS)and all(type(count)is int and 0<=count<=9 for count in value[\'failureCounts\'].values()),\'component_public_invalid\')\n    need(type(value[\'uniqueComponentsObserved\'])is int and value[\'uniqueComponentsObserved\']==len(producer.COMPONENTS)and type(value[\'componentsVerified\'])is int and 0<=value[\'componentsVerified\']<=value[\'uniqueComponentsObserved\'],\'component_public_invalid\')\n    for name in (\'aclAvailableCount\',\'aclEmptyCount\',\'volumeAvailableCount\',\'volumeSealedKnownCount\',\'volumeSealedCount\'):\n        need(type(value[name])is int and 0<=value[name]<=value[\'componentsVerified\'],\'component_public_invalid\')\n    reasons={\'permission_denied\',\'invalid_argument\',\'bad_descriptor\',\'allocation_failed\',\'not_found\',\'attribute_absent\',\'unsupported\',\'other_error\',\'acl_invalid\',\'acl_entry_unavailable\',\'acl_entry_overflow\',\'acl_tag_unavailable\',\'acl_permissions_unavailable\',\'acl_qualifier_unavailable\',\'acl_qualifier_release_failed\',\'acl_flags_unavailable\',\'acl_release_failed\',\'volume_reply_size\',\'volume_reply_length\'}\n    for name in (\'aclUnavailableReasons\',\'volumeUnavailableReasons\'):\n        need(type(value[name])is dict and set(value[name])<=reasons and all(type(count)is int and 1<=count<=value[\'uniqueComponentsObserved\']for count in value[name].values()),\'component_public_invalid\')\n    return value\ndef main():\n    with ExitStack()as held:\n        session=loader.SourceSession(PROJECT/\'agent_tools\',\'readiness_fixture_registry\');held.callback(session.close)\n        private=session.load(\'private_inventory_lock\');protocol=session.load(\'readiness_qemu_jobs\')\n        mac=session.load(\'readiness_tart_macos\');mac_registry=session.load(\'readiness_tart_macos_registry\')\n        session.load(\'tart_macos_probe\');session.load(\'tart_macos_service_census\')\n        session.load(\'tart_macos_active_source_index\')\n        session.held.read(str(PROJECT/\'agent_tools/tool_action_policy.json\'),POLICY)\n        own=held.enter_context(private.Directory(Path(__file__).parent))\n        self_source=held.enter_context(private.Snapshot(own,Path(__file__).name))\n        need(EXECUTING==compile(self_source.body,__file__,\'exec\',dont_inherit=True,optimize=sys.flags.optimize),\n             \'catalog_executed_source_changed\')\n        component_dir=held.enter_context(private.Directory(PROJECT/\'.runtime/tool-recovery/macos-component-acl-diagnostic\'))\n        component_source=held.enter_context(private.Snapshot(component_dir,\'component.py\'))\n        capture_source=held.enter_context(private.Snapshot(component_dir,\'rpc_capture.py\'))\n        need(hashlib.sha256(capture_source.body).hexdigest()==\'bf304127b8a0826363ee8af1cbaef6a8cf35cb8bc4f8e9508d2f55f6a0fe57eb\',\'acl_capture_changed\')\n        capture=types.ModuleType(\'_held_acl_capture\');exec(compile(capture_source.body,str(PROJECT/\'.runtime/tool-recovery/macos-component-acl-diagnostic\'/\'rpc_capture.py\'),\'exec\',dont_inherit=True),capture.__dict__)\n        jobs=session.load(\'durable_remote_job\')\n        need(hashlib.sha256(component_source.body).hexdigest()==PRODUCER,\'catalog_producer_changed\')\n        producer=types.ModuleType(\'_held_catalog_component\');producer.__file__=str(PROJECT/\'.runtime/tool-recovery/macos-component-acl-diagnostic/component.py\')\n        exec(compile(component_source.body,producer.__file__,\'exec\',dont_inherit=True,optimize=sys.flags.optimize),producer.__dict__)\n        prior_dir=held.enter_context(private.Directory(RUN/\'native-symlink-failure-diagnostic-2e635cce-2464-4739-b041-bbeb9e724cd8\'))\n        prior_source=held.enter_context(private.Snapshot(prior_dir,\'private-target-metadata.json\'))\n        need(hashlib.sha256(prior_source.body).hexdigest()==producer.PROOF_SHA,\'component_original_failure_proof_changed\')\n        run_dir=held.enter_context(private.Directory(RUN));name=\'native-component-acl-diagnostic-\'+OP\n        session.guard();run_dir.guard();os.mkdir(name,mode=0o700,dir_fd=run_dir.fd);os.fsync(run_dir.fd);run_dir.guard()\n        out=held.enter_context(private.Directory(RUN/name))\n        def guard():need(time.monotonic()<GROUP_DEADLINE,\'acl_group_deadline\');session.guard();self_source.guard();component_source.guard();capture_source.guard();prior_source.guard();run_dir.guard();out.guard()\n        def record(name,value):\n            guard();raw=value if isinstance(value,bytes)else json.dumps(value,sort_keys=True,separators=(\',\',\':\')).encode()\n            fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=out.fd)\n            with os.fdopen(fd,\'wb\')as f:f.write(raw);f.flush();os.fsync(f.fileno())\n            os.fsync(out.fd);guard()\n        record(\'driver.source.py\',self_source.body)\n        record(\'component.source.py\',component_source.body)\n        record(\'rpc-capture.source.py\',capture_source.body)\n        record(\'original-private-failure-proof.json\',prior_source.body)\n        record(\'intent.json\',{\'schemaVersion\':1,\'operationId\':OP,\'fixtureId\':ALIAS,\'vmName\':VM,\n            \'originalRun\':\'2d933a39-0fb6-46a4-9fd9-02221d81c4b9\',\'producerSha256\':PRODUCER,\n            \'driverSha256\':hashlib.sha256(self_source.body).hexdigest(),\'policySha256\':POLICY,\'guestWallSeconds\':60,\'callerSeconds\':90,\n            \'action\':\'fixed_previously_observed_component_acl_volume_get_only\',\'readOnly\':True,\'idleAuthority\':False,\n            \'namespaceEnrollment\':False,\'input\':False,\'power\':False,\'rootInstallation\':False,\'targetContentRead\':False,\'privateTargetMetadataRetained\':True,\'privatePathsPrinted\':False})\n        phase={\'value\':\'factory\'};nat