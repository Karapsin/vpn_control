"""Prepared fixed ordinary catalog GET; dispatch requires coordinator GO."""
from pathlib import Path
from contextlib import ExitStack
import hashlib,json,os,stat,sys,time,types,uuid
from agent_tools import source_module_loader as loader
GROUP_DEADLINE=time.monotonic()+90
EXECUTING=sys._getframe().f_code
PROJECT=Path.cwd()
OP='46bdb255-92d0-40bb-8893-62e033685645'
ALIAS='tart-macos-independent-observer-namespace-v12'
VM='vpn-tool-recovery-tart-macos-7686d4aa'
RUN=PROJECT/'.runtime/tool-recovery/tart/macos-existing-start-after-rfb-2d933a39-0fb6-46a4-9fd9-02221d81c4b9'
PRODUCER='4cb68d4228d395fc272271965a88cdab7a490c372b5b250e7a37ec5f21f71590'
POLICY='09d410597ba2bec4f5e8ae74a4a46e0f9dfebde41c806065a69bba38b25e8a1e'
MACHINE='ecdc399a-8f2b-5410-b85d-e4db56ddc6c1'
RAW_BOOT='87AC272F-619B-4CC0-B9FC-3E32DAEE5B18'
def need(value,reason):
    if not value:raise RuntimeError(reason)
def parse(raw):
    def pairs(rows):
        result={}
        for key,value in rows:
            need(key not in result,'catalog_duplicate_reply');result[key]=value
        return result
    return json.loads(raw,object_pairs_hook=pairs,
        parse_constant=lambda _:(_ for _ in ()).throw(ValueError('catalog_nonfinite_reply')))
def output_record(out,name,raw,limit):
    """Retain returned public bytes independently of consumed source custody."""
    need(type(raw)is bytes and len(raw)<=limit,'catalog_raw_retention_overflow')
    need(type(name)is str and '/'not in name and name not in {'.','..'},'catalog_raw_name_invalid')
    out.guard()
    fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=out.fd)
    with os.fdopen(fd,'wb')as stream:
        before=os.fstat(stream.fileno())
        need(stat.S_ISREG(before.st_mode)and before.st_uid==os.geteuid()and before.st_nlink==1
             and before.st_mode&0o777==0o600,'catalog_raw_file_invalid')
        need(stream.write(raw)==len(raw),'catalog_raw_write_incomplete');stream.flush();os.fsync(stream.fileno())
        fields=('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns')
        current=os.fstat(stream.fileno());named=os.stat(name,dir_fd=out.fd,follow_symlinks=False)
        need(current.st_size==len(raw)and all(getattr(current,key)==getattr(named,key)for key in fields),
             'catalog_raw_file_changed')
    os.fsync(out.fd);out.guard()
def request_record(out,label,argv,payload):
    need(label in {'catalog','root-before','root-after'}and type(argv)in {tuple,list}
         and all(type(value)is str for value in argv)and type(payload)is bytes,'catalog_raw_request_invalid')
    output_record(out,label+'.request.argv.json',json.dumps(list(argv),separators=(',',':')).encode(),65536)
    output_record(out,label+'.request.stdin',payload,262144)
    context={'schemaVersion':1,'operationId':OP,'fixtureId':ALIAS,'vmName':VM,'machine':MACHINE,
        'actualRawBootRequired':RAW_BOOT,'uid':502,'kind':label,'readOnly':True,
        'guestWallSeconds':60,'callerSeconds':90,'sourceValidation':'pending','semanticValidation':'pending'}
    output_record(out,label+'.request-context.json',json.dumps(context,sort_keys=True).encode(),16384)
def callback_record(out,label,result):
    need(label in {'catalog','root-before','root-after'}and type(result.stdout)is bytes
         and type(result.stderr)is bytes and type(result.returncode)is int,'catalog_raw_callback_invalid')
    limit=8*1024*1024
    output_record(out,label+'.stdout.json',result.stdout[:limit],limit)
    output_record(out,label+'.stderr.txt',result.stderr[:limit],limit)
    receipt={'schemaVersion':1,'operationId':OP,'kind':label,'returncode':result.returncode,
        'stdoutBytes':len(result.stdout),'stderrBytes':len(result.stderr),
        'stdoutRetainedBytes':min(len(result.stdout),limit),'stderrRetainedBytes':min(len(result.stderr),limit),
        'completeRaw':len(result.stdout)<=limit and len(result.stderr)<=limit,
        'sourceValidation':'pending','semanticValidation':'pending'}
    output_record(out,label+'.callback.json',json.dumps(receipt,sort_keys=True).encode(),16384)
    need(receipt['completeRaw'],'catalog_raw_retention_overflow')
def public_reply(envelope,producer):
    need(type(envelope)is dict and type(envelope.get('public'))is dict,'component_public_invalid')
    value=envelope['public']
    if value.get('state')=='blocked':
        need(set(envelope)=={'public'}and set(value)=={'state','reason'}and value['reason']=='macos_component_acl_diagnostic_unavailable','component_public_invalid')
        return value
    fields={'schemaVersion','state','machine','boot','uid','nativeQualified','idleAuthority','targetContentRead','directoryContentsRead','componentAuthentication','namespaceIntegrity','aclEffectiveAccess','rootVolume','uniqueComponentsObserved','componentsVerified','failureCounts','aclAvailableCount','aclEmptyCount','volumeAvailableCount','volumeSealedKnownCount','volumeSealedCount','aclUnavailableReasons','volumeUnavailableReasons'}
    need(set(envelope)=={'public','privateComponentProof'}and set(value)==fields,'component_public_invalid')
    need(type(value['schemaVersion'])is int and value['schemaVersion']==1 and value['state']=='diagnostic'and value['machine']==MACHINE and value['boot']==str(uuid.UUID(RAW_BOOT))and type(value['uid'])is int and value['uid']==502,'component_public_invalid')
    need(all(value[key]is False for key in ('nativeQualified','idleAuthority','targetContentRead','directoryContentsRead'))and value['componentAuthentication']==value['namespaceIntegrity']=='unqualified'and value['aclEffectiveAccess']=='not_evaluated','component_public_invalid')
    need(value['rootVolume']=={'rootMount':'readonly_apfs_snapshot','authenticatedRootPolicy':'enabled','systemIntegrityPolicy':'standard'},'component_public_invalid')
    need(type(value['failureCounts'])is dict and set(value['failureCounts'])==set(producer.REASONS)and all(type(count)is int and 0<=count<=9 for count in value['failureCounts'].values()),'component_public_invalid')
    need(type(value['uniqueComponentsObserved'])is int and value['uniqueComponentsObserved']==len(producer.COMPONENTS)and type(value['componentsVerified'])is int and 0<=value['componentsVerified']<=value['uniqueComponentsObserved'],'component_public_invalid')
    for name in ('aclAvailableCount','aclEmptyCount','volumeAvailableCount','volumeSealedKnownCount','volumeSealedCount'):
        need(type(value[name])is int and 0<=value[name]<=value['componentsVerified'],'component_public_invalid')
    reasons={'permission_denied','invalid_argument','bad_descriptor','allocation_failed','not_found','attribute_absent','unsupported','other_error','acl_invalid','acl_entry_unavailable','acl_entry_overflow','acl_tag_unavailable','acl_permissions_unavailable','acl_qualifier_unavailable','acl_qualifier_release_failed','acl_flags_unavailable','acl_release_failed','volume_reply_size','volume_reply_length'}
    for name in ('aclUnavailableReasons','volumeUnavailableReasons'):
        need(type(value[name])is dict and set(value[name])<=reasons and all(type(count)is int and 1<=count<=value['uniqueComponentsObserved']for count in value[name].values()),'component_public_invalid')
    return value
def main():
    with ExitStack()as held:
        session=loader.SourceSession(PROJECT/'agent_tools','readiness_fixture_registry');held.callback(session.close)
        private=session.load('private_inventory_lock');protocol=session.load('readiness_qemu_jobs')
        mac=session.load('readiness_tart_macos');mac_registry=session.load('readiness_tart_macos_registry')
        session.load('tart_macos_probe');session.load('tart_macos_service_census')
        session.load('tart_macos_active_source_index')
        session.held.read(str(PROJECT/'agent_tools/tool_action_policy.json'),POLICY)
        own=held.enter_context(private.Directory(Path(__file__).parent))
        self_source=held.enter_context(private.Snapshot(own,Path(__file__).name))
        need(EXECUTING==compile(self_source.body,__file__,'exec',dont_inherit=True,optimize=sys.flags.optimize),
             'catalog_executed_source_changed')
        component_dir=held.enter_context(private.Directory(PROJECT/'.runtime/tool-recovery/macos-component-acl-diagnostic'))
        component_source=held.enter_context(private.Snapshot(component_dir,'component.py'))
        capture_source=held.enter_context(private.Snapshot(component_dir,'rpc_capture.py'))
        need(hashlib.sha256(capture_source.body).hexdigest()=='bf304127b8a0826363ee8af1cbaef6a8cf35cb8bc4f8e9508d2f55f6a0fe57eb','acl_capture_changed')
        capture=types.ModuleType('_held_acl_capture');exec(compile(capture_source.body,str(PROJECT/'.runtime/tool-recovery/macos-component-acl-diagnostic'/'rpc_capture.py'),'exec',dont_inherit=True),capture.__dict__)
        jobs=session.load('durable_remote_job')
        need(hashlib.sha256(component_source.body).hexdigest()==PRODUCER,'catalog_producer_changed')
        producer=types.ModuleType('_held_catalog_component');producer.__file__=str(PROJECT/'.runtime/tool-recovery/macos-component-acl-diagnostic/component.py')
        exec(compile(component_source.body,producer.__file__,'exec',dont_inherit=True,optimize=sys.flags.optimize),producer.__dict__)
        prior_dir=held.enter_context(private.Directory(RUN/'native-symlink-failure-diagnostic-2e635cce-2464-4739-b041-bbeb9e724cd8'))
        prior_source=held.enter_context(private.Snapshot(prior_dir,'private-target-metadata.json'))
        need(hashlib.sha256(prior_source.body).hexdigest()==producer.PROOF_SHA,'component_original_failure_proof_changed')
        run_dir=held.enter_context(private.Directory(RUN));name='native-component-acl-diagnostic-'+OP
        session.guard();run_dir.guard();os.mkdir(name,mode=0o700,dir_fd=run_dir.fd);os.fsync(run_dir.fd);run_dir.guard()
        out=held.enter_context(private.Directory(RUN/name))
        def guard():need(time.monotonic()<GROUP_DEADLINE,'acl_group_deadline');session.guard();self_source.guard();component_source.guard();capture_source.guard();prior_source.guard();run_dir.guard();out.guard()
        def record(name,value):
            guard();raw=value if isinstance(value,bytes)else json.dumps(value,sort_keys=True,separators=(',',':')).encode()
            fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=out.fd)
            with os.fdopen(fd,'wb')as f:f.write(raw);f.flush();os.fsync(f.fileno())
            os.fsync(out.fd);guard()
        record('driver.source.py',self_source.body)
        record('component.source.py',component_source.body)
        record('rpc-capture.source.py',capture_source.body)
        record('original-private-failure-proof.json',prior_source.body)
        record('intent.json',{'schemaVersion':1,'operationId':OP,'fixtureId':ALIAS,'vmName':VM,
            'originalRun':'2d933a39-0fb6-46a4-9fd9-02221d81c4b9','producerSha256':PRODUCER,
            'driverSha256':hashlib.sha256(self_source.body).hexdigest(),'policySha256':POLICY,'guestWallSeconds':60,'callerSeconds':90,
            'action':'fixed_previously_observed_component_acl_volume_get_only','readOnly':True,'idleAuthority':False,
            'namespaceEnrollment':False,'input':False,'power':False,'rootInstallation':False,'targetContentRead':False,'privateTargetMetadataRetained':True,'privatePathsPrinted':False})
        phase={'value':'factory'};native_calls=[]
        original_native=mac_registry.MacCustody._native_call
        def captured_native(custody,argv,payload,call_deadline):
            guard()
            need((custody.binding.vm_name,custody.binding.machine,custody.run_intent['operationId'])==(VM,MACHINE,'2d933a39-0fb6-46a4-9fd9-02221d81c4b9'),'acl_rpc_custody_changed')
            need(type(payload)is bytes and 0<len(payload)<=262144,'acl_rpc_payload_invalid')
            canonical,_=protocol.stdin_command(payload.decode('utf-8'))
            need(tuple(argv)==(custody.binding.tart_binary,'exec','-i',VM,custody.binding.guest_python,*canonical[1:]),'acl_rpc_target_changed')
            label='call-'+str(len(native_calls)+1)+'-'+phase['value']
            need(len(native_calls)<12,'acl_rpc_count_invalid')
            output_record(out,label+'.request.json',json.dumps({'argv':list(argv),'stage':phase['value'],'sourceSha256':hashlib.sha256(payload).hexdigest(),'operationId':OP,'readOnly':True},sort_keys=True).encode(),65536)
            output_record(out,label+'.request.stdin',payload,262144)
            with capture.PublicRpcCapture(out,label)as retained:
                result,callback=retained.run(argv,payload,deadline=min(call_deadline,GROUP_DEADLINE),birth=jobs._birth,parent=lambda pid:mac_registry._parent(pid,time.monotonic()+2))
            native_calls.append(callback)
            need(callback['actorAbsent']and not callback['partial'],'acl_rpc_original_unknown')
            guard();return result
        mac_registry.MacCustody._native_call=captured_native
        held.callback(setattr,mac_registry.MacCustody,'_native_call',original_native)
        backend=session.module.registered_fixture(PROJECT,ALIAS).adapter.backend
        held.callback(backend.custody.close)
        phase['value']='executor'
        need((backend.binding.vm_name,backend.binding.machine,backend.binding.ordinary_uid,
              backend.binding.ordinary_account)==(VM,MACHINE,502,'toolrecovery'),'catalog_selected_binding_changed')
        deadline=GROUP_DEADLINE
        with backend.guest_job_executor(deadline=deadline,operation_id=OP)as executor:
            need(executor.machine==MACHINE and executor.boot==RAW_BOOT and int(executor.uid)==502,
                 'catalog_actual_identity_changed')
            def root_probe(label):
                phase['value']=label
                source=mac_registry.guest_probe_source(backend.binding,prefix=backend.custody.guest_proof['prefix'],
                    public_files=backend.custody.guest_proof['publicFiles'])
                if type(source)is str:source=source.encode()
                record(label+'.source.py',source)
                argv,payload=protocol.stdin_command(source.decode());guard()
                request_record(out,label,argv,payload);guard()
                result=executor.execute(argv,payload=payload)
                callback_record(out,label,result);guard()
                need(result.returncode==0 and not result.stderr,'catalog_root_observer_failed')
                packet=parse(result.stdout);need(type(packet)is dict and set(packet)=={'facts','agent'},'catalog_root_reply_invalid')
                mac.guest_facts(packet['facts'],backend.binding)
                need(packet['facts']['machine']==MACHINE and packet['agent']['rawBoot']==RAW_BOOT,
                     'catalog_root_identity_changed')
                record(label+'.result.json',{'returncode':result.returncode,'stdoutBytes':len(result.stdout),
                    'stdoutSha256':hashlib.sha256(result.stdout).hexdigest(),'stderrBytes':0})
                return packet
            before=root_probe('root-before');actor=before['agent']['actor']
            _,seconds,microseconds=actor['birth'].split(':')
            agent=(actor['pid'],502,1,int(seconds),int(microseconds))
            sources={Path(path).name:raw for path,raw in session.cache.values()if Path(path).name in producer.PINS}
            need(set(sources)==set(producer.PINS),'catalog_captured_sources_missing')
            source=producer.build(sources,agent,component_source.body)
            record('catalog.source.py',source);record('catalog-admission.json',{'operationId':OP,
                'sourceSha256':hashlib.sha256(source).hexdigest(),'agent':actor,'actualRawBoot':RAW_BOOT})
            record('source-capsule-before.json',{'sources':[{ 'path':path,'sha256':hashlib.sha256(raw).hexdigest()}
                for path,raw in session.cache.values()]})
            phase['value']='catalog'
            guard();argv,payload=protocol.stdin_command(source.decode())
            request_record(out,'catalog',argv,payload);guard()
            result=executor.execute(argv,payload=payload)
            callback_record(out,'catalog',result);guard()
            after=root_probe('root-after')
            need(after['agent']==before['agent'],'catalog_agent_generation_changed')
        envelope=parse(result.stdout)
        need(type(envelope)is dict and 'public'in envelope and set(envelope)<= {'public','privateComponentProof'}
             and type(envelope['public'])is dict,'catalog_target_reply_invalid')
        if 'privateComponentProof'in envelope:
            proof=envelope['privateComponentProof']
            need(type(proof)is dict and set(proof)=={'schemaVersion','kind','originalFailureProofSha256','credentials','items'}
                 and proof['schemaVersion']==1 and proof['kind']=='private_exact_component_acl_volume'and proof['originalFailureProofSha256']==producer.PROOF_SHA
                 and type(proof['items'])is list and len(proof['items'])<=64
                 and len(json.dumps(proof).encode())<=1048576,'catalog_private_proof_invalid')
            record('private-component-acl-metadata.json',proof)
        # Raw stdout/private artifact stay600. Only finite public summary is
        # parsed into result.json or printed; never print the raw envelope.
        value=public_reply(envelope,producer)
        record('source-capsule-closed.json',{'sources':[{ 'path':path,'sha256':hashlib.sha256(raw).hexdigest()}
            for path,raw in session.cache.values()]})
        record('native-rpc-closure.json',{'actors':[value['actor']for value in native_calls],'allOriginalActorsAbsent':all(jobs._birth(value['actor']['pid'])!=value['actor']['birth']for value in native_calls),'allRawEof':all(value['stdoutEof']and value['stderrEof']for value in native_calls),'dispatchCount':len(native_calls)})
        record('result.json',{'schemaVersion':1,'operationId':OP,'returncode':result.returncode,
            'stderrBytes':len(result.stderr),'reply':value,'inputSubmitted':False,'powerSubmitted':False,
            'rootInstalled':False,'idleAuthority':False})
        print(json.dumps({'operationId':OP,'folder':str(RUN/name),'returncode':result.returncode,'reply':value},sort_keys=True))
if __name__=='__main__':main()
