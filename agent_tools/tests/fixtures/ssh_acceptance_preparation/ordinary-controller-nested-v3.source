from pathlib import Path
from contextlib import ExitStack
from types import ModuleType,SimpleNamespace
import hashlib,json,os,stat,sys,time
class LocalOwnerBlocked(ValueError):
    pass
def need(ok, reason):
    if not ok:
        raise LocalOwnerBlocked(reason)
def generation(i):
    return (i.st_dev, i.st_ino, i.st_mode, i.st_uid, i.st_gid, i.st_nlink, i.st_size, i.st_mtime_ns, i.st_ctime_ns)
class Held:

    def __init__(self, path):
        self.path = Path(path)
        need(self.path.is_absolute() and '..' not in self.path.parts, 'local_source_path')
        self.fds = []
        self.chain = []
        try:
            fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            self.fds.append(fd)
            self.chain.append((None, '/', fd, generation(os.fstat(fd))[:5]))
            for name in self.path.parts[1:-1]:
                parent = fd
                fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
                self.fds.append(fd)
                self.chain.append((parent, name, fd, generation(os.fstat(fd))[:5]))
            self.parent = fd
            self.name = self.path.name
            self.fd = os.open(self.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
            self.fds.append(self.fd)
            i = os.fstat(self.fd)
            need(stat.S_ISREG(i.st_mode) and i.st_uid == os.getuid() and (i.st_nlink == 1) and (not i.st_mode & 18), 'local_source_shape')
            self.pin = generation(i)
            self.raw = b''
            while len(self.raw) < i.st_size:
                part = os.read(self.fd, min(65536, i.st_size - len(self.raw)))
                need(bool(part), 'local_source_short')
                self.raw += part
            self.guard()
        except BaseException:
            self.close()
            raise

    def guard(self):
        for parent, name, fd, pin in self.chain:
            named = os.stat('/', follow_symlinks=False) if parent is None else os.stat(name, dir_fd=parent, follow_symlinks=False)
            need(generation(os.fstat(fd))[:5] == generation(named)[:5] == pin, 'local_source_ancestry_changed')
        need(generation(os.fstat(self.fd)) == generation(os.stat(self.name, dir_fd=self.parent, follow_symlinks=False)) == self.pin and os.pread(self.fd, len(self.raw) + 1, 0) == self.raw, 'local_source_changed')

    def close(self):
        for fd in reversed(self.fds):
            os.close(fd)
        self.fds = []

    def __enter__(self):
        return self

    def __exit__(self, *args):
        try:
            self.guard()
        finally:
            self.close()
class SharedSourceScope:
    """Share immutable held directory identities, retain one separate FD per file."""

    def __init__(self, held_type):
        self.held_type = held_type
        self.directories = {}
        self.files = []

    def hold(self, path):
        path = Path(path)
        if not path.is_absolute() or '..' in path.parts:
            raise ValueError('shared_source_path')
        chain = []
        for parent in reversed(path.parents):
            if parent not in self.directories:
                if parent == Path('/'):
                    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                    entry = (None, '/', fd, module_generation(os.fstat(fd))[:5])
                else:
                    base = self.directories[parent.parent][2]
                    fd = os.open(parent.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=base)
                    entry = (base, parent.name, fd, module_generation(os.fstat(fd))[:5])
                self.directories[parent] = entry
            chain.append(self.directories[parent])
        value = self.held_type.__new__(self.held_type)
        value.path = path
        value.chain = chain
        value.fds = []
        value.parent = chain[-1][2]
        value.name = path.name
        try:
            value.fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=value.parent)
            value.fds.append(value.fd)
            i = os.fstat(value.fd)
            if not stat.S_ISREG(i.st_mode) or i.st_uid != os.getuid() or i.st_nlink != 1 or i.st_mode & 18:
                raise ValueError('shared_source_shape')
            value.pin = module_generation(i)
            value.raw = b''
            while len(value.raw) < i.st_size:
                part = os.read(value.fd, min(65536, i.st_size - len(value.raw)))
                if not part:
                    raise ValueError('shared_source_short')
                value.raw += part
            value.guard()
            self.files.append(value)
            return value
        except BaseException:
            value.close()
            raise

    def __enter__(self):
        return self

    def __exit__(self, *args):
        try:
            for source in self.files:
                source.guard()
        finally:
            for source in reversed(self.files):
                source.close()
            for _, _, fd, _ in reversed(list(self.directories.values())):
                os.close(fd)
def module_generation(i):
    return (i.st_dev, i.st_ino, i.st_mode, i.st_uid, i.st_gid, i.st_nlink, i.st_size, i.st_mtime_ns, i.st_ctime_ns)
