PF_KTHREAD = 0x00200000
# Holds each named file's flock exclusively, as a live linked attempt's creator,
# submit, storage writer and inventory writer would.
LOCKS = ("import fcntl,os,sys,time\nheld=[]\nfor path in sys.argv[1:]:\n fd=os.open(path,os.O_RDONLY)\n fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)\n"
 " held.append(fd)\nprint('held',flush=True)\ntime.sleep(60)\n")


def stat_line(pid, state='S', ppid=1, start=100, flags=0):
 tail = [state, str(ppid)] + ['0'] * 4 + [str(flags)] + ['0'] * 10 + ['1', '0', str(start)] + ['0'] * 5
 return ('%d (x y) %s\n' % (pid, ' '.join(tail))).encode()


class ProcOs:
 """The real os module, except for the procfs double's denials and scripted reads.

 A denied (non-dumpable) process raises EACCES on its descriptors, cwd, root,
 exe and maps, whoever runs the test (root included); a scripted file returns
 its next content on each open, as a process changing between two reads would.
 """
 def __init__(self, proc):
  self._proc, self._streams = proc, {}

 def __getattr__(self, name):
  return getattr(os, name)

 def _check(self, path):
  path = str(path)
  for base in self._proc.denied:
   if path.startswith(base + '/') and path[len(base) + 1:].split('/')[0] in ('fd', 'cwd', 'root', 'exe', 'maps'):
    raise PermissionError(13, 'Permission denied', path)

 def listdir(self, path='.'):
  self._check(path)
  return os.listdir(path)

 def stat(self, path, *args, **kwargs):
  info = os.stat(path, *args, **kwargs)
  owner = self._proc.owners.get(str(path))
  return info if owner is None else os.stat_result((*info[:4], owner, *info[5:]))

 def readlink(self, path, *args, **kwargs):
  self._check(path)
  return os.readlink(path, *args, **kwargs)

 def open(self, path, flags, *args, **kwargs):
  self._check(path)
  fd = os.open(path, flags, *args, **kwargs)
  script = self._proc.scripts.get(str(path))
  if script is not None:
   count = self._proc.opened[str(path)] = self._proc.opened.get(str(path), 0) + 1
   self._streams[fd] = io.BytesIO(script[min(count, len(script)) - 1])
  return fd

 def read(self, fd, size):
  stream = self._streams.get(fd)
  return os.read(fd, size) if stream is None else stream.read(size)

 def close(self, fd):
  self._streams.pop(fd, None)
  return os.close(fd)


class ProcTime:
 """The real time module; after `after` monotonic reads the clock jumps by `jump` seconds."""
 def __init__(self, proc):
  self._proc = proc

 def __getattr__(self, name):
  return getattr(time, name)

 def monotonic(self):
  self._proc.ticks += 1
  return time.monotonic() + (self._proc.jump if self._proc.ticks > self._proc.after else 0)


class FakeProc:
 """A /proc-shaped tree for the exact embedded census source (no real procfs here).

 The census source runs unchanged; only its `os` and `time` imports resolve to
 ProcOs/ProcTime. A same-account non-dumpable process is modelled by EACCES on
 its descriptors, links and maps (root-safe), a zombie by state Z with one
 thread and no cwd/root/exe links. Real-kernel ownership and EACCES/ENOENT
 semantics remain native (Linux) facts.
 """
 def __init__(self, case):
  self.tmp = tempfile.TemporaryDirectory(dir=Path('/tmp').resolve())
  case.addCleanup(self.cleanup)
  self.base = Path(self.tmp.name) / 'proc'
  self.denied, self.scripts, self.opened, self.ticks, self.after, self.jump, self.owners = set(), {}, {}, 0, float('inf'), 0, {}
  (self.base / 'net').mkdir(parents=True)
  self.unix([])

 def cleanup(self):
  self.tmp.cleanup()

 def script(self, pid, leaf, *contents):
  """Successive opens of /proc/<pid>/<leaf> return these contents (the last repeats)."""
  self.scripts[str(self.base / str(pid) / leaf)] = list(contents)

 def clock(self, after, jump):
  self.after, self.jump = after, jump

 def unix(self, rows):
  (self.base / 'net/unix').write_text('Num       RefCount Protocol Flags    Type St Inode Path\n'
   + ''.join('0000000000000000: 00000002 00000000 00010000 0001 01 %d %s\n' % row for row in rows))

 def process(self, pid, *, state='S', ppid=1, start=100, flags=0, threads=1, argv=('sleep', '60'), fds=('/dev/null',), cwd='/', root='/',
             exe='/usr/bin/sleep', maps=('/usr/lib/libc.so.6',), denied=False, uid=None):
  base = self.base / str(pid)
  (base / 'fd').mkdir(parents=True)
  tail = [state, str(ppid)] + ['0'] * 4 + [str(flags)] + ['0'] * 10 + ['1', '0', str(start)] + ['0'] * 5
  (base / 'stat').write_text('%d (x y) %s\n' % (pid, ' '.join(tail)))
  (base / 'status').write_text('Name:\tx\nState:\t%s\nPPid:\t%d\nThreads:\t%d\n' % (state, ppid, threads))
  (base / 'cmdline').write_bytes(b''.join(os.fsencode(item) + b'\0' for item in argv))
  for index, target in enumerate(fds):
   os.symlink(target, base / 'fd' / str(index))
  for leaf, target in (('cwd', cwd), ('root', root), ('exe', exe)):
   if target is not None:
    os.symlink(target, base / leaf)
  (base / 'maps').write_text(''.join('7f0000000000-7f0000001000 r--p 00000000 08:01 42 %s\n' % path for path in maps))
  if denied:
   self.denied.add(str(base))
  if uid is not None:
   self.owners[str(base)] = uid
  return base

 def census(self, paths, **options):
  doubles = {'os': ProcOs(self), 'time': ProcTime(self)}
  def importer(name, *args, **kwargs):
   return doubles[name] if name in doubles else builtins.__import__(name, *args, **kwargs)
  scope = {'__builtins__': {**vars(builtins), '__import__': importer}}
  exec(compile(inspect.getsource(WRITER._actor_census), 'embedded census', 'exec'), scope)
  return scope['_actor_census'](paths, proc=str(self.base), **options)


def receipts(tree, kind='observer'):
 """Retained receipts of one step kind, oldest first: (callback, parsed stdout or None)."""
 base = tree.root / '.rag_index/windows-managed-creator-prevm' / OP / 'observations'
 rows = [(json.loads((path / 'callback.json').read_bytes()), path) for path in (base.iterdir() if base.exists() else ())]
 rows = sorted((row for row in rows if row[0].get('kind', 'observer') == kind), key=lambda row: row[0].get('startedMonotonic', 0))
 return [(callback, json.loads((path / 'stdout.bin').read_bytes()) if (path / 'stdout.bin').exists() else None) for callback, path in rows]


def newest_observation(tree, kind='observer'):
 base = tree.root / '.rag_index/windows-managed-creator-prevm' / OP / 'observations'
 rows = [path for path in base.iterdir() if json.loads((path / 'callback.json').read_bytes()).get('kind', 'observer') == kind
  and (path / 'stdout.bin').exists()]
 return json.loads(max(rows, key=lambda path: (path / 'callback.json').stat().st_mtime_ns).joinpath('stdout.bin').read_bytes())


def flock_outside_proof(function):
 """Every flock of the observer must sit inside an `if E['mode'] == 'proof':` branch."""
 found = []
 def visit(node, guarded):
  if isinstance(node, ast.Call) and getattr(node.func, 'attr', None) == 'flock' and not guarded:
   found.append(node.lineno)
  for child in ast.iter_child_nodes(node):
   proof = (isinstance(node, ast.If) and child in node.body and isinstance(node.test, ast.Compare)
    and ast.unparse(node.test).replace('"', "'") == "E['mode'] == 'proof'")
   visit(child, guarded or proof)
 visit(ast.parse(inspect.getsource(function)), False)
 return found


class CreatorPreVmClosure(unittest.TestCase):
 def assertClosedOnly(self, tree, before_rows, before_journal, result):
  self.assertFalse(tree.own_present())
  self.assertEqual(tree.foreign_rows(), before_rows)
  journal = tree.journal()
  for key in ('prepared', 'submitting'):
   self.assertEqual(journal[name(key)], before_journal[name(key)])
  self.assertEqual(set(journal), set(before_journal) | {name(AUTH), name(RELEASING), name(RELEASED), name(LINK)},
   'durable authorization, release attempt, released result and generation link must be retained in the original journal')
  self.assertEqual(result['state'], 'closed', result)

 def remedy(self):
  # RED is a missing capability: before the remedy no repository surface runs a
  # guarded closure protocol or resolves a derived attempt; only the proof-free
  # generic route exists, which has no protocol states to assert at all.
  self.assertIsNotNone(WRITER, 'missing capability: no source-owned guarded closure protocol exists before the remedy')
  self.assertIsNotNone(READER, 'missing capability: no link-gated next-attempt resolver exists before the remedy')

 def test_complete_blocked_original_closes_only_own_prepared_claim_and_retains_socket_cause(self):
  tree = Tree(self)
  # RED: every legitimate pre-remedy surface refuses; the claim stays consumed.
  with self.assertRaisesRegex(ValueError, 'resource_clean_stopped_proof_required'):
   tree.admission.release_stopped({'machineUuid': MACHINE})
  self.assertFalse(tree.admission.mark_submitting())
  with self.assertRaisesRegex(ValueError, 'resource_original_dispatch_consumed'):
   tree.admission.validate_before_dispatch()
  self.assertEqual(tree.prepare().reservation_identity, tree.identity)
  with self.assertRaisesRegex(environments.NativeEnvironmentError, 'active or unknown'):
   environments.release_environment(tree.root, tree.identity)
  calls = []
  module = SimpleNamespace(_private=jobs._private, _publish=lambda *a: calls.append(a), _birth=jobs._birth, _record=jobs._record)
  self.assertGreater(len(os.fsencode(tree.job / 'credentials.sock')), 107)
  with self.assertRaisesRegex(OSError, 'AF_UNIX path too long'):
   OLD._receive_credentials(tree.job, module, OP)
  causal = json.loads(evidence('socket-path-causal.json'))
  self.assertEqual((calls, causal['completeBeforeActualBind']), ([], {'publishCalls': [], 'reason': 'AF_UNIX path too long', 'type': 'OSError'}))
  self.assertFalse(os.path.lexists(tree.job / 'credentials.sock'))
  self.assertTrue(tree.own_present())
  before_rows, before_journal, before_ids = tree.foreign_rows(), tree.journal(), {(r['id'], r['token']) for r in tree.rows()}
  # GREEN: only the source-owned proof can close the own prepared claim.
  with (tree.spies() if WRITER else contextlib.nullcontext({})) as spies:
   result = tree.close_available()
  self.assertClosedOnly(tree, before_rows, before_journal, result)
  self.assertEqual([call[1] for call in spies['reserve']], [{'ok': True, 'state': 'reserved', 'idempotent': True, 'identity': tree.identity,
   'reservation': {'memoryBytes': 4 * GIB, 'allocationState': 'pending'}, 'nativeActionAllowed': False}])
  self.assertEqual([call[0] for call in spies['release']], [tree.identity])
  self.assertEqual((spies['secret'], spies['unsubmitted']), ([], []))
  self.assertLessEqual({(r['id'], r['token']) for r in tree.rows()}, before_ids)
  self.assertEqual(READER.derive(RID, result['proofSha256']), (result['nextAttempt']['recoveryId'], result['nextAttempt']['operationId']))
  self.assertEqual(result['nextAttempt']['operationId'], str(uuid5(UUID(MACHINE), result['nextAttempt']['recoveryId'])))
  self.assertEqual(json.loads(tree.record(AUTH))['cause'], 'creator_terminal_before_vm')
  self.assertNotIn(tree.identity['token'], json.dumps(result) + b''.join(tree.record(key) for key in (AUTH, RELEASED, LINK)).decode())

 def variants(self):
  job = lambda leaf: lambda tree: tree.job / leaf
  return [
   ('accepted-marker-with-identical-phase', {}, accepted, 'refused', 'credentials_accepted_present'),
   ('creator-listener', {}, marker('creator-listener.json'), 'refused', 'creator_listener_present'),
   ('credentials-socket', {}, bound, 'refused', 'credentials_socket_present'),
   ('handoff-intent', {}, marker('credentials-handoff.intent.json'), 'refused', 'credentials_handoff_present'),
   ('create-intent', {}, marker('create.intent.json', {'plan': {}, 'manager': {}, 'replayAllowed': False}), 'refused', 'create_intent_present'),
   # Either driver that could hand a private frame to this OP.
   *[('local-%s-handoff-%s' % (driver, leaf), {}, local_marker(directory, leaf), 'refused', 'local_handoff_present')
     for driver, directory in (('successor', SUCCESSOR), ('once', ONCE)) for leaf in ('once.json', 'public-ack.json', 'unknown.json')],
   ('vm-root-directory', {}, lambda t: os.mkdir(t.vm_root, 0o700), 'refused', 'vm_root_present'),
   ('vm-root-dangling-link', {}, lambda t: os.symlink(t.base / 'missing', t.vm_root), 'refused', 'vm_root_present'),
   ('vm-root-parent-writable', {}, lambda t: os.chmod(t.home, 0o770), 'refused', 'vm_root_parent_unsafe'),
   ('storage-plan-for-vm', {}, lambda t: t.add_storage_plan('windows-' + MACHINE, str(t.home / 'elsewhere')), 'refused', 'storage_plan_present'),
   ('storage-plan-under-root', {}, lambda t: t.add_storage_plan('linux-under', t.vm_root + '/nested'), 'refused', 'storage_plan_under_root'),
   ('storage-writer-temporary', {}, lambda t: private_write(t.ledger / 'storage-x.tmp', b'{}'), 'refused', 'storage_ledger_busy'),
   # A missing ledger or lock is never initialized (the snapshot below stays equal).
   ('storage-ledger-absent', {}, lambda t: shutil.rmtree(t.ledger), 'refused', 'storage_unenrolled'),
   ('storage-ledger-lock-absent', {}, lambda t: (t.ledger / 'storage-plans.lock').unlink(), 'refused', 'storage_unenrolled'),
   ('storage-ledger-lock-widened', {}, lambda t: os.chmod(t.ledger / 'storage-plans.lock', 0o644), 'refused', 'storage_unenrolled'),
   ('domain-visible', {}, lambda t: t.write_control(domain={'uuid': 'visible', 'name': 'absent'}), 'refused', 'domain_visible'),
   ('domain-other-code', {}, lambda t: t.write_control(domain={'uuid': 'absent', 'name': 'other'}), 'refused', 'domain_unknown'),
   ('manager-absent', {}, lambda t: t.write_control(manager=None), 'refused', 'manager_unavailable'),
   ('manager-restarted-during-lookups', {}, lambda t: t.write_control(managerAfterLookup=MANAGER2), 'refused', 'manager_changed'),
   ('boot-drift', {}, lambda t: t.write_control(epoch={'machine': t.host.machine, 'boot': str(uuid4()), 'account': t.host.account}), 'refused', 'host_epoch_changed'),
   ('marker-generation-drift', {}, lambda t: os.utime(t.ns_root / 'creator-namespace.json', ns=(1, 1)), 'refused', 'namespace_changed'),
   ('namespace-exclusively-held', {}, busy, 'refused', 'namespace_busy'),
   ('hidden-index-and-job', {}, hidden, 'refused', 'other_attempt_present'),
   ('shadow-namespace-for-machine', {}, lambda t: os.mkdir(t.ns_root.parent / (MACHINE + '-shadow'), 0o700), 'refused', 'other_attempt_present'),
   ('job-entry-changed-during-observation', {}, lambda t: t.write_control(touchDuringLookup=str(t.job / 'stdout.bin')), 'refused', 'namespace_changed'),
   ('admission-index-changed', {}, republish(lambda t: t.ns_root / 'admissions' / (OP + '.json'), streamLimit=1), 'refused', 'admission_index_mismatch'),
   ('intent-generation-changed', {}, republish(job('intent.json'), generation=str(uuid4())), 'refused', 'terminal_foreign'),
   ('intent-purpose-changed', {}, republish(job('intent.json'), purpose='windows-managed-repeat-create'), 'refused', 'terminal_foreign'),
   # Missing identities remain missing and block closure.
   ('owner-receipt-missing', {}, lambda t: (t.job / 'owner.json').unlink(), 'refused', 'job_entries_unexpected'),
   ('terminal-receipt-missing', {}, lambda t: (t.job / 'terminal.json').unlink(), 'refused', 'job_entries_unexpected'),
   ('extra-job-entry', {}, lambda t: jobs._create(t.job / 'extra.bin', b'x'), 'refused', 'job_entries_unexpected'),
   ('terminal-exit-nonzero', {}, republish(job('terminal.json'), exitCode=1), 'refused', 'terminal_foreign'),
   ('terminal-stale-generation', {}, republish(job('terminal.json'), generation=str(uuid4())), 'refused', 'terminal_foreign'),
   ('terminal-stream-digest-changed', {}, terminal_stream_digest, 'refused', 'terminal_foreign'),
   ('other-same-machine-journal', {}, machine_journal, 'refused', 'other_machine_journal_present'),
   ('core-dispatch-for-machine', {}, lambda t: private_write(t.root / '.rag_index/readiness-targets' / ('c' * 64) / ('dispatch-' + 'd' * 64 + '-1.json'),
    canonical({'version': 2, 'machine': MACHINE, 'action': 'start'}).encode()), 'refused', 'readiness_target_dispatch_present'),
   ('vm-environment-row', {}, lambda t: t.vm_row(), 'refused', 'environment_row_present'),
   ('deploy-intent', {}, lambda t: private_write(t.root / '.rag_index/windows-vm-deploy-intents' / (MACHINE + '.intent.json'), b'{}'), 'refused', 'deploy_intent_present'),
   ('deploy-credentials', {}, lambda t: os.makedirs(t.root / '.runtime/windows-vm-credentials' / MACHINE, 0o700), 'refused', 'deploy_intent_present'),
   ('live-owner', {'live_owner': True}, lambda t: None, 'refused', 'owner_alive'),
   ('overflowed-stream', {'overflow': True}, lambda t: None, 'refused', 'terminal_truncated'),
   ('remote-program-changed', {}, rewrite('program.py', lambda t: t.program.source + b'\n'), 'refused', 'program_source_mismatch'),
   ('remote-owner-changed', {}, rewrite('owner.py', lambda t: jobs.owner_source() + b'\n'), 'refused', 'owner_source_mismatch'),
   ('local-program-evidence-changed', {}, lambda t: overwrite_private(t.root / SUCCESSOR / 'program.py', t.program.source + b'#'), 'refused', 'local_evidence_changed'),
   ('program-not-from-executing-source', {'old': CURRENT}, lambda t: None, 'refused', 'program_derivation_mismatch'),
   ('listener-region-effect-in-executing-source', {'old_source': LISTENER_EFFECT}, lambda t: None, 'refused', 'phase_region_mismatch'),
   ('actor-reference', {}, actor, 'refused', 'actor_reference_present'),
   ('actor-scan-incomplete', {'stub_actors': True}, lambda t: t.write_control(censusReason='actor_scan_incomplete'), 'refused', 'actor_scan_incomplete'),
   ('actor-descriptor-limit', {'stub_actors': True}, lambda t: t.write_control(censusReason='actor_descriptor_limit'), 'refused', 'actor_descriptor_limit'),
   # A measured same-account denial admits only the root census; what it finds decides.
   ('denied-holder-seen-by-root', {'stub_actors': True}, lambda t: t.write_control(denied=[[4242, 77]], root={'references': 1}), 'refused',
    'actor_reference_present'),
   ('denied-root-census-incomplete', {'stub_actors': True}, lambda t: t.write_control(denied=[[4242, 77]], root={'reason': 'actor_scan_incomplete'}),
    'refused', 'actor_scan_incomplete'),
   ('denied-root-census-unavailable', {'stub_actors': True}, lambda t: t.write_control(denied=[[4242, 77]], privilegedUnavailable=True), 'refused',
    'privileged_census_unavailable'),
   ('denied-root-census-coverage-forged', {'stub_actors': True}, lambda t: t.write_control(denied=[[4242, 77]], root={'covered': [[4242, 78, 'examined']]}),
    'refused', 'privileged_census_unknown'),
   # Ruling R4: no writable libvirt.open fallback when openReadOnly is missing.
   ('libvirt-without-read-only-open', {}, read_only_absent, 'refused', 'domain_read_only_unavailable'),
   ('later-resource-attempt', {}, journal_record('submitting:2'), 'refused', 'resource_later_attempt_present'),
   ('unsubmitted-resource-proof', {}, journal_record('unsubmitted:1'), 'refused', 'resource_unsubmitted_present'),
   ('running-resource-record', {}, journal_record('running'), 'refused', 'record_integrity'),
   ('generic-release-authorization-record', {}, journal_record('release-authorized'), 'refused', 'record_integrity'),
   ('prepared-record-changed', {}, record_changed('prepared'), 'refused', 'resource_records_changed'),
   ('submitting-record-changed', {}, record_changed('submitting'), 'refused', 'resource_records_changed'),
   ('prepared-request-not-pending', {}, prepared_request_running, 'refused', 'resource_records_changed'),
   ('released-without-authorization', {}, journal_record(RELEASED), 'refused', 'record_integrity'),
   ('release-attempt-without-authorization', {}, journal_record(RELEASING), 'refused', 'record_integrity'),
   ('link-without-released', {}, journal_record(LINK), 'refused', 'record_integrity'),
   ('premature-attempt-root', {}, lambda t: os.makedirs(t.root / '.rag_index/windows-managed-creator-attempts' / SCOPE, 0o700), 'refused', 'attempt_custody_unresolved'),
   ('wrong-expected-proof', {}, lambda t: None, 'refused', 'proof_mismatch'),
   # Claims this source did not produce stay UNKNOWN and stop (closePrepared step 7).
   ('foreign-active-row', {}, own_row('active'), 'unknown', 'reservation_foreign'),
   ('unexplained-complete-row', {}, own_row('complete'), 'unknown', 'reservation_evidence_unexplained')]

 def test_unproven_or_drifted_facts_refuse_without_any_ledger_or_journal_change(self):
  seen = set()
  for label, options, mutate, state, reason in self.variants():
   with self.subTest(label):
    tree = Tree(self, **options)
    mutate(tree)
    before, journal = tree.snapshot(), tree.journal()
    with tree.spies() as spies:
     result = tree.close_or_generic('f' * 64)
    self.assertEqual((result['state'], result['reason']), (state, reason), result)
    self.assertEqual(tree.snapshot(), before)
    self.assertEqual(tree.journal(), journal)
    self.assertEqual((spies['reserve'], spies['release'], spies['secret']), ([], [], []))
    self.assertNotIn('authorizationSha256', result)
    if state == 'unknown':
     self.assertEqual(result['nextAction'], WRITER._Stop.action)
    if label == 'libvirt-without-read-only-open':
     calls = (tree.control.parent / 'control.json.calls').read_text().split()
     self.assertFalse({'open', 'lookup:uuid', 'lookup:name'} & set(calls) or any(c.startswith('openReadOnly') for c in calls), calls)
    seen.add(result['reason'])
  self.assertLessEqual(seen, WRITER.REASONS if WRITER else set())
  # The typed phase is identical in the accepted variant: phase alone proves nothing.
  self.assertEqual(json.loads(evidence('owner.stdout.public'))['phase'], 'credential-listener')

 def test_lost_ack_after_complete_receipt_or_row_deletion_reconciles_same_authorization(self):
  # (b) durable release save, lost ACK: reconcile the SAME authorization, never mint a token.
  tree = Tree(self)
  before_ids = {(row['id'], row['token']) for row in tree.rows()}
  def lost_release(root, identity):
   REAL_RELEASE(root, identity)
   raise RuntimeError('acknowledgement lost after durable delete')
  with mock.patch.object(environments, 'release_environment', side_effect=lost_release):
   if WRITER is None:
    with self.assertRaisesRegex(RuntimeError, 'acknowledgement lost'):
     tree.generic_release()
   else:
    proof = tree.proof()['proofSha256']
    first = tree.close(proof)
    self.assertEqual((first['state'], first['reason'], first['authorizationSha256']), ('unknown', 'release_unknown', sha(tree.record(AUTH))), first)
    tree.assertUnpublished()
  self.assertFalse(tree.own_present())
  with tree.spies() as spies:
   if WRITER is None:
    # Pre-remedy re-invocation: the caller-built generic reserve route reconciles nothing.
    second = tree.remint()
   else:
    again = tree.proof()
    self.assertEqual((again['proofSha256'], again['closure']['row']), (proof, 'absent'))
    second = tree.close(proof, resume=sha(tree.record(AUTH)))
  self.assertLessEqual({(row['id'], row['token']) for row in tree.rows()}, before_ids)
  self.assertEqual((second['state'], spies['reserve'], spies['release']), ('closed', [], []))
  # (a) durable reserve save, lost ACK; resumed after the complete receipt went stale.
  tree = Tree(self)
  proof = tree.proof()
  self.assertEqual((proof['state'], proof['closure']['row']), ('proven', 'unknown'))
  def lost_reserve(root, request):
   REAL_RESERVE(root, request)
   raise RuntimeError('acknowledgement lost after durable save')
  with mock.patch.object(environments, 'reserve_environment', side_effect=lost_reserve):
   first = tree.close(proof['proofSha256'])
  authorization = sha(tree.record(AUTH))
  self.assertEqual((first['state'], first['reason'], first['authorizationSha256']), ('unknown', 'reserve_result_unexpected', authorization), first)
  tree.assertUnpublished()
  self.assertIsNone(tree.record(RELEASED))
  pending = tree.close(proof['proofSha256'])
  self.assertEqual((pending['state'], pending['reason'], pending['authorizationSha256'], pending['nextAction']),
   ('refused', 'resume_required', authorization, WRITER.Refused.action))
  with shifted(61):
   again = tree.proof()
   self.assertEqual((again['proofSha256'], again['closure']['row'], again['closure']['factsMatchAuthorization']), (proof['proofSha256'], 'stale', True))
   with tree.spies() as spies:
    second = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual(second['state'], 'closed', second)
  self.assertEqual([c[1]['identity'] for c in spies['reserve']], [tree.identity])
  self.assertEqual(len(spies['release']), 1)
  self.assertEqual(sha(tree.record(AUTH)), authorization)
  # (c) row deleted without any authorization stays UNKNOWN and stops; reserve never runs.
  tree = Tree(self)
  with environments._LockedState(tree.root) as locked:
   locked.state['reservations'] = [r for r in locked.state['reservations'] if r['id'] != tree.identity['reservationId']]
   locked.save()
  before = tree.snapshot()
  with tree.spies() as spies:
   result = tree.close('f' * 64)
  self.assertEqual((result['state'], result['reason'], result['nextAction'], spies['reserve']),
   ('unknown', 'reservation_absent_without_authorization', WRITER._Stop.action, []))
  self.assertNotIn('authorizationSha256', result)
  self.assertEqual(tree.snapshot(), before)
  # (d)+(f) A recorded, guard #1 sees a restarted manager: A + untouched U0 (root ruling R1).
  # Without the explicit digest it never resumes; with it, it continues the SAME
  # authorized closure only over the exact U0 row A bound and the same no-VM facts.
  tree = Tree(self)
  proof, authorization = tree.authorize_then_refuse()
  self.assertEqual(json.loads(tree.record(AUTH)).get('reservationRow', {}).get('sha256'), sha(canonical(tree.own_row()).encode()))
  before = tree.snapshot()
  with tree.spies() as spies:
   for resume, reason in ((None, 'resume_required'), ('e' * 64, 'authorization_mismatch')):
    refused = tree.close(proof, resume=resume)
    self.assertEqual((refused['state'], refused['reason'], refused['authorizationSha256']), ('refused', reason, authorization), refused)
  self.assertEqual((tree.snapshot(), spies['reserve'], spies['release']), (before, [], []))
  again = tree.proof()
  self.assertNotEqual(again['proofSha256'], proof)
  self.assertEqual((again['closure']['factsMatchAuthorization'], again['closure']['rowMatchesAuthorization']), (True, True))
  # An authorization whose source epoch differs never resumes, even with its own digest.
  raw, path = tree.record(AUTH), tree.journal_path(AUTH)
  forged = json.loads(raw)
  forged['sourceEpoch'] = {**forged['sourceEpoch'], 'agent_tools/forged.py': '0' * 64}
  overwrite_private(path, canonical(forged).encode())
  self.assertEqual(tree.close(again['proofSha256'], resume=sha(tree.record(AUTH)))['reason'], 'source_epoch_changed')
  overwrite_private(path, raw)
  self.assertEqual(tree.close(again['proofSha256'], resume=authorization)['state'], 'closed')
  self.assertEqual(sha(tree.record(AUTH)), authorization)
  # (e) crash inside create-only publication leaves an empty record: fail closed.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  publish = readiness.RecoveryJournal._publish_named
  def crash(journal, leaf, value):
   if leaf == name(AUTH):
    os.close(os.open(leaf, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=journal.directory.fd))
    raise OSError('crash after create')
   return publish(journal, leaf, value)
  with mock.patch.object(readiness.RecoveryJournal, '_publish_named', crash):
   self.assertEqual(tree.close(proof)['reason'], 'record_unknown')
  before = tree.snapshot()
  self.assertEqual(tree.proof()['reason'], 'record_integrity')
  self.assertEqual(tree.close(proof)['reason'], 'record_integrity')
  self.assertEqual(tree.snapshot(), before)

 def test_derived_attempt_requires_durable_release_and_refuses_duplicate_generation(self):
  # Causal 4's RED is a missing capability. Before the remedy nothing gates a
  # derived attempt: registry.retain and prepare_start stay generic (the remedy
  # leaves them so) and no repository surface resolves the attempt after 7e8.
  self.assertIsNotNone(READER, 'missing capability: no link-gated resolver for the attempt after 7e8 exists before the remedy')
  body = lambda proof: canonical({'attempt': 2, 'parentRecoveryId': RID, 'proofSha256': proof})
  derive = lambda proof: (lambda rid: (rid, str(uuid5(UUID(MACHINE), rid))))(sha(b'windows-managed-creator-attempt-v1\n' + body(proof).encode()))
  tree = Tree(self)
  binding = tree.plan['binding']
  with self.assertRaises(READER.AttemptUnresolved):
   READER.current(tree.root)
  proof = tree.proof()['proofSha256']
  result = tree.close(proof)
  self.assertEqual(result['state'], 'closed', result)
  rid, op = derive(proof)
  self.assertEqual((READER.derive(RID, proof), result['nextAttempt']), ((rid, op), {'attempt': 2, 'recoveryId': rid, 'operationId': op}))
  custody = READER.current(tree.root)
  self.assertEqual((custody.recovery_id, custody.operation_id, custody.plan()['binding']), (rid, op, json.loads(canonical(binding))))
  self.assertEqual(custody.creator_handle().guard()['plan']['operationId'], op)
  self.assertEqual(registry.load(tree.root, binding).guard()['plan']['operationId'], OP)
  self.assertEqual(READER.creator_handle(tree.root, binding).guard()['plan']['operationId'], op)
  before = tree.snapshot()
  again = tree.close(proof, resume=sha(tree.record(AUTH)))
  self.assertEqual((again['state'], again['reconciled'], tree.snapshot()), ('closed', True, before))
  extra = READER.attempts_parent(tree.root) / ('f' * 64)
  extra.mkdir(mode=0o700)
  with self.assertRaises(READER.AttemptUnresolved):
   READER.current(tree.root)
  extra.rmdir()
  index = {'operationId': op, 'binding': jobs.asdict(tree.host), 'programSha256': 'a' * 64, 'streamLimit': 262144,
   'admissionsGeneration': tree.namespace['admissionsGeneration']}
  CURRENT._creator_admission(jobs, tree.ns_root, index, create=True)
  with self.assertRaisesRegex(ValueError, 'admission_unknown'):
   CURRENT._creator_admission(jobs, tree.ns_root, {**index, 'programSha256': 'b' * 64}, create=True)
  private_write(tree.root / '.rag_index/readiness-resources' / str(uuid4()) / name('prepared'), canonical({'machineUuid': MACHINE}).encode())
  with self.assertRaisesRegex(READER.AttemptUnresolved, 'other_machine_journal_present'):
   READER.current(tree.root)
  # A crash inside retain leaves a partial staging root that is never adopted.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  def partial(root, *args):
   (Path(root) / '.rag_index').mkdir(mode=0o700)
   raise OSError('crash inside retain')
  with mock.patch.object(registry, 'retain', side_effect=partial):
   self.assertEqual(tree.close(proof)['reason'], 'attempt_custody_unresolved')
  self.assertIsNotNone(tree.record(LINK))
  self.assertEqual(tree.close(proof, resume=sha(tree.record(AUTH)))['state'], 'closed')
  entries = os.listdir(READER.attempts_parent(tree.root))
  self.assertEqual((len(entries), len([n for n in entries if n.startswith('.staging-')])), (2, 1))
  self.assertIn(READER.current(tree.root).recovery_id, entries)
  # A conflicting pre-seeded generation link refuses before any custody.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  publish = readiness.RecoveryJournal._publish_named
  def seed(journal, leaf, value):
   result = publish(journal, leaf, value)
   if leaf == name(RELEASED):
    publish(journal, name(LINK), {'kind': 'conflicting-generation', 'replayAllowed': False})
   return result
  with mock.patch.object(readiness.RecoveryJournal, '_publish_named', seed):
   self.assertEqual(tree.close(proof)['reason'], 'record_unknown')
  self.assertFalse(os.path.lexists(READER.attempts_parent(tree.root)))

 def test_original_history_readable_and_immutable_after_new_generation(self):
  tree = Tree(self)
  # One assertion in both runs over the repository's history surface. Before the
  # remedy the retained original observer still reads the 7e8 terminal status and
  # stream digests; only a typed projection of the blocked result is missing.
  self.assertEqual(tree.typed_history(), json.loads(tree.stdout),
   'no typed projection of the original 7e8 terminal result: the retained observer reports only untyped status and stream digests')
  # Pre-remedy regeneration path: the corrected creator builds a DIFFERENT Program,
  # so its fixed status cannot authenticate the executing 7e8 job at all.
  regenerated, status = tree.regenerated_status()
  self.assertNotEqual(regenerated.digest, tree.program.digest)
  self.assertEqual((status['reason'], 'status' in status), ('windows_managed_creator_observation_unresolved', False))
  foreign = {row['id'] for row in tree.foreign_rows()}
  # Preservation (no natural RED): the original job, index, marker, records, registry and claims never change.
  kept = lambda: {'job': {leaf: ((tree.job / leaf).read_bytes(), pin(tree.job / leaf)) for leaf in sorted(os.listdir(tree.job))},
   'index': (tree.ns_root / 'admissions' / (OP + '.json')).read_bytes(), 'marker': pin(tree.ns_root / 'creator-namespace.json'),
   'records': {k: tree.record(k) for k in ('prepared', 'submitting')}, 'registry': tree.handle.guard(),
   'foreign': [row for row in tree.rows() if row['id'] in foreign]}
  before = kept()
  # History reads only the original job; the proof still scans the shared namespace.
  with tree.namespace_holder():
   self.assertEqual(tree.proof()['reason'], 'actor_reference_present')
   self.assertEqual(tree.history()['state'], 'history')
  result = tree.close(tree.proof()['proofSha256'])
  self.assertEqual(result['state'], 'closed')
  with self.assertRaisesRegex(ValueError, 'resource_original_dispatch_unavailable'):
   tree.admission.submission_snapshot()
  custody = READER.current(tree.root)
  with sampled(tree.boot, tree.vms):
   admission = resources.prepare_start(tree.root, host='archlinux', machine_uuid=MACHINE, operation_id=custody.operation_id, fixture_root=tree.vm_root,
    credential_file=str(tree.base / 'no-host-credential'), requested_memory_bytes=4 * GIB, headroom_bytes=8 * GIB)
   self.assertTrue(admission.mark_submitting())
  with mock.patch.object(media, 'dependency_sources', return_value=MEDIA):
   program = CURRENT.creator_program(custody.plan(), admission, custody.namespace(), custody.host_binding())
  CURRENT._creator_admission(jobs, tree.ns_root, {**tree.index, 'operationId': custody.operation_id, 'programSha256': program.digest}, create=True)
  job = tree.ns_root / custody.operation_id
  job.mkdir(mode=0o700)
  jobs._publish(job / 'intent.json', {**tree.intent, 'operationId': custody.operation_id, 'programSha256': program.digest, 'generation': str(uuid4())})
  jobs._create(job / 'program.py', program.source)
  jobs._create(job / 'owner.py', jobs.owner_source())
  # The linked attempt is live: it holds the namespace and the VM root and leaves
  # its own dispatch, credentials, deploy intent and VM row for the same machine.
  tree.attempt_records()
  tree.attempt_actors()
  history = tree.history()
  self.assertEqual((history['state'], history['terminal']['typed'], history['terminal']['stdout']['sha256']),
   ('history', json.loads(tree.stdout), sha(tree.stdout)), history)
  self.assertIn(custody.operation_id, history['namespace'])
  self.assertEqual(tree.proof()['state'], 'closed-history')
  again = tree.close(result['proofSha256'], resume=result['authorizationSha256'])
  self.assertEqual((again['state'], again['reconciled'], again['nextAttempt']), ('closed', True, result['nextAttempt']), again)
  scope = {}
  exec(compile(tree.handle.definitions(), 'retained original observer', 'exec'), scope)
  inventory = scope['_creator_host_work']()
  rows = {row['operationId']: row['status']['state'] for row in inventory['jobs']}
  self.assertEqual((rows[OP], set(rows), inventory['idle']), ('terminal', {OP, custody.operation_id}, False))
  self.assertEqual(kept(), before)

 def test_authorization_requires_current_held_facts_freshness_and_budget(self):
  self.remedy()
  # Held local facts change while the proof is minted: refused before any authorization (C5).
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  tree.hooks = {tree.observations + 1: lambda: tree.touch_evidence('socket')}
  with tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason']), ('refused', 'local_evidence_changed'), result)
  self.assertEqual((tree.record(AUTH), spies['reserve'], spies['release'], tree.own_present()), (None, [], [], True))
  # A same-machine claim appears while the proof is minted: the census in the recheck refuses before any authorization.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  tree.hooks = {tree.observations + 1: lambda: machine_journal(tree)}
  with tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason'], tree.record(AUTH), spies['reserve']), ('refused', 'other_machine_journal_present', None, []), result)
  # A proof that outlived its freshness window never authorizes.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  ticks = itertools.count()
  with tree.spies() as spies:
   result = tree.close(proof, clock=lambda: 1000.0 + 21.0 * next(ticks))
  self.assertEqual((result['state'], result['reason'], tree.record(AUTH), spies['reserve']), ('refused', 'proof_expired', None, []), result)
  # Too little budget left after minting for two guarded observations: refused before any authorization.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  start, calls, smallest = time.monotonic(), itertools.count(), WRITER._CLOSE_SECONDS[0]
  late = lambda: start + (0 if next(calls) < 2 else smallest - WRITER._AUTHORIZE_SECONDS + 1)
  with tree.spies() as spies:
   result = tree.close(proof, timeout=smallest, clock=late)
  self.assertEqual((result['state'], result['reason'], tree.record(AUTH), spies['reserve']), ('refused', 'budget_insufficient', None, []), result)
  # The smallest accepted timeout completes; anything smaller is refused before transport.
  observed = tree.observations
  self.assertEqual(tree.close(proof, timeout=smallest - 1)['reason'], 'inputs_invalid')
  self.assertEqual(tree.observations, observed)
  self.assertEqual(tree.close(proof, timeout=smallest)['state'], 'closed')
  # A resume after the no-VM facts changed refuses and keeps the same authorization.
  tree = Tree(self)
  proof, authorization = tree.authorize_then_refuse()
  os.utime(tree.job / 'stdout.bin', ns=(5, 5))
  again = tree.proof()
  self.assertEqual((again['state'], again['closure']['factsMatchAuthorization']), ('proven', False), again)
  with tree.spies() as spies:
   result = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], result['authorizationSha256'], result['nextAction']),
   ('refused', 'facts_changed', authorization, WRITER.Refused.action), result)
  self.assertEqual((spies['reserve'], spies['release'], sha(tree.record(AUTH)), tree.own_present()), ([], [], authorization, True))

 def test_authorization_and_released_records_bind_exactly_and_guards_expire_in_time(self):
  self.remedy()
  # A tampered authorization field or an extra key never resumes, even with its own digest.
  tree = Tree(self)
  proof, authorization = tree.authorize_then_refuse()
  raw, path = tree.record(AUTH), tree.journal_path(AUTH)
  again = tree.proof()['proofSha256']
  for forged in ({**json.loads(raw), 'programSha256': '0' * 64}, {**json.loads(raw), 'unreviewed': True}):
   overwrite_private(path, canonical(forged).encode())
   with tree.spies() as spies:
    result = tree.close(again, resume=sha(tree.record(AUTH)))
   self.assertEqual((result['state'], result['reason'], spies['reserve']), ('refused', 'record_integrity', []), result)
  overwrite_private(path, raw)
  # A released record while the exact row is still pending is never adopted, even
  # over an otherwise valid chain (authorization, release attempt, released).
  value = json.loads(raw)
  attempt = {'schemaVersion': 1, 'kind': 'windows-creator-prevm-release-submitting-v1', 'operationId': OP, 'cause': value['cause'],
   'reservationId': tree.identity['reservationId'], 'reservationIdentitySha256': value['reservationIdentitySha256'], 'authorizationKey': AUTH,
   'authorizationSha256': authorization, 'proofSha256': value['proofSha256'], 'factsSha256': value['factsSha256'], 'cleanShutdownClaimed': False,
   'nativeActionAllowed': False, 'replayAllowed': False}
  with readiness.RecoveryJournal(tree.journal_path(AUTH).parent).locked(deadline=time.monotonic() + 10) as journal:
   journal.record(RELEASING, attempt)
   journal.record(RELEASED, {'ok': True, 'state': 'released', 'operationId': OP, 'cause': value['cause'], 'reservationId': tree.identity['reservationId'],
    'reservationIdentitySha256': value['reservationIdentitySha256'], 'authorizationKey': AUTH, 'authorizationSha256': authorization,
    'proofSha256': value['proofSha256'], 'factsSha256': value['factsSha256'], 'releaseSubmittingKey': RELEASING,
    'releaseSubmittingSha256': sha(canonical(attempt).encode()), 'cleanShutdownClaimed': False, 'nativeActionAllowed': False, 'replayAllowed': False})
  self.assertIsNotNone(READER.chain(tree.root)['released'])
  with tree.spies() as spies:
   result = tree.close(again, resume=authorization)
  self.assertEqual((result['state'], result['reason'], spies['reserve'], spies['release']), ('refused', 'record_integrity', [], []), result)
  self.assertTrue(tree.own_present())
  # The authorization took so long that the guarded release no longer fits the budget.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  now, write = [time.monotonic()], WRITER._write
  def slow(journal, key, value):
   written = write(journal, key, value)
   if key == AUTH:
    now[0] += 300 - WRITER._RELEASE_SECONDS + 1
   return written
  with mock.patch.object(WRITER, '_write', side_effect=slow), tree.spies() as spies:
   result = tree.close(proof, clock=lambda: now[0])
  self.assertEqual((result['state'], result['reason'], result['authorizationSha256'], spies['reserve']),
   ('refused', 'budget_insufficient', sha(tree.record(AUTH)), []), result)
  # The proof outlives its 120 s lifetime between bookkeeping and release: UNKNOWN, never released.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  now = [time.monotonic()]
  tree.hooks = {tree.observations + 2: lambda: now.__setitem__(0, now[0] + 121)}
  with tree.spies() as spies:
   result = tree.close(proof, clock=lambda: now[0])
  self.assertEqual((result['state'], result['reason'], len(spies['reserve']), spies['release']), ('unknown', 'proof_expired', 1, []), result)
  self.assertTrue(tree.own_present())

 def test_guarded_bookkeeping_and_release_failures_never_overstate_the_outcome(self):
  self.remedy()
  # Held local facts drift right after the authorization: the guard before bookkeeping refuses.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  write = WRITER._write
  def drift(journal, key, value):
   written = write(journal, key, value)
   if key == AUTH:
    tree.touch_evidence('socket')
   return written
  with mock.patch.object(WRITER, '_write', side_effect=drift), tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason'], result['authorizationSha256'], spies['reserve'], spies['release']),
   ('refused', 'local_evidence_changed', sha(tree.record(AUTH)), [], []), result)
  # Transport loss at the guard before bookkeeping: refused, digest returned, no bookkeeping.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  def lost():
   raise ConnectionError('transport lost')
  tree.hooks = {tree.observations + 2: lost}
  with tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason'], result['authorizationSha256']), ('refused', 'observation_unknown', sha(tree.record(AUTH))), result)
  self.assertEqual((spies['reserve'], spies['release']), ([], []))
  # Inventory drift between the locked read and the CAS: refused, the own row stays U0.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  tree.hooks = {tree.observations + 2: tree.foreign_claim}
  with tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason']), ('refused', 'inventory_changed'), result)
  self.assertEqual((spies['reserve'], spies['release']), ([], []))
  self.assertEqual((tree.own_row()['activeJob'], tree.own_row()['activeJobEvidence']['outcome']), ('unknown', 'unknown'))
  # Drift seen by the guard after bookkeeping: UNKNOWN, never released.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  tree.hooks = {tree.observations + 3: lambda: os.mkdir(tree.vm_root, 0o700)}
  with tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason'], result['authorizationSha256']), ('unknown', 'vm_root_present', sha(tree.record(AUTH))), result)
  self.assertEqual((len(spies['reserve']), spies['release'], tree.own_present()), (1, [], True))
  tree.assertUnpublished()
  self.assertIsNone(tree.record(RELEASED))
  # A bookkeeping result with a non-exact identity: UNKNOWN, release never runs.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  def foreign(root, request):
   result = REAL_RESERVE(root, request)
   return {**result, 'identity': {**result['identity'], 'token': 'x' * 32}}
  with mock.patch.object(environments, 'reserve_environment', side_effect=foreign), \
    mock.patch.object(environments, 'release_environment', side_effect=AssertionError('release called')):
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason']), ('unknown', 'reserve_result_unexpected'), result)
  self.assertTrue(tree.own_present())
  # A release acknowledgement without durable absence: UNKNOWN, no released record, link or custody.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  acknowledged = {'ok': True, 'state': 'released', 'identity': tree.identity, 'nativeActionAllowed': False}
  with mock.patch.object(environments, 'release_environment', return_value=acknowledged):
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason']), ('unknown', 'release_unknown'), result)
  self.assertIsNone(tree.record(RELEASED))
  tree.assertUnpublished()

 def test_failures_after_the_release_stay_unknown_and_reconcile_the_same_authorization(self):
  self.remedy()
  # Held local evidence drifts while the last guard observes. The release happened,
  # so the run is UNKNOWN: released is recorded at once, the link is not published.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  original = tree.evidence_path('socket').read_bytes()
  tree.hooks = {tree.observations + 3: lambda: tree.touch_evidence('socket')}
  with tree.spies() as spies:
   result = tree.close(proof)
  authorization = sha(tree.record(AUTH))
  self.assertEqual((result['state'], result['reason'], result['authorizationSha256'], result['nextAction']),
   ('unknown', 'local_evidence_changed', authorization, WRITER._Unknown.action), result)
  self.assertEqual((len(spies['release']), tree.own_present()), (1, False))
  self.assertIsNotNone(tree.record(RELEASED))
  tree.assertUnpublished()
  # While the drift persists a resume refuses before any effect; with the retained
  # evidence intact again the same authorization publishes the link, nothing else.
  pending = tree.close(proof, resume=authorization)
  self.assertEqual((pending['state'], pending['reason'], pending['authorizationSha256']), ('refused', 'local_evidence_changed', authorization), pending)
  tree.evidence_path('socket').write_bytes(original)
  with tree.spies() as spies:
   again = tree.close(proof, resume=authorization)
  self.assertEqual((again['state'], again['reconciled'], spies['reserve'], spies['release']), ('closed', False, [], []), again)
  self.assertEqual(sha(tree.record(AUTH)), authorization)
  # The locked absence read fails right after the release: UNKNOWN; the resume
  # appends released and the link without a second bookkeeping or release.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  inventory, released = resources._inventory, []
  def release(root, identity):
   result = REAL_RELEASE(root, identity)
   released.append(identity)
   return result
  def racing(root):
   if released:
    raise ValueError('private generation changed')
   return inventory(root)
  with mock.patch.object(environments, 'release_environment', side_effect=release), mock.patch.object(resources, '_inventory', side_effect=racing):
   result = tree.close(proof)
  authorization = sha(tree.record(AUTH))
  self.assertEqual((result['state'], result['reason'], result['authorizationSha256']), ('unknown', 'release_unknown', authorization), result)
  self.assertEqual((tree.own_present(), tree.record(RELEASED)), (False, None))
  tree.assertUnpublished()
  with tree.spies() as spies:
   again = tree.close(proof, resume=authorization)
  self.assertEqual((again['state'], spies['reserve'], spies['release']), ('closed', [], []), again)

 def test_claims_this_source_did_not_produce_stop_as_unknown(self):
  self.remedy()
  # Authorization recorded, then the row turns active elsewhere: stop (step 7).
  tree = Tree(self)
  proof, authorization = tree.authorize_then_refuse()
  tree.set_own_evidence('active')
  again = tree.proof()
  # The summary root reviews never calls a foreign row a match (its stable projection is unchanged).
  self.assertEqual((again['closure']['row'], again['closure']['rowMatchesAuthorization']), ('foreign', False))
  before, journal = tree.snapshot(), tree.journal()
  with tree.spies() as spies:
   result = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], result['nextAction'], result['authorizationSha256']),
   ('unknown', 'reservation_foreign', WRITER._Stop.action, authorization), result)
  self.assertEqual((tree.snapshot(), tree.journal(), spies['reserve'], spies['release']), (before, journal, [], []))
  # Lost release ACK, then the proof-free generic route re-mints a claim in the
  # original environment: the same authorization never closes over it.
  tree = Tree(self)
  proof = tree.proof()['proofSha256']
  def lost(root, identity):
   REAL_RELEASE(root, identity)
   raise RuntimeError('acknowledgement lost after durable delete')
  with mock.patch.object(environments, 'release_environment', side_effect=lost):
   self.assertEqual(tree.close(proof)['reason'], 'release_unknown')
  minted = tree.remint()
  self.assertFalse(minted['idempotent'])
  self.assertEqual(tree.proof()['closure']['row'], 'foreign')
  before = tree.snapshot()
  result = tree.close(proof, resume=sha(tree.record(AUTH)))
  self.assertEqual((result['state'], result['reason'], result['nextAction']), ('unknown', 'reservation_foreign', WRITER._Stop.action), result)
  self.assertEqual((tree.snapshot(), tree.record(RELEASED)), (before, None))
  tree.assertUnpublished()
  self.assertIn(minted['identity']['reservationId'], {row['id'] for row in tree.rows()})

 def test_reader_refuses_the_link_while_the_original_claim_or_its_environment_reappears(self):
  self.remedy()
  tree = Tree(self)
  saved = copy.deepcopy(tree.own_row())
  self.assertEqual(tree.close(tree.proof()['proofSha256'])['state'], 'closed')
  READER.current(tree.root)
  with environments._LockedState(tree.root) as locked:
   locked.state['reservations'].append(saved)
   locked.save()
  with self.assertRaises(READER.AttemptUnresolved):
   READER.current(tree.root)
  with environments._LockedState(tree.root) as locked:
   locked.state['reservations'] = [row for row in locked.state['reservations'] if row['id'] != saved['id']]
   locked.save()
  READER.current(tree.root)
  tree.remint()
  with self.assertRaises(READER.AttemptUnresolved):
   READER.current(tree.root)

 def test_support_provenance_constants_reasons_records_and_inputs(self):
  provenance = json.loads((FIXTURES / 'provenance.json').read_bytes())
  self.assertTrue(provenance['nativeFailureClaimed'])
  for leaf, digest in provenance['files'].items():
   self.assertEqual(sha((FIXTURES / leaf).read_bytes()), digest['sha256'], leaf)
  if WRITER is None:
   self.fail('no frozen production identity exists')
  production = WRITER._PRODUCTION
  stdout, stderr = evidence('owner.stdout.public'), evidence('owner.stderr.public')
  self.assertEqual(((len(stdout), sha(stdout)), (len(stderr), sha(stderr)), json.loads(stdout)), (production.stdout, production.stderr, production.typed))
  self.assertEqual(sha(evidence('submission.once.json')), production.evidence['once'][1])
  self.assertEqual(json.loads(evidence('submission.once.json')), {'operationId': OP, 'programSha256': production.program_sha, 'replayAllowed': False})
  self.assertEqual(sha(evidence('original-unsubmitted.proof.json')), production.evidence['unsubmitted'][1])
  # The once driver that preceded the successor is pinned by the source the unsubmitted proof names.
  self.assertEqual(json.loads(evidence('original-unsubmitted.proof.json'))['originalSourceSha256'], production.evidence['onceCaller'][1])
  self.assertEqual({path for path in production.absent}, {driver + '/handoff.' + leaf for driver in (SUCCESSOR, ONCE)
   for leaf in ('once.json', 'public-ack.json', 'unknown.json')})
  causal = json.loads(evidence('socket-path-causal.json'))
  self.assertEqual((causal['socketPathBytes'], len(causal['canonicalCredentialSocketPath'].encode())), (141, 141))
  self.assertEqual(causal['canonicalCredentialSocketPath'], '/home/kardinal/.cache/vpn-control-fixture-creators/' + MACHINE + '/' + OP + '/credentials.sock')
  self.assertEqual(json.loads(evidence('collect.callback.json')), {'complete': True, 'returnCode': 0, 'stderrBytes': 0, 'stdoutBytes': 1718})
  self.assertEqual(json.loads(evidence('unknown.json'))['phase'], 'original-listener')
  for relpath, digest in production.sources.items():
   self.assertEqual(sha((REPO / relpath).read_bytes()), digest, relpath)
  contract = {'readiness_resources.py': '45cc6144', 'native_environment.py': 'e842650c', 'readiness_windows_creator_registry.py': 'd1f06ac9'}
  self.assertTrue(all(production.sources['agent_tools/' + leaf].startswith(prefix) for leaf, prefix in contract.items()))
  self.assertEqual((READER.OP, READER.MACHINE, READER.RID, str(uuid5(UUID(MACHINE), RID))), (OP, MACHINE, RID, OP))
  self.assertEqual(READER.SCOPE, SCOPE)
  # Production entry points cannot select boundaries, identity or runner.
  self.assertEqual(list(inspect.signature(WRITER.run_direct).parameters), ['root', 'action', 'inputs'])
  self.assertNotRegex(inspect.getsource(WRITER.run_direct), 'boundaries|expected|runner')
  # Observer and root census sources are read-only by AST.
  source = '\n'.join(inspect.getsource(getattr(WRITER, n)) for n in sorted({'_observer_main', '_root_census_main', *WRITER._BOUNDARIES, *WRITER._ROOT_BOUNDARIES}))
  tree = ast.parse(source)
  attributes = {n.attr for n in ast.walk(tree) if isinstance(n, ast.Attribute)}
  self.assertFalse(attributes & {'O_WRONLY', 'O_RDWR', 'O_CREAT', 'O_TRUNC', 'O_APPEND', 'mkdir', 'unlink', 'rename', 'chmod', 'remove', 'rmdir', 'replace',
   'symlink', 'link', 'write', 'Popen', 'run', 'system', 'kill', 'defineXML', 'createWithFlags', 'destroy',
   'undefine', 'reserve', '_publish', '_create', 'submit'})
  # Only shared, non-blocking locks; never the ledger's own exclusive lock or save (K16/K17).
  self.assertFalse(attributes & {'LOCK_EX', '_locked', '_save'})
  self.assertEqual({ast.unparse(n.args[1]) for n in ast.walk(tree) if isinstance(n, ast.Call) and getattr(n.func, 'attr', None) == 'flock'},
   {'fcntl.LOCK_SH | fcntl.LOCK_NB'})
  observer = ast.parse(inspect.getsource(WRITER._observer_main))
  called = {(n.value.id, n.attr) for n in ast.walk(observer) if isinstance(n, ast.Attribute) and isinstance(n.value, ast.Name) and n.value.id in ('owner', 'plans')}
  self.assertLessEqual(called, {('owner', leaf) for leaf in ('_root', '_private', '_record', '_intent', '_read', 'observe', 'collect', '_birth',
   'MachineBinding', 'DurableJobError', 'MAX_PROGRAM_BYTES', 'owner_source', '__name__', '__dict__')}
   | {('plans', leaf) for leaf in ('StoragePlans', 'FixtureStorageError', '__name__', '__dict__')})
  self.assertEqual({n.attr for n in ast.walk(observer) if isinstance(n, ast.Attribute) and isinstance(n.value, ast.Call)
   and getattr(n.value.func, 'attr', None) == 'StoragePlans'}, {'_read'})
  # The pinned OWNER and STORAGE functions the observer calls are read-only too.
  plans = next(n for n in ast.parse((REPO / 'scripts/native_fixture_storage.py').read_text()).body if isinstance(n, ast.ClassDef) and n.name == 'StoragePlans')
  bodies = [('StoragePlans._read', next(n for n in plans.body if isinstance(n, ast.FunctionDef) and n.name == '_read'))]
  bodies += [(function.__name__, ast.parse(textwrap.dedent(inspect.getsource(function))))
   for function in (jobs._root, jobs._private, jobs._record, jobs._intent, jobs._read, jobs.observe, jobs.collect, jobs._birth)]
  for label, body in bodies:
   used = {n.attr for n in ast.walk(body) if isinstance(n, ast.Attribute)} | {n.id for n in ast.walk(body) if isinstance(n, ast.Name)}
   self.assertFalse(used & {'O_WRONLY', 'O_RDWR', 'O_CREAT', 'write', 'mkdir', 'unlink', 'rename', 'replace', 'chmod', 'flock', 'LOCK_EX',
    '_publish', '_create', '_save', '_locked', 'link', 'symlink', 'rmdir', 'remove', 'truncate'}, label)
  modes = [ast.literal_eval(n.args[1]) for n in ast.walk(tree) if isinstance(n, ast.Call) and getattr(n.func, 'id', None) == 'open' and len(n.args) > 1]
  self.assertTrue(modes and all(set(mode) <= {'r', 'b'} for mode in modes), modes)
  self.assertFalse([n for n in ast.walk(tree) if isinstance(n, ast.Attribute) and n.attr == 'open' and getattr(n.value, 'id', None) != 'os'])
  lookups = inspect.getsource(WRITER._domain_lookups)
  self.assertLess(lookups.index("os.environ['LIBVIRT_AUTOSTART'] = '0'"), lookups.index('import libvirt'))
  self.assertLess(lookups.index('registerErrorHandler'), lookups.index('openReadOnly'))
  # Every refusal literal is finite and reviewed.
  writer = inspect.getsource(WRITER)
  position = {'_need': 1, '_need_unknown': 1, '_need_stop': 1, 'need': 1, 'Refused': 0, '_Unknown': 0, '_Stop': 0, 'Refusal': 0}
  literals = {call.args[position[call.func.id]].value for call in ast.walk(ast.parse(writer)) if isinstance(call, ast.Call)
   and getattr(call.func, 'id', None) in position and len(call.args) > position[call.func.id]
   and isinstance(call.args[position[call.func.id]], ast.Constant)}
  # Reasons the remote programs emit as {'reason': ...} literals are finite too.
  remote = ast.parse('\n'.join(inspect.getsource(getattr(WRITER, n)) for n in sorted({'_observer_main', '_root_census_main', *WRITER._BOUNDARIES, *WRITER._ROOT_BOUNDARIES})))
  emitted = {value.value for node in ast.walk(remote) if isinstance(node, ast.Dict) for key, value in zip(node.keys, node.values)
   if isinstance(key, ast.Constant) and key.value == 'reason' and isinstance(value, ast.Constant) and isinstance(value.value, str)}
  self.assertTrue(literals and emitted)
  self.assertLessEqual(literals | emitted, WRITER.REASONS)
  self.assertLessEqual(WRITER._ROOT_REASONS, WRITER.REASONS)
  self.assertLessEqual(WRITER._DETAIL_REASONS, WRITER.REASONS)
  # Every census diagnostic substep the embedded sources can emit is finite and reviewed.
  census = ast.parse('\n'.join(inspect.getsource(getattr(WRITER, n)) for n in ('_actor_census', '_root_census_main')))
  steps = {n.args[0].value for n in ast.walk(census) if isinstance(n, ast.Call) and getattr(n.func, 'id', None) in ('fault', 'detail', 'step')
   and n.args and isinstance(n.args[0], ast.Constant)}
  steps |= {'reference-' + kind for kind in ('cmdline', 'descriptor', 'socket', 'cwd', 'root', 'exe', 'maps')}
  self.assertEqual(steps, set(WRITER._DETAIL_STEPS))
  # The close budget covers the minting observation, the authorization and two guarded
  # observations; each observation is the ordinary step plus a possible root census step.
  self.assertEqual((WRITER._OBSERVATION_SECONDS, WRITER._RELEASE_SECONDS, WRITER._AUTHORIZE_SECONDS, WRITER._CLOSE_SECONDS),
   (2 * WRITER._STEP_SECONDS, 2 * WRITER._OBSERVATION_SECONDS + 10, 2 * WRITER._OBSERVATION_SECONDS + 20, (3 * WRITER._OBSERVATION_SECONDS + 35, 300)))
  self.assertGreaterEqual(WRITER._STEP_SECONDS, WRITER._ADMISSION_SECONDS + 5)
  self.assertGreater(WRITER._ADMISSION_SECONDS, WRITER._RUN_SECONDS)
  # Guard #2 ends inside native_environment's 60 s receipt window before the release.
  self.assertLess(WRITER._RECEIPT_SECONDS + 5, 60)
  # The protected credential path is the privileged precedent's own.
  self.assertEqual(WRITER.sudo_credential._credential_path(REPO), REPO / '.codex/arch-sudo.local')
  # Exact inputs refuse before any transport.
  tree = Tree(self)
  for bad in ({'host': 'other', 'timeoutSeconds': 120}, {'host': 'archlinux', 'timeoutSeconds': 5}, {'host': 'archlinux', 'timeoutSeconds': 120, 'x': 1}):
   self.assertEqual(tree.call(WRITER._proof, bad)['reason'], 'inputs_invalid')
  self.assertEqual(tree.close('F' * 64)['reason'], 'inputs_invalid')
  self.assertEqual(tree.close('f' * 64, timeout=60)['reason'], 'inputs_invalid')
  self.assertEqual(tree.close('f' * 64, resume='a' * 64)['reason'], 'resume_unexpected')
  self.assertEqual(tree.observations, 0)
  self.assertEqual(WRITER.run_direct(tree.root, 'replay', {})['reason'], 'inputs_invalid')
  # Close: audit-hooked observer opens no VM path, socket or secret; records are token-free.
  log = tree.base / 'audit.log'
  with tree.spies() as spies:
   proof = tree.proof(audit=log)
   result = tree.close(proof['proofSha256'], audit=log)
  self.assertEqual(result['state'], 'closed', result)
  self.assertFalse(log.exists() and log.read_text(), log.read_text() if log.exists() else '')
  self.assertEqual((spies['secret'], spies['unsubmitted']), ([], []))
  calls = (tree.control.parent / 'control.json.calls').read_text().split()
  self.assertLessEqual(set(calls), {'registerErrorHandler', 'openReadOnly:0', 'getURI', 'lookup:uuid', 'lookup:name', 'close'})
  records = {key: json.loads(tree.record(key)) for key in (AUTH, RELEASED, LINK)}
  for key, value in records.items():
   self.assertFalse(set(value) & {'version', 'target', 'machine', 'action'}, key)
   self.assertNotIn(tree.identity['token'], canonical(value))
  self.assertEqual((records[AUTH]['unsubmittedClaimed'], records[AUTH]['cleanShutdownClaimed'], records[RELEASED]['cleanShutdownClaimed']), (False, False, False))
  self.assertFalse(any(tree.record('unsubmitted:' + str(i)) for i in (1, 2, 3)))
  for output in (proof, result, tree.history()):
   self.assertNotIn(tree.identity['token'], json.dumps(output))
  self.assertEqual(json.loads(tree.record('prepared'))['reservation']['identity'], tree.identity)
  # Phase-region analysis refuses an executing source whose listener region gains an effect.
  WRITER._phase_region(BEFORE.decode())
  with self.assertRaisesRegex(WRITER.Refused, 'phase_region_mismatch'):
   WRITER._phase_region(LISTENER_EFFECT.decode())

 def test_resume_continues_only_over_the_exact_bound_row(self):
  # Root ruling R1. RED: the whole-before writer binds no row into A, so a changed
  # U0 row or a changed own-receipt row is resumed and closed over.
  tree = Tree(self, stub_actors=True)
  proof, authorization = tree.authorize_then_refuse()
  saved = copy.deepcopy(tree.own_row())
  # The original row changes outside this source while it stays UNKNOWN.
  with environments._LockedState(tree.root) as locked:
   row = next(r for r in locked.state['reservations'] if r['id'] == tree.identity['reservationId'])
   row['lastObservation'] = {**row['lastObservation'], 'observedAtUnixMs': row['lastObservation']['observedAtUnixMs'] + 1}
   locked.save()
  again = tree.proof()
  before, journal, observed = tree.snapshot(), tree.journal(), tree.observations
  with tree.spies() as spies:
   result = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], result.get('nextAction'), result.get('authorizationSha256')),
   ('unknown', 'reservation_row_changed', getattr(WRITER._Stop, 'action', None), authorization), result)
  self.assertEqual((tree.snapshot(), tree.journal(), spies['reserve'], spies['release']), (before, journal, [], []))
  # The stop precedes any remote run: nothing is observed over a row A did not bind.
  self.assertEqual(tree.observations, observed)
  # What root reviews before approving a resume digest shows the changed row.
  self.assertEqual((again['closure']['row'], again['closure'].get('rowMatchesAuthorization'), again['closure']['factsMatchAuthorization']), ('unknown', False, True))
  # Restored exactly: the same closure continues with its digest and the same facts.
  with environments._LockedState(tree.root) as locked:
   locked.state['reservations'] = [saved if r['id'] == saved['id'] else r for r in locked.state['reservations']]
   locked.save()
  again = tree.proof()
  self.assertEqual(again['closure']['rowMatchesAuthorization'], True)
  with tree.spies() as spies:
   closed = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((closed['state'], closed['authorizationSha256'], len(spies['reserve']), len(spies['release'])), ('closed', authorization, 1, 1), closed)
  # An own complete receipt (lost bookkeeping ACK) may differ only in bookkeeping fields.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  def lost_reserve(root, request):
   REAL_RESERVE(root, request)
   raise RuntimeError('acknowledgement lost after durable save')
  with mock.patch.object(environments, 'reserve_environment', side_effect=lost_reserve):
   authorization = tree.close(proof)['authorizationSha256']
  self.assertEqual(tree.proof()['closure']['rowMatchesAuthorization'], True)
  with environments._LockedState(tree.root) as locked:
   row = next(r for r in locked.state['reservations'] if r['id'] == tree.identity['reservationId'])
   row['createdAtUnixMs'] += 1
   locked.save()
  with tree.spies() as spies:
   result = tree.close(tree.proof()['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], spies['reserve'], spies['release']), ('unknown', 'reservation_row_changed', [], []), result)
  self.assertTrue(tree.own_present())
  # The row changes while the proof is minted: before A, a positive refusal with no
  # A; over an existing A, the locked read before bookkeeping stops the resume.
  def touch():
   with environments._LockedState(tree.root) as locked:
    row = next(r for r in locked.state['reservations'] if r['id'] == tree.identity['reservationId'])
    row['lastObservation'] = {**row['lastObservation'], 'observedAtUnixMs': row['lastObservation']['observedAtUnixMs'] + 1}
    locked.save()
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  tree.hooks = {tree.observations + 1: touch}
  with tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason'], tree.record(AUTH), spies['reserve']), ('refused', 'inventory_changed', None, []), result)
  tree = Tree(self, stub_actors=True)
  proof, authorization = tree.authorize_then_refuse()
  again = tree.proof()['proofSha256']
  tree.hooks = {tree.observations + 1: touch}
  with tree.spies() as spies:
   result = tree.close(again, resume=authorization)
  self.assertEqual((result['state'], result['reason'], result.get('authorizationSha256'), spies['reserve'], spies['release']),
   ('unknown', 'reservation_row_changed', authorization, [], []), result)

 def test_guard_after_bookkeeping_must_end_inside_the_receipt_window(self):
  # RED: the whole-before guard #2 has no receipt window; natively a guard longer
  # than observationMaximumAgeMs would meet a stale receipt at the release.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  now, window = [time.monotonic()], getattr(WRITER, '_RECEIPT_SECONDS', 50)
  tree.hooks = {tree.observations + 3: lambda: now.__setitem__(0, now[0] + window + 1)}
  with tree.spies() as spies:
   result = tree.close(proof, clock=lambda: now[0])
  self.assertEqual((result['state'], result['reason'], len(spies['reserve']), spies['release']), ('unknown', 'proof_expired', 1, []), result)
  self.assertTrue(tree.own_present())
  tree.assertUnpublished()
  with tree.spies() as spies:
   again = tree.close(tree.proof()['proofSha256'], resume=result['authorizationSha256'])
  self.assertEqual((again['state'], len(spies['reserve']), len(spies['release'])), ('closed', 1, 1), again)

 def test_holder_census_logic_over_a_faked_procfs(self):
  # Root ruling R5 on the exact embedded census source; macOS runs this logic and so
  # does root (denials are modelled by the double, not by file modes). GREEN-only
  # capability proof plus the reviewers' census mutants (C5, C8, K4, K5, own-chain
  # coverage, zombie command line); the causal real-kernel regressions are the
  # Linux tests below.
  self.remedy()
  job, namespace, vm = '/fake/creators/' + MACHINE + '/' + OP, '/fake/creators/' + MACHINE, '/fake/vc-lw-a3aec884'
  paths = [job, namespace, vm]
  proc = FakeProc(self)
  proc.process(100)
  proc.process(101, start=7, denied=True)
  proc.process(102, state='Z', ppid=100, start=9, argv=(), fds=(), cwd=None, root=None, exe=None, maps=(), denied=True)
  proc.process(103, cwd=vm + '-other', fds=(namespace + 'x',), argv=('cat', vm + '2'))
  # A non-dumpable same-account process is denied, never skipped; a zombie is a non-holder.
  self.assertEqual(proc.census(paths), {'reason': None, 'references': 0, 'denied': [[101, 7]], 'zombies': [[102, 100, 'Z', 9]]})
  # Every kind of reference, including the VM root itself deleted (only the ' (deleted)'
  # strip matches it: it is nested under no other target, C8) and a command-line holder
  # whose descriptors are denied (counted at once, never deferred).
  for label, options in (('cwd', {'cwd': job}), ('root', {'root': vm}), ('exe', {'exe': namespace + '/copied'}),
    ('descriptor', {'fds': ('/dev/null', job + '/stdout.bin')}), ('map', {'maps': ('/usr/lib/libc.so.6', job + '/stdout.bin (deleted)')}),
    ('argv', {'argv': ('python3', '-c', 'pass', vm)}), ('deleted-cwd', {'cwd': job + ' (deleted)'}),
    ('deleted-vm-root-cwd', {'cwd': vm + ' (deleted)'}), ('deleted-vm-root-descriptor', {'fds': (vm + ' (deleted)',)}),
    ('deleted-vm-root-map', {'maps': (vm + ' (deleted)',)}), ('denied-argv-holder', {'argv': ('python3', job + '/stdout.bin'), 'denied': True})):
   with self.subTest(label):
    proc = FakeProc(self)
    proc.process(100, start=5, **options)
    census = proc.census(paths)
    kind = {'argv': 'cmdline', 'denied-argv-holder': 'cmdline', 'map': 'maps', 'deleted-cwd': 'cwd', 'deleted-vm-root-cwd': 'cwd',
     'deleted-vm-root-descriptor': 'descriptor', 'deleted-vm-root-map': 'maps'}.get(label, label)
    self.assertEqual((census['references'], census['denied'], census['detail']),
     (1, [], {'substep': 'reference-' + kind, 'pid': 100, 'startTicks': 5, 'errno': None}), census)
  proc = FakeProc(self)
  proc.unix([(777, job + '/credentials.sock'), (778, '/run/user/1000/bus')])
  proc.process(100, fds=('socket:[778]',))
  self.assertEqual(proc.census(paths)['references'], 1)
  proc.process(104, fds=('socket:[777]',))
  self.assertEqual(proc.census(paths)['references'], 2)
  # The ordinary scan reads only the observer's own account: another account's process,
  # even a holder, is neither scanned nor denied there; the root census reads it (N8).
  proc = FakeProc(self)
  proc.process(100, start=5, uid=os.geteuid() + 1, denied=True, fds=('/dev/null', job + '/stdout.bin'))
  self.assertEqual({k: proc.census(paths)[k] for k in ('reason', 'references', 'denied')}, {'reason': None, 'references': 0, 'denied': []})
  proc.denied.clear()
  self.assertEqual(proc.census(paths, privileged=True, denied=[])['references'], 1)
  # The ordinary scan excludes only its own transport chain (this process and its
  # ancestors), never a sibling: a sibling of the observer holding the job counts (C5).
  proc = FakeProc(self)
  shell = 4000001
  proc.process(os.getpid(), ppid=shell, start=50)
  proc.process(shell, ppid=1, start=40, fds=('/dev/null', job + '/stdout.bin'), denied=True)
  proc.process(4000002, ppid=shell, start=60, fds=('/dev/null', job + '/stdout.bin'))
  self.assertEqual({k: proc.census(paths)[k] for k in ('references', 'denied')}, {'references': 1, 'denied': []})
  # The root census excludes only itself (precedent): it examines its own ancestors, so a
  # denied ancestor is reported examined, not exited, and an ancestor holder is found.
  proc.denied.clear()
  privileged = proc.census(paths, privileged=True, denied=[[shell, 40], [4000009, 3]])
  self.assertEqual((privileged['references'], privileged['covered']), (2, [[shell, 40, 'examined'], [4000009, 3, 'exited']]))
  # Bounds: more than 8192 descriptors is typed; a multi-threaded zombie leader, a zombie
  # with a command line or an oversized row is incomplete; every refusal names its step.
  zombie = {'state': 'Z', 'argv': (), 'fds': (), 'cwd': None, 'root': None, 'exe': None, 'maps': ()}
  for label, options, reason, step in (
    ('descriptor-limit', {'fds': ['/dev/null'] * 8193}, 'actor_descriptor_limit', 'descriptor-limit'),
    ('descriptor-bound', {'fds': ['/dev/null'] * 8192}, None, None),
    ('zombie-threads', {**zombie, 'threads': 2, 'denied': True}, 'actor_scan_incomplete', 'zombie-threads'),
    ('zombie-command', {**zombie, 'argv': ('python3', job + '/stdout.bin')}, 'actor_scan_incomplete', 'zombie-command'),
    ('oversized-command', {'argv': ('x' * 1048577,)}, 'actor_scan_incomplete', 'file-oversize')):
   with self.subTest(label):
    proc = FakeProc(self)
    proc.process(100, start=5, **options)
    census = proc.census(paths)
    self.assertEqual((census.get('reason'), census.get('detail', {}).get('substep')), (reason, step), census)
    if step:
     self.assertEqual({k: census['detail'][k] for k in ('pid', 'startTicks', 'errno')}, {'pid': 100, 'startTicks': 5, 'errno': None})
  # The root census reads every process, never accepts a denial, checks kernel threads
  # and zombies, and accounts for every process the ordinary scan could not read.
  proc = FakeProc(self)
  proc.process(100)
  proc.process(101, start=7)
  proc.process(2, flags=PF_KTHREAD, argv=(), fds=(), exe=None, maps=())
  proc.process(102, state='Z', ppid=100, start=9, argv=(), fds=(), cwd=None, root=None, exe=None, maps=())
  self.assertEqual(proc.census(paths, privileged=True, denied=[[101, 7], [555, 3]]), {'reason': None, 'references': 0, 'denied': [], 'zombies': [[102, 100, 'Z', 9]],
   'covered': [[101, 7, 'examined'], [555, 3, 'exited']]})
  # A root-read zombie must show no descriptor, no map and no cwd or root link (K4/K5).
  for label, options, step, errno in (
    ('denied', {'denied': True}, 'privileged-denied', 'EACCES'),
    ('zombie-descriptor', {**zombie, 'fds': ('/dev/null',)}, 'zombie-resources', None),
    ('zombie-map', {**zombie, 'maps': ('/usr/lib/libc.so.6',)}, 'zombie-resources', None),
    ('zombie-cwd', {**zombie, 'cwd': '/'}, 'zombie-resources', None),
    ('zombie-root', {**zombie, 'root': '/'}, 'zombie-resources', None),
    ('zombie-command', {**zombie, 'argv': ('init',)}, 'zombie-command', None),
    ('kernel-command', {'flags': PF_KTHREAD, 'argv': ('init',)}, 'kernel-command', None)):
   with self.subTest(privileged=label):
    proc = FakeProc(self)
    proc.process(101, **options)
    self.assertEqual(proc.census(paths, privileged=True, denied=[[101, 100]]),
     {'reason': 'actor_scan_incomplete', 'detail': {'substep': step, 'pid': 101, 'startTicks': 100, 'errno': errno}})

 def test_census_rechecks_identity_and_its_time_bound_under_a_dynamic_procfs(self):
  # Census review K1/K2/K3/K8 and the precedent's zombie post-check: a process that
  # changes between two reads of the same scan is never trusted.
  self.remedy()
  paths = ['/fake/job', '/fake/namespace', '/fake/vm']
  zombie = {'state': 'Z', 'argv': (), 'fds': (), 'cwd': None, 'root': None, 'exe': None, 'maps': ()}
  for label, options, script, privileged, step in (
    # K1: a readable process whose start changes before its post-check (pid reuse).
    ('pid-reuse-after-scan', {}, (stat_line(100, start=5), stat_line(100, start=6)), False, 'identity-changed'),
    # K2: a denied process whose start changes before the denied row is taken.
    ('pid-reuse-while-denied', {'denied': True}, (stat_line(100, start=5), stat_line(100, start=6)), False, 'identity-changed'),
    # K3: a denied process that turned into a multi-threaded zombie leader.
    ('denied-then-zombie-leader', {'denied': True, 'threads': 2}, (stat_line(100, start=5), stat_line(100, state='Z', start=5)), False, 'zombie-threads'),
    # A zombie whose identity or state changes across its own checks (both modes).
    ('zombie-reused', zombie, (stat_line(100, state='Z', start=5), stat_line(100, state='Z', start=6)), False, 'identity-changed'),
    ('zombie-revived', zombie, (stat_line(100, state='Z', start=5), stat_line(100, state='S', start=5)), True, 'identity-changed')):
   with self.subTest(label):
    proc = FakeProc(self)
    proc.process(100, start=5, **options)
    proc.script(100, 'stat', *script)
    census = proc.census(paths, privileged=privileged, **({'denied': []} if privileged else {}))
    self.assertEqual((census.get('reason'), census.get('detail')),
     ('actor_scan_incomplete', {'substep': step, 'pid': 100, 'startTicks': 5, 'errno': None}), census)
  # A denied process that exited into a clean zombie is a non-holder zombie row.
  proc = FakeProc(self)
  proc.process(100, start=5, denied=True, argv=())
  proc.script(100, 'stat', stat_line(100, start=5), stat_line(100, state='Z', ppid=1, start=5))
  self.assertEqual({k: proc.census(paths)[k] for k in ('reason', 'denied', 'zombies')}, {'reason': None, 'denied': [], 'zombies': [[100, 1, 'Z', 5]]})
  # K8: the whole scan is bounded to 10 s.
  proc = FakeProc(self)
  proc.process(100, start=5)
  proc.clock(after=1, jump=11)
  self.assertEqual(proc.census(paths), {'reason': 'actor_scan_incomplete', 'detail': {'substep': 'scan-deadline', 'pid': 100, 'startTicks': 0, 'errno': None}})

 def test_root_census_is_admitted_only_by_a_measured_denial_and_binds_only_the_proof(self):
  # Root ruling R5. RED: the whole-before observer refuses every denied or zombie
  # same-account process as actor_scan_incomplete, so (sd-pam) blocks every proof.
  tree = Tree(self, stub_actors=True)
  plain = tree.proof()
  self.assertEqual((plain['state'], tree.privileged_sources), ('proven', []), plain)
  tree.write_control(denied=[[4242, 77]], zombies=[[4343, 1, 'Z', 9]])
  denied = tree.proof()
  self.assertEqual((denied['state'], len(tree.privileged_sources)), ('proven', 1), denied)
  self.assertIn("'denied': [[4242, 77]]", tree.privileged_sources[0])
  self.assertEqual(newest_observation(tree)['processes'], {'denied': [[4242, 77]], 'zombies': [[4343, 1, 'Z', 9]]})
  self.assertEqual(newest_observation(tree, 'root-census'), {'kind': 'windows-creator-prevm-root-census-v1', 'state': 'complete', 'scope': 'all-uids',
   'references': 0, 'covered': [[4242, 77, 'examined']]})
  # Process facts bind P, never N: a reaped zombie or a new session never strands A.
  self.assertEqual(denied['factsSha256'], plain['factsSha256'])
  self.assertNotEqual(denied['proofSha256'], plain['proofSha256'])
  # The root program itself refuses unless it runs as root for the expected account.
  scope = WRITER._root_census_source(tree.expected, {'namespace': tree.namespace}, [[4242, 77]], {**tree.boundaries(),
   'root:_root_identity': 'def _root_identity():\n    return {"euid": 1000, "uid": 1000, "sudoUid": None}\n'})
  ran = subprocess.run([sys.executable, '-I', '-B', '-'], input=scope.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
  self.assertEqual(json.loads(ran.stdout), {'kind': 'windows-creator-prevm-root-census-v1', 'state': 'refused', 'reason': 'privileged_census_unknown',
   'detail': {'substep': 'root-identity', 'pid': 0, 'startTicks': 0, 'errno': None}})
  # A close runs the root census in the mint and in both guards; a changed process set refuses.
  proof = denied['proofSha256']
  tree.hooks = {tree.observations + 2: lambda: tree.write_control(denied=[[4242, 77], [4444, 5]])}
  with tree.spies() as spies:
   changed = tree.close(proof)
  self.assertEqual((changed['state'], changed['reason'], changed['authorizationSha256'], spies['reserve']),
   ('refused', 'actors_changed', sha(tree.record(AUTH)), []), changed)
  tree.hooks = {}
  tree.write_control(denied=[[4242, 77]])
  again = tree.proof()
  counted = len(tree.privileged_sources)
  closed = tree.close(again['proofSha256'], resume=changed['authorizationSha256'])
  self.assertEqual((closed['state'], len(tree.privileged_sources) - counted), ('closed', 3), closed)

 def test_privileged_runner_sends_the_protected_credential_only_on_stdin(self):
  # Precedent style (readiness host census, TPM owner): protected credential path,
  # stdin only, bounded streams, an echo discards both streams, typed refusals.
  self.remedy()
  tree = Tree(self, stub_actors=True)
  secret, source, calls, replies = 'prevm-test-only-secret-value', 'print("root census")\n', [], []
  ready = SimpleNamespace(machine=tree.expected.transport_machine, boot=tree.expected.host_binding['boot'], account=tree.expected.host_binding['account'])
  @contextlib.contextmanager
  def admitted(root, host, identity, *, deadline):
   calls.append(('admit', host, deadline - time.monotonic()))
   yield SimpleNamespace(ready=ready, revalidate=lambda: None)
  guard = mock.MagicMock()
  guard.__enter__.return_value = SimpleNamespace(config='config', guard=lambda: None)
  def build(config, host, timeout, *, command):
   calls.append(('argv', command))
   return ['fixture-ssh', host]
  def run_ssh(argv, *, input, stdout, stderr, timeout, cwd):
   calls.append(('run', input, timeout))
   reply = replies.pop(0)
   if isinstance(reply, BaseException):
    raise reply
   return SimpleNamespace(returncode=0, stdout=reply, stderr=b'')
  ctx = {'root': tree.root, 'expected': tree.expected}
  def attempt(runner, reply, kind):
   replies[:], calls[:] = [reply], []
   with mock.patch.object(WRITER.transport, 'admitted_transport', admitted), mock.patch.object(WRITER.deploy.direct, 'Guard', return_value=guard), \
     mock.patch.object(WRITER.transport, 'build_ssh_argv', build), mock.patch.object(WRITER.transport, 'run_ssh', run_ssh):
    return WRITER._run(ctx, runner, source, time.monotonic() + 120, kind)
  privileged, credential = WRITER._privileged_runner(tree.expected), tree.root / '.codex/arch-sudo.local'
  # No (or an unsafe) protected credential: refused before any transport.
  for state in ('absent', 'widened'):
   if state == 'widened':
    private_write(credential, secret.encode() + b'\n')
    os.chmod(credential, 0o644)
   with self.subTest(state), self.assertRaisesRegex(WRITER.Refused, 'privileged_census_unavailable'):
    attempt(privileged, b'{}\n', 'root-census')
   self.assertEqual(calls, [])
  os.chmod(credential, 0o600)
  self.assertEqual(attempt(privileged, b'{"census":true}\n', 'root-census'), b'{"census":true}\n')
  self.assertEqual(calls[1], ('argv', ('sudo', '-S', '-p', '', '--', 'python3', '-I', '-B', '-c', 'exec(' + repr(source) + ')')))
  self.assertEqual((calls[2][0], calls[2][1]), ('run', secret.encode() + b'\n'))
  self.assertLessEqual((calls[0][2], calls[2][2]), (WRITER._ADMISSION_SECONDS, WRITER._RUN_SECONDS))
  self.assertNotIn(secret, repr([call for call in calls if call[0] != 'run']))
  # The protected credential replaced while the run is in flight: nothing is returned (K18).
  def replaced(argv, *, input, stdout, stderr, timeout, cwd):
   calls.append(('run', input, timeout))
   credential.unlink()
   private_write(credential, secret.encode() + b'\n')
   return SimpleNamespace(returncode=0, stdout=b'{"census":true}\n', stderr=b'')
  with mock.patch.object(WRITER.transport, 'admitted_transport', admitted), mock.patch.object(WRITER.deploy.direct, 'Guard', return_value=guard), \
    mock.patch.object(WRITER.transport, 'build_ssh_argv', build), mock.patch.object(WRITER.transport, 'run_ssh', replaced), \
    self.assertRaisesRegex(WRITER.Refused, 'privileged_census_unknown'):
   WRITER._run(ctx, privileged, source, time.monotonic() + 120, 'root-census')
  # An echo of the credential or a timed-out run never returns, retains or parses a stream.
  for reply in (b'{"census":true}' + secret.encode(), subprocess.TimeoutExpired('ssh', 1, output=secret.encode(), stderr=secret.encode())):
   with self.subTest(type(reply).__name__), self.assertRaisesRegex(WRITER.Refused, 'privileged_census_unknown'):
    attempt(privileged, reply, 'root-census')
  # Even a raw timed-out privileged run never has its partial streams retained.
  def timed_out(root, text, deadline):
   raise subprocess.TimeoutExpired('ssh', 1, output=secret.encode(), stderr=secret.encode())
  with self.assertRaisesRegex(WRITER.Refused, 'privileged_census_unknown'):
   WRITER._run(ctx, timed_out, source, time.monotonic() + 120, 'root-census')
  receipts = tree.root / '.rag_index/windows-managed-creator-prevm'
  self.assertFalse([path for path in receipts.rglob('*') if path.is_file() and secret.encode() in path.read_bytes()])
  # The ordinary observer carries only the deflated source and empty stdin.
  attempt(WRITER._transport_runner(tree.expected), b'{}\n', 'observer')
  self.assertEqual((calls[1], calls[2][1]), (('argv', WRITER._command(source)), b''))

 def test_post_link_history_takes_no_lock_and_drops_the_actor_scan(self):
  # Root rulings R5/R6. RED: the whole-before history still scans the original
  # job, so any live reader of the 7e8 job blocks post-link history and proof.
  tree = Tree(self, stub_actors=True)
  result = tree.close(tree.proof()['proofSha256'])
  self.assertEqual(result['state'], 'closed', result)
  self.assertEqual(flock_outside_proof(WRITER._observer_main), [])
  # A live linked attempt holds the namespace marker, the storage ledger and the
  # native inventory exclusively; actors reference the job, namespace and VM root.
  locks = [tree.ns_root / 'creator-namespace.json', tree.ledger / 'storage-plans.lock', tree.root / '.rag_index/native-environments/lock']
  holder = subprocess.Popen([sys.executable, '-c', LOCKS, *map(str, locks)], stdout=subprocess.PIPE)
  tree.children.append(holder)
  self.addCleanup(holder.stdout.close)
  self.assertEqual(holder.stdout.readline(), b'held\n')
  tree.write_control(references={str(tree.job): 1, str(tree.ns_root): 1, tree.vm_root: 1})
  started = time.monotonic()
  history, proof = tree.history(), tree.proof()
  again = tree.close(result['proofSha256'], resume=result['authorizationSha256'])
  self.assertEqual((history['state'], proof['state'], again['state'], again['reconciled']), ('history', 'closed-history', 'closed', True), (history, proof, again))
  self.assertLess(time.monotonic() - started, 60)
  self.assertEqual(newest_observation(tree)['facts']['actors'], {'owner': {**tree.owner, 'alive': False}, 'child': 'unrecorded', 'scan': 'history-dropped'})
  self.assertEqual(tree.privileged_sources, [])

 def test_observer_command_stays_inline_below_the_transport_bound(self):
  # Root ruling R7 through the real transport builder and inline runner with the
  # repository's local SSH peer fixture. RED: the whole-before 'exec(repr(source))'
  # production command exceeds 60,000 bytes and is bound to the saved-program path.
  from agent_tools import ssh_automatic_program as automatic, ssh_transport as transport, private_inventory_lock as private
  from agent_tools.tests.test_ssh_automatic_program import PeerFixture
  tree = Tree(self)
  with private.Directory(READER.journal_directory(tree.root)) as directory:
   local = WRITER._local({'root': tree.root, 'expected': tree.expected}, directory)
  # Production identity and namespace root; a linked attempt makes history's EXPECTED largest.
  production = '/home/kardinal/.cache/vpn-control-fixture-creators/' + MACHINE
  shaped = json.loads(json.dumps(local['namespace']).replace(str(tree.ns_root), production))
  carrier = getattr(WRITER, '_command', lambda source: ('python3', '-I', '-B', '-c', 'exec(' + repr(source) + ')'))
  def executed(command):
   text = command[4]
   if text.startswith('exec('):
    return ast.literal_eval(text[5:-1])
   import base64, zlib
   return zlib.decompress(base64.b64decode(re.fullmatch(r"import base64,zlib;exec\(zlib\.decompress\(base64\.b64decode\('([A-Za-z0-9+/=]+)'\)\)\)", text).group(1))).decode()
  peer_root = tree.base / 'peer-root'
  peer_root.mkdir(mode=0o700)
  peer = PeerFixture(peer_root)
  config = transport.load_config(peer_root)
  for mode, linked in (('proof', ()), ('history', (str(uuid4()),))):
   with self.subTest(mode):
    source = WRITER._observer_source(WRITER._PRODUCTION, {**local, 'namespace': shaped, 'linked': linked}, mode)
    command = carrier(source)
    argv = transport.build_ssh_argv(config, 'explicit-peer', 30, command=command, ssh_binary=str(peer.binary), nested_ssh_binary=str(peer.binary))
    self.assertIsInstance(argv, transport.BoundInlineArgv)
    # Room is left for the production route's SSH options (readiness master, jump host).
    self.assertLessEqual(automatic.command_bytes(argv), 60000 - 8192)
    self.assertEqual(executed(command), source)
    with peer.environment():
     ran = transport.run_ssh(argv, input=b'', stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60, cwd=peer_root)
    value = json.loads(ran.stdout)
    self.assertEqual((ran.returncode, ran.stderr, value['kind'], value['mode']), (0, b'', 'windows-creator-prevm-observation-v1', mode))
  self.assertEqual(len(peer.events()), 2)
  self.assertTrue(all(event['commandBytes'] <= 60000 for event in peer.events()))
  self.assertFalse((peer_root / '.rag_index/ssh-automatic-program').exists())

 def test_reader_reports_missing_custody_as_a_finite_refusal(self):
  # RED: the whole-before reader leaks a raw FileNotFoundError when the link
  # exists but the attempts parent is missing.
  tree = Tree(self, stub_actors=True)
  result = tree.close(tree.proof()['proofSha256'])
  self.assertEqual(result['state'], 'closed', result)
  shutil.rmtree(tree.root / '.rag_index/windows-managed-creator-attempts')
  for call in (lambda: READER.current(tree.root), lambda: READER.creator_handle(tree.root, tree.plan['binding'])):
   with self.assertRaises(READER.AttemptUnresolved) as caught:
    call()
   self.assertEqual(caught.exception.reason, 'attempt_custody_unresolved')
  # The linked close re-publishes only the local custody (S10), nothing else.
  again = tree.close(result['proofSha256'], resume=result['authorizationSha256'])
  self.assertEqual((again['state'], again['reconciled'], READER.current(tree.root).operation_id), ('closed', True, result['nextAttempt']['operationId']))

 def test_release_attempt_record_separates_own_release_from_a_foreign_deletion(self):
  # Safety review F1. RED: the second-revise writer treats ANY absent row over A as
  # its own lost release ACK; after a deletion it never made it records released,
  # links and publishes attempt 2, and root's summary calls the absent row a match.
  self.remedy()
  # (i) A over the untouched U0 row, then a deletion this source never made: stop.
  tree = Tree(self, stub_actors=True)
  proof, authorization = tree.authorize_then_refuse()
  with environments._LockedState(tree.root) as locked:
   locked.state['reservations'] = [r for r in locked.state['reservations'] if r['id'] != tree.identity['reservationId']]
   locked.save()
  again = tree.proof()
  before, journal, observed = tree.snapshot(), tree.journal(), tree.observations
  with tree.spies() as spies:
   result = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], result.get('nextAction'), result.get('authorizationSha256')),
   ('unknown', 'reservation_absent_without_release', WRITER._Stop.action, authorization), result)
  self.assertEqual((tree.snapshot(), tree.journal(), spies['reserve'], spies['release'], tree.observations), (before, journal, [], [], observed))
  self.assertIsNone(tree.record(RELEASED))
  tree.assertUnpublished()
  # What root reviewed before approving that digest never called the absent row a match.
  self.assertEqual({k: again['closure'].get(k) for k in ('row', 'rowMatchesAuthorization', 'releaseSubmitted', 'factsMatchAuthorization')},
   {'row': 'absent', 'rowMatchesAuthorization': False, 'releaseSubmitted': False, 'factsMatchAuthorization': True}, again)
  # (ii) The release ACK is lost after the durable delete: the release-attempt record
  # written right before it proves the release was this source's; the resume records
  # released and the link with no second bookkeeping or release.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  def lost(root, identity):
   REAL_RELEASE(root, identity)
   raise RuntimeError('acknowledgement lost after durable delete')
  with mock.patch.object(environments, 'release_environment', side_effect=lost):
   first = tree.close(proof)
  authorization, attempt = sha(tree.record(AUTH)), tree.record(RELEASING)
  self.assertEqual((first['state'], first['reason'], first['authorizationSha256'], tree.record(RELEASED)),
   ('unknown', 'release_unknown', authorization, None), first)
  value = json.loads(attempt)
  self.assertEqual({k: value[k] for k in ('kind', 'operationId', 'authorizationKey', 'authorizationSha256', 'reservationIdentitySha256', 'replayAllowed')},
   {'kind': 'windows-creator-prevm-release-submitting-v1', 'operationId': OP, 'authorizationKey': AUTH, 'authorizationSha256': authorization,
    'reservationIdentitySha256': sha(canonical(tree.identity).encode()), 'replayAllowed': False})
  self.assertNotIn(tree.identity['token'], attempt.decode())
  again = tree.proof()
  self.assertEqual({k: again['closure'][k] for k in ('row', 'rowMatchesAuthorization', 'releaseSubmitted', 'released')},
   {'row': 'absent', 'rowMatchesAuthorization': True, 'releaseSubmitted': True, 'released': False})
  with tree.spies() as spies:
   second = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((second['state'], spies['reserve'], spies['release'], tree.record(RELEASING)), ('closed', [], [], attempt), second)
  self.assertEqual(json.loads(tree.record(RELEASED))['releaseSubmittingSha256'], sha(attempt))
  # (iii) A crash after the record but before the release: the own receipt row is still
  # present, so the approved resume books it once more and releases it once.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  with mock.patch.object(environments, 'release_environment', side_effect=OSError('crash after the release-attempt record')):
   first = tree.close(proof)
  authorization, attempt = sha(tree.record(AUTH)), tree.record(RELEASING)
  self.assertEqual((first['state'], first['reason'], tree.own_present(), tree.record(RELEASED)), ('unknown', 'release_unknown', True, None), first)
  self.assertIsNotNone(attempt)
  again = tree.proof()
  self.assertEqual((again['closure']['row'] in ('fresh', 'stale'), again['closure']['rowMatchesAuthorization'], again['closure']['releaseSubmitted']),
   (True, True, True), again)
  with tree.spies() as spies:
   second = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((second['state'], len(spies['reserve']), len(spies['release']), tree.record(RELEASING)), ('closed', 1, 1, attempt), second)
  # (iv) The release-attempt record cannot be written: UNKNOWN, and the release never runs.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  publish = readiness.RecoveryJournal._publish_named
  def unavailable(journal, leaf, value):
   if leaf == name(RELEASING):
    raise OSError('release-attempt record unavailable')
   return publish(journal, leaf, value)
  with mock.patch.object(readiness.RecoveryJournal, '_publish_named', unavailable), tree.spies() as spies:
   result = tree.close(proof)
  self.assertEqual((result['state'], result['reason'], len(spies['reserve']), spies['release'], tree.own_present()),
   ('unknown', 'record_unknown', 1, [], True), result)
  self.assertIsNone(tree.record(RELEASING))

 def test_resume_needs_the_exact_authorization_digest_and_the_reviewed_fresh_proof(self):
  # Root ruling R1. These pin behaviour that held but survived the reviewers' mutants
  # (V1, V2b, V3, V3b, R1e); each goes RED under its mutant.
  self.remedy()
  tree = Tree(self, stub_actors=True)
  proof, authorization = tree.authorize_then_refuse()
  fresh = tree.proof()['proofSha256']
  record = json.loads(tree.record(AUTH))
  # R1e: a well-formed digest the caller legitimately holds is still not the authorization.
  for wrong in (fresh, record['proofSha256'], record['factsSha256'], sha(canonical(record).encode() + b' ')):
   with tree.spies() as spies:
    result = tree.close(fresh, resume=wrong)
   self.assertEqual((result['state'], result['reason'], result['authorizationSha256'], spies['reserve'], spies['release']),
    ('refused', 'authorization_mismatch', authorization, [], []), result)
  # V3: over the U0 row, the proof reviewed before the manager changed is stale.
  with tree.spies() as spies:
   stale = tree.close(proof, resume=authorization)
  self.assertEqual((stale['state'], stale['reason'], spies['reserve'], spies['release'], tree.own_row()['activeJob']),
   ('refused', 'proof_mismatch', [], [], 'unknown'), stale)
  # V3b: over this source's own complete receipt, likewise.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  def lost_reserve(root, request):
   REAL_RESERVE(root, request)
   raise RuntimeError('acknowledgement lost after durable save')
  with mock.patch.object(environments, 'reserve_environment', side_effect=lost_reserve):
   authorization = tree.close(proof)['authorizationSha256']
  reviewed = tree.proof()
  self.assertEqual((reviewed['closure']['row'] in ('fresh', 'stale'), reviewed['closure']['rowMatchesAuthorization']), (True, True), reviewed)
  tree.write_control(manager=MANAGER2)
  with tree.spies() as spies:
   result = tree.close(reviewed['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], spies['reserve'], spies['release']), ('refused', 'proof_mismatch', [], []), result)
  # V2b (S8): after a lost release ACK, a changed no-VM fact refuses the released record.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  def lost(root, identity):
   REAL_RELEASE(root, identity)
   raise RuntimeError('acknowledgement lost after durable delete')
  with mock.patch.object(environments, 'release_environment', side_effect=lost):
   authorization = tree.close(proof)['authorizationSha256']
  os.utime(tree.job / 'stdout.bin', ns=(5, 5))
  again = tree.proof()
  self.assertEqual(again['closure']['factsMatchAuthorization'], False)
  result = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], tree.record(RELEASED), tree.record(LINK)), ('refused', 'facts_changed', None, None), result)
  # V2b (S9): released recorded, link missing: a changed no-VM fact refuses the link.
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  original = tree.evidence_path('socket').read_bytes()
  tree.hooks = {tree.observations + 3: lambda: tree.touch_evidence('socket')}
  authorization = tree.close(proof)['authorizationSha256']
  tree.hooks = {}
  self.assertIsNotNone(tree.record(RELEASED))
  tree.evidence_path('socket').write_bytes(original)
  os.utime(tree.job / 'stdout.bin', ns=(5, 5))
  again = tree.proof()
  result = tree.close(again['proofSha256'], resume=authorization)
  self.assertEqual((result['state'], result['reason'], tree.record(LINK)), ('refused', 'facts_changed', None), result)
  tree.assertUnpublished()
  # V1: after the link, the custody-only reconcile needs the exact digest and names only
  # the closure's own proof; a refused re-entry republishes nothing.
  tree = Tree(self, stub_actors=True)
  closed = tree.close(tree.proof()['proofSha256'])
  shutil.rmtree(tree.root / '.rag_index/windows-managed-creator-attempts')
  before = tree.snapshot()
  for expected, resume, reason in ((closed['proofSha256'], None, 'resume_required'), (closed['proofSha256'], 'e' * 64, 'authorization_mismatch'),
    ('a' * 64, closed['authorizationSha256'], 'proof_mismatch')):
   refused = tree.close(expected, resume=resume)
   self.assertEqual((refused['state'], refused['reason'], refused['authorizationSha256']), ('refused', reason, closed['authorizationSha256']), refused)
  self.assertEqual(tree.snapshot(), before)
  self.assertFalse(os.path.lexists(tree.root / '.rag_index/windows-managed-creator-attempts'))
  again = tree.close(closed['proofSha256'], resume=closed['authorizationSha256'])
  self.assertEqual((again['state'], again['reconciled']), ('closed', True), again)

 def test_malformed_link_record_is_record_integrity_everywhere(self):
  # Safety review F5. RED: chain() and creator_handle() raise a raw AttributeError for a
  # parseable link whose closure, parent or next is not an object; the writer reports
  # it as observation_unknown.
  self.remedy()
  tree = Tree(self, stub_actors=True)
  result = tree.close(tree.proof()['proofSha256'])
  path, raw = tree.journal_path(LINK), tree.record(LINK)
  for field, value in (('closure', 'x'), ('parent', []), ('next', None)):
   with self.subTest(field):
    overwrite_private(path, canonical({**json.loads(raw), field: value}).encode())
    for call in (lambda: READER.chain(tree.root), lambda: READER.current(tree.root), lambda: READER.creator_handle(tree.root, tree.plan['binding'])):
     with self.assertRaises(READER.AttemptUnresolved) as caught:
      call()
     self.assertEqual(caught.exception.reason, 'record_integrity')
    for output in (tree.proof(), tree.history(), tree.close(result['proofSha256'], resume=result['authorizationSha256'])):
     self.assertEqual((output['state'], output['reason']), ('refused', 'record_integrity'), output)
  overwrite_private(path, raw)
  self.assertEqual(READER.current(tree.root).operation_id, result['nextAttempt']['operationId'])

 def test_after_the_link_only_the_custody_sources_must_match_the_authorization_epoch(self):
  # Safety review F4. RED: the second-revise writer compares the whole source epoch A
  # bound even after the link, so a later Stage 2 change to this module refuses every
  # custody repair (S10) with source_epoch_changed.
  self.remedy()
  tree = Tree(self, stub_actors=True)
  epoch = WRITER._epoch
  changed = lambda relpath: (lambda expected: {**epoch(expected), relpath: '0' * 64})
  writer = 'agent_tools/readiness_windows_creator_prevm_recovery.py'
  # Before the link the whole epoch binds: a writer change strands A.
  proof, authorization = tree.authorize_then_refuse()
  fresh = tree.proof()['proofSha256']
  with mock.patch.object(WRITER, '_epoch', changed(writer)), tree.spies() as spies:
   result = tree.close(fresh, resume=authorization)
  self.assertEqual((result['state'], result['reason'], spies['reserve']), ('refused', 'source_epoch_changed', []), result)
  closed = tree.close(tree.proof()['proofSha256'], resume=authorization)
  self.assertEqual(closed['state'], 'closed', closed)
  attempts_root = tree.root / '.rag_index/windows-managed-creator-attempts'
  # After it, a change to this module or to a pin custody does not run repairs custody...
  for relpath in (writer, 'agent_tools/native_environment.py'):
   with self.subTest(relpath):
    shutil.rmtree(attempts_root, ignore_errors=True)
    with mock.patch.object(WRITER, '_epoch', changed(relpath)):
     again = tree.close(closed['proofSha256'], resume=authorization)
    self.assertEqual((again['state'], again['reason'], again.get('reconciled')), ('closed', None, True), again)
  # ...while a change to any source the custody publication runs refuses it: the
  # registry retain/load, the create-only rename, the private checks, the derived
  # plan and the reader that validates the published custody.
  custody = ('agent_tools/durable_remote_job.py', 'agent_tools/private_inventory_lock.py', 'agent_tools/readiness_windows_creator_attempts.py',
   'agent_tools/readiness_windows_creator_registry.py', 'agent_tools/readiness_windows_managed_create.py')
  self.assertEqual(sorted(WRITER._CUSTODY_SOURCES), sorted(custody))
  shutil.rmtree(attempts_root, ignore_errors=True)
  for relpath in custody:
   with self.subTest(relpath), mock.patch.object(WRITER, '_epoch', changed(relpath)):
    refused = tree.close(closed['proofSha256'], resume=authorization)
    self.assertEqual((refused['state'], refused['reason']), ('refused', 'source_epoch_changed'), refused)
    self.assertFalse(os.path.lexists(attempts_root))

 def test_custody_publication_never_replaces_an_attempt_root_that_appeared(self):
  # Root ruling R2 (create-only publication). An overwriting rename survived every
  # earlier test (causal review D1).
  self.remedy()
  tree = Tree(self, stub_actors=True)
  proof = tree.proof()['proofSha256']
  retain = registry.retain
  def racing(root, *args):
   result = retain(root, *args)
   # A concurrent publisher's empty final attempt root appears while custody is staged.
   os.mkdir(READER.attempts_parent(tree.root) / json.loads(tree.record(LINK))['next']['recoveryId'], 0o700)
   return result
  with mock.patch.object(registry, 'retain', side_effect=racing):
   result = tree.close(proof)
  parent, rid = READER.attempts_parent(tree.root), json.loads(tree.record(LINK))['next']['recoveryId']
  self.assertEqual((result['state'], result['reason']), ('unknown', 'attempt_custody_unresolved'), result)
  self.assertEqual(os.listdir(parent / rid), [])
  staged = [leaf for leaf in os.listdir(parent) if leaf.startswith('.staging-')]
  self.assertEqual(len(staged), 1)
  self.assertTrue((parent / staged[0] / '.rag_index').is_dir())
  with self.assertRaises(READER.AttemptUnresolved):
   READER.current(tree.root)

 def test_census_refusals_retain_a_bounded_detail_and_every_step_its_timing(self):
  # Census review: native diagnostics land before R1 (this module becomes A's source
  # epoch). RED: the second-revise observer and root census emit only the finite
  # reason, and step callbacks carry no timing.
  self.remedy()
  tree = Tree(self, stub_actors=True)
  self.assertEqual(tree.proof()['state'], 'proven')
  callback, _ = receipts(tree)[-1]
  self.assertEqual({key for key in ('startedMonotonic', 'endedMonotonic', 'elapsedSeconds') if key in callback},
   {'startedMonotonic', 'endedMonotonic', 'elapsedSeconds'}, callback)
  self.assertLessEqual(callback['startedMonotonic'], callback['endedMonotonic'])
  self.assertAlmostEqual(callback['elapsedSeconds'], callback['endedMonotonic'] - callback['startedMonotonic'], places=2)
  for label, control, reason, kind in (
    ('ordinary-holder', {'references': 1, 'censusDetail': {'substep': 'reference-descriptor', 'pid': 4242, 'startTicks': 77, 'errno': None}},
     'actor_reference_present', 'observer'),
    ('ordinary-incomplete', {'censusReason': 'actor_scan_incomplete', 'censusDetail': {'substep': 'proc-io', 'pid': 4242, 'startTicks': 77, 'errno': 'EACCES'}},
     'actor_scan_incomplete', 'observer'),
    ('ordinary-descriptor-limit', {'censusReason': 'actor_descriptor_limit', 'censusDetail': {'substep': 'descriptor-limit', 'pid': 9, 'startTicks': 1, 'errno': None}},
     'actor_descriptor_limit', 'observer'),
    ('root-incomplete', {'denied': [[4242, 77]], 'root': {'reason': 'actor_scan_incomplete', 'detail': {'substep': 'privileged-denied', 'pid': 4242,
     'startTicks': 77, 'errno': 'EPERM'}}}, 'actor_scan_incomplete', 'root-census'),
    ('root-holder', {'denied': [[4242, 77]], 'root': {'references': 1, 'detail': {'substep': 'reference-maps', 'pid': 4242, 'startTicks': 77, 'errno': None}}},
     'actor_reference_present', 'root-census')):
   with self.subTest(label):
    tree.write_control(**control)
    result = tree.proof()
    self.assertEqual((result['state'], result['reason']), ('refused', reason), result)
    self.assertNotIn('detail', json.dumps(result))
    callback, reply = receipts(tree, kind)[-1]
    detail = control.get('censusDetail') or control['root']['detail']
    self.assertEqual((reply['state'], reply['reason'], reply['detail']), ('refused', reason, detail), reply)
    self.assertTrue(callback['complete'] and callback['startedMonotonic'] <= callback['endedMonotonic'], callback)
    tree.write_control(references=0, censusReason=None, censusDetail=None, denied=[], root={})
  # Malformed or unlisted details are never accepted.
  for detail in ({'substep': 'unlisted', 'pid': 1, 'startTicks': 1, 'errno': None}, {'substep': 'proc-io', 'pid': -1, 'startTicks': 1, 'errno': None},
    {'substep': 'proc-io', 'pid': 1, 'startTicks': True, 'errno': None}, {'substep': 'proc-io', 'pid': 1, 'startTicks': 1, 'errno': 'ENOSPC'},
    {'substep': 'proc-io', 'pid': 1, 'startTicks': 1}, {'substep': ['proc-io'], 'pid': 1, 'startTicks': 1, 'errno': None}):
   with self.subTest(detail=detail):
    tree.write_control(censusReason='actor_scan_incomplete', censusDetail=detail)
    self.assertEqual(tree.proof()['reason'], 'observation_invalid')
    tree.write_control(censusReason=None, censusDetail=None, denied=[[4242, 77]], root={'reason': 'actor_scan_incomplete', 'detail': detail})
    self.assertEqual(tree.proof()['reason'], 'privileged_census_unknown')
    tree.write_control(denied=[], root={})
  # A step that fails before any stream still records its timing.
  tree.write_control(denied=[[4242, 77]], privilegedUnavailable=True)
  self.assertEqual(tree.proof()['reason'], 'privileged_census_unavailable')
  callback, reply = receipts(tree, 'root-census')[-1]
  self.assertEqual((callback['complete'], callback['errorClass'], reply), (False, 'Refused', None))
  self.assertLessEqual(callback['startedMonotonic'], callback['endedMonotonic'])

 def test_root_census_refuses_identity_epoch_and_coverage_drift_and_the_vm_root_parent_is_bound(self):
  # Census review K6/K7/K10/K20 (root census boundaries) and K19 (VM-root parent in N).
  self.remedy()
  tree = Tree(self, stub_actors=True)
  tree.write_control(denied=[[4242, 77]])
  self.assertEqual(tree.proof()['state'], 'proven')
  account = int(tree.host.account)
  for label, change, reason in (
    ('another-sudo-account', {'rootIdentity': {'euid': 0, 'uid': 0, 'sudoUid': str(account + 1)}}, 'privileged_census_unknown'),
    ('not-root', {'rootIdentity': {'euid': account, 'uid': account, 'sudoUid': None}}, 'privileged_census_unknown'),
    ('boot-changed-before-scan', {'rootEpochFlip': 'before-scan'}, 'host_epoch_changed'),
    ('boot-changed-after-scan', {'rootEpochFlip': 'after-scan'}, 'host_epoch_changed'),
    ('coverage-state-unknown', {'root': {'covered': [[4242, 77, 'unknown']]}}, 'privileged_census_unknown'),
    ('coverage-row-extended', {'root': {'covered': [[4242, 77, 'examined', 1]]}}, 'privileged_census_unknown'),
    ('coverage-row-missing', {'root': {'covered': []}}, 'privileged_census_unknown')):
   with self.subTest(label):
    tree.write_control(**change)
    self.assertEqual(tree.proof()['reason'], reason)
    tree.write_control(rootIdentity=None, rootEpochFlip=None, root={})
  # K19: the VM root's pinned parent is a no-VM fact; a mode change within the allowed bits changes N.
  proven = tree.proof()
  os.chmod(tree.home, 0o750)
  again = tree.proof()
  self.assertEqual(again['state'], 'proven', again)
  self.assertNotEqual(again['factsSha256'], proven['factsSha256'])
  with tree.spies() as spies:
   result = tree.close(proven['proofSha256'])
  self.assertEqual((result['state'], result['reason'], tree.record(AUTH), spies['reserve']), ('refused', 'proof_mismatch', None, []), result)

 def test_root_census_runs_unchanged_through_the_real_saved_program_password_carrier(self):
  # Census review C2 and ruling R7 for the root step: the real build_ssh_argv/run_ssh
  # saved-program sudo password carrier with the repository's SocketGuest sudo shim
  # (test_ssh_privileged_program); only readiness admission and the direct Guard are
  # controlled. The real sudo on archlinux stays a native fact (runbook R1).
  self.remedy()
  from agent_tools import ssh_automatic_program as automatic, ssh_transport as transport
  from agent_tools.tests.test_ssh_privileged_program import SocketGuest
  tree = Tree(self, stub_actors=True)
  base = tree.base / 'guest'
  base.mkdir(mode=0o700)
  (base / '.rag_index').mkdir(mode=0o700)
  guest = SocketGuest(base)
  self.addCleanup(guest.close)
  guest.base.hosts = {'archlinux': guest.base.hosts['explicit-peer']}
  guest.base.write_config()
  shutil.copy2(guest.base.binary, base / 'ssh')
  config = transport.load_config(base)
  secret, credential = 'prevm-carrier-only-secret-value', base / '.codex/arch-sudo.local'
  private_write(credential, (secret + '\n').encode())
  denied = [[4242, 77]]
  source = WRITER._root_census_source(tree.expected, {'namespace': tree.namespace}, denied, tree.boundaries())
  direct = subprocess.run([sys.executable, '-I', '-B', '-'], input=source.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
  ready = SimpleNamespace(machine=tree.expected.transport_machine, boot=tree.expected.host_binding['boot'], account=tree.expected.host_binding['account'])
  budgets, built = [], []
  @contextlib.contextmanager
  def admitted(root, host, identity, *, deadline):
   budgets.append(deadline - time.monotonic())
   yield SimpleNamespace(ready=ready, revalidate=lambda: None)
  @contextlib.contextmanager
  def guard(root, host):
   yield SimpleNamespace(config=config, guard=lambda: None)
  build = transport.build_ssh_argv
  def recorded(*args, **kwargs):
   built.append(build(*args, **kwargs))
   return built[-1]
  def attempt():
   with guest.environment(), mock.patch.object(WRITER.transport, 'admitted_transport', admitted), \
     mock.patch.object(WRITER.deploy.direct, 'Guard', guard), mock.patch.object(WRITER.transport, 'build_ssh_argv', recorded):
    return WRITER._run({'root': base, 'expected': tree.expected}, WRITER._privileged_runner(tree.expected), source, time.monotonic() + 120, 'root-census')
  guest.mode.write_text('consumed')
  started = time.monotonic()
  out = attempt()
  elapsed = time.monotonic() - started
  self.assertEqual(json.loads(out), json.loads(direct.stdout))
  self.assertEqual(json.loads(out), {'kind': 'windows-creator-prevm-root-census-v1', 'state': 'complete', 'scope': 'all-uids', 'references': 0,
   'covered': [[4242, 77, 'examined']]})
  # The password carrier is always the saved-program transfer, inside one admitted step.
  self.assertIsInstance(built[0], automatic.PlannedArgv)
  self.assertLess(elapsed, WRITER._STEP_SECONDS)
  self.assertLessEqual(max(budgets), WRITER._ADMISSION_SECONDS)
  self.assertTrue(guest.events and all(event['commandBytes'] <= 60000 for event in guest.events), guest.events)
  self.assertEqual(guest.failures, [])
  # The credential is never in argv, the staged program, receipts or claims.
  self.assertNotIn(secret, ' '.join(built[0].original_argv + built[0].command))
  self.assertEqual([path for path in base.rglob('*') if path.is_file() and path != credential and secret.encode() in path.read_bytes()], [])
  # A refused sudo authentication or an echoed credential is never a census.
  for mode in ('denied', 'echo'):
   with self.subTest(mode):
    guest.mode.write_text(mode)
    with self.assertRaisesRegex(WRITER.Refused, 'privileged_census_unknown'):
     attempt()
    self.assertEqual([path for path in base.rglob('*') if path.is_file() and path != credential and secret.encode() in path.read_bytes()], [])

 @unittest.skipUnless(sys.platform.startswith('linux'), 'real Linux /proc ownership, ptrace and zombie semantics')
 @unittest.skipIf(os.geteuid() == 0, 'root reads non-dumpable processes')
 def test_linux_real_procfs_holder_census_regressions(self):
  # Root ruling R5 against the real kernel; kills the reviewers' M12 (skip a denied
  # process) and M13 (no descriptor cap). RED: the whole-before scan refuses the
  # non-dumpable holder and the zombie as incomplete, misses the cwd-only and
  # map-only holders, and has no typed descriptor bound.
  def spawn(tree, code, *arguments, cwd=None, env=None):
   child = subprocess.Popen([sys.executable, '-c', code, *map(str, arguments)], cwd=cwd, stdout=subprocess.PIPE, env={**os.environ, **(env or {})})
   tree.children.append(child)
   self.addCleanup(child.stdout.close)
   line = child.stdout.readline()
   if line.startswith(b'skip'):
    self.skipTest(line.decode().strip())
   self.assertTrue(line.startswith(b'ready'), line)
   return child, line.split()[1:]
  ticks = lambda pid: int(Path('/proc/%d/stat' % pid).read_bytes().rsplit(b')', 1)[1].split()[19])
  # (a) A non-dumpable same-account holder known only by its descriptor (its argv does
  # not name the job): denied, never skipped (M12); only the root census decides.
  tree = Tree(self)
  child, _ = spawn(tree, "import ctypes,os,time;fd=os.open(os.environ['PREVM_HOLD'],os.O_RDONLY);ctypes.CDLL(None).prctl(4,0,0,0,0);"
   "print('ready',flush=True);time.sleep(60)", env={'PREVM_HOLD': str(tree.job / 'stdout.bin')})
  tree.write_control(root={'references': 1})
  self.assertEqual(tree.proof()['reason'], 'actor_reference_present')
  self.assertTrue(any('[%d, %d]' % (child.pid, ticks(child.pid)) in source for source in tree.privileged_sources))
  tree.write_control(privilegedUnavailable=True)
  self.assertEqual(tree.proof()['reason'], 'privileged_census_unavailable')
  # (a') A non-dumpable holder whose argv names the job is a reference at once: no root census.
  tree = Tree(self)
  named, _ = spawn(tree, "import ctypes,os,sys,time;fd=os.open(sys.argv[1],os.O_RDONLY);ctypes.CDLL(None).prctl(4,0,0,0,0);"
   "print('ready',flush=True);time.sleep(60)", tree.job / 'stdout.bin')
  tree.write_control(privilegedUnavailable=True)
  self.assertEqual((tree.proof()['reason'], tree.privileged_sources), ('actor_reference_present', []))
  detail = receipts(tree)[-1][1]['detail']
  self.assertEqual((detail['substep'], detail['pid'], detail['startTicks']), ('reference-cmdline', named.pid, ticks(named.pid)))
  # (b) More than 8192 descriptors in one same-account process: typed refusal (M13).
  with self.subTest('descriptor-limit'):
   tree = Tree(self)
   spawn(tree, "import os,resource,time\nsoft,hard=resource.getrlimit(resource.RLIMIT_NOFILE)\n"
    "if hard!=resource.RLIM_INFINITY and hard<8300:print('skip: descriptor hard limit',hard,flush=True);time.sleep(60)\n"
    "resource.setrlimit(resource.RLIMIT_NOFILE,(8300,hard));held=[os.open('/dev/null',os.O_RDONLY) for _ in range(8200)]\n"
    "print('ready',flush=True);time.sleep(60)")
   self.assertEqual(tree.proof()['reason'], 'actor_descriptor_limit')
  # (c) A cwd-only holder and (d) a map-only holder of the original job.
  with self.subTest('cwd-only'):
   tree = Tree(self)
   spawn(tree, "import time;print('ready',flush=True);time.sleep(60)", cwd=tree.job)
   self.assertEqual(tree.proof()['reason'], 'actor_reference_present')
  with self.subTest('map-only'):
   tree = Tree(self)
   spawn(tree, "import mmap,os,sys,time;fd=os.open(sys.argv[1],os.O_RDONLY);m=mmap.mmap(fd,0,prot=mmap.PROT_READ);os.close(fd)\n"
    "print('ready',flush=True);time.sleep(60)", tree.job / 'stdout.bin')
   self.assertEqual(tree.proof()['reason'], 'actor_reference_present')
  # (e) A same-account zombie is a non-holder bound into P, never into N.
  tree = Tree(self)
  plain = tree.proof()
  parent, rows = spawn(tree, "import os,time\npid=os.fork()\nif pid==0:os._exit(0)\ntime.sleep(.5);print('ready',pid,flush=True);time.sleep(60)")
  zombie = int(rows[0])
  self.assertEqual(Path('/proc/%d/stat' % zombie).read_bytes().rsplit(b')', 1)[1].split()[0], b'Z')
  bound = tree.proof()
  self.assertEqual(bound['state'], 'proven', bound)
  self.assertIn([zombie, parent.pid, 'Z', ticks(zombie)], newest_observation(tree)['processes']['zombies'])
  self.assertEqual(bound['factsSha256'], plain['factsSha256'])
  self.assertNotEqual(bound['proofSha256'], plain['proofSha256'])

 @unittest.skipUnless(sys.platform.startswith('linux'), 'Linux /proc, SO_PEERCRED and boot_id native boundaries')
 def test_linux_native_boundaries_match_old_creator_manager_rules(self):
  if WRITER is None:
   self.fail('no embedded native boundaries exist')
  # Production boundaries are embedded by source; execute exactly that source here.
  scope = {}
  exec(inspect.getsource(CURRENT.host_machine) + '\n' + inspect.getsource(WRITER._host_epoch) + '\n' + inspect.getsource(WRITER._manager_identity)
   + '\n' + inspect.getsource(WRITER._actor_census), scope)
  self.assertEqual(scope['_host_epoch'](), {'machine': CURRENT.host_machine(), 'boot': jobs._boot(), 'account': str(os.geteuid())})
  with tempfile.TemporaryDirectory(dir='/tmp') as directory:
   path = os.path.join(directory, 's')
   server = socket.socket(socket.AF_UNIX)
   server.bind(path)
   os.chmod(path, 0o600)
   server.listen(1)
   try:
    executable = os.path.realpath(sys.executable)
    if os.stat(executable).st_uid == 0 and not os.stat(executable).st_mode & 0o022:
     row = scope['_manager_identity'](path, executable)
     self.assertEqual((row['pid'], row['socketIdentity'][:2]), (os.getpid(), [os.lstat(path).st_dev, os.lstat(path).st_ino]))
    self.assertIsNone(scope['_manager_identity'](path, '/usr/bin/virtqemud-not-this'))
   finally:
    server.close()
   child = subprocess.Popen([sys.executable, '-c', 'import os,sys,time;fd=os.open(sys.argv[1],os.O_RDONLY);time.sleep(30)', directory])
   try:
    time.sleep(.3)
    self.assertGreaterEqual(scope['_actor_census']([directory])['references'], 1)
   finally:
    child.kill()
    child.wait()


class LinuxRootCensusCausalTests(unittest.TestCase):
 """Root-run real-kernel RED/GREEN of the generated root census (census review C1).

 Precedent: test_windows_tpm_owner.LinuxKernelCausalTests, run by the Fast Checks
 sudo step. Children drop to uid 65534: a non-dumpable non-holder, a zombie, a
 non-dumpable holder known only by its descriptor and one whose argv names the
 job. RED: the whole-before stage-1 ordinary scan (frozen beforeimage), run as
 uid 65534 on the real procfs, refuses the non-dumpable non-holder (-1). GREEN:
 the ordinary scan reports it denied and the zombie as a non-holder row; the
 exact generated root census, run as root with SUDO_UID=65534 and the
 production boundaries, completes with references 0 and covers the denied
 process as examined, and refuses actor_reference_present for the holder.
 """
 @unittest.skipUnless(sys.platform.startswith('linux') and os.geteuid() == 0, 'actual Linux root census capability required')
 def test_whole_before_ordinary_scan_red_generated_root_census_green(self):
  capabilities = int(next(v.split()[1] for v in Path('/proc/self/status').read_text().splitlines() if v.startswith('CapEff:')), 16)
  if not capabilities & (1 << 19):
   self.skipTest('actual CAP_SYS_PTRACE required; cannot substitute mocked procfs')
  self.assertIsNotNone(WRITER, 'missing capability: no generated root census exists before the remedy')
  raw = (STAGE1 / 'stage1-writer.before.source').read_bytes()
  self.assertEqual(sha(raw), json.loads((STAGE1 / 'provenance.json').read_bytes())['files']['stage1-writer.before.source']['sha256'])
  before = next(ast.get_source_segment(raw.decode(), node) for node in ast.parse(raw.decode()).body
   if isinstance(node, ast.FunctionDef) and node.name == '_actor_references')
  uid, children = 65534, []
  drop = 'import os\nos.setgroups([]);os.setgid(65534);os.setuid(65534)\n'
  ticks = lambda pid: int(Path('/proc/%d/stat' % pid).read_bytes().rsplit(b')', 1)[1].split()[19])
  def spawn(code, *arguments, env=None):
   child = subprocess.Popen([sys.executable, '-I', '-c', drop + code, *map(str, arguments)], stdout=subprocess.PIPE,
    env={**os.environ, **(env or {})})
   children.append(child)
   line = child.stdout.readline()
   self.assertTrue(line.startswith(b'ready'), line)
   return child, line.split()[1:]
  def unprivileged(source):
   ran = subprocess.run([sys.executable, '-I', '-B', '-c', drop + source], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
   self.assertEqual((ran.returncode, ran.stderr), (0, b''), ran.stderr)
   return json.loads(ran.stdout)
  with tempfile.TemporaryDirectory(dir='/tmp') as directory:
   home = Path(directory)
   home.chmod(0o700)
   os.chown(home, uid, uid)
   namespace, vm = home / 'creators' / MACHINE, home / 'vc-lw-a3aec884'
   job, held = namespace / OP, namespace / OP / 'stdout.bin'
   for path in (home / 'creators', namespace, job):
    path.mkdir(mode=0o700)
    os.chown(path, uid, uid)
   held.write_bytes(b'original job stream\n')
   held.chmod(0o600)
   os.chown(held, uid, uid)
   paths = [str(job), str(namespace), str(vm)]
   ordinary = lambda: unprivileged(inspect.getsource(WRITER._actor_census) + '\nimport json\nprint(json.dumps(_actor_census(%r)))\n' % paths)
   expected = dataclasses.replace(WRITER._PRODUCTION, vm_root=str(vm), host_binding={'target': 'archlinux', 'machine': CURRENT.host_machine(),
    'boot': Path('/proc/sys/kernel/random/boot_id').read_text().strip(), 'account': str(uid)})
   def root_census(denied):
    source = WRITER._root_census_source(expected, {'namespace': {'root': str(namespace)}}, denied)
    ran = subprocess.run([sys.executable, '-I', '-B', '-c', source], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60,
     env={**os.environ, 'SUDO_UID': str(uid)})
    self.assertEqual((ran.returncode, ran.stderr), (0, b''), ran.stderr)
    return json.loads(ran.stdout)
   try:
    hidden, _ = spawn("import ctypes,time;ctypes.CDLL(None).prctl(4,0,0,0,0);print('ready',flush=True);time.sleep(60)")
    parent, rows = spawn("import ctypes,time\nctypes.CDLL(None).prctl(4,1,0,0,0)\npid=os.fork()\nif pid==0:os._exit(0)\n"
     "time.sleep(.5);print('ready',pid,flush=True);time.sleep(60)")
    zombie = int(rows[0])
    self.assertEqual(Path('/proc/%d/stat' % zombie).read_bytes().rsplit(b')', 1)[1].split()[0], b'Z')
    # RED: the whole-before stage-1 ordinary scan refuses on the non-dumpable non-holder.
    self.assertEqual(unprivileged(before + '\nimport json\nprint(json.dumps(_actor_references(%r)))\n' % paths), -1)
    # GREEN: denied, never skipped; the zombie is a non-holder row ...
    scan = ordinary()
    self.assertEqual((scan['reason'], scan['references']), (None, 0), scan)
    self.assertIn([hidden.pid, ticks(hidden.pid)], scan['denied'])
    self.assertIn([zombie, parent.pid, 'Z', ticks(zombie)], scan['zombies'])
    # ... and the exact generated root census completes over every account.
    complete = root_census(scan['denied'])
    self.assertEqual({key: complete.get(key) for key in ('kind', 'state', 'scope', 'references')},
     {'kind': 'windows-creator-prevm-root-census-v1', 'state': 'complete', 'scope': 'all-uids', 'references': 0}, complete)
    self.assertEqual([row[:2] for row in complete['covered']], scan['denied'])
    self.assertIn([hidden.pid, ticks(hidden.pid), 'examined'], complete['covered'])
    # A non-dumpable holder known only by its descriptor: denied to the scan, found by root.
    holder, _ = spawn("import ctypes,time;fd=os.open(os.environ['PREVM_HOLD'],os.O_RDONLY);ctypes.CDLL(None).prctl(4,0,0,0,0);"
     "print('ready',flush=True);time.sleep(60)", env={'PREVM_HOLD': str(held)})
    scan = ordinary()
    self.assertEqual((scan['reason'], scan['references']), (None, 0), scan)
    self.assertIn([holder.pid, ticks(holder.pid)], scan['denied'])
    refused = root_census(scan['denied'])
    self.assertEqual((refused['state'], refused['reason'], refused['detail']['substep'], refused['detail']['pid']),
     ('refused', 'actor_reference_present', 'reference-descriptor', holder.pid), refused)
    # A non-dumpable holder whose argv names the job is a reference of the ordinary scan itself.
    named, _ = spawn("import ctypes,sys,time;fd=os.open(sys.argv[1],os.O_RDONLY);ctypes.CDLL(None).prctl(4,0,0,0,0);"
     "print('ready',flush=True);time.sleep(60)", held)
    scan = ordinary()
    self.assertEqual((scan['reason'], scan['references'], scan['detail']['substep'], scan['detail']['pid']),
     (None, 1, 'reference-cmdline', named.pid), scan)
   finally:
    for child in children:
     child.kill()
     child.wait(timeout=5)
     child.stdout.close()


if __name__ == '__main__':
 unittest.main()
