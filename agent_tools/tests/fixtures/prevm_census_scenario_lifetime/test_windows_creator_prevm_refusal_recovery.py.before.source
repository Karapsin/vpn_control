from agent_tools import readiness_windows_creator_registry as registry, readiness_windows_managed_create as CURRENT, windows_vm_media as media

FIXTURES = Path(__file__).parent / 'fixtures/windows_creator_prevm_refusal_recovery'
STAGE1 = FIXTURES / 'beforeimage'
OLD_FIXTURES = Path(__file__).parent / 'fixtures/windows_managed_creator_unix_address'
REPO = Path(__file__).resolve().parents[2]
OP, MACHINE = '7e8b2dcd-63c1-58fc-b382-f64695bacf11', 'a3aec884-5e5c-47c6-b1c6-378d88045d72'
RID = '142e4db1bbd672d1be706c61f3269ce1770675c8398cc4f88ffb675831f94769'
AUTH, RELEASED, LINK = 'release-authorized:creator-prevm', 'released', 'generation-link:2'
RELEASING = 'release-submitting:creator-prevm'
DIRECT = '.runtime/tool-recovery-windows/direct/'
SUCCESSOR, ONCE = DIRECT + 'new-libvirt-create-successor-' + OP, DIRECT + 'new-libvirt-create-once-' + OP
SCOPE = 'aca6b625f87d0696b7b9579774e38596c2cc0e5ff986d0c331b010afcb255d7c'
GIB = 1024**3
MANAGER2 = {'pid': 4343, 'birth': 100, 'executableGeneration': [1] * 9, 'socketIdentity': [1] * 5}
REAL_RESERVE, REAL_RELEASE = environments.reserve_environment, environments.release_environment
sha = lambda raw: hashlib.sha256(raw).hexdigest()
canonical = lambda value: json.dumps(value, sort_keys=True, separators=(',', ':'))
name = lambda key: sha(key.encode()) + '.json'
pin = lambda path: (lambda i: [i.st_dev, i.st_ino, i.st_mode, i.st_uid, i.st_gid, i.st_nlink, i.st_size, i.st_mtime_ns, i.st_ctime_ns])(os.lstat(path))


def optional(module):
 try:
  return importlib.import_module('agent_tools.' + module)
 except ModuleNotFoundError as error:
  if error.name != 'agent_tools.' + module:
   raise
  return None


WRITER, READER = optional('readiness_windows_creator_prevm_recovery'), optional('readiness_windows_creator_attempts')


def evidence(leaf):
 raw = (FIXTURES / 'evidence' / leaf).read_bytes()
 assert sha(raw) == json.loads((FIXTURES / 'provenance.json').read_bytes())['files']['evidence/' + leaf]['sha256'], leaf
 return raw


def executing_before():
 path = OLD_FIXTURES / 'managed_create.before.source'
 raw = path.read_bytes()
 assert sha(raw) == json.loads((OLD_FIXTURES / 'provenance.json').read_bytes())['files']['managed_create.before.source']['sha256'] == \
 '8aeb4c0153ea840c595a5996295e62f6ef6b5504df2cb4845cbbab953955d218'
 module = types.ModuleType('agent_tools._prevm_executing_before')
 module.__package__, module.__file__ = 'agent_tools', str(REPO / 'agent_tools/readiness_windows_managed_create.py')
 sys.modules[module.__name__] = module
 exec(compile(raw, str(path), 'exec'), module.__dict__)
 return module, raw


def executing_module(raw, directory):
 """An executing creator from exact bytes; inspect reads back the same file."""
 path = directory / 'executing.before.source'
 path.write_bytes(raw)
 module = types.ModuleType('agent_tools._prevm_executing_' + sha(raw)[:16])
 module.__package__, module.__file__ = 'agent_tools', str(REPO / 'agent_tools/readiness_windows_managed_create.py')
 sys.modules[module.__name__] = module
 exec(compile(raw, str(path), 'exec'), module.__dict__)
 return module


OLD, BEFORE = executing_before()
# An executing source whose listener region could reach a durable effect before 'capacity'.
LISTENER_EFFECT = BEFORE.replace(b"        answer=private_answer(PLAN['binding']['setup'],credentials);",
 b"        save('x.json',{});answer=private_answer(PLAN['binding']['setup'],credentials);")
assert LISTENER_EFFECT != BEFORE
MEDIA = [('pycdlib/__init__.py', Path('/nonexistent'), b'# controlled media reader capsule\n')]
FAKE_LIBVIRT = '''import builtins, json, os
VIR_ERR_NO_DOMAIN = 42
CONTROL = %r
class libvirtError(Exception):
    def __init__(self, code):
        self.code = code
        super().__init__('controlled')
    def get_error_code(self):
        return self.code
def _log(text):
    with builtins.open(CONTROL + '.calls', 'a') as stream:
        stream.write(text + '\\n')
def registerErrorHandler(handler, context):
    _log('registerErrorHandler')
class _Connection:
    def __init__(self, uri):
        self.uri = uri
    def getURI(self):
        _log('getURI')
        return self.uri
    def _lookup(self, kind):
        _log('lookup:' + kind)
        value = json.load(builtins.open(CONTROL))
        if kind == 'name' and value.get('managerAfterLookup'):
            # The ordinary manager restarts while the lookups run.
            value['manager'] = value.pop('managerAfterLookup')
            with builtins.open(CONTROL, 'w') as stream:
                json.dump(value, stream)
        if kind == 'name' and value.get('touchDuringLookup'):
            # A job file changes after the observer pinned it.
            os.utime(value['touchDuringLookup'], ns=(7, 7))
        code = value['domain'][kind]
        if code == 'visible':
            return object()
        raise libvirtError(VIR_ERR_NO_DOMAIN if code == 'absent' else 1)
    def lookupByUUIDString(self, value):
        return self._lookup('uuid')
    def lookupByName(self, value):
        return self._lookup('name')
    def close(self):
        _log('close')
def openReadOnly(uri):
    _log('openReadOnly:' + os.environ.get('LIBVIRT_AUTOSTART', 'unset'))
    return _Connection(uri)
def open(uri):
    _log('open')
    raise libvirtError(1)
'''
AUDIT = '''import sys
def _prevm_audit(event, args, _forbidden=%r, _log=%r):
    if event in ('open', 'socket.connect', 'socket.bind'):
        text = str(args[0] if event == 'open' else args[1])
        if any(mark in text for mark in _forbidden) or text.endswith('.secret'):
            with __import__('builtins').open(_log, 'a') as stream:
                stream.write(event + ' ' + text + '\\n')
sys.addaudithook(_prevm_audit)
'''
MEASUREMENT = {'physicalMemoryBytes': 128 * GIB, 'runningConfiguredMemoryBytes': 2 * GIB, 'swapUsedBytes': 0, 'pressure': 'normal'}


@contextlib.contextmanager
def sampled(boot, vms):
 guard = mock.MagicMock()
 guard.__enter__.return_value = SimpleNamespace(config=SimpleNamespace(hosts={'archlinux': object()}), guard=lambda: None)

 def observe(root, target, mode, credential_file=None, **kwargs):
  assert mode == 'host-resources' and credential_file is not None
  now = time.time_ns() // 1_000_000
  sample = lambda at: {'observedAtUnixMs': at, 'availableMemoryBytes': 48 * GIB, 'psi': 'normal', 'psiSomeAvg10': 0., 'psiFullAvg10': 0.,
   'vmstat': {'pswpin': 0, 'pswpout': 0, 'oomKill': 0}}
  return {'schemaVersion': 1, 'deploymentId': target.deployment_id, 'mode': 'host-resources', 'state': 'resources-observed', 'reason': None,
   'hostBootId': boot, 'vms': copy.deepcopy(vms), 'physicalMemoryBytes': 64 * GIB, 'swapUsedBytes': 0,
   'samples': [sample(now - 100), sample(now)], 'freeDiskBytes': 300 * GIB, 'inventoryComplete': True,
   'nativeActionAllowed': False, 'replayAllowed': False}
 with mock.patch.object(resources.deploy.direct, 'Guard', return_value=guard), mock.patch.object(resources, '_remote_observation', side_effect=observe):
  yield


def private_write(path, raw):
 path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
 fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
 with os.fdopen(fd, 'wb') as stream:
  stream.write(raw)


def overwrite_private(path, raw):
 if os.path.lexists(path):
  path.unlink()
 private_write(path, raw)


class Tree:
 """One 7e8-shaped consumed claim built only through real code paths."""
 def __init__(self, case, *, live_owner=False, overflow=False, old=None, old_source=None, stub_actors=False):
  self.case, self.tmp = case, tempfile.TemporaryDirectory(dir=Path('/tmp').resolve())
  case.addCleanup(self.cleanup)
  self.base = Path(self.tmp.name)
  self.base.chmod(0o700)
  self.root, self.home, self.control, self.fake = self.base / 'r', self.base / 'h', self.base / 'control.json', self.base / 'fake'
  for path in (self.root, self.root / '.rag_index', self.home, self.fake):
   path.mkdir(mode=0o700)
  self.children, self.observations, self.hooks, self.stub_actors, self.privileged_sources = [], 0, {}, stub_actors, []
  self.old_source = BEFORE if old_source is None else old_source
  self.old = old or (OLD if old_source is None else executing_module(old_source, self.base))
  self.host = jobs.MachineBinding('archlinux', CURRENT.host_machine(), jobs._boot(), str(os.geteuid()))
  self.boot = str(UUID(self.host.boot))
  self.vm_root = str(self.home / 'vc-lw-a3aec884')
  asset = lambda leaf: {'path': str(self.base / 'media' / leaf), 'bytes': 4096, 'sha256': sha(leaf.encode())}
  spec = {'deploymentId': MACHINE, 'host': 'archlinux', 'root': self.vm_root, 'memoryMiB': 4096, 'cpus': 4, 'diskGiB': 64, 'vncPort': 5953,
   'headroomMiB': 8192, 'assets': {'installer': asset('windows-x64.iso'), 'drivers': asset('virtio-win.iso'),
   'firmwareCode': asset('code.fd'), 'firmwareVars': asset('vars.fd')}}
  setup = {'user': 'recovery', 'administrator': 'recoveryadmin', 'locale': 'en-US', 'imageName': 'Windows 11 Enterprise Evaluation'}
  uri = 'qemu+unix:///session?socket=' + quote(str(self.home / '.cache/libvirt/virtqemud-sock'), safe='/')
  self.plan = CURRENT.plan(spec, setup, {'hostBootId': self.boot, 'pending': []}, uri, 'vc-recovery-libvirt-a3aec884', OP, RID)
  initialized = subprocess.run([sys.executable, '-I', '-B', '-'], input=CURRENT.initialize_program(self.plan, self.host),
   stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
  assert initialized.returncode == 0 and not initialized.stderr, initialized.stderr
  self.namespace = CURRENT._namespace_reply(self.plan, self.host, json.loads(initialized.stdout))
  self.ns_root = Path(self.namespace['root'])
  self.job = self.ns_root / OP
  self.vms = [{'pid': 17, 'startTicks': 777, 'sessionId': 17, 'uid': 1000, 'commandSha256': 'a' * 64,
   'executableGeneration': [1] * 9, 'configuredMemoryBytes': 2 * GIB}]
  measurement = {'physicalMemoryBytes': 64 * GIB, 'runningConfiguredMemoryBytes': 2 * GIB, 'swapUsedBytes': 0, 'pressure': 'normal'}
  environments.reserve_environment(self.root, {'hostAlias': 'archlinux', 'environment': 'recovery-' + str(uuid4()), 'operator': 'readiness-resources',
   'requestedMemoryBytes': 2 * GIB, 'headroomBytes': 8 * GIB, 'measurement': measurement})
  request = {'hostAlias': 'archlinux', 'environment': 'windows-' + str(uuid4()), 'operator': 'windows-vm-deploy',
   'requestedMemoryBytes': 2 * GIB, 'headroomBytes': 8 * GIB, 'measurement': measurement}
  running = environments.reserve_environment(self.root, request)
  environments.reserve_environment(self.root, {**request, 'allocationState': 'running', 'reservationIdentity': running['identity'],
   'runningAllocationMapping': [{'reservationId': running['identity']['reservationId'], 'memoryBytes': 2 * GIB}]})
  with sampled(self.boot, self.vms):
   self.admission = self.prepare()
   assert self.admission.mark_submitting() is True
  self.identity = self.admission.reservation_identity
  self.storage = types.ModuleType('prevm_test_storage')
  exec(compile((REPO / 'scripts/native_fixture_storage.py').read_bytes(), 'storage', 'exec'), self.storage.__dict__)
  self.ledger = self.home / '.cache/vpn-control-fixture-storage'
  self.ledger.mkdir(mode=0o700)
  self.add_storage_plan('linux-unrelated', str(self.home / 'other'))
  with mock.patch.object(media, 'dependency_sources', return_value=MEDIA):
   self.program = self.old.creator_program(self.plan, self.admission, self.namespace, self.host)
  self.index = {'operationId': OP, 'binding': jobs.asdict(self.host), 'programSha256': self.program.digest, 'streamLimit': 262144,
   'admissionsGeneration': self.namespace['admissionsGeneration']}
  self.old._creator_admission(jobs, self.ns_root, self.index, create=True)
  self.job.mkdir(mode=0o700)
  self.intent = {'schemaVersion': 1, 'operationId': OP, 'binding': jobs.asdict(self.host), 'purpose': 'windows-managed-first-create',
   'programSha256': self.program.digest, 'streamLimit': 262144, 'generation': str(uuid4())}
  jobs._publish(self.job / 'intent.json', self.intent)
  jobs._create(self.job / 'program.py', self.program.source)
  jobs._create(self.job / 'owner.py', jobs.owner_source())
  child = subprocess.Popen([sys.executable, '-c', 'import time;time.sleep(60)'], stdin=subprocess.DEVNULL)
  self.children.append(child)
  owner = {'pid': child.pid, 'birth': jobs._birth(child.pid)}
  assert owner['birth']
  if not live_owner:
   child.kill()
   child.wait()
  correlation = {key: self.intent[key] for key in ('operationId', 'binding', 'programSha256', 'generation')}
  jobs._publish(self.job / 'owner.json', {**correlation, 'owner': owner})
  jobs._create(self.job / 'child-admission', b'consumed\n')
  self.stdout, self.stderr = evidence('owner.stdout.public'), evidence('owner.stderr.public')
  jobs._create(self.job / 'stdout.bin', self.stdout)
  jobs._create(self.job / 'stderr.bin', self.stderr)
  stream = lambda raw: {'overflow': overflow, 'retainedBytes': len(raw), 'totalBytes': len(raw) + overflow, 'sha256': sha(raw)}
  jobs._publish(self.job / 'terminal.json', {**correlation, 'owner': owner, 'exitCode': 0, 'streamsClosed': True,
   'stdout': stream(self.stdout), 'stderr': stream(self.stderr)})
  self.owner = owner
  self.handle = registry.retain(self.root, self.plan, self.host, self.namespace)
  self.write_control()
  (self.fake / 'libvirt.py').write_text(FAKE_LIBVIRT % str(self.control))
  if WRITER is not None:
   self.layout()

 def cleanup(self):
  for child in self.children:
   if child.poll() is None:
    child.kill()
    child.wait()
  self.tmp.cleanup()

 def prepare(self):
  return resources.prepare_start(self.root, host='archlinux', machine_uuid=MACHINE, operation_id=OP, fixture_root=self.vm_root,
   credential_file=str(self.base / 'no-host-credential'), requested_memory_bytes=4 * GIB, headroom_bytes=8 * GIB)

 def add_storage_plan(self, fixture, directory):
  plans = self.storage.StoragePlans(self.ledger)
  with plans._locked():
   value = plans._read()
   value['plans'][fixture] = {'platform': 'linux', 'directory': directory, 'disks': [{'path': directory + '/disk.qcow2', 'capacityBytes': GIB}],
    'workingBytes': 0, 'writerPid': None, 'state': 'retained'}
   plans._save(value)

 def write_control(self, **changes):
  value = json.loads(self.control.read_text()) if self.control.exists() else {
   'epoch': {'machine': self.host.machine, 'boot': self.host.boot, 'account': self.host.account}, 'references': 0,
   'censusReason': None, 'denied': [], 'zombies': [], 'root': {}, 'privilegedUnavailable': False,
   'manager': {'pid': 4242, 'birth': 99, 'executableGeneration': [1] * 9, 'socketIdentity': [1] * 5},
   'domain': {'uuid': 'absent', 'name': 'absent'}}
  value.update(changes)
  self.control.write_text(json.dumps(value))

 def layout(self):
  production = WRITER._PRODUCTION
  content = {'program': self.program.source, 'once': canonical({'operationId': OP, 'programSha256': self.program.digest, 'replayAllowed': False}).encode(),
   'stdout': self.stdout, 'stderr': self.stderr, 'oldCreator': self.old_source,
   'namespace': json.dumps(self.namespace, indent=2, sort_keys=True).encode(), 'plan': json.dumps(self.plan).encode(),
   'hostBinding': json.dumps(jobs.asdict(self.host)).encode(), 'unsubmitted': evidence('original-unsubmitted.proof.json'),
   'socket': evidence('socket-path-causal.json')}
  rows = {}
  for role, raw in content.items():
   relpath = production.evidence[role][0]
   private_write(self.root / relpath, raw)
   rows[role] = (relpath, sha(raw))
  scope = self.root / '.rag_index/windows-managed-creators' / READER.SCOPE
  journal = self.root / '.rag_index/readiness-resources' / OP
  self.expected = dataclasses.replace(
   production, vm_root=self.vm_root, uri=self.plan['binding']['uri'], host_binding=jobs.asdict(self.host), transport_machine='0' * 64,
   program_sha=self.program.digest, intent_generation=self.intent['generation'], owner=self.owner,
   prepared_sha=sha((journal / name('prepared')).read_bytes()), submitting_sha=sha((journal / name('submitting')).read_bytes()),
   reservation_id=self.identity['reservationId'], registry={leaf: sha((scope / leaf).read_bytes()) for leaf in production.registry},
   evidence=rows, sources={relpath: sha((REPO / relpath).read_bytes()) for relpath in production.sources})

 def boundaries(self):
  control = str(self.control)
  epoch = 'def _host_epoch():\n    import json\n    return json.load(open(%r))["epoch"]\n' % control
  rows = {'_host_epoch': epoch,
   '_manager_identity': 'def _manager_identity(socket_path, executable):\n    import json\n    return json.load(open(%r))["manager"]\n' % control,
   # The root census program always runs controlled: tests never hold root. Its
   # epoch may change on its first or last read; its identity may be another account.
   'root:_host_epoch': ('def _host_epoch():\n    import json\n    value = json.load(open(%r))\n    epoch = dict(value["epoch"])\n'
    '    if value.get("rootEpochFlip") == ("after-scan" if globals().get("CENSUS_RAN") else "before-scan"):\n'
    '        epoch["boot"] = "00000000-0000-4000-8000-000000000000"\n    return epoch\n') % control,
   'root:_root_identity': ('def _root_identity():\n    import json\n    value = json.load(open(%r)).get("rootIdentity")\n'
    '    return value if value is not None else {"euid": 0, "uid": 0, "sudoUid": %r}\n') % (control, self.host.account),
   'root:_actor_census': ('def _actor_census(paths, proc="/proc", privileged=False, denied=()):\n    import json\n'
    '    globals()["CENSUS_RAN"] = True\n    value = json.load(open(%r))["root"]\n'
    '    if value.get("reason"):\n        return {"reason": value["reason"], **({"detail": value["detail"]} if value.get("detail") else {})}\n'
    '    return {"reason": None, "references": value.get("references", 0), "denied": [], "zombies": [],\n'
    '            "covered": value.get("covered", [[pid, start, "examined"] for pid, start in denied]),\n'
    '            **({"detail": value["detail"]} if value.get("detail") else {})}\n') % control}
  if self.stub_actors or not sys.platform.startswith('linux'):
   # Path-aware: an int counts for every scan, a {path: count} map only for the scanned paths.
   rows['_actor_census'] = ('def _actor_census(paths, proc="/proc", privileged=False, denied=()):\n    import json\n'
    '    value = json.load(open(%r))\n    detail = {"detail": value["censusDetail"]} if value.get("censusDetail") else {}\n'
    '    if value["censusReason"]:\n        return {"reason": value["censusReason"], **detail}\n'
    '    count = value["references"] if type(value["references"]) is int else sum(value["references"].get(path, 0) for path in paths)\n'
    '    return {"reason": None, "references": count, "denied": value["denied"], "zombies": value["zombies"], **(detail if count else {})}\n') % control
   # The whole-before (stage-1) observer's boundary: any incomplete or denied scan is -1.
   rows['_actor_references'] = ('def _actor_references(paths):\n    import json\n    value = json.load(open(%r))\n'
    '    if value["censusReason"] or value["denied"] or value["zombies"]:\n        return -1\n'
    '    return value["references"] if type(value["references"]) is int else sum(value["references"].get(path, 0) for path in paths)\n') % control
  return rows

 def privileged(self):
  """Root census double: runs the generated root program (controlled boundaries), never sudo."""
  def run(root, source, deadline):
   self.privileged_sources.append(source)
   if json.loads(self.control.read_text())['privilegedUnavailable']:
    raise WRITER.Refused('privileged_census_unavailable')
   result = subprocess.run([sys.executable, '-I', '-B', '-'], input=source.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
   return {'returnCode': result.returncode, 'stdout': result.stdout, 'stderr': result.stderr}
  return run

 def runner(self, audit=None):
  def run(root, source, deadline):
   self.observations += 1
   hook = self.hooks.get(self.observations)
   if hook:
    hook()
   prefix = AUDIT % ((self.vm_root, 'credentials.sock', 'new-credentials', '.secret'), str(audit)) if audit else ''
   wrapper = prefix + 'import sys\nsys.path.insert(0, %r)\nexec(compile(%r, "prevm-observer", "exec"))\n' % (str(self.fake), source)
   result = subprocess.run([sys.executable, '-I', '-B', '-'], input=wrapper.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
   return {'returnCode': result.returncode, 'stdout': result.stdout, 'stderr': result.stderr}
  return run

 def call(self, function, inputs, audit=None, expected=None, clock=None):
  # The whole-before (stage-1) writer has no privileged seam; it gets the same call otherwise.
  privileged = {'privileged': self.privileged()} if 'privileged' in inspect.signature(function).parameters else {}
  return WRITER._finite(function, self.root, inputs, expected=expected or self.expected, runner=self.runner(audit), boundaries=self.boundaries(),
   **privileged, **({} if clock is None else {'clock': clock}))

 def proof(self, **kwargs):
  return self.call(WRITER._proof, {'host': 'archlinux', 'timeoutSeconds': 120}, **kwargs)

 def history(self):
  return self.call(WRITER._history, {'host': 'archlinux', 'timeoutSeconds': 120})

 def close(self, proof, resume=None, timeout=300, **kwargs):
  inputs = {'host': 'archlinux', 'timeoutSeconds': timeout, 'expectedProofSha256': proof}
  if resume:
   inputs['resumeAuthorizationSha256'] = resume
  return self.call(WRITER._close, inputs, **kwargs)

 def close_available(self):
  """The repository's own closure source; before the remedy only the generic route."""
  if WRITER is None:
   return {'state': self.generic_release()['state'], 'reason': None}
  proven = self.proof()
  return self.close(proven.get('proofSha256') or '0' * 64)

 def close_or_generic(self, proof):
  """Remedy: source-owned close. Before it: the generic caller-built route."""
  if WRITER is not None:
   return self.close(proof)
  return {'state': self.generic_release()['state'], 'reason': None}

 def authorize_then_refuse(self):
  """Record the authorization, then refuse at the guard before bookkeeping: A + untouched U0 row."""
  proof = self.proof()['proofSha256']
  self.hooks = {self.observations + 2: lambda: self.write_control(manager=MANAGER2)}
  first = self.close(proof)
  self.hooks = {}
  authorization = sha(self.record(AUTH))
  self.case.assertEqual((first['state'], first['reason'], first['authorizationSha256'], first['nextAction']),
   ('refused', 'manager_changed', authorization, WRITER.Refused.action), first)
  self.case.assertEqual(self.own_row()['activeJob'], 'unknown')
  return proof, authorization

 def assertUnpublished(self):
  """No link, attempt root or resolvable next attempt before a durable release."""
  self.case.assertIsNone(self.record(LINK))
  self.case.assertFalse(os.path.lexists(READER.attempts_parent(self.root)))
  with self.case.assertRaises(READER.AttemptUnresolved):
   READER.current(self.root)

 def typed_history(self):
  """The typed original-7e8 terminal result through the repository's own history surface."""
  if WRITER is not None:
   return self.history().get('terminal', {}).get('typed')
  scope = {}
  exec(compile(self.handle.definitions(), 'retained original observer', 'exec'), scope)
  row = next(row for row in scope['_creator_host_work']()['jobs'] if row['operationId'] == OP)
  return row['status'].get('typed')

 @contextlib.contextmanager
 def namespace_holder(self):
  """A live same-account actor holding the shared namespace marker, not the original job."""
  if sys.platform.startswith('linux') and not self.stub_actors:
   child = subprocess.Popen([sys.executable, '-c', 'import os,sys,time;fd=os.open(sys.argv[1],os.O_RDONLY);time.sleep(60)',
    str(self.ns_root / 'creator-namespace.json')])
   self.children.append(child)
   try:
    time.sleep(.3)
    yield
   finally:
    child.kill()
    child.wait()
  else:
   self.write_control(references={str(self.ns_root): 1})
   try:
    yield
   finally:
    self.write_control(references=0)

 def attempt_actors(self):
  """Live attempt-2 actors: one holds the namespace marker, one names the VM root in its argv."""
  if sys.platform.startswith('linux') and not self.stub_actors:
   for code, argument in (('import os,sys,time;fd=os.open(sys.argv[1],os.O_RDONLY);time.sleep(60)', str(self.ns_root / 'creator-namespace.json')),
     ('import sys,time;time.sleep(60)', self.vm_root)):
    self.children.append(subprocess.Popen([sys.executable, '-c', code, argument]))
   time.sleep(.3)
  else:
   self.write_control(references={str(self.ns_root): 1, self.vm_root: 1})

 def attempt_records(self):
  """What the linked attempt legitimately leaves for the same VM: dispatch, credentials, intent, VM row."""
  target = sha(json.dumps(['archlinux', MACHINE], separators=(',', ':')).encode())
  private_write(self.root / '.rag_index/readiness-targets' / target / ('dispatch-' + 'd' * 64 + '-1.json'),
   canonical({'version': 2, 'machine': MACHINE, 'action': 'start'}).encode())
  os.makedirs(self.root / '.runtime/windows-vm-credentials' / MACHINE, 0o700)
  private_write(self.root / '.rag_index/windows-vm-deploy-intents' / (MACHINE + '.intent.json'), b'{}')
  self.vm_row()

 def regenerated_status(self):
  """Pre-remedy read path: regenerate the creator Program, run its fixed status."""
  with mock.patch.object(media, 'dependency_sources', return_value=MEDIA):
   program = CURRENT.creator_program(self.plan, self.admission, self.namespace, self.host)
  result = subprocess.run([sys.executable, '-I', '-B', '-'], input=CURRENT.status_program(program), stdout=subprocess.PIPE,
   stderr=subprocess.PIPE, timeout=60)
  return program, json.loads(result.stdout)

 def rows(self):
  return json.loads((self.root / '.rag_index/native-environments/reservations.json').read_bytes())['reservations']

 def own_row(self):
  return next(row for row in self.rows() if row['id'] == self.identity['reservationId'])

 def own_present(self):
  return any(row['id'] == self.identity['reservationId'] for row in self.rows())

 def foreign_rows(self):
  return [row for row in self.rows() if row['id'] != self.identity['reservationId']]

 def set_own_evidence(self, outcome):
  with environments._LockedState(self.root) as locked:
   row = next(r for r in locked.state['reservations'] if r['id'] == self.identity['reservationId'])
   row['activeJobEvidence'] = {**row['activeJobEvidence'], 'outcome': outcome, 'observedAtUnixMs': time.time_ns() // 1_000_000}
   row['activeJob'] = 'absent' if outcome == 'complete' else 'active'
   locked.save()

 def mapping(self):
  return [{'reservationId': r['id'], 'memoryBytes': r['requestedMemoryBytes']} for r in self.rows() if r['allocationState'] == 'running']

 def foreign_claim(self):
  """An unrelated pending claim through the real reserve, never the spied one."""
  REAL_RESERVE(self.root, {'hostAlias': 'archlinux', 'environment': 'recovery-' + str(uuid4()), 'operator': 'readiness-resources',
   'requestedMemoryBytes': GIB, 'headroomBytes': 8 * GIB, 'measurement': MEASUREMENT, 'runningAllocationMapping': self.mapping()})

 def vm_row(self):
  REAL_RESERVE(self.root, {'hostAlias': 'archlinux', 'environment': 'windows-' + MACHINE, 'operator': 'windows-vm-deploy',
   'requestedMemoryBytes': 2 * GIB, 'headroomBytes': 8 * GIB, 'measurement': MEASUREMENT, 'runningAllocationMapping': self.mapping()})

 def remint(self):
  """The proof-free generic route re-mints the prepared request in the original environment."""
  prepared = json.loads(self.record('prepared'))
  return REAL_RESERVE(self.root, {**prepared['request'], 'expectedInventorySha256': resources._inventory(self.root)[1]})

 def journal(self):
  directory = self.root / '.rag_index/readiness-resources' / OP
  return {leaf: (directory / leaf).read_bytes() for leaf in sorted(os.listdir(directory))}

 def journal_path(self, key):
  return self.root / '.rag_index/readiness-resources' / OP / name(key)

 def record(self, key):
  path = self.journal_path(key)
  return path.read_bytes() if path.exists() else None

 def evidence_path(self, role):
  return self.root / self.expected.evidence[role][0]

 def touch_evidence(self, role):
  path = self.evidence_path(role)
  path.write_bytes(path.read_bytes() + b' ')

 def snapshot(self):
  files = {}
  for top in (self.root, self.home):
   for path in sorted(top.rglob('*')):
    relative = path.relative_to(self.base)
    if 'windows-managed-creator-prevm' in relative.parts:
     continue
    files[str(relative)] = (('link', os.readlink(path)) if path.is_symlink() else 'socket' if path.is_socket()
     else sha(path.read_bytes()) if path.is_file() else 'directory')
  return files

 def generic_release(self):
  """Pre-remedy generic route surface: caller-built request, no facts at all."""
  rows, digest = resources._inventory(self.root)
  prepared = json.loads(self.record('prepared'))
  environments.reserve_environment(self.root, {**prepared['request'], 'expectedInventorySha256': digest,
   'observations': [resources._receipt(self.identity, 'complete')]})
  return environments.release_environment(self.root, self.identity)

 @contextlib.contextmanager
 def spies(self):
  calls = {'reserve': [], 'release': [], 'secret': [], 'unsubmitted': []}
  reserve, release = environments.reserve_environment, environments.release_environment
  def spy_reserve(root, request):
   result = reserve(root, request)
   calls['reserve'].append((request, result))
   return result
  def spy_release(root, identity):
   result = release(root, identity)
   calls['release'].append((identity, result))
   return result
  class Secret:
   def __init__(self, *args, **kwargs):
    calls['secret'].append(args)
    raise AssertionError('secret file opened')
  with mock.patch.object(environments, 'reserve_environment', side_effect=spy_reserve), \
  mock.patch.object(environments, 'release_environment', side_effect=spy_release), \
  mock.patch.object(resources, 'SecretFile', Secret), \
  mock.patch.object(resources.ResourceAdmission, 'reconcile_unsubmitted', side_effect=lambda *a, **k: calls['unsubmitted'].append(a)):
   yield calls


def shifted(seconds):
 real = time.time_ns
 fake = SimpleNamespace(time_ns=lambda: real() + int(seconds * 1e9), monotonic=time.monotonic, sleep=time.sleep, time=time.time)
 stack = contextlib.ExitStack()
 for module in (environments, resources) + ((WRITER,) if WRITER else ()):
  stack.enter_context(mock.patch.object(module, 'time', fake))
 return stack


