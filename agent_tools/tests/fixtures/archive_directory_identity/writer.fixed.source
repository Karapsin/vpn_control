 need(generation(os.fstat(afd))==ag==generation(IMAGE.lstat())and generation(os.fstat(rawfd))==rg==generation(ORIGINAL.lstat()),'archive_verify_generation');os.close(afd);os.close(rawfd);os.fsync(output_parent)
