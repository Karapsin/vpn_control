"""One normal owned guest ordinary login. No private input is accepted in argv/source."""
from pathlib import Path
import os,runpy,hashlib,resource,fcntl,io,time
from PIL import Image,ImageDraw
from agent_tools.readiness_tart_vnc import ProtectedVncSession,SecretInputJournal
DIRECTORY=Path(__file__).resolve().parent
ROOT=DIRECTORY.parent
OPERATION='4cdfbaee-d2aa-42f4-865e-1479d9a266bd'
PASSWORD_OPERATION='b8e06fac-bd1a-44cb-a827-413d521a0861'
SUBMIT_OPERATION='90c6fae0-2dfc-4904-8ba1-8c0d95364290'
BASELINE=ROOT/'public-recognized-Tool-Recovery-empty-password-1792516563105774000.png'
ACCOUNT_PHASE=ROOT/'protected-standard-account-8b3966a1-2379-4a59-b99a-9f061a7e8d9c/protected-standard-account-phase.inert.py'
CREDENTIAL=ACCOUNT_PHASE.parent/'ordinary-pass.bin'
def guard():
 if hashlib.sha256(ACCOUNT_PHASE.read_bytes()).hexdigest()!='711306cb50dc7024084128f95937a46953ea7b0b88688603bdfc77efe5a0720c':raise RuntimeError('ordinary_credential_admission_source_changed')
 h=runpy.run_path(str(ACCOUNT_PHASE))['source_guard']()
 c=CREDENTIAL.lstat()
 if(c.st_dev,c.st_ino,c.st_uid,c.st_mode&0o777,c.st_nlink)!=(16777231,267824886,503,0o600,1):raise RuntimeError('ordinary_credential_handle_changed')
 return h
def login_once():
 resource.setrlimit(resource.RLIMIT_CORE,(0,0));h=guard()
 lock=os.open(DIRECTORY/'phase.lock',os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
 try:
  fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
  h['record'](DIRECTORY/'phase-unknown.json',{'operationId':OPERATION,'originalRun':'2d933a39-0fb6-46a4-9fd9-02221d81c4b9','account':'toolrecovery','state':'unknown_no_replay'})
  baseline=Image.open(BASELINE).convert('RGB');box=(425,410,605,451);expected=baseline.crop(box).tobytes()
  fd=os.open(ROOT/'vnc-auth.bin',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
  try:
   with ProtectedVncSession(port=53086,credential_fd=fd,guard=guard,timeout=20)as view:
    def recipient():
     guard();im=Image.open(io.BytesIO(view.capture_png())).convert('RGB')
     if im.size!=(1024,768)or im.crop(box).tobytes()!=expected:raise RuntimeError('ordinary_login_recipient_changed')
     im=None
    recipient()
    image=Image.open(io.BytesIO(view.capture_png())).convert('RGB')
    if image.crop((440,461,580,483)).tobytes()!=baseline.crop((440,461,580,483)).tobytes():raise RuntimeError('ordinary_login_field_not_known_empty')
    image=None
    journal_dir=DIRECTORY/'secret-inputs';journal_dir.mkdir(mode=0o700)
    journal=SecretInputJournal(journal_dir,OPERATION)
    secret=os.open(CREDENTIAL,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    try:view.type_secret_from_fd(secret,operation_id=PASSWORD_OPERATION,journal=journal,guard=recipient)
    finally:os.close(secret)
    h['record'](DIRECTORY/'password-transport-complete.json',{'operationId':PASSWORD_OPERATION,'state':'transport_complete_not_login_receipt'})
    recipient()
    h['record'](DIRECTORY/'submit-unknown.json',{'operationId':SUBMIT_OPERATION,'action':'one_normal_ordinary_login_Return','state':'unknown'})
    view.key('Return')
    h['record'](DIRECTORY/'submit-transport-complete.json',{'operationId':SUBMIT_OPERATION,'state':'submitted_awaiting_independent_session'})
  finally:os.close(fd)
 finally:os.close(lock)
def masked_observe():
 resource.setrlimit(resource.RLIMIT_CORE,(0,0));h=guard();fd=os.open(ROOT/'vnc-auth.bin',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
 try:
  with ProtectedVncSession(port=53086,credential_fd=fd,guard=guard,timeout=20)as view:
   im=Image.open(io.BytesIO(view.capture_png())).convert('RGB');ImageDraw.Draw(im).rectangle((420,452,620,495),fill=(96,96,96))
   path=DIRECTORY/('masked-login-observer-'+str(time.time_ns())+'.png');out=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
   with os.fdopen(out,'wb')as f:im.save(f,format='PNG')
   return str(path)
 finally:os.close(fd)
