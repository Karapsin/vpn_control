"""Finite Windows QMP/libvirt packets; source never contains protected inputs."""
import ast
import inspect
import json
import re
from uuid import UUID

from . import windows_vm_instance as instance
from . import windows_vm_deploy_remote as deployment
from . import readiness_windows_guest as guest
from .native_vm_spec import FreshWindowsVmSpec
from .windows_vm_unattend import parse_setup


def _main():
    _CANONICAL_INSTANCE_DEFINITIONS()
    import base64,fcntl
    from xml.etree import ElementTree as ET
    global wire,partial_wire,QGA_PEER_PID,QGA_GUARD
    lock=None;connection=None;domain=None
    def epoch():
        require(pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()==CONTEXT['hostBootId'],'instance_host_epoch')
        instance_intent();closing()
    def actor():
        if PROVIDER=='raw-qemu-windows':
            row=read('qemu-started.json')
            try:process(row)
            except FileNotFoundError:return None
            except ValueError as error:
                if str(error)=='instance_process_dead':return None
                raise
            process(read('swtpm-started.json'));return row
        candidates=[]
        for path in pathlib.Path('/proc').iterdir():
            if not path.name.isdigit():continue
            try:
                if path.stat().st_uid!=os.geteuid():continue
                raw=(path/'cmdline').read_bytes();words=raw.split(b'\0')
                if b'-uuid' not in words:continue
                index=words.index(b'-uuid')
                if index+1>=len(words) or words[index+1].decode('ascii','ignore')!=SPEC['deploymentId']:continue
                pid=int(path.name);start=birth(pid)
                row={'pid':pid,'startTicks':start,'argv':[os.fsdecode(v) for v in words if v],
                     'commandSha256':hashlib.sha256(raw).hexdigest(),'executableGeneration':list(generation(os.stat(path/'exe')))}
                process(row);candidates.append(row)
            except FileNotFoundError:continue
        require(len(candidates)==1,'instance_libvirt_actor_unknown');row=candidates[0]
        owns(row['pid'],root/'disk.qcow2');owns(row['pid'],root/'uefi-vars.fd');return row
    def vm_guard():
        epoch()
        if PROVIDER=='libvirt-windows':
            require(connection.getURI()==URI and domain.UUIDString()==SPEC['deploymentId'] and domain.name()==DOMAIN,'instance_libvirt_identity')
            xml=domain.XMLDesc(libvirt.VIR_DOMAIN_XML_INACTIVE).encode()
            require(hashlib.sha256(xml).hexdigest()==XML_SHA,'instance_libvirt_xml_changed')
            tree=ET.fromstring(xml);sources=tree.findall("devices/disk[@device='disk']/source")
            require(len(sources)==1 and sources[0].get('file')==str(root/'disk.qcow2') and tree.findtext('os/nvram')==str(root/'uefi-vars.fd'),'instance_libvirt_artifacts')
        if current_actor is not None:
            process(current_actor)
            if PROVIDER=='raw-qemu-windows':owns(current_actor['pid'],root/'qmp.sock',True)
    def machine_state():
        vm_guard()
        if PROVIDER=='raw-qemu-windows':
            if current_actor is None:return 'stopped'
            require(qmp('query-uuid')['UUID'].lower()==SPEC['deploymentId'],'instance_machine')
            return qmp('query-status')['status']
        value=domain.state()[0]
        return {1:'running',2:'booting',3:'paused',4:'shutdown',5:'stopped',6:'unhealthy',7:'suspended'}.get(value,'unknown')
    def rpc(command,arguments):
        vm_guard()
        if PROVIDER=='raw-qemu-windows':
            global QGA_PEER_PID,QGA_GUARD
            QGA_PEER_PID=current_actor['pid'];owns(QGA_PEER_PID,root/'qga.sock',True);named=os.lstat(root/'qga.sock')
            def guarded():
                vm_guard();require(os.lstat(root/'qga.sock').st_ino==named.st_ino,'instance_qga_changed')
            QGA_GUARD=guarded
            value=call(str(root/'qga.sock'),command,arguments,_deadline=time.monotonic()+8)
        else:
            request=json.dumps({'execute':command,'arguments':arguments},separators=(',',':'))
            require(len(request.encode())<=262144,'instance_guest_request_bound')
            raw=libvirt_qemu.qemuAgentCommand(domain,request,8,0)
            require(type(raw)is str and 0<len(raw.encode())<=262144,'instance_guest_reply_bound')
            answer=json.loads(raw);require(type(answer)is dict and 'return'in answer and 'error'not in answer,'instance_guest_reply')
            value=answer['return']
        vm_guard();return value
    def script(label,source):
        prefix='readiness-'+OPERATION+'-'+label
        intent_name=prefix+'.intent.json';ack_name=prefix+'.ack.json';terminal_name=prefix+'.terminal.json'
        if not os.path.lexists(root/intent_name):
            save(intent_name,{'operationId':OPERATION,'label':label,'sourceSha256':hashlib.sha256(source.encode()).hexdigest(),
                              'hostBoot':CONTEXT['hostBootId'],'actor':current_actor,'replayAllowed':False})
            vm_guard()
            ack=rpc('guest-exec',{'path':'powershell.exe','arg':['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-Command',"$s=[Console]::In.ReadToEnd(); & ([ScriptBlock]::Create($s))"],
                                  'input-data':base64.b64encode(source.encode()).decode(),'capture-output':True})
            require(type(ack)is dict and set(ack)=={'pid'} and type(ack['pid'])is int and ack['pid']>0,'instance_guest_exec_ack')
            save(ack_name,{'operationId':OPERATION,'label':label,'ack':ack,'replayAllowed':False})
        intent=read(intent_name)
        require(intent['operationId']==OPERATION and intent['label']==label and intent['sourceSha256']==hashlib.sha256(source.encode()).hexdigest()
                and intent['hostBoot']==CONTEXT['hostBootId'] and intent['actor']==current_actor,'instance_original_guest_request')
        # Lost admission acknowledgement is never permission to guest-exec again.
        require(os.path.lexists(root/ack_name),'instance_original_guest_ack_unknown')
        ack=read(ack_name);require(ack['operationId']==OPERATION and ack['label']==label and ack['replayAllowed']is False,'instance_guest_exec_ack')
        if os.path.lexists(root/terminal_name):terminal=read(terminal_name)
        else:
            deadline=time.monotonic()+20
            while True:
                terminal=rpc('guest-exec-status',ack['ack'])
                if terminal.get('exited')is True:break
                require(time.monotonic()<deadline,'instance_original_guest_pending');time.sleep(.2)
            save(terminal_name,terminal)
        require(terminal.get('exited')is True and terminal.get('exitcode')==0 and not terminal.get('out-truncated',False)
                and not terminal.get('err-truncated',False),'instance_guest_program_failed')
        out=base64.b64decode(terminal.get('out-data',''),validate=True);err=base64.b64decode(terminal.get('err-data',''),validate=True)
        require(not err and 0<len(out)<=65536,'instance_guest_output_bound');value=json.loads(out.decode('utf-8-sig'))
        require(type(value)is dict,'instance_guest_output');vm_guard();return value
    try:
        epoch();chain()
        lock=os.open(root/'intent.json',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);limit=time.monotonic()+5
        while True:
            try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);break
            except BlockingIOError:require(time.monotonic()<limit,'instance_operator_busy');time.sleep(.05)
        if PROVIDER=='libvirt-windows':
            import libvirt,libvirt_qemu
            libvirt.registerErrorHandler(lambda *_:None,None)
            connection=libvirt.open(URI);require(connection is not None,'instance_libvirt_connection')
            domain=connection.lookupByUUIDString(SPEC['deploymentId']);current_actor=actor() if domain.isActive() else None
        else:current_actor=actor()
        if PROVIDER=='raw-qemu-windows':
            suffix='readiness-'+OPERATION+'-'+MODE+'-'+os.urandom(8).hex()
            wire=os.open(root/(suffix+'.wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
            partial_wire=os.open(root/(suffix+'.partial-wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
        state=machine_state()
        result={'state':'observed','operationId':OPERATION,'provider':PROVIDER,'machine':SPEC['deploymentId'],
                'hostBoot':CONTEXT['hostBootId'],'guest':state,'actor':current_actor,'sessionFacts':None,'displayFacts':None,'guestAgent':False}
        if MODE=='resume':
            require(state in {'paused','suspended'},'instance_recovery_state_changed')
            require(EXPECTED.get('actor')==current_actor and EXPECTED.get('hostBoot')==CONTEXT['hostBootId'],'instance_recovery_identity_changed')
            vm_guard();save('readiness-recovery-'+RECOVERY_ID+'.intent.json',{'action':'resume','recoveryId':RECOVERY_ID,'operationId':OPERATION,'before':result,'replayAllowed':False})
            if PROVIDER=='raw-qemu-windows':qmp('cont')
            else:domain.resume()
            vm_guard();result['guest']=machine_state();result['state']='submitted'
        elif MODE=='observe':
            if state=='running':
                try:rpc('guest-ping',{});result['guestAgent']=True
                except Exception:result['guest']='booting'
                if result['guestAgent']:
                    result['sessionFacts']=script('session',SESSION_SCRIPT)
                    if DISPLAY_SCRIPT:result['displayFacts']=script('display',DISPLAY_SCRIPT)
        elif MODE in {'lease-acquire','lease-status','lease-cancel','lease-enroll'}:
            require(state=='running','instance_guest_not_ready');rpc('guest-ping',{})
            result['lease']=script(MODE,LEASE_SCRIPT)
        else:raise ValueError('instance_packet_action')
        vm_guard();print(json.dumps(result))
    except BaseException as error:
        reason=str(error) if type(error)is ValueError and re.fullmatch('instance_[a-z_]{1,64}',str(error)) else 'instance_observation_unknown'
        print(json.dumps({'state':'blocked','operationId':OPERATION,'reason':reason,'errorClass':type(error).__name__,'replayAllowed':False}))
    finally:
        if connection is not None:connection.close()
        if lock is not None:os.close(lock)
        for descriptor in (globals().get('wire',-1),globals().get('partial_wire',-1)):
            if descriptor!=-1:os.close(descriptor)
        for descriptor in reversed(held):os.close(descriptor)


def program(binding,mode,operation,*,expected=None,recovery_id=None,interactive=False,lease_binding=None,ttl_seconds=None):
    """Build only reviewed actions; no caller command/source or credential input."""
    if type(binding)is not dict or set(binding)!={'provider','spec','setup','context','uri','domain','xmlSha256'}:
        raise ValueError('windows_packet_binding')
    provider=binding['provider'];spec=FreshWindowsVmSpec.parse(binding['spec']);setup=parse_setup(binding['setup']);context=binding['context']
    if provider not in {'raw-qemu-windows','libvirt-windows'} or mode not in {'observe','resume','lease-acquire','lease-status','lease-cancel','lease-enroll'}:
        raise ValueError('windows_packet_action')
    if type(operation)is not str or str(UUID(operation))!=operation or type(interactive)is not bool:
        raise ValueError('windows_packet_identity')
    if type(context)is not dict or set(context)!={'hostBootId','pending'} or str(UUID(context['hostBootId']))!=context['hostBootId']:
        raise ValueError('windows_packet_context')
    if provider=='libvirt-windows':
        if binding['uri']!='qemu:///session' or binding['domain']!='vc-recovery-libvirt-'+spec.deployment_id[:8] or type(binding['xmlSha256'])is not str or re.fullmatch('[0-9a-f]{64}',binding['xmlSha256'])is None:
            raise ValueError('windows_packet_domain')
    elif any(binding[k]is not None for k in ('uri','domain','xmlSha256')):
        raise ValueError('windows_packet_domain')
    if mode=='resume' and (type(expected)is not dict or type(recovery_id)is not str or re.fullmatch('[0-9a-f]{64}',recovery_id)is None):
        raise ValueError('windows_packet_recovery')
    display='';lease=''
    if interactive:
        from . import readiness_windows_display as display_module
        if type(expected)is not dict or type(expected.get('boot'))is not str:raise ValueError('windows_display_binding')
        display=display_module.powershell_source(spec.deployment_id,expected['boot'])
    if mode.startswith('lease-'):
        from . import readiness_windows_leases as leases
        if type(lease_binding)is not leases.WindowsLeaseBinding or lease_binding.machine!=spec.deployment_id:
            raise ValueError('windows_lease_binding')
        lease=(leases.enrollment_source(lease_binding.machine,lease_binding.boot) if mode=='lease-enroll' else
               leases.program(mode.removeprefix('lease-').replace('acquire','acquire'),lease_binding,operation,
                              **({'ttl_seconds':ttl_seconds}if mode=='lease-acquire' else {})))
        lease=lease.decode()
    source=inspect.getsource(instance._vm_main);node=next(n for n in ast.parse(source).body if isinstance(n,ast.FunctionDef))
    nodes=[n for n in node.body if isinstance(n,(ast.Import,ast.ImportFrom,ast.Assign,ast.FunctionDef)) and not(isinstance(n,ast.FunctionDef) and n.name=='launch')]
    canonical='\n'.join(ast.get_source_segment(source,n)for n in nodes)
    text=inspect.getsource(_main);marker='    _CANONICAL_INSTANCE_DEFINITIONS()\n'
    if text.count(marker)!=1:raise ValueError('windows_packet_source')
    text=text.replace(marker,''.join('    '+line+'\n'for line in canonical.splitlines()))
    bindings={'SPEC':spec.as_dict(),'SETUP':setup,'CONTEXT':context,'PROVIDER':provider,'URI':binding['uri'],'DOMAIN':binding['domain'],'XML_SHA':binding['xmlSha256'],
              'OPERATION':operation,'MODE':mode,'EXPECTED':expected,'RECOVERY_ID':recovery_id,'SESSION_SCRIPT':guest.powershell_source(setup['user']),
              'DISPLAY_SCRIPT':display,'LEASE_SCRIPT':lease}
    packet='\n'.join(key+'='+repr(value)for key,value in bindings.items())+'\n'+deployment.guest_rpc_definitions()+'\nwire=partial_wire=-1\n'+text+'\n_main()\n'
    compile(packet,'finite Windows readiness packet','exec');return packet.encode()
