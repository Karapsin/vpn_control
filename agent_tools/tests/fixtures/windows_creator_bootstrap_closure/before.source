def creator_program(value,resource_admission,namespace,host_binding):
    """Internal fixed Program; resources must already be consumed for this op."""
    value=_plan(value);namespace=_namespace_reply(value,host_binding,namespace);job_root=namespace['root'];root_generation=namespace['generation']
    binding=value['binding'];spec=binding['spec'];operation=value['operationId']
    _need(type(resource_admission)is resources.ResourceAdmission and resource_admission.operation_id==operation
        and resource_admission.machine_uuid==spec['deploymentId']and resource_admission.target.deployment_id==operation
        and resource_admission.target.host==spec['host']and resource_admission.target.root==spec['root'])
    snapshot=resource_admission.submission_snapshot();_need(snapshot['hostBootId']==binding['context']['hostBootId'])
    _need(lifecycle._canonical(job_root)and lifecycle._pin(root_generation,2)and type(host_binding)is jobs.MachineBinding
        and UUID(host_binding.boot)==UUID(binding['context']['hostBootId'])and host_binding.account.isdecimal()and int(host_binding.account)>0
        and not (job_root==spec['root']or job_root.startswith(spec['root']+'/')))
    legacy=inspect.getsource(instance._vm_main);node=ast.parse(legacy).body[0]
    names={'require','generation','structure','chain','closing','pin','private','save','birth'}
    canonical='\n'.join(ast.get_source_segment(legacy,row)for row in node.body if isinstance(row,(ast.Import,ast.ImportFrom,ast.Assign))or isinstance(row,ast.FunctionDef)and row.name in names)
    source=inspect.getsource(_creator_main);marker='    _CANONICAL_CREATE_DEFINITIONS()\n';_need(source.count(marker)==1)
    source=source.replace(marker,''.join('    '+line+'\n'for line in canonical.splitlines()))
    constants={'SPEC':spec,'SETUP':binding['setup'],'CONTEXT':binding['context'],'PLAN':value,'CREATOR_ADMISSION':snapshot,'CREATOR_JOB_ROOT':job_root,'CREATOR_ROOT_GENERATION':root_generation,
        'CREATOR_NAMESPACE':namespace,'CREATOR_HOST_BINDING':jobs.asdict(host_binding),'CREATOR_OWNER_SOURCE':jobs.owner_source(),'URI_SOCKET':str(PurePosixPath(spec['root']).parent/'.cache/libvirt/virtqemud-sock'),
        'CREATOR_INITIALIZE':initialization_source(),'CREATOR_INSTALL_AGENT':unattended.INSTALL_AGENT}
    storage=Path(__file__).parent.parent/'scripts/native_fixture_storage.py'
    prefix="_CREATOR_EXECUTING_CODE=__import__('inspect').currentframe().f_code\nimport types,sys\n"
    prefix+='\n'.join(name+'='+repr(item)for name,item in constants.items())+'\n'
    prefix+="CREATOR_STORAGE=types.ModuleType('fixed_creator_storage');sys.modules[CREATOR_STORAGE.__name__]=CREATOR_STORAGE\nexec(compile("+repr(storage.read_bytes())+",'fixed-creator-storage','exec'),CREATOR_STORAGE.__dict__)\n"
    prefix+='MEDIA_READER='+repr(media.dependency_capsule(media.dependency_sources()))+'\n'+inspect.getsource(media.read_wim_images)+'\n'+inspect.getsource(media.installer_images)+'\n'+inspect.getsource(media.select_image)+'\n'
    prefix+='FIELDS=set('+repr(sorted(unattended.FIELDS))+')\n'
    prefix+='import re\nfrom xml.etree import ElementTree as ET\n'+inspect.getsource(unattended.parse_setup)+'\n'+inspect.getsource(unattended.answer_file).replace('def answer_file(','def _legacy_answer(')+'\n'
    prefix+=inspect.getsource(private_answer)+'\n'+inspect.getsource(credential_frame)+'\n'+inspect.getsource(_channel_identity)+'\n'+inspect.getsource(_receive_credentials)+'\n'
    prefix+=inspect.getsource(lifecycle._start_capacity)+'\n'+inspect.getsource(lifecycle._storage_vm_coverage)+'\n'+inspect.getsource(resource_facts.measurement).replace('def measurement(','def _lifecycle_measurement(')+'\n'
    result=jobs.Program('windows-managed-first-create',(prefix+source+'\n_creator_main()\n').encode(),262144)
    expected={'operationId':operation,'binding':jobs.asdict(host_binding),'rootGeneration':list(root_generation),'programSha256':result.digest}
    _CREATE_PROGRAMS[result]=(weakref.ref(result),job_root+'/'+operation,expected)
    _CREATE_NAMESPACES[result]=namespace;_CREATE_PLANS[result]=value
    return result
