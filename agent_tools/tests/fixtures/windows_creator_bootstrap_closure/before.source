"""Unexposed managed-first Windows creator for an explicit new owned fixture.

Source-only qualification stage. This module grants no provider capability. Its
credential channel is separate from retained Program source and all receipts;
secret seed media is held by metadata and exact bytes, never by content hashes.
A manager ACK is pending evidence, never guest readiness or signin authority.
"""
import ast
import hashlib
import inspect
import json
from pathlib import Path,PurePosixPath
import re
import weakref
from uuid import UUID,uuid5
from xml.etree import ElementTree as ET

