            row={'pid':pid,'birth':birth(pid),'executableGeneration':list(generation(os.fstat(binaries['virtqemud']))),'socketIdentity':list(structure(named))}
            require(structure(os.lstat(socket_path))==structure(named),'windows_managed_manager_changed');return row
