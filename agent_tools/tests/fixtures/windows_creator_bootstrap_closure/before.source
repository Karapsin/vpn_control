        def epoch():
            require(pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()==context['hostBootId'],'windows_managed_host_changed');closing()
        epoch();require(not os.path.lexists(root),'windows_managed_blank_root_required')
        phase='public-assets';assets={};binaries={}
