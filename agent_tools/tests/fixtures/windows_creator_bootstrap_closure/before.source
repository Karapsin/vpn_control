from . import windows_vm_instance as instance
from . import windows_vm_media as media
from . import windows_vm_resources as resource_facts
from . import windows_vm_unattend as unattended

_EXECUTING_CODE=inspect.currentframe().f_code
_CREATE_PROGRAMS=weakref.WeakKeyDictionary()
_CREATE_NAMESPACES=weakref.WeakKeyDictionary()
_CREATE_PLANS=weakref.WeakKeyDictionary()
QUALIFIED_RECOVERIES=frozenset()


def _need(value):
    if not value:raise ValueError('windows_managed_create_unresolved')


def credential_frame(raw):
    """Private input validator; errors contain no input or derived material."""
    import json,re
    def pairs(rows):
        result={}
        for key,value in rows:
            if key in result:raise ValueError()
            result[key]=value
        return result
    try:
        if type(raw)is not bytes or not 0<len(raw)<=4096:raise ValueError()
        value=json.loads(raw.decode('ascii'),object_pairs_hook=pairs)
        if type(value)is not dict or set(value)!={'user','administrator'}:raise ValueError()
        if any(type(secret)is not str or re.fullmatch('[A-Za-z0-9!_-]{24,64}',secret)is None for secret in value.values()):raise ValueError()
        return value
    except BaseException:raise ValueError('windows_managed_private_input_invalid')from None


def private_answer(setup,credentials):
    """No automatic signin; return only to the private seed writer."""
    from xml.etree import ElementTree as ET
    raw=_legacy_answer(setup,credentials);root=ET.fromstring(raw)
    ns={'u':'urn:schemas-microsoft-com:unattend'}
    for component in root.findall('.//u:component',ns):
        for node in list(component):
            if node.tag=='{'+ns['u']+'}AutoLogon':component.remove(node)
    if root.findall('.//u:AutoLogon',ns):raise ValueError('windows_managed_private_seed_invalid')
    return ET.tostring(root,encoding='utf-8',xml_declaration=True)


_legacy_answer=unattended.answer_file


def initialization_source():
    marker='Stop-Transcript\n';raw=unattended.INITIALIZE
    _need(raw.count(marker)==1)
    return raw.replace(marker,"Start-ScheduledTask -TaskName 'VpnControlFixtureInitialize'\n"+marker)


def domain_xml(spec,domain):
    """Only public path/VM metadata; no credential or graphics password."""
    from xml.etree import ElementTree as E
    def node(parent,tag,text=None,**attrs):
        value=E.SubElement(parent,tag,{key:str(item)for key,item in attrs.items()})
        if text is not None:value.text=str(text)
        return value
    root=E.Element('domain',type='kvm');node(root,'name',domain);node(root,'uuid',spec['deploymentId'])
    node(root,'memory',spec['memoryMiB']*1024,unit='KiB');node(root,'currentMemory',spec['memoryMiB']*1024,unit='KiB');node(root,'vcpu',spec['cpus'])
    osnode=node(root,'os',firmware='efi');node(osnode,'type','hvm',arch='x86_64',machine='q35')
    node(osnode,'loader',spec['assets']['firmwareCode']['path'],readonly='yes',secure='yes',type='pflash')
    node(osnode,'nvram',spec['root']+'/uefi-vars.fd');node(osnode,'boot',dev='cdrom');node(osnode,'boot',dev='hd')
    features=node(root,'features');node(features,'acpi');node(features,'apic');node(features,'smm',state='on')
    node(root,'cpu',mode='host-passthrough');node(root,'on_poweroff','destroy');node(root,'on_reboot','restart');node(root,'on_crash','preserve')
    devices=node(root,'devices');node(devices,'emulator','/usr/bin/qemu-system-x86_64')
    for target,path,kind,fmt in [('sda',spec['root']+'/disk.qcow2','disk','qcow2'),('sdb',spec['assets']['installer']['path'],'cdrom','raw'),('sdc',spec['assets']['drivers']['path'],'cdrom','raw'),('sdd',spec['root']+'/seed.iso','cdrom','raw')]:
        disk=node(devices,'disk',type='file',device=kind);node(disk,'driver',name='qemu',type=fmt);node(disk,'source',file=path);node(disk,'target',dev=target,bus='sata')
        if kind=='cdrom':node(disk,'readonly')
        if target=='sdd':node(disk,'alias',name='ua-vpn-control-credential-seed')
    controller=node(devices,'controller',type='virtio-serial',index='0')
    channel=node(devices,'channel',type='unix');node(channel,'source',mode='bind',path=spec['root']+'/qga.sock');node(channel,'target',type='virtio',name='org.qemu.guest_agent.0')
    tpm=node(devices,'tpm',model='tpm-crb');backend=node(tpm,'backend',type='emulator',version='2.0',persistent_state='yes');node(backend,'source',type='dir',path=spec['root']+'/tpm')
    interface=node(devices,'interface',type='user');node(interface,'model',type='e1000e')
    graphics=node(devices,'graphics',type='vnc',port=spec['vncPort'],autoport='no',listen='127.0.0.1');node(graphics,'listen',type='address',address='127.0.0.1')
    node(devices,'input',type='tablet',bus='usb');video=node(devices,'video');node(video,'model',type='vga',vram='16384',heads='1',primary='yes')
    return E.tostring(root,encoding='unicode')


def plan(spec,setup,context,uri,domain,operation,recovery_id):
    """Pure explicit target plan. It cannot authorize an existing VM mutation."""
    spec=native_vm_spec.FreshWindowsVmSpec.parse(spec).as_dict();setup=unattended.parse_setup(setup)
    binding={'provider':'libvirt-windows','spec':spec,'setup':setup,'context':context,'uri':uri,'domain':domain,'xmlSha256':'0'*64}
    packets.validate_binding(binding)
    _need(lifecycle._uuid(operation)and lifecycle._digest(recovery_id)and operation==str(uuid5(UUID(spec['deploymentId']),recovery_id)))
    xml=domain_xml(spec,domain)
    return json.loads(json.dumps({'schemaVersion':1,'kind':'windows-managed-first-create-v1','binding':{**binding,'xmlSha256':hashlib.sha256(xml.encode()).hexdigest()},
        'operationId':operation,'recoveryId':recovery_id,'xml':xml,'ordinarySigninAllowed':False,'seedDetachRequired':True,'replayAllowed':False},allow_nan=False))


def _plan(value):
    _need(type(value)is dict and set(value)=={'schemaVersion','kind','binding','operationId','recoveryId','xml','ordinarySigninAllowed','seedDetachRequired','replayAllowed'})
    _need(type(value['schemaVersion'])is int and value['schemaVersion']==1 and value['ordinarySigninAllowed']is False and value['seedDetachRequired']is True and value['replayAllowed']is False)
    b=value['binding'];rebuilt=plan(b['spec'],b['setup'],b['context'],b['uri'],b['domain'],value['operationId'],value['recoveryId'])
    _need(rebuilt==value);return rebuilt


def creator_root(value):
    body=_plan(value);return str(PurePosixPath(body['binding']['spec']['root']).parent/'.cache/vpn-control-fixture-creators'/body['binding']['spec']['deploymentId'])


def _namespace_main():
    import os,pathlib,stat,json,types
    module=types.ModuleType('managed_creator_namespace_owner');__import__('sys').modules[module.__name__]=module
    exec(compile(OWNER,'fixed creator namespace owner','exec'),module.__dict__);module.owner_source=lambda:OWNER
    bound=module.MachineBinding.from_dict(BINDING);module._binding_live(bound)
    root=pathlib.Path(ROOT);vm=pathlib.Path(PLAN['binding']['spec']['root'])
    def need(value):
        if not value:raise ValueError('windows_managed_creator_namespace_unknown')
    need(not os.path.lexists(vm));parent=vm.parent
    fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW);held=[fd]
    try:
        for name in parent.parts[1:]:fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd);held.append(fd)
        row=os.fstat(fd);need(row.st_uid==os.geteuid()and not row.st_mode&0o022)
        for name in ('.cache','vpn-control-fixture-creators'):
            try:os.mkdir(name,0o700,dir_fd=fd)
            except FileExistsError:pass
            fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd);held.append(fd);row=os.fstat(fd)
            need(row.st_uid==os.geteuid()and not row.st_mode&0o022)
        created=False
        try:os.mkdir(root.name,0o700,dir_fd=fd);created=True
        except FileExistsError:pass
        module._root(root);generation=module.root_generation(root)
        marker={'schemaVersion':1,'kind':'windows-managed-creator-namespace-v1','vmRoot':str(vm),'machine':PLAN['binding']['spec']['deploymentId'],
            'binding':BINDING,'ownerSourceSha256':__import__('hashlib').sha256(OWNER).hexdigest()}
        path=root/'creator-namespace.json'
        if not os.path.lexists(path):
            need(created and not list(root.iterdir()));module._publish(path,marker)
        need(module._record(path)==marker and not os.path.lexists(vm))
        info=module._private(path,directory=False)
        pin=[info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid,info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns]
        print(json.dumps({'root':ROOT,'generation':list(generation),'marker':marker,'markerGeneration':pin}))
    finally:
        for descriptor in reversed(held):os.close(descriptor)


def _namespace_expected(value,host_binding):
    value=_plan(value);_need(type(host_binding)is jobs.MachineBinding and host_binding.account.isdecimal()and int(host_binding.account)>0
        and UUID(host_binding.boot)==UUID(value['binding']['context']['hostBootId']))
    return {'schemaVersion':1,'kind':'windows-managed-creator-namespace-v1','vmRoot':value['binding']['spec']['root'],'machine':value['binding']['spec']['deploymentId'],
        'binding':jobs.asdict(host_binding),'ownerSourceSha256':hashlib.sha256(jobs.owner_source()).hexdigest()}


def initialize_program(value,host_binding):
    value=_plan(value);_namespace_expected(value,host_binding)
    return ('PLAN='+repr(value)+'\nROOT='+repr(creator_root(value))+'\nBINDING='+repr(jobs.asdict(host_binding))+'\nOWNER='+repr(jobs.owner_source())+'\n'+inspect.getsource(_namespace_main)+'\n_namespace_main()\n').encode()


def _namespace_reply(value,host_binding,reply):
    _need(type(reply)is dict and set(reply)=={'root','generation','marker','markerGeneration'}and reply['root']==creator_root(value)
        and lifecycle._pin(reply['generation'],2)and all(reply['generation'])and lifecycle._pin(reply['markerGeneration'],9)
        and reply['markerGeneration'][2]==0o100600 and reply['markerGeneration'][3]==int(host_binding.account)and reply['markerGeneration'][5]==1 and reply['marker']==_namespace_expected(value,host_binding))
    return json.loads(json.dumps(reply))


def _creator_submit():
    import fcntl,json,os,pathlib,time,types
    module=types.ModuleType('fixed_creator_submission_owner');__import__('sys').modules[module.__name__]=module
    exec(compile(OWNER,'fixed creator owner','exec'),module.__dict__);module.owner_source=lambda:OWNER
    root=module._root(NAMESPACE['root'],tuple(NAMESPACE['generation']));bound=module.MachineBinding.from_dict(NAMESPACE['marker']['binding'])
    module._binding_live(bound);path=root/'creator-namespace.json';expected=NAMESPACE['marker'];need=lambda value:None if value else(_ for _ in ()).throw(ValueError('windows_managed_creator_namespace_unknown'))
    need(module._record(path)==expected);operation=PLAN['operationId'];job=root/operation
    program=module.Program('windows-managed-first-create',SOURCE,262144)
    if os.path.lexists(job):result=module.submit(root,operation,bound,program,generation=tuple(NAMESPACE['generation']))
    else:
        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
        try:
            pin=lambda i:[i.st_dev,i.st_ino,i.st_mode,i.st_uid,i.st_gid,i.st_nlink,i.st_size,i.st_mtime_ns,i.st_ctime_ns]
            original=pin(os.fstat(fd));need(original==pin(os.lstat(path))==NAMESPACE['markerGeneration']);end=time.monotonic()+5
            while True:
                try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB);break
                except BlockingIOError:need(time.monotonic()<end);time.sleep(.02)
            need(pin(os.fstat(fd))==pin(os.lstat(path))==original and module._record(path)==expected)
            need(not os.path.lexists(PLAN['binding']['spec']['root']))
            result=module.submit(root,operation,bound,program,generation=tuple(NAMESPACE['generation']))
        finally:os.close(fd)
    print(json.dumps(result))


def submission_program(program):
    _need(type(program)is jobs.Program and program in _CREATE_PROGRAMS)
    original,job,expected=_CREATE_PROGRAMS[program];_need(original()is program)
    namespace=_CREATE_NAMESPACES[program];value=_CREATE_PLANS[program]
    return ('PLAN='+repr(value)+'\nNAMESPACE='+repr(namespace)+'\nOWNER='+repr(jobs.owner_source())+'\nSOURCE='+repr(program.source)+'\n'+inspect.getsource(_creator_submit)+'\n_creator_submit()\n').encode()


def _creator_inventory():
    import ast,hashlib,json,os,pathlib,types
    def need(value):
        if not value:raise ValueError('windows_managed_creator_visibility_missing')
    module=types.ModuleType('fixed_creator_inventory_owner');__import__('sys').modules[module.__name__]=module
    exec(compile(OWNER,'fixed creator inventory owner','exec'),module.__dict__);module.owner_source=lambda:OWNER
    root=module._root(NAMESPACE['root'],tuple(NAMESPACE['generation']))
    def marker_guard():
        info=module._private(root/'creator-namespace.json',directory=False)
        pin=[info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid,info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns]
        need(pin==NAMESPACE['markerGeneration']and module._record(root/'creator-namespace.json')==NAMESPACE['marker'])
    marker_guard()
    bound=module.MachineBinding.from_dict(NAMESPACE['marker']['binding']);names=list(root.iterdir());need(len(names)<=4096);rows=[]
    for path in names:
        if path.name=='creator-namespace.json':continue
        operation=module._uuid(path.name)
        try:
            intent=module._intent(path,operation,bound);need(intent['purpose']=='windows-managed-first-create')
            source=module._read(path/'program.py',module.MAX_PROGRAM_BYTES)
            need(hashlib.sha256(source).hexdigest()==intent['programSha256']and module._read(path/'owner.py',module.MAX_PROGRAM_BYTES)==OWNER)
            values=[ast.literal_eval(n.value)for n in ast.parse(source).body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)and n.targets[0].id=='PLAN']
            need(len(values)==1);plan=values[0]
            need(plan['binding']==PLAN['binding']and plan['operationId']==operation and plan['ordinarySigninAllowed']is False and plan['seedDetachRequired']is True and plan['replayAllowed']is False)
            status=module.observe(root,operation,bound,generation=tuple(NAMESPACE['generation']))
            if status['state']=='terminal':status,_,_=module.collect(root,operation,bound,generation=tuple(NAMESPACE['generation']))
        except BaseException:status=module._base(operation,'unknown','original_creator_unresolved')
        rows.append({'operationId':operation,'status':status})
    marker_guard()
    print(json.dumps({'kind':'windows-managed-creator-inventory-v1','machine':NAMESPACE['marker']['machine'],'visibilityComplete':True,'jobs':rows,
        'idle':all(row['status']['state']=='terminal'and row['status']['terminal']['exitCode']==0 for row in rows)}))


def inventory_program(value,host_binding,namespace):
    value=_plan(value);namespace=_namespace_reply(value,host_binding,namespace)
    return ('PLAN='+repr(value)+'\nNAMESPACE='+repr(namespace)+'\nOWNER='+repr(jobs.owner_source())+'\n'+inspect.getsource(_creator_inventory)+'\n_creator_inventory()\n').encode()


def _project_creator_inventory(source,machine):
    import contextlib,io,json
    output=io.StringIO()
    with contextlib.redirect_stdout(output):exec(compile(source,'fixed selected creator inventory','exec'),{})
    reply=json.loads(output.getvalue())
    if type(reply)is not dict or set(reply)!={'kind','machine','visibilityComplete','jobs','idle'}or reply['kind']!='windows-managed-creator-inventory-v1'or reply['machine']!=machine or reply['visibilityComplete']is not True or type(reply['jobs'])is not list or type(reply['idle'])is not bool:raise ValueError('windows_managed_creator_visibility_missing')
    return reply


def observer_inventory_definitions(value,host_binding,namespace):
    """Internal source-owned main hook. No purpose-only running exemption."""
    source=inventory_program(value,host_binding,namespace);machine=_plan(value)['binding']['spec']['deploymentId']
    return ('_CREATOR_INVENTORY_SOURCE='+repr(source)+'\n_CREATOR_MACHINE='+repr(machine)+'\n'+inspect.getsource(_project_creator_inventory)+
            '\ndef _creator_host_work():\n return _project_creator_inventory(_CREATOR_INVENTORY_SOURCE,_CREATOR_MACHINE)\n')


def _channel_identity(job,expected,owner_source,*,live=True):
    """Execute on provider HOST: original durable source and live child only."""
    import hashlib,os,pathlib,types,sys
    module=types.ModuleType('managed_create_original_owner');sys.modules[module.__name__]=module
    exec(compile(owner_source,'original-creator-owner','exec'),module.__dict__);module.owner_source=lambda:owner_source
    job=pathlib.Path(job);module._root(job.parent,tuple(expected['rootGeneration']));module._private(job,directory=True)
    binding=module.MachineBinding.from_dict(expected['binding']);module._binding_live(binding)
    intent=module._intent(job,expected['operationId'],binding)
    if intent['purpose']!='windows-managed-first-create'or intent['programSha256']!=expected['programSha256']or module._read(job/'owner.py',module.MAX_PROGRAM_BYTES)!=owner_source:raise ValueError('windows_managed_original_owner_unknown')
    source=module._read(job/'program.py',module.MAX_PROGRAM_BYTES)
    if hashlib.sha256(source).hexdigest()!=intent['programSha256']:raise ValueError('windows_managed_original_owner_unknown')
    original=module._record(job/'owner.json');module._correlate(original,intent);actor=module._owner_identity(original)
    if live and module._birth(actor['pid'])!=actor['birth']:raise ValueError('windows_managed_original_owner_unknown')
    return module,intent,actor,source


def _handoff(job,expected,owner_source):
    """Private stdin -> exact connected original socket, once, no retransmit."""
    import json,os,pathlib,socket,stat,struct,time
    frame=None;value=None;client=None
    try:
        frame=__import__('sys').stdin.buffer.read(4097);value=credential_frame(frame)
        module,intent,owner,source=_channel_identity(job,expected,owner_source,live=False);job=pathlib.Path(job)
        row=module._record(job/'creator-listener.json');sock=job/'credentials.sock'
        if set(row)!={'operationId','actor','executableGeneration','socketIdentity'}or row['operationId']!=expected['operationId']:raise ValueError()
        actor=row['actor'];pid=actor['pid']
        # A consumed handoff never needs a live process or replacement socket.
        # Reclose the exact original files, then preserve its unknown outcome.
        if os.path.lexists(job/'credentials-handoff.intent.json'):
            consumed=module._record(job/'credentials-handoff.intent.json')
            if consumed!={'operationId':expected['operationId'],'actor':actor,'socketIdentity':row['socketIdentity'],'replayAllowed':False}:raise ValueError()
            print(json.dumps({'state':'original-observation-required','operationId':expected['operationId'],'replayAllowed':False}));return
        _channel_identity(job,expected,owner_source)
        if module._birth(pid)!=actor['birth']:raise ValueError()
        proc=pathlib.Path('/proc')/str(pid);raw=(proc/'stat').read_text();words=raw[raw.rfind(')')+2:].split()
        pin=lambda i:[i.st_dev,i.st_ino,i.st_mode,i.st_uid,i.st_gid,i.st_nlink,i.st_size,i.st_mtime_ns,i.st_ctime_ns]
        structure=lambda i:[i.st_dev,i.st_ino,i.st_mode,i.st_uid,i.st_gid]
        if int(words[1])!=owner['pid']or pin(os.stat(proc/'exe'))!=row['executableGeneration']:raise ValueError()
        named=os.lstat(sock)
        if not stat.S_ISSOCK(named.st_mode)or stat.S_IMODE(named.st_mode)!=0o600 or named.st_uid!=os.geteuid()or structure(named)!=row['socketIdentity']:raise ValueError()
        client=socket.socket(socket.AF_UNIX);client.settimeout(10);client.connect(str(sock))
        peer=struct.unpack('3i',client.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))
        if peer[:2]!=(pid,os.geteuid())or module._birth(pid)!=actor['birth']or structure(os.lstat(sock))!=row['socketIdentity']:raise ValueError()
        _channel_identity(job,expected,owner_source)
        module._publish(job/'credentials-handoff.intent.json',{'operationId':expected['operationId'],'actor':actor,'socketIdentity':row['socketIdentity'],'replayAllowed':False})
        client.sendall(frame);client.shutdown(socket.SHUT_WR)
        ack=client.recv(2)
        if ack!=b'OK':raise ValueError()
        print(json.dumps({'state':'credentials-accepted','operationId':expected['operationId'],'replayAllowed':False}))
    except BaseException:
        print(json.dumps({'state':'blocked','operationId':expected['operationId'],'reason':'windows_managed_credential_handoff_unknown','replayAllowed':False}))
    finally:
        if value is not None:value.clear()
        frame=None
        if client is not None:client.close()


def _handoff_source(job,expected):
    _need(lifecycle._canonical(job)and type(expected)is dict and set(expected)=={'operationId','binding','rootGeneration','programSha256'})
    jobs.MachineBinding.from_dict(expected['binding']);_need(lifecycle._uuid(expected['operationId'])and lifecycle._pin(expected['rootGeneration'],2)and lifecycle._digest(expected['programSha256']))
    text=inspect.getsource(credential_frame)+'\n'+inspect.getsource(_channel_identity)+'\n'+inspect.getsource(_handoff)+'\n_handoff('+repr(job)+','+repr(expected)+','+repr(jobs.owner_source())+')\n'
    compile(text,'fixed private managed handoff','exec');return text.encode()


def handoff_program(program):
    """Only the exact locally minted creator may select a credential endpoint."""
    _need(type(program)is jobs.Program and program in _CREATE_PROGRAMS)
    original,job,expected=_CREATE_PROGRAMS[program];_need(original()is program)
    return _handoff_source(job,expected)


def _receive_credentials(job,module,operation):
    import os,pathlib,socket,stat
    def need(value):
        if not value:raise ValueError('windows_managed_private_input_invalid')
    def generation(i):return [i.st_dev,i.st_ino,i.st_mode,i.st_uid,i.st_gid,i.st_nlink,i.st_size,i.st_mtime_ns,i.st_ctime_ns]
    def structure(i):return [i.st_dev,i.st_ino,i.st_mode,i.st_uid,i.st_gid]
    listener=socket.socket(socket.AF_UNIX);listener.settimeout(60);client=None;raw=None
    try:
        endpoint=pathlib.Path(job)/'credentials.sock';listener.bind(str(endpoint));os.chmod(endpoint,0o600);listener.listen(1)
        module._publish(pathlib.Path(job)/'creator-listener.json',{'operationId':operation,'actor':{'pid':os.getpid(),'birth':module._birth(os.getpid())},
            'executableGeneration':generation(os.stat('/proc/self/exe')),'socketIdentity':structure(os.lstat(endpoint))})
        client,_=listener.accept();client.settimeout(10);chunks=[];size=0
        while True:
            block=client.recv(min(4097-size,4097));size+=len(block)
            if not block:break
            need(size<=4096);chunks.append(block)
        raw=b''.join(chunks);chunks.clear();value=credential_frame(raw);raw=None
        module._publish(pathlib.Path(job)/'credentials-accepted.json',{'operationId':operation,'replayAllowed':False})
        client.sendall(b'OK');return value
    finally:
        raw=None
        if client is not None:client.close()
        listener.close()


def _creator_main():
    """One retained ordinary HOST owner; never adopts an existing VM root."""
    _CANONICAL_CREATE_DEFINITIONS()
    import types
    root=pathlib.Path(PLAN['binding']['spec']['root']);spec=PLAN['binding']['spec'];context=PLAN['binding']['context']
    listener=None;connection=None;frame=None;credentials=None;answer=None;secret_media=[]
    job=pathlib.Path(CREATOR_JOB_ROOT)/PLAN['operationId'];phase='original-owner'
    try:
        # The actual complete executing Program, not its imported module hash,
        # authenticates the child before it can accept protected input.
