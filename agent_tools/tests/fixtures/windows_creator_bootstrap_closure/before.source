            'machine':spec['deploymentId'],'hostBoot':context['hostBootId'],'domain':PLAN['binding']['domain'],'uri':PLAN['binding']['uri'],
            'manager':original_manager,'domainId':domain.ID(),'ordinarySigninAllowed':False,'seedDetachRequired':True,'replayAllowed':False}
