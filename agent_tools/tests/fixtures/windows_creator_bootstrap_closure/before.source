        answer=private_answer(PLAN['binding']['setup'],credentials);credentials.clear();credentials=None
        phase='capacity';fresh=CREATOR_ADMISSION['census'];_start_capacity(spec,context,CREATOR_ADMISSION,fresh,_lifecycle_measurement(fresh),PLAN['operationId'])
        absent();require(not os.path.lexists(root),'windows_managed_blank_root_required')
        ledger=root.parent/'.cache/vpn-control-fixture-storage';require(ledger.is_dir()and not ledger.is_symlink(),'windows_managed_storage_unenrolled')
        storage=CREATOR_STORAGE.StoragePlans(ledger)
        with storage._locked():_storage_vm_coverage(storage._read(),fresh,birth)
        # Reserve full new mutable growth, including private seed and NVRAM,
        # before mkdir or qemu-img. Other retained/UNKNOWN claims stay counted.
        storage.reserve('windows-'+spec['deploymentId'],'windows','bootstrap',root,
            [{'path':str(root/'disk.qcow2'),'capacityBytes':spec['diskGiB']*1024**3},
             {'path':str(root/'uefi-vars.fd'),'capacityBytes':8*1024**2},
             {'path':str(root/'seed.iso'),'capacityBytes':64*1024**2}],writer_pid=os.getpid(),staging_growth_bytes=64*1024**2)
        manager_guard();_start_capacity(spec,context,CREATOR_ADMISSION,fresh,_lifecycle_measurement(fresh),PLAN['operationId'])
        module._publish(job/'create.intent.json',{'plan':PLAN,'manager':original_manager,'replayAllowed':False})
        phase='blank-root';os.mkdir(root.name,0o700,dir_fd=parent);private(root,True)
        save('managed-create-host-original.json',{'namespace':CREATOR_NAMESPACE,'operationId':PLAN['operationId'],'programSha256':intent['programSha256'],'owner':owner,'replayAllowed':False})
        source_names=('firmwareCode','installer','drivers')
        save('intent.json',{'schemaVersion':1,'spec':spec,'setup':PLAN['binding']['setup'],'hostBootId':context['hostBootId'],
            'rootIdentity':list(structure(os.lstat(root))),'assetIdentities':{name:{'set':index+1,'generation':list(generation(os.fstat(assets[name])))}for index,name in enumerate(source_names)}})
        for name in ('tpm','seed'):os.mkdir(root/name,0o700)
        save('seed/Autounattend.xml',answer);answer=None
        save('seed/initialize.ps1',CREATOR_INITIALIZE.encode('utf-8-sig'));save('seed/install-agent.ps1',CREATOR_INSTALL_AGENT.encode('utf-8-sig'))
        def run(name,args,timeout=30,limit=262144):
