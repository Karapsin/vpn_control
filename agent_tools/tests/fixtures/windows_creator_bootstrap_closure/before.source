        module._root(job.parent,tuple(CREATOR_ROOT_GENERATION));intent=module._intent(job,PLAN['operationId'],bound)
        source=module._read(job/'program.py',module.MAX_PROGRAM_BYTES)
        require(intent['purpose']=='windows-managed-first-create'and hashlib.sha256(source).hexdigest()==intent['programSha256']
                and compile(source,'fixed-purpose-program','exec')==_CREATOR_EXECUTING_CODE,'windows_managed_original_owner_unknown')
        expected={'operationId':PLAN['operationId'],'binding':CREATOR_HOST_BINDING,'rootGeneration':CREATOR_ROOT_GENERATION,'programSha256':intent['programSha256']}
        _,_,owner,_=_channel_identity(job,expected,CREATOR_OWNER_SOURCE)
        require(os.getppid()==owner['pid'],'windows_managed_original_owner_unknown')
        os.umask(0o077);parent=chain();closing()
        import fcntl
        namespace_path=job.parent/'creator-namespace.json';namespace_fd=os.open(namespace_path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);held.append(namespace_fd)
        namespace_pin=generation(os.fstat(namespace_fd));require(list(namespace_pin)==CREATOR_NAMESPACE['markerGeneration']and namespace_pin==generation(os.lstat(namespace_path))and module._record(namespace_path)==CREATOR_NAMESPACE['marker'],'windows_managed_creator_namespace_unknown')
