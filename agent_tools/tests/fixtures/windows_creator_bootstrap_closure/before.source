        domain=connection.defineXML(PLAN['xml']);require(domain is not None,'windows_managed_define_unknown');manager_guard()
        require(domain.UUIDString()==spec['deploymentId']and domain.name()==PLAN['binding']['domain']and not domain.isActive(),'windows_managed_define_unknown')
