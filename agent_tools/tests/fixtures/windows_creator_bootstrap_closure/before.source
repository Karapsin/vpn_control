        phase='disk';run('qemu-img',['create','-f','qcow2',str(root/'disk.qcow2'),str(spec['diskGiB'])+'G'])
        image=json.loads(run('qemu-img',['info','--output=json',str(root/'disk.qcow2')]))
        require(image.get('format')=='qcow2'and image.get('virtual-size')==spec['diskGiB']*1024**3 and not image.get('backing-filename'),'windows_managed_blank_disk_unknown')
        for name in ('disk.qcow2','uefi-vars.fd'):private(root/name)
        save('mutable-artifacts.json',{name:list(structure(private(root/name)))for name in ('disk.qcow2','uefi-vars.fd')})
        phase='private-seed';run('xorriso',['-as','mkisofs','-quiet','-J','-R','-V','VCSETUP','-o',str(root/'seed.iso'),str(root/'seed')],timeout=60)
        for name in ('seed/Autounattend.xml','seed.iso'):
            path=root/name;info=private(path);require(0<info.st_size<=64*1024**2,'windows_managed_private_seed_invalid')
            fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);held.append(fd);raw=os.read(fd,64*1024**2+1)
            require(len(raw)==info.st_size and generation(os.fstat(fd))==generation(info),'windows_managed_private_seed_invalid')
            secret_media.append((fd,path,generation(info),raw))
        save('credential-seed-custody.json',{'operationId':PLAN['operationId'],'ordinarySigninAllowed':False,'detachRequired':True,
            'files':{str(path.relative_to(root)):list(identity)for fd,path,identity,raw in secret_media},'replayAllowed':False})
        def seed_guard():
            for fd,path,identity,raw in secret_media:
                require(generation(os.fstat(fd))==generation(os.lstat(path))==identity,'windows_managed_private_seed_changed')
                os.lseek(fd,0,0);require(os.read(fd,len(raw)+1)==raw,'windows_managed_private_seed_changed')
