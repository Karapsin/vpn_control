 with open('/proc/sys/kernel/random/boot_id')as stream:live_boot=stream.read(128).strip()
 require(live_boot==CONTEXT['hostBootId']and os.geteuid()==TARGET_UID,'abandon_host_context')
 instance_intent();closing()
 require(structure(os.fstat(ROOT_FD))==ROOT_STRUCTURE and structure(os.lstat(root))==ROOT_STRUCTURE,'abandon_root_changed')
 q=read('qemu-started.json');t=read('swtpm-started.json')
 require({'pid':q['pid'],'startTicks':q['startTicks']}==QEMU_EXPECTED and {'pid':t['pid'],'startTicks':t['startTicks']}==SWTPM_EXPECTED,'abandon_vm_identity')
 process(q);process(t);owns(q['pid'],root/'qga.sock',True)


def original_files_guard():
 host_guard();files_closing()
 require(set(all_files)==EXPECTED_SELECTED_NAMES,'abandon_original_selected_scope_changed')


def actor_guard():
 original_files_guard()
 actual=actor_snapshot(ACTOR['pid'],REQUIRED_PATHS)
 require(stable_actor_identity(actual)==ACTOR_STABLE,'abandon_actor_identity_changed')
 require(actor_status_identity(base64.b64decode(actual['statusBase64'],validate=True))==ACTOR_STATUS_IDENTITY,'abandon_actor_stable_status_changed')
 return actual


def fdinfo_identity(require_alive):
 require(pidfd is not None and os.readlink('/proc/self/fd/'+str(pidfd))=='anon_inode:[pidfd]'and generation(os.fstat(pidfd))==pidfd_generation,'abandon_pidfd_descriptor_changed')
 raw=bounded_proc('/proc/self/fdinfo/'+str(pidfd),65536);rows=raw.splitlines();pids=[r for r in rows if r.startswith(b'Pid:')];namespaces=[r for r in rows if r.startswith(b'NSpid:')]
 require(len(pids)==1 and len(pids[0].split())==2 and len(namespaces)<=1,'abandon_pidfd_fdinfo_shape')
