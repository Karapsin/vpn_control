 all_files=COLLECTOR['files'];require(type(all_files)is dict and set(all_files)==EXPECTED_SELECTED_NAMES,'abandon_original_files')
 total=0
 for name,row in all_files.items():
  require(type(name)is str and name.startswith(ORIGINAL_PREFIX+'.')and '/'not in name and '\\'not in name and type(row)is dict and row.get('path')==str(root/name),'abandon_original_file_path')
  if row.get('state')=='absent':require(row.get('closingAbsent')is True,'abandon_original_absence_receipt');continue
  require(row.get('state')=='complete'and row.get('namedHeldOpening')is True and row.get('namedHeldClosing')is True and row.get('openingGeneration')==row.get('closingGeneration')and row.get('openingSha256')==row.get('closingSha256'),'abandon_original_closing_receipt')
  require(type(row.get('bytes'))is int and row['bytes']>=0,'abandon_original_file_size')
  total+=row['bytes'];require(total<=MAX_INPUT,'abandon_original_total_bound')
  private(root/name);fd=os.open(root/name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);held.append(fd);opening=generation(os.fstat(fd))
  require(list(opening)==row['openingGeneration']and generation(os.lstat(root/name))==opening,'abandon_original_live_generation_changed')
  data=b''
  while True:
