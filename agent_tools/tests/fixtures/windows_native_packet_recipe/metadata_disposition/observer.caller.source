 require(len(raw)<=limit,'collector_proc_bound');return raw
def file_bytes(suffix,required=True):
 name=ORIGINAL_PREFIX+suffix;data=ORIGINAL_HELD_BYTES.get(name)
 if data is None:require(not required,'collector_required_original_file_absent');return None
 return data
def historical_wire_join():
 qga=file_bytes('.canonical-qga.py');emitter=file_bytes('.canonical-emitter.py')
 require(hashlib.sha256(qga).hexdigest()==QGA_SHA256 and hashlib.sha256(emitter).hexdigest()==EMITTER_SHA256,'collector_original_canonical_source_hash')
 raw=file_bytes('.rpc-000083.raw');request=file_bytes('.rpc-000083.request.json');intent=json.loads(file_bytes('.rpc-000083.intent.json'))
 require(type(intent)is dict and intent.get('sequence')==83 and type(intent.get('nonce'))is int and intent['nonce']==EXPECTED_NONCE and intent.get('requestPath')==str(root/(ORIGINAL_PREFIX+'.rpc-000083.request.json'))and intent.get('rawPath')==str(root/(ORIGINAL_PREFIX+'.rpc-000083.raw'))and intent.get('requestBytes')==len(request)and intent.get('requestSha256')==hashlib.sha256(request).hexdigest(),'collector_original_rpc_intent_join')
 parsed=json.loads(request);require(type(parsed)is dict and parsed.get('execute')==intent.get('command')=='guest-exec','collector_original_rpc_command_join')
 matches=0;after_sync=[]
 for line in raw.splitlines(keepends=True):
  marker=line.rfind(b'\xff')
  if marker>=0:
   try:value=json.loads(line[marker+1:])
   except(ValueError,UnicodeDecodeError):continue
   if type(value)is dict and set(value)=={'return'}and type(value['return'])is int and value['return']==intent['nonce']:matches+=1
  elif matches:
   after_sync.append(json.loads(line))
 require(matches==1,'collector_original_sync_nonce_join')
 require(after_sync==[{'error':{'class':'GenericError','desc':'Failed to execute helper program (Invalid argument)'}}],'collector_original_error_reply_join')
 return {'canonicalSourceSha256':QGA_SHA256,'canonicalOpenChecksPeerCredentialsBeforeSync':True,'knownQemuPid':QEMU_EXPECTED['pid'],'knownQemuStartTicks':QEMU_EXPECTED['startTicks'],'rpcSequence':83,'command':'guest-exec','requestSha256':hashlib.sha256(request).hexdigest(),'rawSha256':hashlib.sha256(raw).hexdigest(),'rawBytes':len(raw),'nonce':intent['nonce'],'matchingDelimitedSyncReplies':matches,'afterSyncReply':after_sync[0],'originalRpcOutcome':'UNKNOWN','guestChildAbsenceClaimed':False,'guestReplayAllowed':False,'meaning':'Historical complete bf05 source/intent/nonce/raw causal join only; not a fresh socket peer or guest child-state query.'}
def fd_metadata(pid,number,expected_link=None):
 path='/proc/'+str(pid)+'/fd/'+number;before=os.readlink(path)
 if expected_link is not None:require(before==expected_link,'collector_actor_fd_link_changed')
 info=os.stat(path);after=os.readlink(path);require(before==after,'collector_actor_fd_link_changed')
 return {'fd':int(number),'link':before,'targetGeneration':list(generation(info))}
def process_link_metadata(pid,leaf):
 path='/proc/'+str(pid)+'/'+leaf;before=os.readlink(path);info=os.stat(path);after=os.readlink(path);require(before==after,'collector_actor_metadata_link_changed')
 return {'link':before,'targetGeneration':list(generation(info))}

def process_namespace_root(pid):
 base='/proc/'+str(pid);names=os.listdir(base+'/ns');require(0<len(names)<=32 and all(type(name)is str and re.fullmatch('[a-z_]+',name)for name in names),'collector_namespace_bound')
 return {'namespaces':{name:process_link_metadata(pid,'ns/'+name)for name in sorted(names)},'processRoot':process_link_metadata(pid,'root')}

def actor_snapshot(pid,required_paths):
 base='/proc/'+str(pid);require(os.stat(base).st_uid==os.geteuid(),'collector_actor_uid')
 start=birth(pid);cmd=bounded_proc(base+'/cmdline',1024*1024);status=bounded_proc(base+'/status',65536);exe=os.readlink(base+'/exe');exestat=generation(os.stat(base+'/exe'));argv=cmd.rstrip(b'\0').split(b'\0')
 require(cmd.endswith(b'\0')and argv and all(b'\0'not in x for x in argv),'collector_actor_cmdline');require(re.fullmatch(r'python3(?:\.[0-9]+)?',pathlib.PurePosixPath(exe).name)is not None,'collector_actor_python')
 uid_line=[line for line in status.splitlines()if line.startswith(b'Uid:')];require(len(uid_line)==1 and [int(x)for x in uid_line[0].split()[1:]]==[os.geteuid()]*4,'collector_actor_uid_status')
 numbers=os.listdir(base+'/fd');require(len(numbers)<=8192,'collector_actor_fd_bound');selected={};sockets=[]
 for number in sorted(numbers,key=lambda x:int(x)if x.isdecimal()else-1):
  if not number.isdecimal():continue
  try:link=os.readlink(base+'/fd/'+number)
  except FileNotFoundError:continue
  if link in required_paths:
   metadata=fd_metadata(pid,number,link);require(metadata['targetGeneration']==all_files[pathlib.Path(link).name]['openingGeneration'],'collector_actor_original_fd_identity');selected.setdefault(link,[]).append(metadata)
  elif re.fullmatch(r'socket:\[[0-9]+\]',link):sockets.append(fd_metadata(pid,number,link))
 require(set(selected)==set(required_paths)and sockets,'collector_actor_exact_fd_scope')
 metadata=process_namespace_root(pid)
 require(birth(pid)==start and os.stat(base).st_uid==os.geteuid()and os.readlink(base+'/exe')==exe and generation(os.stat(base+'/exe'))==exestat and bounded_proc(base+'/cmdline',1024*1024)==cmd,'collector_actor_opening_identity')
 return {'pid':pid,'uid':os.geteuid(),'startTicks':start,'exe':exe,'executableGeneration':list(exestat),'cmdlineBase64':base64.b64encode(cmd).decode(),'cmdlineSha256':hashlib.sha256(cmd).hexdigest(),'argvBytesBase64':[base64.b64encode(x).decode()for x in argv],'statusBase64':base64.b64encode(status).decode(),'requiredSourceAndRequestFds':selected,'socketFds':sockets,**metadata}
def actor_identity_observation(value):
 keys=('pid','uid','startTicks','exe','executableGeneration','cmdlineBase64','cmdlineSha256','argvBytesBase64','requiredSourceAndRequestFds','socketFds','namespaces','processRoot')
 return {key:value[key]for key in keys}

def stable_actor_identity(value):
 projection=actor_identity_observation(value);namespaces=projection['namespaces']
 if type(namespaces)is not dict or not namespaces:raise ValueError('collector_namespace_projection_shape')
 projected={}
 for name,metadata in namespaces.items():
  if type(metadata)is not dict or type(metadata.get('targetGeneration'))is not list or len(metadata['targetGeneration'])!=9:raise ValueError('collector_namespace_projection_shape')
  projected[name]={**metadata,'targetGeneration':metadata['targetGeneration'][:7]}
 projection['namespaces']=projected
 return projection
