def exact_write(fd,data):
 at=0
 while at<len(data):
  count=os.write(fd,data[at:at+65536]);require(type(count)is int and 0<count<=min(65536,len(data)-at),'abandon_journal_short_write');at+=count


def journal(name,value):
 require(HOST_ADMITTED and name.startswith(prefix+'.')and '/'not in name and '\\'not in name,'abandon_journal_scope')
 instance_intent();closing()
 raw=value if type(value)is bytes else(json.dumps(value,sort_keys=True,separators=(',',':'))+'\n').encode()
 require(len(raw)<=MAX_INPUT,'abandon_journal_bound')
 fd=os.open(root/name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
 try:exact_write(fd,raw);os.fsync(fd)
 finally:os.close(fd)
 os.fsync(ROOT_FD)
 fd=os.open(root/name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);held.append(fd);opening=generation(os.fstat(fd));actual=b''
 while True:
  part=os.read(fd,65536)
  if not part:break
  actual+=part;require(len(actual)<=MAX_INPUT,'abandon_journal_read_bound')
 require(actual==raw and generation(os.fstat(fd))==opening and generation(os.lstat(root/name))==opening,'abandon_journal_readback')
 pins.append((fd,root/name,opening));held_files.append((fd,len(raw),hashlib.sha256(raw).hexdigest()))
 return {'path':str(root/name),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'fileFsynced':True,'parentFsynced':True}


def hash_held(fd,length):
 os.lseek(fd,0,os.SEEK_SET);h=hashlib.sha256();size=0
 while True:
  part=os.read(fd,65536)
  if not part:break
  size+=len(part);require(size<=length,'abandon_held_bound');h.update(part)
 require(size==length,'abandon_held_size');return h.hexdigest()


def files_closing():
 for fd,length,digest in held_files:require(hash_held(fd,length)==digest,'abandon_held_hash_changed')
 closing()


def actor_status_identity(raw):
 rows=raw.splitlines();uids=[r for r in rows if r.startswith(b'Uid:')];require(len(uids)==1,'abandon_actor_uids')
 uid_values=[int(x)for x in uids[0].split()[1:]];require(uid_values==[os.geteuid()]*4,'abandon_actor_uids')
 namespace=[r for r in rows if r.startswith(b'NSpid:')];require(len(namespace)<=1,'abandon_actor_namespace')
 ns=[int(x)for x in namespace[0].split()[1:]]if namespace else None
 require(ns is None or ns and all(x>0 for x in ns),'abandon_actor_namespace')
 return {'uids':uid_values,'namespacePids':ns}


