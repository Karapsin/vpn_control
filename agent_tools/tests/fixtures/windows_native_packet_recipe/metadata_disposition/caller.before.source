 require(hashlib.sha256(file_bytes('.rpc-000018.request.json')).hexdigest()==EXPECTED_REQUEST_SHA256 and hashlib.sha256(file_bytes('.rpc-000018.raw')).hexdigest()==EXPECTED_RAW_SHA256,'abandon_original_rpc83_hash')
 historical=historical_wire_join();require(historical==COLLECTOR['historicalWireJoin'],'abandon_historical_wire_changed')
