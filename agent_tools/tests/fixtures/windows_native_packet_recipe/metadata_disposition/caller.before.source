 raw=bounded_proc('/proc/self/fdinfo/'+str(pidfd),65536);rows=raw.splitlines();pids=[r for r in rows if r.startswith(b'Pid:')];namespaces=[r for r in rows if r.startswith(b'NSpid:')]
 require(len(pids)==1 and len(pids[0].split())==2 and len(namespaces)<=1,'abandon_pidfd_fdinfo_shape')
