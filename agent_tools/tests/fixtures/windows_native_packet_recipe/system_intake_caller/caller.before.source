INTAKE_RENDERER_SOURCE=b'"""Finite pure initial SYSTEM intake rendering. No I/O, transport, or guest action.\n\nThe caller supplies immutable whole current sources and four retained completion\nbytes. Only canonical build_guest_exec/decode_guest_result are used. This module\nnever starts or polls an operation; the existing sole QGA operator owns custody.\n"""\nimport hashlib\nimport json\nimport re\nimport sys\nimport types\nimport uuid\n\nOWNER_SHA = \'d6317f066f4a679e37f0a6aa5c30c229a2c6115ae2968aed568bec91d07362b2\'\nEMITTER_SHA = \'2938a7c6c25d23adc9683ced126fe2d3c0a88614dab59a7b134a624d6f8b0ee8\'\nRAW_OUTPUT_LIMIT = 65536\nCATALOG = (\n    dict(key=\'msi\', transferId=\'87079087-ae56-43c9-b504-842d2f300e12\', name=\'vpn-control-2.2.13.msi\', bytes=131228020,\n         sha256=\'8167212cb412c0e0d1c3ad1d60f12fdbc5477043725fd35484bdf6b46db25fb6\',\n         rootIdentity=\'0cbd6c77:000e000000007dcc\', fileIdentity=\'0cbd6c77:000c000000007dcd\',\n         endpointReceiptSha256=\'b6df93d2beef13263325756dcef278d5e45c013cd2ba99681545d3cfdec9eefc\',\n         transferReceiptSha256=\'724493f1ec9676dd464997633761685b4053be0a7c2fb330b430b6add48d1325\'),\n    dict(key=\'python\', transferId=\'658bac7e-b69f-494d-908e-5a80aa3f2c57\', name=\'python-3.13.15-amd64.exe\', bytes=29452944,\n         sha256=\'edec09c4853aeae9ac36efb8c9f95b6b8e2fee65eee56d9767a8b7c69c574403\',\n         rootIdentity=\'0cbd6c77:0010000000007dda\', fileIdentity=\'0cbd6c77:000e000000007ddb\',\n         endpointReceiptSha256=\'5bca869ecece141ca7901a606f7e343bc5ce03e5cbe8e12f66ddacff300cffe9\',\n         transferReceiptSha256=\'3cb3f0a2f62a5a5617f178a6b58f25c41d6ed0470b1fedd075b24946bcee7b3c\'),\n)\n\ndef need(ok, code):\n    if not ok:\n        raise ValueError(code)\n\ndef sha(source):\n    return hashlib.sha256(source).hexdigest()\n\ndef canonical_module(source):\n    need(type(source) is bytes and sha(source) == EMITTER_SHA, \'emitter-whole-source-pin\')\n    name = \'_private_initial_system_emitter_\' + EMITTER_SHA + \'_\' + uuid.uuid4().hex\n    need(name not in sys.modules, \'emitter-module-collision\')\n    module = types.ModuleType(name)\n    module.__file__ = \'agent_tools/windows_artifact_transfer.py@\' + EMITTER_SHA\n    sys.modules[name] = module\n    exec(compile(source, module.__file__, \'exec\'), module.__dict__, module.__dict__)\n    need(sys.modules[name] is module, \'emitter-module-registration\')\n    return module\n\ndef native_fragments(owner_source):\n    need(type(owner_source) is bytes and sha(owner_source) == OWNER_SHA, \'owner-whole-source-pin\')\n    source = owner_source.decode(\'utf-8-sig\')\n    start = source.index("Add-Type -TypeDefinition @\'\\n")\n    end = source.index(\'\\npublic sealed class RetainedRawPump\', start)\n    helper = source[start:end] + "\\n\'@ -ReferencedAssemblies @(\'System\',\'System.Core\')\\n"\n    start = source.index(\'function Assert-NativeIdentity(\')\n    end = source.index(\'function Add-FilePin(\', start)\n    return helper, source[start:end]\n\ndef artifact_acl_fragment(emitter):\n    source = emitter._ENDPOINT\n    start = source.index(\'function Read-ArtifactAcl(\')\n    end = source.index(\'\\n}\\n\', start) + 3\n    return source[start:end]\n\ndef _uuid(value, code):\n    need(type(value) is str and str(uuid.UUID(value)) == value and uuid.UUID(value).int != 0, code)\n\ndef _receipt(raw, expected_sha, label):\n    need(type(raw) is bytes and sha(raw) == expected_sha, label + \'-receipt-pin\')\n    value = json.loads(raw)\n    need(type(value) is dict and value.get(\'state\') == \'qualified\'\n         and value.get(\'originalExecNaturalExit\') == 0\n         and value.get(\'completeOuterSourceClosing\') is True\n         and value.get(\'dualEOF\') is True and value.get(\'stderrBytes\') == 0\n         and value.get(\'f9FinallyClosingProvenByNaturalExit0\') is True\n         and value.get(\'productInstalled\') is False, label + \'-known-closed\')\n    need(type(value.get(\'ownerClosing\')) is dict and value[\'ownerClosing\'].get(\'sourceClosing\') is True,\n         label + \'-owner-source-closing\')\n    return value\n\ndef _acl(value, directory):\n    need(type(value) is dict and set(value) == {\'ownerSid\',\'sddl\',\'rules\',\'protected\'}\n         and value[\'ownerSid\'] == \'S-1-5-18\' and type(value[\'rules\']) is int and value[\'rules\'] == 3\n         and value[\'protected\'] is directory and type(value[\'sddl\']) is str\n         and 1 <= len(value[\'sddl\']) <= 4096 and \'\\x00\' not in value[\'sddl\'], \'endpoint-full-acl\')\n\ndef bind_input(*, endpoint_receipts, transfer_receipts, guest_context, operation_id, phase_id, route, emitter):\n    """Consume exactly the retained four closed receipts; no new native facts."""\n    need(type(endpoint_receipts) is dict and set(endpoint_receipts) == {\'msi\',\'python\'}, \'two-endpoint-receipts\')\n    need(type(transfer_receipts) is dict and set(transfer_receipts) == {\'msi\',\'python\'}, \'two-transfer-receipts\')\n    _uuid(operation_id, \'fresh-operation-id\'); _uuid(phase_id, \'fresh-phase-id\')\n    need(operation_id != phase_id and route in (\'DIRECT\',\'MCP\'), \'assigned-route-phase\')\n    need(type(guest_context) is dict, \'unbound-guest-context\')\n    emitter._context(guest_context, guest_context[\'deploymentId\'])\n    assets = []\n    for c in CATALOG:\n        e = _receipt(endpoint_receipts[c[\'key\']], c[\'endpointReceiptSha256\'], c[\'key\'] + \'-endpoint\')[\'endpoint\']\n        t = _receipt(transfer_receipts[c[\'key\']], c[\'transferReceiptSha256\'], c[\'key\'] + \'-transfer\')\n        inner = t[\'innerResult\']\n        root = \'C:\\\\ProgramData\\\\VpnControlArtifact-\' + c[\'transferId\']\n        path = root + \'\\\\\' + c[\'name\']\n        need(e[\'transferId\'] == t[\'transferId\'] == inner[\'transferId\'] == c[\'transferId\']\n             and e[\'deploymentId\'] == guest_context[\'deploymentId\']\n             and e[\'rootPath\'] == root and e[\'filePath\'] == path\n             and e[\'rootIdentity\'] == c[\'rootIdentity\'] and e[\'fileIdentity\'] == c[\'fileIdentity\']\n             and e[\'rootIdentityClosing\'] is True and e[\'guestBootClosing\'] is True\n             and e[\'bootstrapActorClosing\'] is True and e[\'parentChainNoReparse\'] is True,\n             \'actual-endpoint-scope\')\n        need(e[\'bootstrapOpening\'] == e[\'bootstrapClosing\'] and e[\'bootstrapOpening\'][\'boot\'] == guest_context[\'boot\'],\n             \'endpoint-current-boot\')\n        need(t.get(\'actualWholeFileTransferCompleted\') is True and inner[\'state\'] == \'qualified\'\n             and inner[\'handleStatus\'] == \'closed-acknowledged\' and inner[\'sourceClosing\'] is True\n             and inner[\'bytes\'] == c[\'bytes\'] and inner[\'sha256\'] == c[\'sha256\']\n             and inner[\'sameFileIdentity\'] == t[\'endpointFileIdentity\'] == c[\'fileIdentity\']\n             and inner[\'canonicalEmitterSha256\'] == EMITTER_SHA\n             and inner[\'canonicalQgaSha256\'] == \'bf05c8f08c1e5210ba79ffb59186206e80dc13fef057748dab3596df8ab6f022\',\n             \'actual-transfer-known-full-close\')\n        _acl(e[\'rootAcl\'], True); _acl(e[\'fileAcl\'], False)\n        assets.append({k:c[k] for k in (\'key\',\'transferId\',\'bytes\',\'sha256\',\'rootIdentity\',\'fileIdentity\',\'endpointReceiptSha256\',\'transferReceiptSha256\')}\n                      | dict(root=root,path=path,rootAcl=e[\'rootAcl\'],fileAcl=e[\'fileAcl\']))\n    return dict(operationId=operation_id, route=route, ordinarySid=guest_context[\'ordinarySid\'],\n                directoryPaths=[\'C:\\\\\',\'C:\\\\ProgramData\'] + [a[\'root\'] for a in assets] + [\'C:\\\\Windows\',\'C:\\\\Windows\\\\System32\',\'C:\\\\Windows\\\\System32\\\\WindowsPowerShell\',\'C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\',guest_context[\'sourceWorkspace\']],\n                systemFiles=[guest_context[\'powerShellPath\'],\'C:\\\\Windows\\\\System32\\\\msiexec.exe\'], assets=assets)\n\ndef render_sources(*, template, emitter_source, ordinary_owner_source, endpoint_receipts,\n                   transfer_receipts, guest_context, operation_id, phase_id, route):\n    emitter = canonical_module(emitter_source)\n    value = bind_input(endpoint_receipts=endpoint_receipts, transfer_receipts=transfer_receipts,\n                       guest_context=guest_context, operation_id=operation_id, phase_id=phase_id, route=route, emitter=emitter)\n    helper, assertions = native_fragments(ordinary_owner_source)\n    acl = artifact_acl_fragment(emitter)\n    replacements = {\'@@INPUT@@\': "$m=\'" + json.dumps(value,separators=(\',\',\':\'),ensure_ascii=True) + "\'|ConvertFrom-Json",\n                    \'@@EXACT_CANONICAL_NATIVE_HELPER@@\':helper,\n                    \'@@EXACT_CANONICAL_PIN_ASSERTIONS@@\':assertions,\n                    \'@@EXACT_CANONICAL_ARTIFACT_ACL@@\':acl}\n    need(type(template) is str and all(template.count(k) == 1 for k in replacements), \'finite-template\')\n    for key, replacement in replacements.items():\n        need("\'" not in json.dumps(value) if key == \'@@INPUT@@\' else True, \'input-literal\')\n        template = template.replace(key,replacement)\n    need(\'@@\' not in template, \'unbound-source\')\n    source = emitter._boot_bound(template,guest_context).encode(\'utf-8-sig\')\n    plan = emitter.build_guest_exec(source,guest_context=guest_context,phase_id=phase_id)\n    need(plan[\'transport\'] == \'saved-source\', \'canonical-held-saved-source-required\')\n    return dict(source=source,plan=plan,input=value,sourceSha256=sha(source),sourceBytes=len(source),\n                nativeHelperSha256=sha(helper.encode()),pinAssertionsSha256=sha(assertions.encode()),\n                artifactAclSha256=sha(acl.encode()),canonicalEmitterSha256=EMITTER_SHA,canonicalOrdinaryOwnerSha256=OWNER_SHA,\n                preparationOnly=True,nativeQualified=False,nativeActionAllowed=False)\n\ndef decode_result(*, emitter_source, plan, stdout, guest_context, original_pid, expected_input):\n    """Only after original ACK/status known terminal+untruncated raw/source closure.\n\n    Caller retains original raw bytes, PID, both EOFs and outer owner/source proof.\n    This pure decoder does not turn an incomplete/UNKNOWN observation terminal.\n    """\n    need(type(stdout) is bytes and 1 <= len(stdout) <= RAW_OUTPUT_LIMIT, \'bounded-untruncated-raw\')\n    emitter = canonical_module(emitter_source)\n    value = emitter.decode_guest_result(plan,json.loads(stdout),guest_context,original_pid)\n    return validate_observations(value,expected_input)\n\ndef validate_observations(value, expected_input):\n    """Validate finite body observations after the mandatory canonical envelope gate."""\n    need(value.get(\'pinSecuritySections\') == 5, \'owner-dacl-sections\')\n    need(value.get(\'state\') == \'initial-system-observed\' and value.get(\'schemaVersion\') == 1\n         and value.get(\'operationId\') == expected_input[\'operationId\'] and value.get(\'route\') == expected_input[\'route\'], \'intake-result-owner\')\n    for key in (\'tokenClosing\',\'kernelBootClosing\',\'allHeldAndNamedPinsClosing\',\'allFullAclClosing\'):\n        need(value.get(key) is True, \'intake-closing\')\n    for key in (\'nativeAdmissionComplete\',\'signerAdmissionComplete\',\'productInstalled\',\'productOperation\',\'taskOperation\'):\n        need(value.get(key) is False, \'intake-observation-only\')\n    t = value[\'systemToken\']\n    need(type(t) is list and len(t) == 6 and all(type(x) is str for x in t)\n         and t[:3] == [\'S-1-5-18\',\'0\',\'1\'] and t[3] in (\'1\',\'2\') and t[4] in (\'True\',\'False\') and t[5] in (\'True\',\'False\'), \'actual-token6\')\n    _uuid(value[\'kernelBootIdentifier\'], \'actual-kernel-guid\')\n    def pin(p, directory):\n        expected = {\'path\',\'nativeIdentity\',\'security\'} | (set() if directory else {\'sha256\'})\n        need(type(p) is dict and set(p) == expected, \'native-pin-schema\')\n        identity=p[\'nativeIdentity\']; keys={\'attributes\',\'volumeSerial\',\'fileIndex\'}\n        if not directory: keys |= {\'sizeBytes\',\'links\',\'creationFileTime\',\'lastWriteFileTime\'}\n        need(type(identity) is dict and set(identity) == keys, \'native-identity-schema\')\n        for k in keys - {\'creationFileTime\',\'lastWriteFileTime\'}:\n            need(type(identity[k]) is int and identity[k] >= 0, \'native-identity-integer\')\n        need(not identity[\'attributes\'] & 0x400 and bool(identity[\'attributes\'] & 0x10) is directory, \'native-pin-kind\')\n        if not directory:\n            need(identity[\'links\'] == 1 and type(p[\'sha256\']) is str and re.fullmatch(\'[0-9a-f]{64}\',p[\'sha256\']) is not None, \'native-single-link-digest\')\n            for k in (\'creationFileTime\',\'lastWriteFileTime\'):\n                need(type(identity[k]) is str and re.fullmatch(\'[1-9][0-9]{0,18}\',identity[k]) is not None, \'native-filetime\')\n        s=p[\'security\'];need(type(s) is dict and set(s)=={\'ownerSid\',\'sddl\'} and type(s[\'ownerSid\']) is str\n                           and re.fullmatch(r\'S-[0-9]+(?:-[0-9]+)+\',s[\'ownerSid\']) is not None\n                           and type(s[\'sddl\']) is str and 1<=len(s[\'sddl\'])<=4096,\'native-owner-dacl\')\n    directories=value[\'directoryPins\'];files=value[\'filePins\'];observations=value[\'assetObservations\']\n    need(type(directories) is list and len(directories)==9 and [p[\'path\'] for p in directories]==expected_input[\'directoryPaths\'],\'exact-directory-pins\')\n    need(type(files) is list and len(files)==4 and type(observations) is list and len(observations)==2,\'exact-two-file-pins\')\n    for p in directories: pin(p,True)\n    for p in files: pin(p,False)\n    need([p[\'path\'] for p in files[2:]]==expected_input[\'systemFiles\'],\'exact-two-system-file-pins\')\n    for p,o,a in zip(files[:2],observations,expected_input[\'assets\']):\n        pin(p,False);identity=p[\'nativeIdentity\']\n        id2=\'%08x:%016x\'%(identity[\'volumeSerial\'],identity[\'fileIndex\'])\n        need(p[\'path\']==a[\'path\'] and p[\'sha256\']==a[\'sha256\'] and identity[\'sizeBytes\']==a[\'bytes\'] and id2==a[\'fileIdentity\'],\'exact-file-pin\')\n        need(o[\'key\']==a[\'key\'] and o[\'filePath\']==a[\'path\'] and o[\'fileIdentity\']==id2\n             and o[\'rootAcl\']==a[\'rootAcl\'] and o[\'fileAcl\']==a[\'fileAcl\']\n             and o[\'endpointReceiptSha256\']==a[\'endpointReceiptSha256\'] and o[\'transferReceiptSha256\']==a[\'transferReceiptSha256\'],\'asset-receipt-join\')\n        for k in (\'heldPhysicalRead\',\'identityClosing\',\'namedIdentityClosing\',\'aclClosing\'):\n            need(o.get(k) is True,\'asset-closing\')\n        need(o[\'signature\'].get(\'observationOnly\') is True and o[\'signature\'].get(\'signerAdmissionComplete\') is False,\'signature-observation-only\')\n        sig=o[\'signature\'];need(type(sig.get(\'status\')) is str and len(sig[\'status\'])<=2048,\'signature-status\')\n        need(sig.get(\'signerSubject\') is None or (type(sig[\'signerSubject\']) is str and len(sig[\'signerSubject\'])<=2048),\'signature-subject\')\n        cert=sig.get(\'signerCertificateSha256\');need(cert is None or (type(cert) is str and re.fullmatch(\'[0-9a-f]{64}\',cert) is not None),\'signature-cert-sha\')\n        root=next(p for p in directories if p[\'path\']==a[\'root\'])[\'nativeIdentity\']\n        need(\'%08x:%016x\'%(root[\'volumeSerial\'],root[\'fileIndex\'])==a[\'rootIdentity\'],\'root-native-identity-join\')\n    full=value[\'fullAclObservations\'];expected_paths=[p[\'path\'] for p in directories+files]\n    need(type(full) is list and len(full)==13 and [r[\'path\'] for r in full]==expected_paths,\'full-acl-observation-paths\')\n    for row in full:\n        s=row[\'security\'];need(type(s) is dict and set(s)=={\'ownerSid\',\'sddl\'} and type(s[\'ownerSid\']) is str\n                             and type(s[\'sddl\']) is str and 1<=len(s[\'sddl\'])<=4096,\'full-acl-observation-schema\')\n    for a in expected_input[\'assets\']:\n        for path,acl in ((a[\'root\'],a[\'rootAcl\']),(a[\'path\'],a[\'fileAcl\'])):\n            s=next(row[\'security\'] for row in full if row[\'path\']==path)\n            need(s=={k:acl[k] for k in (\'ownerSid\',\'sddl\')},\'full-acl-endpoint-join\')\n    return value\n'
INTAKE_RENDERER_SHA='1da80ca7e3f778002b3ce0eefebd8eadcb0140aeb471650070c46225d56c3831'
INTAKE_ARGUMENTS_SHA='bc5a8902477be219f0562ca2b031a67a82b61b8a0a871f3c9e385711fbb02005'

EMPTY_SHA=hashlib.sha256(b'').hexdigest()
wire=partial_wire=-1;saved_sources=[];overall_deadline=time.monotonic()+120;original_failure=None;original_guest_pid=None
prefix='initial-system-intake-'+PROBE_ID
initialize_qga_owner(JOINED_CONTEXT['qemu']['pid'])
try:
 chain();instance_intent();closing();HOST_ADMITTED=True;initialize_emitter();pin_qga_source();pin_emitter_source();setup_qga_owner();guard=QGA_GUARD
 initial=observed();require(initial['guestAgentReady']and initial['ordinarySessionObserved']and initial['qemu']==JOINED_CONTEXT['qemu']and initial['swtpm']==JOINED_CONTEXT['swtpm'],'intake_current_host_actor');instance_intent();closing()
 save(prefix+'.intent.json',{'probeId':PROBE_ID,'operationId':INTAKE_INPUT['operationId'],'canonicalEmitterSha256':EMITTER_SHA256,'before':initial,'guestContextSha256':GUEST_CONTEXT_SHA256,'sourceSha256':INTAKE_SOURCE_SHA,'readOnly':True,'productOperation':False,'taskOperation':False})
 require(hashlib.sha256(INTAKE_RENDERER_SOURCE).hexdigest()==INTAKE_RENDERER_SHA and hashlib.sha256(INTAKE_SOURCE).hexdigest()==INTAKE_SOURCE_SHA,'intake_whole_source_binding')
 hold_generated_bytes(prefix+'.decoder.py',INTAKE_RENDERER_SOURCE)
 decoder=types.ModuleType('_initial_system_intake_decoder_'+INTAKE_RENDERER_SHA);decoder.__name__+='_'+str(id(decoder));decoder.__file__=prefix+'.decoder.py'
 require(decoder.__name__not in sys.modules,'intake_decoder_namespace');sys.modules[decoder.__name__]=decoder;exec(compile(INTAKE_RENDERER_SOURCE,decoder.__file__,'exec'),decoder.__dict__,decoder.__dict__)
 require(sys.modules[decoder.__name__]is decoder and decoder.decode_result.__globals__ is decoder.__dict__,'intake_decoder_owner')
 plan,source_sha=build_native_command('intake',INTAKE_SOURCE)
 require(plan['transport']=='saved-source'and hashlib.sha256(json.dumps(plan['arguments'],sort_keys=True,separators=(',',':')).encode()).hexdigest()==INTAKE_ARGUMENTS_SHA,'intake_exact_saved_plan')
 ack=retained_call('guest-exec',plan['arguments'],_deadline=overall_deadline);save(prefix+'.ack.json',ack);require(type(ack)is dict and set(ack)=={'pid'}and exact_int(ack['pid'],1),'intake_ack');original_guest_pid=ack['pid']
 while True:
  terminal=retained_call('guest-exec-status',ack,_deadline=overall_deadline)
  if terminal.get('exited')is True:break
  require(time.monotonic()<overall_deadline,'intake_pending');time.sleep(.1)
 save(prefix+'.terminal.json',terminal);out=base64.b64decode(terminal.get('out-data',''),validate=True);err=base64.b64decode(terminal.get('err-data',''),validate=True)
 require(terminal.get('exited')is True and type(terminal.get('exitcode'))is int and terminal['exitcode']==0 and not err and not terminal.get('out-truncated',False)and not terminal.get('err-truncated',False)and len(out)<=65536,'intake_native_terminal')
 result=decoder.decode_result(emitter_source=EMITTER_SOURCE,plan=plan,stdout=out,guest_context=GUEST_CONTEXT,original_pid=original_guest_pid,expected_input=INTAKE_INPUT)
 generated_sources_closing();guard();finalize_rpc_success();save(prefix+'.result.json',result)
 print(json.dumps({'state':'qualified','probeId':PROBE_ID,'query':'initial-system-intake','result':result,'canonicalEmitterSha256':EMITTER_SHA256,'canonicalQgaSha256':QGA_MODULE_SHA,'sourceClosing':True,'readOnly':True,'productOperation':False,'taskOperation':False},sort_keys=True))
except BaseException as error:
 original_failure=error
 receipt={'state':'unknown','probeId':PROBE_ID,'errorClass':type(error).__name__,'error':str(error),'automaticRetry':False,'retainedHostDescriptors':list(held)+[fd for fd in(wire,partial_wire)if fd>=0],'originalRpc':None if CURRENT_RPC is None else CURRENT_RPC.snapshot(),'originalGuestPid':original_guest_pid,'programParked':True,'automaticMutationResume':False,'readOnly':True,'productOperation':False,'taskOperation':False}
 safe_journal(prefix+'.unknown.json',receipt);safe_report(receipt);park_original(receipt,error)
finally:
 if original_failure is None:
  for fd in(wire,partial_wire):
   if fd>=0:os.close(fd)
  for fd in reversed(held):os.close(fd)
