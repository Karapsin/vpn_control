    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)

    def budget():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError('collection-deadline')
        c.settimeout(min(20, remaining))

    def receive():
        budget()
        return c.recv(1)

    def send(data):
        budget()
        c.sendall(data)
    try:
        budget()
