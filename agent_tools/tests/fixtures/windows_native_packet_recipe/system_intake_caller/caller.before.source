QGA_MODULE_SHA='bf05c8f08c1e5210ba79ffb59186206e80dc13fef057748dab3596df8ab6f022'
QGA_MODULE_ORIGIN='agent_tools/windows_qga_transfer.py@bf05c8f08c1e5210ba79ffb59186206e80dc13fef057748dab3596df8ab6f022'
# Emitted by the canonical QGA owner factory; only delegates to that module.
import sys
import types
HOST_ADMITTED=False
QGA_MODULE=None
QGA_OWNER=None
QGA_MODULE_RECORD=None
CURRENT_RPC=None
REPORTING_FAILURES=[]

def qga_host_journal_guard():
 require(HOST_ADMITTED is True and len(parents)>0,'host_root_not_admitted')
 for fd,parent,name,identity in parents:
  require(structure(os.fstat(fd))==identity and structure(os.lstat('/')if parent is None else os.stat(name,dir_fd=parent,follow_symlinks=False))==identity,'instance_parent_changed')
 instance_intent()

def save(name,value):return QGA_MODULE.write_journal(root,name,value,guard=qga_host_journal_guard)

def initialize_qga_owner(peer_pid):
 global QGA_MODULE,QGA_OWNER,QGA_MODULE_RECORD,REPORTING_FAILURES
 require(type(QGA_MODULE_SOURCE)is bytes and hashlib.sha256(QGA_MODULE_SOURCE).hexdigest()==QGA_MODULE_SHA,'qga_module_source_sha256')
 module=types.ModuleType('_vpn_control_windows_qga_'+QGA_MODULE_SHA);module.__name__+='_'+str(id(module));module.__file__=QGA_MODULE_ORIGIN
 require(module.__name__ not in sys.modules,'qga_module_preexisting');sys.modules[module.__name__]=module
 exec(compile(QGA_MODULE_SOURCE,QGA_MODULE_ORIGIN,'exec'),module.__dict__,module.__dict__)
 require(sys.modules[module.__name__]is module and module.RetainedQgaOwner.__module__==module.__name__ and module.RetainedRpc.__module__==module.__name__ and module.write_journal.__globals__ is module.__dict__,'qga_module_owner')
 QGA_MODULE=module;QGA_OWNER=module.RetainedQgaOwner(root,prefix,peer_pid,qga_host_journal_guard,save,held,-1,-1);REPORTING_FAILURES=QGA_OWNER.reporting_failures
 QGA_MODULE_RECORD={'sha256':QGA_MODULE_SHA,'bytes':len(QGA_MODULE_SOURCE),'origin':QGA_MODULE_ORIGIN,'moduleName':module.__name__,'registered':True,'completeNamespaceExecuted':True,'peerPid':peer_pid}
 return QGA_MODULE_RECORD

def pin_qga_source():
 require(hold_generated_bytes(prefix+'.canonical-qga.py',QGA_MODULE_SOURCE)==QGA_MODULE_SHA,'qga_module_held_sha256');save(prefix+'.canonical-qga.json',QGA_MODULE_RECORD)

def setup_qga_owner(extra_guard=None):
 global wire,partial_wire,QGA_GUARD
 qga_host_journal_guard();require(QGA_OWNER is not None and QGA_OWNER.current is None and not QGA_OWNER.captures_bound,'qga_owner_setup')
 row=read('qemu-started.json');require(row['pid']==QGA_OWNER.peer_pid,'qga_owner_peer_scope');process(row);owns(row['pid'],root/'qga.sock',True);named=os.lstat(root/'qga.sock')
 def guard():
  process(row);require(os.lstat(root/'qga.sock').st_ino==named.st_ino,'qga_owner_socket_changed');instance_intent();closing()
  if extra_guard is not None:extra_guard()
 QGA_GUARD=guard
 wire=os.open(root/(prefix+'.wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
 partial_wire=os.open(root/(prefix+'.partial-wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
 QGA_OWNER.bind_captures(wire,partial_wire,guard=guard)

def retained_call(command,args,_deadline):
 global CURRENT_RPC
 try:return QGA_OWNER.call(command,args,_deadline)
 finally:CURRENT_RPC=QGA_OWNER.current

def call(sock,command,args,_deadline=None):
 require(str(sock)==str(root/'qga.sock'),'qga_owner_socket_scope')
 return retained_call(command,args,overall_deadline if _deadline is None else _deadline)

def finalize_rpc_success():return QGA_OWNER.finalize_known()
def safe_journal(name,value):return QGA_OWNER.safe_journal(name,value)
def safe_report(value):return QGA_OWNER.safe_report(value)
def park_original(receipt,error):return QGA_OWNER.park_original(receipt,error)

def guest_state(pid):
 require(type(pid)is int and pid==QGA_OWNER.peer_pid,'qga_owner_observation_peer')
 require(retained_call('guest-ping',{},overall_deadline)=={},'qga_owner_ping')
 osinfo=retained_call('guest-get-osinfo',{},overall_deadline);require(type(osinfo)is dict,'qga_owner_osinfo')
 name=osinfo.get('pretty-name')or osinfo.get('name');name=name if type(name)is str and 0<len(name)<=256 and not any(ord(c)<32 for c in name)else None
 users=retained_call('guest-get-users',{},overall_deadline);require(type(users)is list and len(users)<=128,'qga_owner_users')
 ordinary=any(type(user)is dict and type(user.get('user'))is str and user['user'].rsplit('\\',1)[-1].casefold()==SETUP['user'].casefold()for user in users)
 return {'guestAgentReady':True,'ordinarySessionObserved':ordinary,'osName':name}

def exact_int(value,minimum=0):return type(value)is int and value>=minimum
def held_hash(fd,length):
 os.lseek(fd,0,os.SEEK_SET);h=hashlib.sha256();total=0
 while True:
  data=os.read(fd,262144)
