y) -cne $a.rootIdentity){throw \'IN_ROOT_ID\'}\nCheck-AssetAcl (Read-ArtifactAcl $a.root $true) $a.rootAcl\n$p=@{directory=$false;stream=[OrdinaryNativeFacts]::OpenHeld($a.path);asset=$a};$pins.Add($p);$files.Add($p)\n$id=[OrdinaryNativeFacts]::Identity($p.stream.SafeFileHandle,$false);$sec=[OrdinaryNativeFacts]::Security($p.stream.SafeFileHandle)\nif((Id2 $id) -cne $a.fileIdentity -or [uint64]$id.sizeBytes -ne [uint64]$a.bytes -or $p.stream.Length -ne $a.bytes){throw \'IN_FILE_ID_SIZE\'}\n$p.record=[pscustomobject]@{path=$a.path;sha256=$a.sha256;nativeIdentity=($id|ConvertTo-Json -Compress|ConvertFrom-Json);security=[pscustomobject]@{ownerSid=$sec[0];sddl=$sec[1]}}\n$p.fullAcl=Read-Acl $a.path;Check-AssetAcl (Read-ArtifactAcl $a.path $false) $a.fileAcl;Assert-Pin $p\n}\nforeach($name in $m.systemFiles){\n$p=@{directory=$false;stream=[OrdinaryNativeFacts]::OpenHeld($name);asset=$null};$pins.Add($p);$files.Add($p)\n$id=[OrdinaryNativeFacts]::Identity($p.stream.SafeFileHandle,$false);$sec=[OrdinaryNativeFacts]::Security($p.stream.SafeFileHandle)\n$p.record=[pscustomobject]@{path=$name;sha256=$null;nativeIdentity=($id|ConvertTo-Json -Compress|ConvertFrom-Json);security=[pscustomobject]@{ownerSid=$sec[0];sddl=$sec[1]}}\n$p.fullAcl=Read-Acl $name;Assert-Pin $p\n$p.record.sha256=Read-Hash $p\n}\nCheck-Context\nforeach($p in $files){\n[void](Get-PinHash $p);Check-Context\n$sig=$null;if($null -ne $p.asset){$sig=Read-Sig $p.record.path}\n[void](Get-PinHash $p);Check-Context\nif($null -eq $p.asset){continue}\n$a=$p.asset;Check-AssetAcl (Read-ArtifactAcl $a.root $true) $a.rootAcl;Check-AssetAcl (Read-ArtifactAcl $a.path $false) $a.fileAcl\n$rows.Add([ordered]@{key=$a.key;transferId=$a.transferId;rootPath=$a.root;filePath=$a.path;rootIdentity=$a.rootIdentity;fileIdentity=$a.fileIdentity;rootAcl=$a.rootAcl;fileAcl=$a.fileAcl;endpointReceiptSha256=$a.endpointReceiptSha256;transferReceiptSha256=$a.transferReceiptSha256;signature=$sig;heldPhysicalRead=$true;identityClosing=$true;namedIdentityClosing=$true;aclClosing=$true})\n}\nCheck-Context\n$r=[ordered]@{schemaVersion=1;state=\'initial-system-observed\';operationId=$m.operationId;route=$m.route;systemToken=@($token);kernelBootIdentifier=$boot;directoryPins=@($dirs.ToArray());filePins=@($files|ForEach-Object {$_.record});assetObservations=@($rows.ToArray());fullAclObservations=@($pins|ForEach-Object {[ordered]@{path=$_.record.path;security=$_.fullAcl}});pinSecuritySections=5;tokenClosing=$true;kernelBootClosing=$true;allHeldAndNamedPinsClosing=$true;allFullAclClosing=$true;nativeAdmissionComplete=$false;signerAdmissionComplete=$false;productInstalled=$false;productOperation=$false;taskOperation=$false}\nif(([Text.Encoding]::UTF8.GetByteCount(($r|ConvertTo-Json -Depth 8 -Compress))+[Text.Encoding]::UTF8.GetByteCount([Environment]::NewLine)) -gt 32768){throw \'IN_OUTPUT\'}\n\n$bootstrapClosing=Read-ProgramBootstrap;$tokenIdentity=[Security.Principal.WindowsIdentity]::GetCurrent();try{$tokenClosing=[VpnArtifactToken]::Read($tokenIdentity.Token)}finally{$tokenIdentity.Dispose()};$bootstrapClosing.tokenElevation=$tokenClosing[0];$bootstrapClosing.tokenElevationType=$tokenClosing[1]\nif($bootstrapClosing.pid -ne $bootstrapOpening.pid -or $bootstrapClosing.birthFileTimeUtc -cne $bootstrapOpening.birthFileTimeUtc -or $bootstrapClosing.sessionId -ne $bootstrapOpening.sessionId -or $bootstrapClosing.path -cne $bootstrapOpening.path -or $bootstrapClosing.principalSid -cne \'S-1-5-18\' -or $bootstrapClosing.tokenElevation -ne 1 -or $bootstrapClosing.tokenElevationType -ne $bootstrapOpening.tokenElevationType -or -not $bootstrapClosing.is64BitProcess -or $bootstrapClosing.powerShellMajor -ne 5 -or $bootstrapClosing.powerShellEdition -cne \'Desktop\' -or $bootstrapClosing.boot.lastBootUpTimeFileTimeUtc -cne $expectedBoot -or $bootstrapClosing.boot.machineGuid -cne $expectedMachine -or $bootstrapClosing.boot.hardwareUuid -cne $expectedHardware){throw \'BOOTSTRAP_ACTOR_OR_BOOT_CLOSING\'}\n$r.bootstrapOpening=$bootstrapOpening;$r.bootstrapClosing=$bootstrapClosing;$r.guestBootClosing=$true;$r.bootstrapActorClosing=$true\n[pscustomobject]$r\n}finally{\nforeach($p in $pins){if($p.directory){$p.handle.Dispose()}else{$p.stream.Dispose()}}\n}\n'
