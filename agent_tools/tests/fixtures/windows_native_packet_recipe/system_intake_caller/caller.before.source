                x = receive()
                received.extend(x)
                if x == b'\n':
                    os.write(wire, bytes(raw) + b'\n')
                    os.fsync(wire)
                    return json.loads(raw)
                if not x:
                    raise ValueError()
                raw.extend(x)
            raise ValueError()
        if line().get('return') != sid:
            raise ValueError()
        send(json.dumps({'execute': command, 'arguments': args}, separators=(',', ':')).encode() + b'\n')
        result = line()
        if 'return' not in result:
            raise ValueError()
        return result['return']
    except BaseException as error:
        primary = error
        raise
    finally:
        try:
            os.write(partial_wire, bytes(received))
            os.fsync(partial_wire)
        except OSError as error:
            if primary is None:
                raise
            primary.readonlyQgaCaptureFailure = {'stage': 'raw_capture', 'errorClass': type(error).__name__, 'errno': error.errno}
        finally:
            c.close()

