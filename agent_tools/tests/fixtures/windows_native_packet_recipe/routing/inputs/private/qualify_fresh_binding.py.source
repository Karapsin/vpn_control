"""PRIVATE whole generated namespace, real retained owner, inert in-memory wire.

No network/Unix sockets/SSH/QMP/VM/guest or native backend is executed. Actual
canonical retained QGA code writes genuine owned local journal/capture files.
"""
import ast,base64,copy,hashlib,importlib.util,io,json,os,re,stat,struct,sys,tempfile,types,unittest
from pathlib import Path
from unittest.mock import patch

BASE=Path(__file__).resolve().parent
ROOT=BASE.parents[3]
sys.path.insert(0,str(ROOT))
spec=importlib.util.spec_from_file_location('uac_candidate_inert',BASE/'qualify_inert.py')
inert=importlib.util.module_from_spec(spec);sys.modules[spec.name]=inert;spec.loader.exec_module(inert)
M=inert.MODULE
from agent_tools.tests.test_windows_vm_guest import GuestQualificationTests

class ParkObserved(BaseException):pass

class FreshBindingTests(unittest.TestCase):
    def setUp(self):
        self.temp=tempfile.TemporaryDirectory(prefix='uac-private-binding-',dir=BASE)
        self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name).resolve()
        self.fixture=GuestQualificationTests();self.fixture.setUp();self.addCleanup(self.fixture.doCleanups)
        self.value=copy.deepcopy(self.fixture.result)
        self.value['user']['name']=M.SETUP['user'];self.value['administrator']['name']=M.SETUP['administrator']
        self.value['os']['bootTime']='2026-10-19T06:35:06.5000001Z'
        opening=['134368653275038175','C:\\Windows\\explorer.exe',self.value['administrator']['sid'],'0','3','True','False','True','2']
        self.value['visualSession']={'activeConsoleSession':2,'closingConsoleSession':2,'administratorProfile':'C:\\Users\\'+M.SETUP['administrator'],'explorerPid':5788,'opening':opening,'closing':list(opening),'bootFileTimeUtc':'134368653065000001'}
        self.value['nonce']='11111111-1111-4111-8111-111111111111'
        self.binding=M._visual_session(self.value,self.value['nonce'],M.SETUP)
        self.calls=[];self.peers=[];self.break_receive=False;self.stderr=b'';self.change_session=False
        case=self
        class Peer:
            def __init__(self,*args):self.buffer=bytearray();self.closed=False;case.peers.append(self)
            def settimeout(self,value):pass
            def connect(self,path):self.path=path
            def getsockopt(self,*args):return struct.pack('3i',M.CONFIG['qemu']['pid'],os.geteuid(),0)
            def send(self,data):
                if data.startswith(b'\xff'):
                    self.buffer.extend(b'\xff'+json.dumps({'return':json.loads(data[1:])['arguments']['id']}).encode()+b'\n')
                else:
                    request=json.loads(data);command=request['execute'];case.calls.append(request)
                    if command=='guest-exec':
                        source=base64.b64decode(request['arguments']['arg'][-1]).decode('utf-16le')
                        case.operation=re.search(r"\$OperationId='([0-9a-f-]+)'",source)[1]
                        result={'pid':5678}
                    else:
                        assert command=='guest-exec-status'
                        value=copy.deepcopy(case.value);value['nonce']=case.operation
                        if case.change_session:value['visualSession']['explorerPid']+=1
                        result={'exited':True,'exitcode':0,'out-data':base64.b64encode(json.dumps(value).encode()).decode(),'err-data':base64.b64encode(case.stderr).decode()}
                    self.buffer.extend(json.dumps({'return':result}).encode()+b'\n')
                return len(data)
            def recv(self,size):
                if case.break_receive:raise OSError('controlled-original-wire-error')
                data=bytes(self.buffer[:size]);del self.buffer[:size];return data
            def close(self):self.closed=True
        self.qualifier=M.RetainedVisualQualifier()
        self.guard_count=0
        def guard():self.guard_count+=1
        self.backend=types.SimpleNamespace(config=M.CONFIG,visual_binding=self.binding,guard=guard)
        self.qualifier.bind(self.backend)
        self.patches=[patch.object(M,'root',self.root),patch.object(M,'read',return_value=M.CONFIG['qemu']),
            patch.object(M,'process',lambda row:row['pid']),patch.object(M,'owns',lambda *args:None)]
        # A local file is the declared inert socket-generation input; no real socket opens.
        (self.root/'qga.sock').write_bytes(b'inert-socket-generation')
        api=types.SimpleNamespace(AF_UNIX=1,SOCK_STREAM=1,SOL_SOCKET=1,SO_PEERCRED=17,socket=Peer)
        self.patches.append(patch.object(self.qualifier.module,'socket',api))
        for item in self.patches:item.start();self.addCleanup(item.stop)
        self.addCleanup(self.close_owned_inert_descriptors)

    def close_owned_inert_descriptors(self):
        # Explicit test-only cleanup after tracing a parked inert peer. Never native.
        for query in self.qualifier.queries:
            current=query['owner'].current
            if current is not None and current.client is not None:current.client.close()
            for fd in list(query['heldFds']):
                try:os.close(fd)
                except OSError:pass
                query['heldFds'].remove(fd)

    def until_original_park(self):
        function=self.qualifier.module.RetainedQgaOwner.park_original
        tree=ast.parse(M.QGA_MODULE_SOURCE)
        node=next(n for n in ast.walk(tree) if isinstance(n,ast.FunctionDef)and n.name=='park_original')
        loop=next(n for n in ast.walk(node)if isinstance(n,ast.While))
        old=sys.gettrace()
        def trace(frame,event,arg):
            if frame.f_code is function.__code__ and event=='line' and frame.f_lineno==loop.lineno:
                raise ParkObserved()
            return trace
        try:
            sys.settrace(trace)
            with self.assertRaises(ParkObserved),patch.object(self.qualifier.module.sys,'stdout',io.StringIO()):
                self.qualifier()
        finally:sys.settrace(old)

    def test_actual_registered_whole_module_and_query_source_pins(self):
        self.assertEqual('bf05c8f08c1e5210ba79ffb59186206e80dc13fef057748dab3596df8ab6f022',M.QGA_MODULE_SHA)
        self.assertEqual(hashlib.sha256(M.QGA_MODULE_SOURCE).hexdigest(),M.QGA_MODULE_SHA)
        self.assertIs(sys.modules[self.qualifier.module.__name__],self.qualifier.module)
        self.assertIs(self.qualifier.module.RetainedRpc.run.__globals__,self.qualifier.module.__dict__)
        self.assertIn("$ProgressPreference='SilentlyContinue'",M.VISUAL_QUERY_TEMPLATE)
        self.assertTrue(any(path.endswith('/fresh_visual_qualification.py')for path in M.CONFIG['sourcePins']))

    def test_same_binding_requires_actual_fresh_ack_and_terminal_and_known_closure(self):
        result=self.qualifier()
        self.assertEqual(self.binding,result)
        self.assertEqual(['guest-exec','guest-exec-status'],[row['execute']for row in self.calls])
        query=self.qualifier.queries[0]
        self.assertTrue(query['closed']);self.assertTrue(query['owner'].finalized)
        self.assertEqual([],query['heldFds']);self.assertTrue(all(peer.closed for peer in self.peers))
        self.assertIs(type(result['bootFileTimeUtc']),str)
        self.assertEqual('134368653065000001',result['bootFileTimeUtc'])
        receipts=list(self.root.glob('*.known.json'));self.assertGreaterEqual(len(receipts),3)
        self.assertTrue(all(stat.S_IMODE(path.stat().st_mode)==0o600 for path in self.root.iterdir()if path.name!='qga.sock'))

    def test_saved_binding_does_not_replace_new_current_queries(self):
        self.qualifier();self.qualifier()
        self.assertEqual(4,len(self.calls))
        self.assertEqual(2,len({q['operationId']for q in self.qualifier.queries}))
        self.assertTrue(all(q['closed']for q in self.qualifier.queries))

    def test_changed_current_session_parks_original_before_input(self):
        self.change_session=True;self.until_original_park()
        query=self.qualifier.queries[0]
        self.assertEqual('current_native_visual_session_changed',str(query['originalError']))
        self.assertTrue(query['owner'].parked)
        self.assertEqual(['guest-exec','guest-exec-status'],[row['execute']for row in self.calls])
        self.assertTrue(query['heldFds'])
        with self.assertRaisesRegex(ValueError,'fresh_visual_qualifier_not_actionable'):self.qualifier()
        self.assertEqual(2,len(self.calls))

    def test_original_wire_error_retains_rpc_and_prevents_replay(self):
        self.break_receive=True;self.until_original_park()
        query=self.qualifier.queries[0];rpc=query['owner'].current
        self.assertIsNotNone(rpc);self.assertTrue(rpc.unknown)
        self.assertFalse(rpc.closed);self.assertTrue(query['heldFds'])
        self.assertFalse(rpc.client.closed)
        count=len(self.peers)
        with self.assertRaisesRegex(ValueError,'fresh_visual_qualifier_not_actionable'):self.qualifier()
        self.assertEqual(count,len(self.peers))

    def test_nonempty_stderr_preserves_original_terminal_and_refuses_binding(self):
        self.stderr=b'controlled-original-stderr';self.until_original_park()
        query=self.qualifier.queries[0]
        self.assertIsNotNone(query['terminal'])
        self.assertEqual('fresh_visual_query_output',str(query['originalError']))
        terminal=json.loads((self.root/(query['prefix']+'.terminal.json')).read_bytes())
        self.assertEqual(self.stderr,base64.b64decode(terminal['err-data']))
        self.assertNotIn('closed',query)

    def test_bind_is_single_use(self):
        with self.assertRaisesRegex(ValueError,'fresh_visual_qualifier_already_bound'):self.qualifier.bind(self.backend)

if __name__=='__main__':unittest.main(verbosity=2)
