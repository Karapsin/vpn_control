EXPECTED_NONCE=8220859838733921813

# Host-only observation. No socket, subprocess, QGA, QMP, signal or cleanup call.
MAX_FILE=65536
MAX_TOTAL=131072
MAX_WIRE=4*1024*1024
all_files={};file_holds=[];absent=[];bytes_retained=0;actor=None;deadline=time.monotonic()+45
def budget():require(time.monotonic()<deadline,'collector_read_deadline')
result={'schemaVersion':1,'state':'preparing','probeId':COLLECTOR_ID,'originalPrefix':ORIGINAL_PREFIX,'originalProbeId':ORIGINAL_PROBE_ID,'canonicalEmitterSha256':EMITTER_SHA256,'canonicalQgaSha256':QGA_SHA256,'hostReadOnly':True,'guestQueries':False,'newSocketOperations':False,'signals':False,'originalHandleClose':False,'productOperation':False,'taskOperation':False,'files':all_files}

def hold_exact_root():
 parent=parents[-1][0];fd=os.open(root.name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent);held.append(fd);info=os.fstat(fd)
 require(stat.S_ISDIR(info.st_mode)and info.st_uid==os.geteuid()and stat.S_IMODE(info.st_mode)==0o700,'collector_root_private')
 identity=structure(info);require(structure(os.stat(root.name,dir_fd=parent,follow_symlinks=False))==identity,'collector_root_named_held')
 parents.append((fd,parent,root.name,identity));result['rootStructureOpening']=list(identity);return fd,identity

def bounded_proc(path,limit):
 with open(path,'rb')as stream:raw=stream.read(limit+1)
 require(len(raw)<=limit,'collector_proc_bound');return raw

def prefix_names():
 return sorted(EXPECTED_NAMES)

def collect_file(name):
 global bytes_retained
 budget()
 path=root/name
 try:before=os.lstat(path)
 except FileNotFoundError:
  all_files[name]={'state':'absent','path':str(path)};absent.append(name);return
 require(stat.S_ISREG(before.st_mode)and before.st_uid==os.geteuid()and stat.S_IMODE(before.st_mode)==0o600 and before.st_nlink==1,'collector_file_private')
 require(0<=before.st_size<=MAX_FILE and bytes_retained+before.st_size<=MAX_TOTAL,'collector_file_or_aggregate_bound')
 fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);held.append(fd);opening=generation(os.fstat(fd));require(opening==generation(before),'collector_named_held_opening')
 chunks=[];size=0;h=hashlib.sha256()
 while True:
  chunk=os.read(fd,min(65536,MAX_FILE+1-size))
  if not chunk:break
  size+=len(chunk);require(size<=MAX_FILE and bytes_retained+size<=MAX_TOTAL,'collector_read_bound');chunks.append(chunk);h.update(chunk)
 require(size==opening[6]and generation(os.fstat(fd))==opening and generation(os.lstat(path))==opening,'collector_file_changed_during_read')
 raw=b''.join(chunks);bytes_retained+=size;digest=h.hexdigest();file_holds.append((fd,path,opening,digest,size));pins.append((fd,path,opening))
 if name in EXACT_PINS:
  wanted=EXACT_PINS[name];require(size==wanted['bytes']and digest==wanted['sha256'],'collector_exact_original_bytes')
  if 'generation'in wanted:require(list(opening)==wanted['generation'],'collector_original_generation_pin')
 all_files[name]={'state':'complete','path':str(path),'bytes':size,'openingGeneration':list(opening),'openingSha256':digest,'base64':base64.b64encode(raw).decode(),'namedHeldOpening':True}

def files_closing():
 for fd,path,opening,digest,length in file_holds:
  budget()
  require(generation(os.fstat(fd))==opening and generation(os.lstat(path))==opening,'collector_file_generation_closing')
  os.lseek(fd,0,os.SEEK_SET);h=hashlib.sha256();size=0
  while True:
   chunk=os.read(fd,min(65536,MAX_FILE+1-size))
   if not chunk:break
   size+=len(chunk);require(size<=MAX_FILE,'collector_closing_bound');h.update(chunk)
  require(size==length and h.hexdigest()==digest and generation(os.fstat(fd))==opening and generation(os.lstat(path))==opening,'collector_file_hash_closing')
  all_files[path.name].update(closingGeneration=list(opening),closingSha256=h.hexdigest(),namedHeldClosing=True)
 for name in absent:
  try:os.lstat(root/name)
  except FileNotFoundError:all_files[name]['closingAbsent']=True
  else:raise ValueError('collector_absence_changed')
 closing()

def file_bytes(suffix,required=True):
 name=ORIGINAL_PREFIX+suffix;row=all_files.get(name)
 if row is None or row.get('state')!='complete':
  require(not required,'collector_required_original_file_absent');return None
 return base64.b64decode(row['base64'],validate=True)

def historical_wire_join():
 qga=file_bytes('.canonical-qga.py');emitter=file_bytes('.canonical-emitter.py')
 require(hashlib.sha256(qga).hexdigest()==QGA_SHA256 and hashlib.sha256(emitter).hexdigest()==EMITTER_SHA256,'collector_original_canonical_source_hash')
 raw=file_bytes('.rpc-000083.raw');request=file_bytes('.rpc-000083.request.json');intent=json.loads(file_bytes('.rpc-000083.intent.json'))
 require(type(intent)is dict and intent.get('sequence')==83 and type(intent.get('nonce'))is int and intent['nonce']==EXPECTED_NONCE and intent.get('requestPath')==str(root/(ORIGINAL_PREFIX+'.rpc-000083.request.json'))and intent.get('rawPath')==str(root/(ORIGINAL_PREFIX+'.rpc-000083.raw'))and intent.get('requestBytes')==len(request)and intent.get('requestSha256')==hashlib.sha256(request).hexdigest(),'collector_original_rpc_intent_join')
 parsed=json.loads(request);require(type(parsed)is dict and parsed.get('execute')==intent.get('command')=='guest-exec','collector_original_rpc_command_join')
 matches=0;after_sync=[]
 for line in raw.splitlines(keepends=True):
  marker=line.rfind(b'\xff')
  if marker>=0:
   try:value=json.loads(line[marker+1:])
   except(ValueError,UnicodeDecodeError):continue
   if type(value)is dict and set(value)=={'return'}and type(value['return'])is int and value['return']==intent['nonce']:matches+=1
  elif matches:
   after_sync.append(json.loads(line))
 require(matches==1,'collector_original_sync_nonce_join')
 require(after_sync==[{'error':{'class':'GenericError','desc':'Failed to execute helper program (Invalid argument)'}}],'collector_original_error_reply_join')
 return {'canonicalSourceSha256':QGA_SHA256,'canonicalOpenChecksPeerCredentialsBeforeSync':True,'knownQemuPid':QEMU_EXPECTED['pid'],'knownQemuStartTicks':QEMU_EXPECTED['startTicks'],'rpcSequence':83,'command':'guest-exec','requestSha256':hashlib.sha256(request).hexdigest(),'rawSha256':hashlib.sha256(raw).hexdigest(),'rawBytes':len(raw),'nonce':intent['nonce'],'matchingDelimitedSyncReplies':matches,'afterSyncReply':after_sync[0],'originalRpcOutcome':'UNKNOWN','guestChildAbsenceClaimed':False,'guestReplayAllowed':False,'meaning':'Historical complete bf05 source/intent/nonce/raw causal join only; not a fresh socket peer or guest child-state query.'}

def fd_metadata(pid,number,expected_link=None):
 path='/proc/'+str(pid)+'/fd/'+number;before=os.readlink(path)
 if expected_link is not None:require(before==expected_link,'collector_actor_fd_link_changed')
 info=os.stat(path);after=os.readlink(path);require(before==after,'collector_actor_fd_link_changed')
 return {'fd':int(number),'link':before,'targetGeneration':list(generation(info))}

def process_link_metadata(pid,leaf):
 path='/proc/'+str(pid)+'/'+leaf;before=os.readlink(path);info=os.stat(path);after=os.readlink(path);require(before==after,'collector_actor_metadata_link_changed')
 return {'link':before,'targetGeneration':list(generation(info))}

def process_namespace_root(pid):
 base='/proc/'+str(pid);names=os.listdir(base+'/ns');require(0<len(names)<=32 and all(type(name)is str and re.fullmatch('[a-z_]+',name)for name in names),'collector_namespace_bound')
 return {'namespaces':{name:process_link_metadata(pid,'ns/'+name)for name in sorted(names)},'processRoot':process_link_metadata(pid,'root')}

def actor_snapshot(pid,required_paths):
 base='/proc/'+str(pid);require(os.stat(base).st_uid==os.geteuid(),'collector_actor_uid')
 start=birth(pid);cmd=bounded_proc(base+'/cmdline',1024*1024);status=bounded_proc(base+'/status',65536);exe=os.readlink(base+'/exe');exestat=generation(os.stat(base+'/exe'));argv=cmd.rstrip(b'\0').split(b'\0')
 require(cmd.endswith(b'\0')and argv and all(b'\0'not in x for x in argv),'collector_actor_cmdline');require(re.fullmatch(r'python3(?:\.[0-9]+)?',pathlib.PurePosixPath(exe).name)is not None,'collector_actor_python')
 uid_line=[line for line in status.splitlines()if line.startswith(b'Uid:')];require(len(uid_line)==1 and [int(x)for x in uid_line[0].split()[1:]]==[os.geteuid()]*4,'collector_actor_uid_status')
 numbers=os.listdir(base+'/fd');require(len(numbers)<=8192,'collector_actor_fd_bound');selected={};sockets=[]
 for number in sorted(numbers,key=lambda x:int(x)if x.isdecimal()else-1):
  if not number.isdecimal():continue
  try:link=os.readlink(base+'/fd/'+number)
  except FileNotFoundError:continue
  if link in required_paths:
   metadata=fd_metadata(pid,number,link);require(metadata['targetGeneration']==all_files[pathlib.Path(link).name]['openingGeneration'],'collector_actor_original_fd_identity');selected.setdefault(link,[]).append(metadata)
  elif re.fullmatch(r'socket:\[[0-9]+\]',link):sockets.append(fd_metadata(pid,number,link))
 require(set(selected)==set(required_paths)and sockets,'collector_actor_exact_fd_scope')
 metadata=process_namespace_root(pid)
 require(birth(pid)==start and os.stat(base).st_uid==os.geteuid()and os.readlink(base+'/exe')==exe and generation(os.stat(base+'/exe'))==exestat and bounded_proc(base+'/cmdline',1024*1024)==cmd,'collector_actor_opening_identity')
 return {'pid':pid,'uid':os.geteuid(),'startTicks':start,'exe':exe,'executableGeneration':list(exestat),'cmdlineBase64':base64.b64encode(cmd).decode(),'cmdlineSha256':hashlib.sha256(cmd).hexdigest(),'argvBytesBase64':[base64.b64encode(x).decode()for x in argv],'statusBase64':base64.b64encode(status).decode(),'requiredSourceAndRequestFds':selected,'socketFds':sockets,**metadata}

def stable_actor_identity(value):
 keys=('pid','uid','startTicks','exe','executableGeneration','cmdlineBase64','cmdlineSha256','argvBytesBase64','requiredSourceAndRequestFds','socketFds','namespaces','processRoot')
 return {key:value[key]for key in keys}

def stable_projection_paths(opening,closing):
 # Reporting only: paths into the unchanged stable projections, in deterministic order.
 paths=[]
 def compare(left,right,path):
  if left==right:return
  if type(left)is dict and type(right)is dict:
   for key in sorted(set(left)|set(right)):
    if key not in left or key not in right:paths.append(path+[key])
    else:compare(left[key],right[key],path+[key])
  elif type(left)is list and type(right)is list:
   for index in range(max(len(left),len(right))):
    if index>=len(left)or index>=len(right):paths.append(path+[index])
    else:compare(left[index],right[index],path+[index])
  else:paths.append(path)
 compare(opening,closing,[]);return paths

def discover_actor():
 required_paths={str(root/(ORIGINAL_PREFIX+s))for s in('.rpc-000083.request.json','.rpc-000083.raw','.canonical-qga.py','.canonical-emitter.py')}
 entries=os.listdir('/proc');require(len(entries)<=131072,'collector_proc_entry_bound');candidates=[];scan={'sameUidProcesses':0,'racedOrUnreadableProcesses':0}
 for name in sorted(entries):
  budget()
  if not name.isdecimal()or int(name)<=0 or int(name)in(QEMU_EXPECTED['pid'],os.getpid()):continue
  base='/proc/'+name
  try:
   if os.stat(base).st_uid!=os.geteuid():continue
   scan['sameUidProcesses']+=1;numbers=os.listdir(base+'/fd');require(len(numbers)<=8192,'collector_scan_fd_bound');seen=set();has_socket=False
   for number in numbers:
    if not number.isdecimal():continue
    try:link=os.readlink(base+'/fd/'+number)
    except FileNotFoundError:continue
    if link in required_paths:seen.add(link)
    if re.fullmatch(r'socket:\[[0-9]+\]',link):has_socket=True
   if seen==required_paths and has_socket:candidates.append(actor_snapshot(int(name),required_paths))
  except(FileNotFoundError,PermissionError,ProcessLookupError):scan['racedOrUnreadableProcesses']+=1
 result['actorScan']=scan;result['actorCandidateCount']=len(candidates);result['candidateIdentities']=[{'pid':x['pid'],'startTicks':x['startTicks']}for x in candidates]
 require(len(candidates)==1,'collector_actor_not_unique');return candidates[0],required_paths

try:
 chain();root_fd,root_identity=hold_exact_root();instance_intent();closing();qemu=read('qemu-started.json');require(qemu['pid']==QEMU_EXPECTED['pid']and qemu['startTicks']==QEMU_EXPECTED['startTicks'],'collector_qemu_scope');process(qemu);owns(qemu['pid'],root/'qga.sock',True)
 opening_names=prefix_names();result['selectedFileNames']=opening_names;result['prefixInventoryObserved']=False;result['rootListenerProcNetUnixGuard']=True
 for name in sorted(set(opening_names)|set(EXPECTED_NAMES)):collect_file(name)
 result['historicalWireJoin']=historical_wire_join()
 actor,required_paths=discover_actor();result['actorOpening']=actor
 result['socketObservation']={'currentPeerRelation':'not-observed-by-readonly-proc-metadata','anonymousSocketIsNotFreshQgaPeerProof':True,'newProtocolQueries':False,'socketPayloadRead':False}
 actor_closing=actor_snapshot(actor['pid'],required_paths);result['actorClosing']=actor_closing
 result['actorStableProjectionDiff']=stable_projection_paths(stable_actor_identity(actor),stable_actor_identity(actor_closing))
 require(stable_actor_identity(actor_closing)==stable_actor_identity(actor),'collector_actor_closing_changed')
 files_closing();process(qemu);owns(qemu['pid'],root/'qga.sock',True);closing()
 result['rootStructureClosing']=list(structure(os.fstat(root_fd)));require(result['rootStructureClosing']==list(root_identity),'collector_root_closing');result['rootNamedHeldClosing']=True
 result.update(state='qualified',sourceClosing=True,allFileBytesComplete=True,allFileBytesReadAndHashesComplete=True,originalFileBytePayloadEmitted=False,aggregateFileBytes=bytes_retained,canonicalSourceFilesJoined=True,scope='exact-original-rpc83-host-actor-identity',collectorId=COLLECTOR_ID,hostProcessMetadataReadOnly=True,foreignFdContentsRead=False,qgaConnectOrRead=False,guestProgramSubmitted=False)
except BaseException as error:
 result.update(state='refused',errorClass=type(error).__name__,error=str(error),sourceClosing=False,allFileBytesComplete=False,aggregateFileBytes=bytes_retained)
finally:
 for fd in reversed(held):os.close(fd)
for row in all_files.values():row.pop('base64',None)
wire=json.dumps(result,sort_keys=True,ensure_ascii=True).encode()
if len(wire)+1>MAX_WIRE:
 metadata={name:{k:v for k,v in row.items()if k!='base64'}for name,row in all_files.items()}
 result={'schemaVersion':1,'state':'refused','probeId':COLLECTOR_ID,'originalPrefix':ORIGINAL_PREFIX,'canonicalEmitterSha256':EMITTER_SHA256,'canonicalQgaSha256':QGA_SHA256,'hostReadOnly':True,'guestQueries':False,'newSocketOperations':False,'signals':False,'originalHandleClose':False,'sourceClosing':False,'allFileBytesComplete':False,'error':'collector_serialized_output_bound','attemptedOutputBytes':len(wire),'noFileBytePayloadEmitted':True,'completeDiagnosticMetadata':metadata,'originalFilesProcessesAndSocketsUntouched':True}
 wire=json.dumps(result,sort_keys=True,ensure_ascii=True).encode();require(len(wire)+1<=MAX_WIRE,'collector_refusal_output_bound')
print(wire.decode('ascii'))
