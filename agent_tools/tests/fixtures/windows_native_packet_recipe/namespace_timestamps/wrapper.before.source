"""Execute one bounded host-only actor identity metadata request once through normal DIRECT.

Preparation of this caller is not authority to run it before the coordinator's
fresh selected-channel/source window. No retry, signal, timeout reset or cleanup.
"""
from pathlib import Path
import hashlib,json,os,re,stat,sys,time
ROOT=Path('/Users/karapsin_de/projects/vpn_control');sys.path.insert(0,str(ROOT))
from agent_tools import source_module_loader
BASE=Path(__file__).resolve().parent
if len(sys.argv)!=3 or re.fullmatch('[0-9a-f]{64}',sys.argv[2])is None:raise ValueError('reviewed_manifest_sha256_required')
label,manifest_name=sys.argv[1].split('@',1)
if label!='direct-host-rpc83-closing-diagnostic' or not Path(manifest_name).is_absolute():raise ValueError('explicit_absolute_readonly_manifest_required')
manifest_path=Path(manifest_name)
manifest=None;pin=None
out=manifest_path.parent/(label+'-original-operator');out.mkdir(mode=0o700)
held=[]
def generation(s):return(s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
def hold(path,expected,max_bytes=8*1024*1024):
 path=Path(path);fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW);held.append((fd,path,generation(os.fstat(fd))));row=held[-1][2]
 if not stat.S_ISREG(row[2])or row[3]!=os.getuid()or row[5]!=1:raise ValueError('operator_source_identity')
 raw=b''
 while True:
  chunk=os.read(fd,65536)
  if not chunk:break
  raw+=chunk
  if len(raw)>max_bytes:raise ValueError('operator_source_bound')
 if hashlib.sha256(raw).hexdigest()!=expected:raise ValueError('operator_source_hash')
 guard();return raw
def guard():
 for fd,path,row in held:
  if generation(os.fstat(fd))!=row or generation(os.stat(path,follow_symlinks=False))!=row:raise ValueError('operator_source_changed')
def save(name,value):
 raw=value if type(value)is bytes else(json.dumps(value,sort_keys=True,ensure_ascii=False)+'\n').encode();fd=os.open(out/name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
 try:
  at=0
  while at<len(raw):
   count=os.write(fd,raw[at:])
   if count<=0:raise OSError('operator_receipt_write')
   at+=count
  os.fsync(fd)
 finally:os.close(fd)
def stable_projection_paths(opening,closing):
 # Reporting only: paths into the unchanged stable projections, in deterministic order.
 paths=[]
 def compare(left,right,path):
  if left==right:return
  if type(left)is dict and type(right)is dict:
   for key in sorted(set(left)|set(right)):
    if key not in left or key not in right:paths.append(path+[key])
    else:compare(left[key],right[key],path+[key])
  elif type(left)is list and type(right)is list:
   for index in range(max(len(left),len(right))):
    if index>=len(left)or index>=len(right):paths.append(path+[index])
    else:compare(left[index],right[index],path+[index])
  else:paths.append(path)
 compare(opening,closing,[]);return paths

started=False;terminal=None
try:
 manifest=json.loads(hold(manifest_path,sys.argv[2]));hold(Path(__file__).resolve(),manifest['operatorSourceSha256']);pin=next(p for p in manifest['requests']if p['label']==label)
 request=json.loads(hold(pin['requestPath'],pin['requestSha256']));source=hold(pin['sourcePath'],pin['sourceSha256'])
 for source_pin in pin.get('sourcePins',[]):hold(source_pin['path'],source_pin['sha256'])
 if request['program']['source'].encode()!=source or request['operationId']!=pin['operationId']:raise ValueError('operator_request_source_join')
 save('intent.private.json',{'request':request,'requestPin':pin,'collectorId':pin['collectorId'],'sourceHold':[(str(path),list(row))for fd,path,row in held],'sourceClosing':False,'newOperationStartOnce':True,'productOperation':False})
 with source_module_loader.request_scope(ROOT/'agent_tools'):
  owner=source_module_loader.adapter(ROOT/'agent_tools','ssh_program_execution');guard()
  admission=owner.admit_start(ROOT,'archlinux',request);save('admission.json',admission)
  if admission!={'ok':True}:raise ValueError('original_admission_refused')
  save('start-call-intent.json',{'operationId':request['operationId'],'sourceSha256':pin['sourceSha256'],'noReplay':True})
  started=True;initial=owner.start(ROOT,'archlinux',request,source_context=owner._session);save('initial.json',initial)
  identity={'operationId':request['operationId']};deadline=time.monotonic()+180;sequence=0
  while time.monotonic()<deadline:
   guard();value=owner.collect(ROOT,'archlinux',identity);sequence+=1;save('observation-'+str(sequence).zfill(5)+'.json',value)
   if value.get('state')in ('unknown','refused'):raise ValueError('original_operation_'+value['state'])
   if value.get('state')=='terminal':terminal=value;break
   time.sleep(.3)
  if terminal is None:raise TimeoutError('original_operation_observation_pending_no_replay')
  if terminal.get('exitCode')!=0 or terminal.get('capture',{}).get('complete')is not True or terminal['capture'].get('eof')!={'stdout':True,'stderr':True}:raise ValueError('original_outer_terminal_not_success')
  directory=ROOT/'.rag_index/ssh-program-execution'/request['operationId'];stdout=hold(directory/'stdout.private',terminal['streams']['stdout']['retainedSha256'],4*1024*1024);stderr=hold(directory/'stderr.private',terminal['streams']['stderr']['retainedSha256'],65536);save('stdout.private',stdout);save('stderr.private',stderr)
  for name,raw in [('stdout',stdout),('stderr',stderr)]:
   stream=terminal['streams'][name]
   if hashlib.sha256(raw).hexdigest()!=stream['retainedSha256']or hashlib.sha256(raw).hexdigest()!=stream['receivedSha256']or len(raw)!=stream['bytes']or len(raw)!=stream['receivedBytes']:raise ValueError('original_raw_stream_join')
  if stderr:raise ValueError('original_outer_stderr_nonempty')
  result=json.loads(stdout.decode('utf-8-sig'))
  identity_qualified=result.get('state')=='qualified'
  closing_refused=result.get('state')=='refused'and result.get('error')=='collector_actor_closing_changed'
  if result.get('probeId')!=pin['collectorId']or not(identity_qualified or closing_refused):raise ValueError('original_collector_result_not_diagnostic')
  for field,expected_value in {'hostReadOnly':True,'guestQueries':False,'newSocketOperations':False,'signals':False,'originalHandleClose':False,'productOperation':False,'taskOperation':False}.items():
   if result.get(field)is not expected_value:raise ValueError('original_collector_scope')
  if result.get('prefixInventoryObserved')is not False or result.get('rootListenerProcNetUnixGuard')is not True:raise ValueError('original_collector_observation_scope')
  if identity_qualified and(result.get('sourceClosing')is not True or result.get('allFileBytesReadAndHashesComplete')is not True or result.get('collectorId')!=pin['collectorId']or result.get('scope')!='exact-original-rpc83-host-actor-identity'):raise ValueError('original_collector_identity_not_qualified')
  if closing_refused and result.get('sourceClosing')is not False:raise ValueError('original_collector_refusal_source_scope')
  expected=manifest['expectedFiles'];files=result.get('files')
  if type(files)is not dict or set(files)!={Path(wanted['path']).name for wanted in expected}:raise ValueError('original_collector_file_count')
  for wanted in expected:
   item=files[Path(wanted['path']).name]
   if item.get('state')!='complete'or item.get('path')!=wanted['path']or item.get('namedHeldOpening')is not True:raise ValueError('original_collector_file_opening_join')
   if 'bytes'in wanted and(item['bytes']!=wanted['bytes']or item['openingSha256']!=wanted['sha256']):raise ValueError('original_collector_file_join')
   if 'generation'in wanted and item['openingGeneration']!=wanted['generation']:raise ValueError('original_collector_generation_join')
   if identity_qualified and(item.get('namedHeldClosing')is not True or item.get('openingGeneration')!=item.get('closingGeneration')or item.get('openingSha256')!=item.get('closingSha256')):raise ValueError('original_collector_file_closing_join')
  actor=result.get('actorOpening');closing_actor=result.get('actorClosing');keys=('pid','uid','startTicks','exe','executableGeneration','cmdlineBase64','cmdlineSha256','argvBytesBase64','requiredSourceAndRequestFds','socketFds','namespaces','processRoot')
  if type(actor)is not dict or type(closing_actor)is not dict or result.get('actorCandidateCount')!=1:raise ValueError('original_collector_actor_snapshots_missing')
  for snapshot in (actor,closing_actor):
   if snapshot.get('uid')!=1000 or type(snapshot.get('pid'))is not int or snapshot['pid']<=0 or type(snapshot.get('startTicks'))is not int or snapshot['startTicks']<=0:raise ValueError('original_collector_actor_shape')
   import base64
   cmd=base64.b64decode(snapshot['cmdlineBase64'],validate=True)
   if not cmd.endswith(b'\0')or hashlib.sha256(cmd).hexdigest()!=snapshot['cmdlineSha256']or[base64.b64encode(v).decode()for v in cmd.rstrip(b'\0').split(b'\0')]!=snapshot['argvBytesBase64']:raise ValueError('original_collector_cmdline_join')
   required={wanted['path']for wanted in expected if not wanted['path'].endswith('.intent.json')}
   if set(snapshot.get('requiredSourceAndRequestFds',{}))!=required or not snapshot.get('socketFds')or not snapshot.get('namespaces')or type(snapshot.get('processRoot'))is not dict:raise ValueError('original_collector_fd_scope')
   for path,fdrows in snapshot['requiredSourceAndRequestFds'].items():
    if not fdrows or any(row.get('link')!=path or row.get('targetGeneration')!=files[Path(path).name]['openingGeneration']for row in fdrows):raise ValueError('original_collector_fd_generation_join')
  opening_projection={key:actor[key]for key in keys};closing_projection={key:closing_actor[key]for key in keys};diff=stable_projection_paths(opening_projection,closing_projection)
  if result.get('actorStableProjectionDiff')!=diff:raise ValueError('original_collector_projection_diff_join')
  if identity_qualified and(diff or opening_projection!=closing_projection):raise ValueError('original_collector_identity_unstable')
  if closing_refused and(not diff or opening_projection==closing_projection):raise ValueError('original_collector_refusal_without_difference')
  if identity_qualified and(result.get('rootNamedHeldClosing')is not True or result.get('rootStructureOpening')!=result.get('rootStructureClosing')):raise ValueError('original_collector_root_join')
  history=result.get('historicalWireJoin',{})
  if history.get('rpcSequence')!=83 or history.get('nonce')!=8220859838733921813 or history.get('requestSha256')!='8db1bf43f51b325fc620957366af54ff0555696e6c0fd7cd7bfa71963d147c81'or history.get('rawSha256')!='639ec96921964c4e0dc65cfd20603b2ea040de99b5e83792f67c4f156c9bf2f4'or history.get('originalRpcOutcome')!='UNKNOWN'or history.get('guestChildAbsenceClaimed')is not False or history.get('guestReplayAllowed')is not False:raise ValueError('original_collector_historical_join')
  for field,expected in pin.get('resultJoins',{}).items():
   if result.get(field)!=expected:raise ValueError('original_inner_result_extra_source_join')
  terminal_raw=(directory/'terminal.json').read_bytes();hold(directory/'terminal.json',hashlib.sha256(terminal_raw).hexdigest(),131072)
  if json.loads(terminal_raw)!=terminal:raise ValueError('original_terminal_file_join')
  closed_raw=(directory/'owner-closed.json').read_bytes();hold(directory/'owner-closed.json',hashlib.sha256(closed_raw).hexdigest(),131072);closed=json.loads(closed_raw);save('owner-closed.json',closed)
  if closed!={'operationId':request['operationId'],'terminalSha256':hashlib.sha256(terminal_raw).hexdigest(),'sourceClosing':True}:raise ValueError('original_owner_source_not_closed')
  guard();save('diagnostic-capture-qualified.json',{'state':'diagnostic-capture-qualified','label':label,'operationId':request['operationId'],'sourceSha256':pin['sourceSha256'],'collectorId':pin['collectorId'],'terminal':terminal,'innerResult':result,'ownerClosing':closed,'sourceClosing':True,'sourceClosingScope':'new-local-operator-and-upstream-generic-host-program-only','identityQualified':identity_qualified,'innerRefused':closing_refused,'sourceClosingOfActor':result.get('sourceClosing')is True,'actorStableProjectionDiff':diff,'signalAuthorityGranted':False,'productOperation':False})
  print(json.dumps({'state':'diagnostic-capture-qualified','label':label,'operationId':request['operationId'],'exitCode':0,'sourceClosing':True,'identityQualified':identity_qualified,'innerRefused':closing_refused,'sourceClosingOfActor':result.get('sourceClosing')is True,'signalAuthorityGranted':False},sort_keys=True))
except BaseException as error:
 save('original-failure.json',{'state':'unknown'if started else'refused-before-start','errorClass':type(error).__name__,'error':str(error),'operationId':None if pin is None else pin['operationId'],'startedOnce':started,'terminalObserved':terminal is not None,'replayAllowed':False,'automaticCleanup':False})
 raise
finally:
 for fd,path,row in reversed(held):os.close(fd)
