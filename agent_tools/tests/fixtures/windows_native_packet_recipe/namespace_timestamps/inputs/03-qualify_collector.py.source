"""Whole saved collector namespaces against read-only in-memory host peers."""
import argparse
import base64
import builtins
import collections
import contextlib
import hashlib
import io
import json
import os
from pathlib import Path
import re
import stat
import sys
import traceback
import types

HERE=Path(__file__).resolve().parent
sys.path.insert(0,str(HERE.parent/'inert-caller-qualification'))
from harness import PeerWorld,literals

CURRENT_SHA='c9f4e67849e7c019dfb78b9f4e92c87fc37baae04e423306ca86a992b5f73212'
REPO=HERE.parents[3]
CANONICAL={name:(REPO/'agent_tools'/name).read_bytes()for name in ('windows_qga_transfer.py','windows_artifact_transfer.py')}

def digest(data):return hashlib.sha256(data).hexdigest()
def forbidden(*args,**kwargs):raise AssertionError('collector attempted an unqualified side effect')

class CollectorWorld(PeerWorld):
 def __init__(self,declarations,fault=None,drift=True):
  self.declarations=declarations;self.fault=fault;self.drift=drift
  self.original_pid=54321;self.own_pid=33333;self.status_reads=collections.Counter();self.closing_phase=False
  self.fd_targets={};self.metadata_reads=[];self.forbidden_attempts=[]
  super().__init__(declarations,[])
  self.prefix=declarations['ORIGINAL_PREFIX'];self._original_files()
  self._actor(self.original_pid);self._actor(self.own_pid)
  if fault=='ambiguity':self._actor(54322)
  if fault=='missing-fd':del self.links[f'/proc/{self.original_pid}/fd/103']
  if fault=='wrong-uid':self.nodes[f'/proc/{self.original_pid}']['uid']=1001
  if fault=='canonical-hash':self.nodes[self.root+'/'+self.prefix+'.canonical-qga.py']['data'][0]^=1
  if fault=='nonce-mismatch':self.nodes[self.root+'/'+self.prefix+'.rpc-000005.raw']['data']=bytearray(b'\xff{"return":778}\n{"return":{"exited":false}}\n')
  if fault=='file-bound':self.node(self.root+'/'+self.prefix+'.00-bound.bin',b'x',size=8*1024*1024+1)
  if fault=='aggregate-bound':
   for name in ('00-a.bin','00-b.bin'):self.node(self.root+'/'+self.prefix+'.'+name,b'x'*(5*1024*1024))
  if fault=='symlink-file':self.node(self.root+'/'+self.prefix+'.00-link',b'',mode=stat.S_IFLNK|0o777)
  if fault=='explicit-absences':del self.nodes[self.root+'/'+self.prefix+'.rpc-000001.known.json']
  if fault=='required-absence':del self.nodes[self.root+'/'+self.prefix+'.rpc-000005.raw']
  self.os.listdir=self.listdir;self.os.getpid=lambda:self.own_pid;self.os.lseek=self.lseek;self.os.SEEK_SET=os.SEEK_SET
  self.os.kill=self.trap;self.os.unlink=self.trap;self.os.remove=self.trap;self.os.rename=self.trap
  self.socket.socket=self.trap
  self.initial_nodes=self.node_snapshot();self.initial_links=dict(self.links)

 def trap(self,*args,**kwargs):
  self.forbidden_attempts.append({'args':repr(args)[:300]});return forbidden()

 def _original_files(self):
  assert digest(CANONICAL['windows_qga_transfer.py'])==self.declarations['QGA_SHA256']
  assert digest(CANONICAL['windows_artifact_transfer.py'])==self.declarations['EMITTER_SHA256']
  self.node(self.root+'/'+self.prefix+'.canonical-qga.py',CANONICAL['windows_qga_transfer.py'])
  self.node(self.root+'/'+self.prefix+'.canonical-emitter.py',CANONICAL['windows_artifact_transfer.py'])
  for sequence in range(1,6):
   stem=self.root+'/'+self.prefix+'.rpc-'+str(sequence).zfill(6)
   command='guest-exec-status'if sequence==5 else'guest-ping'
   request=(json.dumps({'execute':command,'arguments':{'pid':8123}if sequence==5 else{}},separators=(',',':'))+'\n').encode()
   raw=b'\xff'+json.dumps({'return':777 if sequence==5 else sequence},separators=(',',':')).encode()+b'\n'+b'{"return":{"exited":false}}\n'
   self.node(stem+'.request.json',request);self.node(stem+'.raw',raw)
   self.jnode(stem+'.intent.json',{'sequence':sequence,'nonce':777 if sequence==5 else sequence,'command':command,'requestPath':stem+'.request.json','rawPath':stem+'.raw','requestBytes':len(request),'requestSha256':digest(request)})
   self.jnode(stem+'.known.json',{'state':'known','sequence':sequence})
  self.jnode(self.root+'/'+self.prefix+'.intent.json',{'state':'started','productOperation':False})
  self.node(self.root+'/'+self.prefix+'.wire',b'{"return":{"exited":false}}\n')
  self.node(self.root+'/'+self.prefix+'.partial-wire',b'\xff{"return":777}\n')

 def _actor(self,pid):
  base=f'/proc/{pid}';self.node(base,mode=stat.S_IFDIR|0o555)
  self.node(base+'/stat',(str(pid)+' (inert collector actor) '+' '.join(['S']+['0']*18+['1234567'])).encode())
  self.node(base+'/status',b'Name:\tpython3\nUid:\t1000\t1000\t1000\t1000\nvoluntary_ctxt_switches:\t10\nVmRSS:\t2048 kB\n')
  self.node(base+'/cmdline',b'/usr/bin/python3.13\0-c\0inert original operation\0')
  self.node(base+'/exe',b'inert actor executable',mode=stat.S_IFREG|0o755);self.links[base+'/exe']='/usr/bin/python3.13'
  for number,suffix in enumerate(('.rpc-000005.request.json','.rpc-000005.raw','.canonical-qga.py','.canonical-emitter.py'),100):
   path=base+'/fd/'+str(number);target=self.root+'/'+self.prefix+suffix
   self.links[path]=target;self.fd_targets[path]=target
  path=base+'/fd/104';self.links[path]='socket:['+str(900000+pid)+']';self.node(path,mode=stat.S_IFSOCK|0o600)

 def node_snapshot(self):
  return {p:{k:(bytes(v)if k=='data'else v)for k,v in n.items()}for p,n in self.nodes.items()}

 def listdir(self,path):
  path=str(path)
  if path==self.root:return sorted(p[len(path)+1:]for p in self.nodes if p.startswith(path+'/')and'/'not in p[len(path)+1:])
  if path=='/proc':return sorted({p.split('/')[2]for p in self.nodes if p.startswith('/proc/')and len(p.split('/'))>2}|{'self','net'})
  if re.fullmatch(r'/proc/[0-9]+/fd',path):return sorted(p[len(path)+1:]for p in self.links if p.startswith(path+'/'))
  raise AssertionError('unqualified listdir: '+path)

 def info(self,path):
  path=str(path)
  if path in self.fd_targets:
   self.metadata_reads.append(path);value=super().info(self.fd_targets[path])
   if self.closing_phase and self.fault=='fd-generation'and path==f'/proc/{self.original_pid}/fd/100':value.st_ino+=1
   return value
  value=super().info(path)
  if self.closing_phase:
   if self.fault=='executable-generation'and path==f'/proc/{self.original_pid}/exe':value.st_ino+=1
   if self.fault=='socket-generation'and path==f'/proc/{self.original_pid}/fd/104':value.st_ino+=1
   if self.fault=='file-generation'and path==self.root+'/'+self.prefix+'.rpc-000001.known.json':value.st_mtime_ns+=1
  return value

 def resolve_link(self,path):
  path=str(path);value=self.links[path]
  if self.closing_phase and path==f'/proc/{self.original_pid}/fd/104'and self.fault=='socket-link':return 'socket:[999999999]'
  if self.closing_phase and path==f'/proc/{self.original_pid}/exe'and self.fault=='executable-link':return '/usr/bin/replaced-python'
  return value

 def builtin_open(self,path,mode='r',*args,**kwargs):
  path=self.resolve(path)
  if re.match(r'/proc/[0-9]+/fd(?:/|$)',path):self.forbidden_attempts.append({'procFdRead':path});raise AssertionError('proc fd payload read forbidden')
  if path=='/proc/net/unix'and self.status_reads[self.original_pid]:self.closing_phase=True
  result=super().builtin_open(path,mode,*args,**kwargs)
  raw=result.getvalue()
  pid_match=re.fullmatch(r'/proc/([0-9]+)/(status|stat)',path)
  if pid_match:
   pid=int(pid_match.group(1));kind=pid_match.group(2)
   if kind=='status':
    self.status_reads[pid]+=1
    if self.fault=='wrong-status-uid'and pid==self.original_pid:raw=raw.replace(b'1000\t1000\t1000\t1000',b'1000\t1001\t1000\t1000')
    if self.drift and self.status_reads[pid]>1:raw=raw.replace(b'switches:\t10',b'switches:\t11').replace(b'2048 kB',b'2052 kB')
   elif self.closing_phase and self.fault=='start-changed'and pid==self.original_pid:
    raw=raw.replace('1234567','1234568')if isinstance(raw,str)else raw.replace(b'1234567',b'1234568')
  return io.BytesIO(raw)if'rb'==mode else io.StringIO(raw)

 def open_fd(self,path,flags,mode=0o777,*,dir_fd=None):
  absolute=self.resolve(path,dir_fd)
  if re.match(r'/proc/[0-9]+/fd(?:/|$)',absolute):self.forbidden_attempts.append({'procFdOpen':absolute});raise AssertionError('proc fd open forbidden')
  if flags&(os.O_CREAT|os.O_WRONLY|os.O_RDWR|os.O_TRUNC|os.O_APPEND):return self.trap(absolute,flags)
  return super().open_fd(path,flags,mode,dir_fd=dir_fd)

 def lseek(self,fd,offset,whence):
  assert whence==os.SEEK_SET and offset>=0;self.fds[fd]['offset']=offset;return offset

 def import_peer(self,name,globals=None,locals=None,fromlist=(),level=0):
  if name=='subprocess':
   self.imports.append({'name':name,'fromlist':list(fromlist or()),'level':level})
   peer=types.ModuleType(name);peer.__getattr__=lambda key:self.trap('subprocess.'+key);return peer
  return super().import_peer(name,globals,locals,fromlist,level)

 def write_fd(self,fd,data):return self.trap('write',fd)

def qualify(path,destination,label,expected_state,expected_error=None,fault=None,drift=True):
 source=path.read_bytes();world=CollectorWorld(literals(source.decode()),fault,drift)
 world.os.readlink=world.resolve_link
 namespace={'__name__':'__main__'};ordinary=dict(vars(builtins));ordinary['__import__']=world.import_peer;ordinary['open']=world.builtin_open;namespace['__builtins__']=ordinary
 output=io.StringIO();stderr=io.StringIO();caught=None;calls=collections.Counter();lines=set()
 def trace(frame,event,arg):
  if frame.f_code.co_filename==str(path):
   if event=='call':calls[frame.f_code.co_name]+=1
   elif event=='line':lines.add(frame.f_lineno)
  return trace
 prior=sys.gettrace()
 try:
  with contextlib.redirect_stdout(output),contextlib.redirect_stderr(stderr):
   sys.settrace(trace);exec(compile(source,str(path),'exec'),namespace,namespace)
 except BaseException as error:caught={'class':type(error).__name__,'message':str(error),'traceback':traceback.format_exc()}
 finally:sys.settrace(prior)
 assert caught is None,(label,caught)
 result=json.loads(output.getvalue());assert result['state']==expected_state,(label,result.get('error'),expected_state)
 if expected_error:assert expected_error==result.get('error'),(label,result.get('error'),expected_error)
 assert world.node_snapshot()==world.initial_nodes and world.links==world.initial_links,'original data or metadata mutated'
 assert not world.fds and not world.forbidden_attempts and not world.rpc and not world.sockets,'side effect or leaked collector handle'
 assert all(event[0]not in('write','fsync')for event in world.events)
 for flag in ('guestQueries','newSocketOperations','signals','originalHandleClose','productOperation','taskOperation'):assert result[flag]is False
 if expected_state=='qualified':
  assert result['actorOpening']['pid']==world.original_pid and result['actorCandidateCount']==1
  assert result['socketObservation']['currentPeerRelation']=='unavailable-from-proc-net-unix'and result['socketObservation']['anonymousSocketIsNotFreshQgaPeerProof']is True
  assert result['actorOpening']['statusBase64']!=result['actorClosing']['statusBase64']if drift else True
  assert result['sourceClosing']is True and result['allFileBytesComplete']is True
  assert any(row['state']=='absent'and row['closingAbsent']is True for row in result['files'].values())
 case=destination/label;case.mkdir(mode=0o700)
 (case/'caller.py').write_bytes(source)
 receipt={'schemaVersion':1,'label':label,'source':str(path),'sourceSha256':digest(source),'sourceUnmodified':True,'partialNamespaceExecution':False,'postExecFunctionReplacement':False,'initialGlobals':['__name__','__builtins__'],'fault':fault,'irrelevantStatusDrift':drift,'imports':world.imports,'functions':dict(calls),'coveredLines':sorted(lines),'procFdMetadataOnly':world.metadata_reads,'forbiddenAttempts':world.forbidden_attempts,'allOriginalDataUnchanged':True,'allOwnReadonlyDescriptorsClosed':True,'guestOrNetworkOperations':False,'nativeAcceptance':False,'stdout':output.getvalue(),'stderr':stderr.getvalue(),'result':result}
 raw=(json.dumps(receipt,sort_keys=True,indent=2)+'\n').encode();(case/'receipt.json').write_bytes(raw)
 return {'label':label,'passed':True,'state':result['state'],'error':result.get('error'),'sourceSha256':digest(source),'receiptSha256':digest(raw)}

def main():
 parser=argparse.ArgumentParser();parser.add_argument('--output',default='qualification-inert-v1');args=parser.parse_args()
 assert Path(args.output).name==args.output and args.output.startswith('qualification-')
 destination=HERE/args.output;destination.mkdir(mode=0o700,exist_ok=False)
 current=HERE/'collector-caller.py';assert digest(current.read_bytes())==CURRENT_SHA
 cases=[]
 def run(label,**kwargs):cases.append(qualify(current,destination,label,**kwargs))
 run('success-status-drift',expected_state='qualified')
 run('success-explicit-absences',expected_state='qualified',fault='explicit-absences')
 controls={'ambiguity':'collector_actor_not_unique','missing-fd':'collector_actor_not_unique','wrong-uid':'collector_actor_not_unique','wrong-status-uid':'collector_actor_uid_status','start-changed':'collector_actor_closing_changed','executable-generation':'collector_actor_closing_changed','executable-link':'collector_actor_closing_changed','fd-generation':'collector_actor_original_fd_identity','socket-generation':'collector_actor_closing_changed','socket-link':'collector_actor_closing_changed','file-generation':'collector_file_generation_closing','canonical-hash':'collector_original_canonical_source_hash','nonce-mismatch':'collector_original_sync_nonce_join','file-bound':'collector_file_or_aggregate_bound','aggregate-bound':'collector_file_or_aggregate_bound','symlink-file':'collector_file_private','required-absence':'collector_required_original_file_absent'}
 for fault,reason in controls.items():run('refuse-'+fault,expected_state='refused',expected_error=reason,fault=fault)
 old=HERE/'draft-before-stable-status-projection/collector-caller.py';assert digest(old.read_bytes()).startswith('ab7')
 cases.append(qualify(old,destination,'red-before-stable-status',expected_state='refused',expected_error='collector_actor_closing_changed'))
 old=HERE/'draft-before-inert-review/collector-caller.py';assert digest(old.read_bytes()).startswith('2ae')
 cases.append(qualify(old,destination,'red-before-own-pid-exclusion',expected_state='refused',expected_error='collector_actor_not_unique'))
 summary={'schemaVersion':1,'allPassed':True,'cases':cases,'caseCount':len(cases),'currentSourceSha256':CURRENT_SHA,'qualifierSha256':digest(Path(__file__).read_bytes()),'completeNamespaces':True,'pythonCInitialGlobalsOnly':True,'noFunctionReplacement':True,'originalFilesProcessesSocketsUntouched':True,'nativeAcceptance':False,'guestOrNetworkOperations':False,'ownedOutputsOnly':str(destination)}
 (destination/'summary.json').write_text(json.dumps(summary,sort_keys=True,indent=2)+'\n');print(json.dumps(summary,sort_keys=True,indent=2))

if __name__=='__main__':main()
