"""Mac unlock evidence admission, separate from executable input authority.

The retained bootstrap unlock is historical component evidence. Its independent
observer has no retained producer envelope, so it cannot qualify the new nonce
producer. Generic admission additionally requires a complete, reviewed native
case and a source-owned resolution of every enrolled legacy GUI incident.
"""
from __future__ import annotations

from contextlib import ExitStack
from copy import deepcopy
import hashlib
import json
from pathlib import Path
import re
import sys
from types import MappingProxyType

from . import readiness_tart_macos_registry as registry
from . import readiness_tart_macos_unlock as unlock

_EXECUTING_CODE = sys._getframe().f_code
_HISTORICAL_SOURCE = '80ac36469ccac1e241b44d4b4e6c90d382845b3fdd98afd8d6144681a0d8a39d'
_HISTORICAL_STREAM = '8a0df0f6501713cba553d16932e89289d22b521ec0d08a67e8730a0ab84f0be4'
# No new native once case has been performed. Adding an entry requires the
# complete source-held native scenario, not a caller-supplied producer digest.
_NATIVE_DRIVERS = frozenset()
_TOKEN = object()
_HISTORY_ROLES = frozenset({'source', 'plan', 'phase', 'password', 'returnIntent', 'returnComplete',
                           'postProbe', 'publicPreflight', 'baseline'})
PROFILE = MappingProxyType({'dimensions': (1024, 768), 'accountBox': (425, 410, 605, 451),
                           'fieldBox': (432, 458, 592, 489), 'caretBox': (14, 7, 15, 23)})


class QualificationBlocked(ValueError):
    """Only finite identifiers; never proof bodies or private input."""


def _need(condition, reason='macos_unlock_qualification_invalid'):
    if not condition:
        raise QualificationBlocked(reason)


def _json(raw):
    def pairs(rows):
        value = {}
        for key, item in rows:
            _need(key not in value)
            value[key] = item
        return value
    try:
        value = json.loads(raw, object_pairs_hook=pairs,
                           parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
        _need(type(value) is dict)
        return value
    except Exception:
        raise QualificationBlocked('macos_unlock_qualification_invalid') from None


def _projection(packet, binding):
    """Finite identity projection; historical packets never execute code."""
    _need(type(packet) is dict and set(packet) == {'facts', 'agent'})
    facts, agent = packet['facts'], packet['agent']
    _need(type(facts) is dict and type(agent) is dict
          and set(agent) == {'actor', 'uid', 'principal', 'home', 'python', 'rawBoot'}
          and agent['python'] == binding.guest_python)
    return unlock._identity({'target': binding.target, 'machine': facts.get('machine'),
        'boot': facts.get('boot'), 'rawBoot': agent.get('rawBoot'), 'uid': facts.get('uid'),
        'principal': facts.get('account'), 'home': facts.get('home'),
        'agent': {**agent['actor'], 'uid': agent['uid']}, 'console': facts.get('console'),
        'display': facts.get('display')}, binding)


def historical_profile(records, binding, original_run):
    """Validate historical public data only; returns no dispatch capability."""
    try:
        _need(type(records) is dict and set(records) == _HISTORY_ROLES)
        _need(type(records['source']) is bytes and hashlib.sha256(records['source']).hexdigest() == _HISTORICAL_SOURCE)
        values = {key: _json(value) for key, value in records.items() if key not in {'source', 'baseline'}}
        plan, phase = values['plan'], values['phase']
        _need(set(plan) == {'schemaVersion', 'operationId', 'fixtureId', 'baseline', 'streamProducerSha256',
              'secretOperation', 'submitOperation', 'noCredentialBytesInPlan', 'actions'}
              and type(plan['schemaVersion']) is int and plan['schemaVersion'] == 1
              and plan['streamProducerSha256'] == _HISTORICAL_STREAM
              and plan['noCredentialBytesInPlan'] is True)
        for key in ('operationId', 'secretOperation', 'submitOperation'):
            unlock._uuid(plan[key])
        _need(len({plan[key] for key in ('operationId', 'secretOperation', 'submitOperation')}) == 3)
        _need(set(phase) == {'operationId', 'originalRun', 'recipient', 'state'}
              and phase['operationId'] == plan['operationId'] and phase['originalRun'] == original_run
              and phase['state'] == 'unknown_no_replay')
        before = deepcopy(phase['recipient']); before['display'] = 'ready'
        unlock._identity(before, binding)
        _need(before['console']['locked'] is True)
        _need(values['password'] == {'operationId': plan['secretOperation'], 'state': 'transport_complete_not_unlock_receipt'}
              and values['returnIntent'] == {'operationId': plan['submitOperation'], 'action': 'one_Return_existing_original_field', 'state': 'unknown'}
              and values['returnComplete'] == {'operationId': plan['submitOperation'], 'state': 'submitted_awaiting_independent_session'})
        after = _projection(values['postProbe'], binding)
        unlock._identity(after, binding, before)
        _need(after['console']['locked'] is False)
        preflight = values['publicPreflight']
        recipient = deepcopy(preflight.get('recipient')); recipient['display'] = 'ready'
        _need(preflight.get('operationId') == plan['operationId'] and recipient == before
              and preflight.get('sourceSha256') == _HISTORICAL_SOURCE
              and preflight.get('state') == 'public_only_complete_secret_unsubmitted'
              and preflight.get('simulatedMaximumAscii32EventGuards') == 136
              and type(preflight.get('fastGuardSeconds')) is list and len(preflight['fastGuardSeconds']) == 136)
        unlock._image(records['baseline'], PROFILE['dimensions'])
        return {'operationId': plan['operationId'], 'secretOperation': plan['secretOperation'],
                'returnOperation': plan['submitOperation'], 'before': before, 'after': after,
                'baselineName': plan['baseline'], 'profile': dict(PROFILE),
                'authority': 'historical_component_data_only', 'newProducerQualified': False}
    except (QualificationBlocked, unlock.UnlockBlocked):
        raise
    except Exception:
        raise QualificationBlocked('macos_unlock_historical_profile_invalid') from None


class QualifiedUnlock:
    """Opaque admission, unavailable until a complete new native case exists."""
    __slots__ = ('_token', '_custody', '_held', '_closed', '_profile', '_baseline', '_binding', '_manifest')

    def __init__(self, *args, **kwargs):
        raise QualificationBlocked('macos_unlock_native_case_required')

    def guard(self):
        _need(self._token is _TOKEN and not self._closed, 'macos_unlock_qualification_closed')
        self._custody._operator.guard()
        for item in self._held:
            item.guard()

    def close(self):
        if not self._closed:
            self._closed = True
            for item in reversed(self._held):
                item.close()


def _validate_native_case(case, records, binding, run_operation):
    """Strict closed schema; source allowlist remains empty before native proof."""
    _need(type(case) is dict and set(case) == {'driverSha256', 'operationId', 'originalRunOperationId',
          'before', 'after', 'producerSources', 'publicBenchmark', 'intentSha256', 'rawReplySha256'})
    _need(type(case['driverSha256']) is str and case['driverSha256'] in _NATIVE_DRIVERS,
          'macos_unlock_new_native_case_unqualified')
    unlock._uuid(case['operationId'])
    _need(case['originalRunOperationId'] == run_operation)
    before, after = case['before'], case['after']
    unlock._identity(before, binding); unlock._identity(after, binding, before)
    _need(before['console']['locked'] is True and after['console']['locked'] is False)
    _need(type(records) is dict and set(records) == {'intent', 'rawReply', 'publicBenchmark', 'driver'})
    for role, digest in (('intent', case['intentSha256']), ('rawReply', case['rawReplySha256']), ('driver', case['driverSha256'])):
        _need(type(digest) is str and re.fullmatch('[0-9a-f]{64}', digest)
              and hashlib.sha256(records[role]).hexdigest() == digest)
    # Complete producer/request/reply and new full-chain timing validation will
    # be added with the first reviewed native driver. A label cannot skip it.
    raise QualificationBlocked('macos_unlock_native_driver_protocol_unqualified')


def load(custody):
    """Selected private registration only; no caller path, profile or boolean."""
    _need(type(custody) is registry.MacCustody, 'macos_unlock_custody_unqualified')
    custody._operator.guard()
    reference = custody.descriptor.get('qualifications', {}).get('unlock')
    _need(type(reference) is dict, 'macos_unlock_native_case_required')
    path, pin = registry._reference(reference, custody.root)
    _need(path == custody.lifecycle_root / 'unlock-native-qualification.json')
    # Until the new native envelope and legacy incident resolutions exist, no
    # manifest label, digest, fabricated DTO or historical result mints material.
    with registry.PublicProof(path, pin) as holder:
        manifest = holder.value()
        _need(type(manifest) is dict and set(manifest) == {'schemaVersion', 'originalRunOperationId', 'nativeCase', 'legacyGui'})
        _need(type(manifest['schemaVersion']) is int and manifest['schemaVersion'] == 1
              and manifest['originalRunOperationId'] == custody.run_intent['operationId'])
        _need(type(manifest['legacyGui']) is dict, 'macos_unlock_legacy_gui_unqualified')
        _validate_native_case(manifest['nativeCase'], {}, custody.binding, custody.run_intent['operationId'])
    raise QualificationBlocked('macos_unlock_native_case_required')
