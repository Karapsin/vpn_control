 sys.argv=[str(path),'--target',P['target'],'--fixture-id',P['fixtureId'],'--operation-id',P['operationId'],'--lease-operation-id',P['leaseOperationId']]
 exec(compile(original,str(path),'exec',dont_inherit=True),{'__name__':'__main__','__file__':str(path)})
finally:sources.close()
'''

_PROFILE_CAPTURE_SOURCE = rb'''"""Bounded public v12 RPC evidence for the private qualification caller.

This is an internal capture helper, not a provider/tool action. Its caller must
admit the fixed target/source before constructing argv. It signals only its own
original Popen actor after exact kernel birth and parent checks. A timeout never
cancels the guest operation or grants permission to submit it again.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import selectors
import stat
import subprocess
import time


class CaptureUnknown(RuntimeError):
    pass


def _identity(info):
    return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid, info.st_nlink)


def _generation(info):
    return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
            info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def _write(fd, raw):
    view = memoryview(raw)
    while view:
        n = os.write(fd, view)
        if n <= 0:
            raise OSError('capture_short_write')
        view = view[n:]
    os.fsync(fd)


class PublicRpcCapture:
    """Preopen all output leaves against a held directory before dispatch.

    Raw bytes always go to those original descriptors, including when a named
    route is replaced. Final evidence precedes external source/semantic guards.
    The helper retains bounded prefixes only; overflow/partial EOF is UNKNOWN.
    """
    limits = {'stdout': 262144, 'stderr': 65536}

    def __init__(self, directory, label):
        if os.name != 'posix' or not re.fullmatch(r'call-[1-9][0-9]*-(?:factory|lease|executor|namespace|inventory|root-before|root-after|public|once|observer|source-close)', label):
            raise ValueError('capture_scope')
        directory.guard()
        self.directory = directory
        self.fd = os.dup(directory.fd)
        self.identity = _identity(os.fstat(self.fd))[:5]
        self.leaves = {}
        self.callback = bytearray()
        try:
            for role, suffix in (('stdout', '.stdout.json'), ('stderr', '.stderr.txt'), ('callback', '.capture.jsonl')):
                name = label + suffix
                fd = os.open(name, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=self.fd)
                self.leaves[role] = (fd, name, _identity(os.fstat(fd)))
            os.fsync(self.fd)
            self._guard_routes()
        except BaseException:
            self.close()
            raise

    def _guard_routes(self):
        self.directory.guard()
        if _identity(os.fstat(self.fd))[:5] != self.identity:
            raise CaptureUnknown('capture_directory_changed')
        for fd, name, identity in self.leaves.values():
            if _identity(os.fstat(fd)) != identity or _identity(os.stat(name, dir_fd=self.fd, follow_symlinks=False)) != identity:
                raise CaptureUnknown('capture_output_route_changed')
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
                raise CaptureUnknown('capture_output_generation_changed')

    def _record(self, value):
        raw = (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()
        if len(self.callback) + len(raw) > 16384: raise CaptureUnknown('capture_callback_limit')
        _write(self.leaves['callback'][0], raw)
        self.callback.extend(raw)

    def run(self, argv, payload, *, deadline, birth, parent):
        """One admitted RPC; birth/parent are pure source-held kernel getters."""
        if type(payload) is not bytes or len(payload) > 262144 or not time.monotonic() < deadline <= time.monotonic() + 90:
            raise ValueError('capture_bound')
        self._guard_routes()
        data = {name: bytearray() for name in self.limits}
        eof = {name: False for name in self.limits}
        overflow = {name: False for name in self.limits}
        process = None; actor = None; failure = None; cleanup = None; sent = 0; code = None
        selector = selectors.DefaultSelector()

        def owned():
            return (actor is not None and actor['birth'] is not None and birth(actor['pid']) == actor['birth']
                    and parent(actor['pid']) == actor['parent'])

        def event(key):
            nonlocal sent, failure
            pipe = key.fileobj; role = key.data
            if role == 'stdin':
                try:
                    n = os.write(pipe.fileno(), memoryview(payload)[sent:sent + 65536])
                except (BlockingIOError, InterruptedError):
                    return
                except BrokenPipeError:
                    selector.unregister(pipe); pipe.close(); failure = failure or 'stdin_closed'; return
                if n <= 0:
                    raise OSError('capture_stdin_write')
                sent += n
                if sent == len(payload):
                    selector.unregister(pipe); pipe.close()
                return
            try:
                block = os.read(pipe.fileno(), 65536)
            except (BlockingIOError, InterruptedError):
                return
            if not block:
                eof[role] = True; selector.unregister(pipe); pipe.close(); return
            room = self.limits[role] - len(data[role])
            keep = block[:room]
            if keep:
                # Retain immediately, before any external source/actor guard.
                _write(self.leaves[role][0], keep); data[role].extend(keep)
            if len(block) > room:
                overflow[role] = True; failure = failure or 'output_limit'

        try:
            process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                env={k: v for k, v in os.environ.items() if not k.startswith('DYLD_')}, close_fds=True, bufsize=0)
            actor = {'pid': process.pid, 'birth': birth(process.pid), 'parent': os.getpid()}
            self._record({'schemaVersion': 1, 'stage': 'started', 'actor': actor, 'replayAllowed': False})
            for role in ('stdout', 'stderr', 'stdin'):
                pipe = getattr(process, role); os.set_blocking(pipe.fileno(), False)
                if role == 'stdin' and not payload:
                    pipe.close(); continue
                selector.register(pipe, selectors.EVENT_WRITE if role == 'stdin' else selectors.EVENT_READ, role)
            if not owned():
                failure = 'actor_not_owned'
            while selector.get_map() and failure is None:
                left = deadline - time.monotonic()
                if left <= 0:
                    failure = 'timeout'; break
                for key, _ in selector.select(min(.05, left)):
                    event(key)
                    if failure: break
            if failure is None:
                try: code = process.wait(timeout=max(.001, deadline - time.monotonic()))
                except subprocess.TimeoutExpired: failure = 'timeout'
        except BaseException as error:
            failure = failure or 'capture_' + type(error).__name__
        finally:
            # No source/named-output guards may run before bounded drainage and
            # callback retention. Never signal a group/manager/guest process.
            if process is not None:
                try:
                    if process.poll() is None:
                        if owned(): process.kill()
                        else: cleanup = 'original_actor_not_owned_no_signal'
                    end = time.monotonic() + 2
                    # Read remaining queued output after exact-child cleanup;
                    # inherited descendants holding pipes cannot wait forever.
                    while selector.get_map() and time.monotonic() < end:
                        for key, _ in selector.select(min(.05, max(0, end - time.monotonic()))):
                            if key.data == 'stdin':
                                selector.unregister(key.fileobj); key.fileobj.close()
                            else: event(key)
                    try: code = process.wait(timeout=max(.001, end - time.monotonic()))
                    except subprocess.TimeoutExpired: cleanup = cleanup or 'original_actor_wait_timeout'
                except BaseException as error:
                    cleanup = cleanup or 'cleanup_' + type(error).__name__
                finally:
                    for pipe in (process.stdin, process.stdout, process.stderr):
                        if pipe is not None and not pipe.closed:
                            try: pipe.close()
                            except OSError: cleanup = cleanup or 'pipe_close_failed'
            selector.close()
            try:
                actor_absent = actor is not None and actor['birth'] is not None and birth(actor['pid']) != actor['birth']
            except BaseException:
                actor_absent = False
            if not actor_absent: cleanup = cleanup or 'original_actor_absence_unproven'
            result = {'schemaVersion': 1, 'stage': 'retained', 'actor': actor, 'returncode': code,
                'actorAbsent': actor_absent, 'outputGenerations': {role: list(_generation(os.fstat(self.leaves[role][0]))) for role in self.limits},
                'stdinBytesWritten': sent, 'stdoutBytes': len(data['stdout']), 'stderrBytes': len(data['stderr']),
                'stdoutEof': eof['stdout'], 'stderrEof': eof['stderr'],
                'stdoutOverflow': overflow['stdout'], 'stderrOverflow': overflow['stderr'],
                'partial': bool(failure or cleanup) or not all(eof.values()) or sent != len(payload) or any(overflow.values()),
                'failure': failure, 'cleanupFailure': cleanup, 'replayAllowed': False,
                'originalOutcome': 'unknown_no_replay' if failure or cleanup else 'callback_retained_not_semantic_success',
                'stdoutSha256': hashlib.sha256(data['stdout']).hexdigest(), 'stderrSha256': hashlib.sha256(data['stderr']).hexdigest()}
            self._record(result)
            os.fsync(self.fd)
        # Original raw/callback are durable even if this final custody check fails.
        self._guard_routes()
        for role in self.limits:
            fd = self.leaves[role][0]
            before = _generation(os.fstat(fd))
            if list(before) != result['outputGenerations'][role]:
                raise CaptureUnknown('capture_output_generation_changed')
            if os.pread(self.leaves[role][0], self.limits[role] + 1, 0) != bytes(data[role]):
                raise CaptureUnknown('capture_output_bytes_changed')
            if _generation(os.fstat(fd)) != before:
                raise CaptureUnknown('capture_output_generation_changed')
        if os.pread(self.leaves['callback'][0], 16385, 0) != bytes(self.callback):
            raise CaptureUnknown('capture_callback_changed')
        self._guard_routes()
        if failure or cleanup or result['partial']:
            raise CaptureUnknown('namespace_original_rpc_unknown_no_replay')
        return subprocess.CompletedProcess(argv, code, bytes(data['stdout']), bytes(data['stderr'])), result

    def close(self):
        for fd, _, _ in self.leaves.values(): os.close(fd)
        self.leaves.clear()
        if self.fd >= 0: os.close(self.fd); self.fd = -1

    def __enter__(self): return self
    def __exit__(self, *_): self.close()
'''

_LABEL_TOKEN = object()
_LABEL_MODE = 'exact_white_foreground_v1'
# Fixed historical PUBLIC empty baseline, never a new or filled frame.
_LABEL_BASELINE_SHA = 'ccfa8f4d3940612f63b591a78af4708d5746d0288b10c823d5991a18d190fc29'
_PROFILE_PURPOSE = 'native_macos_label_profile_v1'
_PROFILE_MODULES = ('readiness_tart_macos_registry','readiness_fixture_registry','readiness_tart_macos','readiness_tart_macos_unlock','readiness_tart_macos_wake','readiness_qemu_jobs','private_inventory_lock','durable_remote_job','readiness_lease_workflow','readiness_tart_macos_lease_executor','readiness_tart_macos_lease_qualification','readiness_tart_macos_lease_bridge','readiness_tart_macos_session','readiness_tart_macos_session_stream','readiness_tart_macos_unlock_qualification','readiness_tart_macos_unlock_observer','readiness_tart_macos_legacy_phases','readiness_tart_macos_unlock_material')


def _profile_roles(root):
    from .source_module_loader import SourceSession
    with ExitStack() as held:
        sources = SourceSession(root / 'agent_tools', 'readiness_tart_macos_registry')
        held.callback(sources.close)
        for name in _PROFILE_MODULES: sources.load(name)
        sources.guard()
        result = {str(Path(path).relative_to(root)): hashlib.sha256(body).hexdigest()
                  for path, body in sources.cache.values()}
        _need(result.get('agent_tools/readiness_tart_macos_unlock_qualification.py') ==
              hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), 'macos_label_profile_source_epoch')
        return result


def _profile_context(custody):
    _need(type(custody) is registry.MacCustody, 'macos_label_profile_custody')
    custody._operator.guard()
    _need(Path(__file__).resolve() == custody.root / 'agent_tools' / Path(__file__).name,
          'macos_label_profile_staging_only')
    _need(_EXECUTING_CODE == compile(Path(__file__).read_bytes(), __file__, 'exec', dont_inherit=True),
          'macos_label_profile_source_epoch')
    return custody.lifecycle_root / 'jobs', custody.run_owner.generation, custody.host_binding


def _render_profile_driver(project, fixture, target, source_pins):
    # Four typed DATA substitutions only; all executable statements are fixed.
    _need(type(project) is str and type(fixture) is str and type(target) is str
          and type(source_pins) is dict, 'macos_label_profile_render')
    result = _PROFILE_DRIVER_TEMPLATE
    for marker, value in (('@@PROJECT@@', repr(project)), ('@@FIXTURE@@', repr(fixture)),
                          ('@@TARGET@@', repr(target)), ('@@SOURCE_PINS@@', repr(source_pins)),
                          ('@@CAPTURE_NAME@@', 'label-profile-capture.py')):
        result = result.replace(marker, value)
    _need('@@' not in result, 'macos_label_profile_render')
    return result.encode()


def _label_program(custody, operation, lease_operation, fixture_id):
    """Fixed read-only Program builder; no submit, callback, path or source argument."""
    import base64
    root, generation, binding = _profile_context(custody)
    operation = unlock._uuid(operation); lease_operation = unlock._uuid(lease_operation)
    _need(operation != lease_operation, 'macos_label_profile_operation')
    source = _render_profile_driver(str(custody.root), fixture_id,
             'tart:' + custody.binding.vm_name, _profile_roles(custody.root))
    config = {'phase': 'public', 'project': str(custody.root), 'jobRoot': str(root),
        'jobRootGeneration': list(generation), 'hostBinding': binding.__dict__,
        'operationId': operation, 'leaseOperationId': lease_operation,
        'originalRunOperationId': custody.run_intent['operationId'], 'fixtureId': fixture_id,
        'target': 'tart:' + custody.binding.vm_name, 'purpose': _PROFILE_PURPOSE,
        'source': base64.b64encode(source).decode(), 'captureSource': base64.b64encode(_PROFILE_CAPTURE_SOURCE).decode(), 'sourceSha256': hashlib.sha256(source).hexdigest(),
        'driverPath': str(root / operation / 'label-driver.py'),
        'indexPath': str(custody.lifecycle_root / ('native-unlock-controller-' + operation + '.json'))}
    # The durable J intent/owner predates fixed-file publication/native effects.
    return registry.jobs.Program(_PROFILE_PURPOSE, ('CONFIG=' + repr(config) + '\n' + _PROFILE_WRAPPER).encode(), 262144)


def label_profile_program(custody, operation, lease_operation):
    _need(type(custody) is registry.MacCustody, 'macos_label_profile_custody')
    return _label_program(custody, operation, lease_operation, custody.fixture_id)


def _original_profile_fixture(custody, fixture_id, held):
    # Exact historical fixture association, no old receipt/source relabeling.
    from . import readiness_fixture_registry as fixtures
    fixtures._id(fixture_id)
    path = custody.root / '.rag_index/readiness-fixtures' / (fixture_id + '.json')
    original, pin = fixtures._json(path)
    proof = registry.PublicProof(path, pin, private_file=False); held.append(proof)
    before, current = deepcopy(original), deepcopy(custody.descriptor)
    before['fixtureId'] = current['fixtureId']
    before['qualifications'].pop('labelProfile', None)
    current['qualifications'].pop('labelProfile', None)
    _need(before == current, 'macos_label_profile_original_fixture_changed')
    return fixture_id


def _baseline_reference(custody, reference):
    _need(type(reference) is dict and set(reference) == {'path','pin'}
          and type(reference['path']) is str, 'macos_label_profile_baseline_route')
    path = Path(reference['path'])
    _need(path == custody.lifecycle_root / 'public-held-source-native-wake-empty-Tool-Recovery-lockscreen-1792522029846637000.png'
          and path == path.resolve(strict=True), 'macos_label_profile_baseline_route')
    _need(reference['pin'].get('sha256') == _LABEL_BASELINE_SHA, 'macos_label_profile_baseline_epoch')
    return path, reference['pin']


def _read_profile_case(custody, operation, held):
    import ast
    root, generation, binding = _profile_context(custody)
    operation = unlock._uuid(operation)
    job = root / operation
    raw_program = registry.jobs._read(job / 'program.py', registry.jobs.MAX_PROGRAM_BYTES)
    try:
        config = ast.literal_eval(raw_program.decode().splitlines()[0].removeprefix('CONFIG='))
    except Exception:
        raise QualificationBlocked('macos_label_profile_program') from None
    fixture_id = _original_profile_fixture(custody, config.get('fixtureId'), held)
    expected = _label_program(custody, operation, config.get('leaseOperationId'), fixture_id)
    _need(raw_program == expected.source, 'macos_label_profile_program')
    owner = registry.OriginalOwner(root, tuple(generation), operation, binding, expected)
    status = owner.observe()
    _need(status['state'] == 'terminal' and status['terminal']['exitCode'] == 0
          and status['terminal']['streamsClosed'] is True
          and registry.jobs._birth(status['owner']['pid']) != status['owner']['birth'],
          'macos_label_profile_original_pending')
    collected, stdout, stderr = registry.jobs.collect(root, operation, binding, generation=tuple(generation))
    _need(collected == status, 'macos_label_profile_original_changed')
    # Full terminal streams are authenticated by the original durable owner;
    # metrics JSON is a projection, never caller success authority.
    for name, data in (('stdout', stdout), ('stderr', stderr)):
        meta = status['terminal'][name]
        _need(not meta['overflow'] and meta['totalBytes'] == meta['retainedBytes'] == len(data)
              and meta['sha256'] == hashlib.sha256(data).hexdigest(), 'macos_label_profile_streams')
    response = _json(stdout)
    folder = custody.lifecycle_root / ('native-label-profile-' + operation)
    records = {}
    for name in ('complete.json','profile-match-result.json','root-before.source.py','root-before.stdout.json',
                 'root-before.result.json','root-after.source.py','root-after.stdout.json','root-after.result.json',
                 'source-capsule-before.json','source-capsule-closed.json','rpc-closure.json','lease-original-status.json','baseline-reference.json'):
        path = folder / name
        pin = {'generation': list(registry.private._generation(path.lstat())),
               'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}
        proof = registry.PublicProof(path, pin); held.append(proof); records[name] = proof.body
    done, metrics = _json(records['complete.json']), _json(records['profile-match-result.json'])
    _need(done.get('operationId') == operation and done.get('captures') == 1
          and done.get('sameIdentityBeforeAfter') is True and done.get('profileMode') == _LABEL_MODE
          and done.get('state') == 'readonly_label_profile_qualified'
          and done.get('ordinaryCredentialAccess') is False and done.get('guiInput') is False
          and done.get('fullFramePersisted') is False and done.get('newBaselineAuthority') is False,
          'macos_label_profile_protocol')
    _need(set(metrics) == {'labelMatch','baselineForegroundPixels','emptyFieldMatch','nonCaretFieldDifferingPixels','nativeProfileMode'}
          and type(metrics['baselineForegroundPixels']) is int and 0 < metrics['baselineForegroundPixels'] < 180*41
          and response == {'operationId': operation, 'state': 'readonly_label_profile_qualified', **metrics}
          and metrics.get('nativeProfileMode') == _LABEL_MODE and metrics.get('labelMatch') is True
          and type(metrics.get('emptyFieldMatch')) is bool
          and type(metrics.get('nonCaretFieldDifferingPixels')) is int
          and 0 <= metrics['nonCaretFieldDifferingPixels'] < 160 * 31
          and metrics['emptyFieldMatch'] == (metrics['nonCaretFieldDifferingPixels'] == 0),
          'macos_label_profile_metrics')
    source_pins = _profile_roles(custody.root)
    _need(_json(records['source-capsule-before.json']) == _json(records['source-capsule-closed.json']) == source_pins,
          'macos_label_profile_source_epoch')
    before = _projection(_json(records['root-before.stdout.json']), custody.binding)
    after = _projection(_json(records['root-after.stdout.json']), custody.binding)
    unlock._identity(after, custody.binding, before)
    _need(before['console']['locked'] is True and after['console']['locked'] is True, 'macos_label_profile_session')
    expected_probe = registry.guest_probe_source(custody.binding, prefix=custody.guest_proof['prefix'], public_files=custody.guest_proof['publicFiles'])
    if type(expected_probe) is str: expected_probe = expected_probe.encode()
    for stage in ('root-before', 'root-after'):
        _need(records[stage + '.source.py'] == expected_probe
              and _json(records[stage + '.result.json'])['returncode'] == 0,
              'macos_label_profile_root_source')
    closure = _json(records['rpc-closure.json'])
    _need(closure.get('allClosed') is True and type(closure.get('attempts')) is list
          and closure['attempts'], 'macos_label_profile_rpc_closure')
    for item in closure['attempts']:
        callback, actor = item.get('callback'), item.get('actor')
        _need(type(actor) is dict and type(callback) is dict and callback.get('actor') == actor
              and callback.get('stdoutEof') is True and callback.get('stderrEof') is True
              and callback.get('partial') is False and callback.get('actorAbsent') is True
              and registry.jobs._birth(actor['pid']) != actor['birth'], 'macos_label_profile_rpc_closure')
    baseline_ref = _json(records['baseline-reference.json'])
    baseline_path, baseline_pin = _baseline_reference(custody, baseline_ref)
    _need(baseline_path == custody.lifecycle_root / 'public-held-source-native-wake-empty-Tool-Recovery-lockscreen-1792522029846637000.png', 'macos_label_profile_baseline_route')
    baseline_proof = registry.PublicProof(baseline_path, baseline_pin); held.append(baseline_proof)
    mask = unlock._white_label_mask(unlock._image(baseline_proof.body, PROFILE['dimensions']), PROFILE)
    _need(sum(mask) == metrics['baselineForegroundPixels'], 'macos_label_profile_baseline_changed')
    for proof in held: proof.guard()
    return {'operationId': operation, 'programSha256': expected.digest, 'sourcePins': source_pins,
            'before': before, 'after': after, 'metrics': metrics, 'baseline': baseline_ref}, owner


class LabelProfile:
    __slots__ = ('_token','_custody','_held','_owner','_owner_state','_baseline','_mask','_binding','_closed','_case')
    def __init__(self, *args, **kwargs):
        raise QualificationBlocked('macos_label_profile_not_opaque')
    def guard(self):
        _need(self._token is _LABEL_TOKEN and not self._closed, 'macos_label_profile_closed')
        self._custody._operator.guard()
        for proof in self._held: proof.guard()
        _need(self._owner.observe() == self._owner_state, 'macos_label_profile_original_changed')
    def close(self):
        if not self._closed:
            self._closed = True
            for proof in reversed(self._held): proof.close()


def admit_label_profile(custody, operation):
    """After one actual readonly case, create immutable informational epoch receipt."""
    held = []
    try:
        case, _ = _read_profile_case(custody, operation, held)
        path = custody.lifecycle_root / ('label-profile-epoch-' + case['operationId'] + '.json')
        registry.jobs._publish(path, {'schemaVersion': 1, 'mode': _LABEL_MODE, 'case': case})
        return {'path': str(path), 'pin': {'generation': list(registry.private._generation(path.lstat())),
                 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}}
    finally:
        for proof in reversed(held): proof.close()


def load_label_epoch(custody):
    """No caller path/flag. Missing informational role retains legacy RGB mode."""
    reference = custody.descriptor.get('qualifications', {}).get('labelProfile')
    if reference is None: return None
    _profile_context(custody)
    path, pin = registry._reference(reference, custody.root)
    held = []
    try:
        proof = registry.PublicProof(path, pin); held.append(proof); receipt = proof.value()
        _need(set(receipt) == {'schemaVersion','mode','case'} and receipt['schemaVersion'] == 1
              and receipt['mode'] == _LABEL_MODE, 'macos_label_profile_receipt')
        operation = unlock._uuid(receipt['case']['operationId'])
        _need(path == custody.lifecycle_root / ('label-profile-epoch-' + operation + '.json'), 'macos_label_profile_route')
        case, owner = _read_profile_case(custody, operation, held)
        _need(case == receipt['case'], 'macos_label_profile_receipt')
        baseline_path, baseline_pin = _baseline_reference(custody, case['baseline'])
        baseline = registry.PublicProof(baseline_path, baseline_pin); held.append(baseline)
        mask = unlock._white_label_mask(unlock._image(baseline.body, PROFILE['dimensions']), PROFILE)
        _need(0 < sum(mask) < len(mask), 'macos_label_profile_blank')
        value = object.__new__(LabelProfile)
        value._token, value._custody, value._held, value._owner = _LABEL_TOKEN, custody, held, owner
        value._owner_state = owner.observe()
        value._baseline, value._mask, value._closed, value._case = baseline, mask, False, case
        value._binding = (case['before']['boot'], case['before']['console']['session'])
        value.guard(); return value
    except BaseException:
        for item in reversed(held): item.close()
        raise


def _label_epoch_guard(epoch, custody, profile):
    _need(type(epoch) is LabelProfile and getattr(epoch, '_token', None) is _LABEL_TOKEN
          and epoch._custody is custody and dict(profile) == dict(PROFILE), 'macos_label_profile_not_opaque')
    epoch.guard()


def _label_epoch_mask(epoch, mask):
    _need(type(epoch) is LabelProfile and epoch._token is _LABEL_TOKEN and epoch._mask == mask,
          'macos_label_profile_baseline_changed')
    epoch.guard()
