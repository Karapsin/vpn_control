    for crop in(first,second):ImageDraw.Draw(crop).rectangle((x0,y0,x1-1,y1-1),fill=(0,0,0))
    delta=ImageChops.difference(first,second).tobytes();different=sum(delta[i:i+3]!=b'\x00\x00\x00'for i in range(0,len(delta),3));first.close();second.close()
    mask=U._white_label_mask(baseline,Q.PROFILE)
    metrics={'labelMatch':label_match,'baselineForegroundPixels':sum(mask),'emptyFieldMatch':empty_match,'nonCaretFieldDifferingPixels':different,'nativeProfileMode':'exact_white_foreground_v1'};image=None

  finally:os.close(fd)
  physical();baselineheld.guard();record('profile-match-result.json',metrics)
  stage='root_after';after=root_probe('root-after');U._identity(after,c.binding,before);record('root-after.validated.json',after)
  physical();source_guard();record('source-capsule-closed.json',PINNED_CONSUMERS);record('rpc-closure.json',{'attempts':native_attempts,'allClosed':all(native_attempt_closed(x)for x in native_attempts)})
  need(all(native_attempt_closed(x)for x in native_attempts),'diagnostic_rpc_closure_unknown');need(metrics['labelMatch']is True and metrics['emptyFieldMatch']==(metrics['nonCaretFieldDifferingPixels']==0),'diagnostic_label_profile_refused');stage='complete';record('complete.json',{'operationId':args.operation_id,'state':'readonly_label_profile_qualified','captures':1,'sameIdentityBeforeAfter':True,'fullFramePersisted':False,'ordinaryCredentialAccess':False,'guiInput':False,'fullIdleAuthority':False,'newBaselineAuthority':False,'profileMode':'exact_white_foreground_v1'});print(json.dumps({'operationId':args.operation_id,'state':'readonly_label_profile_qualified',**metrics}))
 except BaseException as error:
  record('failure.json',{'operationId':args.operation_id,'stage':stage,'failureClass':type(error).__name__,'code':error.args[0]if type(error)is DiagnosticGuard and len(error.args)==1 and type(error.args[0])is str and error.args[0]in DIAGNOSTIC_CODES else 'unclassified','replayAllowed':False,'originalOutcome':'unknown_no_replay','rawExceptionTextRetained':False})
  record('rpc-closure-failed.json',{'attempts':native_attempts,'allClosed':all(native_attempt_closed(x)for x in native_attempts)})
  raise
'''

_PROFILE_WRAPPER = r'''import base64,hashlib,os,pathlib,sys
CODE=sys._getframe().f_code
P=CONFIG
sys.path.insert(0,P['project'])
from agent_tools.source_module_loader import SourceSession
sources=SourceSession(pathlib.Path(P['project'])/'agent_tools','durable_remote_job')
J=sources.module
try:
 root=pathlib.Path(P['jobRoot']);binding=J.MachineBinding.from_dict(P['hostBinding']);generation=tuple(P['jobRootGeneration'])
 J._root(root,generation);J._binding_live(binding)
 job=root/P['operationId'];intent=J._intent(job,P['operationId'],binding)
 raw=J._read(job/'program.py',J.MAX_PROGRAM_BYTES)
 if CODE!=compile(raw,'fixed-purpose-program','exec',dont_inherit=True):raise RuntimeError('controller_executed_program_changed')
 if intent['purpose']!=P['purpose']or intent['programSha256']!=hashlib.sha256(raw).hexdigest():raise RuntimeError('controller_original_program_changed')
 owner=J._record(job/'owner.json');J._correlate(owner,intent);actor=J._owner_identity(owner)
 if actor['pid']!=os.getppid()or J._birth(actor['pid'])!=actor['birth']:raise RuntimeError('controller_not_original_owner_child')
 original=base64.b64decode(P['source'],validate=True)
 if hashlib.sha256(original).hexdigest()!=P['sourceSha256']:raise RuntimeError('controller_source_invalid')
 J._create(pathlib.Path(P['driverPath']).parent/'label-profile-capture.py',base64.b64decode(P['captureSource'],validate=True));path=pathlib.Path(P['driverPath']);J._create(path,original);info=path.lstat()
 if path.read_bytes()!=original or info.st_uid!=os.getuid()or info.st_nlink!=1 or info.st_mode&0o777!=0o600:raise RuntimeError('controller_named_source_changed')
 index={'schemaVersion':1,'operationId':P['operationId'],'fixtureId':P['fixtureId'],'target':P['target'],'phase':P['phase'],'sourceSha256':P['sourceSha256'],'programSha256':intent['programSha256'],'hostBinding':P['hostBinding'],'jobRootGeneration':P['jobRootGeneration'],'originalRunOperationId':P['originalRunOperationId'],'leaseOperationId':P['leaseOperationId'],'replayAllowed':False}
 # The durable job intent existed before this index and before any driver code.
 # A missing index after lost owner launch remains UNKNOWN, never a retry.
 J._publish(pathlib.Path(P['indexPath']),index)
