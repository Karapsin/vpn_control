import hashlib,json,os,stat,subprocess,sys,time
job,stage=sys.argv[1:]
while not os.path.exists(os.path.join(job,'release')):time.sleep(.01)
intent=json.load(open(os.path.join(job,'intent.json')))
entry=os.path.join(stage,'scripts','integration','linux_owner_lifecycle_scenario.py')
runner='import pathlib,runpy,sys;p=pathlib.Path(sys.argv[1]);sys.path.insert(0,str(p.parent));sys.argv=[str(p),"--input",sys.argv[2],"--admissions",sys.argv[3],"--receipt",sys.argv[4]];runpy.run_path(str(p),run_name="__main__")'
receipt_path=os.path.join(job,'scenario-receipt.json')
def durable(name,value):
 path=os.path.join(job,name);fd=os.open(path+'.tmp',os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
 with os.fdopen(fd,'w') as f:json.dump(value,f,sort_keys=True);f.flush();os.fsync(f.fileno())
 os.replace(path+'.tmp',path);d=os.open(job,os.O_RDONLY);os.fsync(d);os.close(d)
fd=os.open(os.path.join(job,'failure.stderr'),os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
with os.fdopen(fd,'wb') as err:
 rc=subprocess.call(['/bin/sh',os.path.join(stage,'scripts','native_fixture_run.sh'),'--pid-file',os.path.join(job,'child.pid'),'--exit-file',os.path.join(job,'child.exit'),'--',sys.executable,'-I','-B','-c',runner,entry,os.path.join(stage,'scenario-input.json'),os.path.join(stage,'admissions.json'),receipt_path],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=err)
 err.flush();os.fsync(err.fileno())
evidence={'evidenceClass':'native-owner-gui-lifecycle','scenarioReceiptAvailable':False,'runnerExitCode':rc,'cleanupState':'unknown'}
try:
 fd=os.open(receipt_path,os.O_RDONLY|os.O_NOFOLLOW)
 try:
  st=os.fstat(fd)
  if not stat.S_ISREG(st.st_mode) or st.st_uid!=os.geteuid() or stat.S_IMODE(st.st_mode)!=0o600 or st.st_size>4*1024*1024:raise ValueError()
  raw=os.read(fd,4*1024*1024+1)
  if len(raw)!=st.st_size:raise ValueError()
  item=json.loads(raw)
 finally:os.close(fd)
 cleanup=item.get('cleanup')
 if item.get('schema')!='vpn-control.linux-owner-gui-lifecycle.receipt' or item.get('scenarioId')!=intent['scenarioId'] or item.get('correlationId')!=intent['correlationId'] or not isinstance(cleanup,dict):raise ValueError()
 evidence.update(scenarioReceiptAvailable=True,cleanupState=cleanup.get('state','unknown'),scenarioReceiptPath=receipt_path)
 raw_input=open(os.path.join(stage,'scenario-input.json'),'rb').read();typed=json.loads(raw_input);source=json.load(open(os.path.join(stage,'admissions.json')))['source']
 if hashlib.sha256(raw_input).hexdigest()!=intent['artifactIds']['scenarioInput'].removeprefix('sha256-') or item.get('sourceIdentity')!=typed['sourceIdentity'] or item.get('packageSourceSha')!=source['packageSourceSha']:raise ValueError()
 expected_labels=('fresh-frontend-attach','hide','show-with-fresh-XID','graceful-close-to-tray','show-after-legitimate-XID-change','exact-frontend-crash','bounded-crash-lease-expiry-with-runtime-traffic','fresh-frontend-without-tray','graceful-close-detach-without-tray','reattach-same-original-owner')
 slices=item.get('slices')
 if rc==0 and (not isinstance(slices,list) or tuple(x.get('action') if isinstance(x,dict) else None for x in slices)!=expected_labels or not all(type(x.get('frames')) is int and x['frames']>=10 and x.get('sameController') is True and x.get('sameRuntime') is True for x in slices)):rc=1
 if rc==0 and (item.get('result')!='passed' or type(item.get('frames')) is not int or item['frames']<80 or cleanup.get('state')!='complete' or not all(cleanup.get(k) is True for k in ('ownerStopped','workspaceRemoved','protectedPreserved','referencesAbsent'))):rc=1
except Exception:
 if rc==0:rc=1
durable('evidence.json',evidence)
identity=intent['identity'];receipt={k:intent[k] for k in ('scenarioId','host','environment','bundleHash','artifactIds','correlationId','jobId')}
receipt.update(pid=identity['pid'],startTicks=identity['startTicks'],exitCode=rc);durable('receipt.json',receipt)
