class ShortcutTaskPacketBindingTests(HistoryCase):
 def assemble(self,body=None,task=None):
  old_body=gzip.decompress(base64.b64decode(SHORTCUT_STALE_TASK_BODY_GZIP)).decode();old_task=gzip.decompress(base64.b64decode(SHORTCUT_STALE_TASK_ACTION_GZIP)).decode()
  body=old_body if body is None else body;task=old_task if task is None else task
  namespace={'ast':ast,'base64':base64,'hashlib':hashlib,'worker':refresh,'NONCE':'93215a74-cfa1-4336-ab10-2bcc8409ac93','CORRELATION':'ca426b5a-0484-4480-98aa-8bd598658ab8','fixture':lambda *_:(body,task)}
  exec(compile(gzip.decompress(base64.b64decode(SHORTCUT_STALE_TASK_PROGRAM_GZIP)),'actual-native-ca426-factory','exec'),namespace)
  exec(compile(SHORTCUT_PACKET_VALIDATOR_SOURCE,'actual-packet-validator','exec'),namespace)
  helper=Path(refresh.__file__).read_bytes();source,sha,body,task=namespace['program'](ScreenTests().record(),b'',helper,b'')
  return namespace,helper,source,sha,body,task
 def check(self,assembled):
  ns,helper,source,sha,body,task=assembled
  return ns['_validate_shortcut_packet'](source,sha,body,task,ns['NONCE'],ns['CORRELATION'],helper)
 def test_actual_native_stale_complete_factory_red_and_four_bindings_green(self):
  old=self.assemble()
  with self.assertRaisesRegex(ValueError,'shortcut-task-binding'):self.check(old)
  digest=hashlib.sha256(old[-1].encode()).hexdigest();stale='a6262a588f0e0025174bfd4dbee8387a1dd9fd86e000e02f1a3b8be739af8c59'
  self.assertEqual(old[-2].count(stale),4)
  new=self.assemble(old[-2].replace(stale,digest),old[-1]);self.assertTrue(self.check(new))
  for index in range(4):
   parts=new[-2].split(digest);bad=digest.join(parts[:index+1])+'f'*64+digest.join(parts[index+1:])
   with self.assertRaisesRegex(ValueError,'shortcut-task-binding'):self.check(self.assemble(bad,new[-1]))
 def test_actual_full_factory_packet_body_nonce_loader_size_hash_refusals(self):
  old=self.assemble();digest=hashlib.sha256(old[-1].encode()).hexdigest();new=self.assemble(old[-2].replace('a6262a588f0e0025174bfd4dbee8387a1dd9fd86e000e02f1a3b8be739af8c59',digest),old[-1])
  for slot,value in ((2,new[2].replace("BODY_SHA=", "BODY_SHA='foreign';unused=",1)),(3,'f'*64),(4,new[4]+'\n'),(5,new[5]+'\n')):
   bad=list(new);bad[slot]=value
   with self.assertRaises((ValueError,SyntaxError)):self.check(bad)
  tree=ast.parse(new[2]);packet=next(n for n in ast.walk(tree) if isinstance(n,ast.Dict) for k,n in zip(n.keys,n.values) if isinstance(k,ast.Constant) and k.value=='input-data');raw=base64.b64decode(packet.value)
  for changed in (b'\0'*4+raw[4:],raw[:-1],raw+b'x',raw[:4]+b'x'+raw[5:]):
   bad=list(new);bad[2]=new[2].replace(repr(packet.value),repr(base64.b64encode(changed).decode()))
   with self.assertRaisesRegex(ValueError,'shortcut-packet-bytes'):self.check(bad)
 @unittest.skipUnless(__import__('shutil').which('powershell'),'Actual Windows compressed scheduled-action consumer execution required')
 def test_actual_windows_task_consumers_old_red_new_green_without_task_effects(self):
  old=self.assemble();digest=hashlib.sha256(old[-1].encode()).hexdigest();fixed=old[-2].replace('a6262a588f0e0025174bfd4dbee8387a1dd9fd86e000e02f1a3b8be739af8c59',digest)
  ps=refresh.installed.public._ps_literal;scripts=[]
  for body in (old[-2],fixed):
   line=next(line for line in body.splitlines()if line.startswith('$cp117TaskInput='))
   guard=line[line.index('if($cp117TaskBytes.Length'):line.index(';$cp117TaskText=')]
   compressed=line[line.index('$cp117Memory='):line.index(';$cp117ActionArgument=')]
   execute="& ([ScriptBlock]::Create([Text.UTF8Encoding]::new($false,$true).GetString($v)))"
   if compressed.count(execute)!=1:raise ValueError('actual-action-execution-seam')
   compressed=compressed.replace(execute,"[Console]::Out.WriteLine('ACTION_BYTES_VERIFIED')")
   compressed=compressed.replace("if($cp117ActionEncoded.Length -ge 30000){throw 'PACKAGE_DRIFT'}",'')
   scripts.append("$cp117TaskBytes=[Convert]::FromBase64String("+ps(base64.b64encode(old[-1].encode()).decode())+");"+guard+';'+compressed+';& ([ScriptBlock]::Create($cp117ActionBootstrap))')
  script="$ErrorActionPreference='Stop';$old="+ps(scripts[0])+";$new="+ps(scripts[1])+";$red=$false;try{. ([ScriptBlock]::Create($old))}catch{if($_.Exception.Message -cne 'PACKAGE_DRIFT'){throw};$red=$true};if(-not $red){throw 'OLD_NOT_RED'};. ([ScriptBlock]::Create($new));[Console]::Out.WriteLine('TASK_CONSUMERS_CAUSAL_PASS')"
  result=_run_complete_windows_fixture(script.encode(),timeout=20)
  self.assertEqual(result.returncode,0);self.assertEqual(result.stdout.decode().strip().splitlines(),['ACTION_BYTES_VERIFIED','TASK_CONSUMERS_CAUSAL_PASS'])
