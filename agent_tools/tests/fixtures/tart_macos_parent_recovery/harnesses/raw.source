"""Controlled actual-child whole-ff32 root/RPC causal regression; no VM calls."""
import ast,hashlib,json,os,subprocess,sys,tempfile,time,types,unittest
from pathlib import Path
from unittest import mock
PROJECT=ROOT
from agent_tools import readiness_tart_macos_registry as R, readiness_qemu_jobs as protocol, durable_remote_job as J,private_inventory_lock as P
BASE=FIXTURE;BEFORE=BASE/'sources'
old_public=(BEFORE/'public.raw-loss.before.source').read_bytes()
assert hashlib.sha256(old_public).hexdigest()=='ff32dce5a6e6fa044b8700f47383648f54405c052f2aa4bd111ca1dbc9748ba4'
registry_before=BEFORE/'registry.before.source'
assert hashlib.sha256(registry_before.read_bytes()).hexdigest()=='95d683b31e22ca4d7efc037b394a9bbb44bd452e2d4880c3a4b3f235f0d6a3ab'
def functions(raw,names):
 tree=ast.parse(raw);return [n for n in ast.walk(tree)if isinstance(n,ast.FunctionDef)and n.name in names]
class Cases(unittest.TestCase):
 def exercise(self,*,current,kind,require_retention=False):
  with tempfile.TemporaryDirectory(prefix='public-rpc-loss-')as temp:
   folder=Path(temp).resolve();folder.chmod(0o700)
   native,ordinary=functions(registry_before.read_bytes(),{'_native_call','ordinary_guest_call'})
   scope=R.__dict__.copy();exec(compile(ast.Module(body=[native,ordinary],type_ignores=[]),str(registry_before),'exec'),scope)
   public_source=(b"import sys,time\nprint('original public stdout',flush=True)\nsys.stderr.write('original public stderr');sys.stderr.flush()\n"+(b'time.sleep(30)\n'if kind=='timeout'else b''))
   binding=types.SimpleNamespace(tart_binary='CONTROLLED_TART',vm_name='explicit-owned-test-vm',guest_python=sys.executable,machine='controlled-machine')
   c=types.SimpleNamespace(binding=binding,run_intent={'operationId':'2d933a39-0fb6-46a4-9fd9-02221d81c4b9'})
   calls=[]
   def guard(**kw):
    calls.append('guard');return 'original'if len(calls)==1 or kind=='timeout'else 'changed-after-dispatch'
   c.guard=guard;c._native_call=types.MethodType(scope['_native_call'],c)
   class Executor:
    provider='controlled';target='explicit-owned-test-vm';machine='controlled-machine';boot='controlled-boot';uid='502';principal='toolrecovery';home='/Users/toolrecovery'
    def execute(self,argv,*,payload):return scope['ordinary_guest_call'](c,binding,argv,payload,time.monotonic()+(.15 if kind=='timeout'else 3))
   def need(value,reason):
    if not value:raise RuntimeError(reason)
   def save(path,value):path.write_bytes(value if type(value)is bytes else json.dumps(value).encode())
   root_scope={'physical':lambda:None,'R':types.SimpleNamespace(guest_probe_source=lambda *_a,**_kw:public_source),
    'backend':types.SimpleNamespace(binding=binding),'c':types.SimpleNamespace(guest_proof={'prefix':'/controlled','publicFiles':{}}),
    'protocol':protocol,'save':save,'folder':folder,'args':types.SimpleNamespace(target='explicit-owned-test-vm',fixture_id='controlled',operation_id='controlled'),
    'hashlib':hashlib,'executor':Executor(),'need':need,'capture_phase':{'value':'root-before'}}
   node=functions(old_public,{'root_probe'})[0];exec(compile(ast.Module(body=[node],type_ignores=[]),str(BEFORE/'public.raw-loss.before.source'),'exec'),root_scope)
   with P.Directory(folder)as out:
    if current:
     raw=(BASE/'sources/capture.source').read_bytes();module=types.ModuleType('held_capture');exec(compile(raw,str(BASE/'sources/capture.source'),'exec'),module.__dict__)
     def record(name,value):
      body=value if type(value)is bytes else json.dumps(value).encode();fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=out.fd)
      with os.fdopen(fd,'wb')as f:f.write(body);f.flush();os.fsync(f.fileno())
     hook_scope={'capture_guard':lambda:None,'need':need,'descriptor':{'binding':{'vm_name':binding.vm_name,'machine':binding.machine}},'protocol':protocol,
      'native_callbacks':[],'native_attempts':[],'sys':sys,'capture_phase':{'value':'root-before'},'native_record':record,'args':root_scope['args'],'hashlib':hashlib,
      'capture_module':module,'capture_out':out,'time':time,'J':J,'R':R}
     hook=functions((BASE/'sources/public.current.source').read_bytes(),{'join_native_capture','native_attempt_closed','captured_native'})
     exec(compile(ast.Module(body=hook,type_ignores=[]),str(BASE/'sources/public.current.source'),'exec'),hook_scope)
     c._native_call=types.MethodType(hook_scope['captured_native'],c)
    real=subprocess.Popen;children=[]
    def launch(argv,**kw):
     if argv[0]!='CONTROLLED_TART':return real(argv,**kw)
     self.assertEqual(argv[:4],['CONTROLLED_TART','exec','-i','explicit-owned-test-vm'])
     # Full fixed stdin gate and its real source payload execute in an actual
     # controlled Python process; only the absent provider CLI is translated.
     child=real(argv[4:],**kw);children.append(child);return child
    try:
     with mock.patch.object(subprocess,'Popen',launch):
      with self.assertRaises(Exception):root_scope['root_probe']('root-before')
    finally:
     for child in children:
      if child.poll()is None:child.kill();child.wait()
    if current:
     stdout=(folder/'call-1-root-before.stdout.json').read_bytes();stderr=(folder/'call-1-root-before.stderr.txt').read_bytes()
     callbacks=[json.loads(row)for row in(folder/'call-1-root-before.capture.jsonl').read_bytes().splitlines()]
     self.assertEqual(stdout,b'original public stdout\n',repr((stderr,callbacks)));self.assertEqual(stderr,b'original public stderr')
     self.assertTrue(callbacks[-1]['actorAbsent']);self.assertTrue(callbacks[-1]['stdoutEof']and callbacks[-1]['stderrEof'])
     if kind=='timeout':self.assertTrue(callbacks[-1]['partial']);self.assertEqual(callbacks[-1]['failure'],'timeout')
     else:self.assertFalse(callbacks[-1]['partial']);self.assertIsNone(callbacks[-1]['failure'])
    else:
     if require_retention:self.assertTrue((folder/'root-before.stdout.json').exists(),'wholeff32 root_probe lost original raw before semantic guard')
     self.assertFalse((folder/'root-before.stdout.json').exists());self.assertFalse((folder/'root-before.stderr.txt').exists())
    self.assertTrue((folder/'root-before.request.stdin').exists())
    self.assertTrue(all(child.poll()is not None for child in children))
 def test_whole_old_root_postguard_loses_raw_current_native_hook_retains(self):
  self.exercise(current=False,kind='postguard');self.exercise(current=True,kind='postguard')
 def test_whole_old_root_timeout_loses_raw_current_native_hook_retains(self):
  self.exercise(current=False,kind='timeout');self.exercise(current=True,kind='timeout')
if __name__=='__main__':unittest.main(verbosity=2)
