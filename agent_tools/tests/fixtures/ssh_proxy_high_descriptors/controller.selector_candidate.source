   except OSError as error:
    self._update(diagnostic,connectPhase='failed',connectErrno=self._errno(error),closed=True);client.close();continue
   self._update(diagnostic,connectPhase='connected')
   pair={'client':client,'upstream':upstream,'closed':False,'peer':list(client.getpeername()),'local':list(client.getsockname()),'diagnostic':diagnostic}
   with self.lock:self.pairs.append(pair)
