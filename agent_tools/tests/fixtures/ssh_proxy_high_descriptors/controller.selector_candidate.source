  phase('dispatching')
  _,ready=rw.ensure_ssh(root,host,operation,deadline=min(deadline,time.monotonic()+180))
  guard();selected=master.status(root,'gateway')
  if selected.get('state')!='ready':raise ValueError('readiness_original_master_not_ready')
  phase('ready',connection=ready.connection,masterState=selected['state'],pairCount=len(proxy.pairs))
  save(root/'readiness-result.json',{'schemaVersion':1,'operationId':operation,'state':'ready','purpose':'readiness-only','identities':list(ready.identities()),'master':{k:selected.get(k)for k in('state','recoveryId','child','socketPath')},'noRemoteMutationJob':True,'replayAllowed':False})
