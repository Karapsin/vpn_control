def phase(name,**metadata):
 allowed={'source-admitted','proxy-ready','dispatching','ready','failed','closed'}
 if name not in allowed or any(type(v)not in(bool,int,str,type(None))or(type(v)is str and len(v)>256)for v in metadata.values()):raise ValueError('readiness_phase_schema')
 save(HERE/'direct'/('phase-'+name+'.json'),{'schemaVersion':1,'operationId':NEW_OPERATIONS['direct'],'phase':name,**metadata})

def main(args,*,absolute_deadline=None):
 if args.mode!='direct' or type(args.budget)is not int or args.budget!=180:raise ValueError('readiness_fixed_plan_invalid')
 mode='direct';root=HERE/'direct';host='gateway';operation=NEW_OPERATIONS['direct'];started=time.monotonic();deadline=started+180
 if absolute_deadline is not None:
  if type(absolute_deadline)not in(int,float)or not math.isfinite(absolute_deadline)or absolute_deadline<=0:raise ValueError('local_owner_absolute_deadline_invalid')
  deadline=min(deadline,absolute_deadline)
