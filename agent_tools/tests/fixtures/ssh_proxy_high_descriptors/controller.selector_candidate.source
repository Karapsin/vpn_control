 sys.path.insert(0,str(root))
 from agent_tools import ssh_transport as t,readiness_workflow as rw,readiness_ssh_master as master,readiness_nested_channel as nested,ssh_fresh_nested_channel as channel,private_config_custody as private,ssh_channel_keeper_entry as keeper
 from agent_tools.ssh_keeper_sdk_custody import producer_actor
 manifest=read(HERE/'public-source-manifest.json')['sources'];holders=[];secret_holders=[];clients=[];proxy=None;capsule_holders={};checkout_holders={};explicit_consumers=set(CRITICAL)|{'agent_tools/mcp_server.py','agent_tools/ssh_keeper_mcp_relay.py','agent_tools/ssh_keeper_mcp_delivery.py','agent_tools/tool_action_policy.py','agent_tools/tool_action_policy.json'}
 try:
  for p in (Path(__file__),HERE/'ordinary_retention.py',HERE/'public-source-manifest.json',root/'route-template.private.json',root/'planned-operation.json'):
   holders.append(SourceHold(p))
  helper_hold=next(h for h in holders if h.path==HERE/'ordinary_retention.py')
  if hashlib.sha256(helper_hold.raw).hexdigest()!=RETENTION_SHA:raise ValueError('reviewed_retention_helper_changed')
  import types
  retention=types.ModuleType('_current_ordinary_retention');retention.__file__=str(helper_hold.path);sys.modules[retention.__name__]=retention
  exec(compile(helper_hold.raw,retention.__file__,'exec'),retention.__dict__);helper_hold.guard()
  def current_consumers():
   values=set(explicit_consumers)
   for module in tuple(sys.modules.values()):
    name=getattr(module,'__file__',None)
    if not isinstance(name,str):continue
    try:relative=str(Path(name).resolve().relative_to(root))
    except ValueError:continue
    if relative in manifest:values.add(relative)
   for intent_path in (root/'.rag_index/ssh-program-execution').glob('*/intent.json'):
    try:value=read(intent_path)
    except (FileNotFoundError,json.JSONDecodeError):continue
    for relative in value.get('sourcePins',{}):
     if relative not in manifest:raise ValueError('actual_consumer_outside_manifest')
     values.add(relative)
   return values
  for relative,digest in manifest.items():
   held=SourceHold(root/relative)
   if hashlib.sha256(held.raw).hexdigest()!=digest:raise ValueError('capsule_source_manifest_changed')
   capsule_holders[relative]=held;holders.append(held)
  def guard():
   for h in holders:h.guard()
   for h in secret_holders:h.check()
   for relative in current_consumers():
    if relative not in checkout_holders:
     counterpart=SourceHold(CHECKOUT/relative)
     if hashlib.sha256(counterpart.raw).hexdigest()!=manifest[relative]or counterpart.raw!=capsule_holders[relative].raw:raise ValueError('consumed_source_counterpart_changed')
     checkout_holders[relative]=counterpart;holders.append(counterpart)
    checkout_holders[relative].guard()
   for rel,digest in CRITICAL.items():
    if manifest[rel]!=digest:raise ValueError('reviewed_production_source_changed')
  def guarded():guard();return True
  original=private.PrivateConfigCustody(CHECKOUT/'.vm-hosts.local.json');secret_holders.append(original)
  original_config=json.loads(bytes(original._raw));template=read(root/'route-template.private.json');gateway=template['hosts']['gateway']
  # Exact public transport identity must still join the originally configured
  # trusted targets; only the independent control selector and proxy alias vary.
  fields=('host','port','user','identityFile','knownHostsFile')
  if any(gateway[k]!=original_config['hosts']['gateway'][k]for k in fields)or original_config['hosts']['gateway'].get('transport','direct')!='direct'or original_config['hosts']['gateway'].get('proxyJump')is not None or original_config['hosts']['gateway'].get('password')is not None:raise ValueError('configured_gateway_changed')
  trust_holder=SourceHold(Path(gateway['knownHostsFile']));holders.append(trust_holder)
  for path in {gateway['identityFile']}:
   held=private.PrivateConfigCustody(Path(path));secret_holders.append(held)
  for rel in ('.rag_index/readiness-transport/archlinux/current.json','.rag_index/readiness-transport/archlinux/e385088e4d6554b33579efc3e8bde1f0a2efa31e190afd919cd469d1228234b9.intent.json','.rag_index/readiness-transport-v2/archlinux/current.json','.rag_index/readiness-nested-channel/archlinux/current.json'):
   secret_holders.append(private.PrivateConfigCustody(CHECKOUT/rel))
  planned=read(root/'planned-operation.json')
