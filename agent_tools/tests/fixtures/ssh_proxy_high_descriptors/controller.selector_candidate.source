   inventory['hosts']['gateway'].update(host='127.0.0.1',port=proxy.port,knownHostsFile=str(root/'known_hosts'))
  save(root/'.vm-hosts.local.json',inventory);secret_holders.append(private.PrivateConfigCustody(root/'.vm-hosts.local.json'))
  config=t.load_config(root);guard();save(root/'source-admission.json',{'operationId':operation,'capsulePublicFilesHeld':len(capsule_holders),'consumedSources':{relative:manifest[relative]for relative in sorted(current_consumers())},'allPublicSourceDescriptorsHeld':True,'privateConfigAndKeyContentHashed':False})
  phase('source-admitted',sourceClosing=True)
  phase('proxy-ready',pairCount=len(proxy.pairs),listenerPort=proxy.port)
  guard()
