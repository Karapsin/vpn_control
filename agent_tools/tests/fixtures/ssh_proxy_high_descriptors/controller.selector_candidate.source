  save(root/'operation.json',{'operationId':operation,'purpose':'readiness-only','mode':'direct','host':'gateway','budgetSeconds':180,'sourcePins':CRITICAL,'protectedSharedCorrelation':SHARED_CORR,'protectedSharedConnection':SHARED_CONNECTION,'noRemoteMutationJob':True,'noVMOrLifecycleActions':True})
  os.environ['PYTHONDONTWRITEBYTECODE']='1'
  save(root/'ssh-boundary.json',{'schemaVersion':1,'realSsh':'/usr/bin/ssh','realSshGeneration':list(fingerprint(os.stat('/usr/bin/ssh'))),'faultInjection':False})
  inventory=json.loads(json.dumps(template))
