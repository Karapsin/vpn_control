  try:
   selector=selectors.DefaultSelector()
   selector.register(pair['client'],selectors.EVENT_READ)
   selector.register(pair['upstream'],selectors.EVENT_READ)
   while not self.stopped:
    phase='select';direction=None;self._update(diagnostic,forwardPhase=phase,direction=direction)
    ready=selector.select(.1)
    for key,_ in ready:
     s=key.fileobj
     direction='client-to-upstream'if s is pair['client']else'upstream-to-client';phase='read';self._update(diagnostic,forwardPhase=phase,direction=direction)
     raw=s.recv(65536)
     with self.lock:
      key='clientReads'if s is pair['client']else'upstreamReads';diagnostic[key]+=1
      key='clientReadBytes'if s is pair['client']else'upstreamReadBytes';diagnostic[key]+=len(raw)
     if not raw:self._update(diagnostic,forwardPhase='eof',eofDirection=direction);return
     phase='write';self._update(diagnostic,forwardPhase=phase,direction=direction)
     (pair['upstream']if s is pair['client']else pair['client']).sendall(raw)
     with self.lock:
      key='clientToUpstreamBytes'if s is pair['client']else'upstreamToClientBytes';diagnostic[key]+=len(raw)
  except (OSError,ValueError)as error:self._update(diagnostic,forwardPhase=phase,direction=direction,forwardErrno=self._errno(error),forwardErrorClass='os-error'if isinstance(error,OSError)else'value-error')
  finally:
   if selector is not None:selector.close()
   pair['closed']=True
   for s in (pair['client'],pair['upstream']):
    try:s.close()
    except OSError:pass
   self._update(diagnostic,closed=True)
 def drop_once(self,path,master):
  with self.lock:live=[p for p in self.pairs if not p['closed']]
  if len(live)!=1:raise ValueError('private_proxy_original_pair_unresolved')
  pair=live[0]
