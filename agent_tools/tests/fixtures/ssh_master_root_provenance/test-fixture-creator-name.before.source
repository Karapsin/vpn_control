"""Complete fixed master.status, real child/socket, separate TMPDIR observers."""
from pathlib import Path
from types import ModuleType,SimpleNamespace
from contextlib import ExitStack
import ast,gc,hashlib,json,os,socket,stat,subprocess,sys,tempfile,unittest,uuid
HERE=Path(__file__).resolve().parent;REPO=HERE.parents[4];sys.path.insert(0,str(REPO))
from agent_tools import ssh_transport as transport
from agent_tools import private_inventory_lock as private
PINS={'before':'478a1f2772bd7af9624d7a494f9c6e893641367143d245f79b130e4fc5c5d706','fixed':'ee9fbb43f5413dd2b63d33d5c0db604694fa0c47ab9c13288bac689e00f91a29'}
def source(kind):
    p=HERE/('readiness_ssh_master.'+kind+'.source');raw=p.read_bytes()
    if hashlib.sha256(raw).hexdigest()!=PINS[kind]:raise ValueError('master_fixture_changed')
    return p,raw

def load(kind):
    p,raw=source(kind);m=ModuleType('agent_tools._controlled_master_'+uuid.uuid4().hex);m.__file__=str(p);m.__package__='agent_tools';sys.modules[m.__name__]=m;exec(compile(raw,str(p),'exec'),m.__dict__);return m

WORKER='''from pathlib import Path
from types import ModuleType,SimpleNamespace
import hashlib,json,sys
v=json.loads(sys.stdin.buffer.read());sys.path.insert(0,v['repo'])
from agent_tools import ssh_transport as transport
p=Path(v['source']);raw=p.read_bytes();assert hashlib.sha256(raw).hexdigest()==v['sha']
m=ModuleType('agent_tools._separate_master_observer');m.__file__=str(p);m.__package__='agent_tools';sys.modules[m.__name__]=m;exec(compile(raw,str(p),'exec'),m.__dict__)
r=Path(v['root']);config=transport.SshConfig(r,{'controlled':transport.SshHost('controlled','127.0.0.1',1,'public-test',r/'dummy-key',r/'public-trust')})
try:
 out=m.status(r,'controlled',config);print(json.dumps({'state':out['state'],'recoveryId':out['recoveryId']}))
except ValueError as e:
 reason=str(e)
 if reason not in ('master_socket_provenance','master_socket_parent_changed','master_socket_changed','master_actor_changed','private','socket'):reason='other-fixed-refusal'
 print(json.dumps({'state':'blocked','reason':reason}))
'''

CREATOR_WORKER="from pathlib import Path\nfrom types import ModuleType\nimport hashlib,json,os,sys,time\nv=json.loads(sys.stdin.buffer.read());sys.path.insert(0,v['repo'])\np=Path(v['source']);raw=p.read_bytes();assert hashlib.sha256(raw).hexdigest()==v['sha']\nm=ModuleType('agent_tools._exact_creator');m.__file__=str(p);m.__package__='agent_tools';sys.modules[m.__name__]=m;exec(compile(raw,str(p),'exec'),m.__dict__)\nroot=Path(v['root']);marker=root/'controlled-spawn-boundary.json'\nif v['forceForeignRoot']:m._socket_temp_root=lambda:Path(v['foreignRoot'])\ndef boundary(argv,stderr_path):\n intents=list((root/m.GROUP/'controlled').glob('*.intent.json'));assert len(intents)==1\n intent=json.loads(intents[0].read_bytes())\n root_value=str(Path(intent['socketPath']).parent.parent)\n with marker.open('x')as f:json.dump({'calls':1,'root':root_value,'guardedOriginalIntent':True},f)\n raise RuntimeError('controlled-before-real-SSH')\nm.session._spawn=boundary\ntry:m.start(root,'controlled','c'*64,deadline=time.monotonic()+5)\nexcept RuntimeError as e:assert str(e)=='controlled-before-real-SSH'\nexcept m.MasterUnknown as e:assert str(e)=='master_socket_provenance'\nprint(json.dumps({'calls':1,'root':json.loads(marker.read_bytes())['root']}if marker.exists()else{'calls':0,'intentCount':len(list((root/m.GROUP/'controlled').glob('*.intent.json')))}))\n"

@unittest.skipUnless(os.name=='posix','requires POSIX private directory and actual process/UNIX socket metadata')
class OriginalMasterRoot(unittest.TestCase):
    def setUp(self):
        self.stack=ExitStack();self.addCleanup(self.stack.close)
        self.root=Path(self.stack.enter_context(tempfile.TemporaryDirectory())).resolve(strict=True);self.root.chmod(0o700)
        for name,body in(('dummy-key',b'public-test-dummy-key-not-a-credential\n'),('public-trust',b'public-test-trust\n')):
            p=self.root/name;p.write_bytes(body);p.chmod(0o600)
        self.creator=load('before');self.fixed=load('fixed')
        self.config=transport.SshConfig(self.root,{'controlled':transport.SshHost('controlled','127.0.0.1',1,'public-test',self.root/'dummy-key',self.root/'public-trust')})
        self.parent=Path(self.stack.enter_context(tempfile.TemporaryDirectory(prefix='vcrd-',dir=Path('/tmp').resolve())));self.parent.chmod(0o700)
        self.listener=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);self.listener.bind(str(self.parent/'m'));(self.parent/'m').chmod(0o600);self.listener.listen(8);self.addCleanup(self.listener.close)
        self.child=subprocess.Popen([sys.executable,'-I','-B','-c','import sys;sys.stdin.buffer.read(1)'],stdin=subprocess.PIPE,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL);self.addCleanup(self.child_close)
        self.actor=self.creator.keeper.actor(self.child.pid);self.rid='a'*64
        self.journal=self.creator.initialize(self.root,'controlled')
        self.intent={'version':1,'host':'controlled','recoveryId':self.rid,'machine':self.creator.identity(self.config,'controlled'),'socketPath':str(self.parent/'m'),'socketParent':self.creator.session._directory(self.parent),'idleSeconds':18000}
        with private.Directory(self.journal)as d:
            self.creator._save(d,self.rid+'.intent.json',self.intent)
            self.creator._save(d,self.rid+'.child.json',{'recoveryId':self.rid,'pid':self.child.pid,'actor':self.actor})
            self.creator._save(d,self.rid+'.ready.json',{'recoveryId':self.rid,'masterActor':self.actor,'socketFingerprint':self.creator.session._socket(self.parent/'m',self.intent['socketParent'])})
            self.creator._publish(d,self.rid)
    def child_close(self):
        if not self.child.stdin.closed:self.child.stdin.close()
        self.assertEqual(self.child.wait(timeout=5),0)
    def observe(self,kind,tmpdir):
        p,raw=source(kind);v={'repo':str(REPO),'source':str(p),'sha':hashlib.sha256(raw).hexdigest(),'root':str(self.root)}
        r=subprocess.run([sys.executable,'-I','-B','-c',WORKER],input=json.dumps(v).encode(),capture_output=True,env={'PATH':os.defpath,'TMPDIR':str(tmpdir)},timeout=15)
        self.assertEqual((r.returncode,r.stderr),(0,b''));return json.loads(r.stdout)
    def republish_under(self,base):
        parent=Path(self.stack.enter_context(tempfile.TemporaryDirectory(prefix='vcrd-',dir=base))).resolve(strict=True);parent.chmod(0o700)
        if len(os.fsencode(parent/'m'))>=90:self.skipTest('native temp socket path exceeds qualified 90-byte limit')
        listener=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);self.addCleanup(listener.close);listener.bind(str(parent/'m'));(parent/'m').chmod(0o600);listener.listen(1)
        rid='b'*64;intent={**self.intent,'recoveryId':rid,'socketPath':str(parent/'m'),'socketParent':self.creator.session._directory(parent)}
        with private.Directory(self.journal)as directory:
            self.creator._save(directory,rid+'.intent.json',intent)
            self.creator._save(directory,rid+'.child.json',{'recoveryId':rid,'pid':self.child.pid,'actor':self.actor})
            self.creator._save(directory,rid+'.ready.json',{'recoveryId':rid,'masterActor':self.actor,'socketFingerprint':self.creator.session._socket(parent/'m',intent['socketParent'])})
            self.creator._publish(directory,rid)
        self.rid=rid
    def test_var_tmp_original_survives_other_observer_default(self):
        base=Path('/var/tmp').resolve()
        if not base.is_dir()or base.stat().st_uid!=0 or stat.S_IMODE(base.stat().st_mode)!=0o1777:self.skipTest('host has no qualified OS /var/tmp root')
        self.republish_under(base)
        different=Path(self.stack.enter_context(tempfile.TemporaryDirectory()))
        self.assertEqual(self.observe('fixed',different),{'state':'ready','recoveryId':self.rid})
    @unittest.skipUnless(sys.platform=='darwin','Darwin native per-UID temporary root')
    def test_native_darwin_private_root_survives_other_default(self):
        value=subprocess.run(['/usr/bin/getconf','DARWIN_USER_TEMP_DIR'],capture_output=True,timeout=3,env={'PATH':os.defpath,'LC_ALL':'C'})
        self.assertEqual((value.returncode,value.stderr),(0,b''));base=Path(value.stdout.decode().rstrip('\n')).resolve(strict=True)
        self.republish_under(base)
        different=Path(self.stack.enter_context(tempfile.TemporaryDirectory()))
        self.assertEqual(self.observe('fixed',different),{'state':'ready','recoveryId':self.rid})
    def test_authentic_fixture_alias_root_before_red_resolved_green(self):
        pins={'test-fixture-uncanonical-root.before.source':'83974b43af38f4199f855df8ab58558e1259112427e175134f381c07c6bb7c00','test-fixture-canonical-root.fixed.source':'259d8314814494f77260333f395794ad17f2e1f5a09f6db0634c9191c6b3141f'}
        with tempfile.TemporaryDirectory(dir=Path('/tmp').resolve())as directory:
            root=Path(directory);real=root/'real';real.mkdir(mode=0o700);alias=root/'alias';alias.symlink_to(real,target_is_directory=True)
            for fixed,name in((False,'test-fixture-uncanonical-root.before.source'),(True,'test-fixture-canonical-root.fixed.source')):
                raw=(HERE/name).read_bytes();self.assertEqual(hashlib.sha256(raw).hexdigest(),pins[name]);tree=ast.parse(raw)
                setup=next(n for n in ast.walk(tree)if isinstance(n,ast.FunctionDef)and n.name=='setUp')
                assignment=next(n for n in setup.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Attribute)and t.attr=='root'for t in n.targets))
                with ExitStack()as stack:
                    owner=SimpleNamespace(stack=stack);env={'self':owner,'Path':Path,'tempfile':SimpleNamespace(TemporaryDirectory=lambda:tempfile.TemporaryDirectory(dir=alias))}
                    exec(compile(ast.Module(body=[assignment],type_ignores=[]),'actual-fixture-root-assignment','exec'),env)
                    if fixed:
                        with private.Directory(owner.root)as held:held.guard()
                    else:
                        with self.assertRaises(OSError):private.Directory(owner.root)
    def creator(self,kind,force_foreign=False):
        root=Path(self.stack.enter_context(tempfile.TemporaryDirectory())).resolve(strict=True);root.chmod(0o700)
        for name in('dummy-key','public-trust'):
            p=root/name;p.write_bytes((self.root/name).read_bytes());p.chmod(0o600)
        inventory={'schemaVersion':1,'hosts':{'controlled':{'host':'127.0.0.1','port':1,'user':'public-test','identityFile':str(root/'dummy-key'),'knownHostsFile':str(root/'public-trust'),'transport':'direct'}}}
        p=root/'.vm-hosts.local.json';p.write_text(json.dumps(inventory));p.chmod(0o600)
        if kind=='creator-before':
            p=HERE/'readiness_ssh_master.creator.before.source';digest='072411377f0bcbb3b822aefc826ee3428ba4f019ae5035194c7f51d07129185a'
        else:p,_=source('fixed');digest=PINS['fixed']
        self.assertEqual(hashlib.sha256(p.read_bytes()).hexdigest(),digest)
        foreign=Path(self.stack.enter_context(tempfile.TemporaryDirectory(dir=Path('/tmp').resolve())))
        value={'repo':str(REPO),'source':str(p),'sha':digest,'root':str(root),'forceForeignRoot':force_foreign,'foreignRoot':str(foreign)}
        r=subprocess.run([sys.executable,'-I','-B','-c',CREATOR_WORKER],input=json.dumps(value).encode(),capture_output=True,timeout=15,env={'PATH':os.defpath,'TMPDIR':str(foreign)})
        self.assertEqual((r.returncode,r.stderr),(0,b''));return json.loads(r.stdout),foreign
    def test_complete_creator_ignores_custom_tmpdir_before_launch(self):
        old,foreign=self.creator('creator-before');self.assertEqual(old,{'calls':1,'root':str(foreign)})
        current,_=self.creator('fixed');self.assertEqual(current['calls'],1);self.assertIn(Path(current['root']),{Path('/tmp').resolve(),Path('/var/tmp').resolve()})
    def test_complete_creator_refuses_bad_root_before_admission_or_launch(self):
        current,_=self.creator('fixed',force_foreign=True);self.assertEqual(current,{'calls':0,'intentCount':0})
    def test_whole_original_separate_process_changed_tmpdir_red_green(self):
        different=Path(self.stack.enter_context(tempfile.TemporaryDirectory()))
        self.assertEqual(self.observe('before',different),{'state':'blocked','reason':'master_socket_provenance'})
        self.assertEqual(self.observe('fixed',different),{'state':'ready','recoveryId':self.rid})
    def test_system_root_status_same_owner_socket_unchanged(self):
        out=self.fixed.status(self.root,'controlled',self.config);self.assertEqual(out['state'],'ready');self.assertEqual(out['child']['actor'],self.actor)
    def test_foreign_private_tmpdir_is_not_adopted(self):
        foreign=Path(self.stack.enter_context(tempfile.TemporaryDirectory(dir=Path('/tmp').resolve())));parent=foreign/'owned';parent.mkdir(mode=0o700)
        intent={**self.intent,'socketPath':str(parent/'m'),'socketParent':self.creator.session._directory(parent)}
        with self.assertRaisesRegex(self.fixed.MasterUnknown,'^master_socket_provenance$'):self.fixed._socket(intent)
    def test_parent_inode_replacement_stops(self):
        old=self.parent.with_name(self.parent.name+'-old');self.parent.rename(old);self.parent.mkdir(mode=0o700);self.addCleanup(lambda:old.rmdir())
        self.addCleanup(lambda:(old/'m').unlink(missing_ok=True))
        with self.assertRaisesRegex(self.fixed.MasterUnknown,'^master_socket_parent_changed$'):self.fixed.status(self.root,'controlled',self.config)
    def test_parent_changes_after_absolute_check_old_red_final_fd_green(self):
        p=HERE/'readiness_ssh_master.parent-closing.before.source';raw=p.read_bytes();self.assertEqual(hashlib.sha256(raw).hexdigest(),'770136aa4b7db3beba519fb78e2dfac0683050785cb8eb3c5eb9d1f1d846b96c')
        old=ModuleType('agent_tools._parent_closing_before');old.__file__=str(p);old.__package__='agent_tools';sys.modules[old.__name__]=old;exec(compile(raw,str(p),'exec'),old.__dict__)
        for fixed,module in((False,old),(True,self.fixed)):
            parent=Path(self.stack.enter_context(tempfile.TemporaryDirectory(prefix='vcrd-',dir=Path('/tmp').resolve())));parent.chmod(0o700)
            intent={**self.intent,'socketPath':str(parent/'m'),'socketParent':self.creator.session._directory(parent)}
            retired=parent.with_name(parent.name+'-retired');original=module.session._directory
            def replace_after_check(path):
                actual=original(path)
                if Path(path)==parent:
                    parent.rename(retired);parent.mkdir(mode=0o700)
                return actual
            module.session._directory=replace_after_check
            try:
                if fixed:
                    with self.assertRaisesRegex(module.MasterUnknown,'^master_socket_parent_changed$'):module._socket(intent)
                else:self.assertEqual(module._socket(intent),parent/'m')
            finally:
                module.session._directory=original
                if retired.exists():retired.rmdir()
    def test_parent_permissions_change_stops(self):
        self.parent.chmod(0o755)
        with self.assertRaisesRegex(self.fixed.MasterUnknown,'^master_socket_parent_changed$'):self.fixed.status(self.root,'controlled',self.config)
    def test_socket_inode_replacement_stops(self):
        (self.parent/'m').unlink();replacement=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);self.addCleanup(replacement.close);replacement.bind(str(self.parent/'m'));(self.parent/'m').chmod(0o600);replacement.listen(1)
        with self.assertRaisesRegex(self.fixed.MasterUnknown,'^master_socket_changed$'):self.fixed.status(self.root,'controlled',self.config)
    def test_socket_permissions_change_stops(self):
        (self.parent/'m').chmod(0o666)
        with self.assertRaises(ValueError):self.fixed.status(self.root,'controlled',self.config)
    def test_symlink_parent_not_adopted(self):
        link=self.parent.with_name(self.parent.name+'-link');link.symlink_to(self.parent,target_is_directory=True);self.addCleanup(link.unlink)
        with self.assertRaisesRegex(self.fixed.MasterUnknown,'^master_socket_provenance$'):self.fixed._socket({**self.intent,'socketPath':str(link/'m')})
    def test_parent_traversal_not_adopted(self):
        path=self.parent/'..'/self.parent.name/'m'
        with self.assertRaisesRegex(self.fixed.MasterUnknown,'^master_socket_provenance$'):self.fixed._socket({**self.intent,'socketPath':str(path)})
    def test_owned_world_writable_root_not_system_authority(self):
        if os.getuid()==0:self.skipTest('requires ordinary UID to distinguish root policy')
        self.parent.chmod(0o1777)
        self.assertFalse(self.fixed._socket_root_secure(self.parent.stat(),'system'))
        self.assertFalse(self.fixed._socket_root_secure(self.parent.stat(),'private'))
    def test_private_root_requires_private_mode(self):
        self.assertTrue(self.fixed._socket_root_secure(self.parent.stat(),'private'));self.parent.chmod(0o755);self.assertFalse(self.fixed._socket_root_secure(self.parent.stat(),'private'))
    def test_unknown_root_kind_has_no_authority(self):self.assertFalse(self.fixed._socket_root_secure(self.parent.stat(),'other'))
    def test_root_descriptor_closes_after_positive_and_refusal(self):
        gc.collect();before=len(os.listdir('/dev/fd'))
        self.fixed._socket(self.intent);self.parent.chmod(0o755)
        with self.assertRaises(ValueError):self.fixed._socket(self.intent)
        self.assertEqual(len(os.listdir('/dev/fd')),before)

if __name__=='__main__':unittest.main(verbosity=2)
