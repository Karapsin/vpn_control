"""Once-only least-privilege preparation of two exact owned launchd log files."""
import os,stat,json,hashlib,pwd,subprocess,resource
from pathlib import Path
resource.setrlimit(resource.RLIMIT_CORE,(0,0))
OPERATION='0e630317-c863-451b-94bf-cb8bf505df56'
assert os.geteuid()==0
boot=subprocess.run(["/usr/sbin/sysctl","-n","kern.bootsessionuuid"],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,check=True).stdout.decode("ascii").strip()
assert boot=="87AC272F-619B-4CC0-B9FC-3E32DAEE5B18"
account=pwd.getpwnam("toolrecovery");assert account.pw_uid==502 and account.pw_gid==20 and account.pw_dir=="/Users/toolrecovery"
plist=Path("/Library/LaunchDaemons/com.vpn-control.tool-recovery.agent.plist");info=plist.lstat();assert stat.S_ISREG(info.st_mode)and info.st_uid==0 and not info.st_mode&0o022 and hashlib.sha256(plist.read_bytes()).hexdigest()=='7dd0b139e5b7f0c567c6a8810e015132699ecb3620c39769768181d28eff0c80'
assert os.readlink("/var")=="private/var"
fds=[os.open("/",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)]
try:
 for name in("private","var","log"):
  fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fds[-1]);fds.append(fd);info=os.fstat(fd)
  assert stat.S_ISDIR(info.st_mode)and info.st_uid==0 and not info.st_mode&0o022
 logfd=fds[-1];before=os.fstat(logfd);assert Path("/var/log").resolve()==Path("/private/var/log")
 names=("vpn-tool-recovery-agent.err.log","vpn-tool-recovery-agent.out.log")
 for name in names:
  try:os.stat(name,dir_fd=logfd,follow_symlinks=False)
  except FileNotFoundError:pass
  else:raise RuntimeError("owned_log_not_proven_absent")
 journal=Path("/private/var/db/vpn-control-agent-log-repair-"+OPERATION);journal.mkdir(mode=0o700)
 def record(name,value):
  fd=os.open(journal/name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
  with os.fdopen(fd,"w")as stream:json.dump(value,stream,sort_keys=True);stream.flush();os.fsync(stream.fileno())
 record("original-unknown.json",{"operationId":OPERATION,"state":"unknown","boot":boot,"targetUid":502,"parentDevice":before.st_dev,"parentInode":before.st_ino,"action":"create_two_absent_owned_logs_only"})
 rows=[]
 for name in names:
  fd=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=logfd)
  try:
   os.fchown(fd,502,20);os.fchmod(fd,0o600);os.fsync(fd);info=os.fstat(fd)
   assert stat.S_ISREG(info.st_mode)and(info.st_uid,info.st_gid,stat.S_IMODE(info.st_mode),info.st_nlink)==(502,20,0o600,1)
   row={"name":name,"device":info.st_dev,"inode":info.st_ino,"uid":info.st_uid,"gid":info.st_gid,"mode":stat.S_IMODE(info.st_mode)};rows.append(row);record(name+".json",row)
  finally:os.close(fd)
 after=os.stat("/private/var/log",follow_symlinks=False);assert(after.st_dev,after.st_ino)==(before.st_dev,before.st_ino)
 result={"operationId":OPERATION,"state":"owned_logs_ready_original_launchd_registration_untouched","files":rows,"guestBoot":boot,"journal":str(journal)}
 record("complete.json",result);print(json.dumps(result,sort_keys=True))
finally:
 for fd in reversed(fds):os.close(fd)
