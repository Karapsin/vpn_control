OUT=pathlib.Path(__file__).resolve().parent
INTENT=json.loads((OUT/'intent.json').read_text());OP=INTENT['operationId']
ORIGINAL='0dd55704-1e80-4d62-8d9d-2f0a123e0c3b';PREDECESSOR='7310f227-aaed-4f3b-878a-1b7bf0b49215'
ORIGIN=pathlib.Path('/Users/karapsin_de/projects/vpn_control/.runtime/parity-evidence/android-current-original-lease-retirement-7310f227-aaed-4f3b-878a-1b7bf0b49215')
MANIFEST_SHA='30ead6e10e0cc5c6fef027a2cab984cd28bb52ae7fedeb5e68d59552ece6bbe8';PROGRAM_SHA='982dd6db1743fa2b14a5bc79dc575551eab10a880db0db27860d0fafb34f94da';ADMISSION_SHA='93ff56ef99d2496aef690ea1ae44e0e7ff4136386e6718fa81e8f0ff21e2e6ed'
