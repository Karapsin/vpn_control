import hashlib,re,json
TARGET_PATH = r"\updates\vpn-control-2.2.2.msi"
TARGET_SIZE = 131101044
TARGET_SHA = "f8a8741bcfd22c04be50836aa22da77009105ab1b63df4d9b7648397779a8dfc"

def catalogue(snapshot):
 if type(snapshot)is not str or len(snapshot.encode())>65536:raise ValueError('public-workspace-bound')
 rows={}
 for line in snapshot.splitlines():
  size,separator,row=line.partition(':')
  if not separator or not size.isdecimal()or int(size)!=len(row.encode('utf-16le'))//2:raise ValueError('public-workspace-framing')
  fields=row.split('|',3)
  if len(fields)!=4 or fields[0]not in ('D','F')or fields[1]in rows:raise ValueError('public-workspace-row')
  path=fields[1]
  if path and(not path.startswith('\\')or '/'in path or '..'in path.split('\\')):raise ValueError('public-workspace-path')
  rows[path]=(fields[0],fields[2],fields[3])
 if ''not in rows or rows[''][0]!='D' or r'\workspace.json'not in rows:raise ValueError('public-workspace-original')
 return rows

def conservation(before,after,phase,owner_pids,install_binding=None):
 if phase not in ('owner','download','install','cleanup')or type(owner_pids)is not tuple or not 1<=len(owner_pids)<=2 or any(type(p)is not int or not 1<=p<=2147483647 for p in owner_pids)or len(set(owner_pids))!=len(owner_pids):raise ValueError('public-workspace-phase')
 old=catalogue(before);new=catalogue(after)
 generated={r'\activation.port',r'\vpn-control.lock'}
 if phase in ('download','install','cleanup'):generated|={TARGET_PATH,TARGET_PATH+'.part'}
 if phase in ('install','cleanup'):
  if type(install_binding)is not tuple or len(install_binding)!=2 or any(type(p)is not str or not re.fullmatch(r'[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}',p)for p in install_binding):raise ValueError('public-install-journal-binding')
  key='{"controllerId":"'+install_binding[0]+'","operationId":"'+install_binding[1]+'"}'
  generated.add(r'\.install-correlation-'+hashlib.sha256(key.encode()).hexdigest()+'.json')
 # Existing unrelated files are never excluded by size, extension or directory.
 for path,row in old.items():
  if path in generated:continue
  if path not in new:raise ValueError('public-workspace-deleted')
  other=new[path]
  if row[0]=='D':
   a=row[1].split(':');b=other[1].split(':')
   if len(a)!=8 or len(b)!=8 or row[0]!=other[0]or a[:6]!=b[:6]or row[2]!=other[2]:raise ValueError('public-workspace-directory-drift')
  elif row!=other:raise ValueError('public-workspace-original-drift')
 if set(new)-set(old)-generated:raise ValueError('public-workspace-foreign-delta')
 if phase in ('download','install','cleanup'):
  if TARGET_PATH not in new or TARGET_PATH+'.part' in new:raise ValueError('public-target-terminal')
  target=new[TARGET_PATH];native=target[1].split(':');body=target[2].split('|',1)
  if target[0]!='F' or len(native)!=11 or any(not re.fullmatch(r'0|[1-9][0-9]*',p)for p in native)or int(native[8])*4294967296+int(native[9])!=TARGET_SIZE or native[10]!='1' or len(body)!=2 or body[0]!=TARGET_SHA.upper():raise ValueError('public-target-identity')
 return {'phase':phase,'originalRows':len(old),'generatedRows':sorted(set(new)&generated),'conserved':True}

def public_workspace_cs(source):
 marker=' public static string Snapshot(string root)'
 if source.count(marker)!=1:raise ValueError('public-workspace-source')
 original=source[source.index(marker):source.rfind('\n}')]
 new=original.replace('Snapshot(string root)','PublicSnapshot(string root,string phase,int ownerPid)')
 opening='{var items='
 if new.count(opening)!=1:raise ValueError('public-workspace-open')
 new=new.replace(opening,'{if(root!=@"C:\\Users\\vpncp117\\AppData\\Local\\VpnControl\\cp166\\state"||(phase!="owner"&&phase!="download"&&phase!="install"&&phase!="cleanup")||ownerPid<=0)throw new IOException("PUBLIC_WORKSPACE_SCOPE");long target=0;var items=')
 call='Budget(p.Substring(root.Length),n,ref normal,ref retained,seen);'
 if new.count(call)!=1:raise ValueError('public-workspace-budget-source')
 budget=r""" static void PublicBudget(string relative,long n,string phase,ref long normal,ref long retained,ref long target,HashSet<string> seen){
  bool isTarget=relative==@"\updates\vpn-control-2.2.2.msi",isPartial=relative==@"\updates\vpn-control-2.2.2.msi.part";
  if(isTarget||isPartial){if(phase=="owner"||n<0||n>131101044||isTarget&&n!=131101044)throw new IOException("PUBLIC_TARGET_SIZE");target+=n;if(target>131101044)throw new IOException("PUBLIC_TARGET_BUDGET");}
  else Budget(relative,n,ref normal,ref retained,seen);
 }
"""
 replacement=r"""string relative=p.Substring(root.Length);bool isTarget=relative==@"\updates\vpn-control-2.2.2.msi";PublicBudget(relative,n,phase,ref normal,ref retained,ref target,seen);"""
 new=new.replace(call,replacement)
 row='items.Add("F|"+p.Substring(root.Length)+"|"+FileRow(p,n));'
 if new.count(row)!=1:raise ValueError('public-workspace-file-source')
 new=new.replace(row,'string captured=(relative==@"\\activation.port"||relative==@"\\vpn-control.lock")?ActiveRow(p,n):FileRow(p,n);if(isTarget&&captured.Split(\'|\')[1]!= "F8A8741BCFD22C04BE50836AA22DA77009105AB1B63DF4D9B7648397779A8DFC")throw new IOException("PUBLIC_TARGET_HASH");'+row.replace('FileRow(p,n)','captured'))
 start=source.index(' static string FileRow(');end=source.index('\n static void Budget(',start)
 active=source[start:end].replace('FileRow(','ActiveRow(',1).replace('FileShare.Read)','FileShare.ReadWrite)')
 return source[:source.rfind('\n}')]+ '\n'+active+'\n'+budget+'\n'+new+'\n}'

def complete_task_argument(source):
 import base64,gzip
 if type(source)is not str or not 0<len(source.encode())<=65536:raise ValueError('public-task-source-bound')
 data=source.encode();compressed=gzip.compress(data,mtime=0);packed=base64.b64encode(compressed).decode()
 if len(packed)>16384:raise ValueError('public-task-packed-bound')
 # The complete source invocation uses the natively proved f050 quoting class:
 # ASCII-only known template, a closed base64 payload, and no double quote.
 bootstrap="$ErrorActionPreference='Stop';$i=[IO.MemoryStream]::new([Convert]::FromBase64String('"+packed+"'));$z=[IO.Compression.GZipStream]::new($i,[IO.Compression.CompressionMode]::Decompress);$o=[IO.MemoryStream]::new();try{$b=New-Object byte[] 4096;while(($n=$z.Read($b,0,$b.Length)) -gt 0){$o.Write($b,0,$n);if($o.Length -gt 65536){throw 'REFRESH_SOURCE_BOUND'}};$v=$o.ToArray();if($v.Length -ne "+str(len(data))+" -or [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($v)).Replace('-','').ToLowerInvariant() -cne '"+hashlib.sha256(data).hexdigest()+"'){throw 'REFRESH_SOURCE_HASH'};& ([ScriptBlock]::Create([Text.UTF8Encoding]::new($false,$true).GetString($v)))}finally{$z.Dispose();$i.Dispose();$o.Dispose()}"
 if any(ord(c)<32 or ord(c)>126 or c=='"'for c in bootstrap):raise ValueError('public-task-quoting')
 argument='-NoProfile -NonInteractive -Command "'+bootstrap+'"'
 executable=r'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'
 if len('"'+executable+'" '+argument)>=30000:raise ValueError('public-task-command-bound')
 return {'argument':argument,'argumentSha256':hashlib.sha256(argument.encode()).hexdigest(),'taskSha256':hashlib.sha256(data).hexdigest(),'taskBytes':len(data),'packedBytes':len(compressed),'fullCommandChars':len('"'+executable+'" '+argument)}


def compact_public_phase(source):
 import base64,gzip
 if type(source)is not str or not 0<len(source.encode())<=32768:raise ValueError('public-phase-source-bound')
 data=source.encode();packed=base64.b64encode(gzip.compress(data,mtime=0)).decode();sha=hashlib.sha256(data).hexdigest()
 return "$cp117BlockInput=[IO.MemoryStream]::new([Convert]::FromBase64String('"+packed+"'));$cp117BlockZip=[IO.Compression.GZipStream]::new($cp117BlockInput,[IO.Compression.CompressionMode]::Decompress);$cp117BlockOut=[IO.MemoryStream]::new();try{[byte[]]$chunk=New-Object byte[] 4096;while(($n=$cp117BlockZip.Read($chunk,0,$chunk.Length)) -gt 0){if($cp117BlockOut.Length+$n -gt "+str(len(data))+"){throw 'PUBLIC_PHASE_BOUND'};$cp117BlockOut.Write($chunk,0,$n)};[byte[]]$body=$cp117BlockOut.ToArray();if($body.Length -ne "+str(len(data))+" -or [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($body)).Replace('-','').ToLowerInvariant() -cne '"+sha+"'){throw 'PUBLIC_PHASE_HASH'};. ([ScriptBlock]::Create([Text.UTF8Encoding]::new($false,$true).GetString($body)))}finally{$cp117BlockZip.Dispose();$cp117BlockInput.Dispose();$cp117BlockOut.Dispose()}"

def complete_parent_argument(source):
 # Exact existing tls_program parent limits: 65536 decoded source and the
 # complete native command below30000. The ordinary task16384 limit is separate.
 import base64,gzip
 if type(source)is not str or not 0<len(source.encode())<=65536:raise ValueError('public-parent-source-bound')
 data=source.encode();packed=base64.b64encode(gzip.compress(data,mtime=0)).decode()
 bootstrap="$ErrorActionPreference='Stop';$i=[IO.MemoryStream]::new([Convert]::FromBase64String('"+packed+"'));$z=[IO.Compression.GZipStream]::new($i,[IO.Compression.CompressionMode]::Decompress);$o=[IO.MemoryStream]::new();try{$b=New-Object byte[] 4096;while(($n=$z.Read($b,0,$b.Length)) -gt 0){$o.Write($b,0,$n);if($o.Length -gt 65536){throw 'PACKAGE_SOURCE_BOUND'}};$v=$o.ToArray();if($v.Length -ne "+str(len(data))+" -or [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($v)).Replace('-','').ToLowerInvariant() -cne '"+hashlib.sha256(data).hexdigest()+"'){throw 'PACKAGE_SOURCE_HASH'};& ([ScriptBlock]::Create([Text.UTF8Encoding]::new($false,$true).GetString($v)))}finally{$z.Dispose();$i.Dispose();$o.Dispose()}"
 if any(ord(c)<32 or ord(c)>126 or c=='"'for c in bootstrap):raise ValueError('public-parent-quoting')
 argument='-NoProfile -NonInteractive -Command "'+bootstrap+'"';executable=r'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'
 if len('"'+executable+'" '+argument)>=30000:raise ValueError('public-parent-command-bound')
 return {'argument':argument,'argumentSha256':hashlib.sha256(argument.encode()).hexdigest(),'sourceSha256':hashlib.sha256(data).hexdigest(),'sourceBytes':len(data),'packedBase64Bytes':len(packed),'fullCommandChars':len('"'+executable+'" '+argument)}

def public_phase_carrier(original,body,correlation,nonce,validator_source,input_bytes=b'',terminal_parser_source=''):
 import ast,base64,uuid
 if type(original)is not str or type(body)is not str or type(validator_source)is not str:raise ValueError('public-carrier-input')
 for value in (correlation,nonce):
  if type(value)is not str or str(uuid.UUID(value))!=value:raise ValueError('public-carrier-uuid')
 if type(input_bytes)is not bytes or len(input_bytes)>32768:raise ValueError('public-carrier-frame-bound')
 tree=ast.parse(original)
 constants={}
 for node in tree.body:
  if isinstance(node,ast.Assign)and len(node.targets)==1 and isinstance(node.targets[0],ast.Name)and node.targets[0].id in ('D','NONCE','BODY_SHA','ENCODED'):
   if node.targets[0].id in constants:raise ValueError('public-carrier-duplicate')
   constants[node.targets[0].id]=node
 if set(constants)!={'D','NONCE','BODY_SHA','ENCODED'}:raise ValueError('public-carrier-constants')
 sha=hashlib.sha256(body.encode('utf-16le')).hexdigest()
 full="[Console]::Out.WriteLine(('CP117-READ "+nonce+" "+sha+" '+$PID))\n"+body
 invocation=complete_parent_argument(full)['argument']
 prefix='-NoProfile -NonInteractive -Command "'
 if not invocation.startswith(prefix)or not invocation.endswith('"'):raise ValueError('public-carrier-command')
 replacement={'D':correlation,'NONCE':nonce,'BODY_SHA':sha,'ENCODED':invocation[len(prefix):-1]}
 raw=original.encode();offsets=[0]
 for line in raw.splitlines(keepends=True):offsets.append(offsets[-1]+len(line))
 # Multiple authenticated assignments share one production line. Replace
 # exact AST byte spans, preserving every other assignment and guard byte.
 for node in sorted(constants.values(),key=lambda n:(n.lineno,n.col_offset),reverse=True):
  start=offsets[node.lineno-1]+node.col_offset;end=offsets[node.end_lineno-1]+node.end_col_offset
  name=node.targets[0].id;raw=raw[:start]+(name+'='+repr(replacement[name])).encode()+raw[end:]
 source=raw.decode();tree=ast.parse(source)
 old=next(node for node in tree.body if isinstance(node,ast.FunctionDef)and node.name=='validate')
 vtree=ast.parse(validator_source)
 if any(not isinstance(node,(ast.FunctionDef,ast.Assign,ast.Import,ast.ImportFrom))for node in vtree.body)or not any(isinstance(node,ast.FunctionDef)and node.name=='validate'for node in vtree.body):raise ValueError('public-carrier-validator')
 lines=source.splitlines(keepends=True);lines[old.lineno-1:old.end_lineno]=[validator_source+'\n'];source=''.join(lines)
 callsite="'-EncodedCommand',ENCODED"
 if source.count(callsite)!=1:raise ValueError('public-carrier-consumer')
 source=source.replace(callsite,"'-Command',ENCODED")
 if input_bytes:
  # The exact public source frame is consumed BEFORE guest submission. The
  # following line remains the original guest PID acknowledgement unchanged.
  anchor=" guards();child=call(LEAF+'/qga.sock','guest-exec',"
  if source.count(anchor)!=1:raise ValueError('public-carrier-ingress')
  reader="\n def public_input_frame():\n  n="+str(len(input_bytes))+"\n  parts=[];left=n\n  while left:\n   item=sys.stdin.buffer.read(left)\n   need(bool(item),'public-input-eof');parts.append(item);left-=len(item)\n  raw=b''.join(parts)\n  need(hashlib.sha256(raw).hexdigest()=="+repr(hashlib.sha256(input_bytes).hexdigest())+",'public-input-hash')\n  raw.decode('utf-8','strict')\n  return base64.b64encode(raw).decode('ascii')\n PUBLIC_INPUT=public_input_frame()\n"
  source=source.replace(anchor,reader+anchor)
  payload="'capture-output':True})"
  if source.count(payload)!=1:raise ValueError('public-carrier-input-consumer')
  source=source.replace(payload,"'capture-output':True,'input-data':PUBLIC_INPUT})")
 if terminal_parser_source:
  ptree=ast.parse(terminal_parser_source)
  if len(ptree.body)!=2 or any(not isinstance(n,ast.FunctionDef)for n in ptree.body)or [n.name for n in ptree.body]!=['_public_unique','parse_terminal']:raise ValueError('public-carrier-parser-shape')
  tree=ast.parse(source);parsers=[n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='parse_terminal']
  if len(parsers)!=1:raise ValueError('public-carrier-parser-slot')
  oldparser=parsers[0];lines=source.splitlines(keepends=True)
  lines[oldparser.lineno-1:oldparser.end_lineno]=[terminal_parser_source+'\n'];source=''.join(lines)
 if len(source.encode())>131072:raise ValueError('public-carrier-source-bound')
 compile(source,'<string>','exec')
 return source,sha,invocation

def admit_public_phase(value,events,status,source,correlation,nonce,sha,qemu,capture,private=False):
 import ast,os,base64
 from typing import Any
 def equal(a,b):return json.dumps(a,sort_keys=True,separators=(',',':'))==json.dumps(b,sort_keys=True,separators=(',',':'))
 if type(private)is not bool or type(status)is not dict or type(status.get('returncode'))is not int or status['returncode']!=0 or any(status.get(k)is not True for k in ('pipesClosed','sourceFrameWritten','ackWritten'))or type(status.get('birth'))is not str or not status['birth']:raise ValueError('public-phase-transport')
 if type(value)is not dict or set(value)!={'state','facts','qemu','guestChildPid','appAdmission','installerAction'}or value['state']!='observed'or value['appAdmission']is not False or value['installerAction']is not False or not equal(value['qemu'],qemu):raise ValueError('public-phase-response')
 if type(events)is not list or not 2<=len(events)<=82:raise ValueError('public-phase-events')
 submitted=[];terminal=[];child=None
 for index,item in enumerate(events):
  if type(item)is not dict or set(item)!={'event','pin'}:raise ValueError('public-phase-event')
  name=correlation+'-event-%d.json'%index;capture.verify(name,item['pin'])
  fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=capture.fd)
  try:
   pieces=[];remaining=262145
   while remaining:
    part=os.read(fd,min(4096,remaining))
    if not part:break
    pieces.append(part);remaining-=len(part)
   raw=b''.join(pieces)
  finally:os.close(fd)
  capture.verify(name,item['pin'])
  if len(raw)>262144 or not equal(json.loads(raw),item['event']):raise ValueError('public-phase-event-pin')
  e=item['event'];base={'diagnosticId','nonce','sourceSha256','qemu','kind'}
  if type(e)is not dict or any(e.get(k)!=v for k,v in {'diagnosticId':correlation,'nonce':nonce,'sourceSha256':sha}.items())or not equal(e.get('qemu'),qemu):raise ValueError('public-phase-source')
  kind=e.get('kind');expected={'submitted':{'pid'},'poll':{'pid','poll','exited'},'terminal':{'pid','poll','publicResult'if private else'payload'}}
  if type(kind)is not str or kind not in expected or set(e)!=base|expected[kind]:raise ValueError('public-phase-event-schema')
  if type(e['pid'])is not int or not 1<=e['pid']<=2147483647:raise ValueError('public-phase-pid')
  if kind=='submitted':
   if index!=0 or child is not None:raise ValueError('public-phase-one-child')
   child=e['pid'];submitted.append(e)
  elif child is None or e['pid']!=child:raise ValueError('public-phase-same-child')
  if kind in ('poll','terminal')and(type(e['poll'])is not int or not 1<=e['poll']<=80):raise ValueError('public-phase-poll')
  if kind=='poll'and e['exited']is not None and type(e['exited'])is not bool:raise ValueError('public-phase-exited')
  if kind=='terminal':
   if index!=len(events)-1:raise ValueError('public-phase-terminal-order')
   terminal.append(e)
 if len(submitted)!=1 or len(terminal)!=1 or type(value['guestChildPid'])is not int or value['guestChildPid']!=child:raise ValueError('public-phase-completion')
 # This is the existing source-bound validator closure, never the transport
 # or task code. The caller must hold/authenticate source before this boundary.
 tree=ast.parse(source);starts=[n for n in tree.body if isinstance(n,ast.Import)and[x.name for x in n.names]==['re','types']];ends=[n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='parse_terminal']
 if len(starts)!=1 or len(ends)!=1:raise ValueError('public-phase-validator-slot')
 nodes=[n for n in tree.body if starts[0].lineno<=n.lineno<=ends[0].lineno]
 if any(isinstance(n,ast.ClassDef)or isinstance(n,ast.ImportFrom)and not(n.module=='typing'and n.level==0 and len(n.names)==1 and n.names[0].name=='Mapping'and n.names[0].asname is None)for n in nodes):raise ValueError('public-phase-validator-closure')
 ns={'base64':base64,'json':json,'Any':Any,'hashlib':hashlib};exec(compile(ast.Module(body=nodes,type_ignores=[]),'<source-bound-public-phase-validator>','exec'),ns)
 ns['validate'](value['facts'])
 if private:
  native=terminal[0]['publicResult'];ns['validate'](native)
 else:
  payload=terminal[0]['payload']
  if type(payload)is not dict:raise ValueError('public-phase-terminal-payload')
  native=ns['parse_terminal'](payload,nonce,sha,child)
 if native is None or not equal(native,value['facts']):raise ValueError('public-phase-native-binding')
 return native

def private_admin_parser_source():
 return """def _public_unique(pairs):
 value={}
 for key,item in pairs:
  if key in value:raise ValueError('private-admin-duplicate')
  value[key]=item
 return value

def parse_terminal(value,nonce,sha,pid):
 if type(value)is not dict or value.get('exited')is not True:return None
 if type(value.get('exitcode'))is not int or value['exitcode']!=0 or value.get('out-truncated')or value.get('err-truncated'):raise ValueError('private-admin-exit')
 raw=base64.b64decode(value.get('out-data',''),validate=True)
 err=base64.b64decode(value.get('err-data',''),validate=True)
 if len(raw)>4096 or err:raise ValueError('private-admin-raw-bound')
 header,separator,payload=raw.partition(b'\\n')
 if not separator or header.rstrip(b'\\r')!=('CP117-READ %s %s %d'%(nonce,sha,pid)).encode():raise ValueError('private-admin-header')
 return validate(json.loads(payload.decode('utf-8','strict'),object_pairs_hook=_public_unique,parse_constant=lambda v:(_ for _ in ()).throw(ValueError('private-admin-json'))))
"""

def private_admin_callbacks(correlation,nonce,sha,qemu,account):
 import copy
 if any(type(x)is not str for x in (correlation,nonce,sha,account))or not re.fullmatch(r'uacfix-[0-9a-f]{12}',account)or type(qemu)is not dict:raise ValueError('private-admin-declaration')
 expected=copy.deepcopy(qemu)
 def same(a,b):return json.dumps(a,sort_keys=True,separators=(',',':'))==json.dumps(b,sort_keys=True,separators=(',',':'))
 def public_result(v):
  keys={'version','state','correlationId','account','sid','administrator'}
  if type(v)is not dict or set(v)!=keys or type(v['version'])is not int or v['version']!=1 or v['state']!='created'or v['correlationId']!=correlation or v['account']!=account or v['administrator']is not True:raise ValueError('private-admin-result')
  if type(v['sid'])is not str or len(v['sid'])>184 or not re.fullmatch(r'S-1-5-21-(?:[0-9]{1,10}-){3}[0-9]{1,10}',v['sid'])or any(int(n)>4294967295 for n in v['sid'].split('-')[4:]):raise ValueError('private-admin-sid')
  return copy.deepcopy(v)
 def event(v):
  base={'diagnosticId','nonce','sourceSha256','qemu','kind'}
  if type(v)is not dict or not base<=set(v)or v['diagnosticId']!=correlation or v['nonce']!=nonce or v['sourceSha256']!=sha or not same(v['qemu'],expected):raise ValueError('private-admin-event-binding')
  kind=v['kind'];extra={'submitted':{'pid'},'poll':{'pid','poll','exited'},'terminal':{'pid','poll','publicResult'},'exception':{'phase'}}
  if type(kind)is not str or kind not in extra or set(v)!=base|extra[kind]:raise ValueError('private-admin-event-schema')
  if kind!='exception'and(type(v['pid'])is not int or not 1<=v['pid']<=2147483647):raise ValueError('private-admin-pid')
  if kind in ('poll','terminal')and(type(v['poll'])is not int or not 1<=v['poll']<=80):raise ValueError('private-admin-poll')
  if kind=='poll'and v['exited']is not None and type(v['exited'])is not bool:raise ValueError('private-admin-exited')
  if kind=='exception'and v['phase']!='private-admin-unknown':raise ValueError('private-admin-exception')
  result=copy.deepcopy(v)
  if kind=='terminal':result['publicResult']=public_result(v['publicResult'])
  return result
 def response(v):
  if type(v)is not dict:raise ValueError('private-admin-response')
  if set(v)=={'state','phase','appAdmission','installerAction','replayAllowed'}and v['state']=='unknown'and v['phase']=='private-admin-unknown'and all(v[k]is False for k in ('appAdmission','installerAction','replayAllowed')):return copy.deepcopy(v)
  if set(v)!={'state','facts','qemu','guestChildPid','appAdmission','installerAction'}or v['state']!='observed'or v['appAdmission']is not False or v['installerAction']is not False or not same(v['qemu'],expected)or type(v['guestChildPid'])is not int or not 1<=v['guestChildPid']<=2147483647:raise ValueError('private-admin-response')
  return {'state':'observed','facts':public_result(v['facts']),'qemu':copy.deepcopy(expected),'guestChildPid':v['guestChildPid'],'appAdmission':False,'installerAction':False}
 return public_result,event,response

def private_admin_phase_carrier(original,body,correlation,nonce,validator_source):
 # Secret-dependent material never enters public source, argv or a digest.
 # The exact 2048-byte private frame is held in memory; trailing padding is
