 $candidates=@(Get-CimInstance Win32_Process -Filter "Name='vpn-control-install-helper.exe'" -ErrorAction Stop)
 if($candidates.Count -lt 1 -or $candidates.Count -gt 2){throw 'PUBLIC_POST_COORDINATOR_COUNT'}
 $coordinators=[Collections.Generic.List[object]]::new();$users=[Collections.Generic.List[object]]::new()
 foreach($candidate in $candidates){
  if($candidate.ExecutablePath -cne $cp117PostBinding.helperPath -or $candidate.SessionId -ne 1){throw 'PUBLIC_POST_FOREIGN_HELPER'}
  $candidateArgv=[Cp117PublicCoordinatorArgv]::Read([string]$candidate.CommandLine)
  if($candidateArgv[0] -cne $cp117PostBinding.helperPath -or $candidateArgv[2] -cne $cp117PostBinding.jobId -or $candidateArgv[3] -cne ([string]$cp117PostBinding.ownerPid) -or $candidateArgv[4] -cne $cp117PostBinding.ownerBirth){throw 'PUBLIC_POST_FOREIGN_JOB'}
  if($candidateArgv[1] -ceq 'install-coordinator'){$coordinators.Add($candidate)}elseif($candidateArgv[1] -ceq 'install-user'){
   $userProcess=Get-Process -Id $candidate.ProcessId -ErrorAction Stop
   try{$userBirth=[Cp117PublicCoordinatorArgv]::Birth([IntPtr]$userProcess.Handle);$userToken=[Cp117OwnerToken]::Read([int]$candidate.ProcessId,[long]$userBirth)
    if($userProcess.HasExited -or ($userToken -join '|') -cne 'S-1-5-21-2404255130-2183793310-3766671872-1002|0|3|False|False|1'){throw 'PUBLIC_POST_USER_TOKEN'}
    $users.Add(@{pid=[int]$candidate.ProcessId;birth=[string]$userBirth;sid=$userToken[0];sessionId=1;elevated=$false})
   }finally{$userProcess.Dispose()}
  }else{throw 'PUBLIC_POST_FOREIGN_ROLE'}
 }
 if($coordinators.Count -ne 1 -or $users.Count -gt 1){throw 'PUBLIC_POST_COORDINATOR_ROLES'};$native=$coordinators[0]
 if($native.ProcessId -le 0 -or $native.ProcessId -gt 2147483647 -or $native.ExecutablePath -cne $cp117PostBinding.helperPath -or $native.SessionId -ne 1){throw 'PUBLIC_POST_COORDINATOR_PATH'}
 $process=Get-Process -Id $native.ProcessId -ErrorAction Stop;$handle=$process.Handle;$birth=[Cp117PublicCoordinatorArgv]::Birth([IntPtr]$handle);$token=[Cp117OwnerToken]::Read([int]$native.ProcessId,[long]$birth)
 if($process.HasExited -or $token.Length -ne 6 -or $token[0] -cne $cp117PostBinding.adminSid -or $token[1] -cne '1' -or $token[2] -cne '2' -or $token[3] -cne 'True' -or $token[4] -cne 'True' -or $token[5] -cne '1'){throw 'PUBLIC_POST_COORDINATOR_TOKEN'}
 $argv=[Cp117PublicCoordinatorArgv]::Read([string]$native.CommandLine)
 if($argv[0] -cne $cp117PostBinding.helperPath -or $argv[1] -cne 'install-coordinator' -or $argv[2] -cne $cp117PostBinding.jobId -or $argv[3] -cne ([string]$cp117PostBinding.ownerPid) -or $argv[4] -cne $cp117PostBinding.ownerBirth){throw 'PUBLIC_POST_COORDINATOR_ARGUMENTS'}
 $expected='"install-coordinator" "'+$cp117PostBinding.jobId+'" "'+$cp117PostBinding.ownerPid+'" "'+$cp117PostBinding.ownerBirth+'"';$argsSha=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($expected))).Replace('-','').ToLowerInvariant()
 $lastNative=Get-CimInstance Win32_Process -Filter ('ProcessId='+$native.ProcessId) -ErrorAction Stop;$lastToken=[Cp117OwnerToken]::Read([int]$native.ProcessId,[long]$birth);$last=[Cp117InstalledFile]::Read($cp117PostBinding.helperPath)
 if($process.HasExited -or $lastNative.ExecutablePath -cne $native.ExecutablePath -or $lastNative.CommandLine -cne $native.CommandLine -or $lastNative.SessionId -ne 1 -or ($lastToken -join '|') -cne ($token -join '|') -or $last[0] -cne $first[0] -or $last[1] -cne $first[1] -or $sddl -cne [IO.File]::GetAccessControl($cp117PostBinding.helperPath).GetSecurityDescriptorSddlForm([Security.AccessControl.AccessControlSections]::All)){throw 'PUBLIC_POST_COORDINATOR_DRIFT'}
 foreach($row in $cp117PostDirectoryRows){$pin=[string]$cp117PostDirMethod.Invoke($null,[object[]]@([string]$row.path));if((($pin.Split(':')[0..5])-join ':') -cne $row.identity -or $row.sddl -cne [IO.Directory]::GetAccessControl($row.path).GetSecurityDescriptorSddlForm([Security.AccessControl.AccessControlSections]::All) -or ([IO.File]::GetAttributes($row.path) -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'PUBLIC_POST_PARENT_DRIFT'}}
 if($process.HasExited -or [Cp117PublicCoordinatorArgv]::Birth([IntPtr]$handle) -ne $birth){throw 'PUBLIC_POST_PROCESS_CLOSING'}
 $cp117PostResult=@{version=1;state='observed';correlationId=$cp117PostBinding.correlationId;jobId=$cp117PostBinding.jobId;pid=[int]$native.ProcessId;birth=[string]$birth;sid=$token[0];sessionId=1;elevated=$true;administratorsEnabled=$true;helperPath=$cp117PostBinding.helperPath;helperSha256=$first[0];helperIdentity=$first[1];helperSddl=$sddl;argumentsSha256=$argsSha;originalUserHelpers=@($users.ToArray());ownerPid=[int]$cp117PostBinding.ownerPid;ownerBirth=$cp117PostBinding.ownerBirth;installerAction=$false;taskAction=$false;replayAllowed=$false}
}finally{if($null -ne $cp117PostFile){$cp117PostFile.Dispose()};foreach($held in $cp117PostParents){$held.Dispose()};if($null -ne $process){$process.Dispose()}}
"""

def public_collection_phase(original_source,prefix,fragment,suffix,submission,pins,phase,correlation,nonce):
    if phase not in ('authorization','terminal')or type(submission)is not dict or type(pins)is not tuple or len(pins)!=3:raise ValueError('public-collection-phase')
    expected_corr,task_sha,image_sha=pins
    task_name='VpnControlPublicUpdate-'+expected_corr
    fields={'outcome','taskName','actionSha256','taskSha256','imageSha256','rootIdentity','rootSddl','taskFileIdentity','imageFileIdentity','role','taskActor','taskRunLevel','installerCompleted','replayAllowed'}
    if set(submission)!=fields or expected_corr!='6815bdda-18db-42e7-8d48-99a7a8af39aa' or submission['taskName']!=task_name or submission['taskSha256']!=task_sha or submission['imageSha256']!=image_sha or submission['outcome']!='submitted' or submission['role']!='SYSTEM' or submission['taskActor']!='S-1-5-21-2404255130-2183793310-3766671872-1002' or submission['taskRunLevel']!='Limited' or submission['installerCompleted']is not False or submission['replayAllowed']is not False:raise ValueError('public-collection-original')
    action_sha=submission['actionSha256']
    if any(type(v)is not str or not re.fullmatch(r'[0-9a-f]{64}',v)for v in (task_sha,image_sha,action_sha)):raise ValueError('public-collection-source')
    if type(submission.get('rootIdentity'))is not str or not re.fullmatch(r'[0-9]+(?::[0-9]+){7}',submission['rootIdentity']) or type(submission.get('rootSddl'))is not str or len(submission['rootSddl'])>2048 or "'"in submission['rootSddl']:raise ValueError('public-collection-root')
    root=r'C:\Users\vpncp117\AppData\Local\VpnControl\mcp-public-update-'+expected_corr
    values={'@ROOT@':"'"+root+"'",'@TASK_NAME@':"'"+task_name+"'",'@PHASE@':phase,'@ROOT_ID@':submission['rootIdentity'],'@ROOT_SDDL@':submission['rootSddl'],'@ARGUMENT_SHA@':action_sha,'@CORRELATION@':expected_corr}
    for key,value in values.items():
        if key not in fragment:raise ValueError('public-collection-placeholder')
        fragment=fragment.replace(key,value)
    if re.search(r'@[A-Z_]+@',fragment):raise ValueError('public-collection-placeholder')
    # The exact three template bytes are authenticated by the whole driver holder.
    body=prefix+fragment+suffix
    import ast
    tree=ast.parse(PUBLIC_FACTORY_SOURCE_FOR_VALIDATOR)
    validator='\n'.join(ast.get_source_segment(PUBLIC_FACTORY_SOURCE_FOR_VALIDATOR,n)for n in tree.body if isinstance(n,ast.FunctionDef)and n.name in ('public_collection_names','validate_public_collection'))+'\n'
    validator+='PUBLIC_SUBMISSION='+repr(submission)+'\nPUBLIC_PINS='+repr(pins)+'\nPUBLIC_PHASE='+repr(phase)+'\n'
    validator+="def validate(value):\n if type(value)is not dict or set(value)!={'outcome','facts'}or value['outcome']!='complete':raise ValueError('public-record-wrapper')\n validate_public_collection(value['facts'],PUBLIC_PHASE,PUBLIC_SUBMISSION,*PUBLIC_PINS)\n return value\n"
    return public_phase_carrier(original_source,body,correlation,nonce,validator,terminal_parser_source=compressed_public_parser_source())


from pathlib import Path
"""Fixed complete-flow phase executor; source-only draft, no automatic entry point.
The caller supplies the original authenticated current-guest context obtained by
unchanged recovery/source/outer guards. Native dispatch requires whole-flow review.
"""
import ast,hashlib,json,os
from pathlib import Path

PUBLIC_PHASE_IDS={'preflight': ('dc5a2db4-e0f1-45c2-8dd1-639858536e2c', '720eaecf-5305-48eb-a38e-e7765744ce52'), 'admin-create': ('4b99ce29-e252-42cb-b031-60d023f01ee2', '3cc2cc73-4452-4962-868f-832714274134'), 'public-start': ('6815bdda-18db-42e7-8d48-99a7a8af39aa', '90c25455-07b1-4663-b10a-d21aaee3a9c7'), 'authorization-read': ('1b7dc827-7bdf-4747-8bdb-268c1b41f136', '5995e94e-0c1a-449c-a9d8-dccbd0f39812'), 'consent-observe': ('146d250c-0c60-4baf-9fa9-f81648c0f18d', 'ce23e6c7-9422-45e6-8a2a-2cfa49ddc527'), 'post-consent': ('8f0395d2-bdbe-4a5f-81ba-4a2c9b3c901d', '743a03cb-cf80-4f4d-b2cb-f18e44dc3b42'), 'terminal-read': ('abf3ea17-8d7e-43c9-99a1-929db6afbc42', '9bef201d-21b3-4dc7-b0e5-bdd6563852b1'), 'target-context': ('10bda3ba-007b-4f6f-ae91-fbeaf02f3926', '3e1a2e94-c72b-4fdb-b5f2-5ef8627e8d84'), 'admin-cleanup': ('7ed5150d-f1b6-416e-8ea3-9ac4b8bce5dc', 'c19c77e8-7e57-4fa2-a4cc-e20b63a16e16'), 'server-stop': ('520232e2-28ed-47cc-98fb-5d61e8c1df85', '3c1df1b4-b38b-43b1-b3b8-d22a1bbd00be'), 'authorization-read:1': ('870623d3-ac90-5bd0-a08e-e5068e6dc623', 'b26df366-a7fc-5268-9b07-a6c769c0637b'), 'authorization-read:2': ('001ffe91-d402-51ce-b8d9-5347bcef845c', '7ab6fd7e-239a-5789-8467-6c946f4ce472'), 'authorization-read:3': ('2c72de1d-e65d-5fb9-867b-055b2df0b086', 'd8e03533-56df-566d-bcf8-197c3faa87ab'), 'authorization-read:4': ('d3b2b0c1-008a-5295-b571-7fb8a86e5888', 'e83bdec1-ba1b-532c-9740-def46d935886'), 'authorization-read:5': ('966ad90e-8e3c-5d72-8295-fc43751c769d', '333d32be-4358-5edb-9ae4-00f219181fb9'), 'authorization-read:6': ('d5df4b2d-3154-563e-a49b-acffe303d3a5', 'e63358a7-d50e-55f3-8500-493b69d6106b'), 'authorization-read:7': ('809a1566-bc89-524e-acdf-e8c53ff6adf8', '7e457148-72bb-534c-a34a-95002a5bd73c'), 'authorization-read:8': ('06bc1911-5c51-50a3-bdfd-bff90b2430b1', 'ce453b09-4baf-55ba-98d0-ab3a91e15b17'), 'authorization-read:9': ('7425af69-d50a-55fe-933c-8c5f3785c84c', '3bf87878-87a3-5cae-b7ef-c69e06454258'), 'authorization-read:10': ('b7ba9a31-41eb-5a02-a5a2-596520278cfd', 'a3741cb9-2a2e-549a-85dd-4a2dd9fa744e'), 'authorization-read:11': ('7b73f051-2167-5c4f-be7d-cb87457e3ea2', 'a59a7863-6bb4-5cf0-b25f-80c78d1c4a7a'), 'terminal-read:1': ('7f93760e-c6df-5f44-86b2-ff514d7f28c5', '3af73b71-8030-529f-a48f-92ed9d459c24'), 'terminal-read:2': ('c31d4d04-b1e7-58c6-aec2-3f2cac05b071', '60baae75-d386-5de4-b5f7-6c94b438cd9f'), 'terminal-read:3': ('503b6815-624e-5aeb-bc5b-3d9ef4472a39', 'f2c98d6b-410e-581c-8b6e-926072b8dce2'), 'terminal-read:4': ('1874b81f-ebf1-55bf-a66b-9aaba2c1bf7a', 'a03a7c00-bc4b-5a60-95ad-a2a2429c4ae1'), 'terminal-read:5': ('70da03d3-e72e-5af4-a07c-b5e67d272b98', '5660e69b-5264-57e2-b6ed-21f70a64350d'), 'terminal-read:6': ('82fd146b-f57a-578f-a2b6-796fd0f92a1c', 'bed3d773-82e6-5ba1-8873-2114fc5edf10'), 'terminal-read:7': ('074a9003-8937-56ba-8a3b-9c98ac882d08', 'b1972ca6-c96b-5513-8fb5-d10111f57a46'), 'terminal-read:8': ('5da0e321-8f64-5806-9ddf-83451aac6c6d', '514b6423-d53f-5d1b-ac49-2a079abdc2ba'), 'terminal-read:9': ('bd8f2685-0ea9-5878-a8d3-a44e79f02173', 'ae0b3b37-8ae3-5b00-b353-24bb596a1b04'), 'terminal-read:10': ('158a9147-60f3-5ed7-8157-f3b4feee60da', 'd51163fd-8b05-50a4-be3d-3a535de82c2d'), 'terminal-read:11': ('d0b742cf-85b5-5dbe-b5f2-edda7d7abbdb', '23fa200d-8a15-5ca0-b2de-f6b8e3806d33'), 'consent-observe:1': ('1c38edb7-ae4d-56d2-9648-52a4d5cdd2a1', '0f149be1-55a6-5a12-8144-db301a769865'), 'consent-observe:2': ('5c4815cd-4a82-54ed-b4d2-d398c56cb951', '9ce66915-4947-5909-8831-0dc7ad0b52d4')}

def run_fixed_phase(context,phase,source,sha,*,public_input=b'',private_frame=b'',markers=(),callbacks=None):
    """Exactly one original route/child per fixed phase; failure is consumed UNKNOWN.
    All opened capture files contain public source/evidence only. In private mode
    original streams remain in the reviewed private collector's memory and every
    event/response is declassified before any AuthorityCapture call.
    """
    if phase not in PUBLIC_PHASE_IDS or phase in context['consumed']:raise ValueError('public-phase-consumed')
    correlation,nonce=PUBLIC_PHASE_IDS[phase]
    if type(source)is not str or type(sha)is not str or len(source.encode('utf-8'))>131072 or len(sha)!=64:raise ValueError('public-phase-source')
    compile(source,'<string>','exec')
    constants={}
    for node in ast.parse(source).body:
        if isinstance(node,ast.Assign):
            for target in node.targets:
                if isinstance(target,ast.Name)and target.id in ('D','NONCE','BODY_SHA'):
                    if target.id in constants:raise ValueError('public-phase-source-duplicate')
                    constants[target.id]=ast.literal_eval(node.value)
    if constants!={'D':correlation,'NONCE':nonce,'BODY_SHA':sha}:raise ValueError('public-phase-source-binding')
    if private_frame:
        if phase != 'admin-create'or type(private_frame)is not bytes or len(private_frame)!=2048 or not markers or callbacks is None:raise ValueError('public-private-phase')
    elif callbacks is not None or markers:raise ValueError('public-private-phase')
    if type(public_input)is not bytes or len(public_input)>32768 or private_frame and public_input:raise ValueError('public-phase-input')
    context['verify']()
    command,source_frame=context['stdin_command'](source)
    argv=context['ssh_argv'](command)
    if max(len(x.encode('utf-8'))for x in argv)>4096:raise ValueError('public-phase-argv')
    root=context['root'];leaf='windows-public-complete-'+correlation
    path=root/'.runtime/parity-evidence'/leaf
    if path.exists():raise ValueError('public-phase-evidence-consumed')
    path.mkdir(mode=0o700)
    cap=context['capture_class'](root,leaf)
    context['consumed'].add(phase)
    events=[];status=None;value=None
    try:
        cap.create('remote.py',source.encode('utf-8'));cap.create('source-frame.private',source_frame)
        cap.create('attempt.json',json.dumps({'state':'consumed','phase':phase,'correlationId':correlation,'nonce':nonce,'sourceSha256':hashlib.sha256(source.encode()).hexdigest(),'replayAllowed':False},sort_keys=True).encode());os.fsync(cap.fd)
        context['verify']()
        if private_frame:
            event,response=callbacks
            value,events,status=context['private_collect'](argv,cap,context['verify'],source_frame,correlation,nonce,sha,context['qemu'],public_event=event,public_response=response,private_frame=private_frame,private_markers=markers)
        else:
            value,events,status=context['guest_collect'](argv,cap,context['verify'],source_frame,correlation,nonce,sha,context['qemu'],public_input,())
        context['verify']()
        facts=context['factory']['admit_public_phase'](value,events,status,source,correlation,nonce,sha,context['qemu'],cap,private=bool(private_frame))
        pin=cap.create('result.json',json.dumps({'state':'observed','phase':phase,'facts':facts,'events':events,'localStatus':status,'replayAllowed':False},sort_keys=True).encode());os.fsync(cap.fd)
        context['verify']()
        return {'state':'observed','phase':phase,'facts':facts,'receipt':pin,'evidenceLeaf':leaf,'replayAllowed':False}
    except Exception as exc:
        # Private failures never stringify exceptions or relay their raw payload.
        # The collector already retained original PID/birth/partial public evidence.
        identity=getattr(exc,'localObservation',None)
        if private_frame:identity=None
        unknown={'state':'unknown','phase':phase,'exceptionType':type(exc).__name__,'localObservation':identity,'replayAllowed':False}
        try:
            pin=cap.create('unknown.json',json.dumps(unknown,sort_keys=True).encode());os.fsync(cap.fd)
        except Exception:pin=None
        return dict(unknown,evidenceLeaf=leaf,receipt=pin)
    finally:
        cap.close()
