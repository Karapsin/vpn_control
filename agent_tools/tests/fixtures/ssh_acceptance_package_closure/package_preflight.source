"""Fixed source-only counter-package closure, before any owner or transport."""
from pathlib import Path
import ast,hashlib,json,os,stat

def _pairs(items):
 value={}
 for key,item in items:
  if key in value:raise ValueError('package_duplicate_key')
  value[key]=item
 return value

def check(here,mode,hold,controller_sha,boundary_sha,retention_sha):
 if mode not in('direct','nested'):raise ValueError('package_mode')
 here=Path(here);root=here/mode;control=hold(here/'controller.py')
 if hashlib.sha256(control.raw).hexdigest()!=controller_sha:raise ValueError('package_controller_changed')
 tree=ast.parse(control.raw);main=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='main')
 loop=next(n for n in ast.walk(main)if isinstance(n,ast.For)and isinstance(n.target,ast.Name)and n.target.id=='p'and isinstance(n.iter,ast.Tuple))
 expected=ast.parse("(Path(__file__),HERE/'ordinary_retention.py',HERE/'bin/ssh',HERE/'public-source-manifest.json',root/'route-template.private.json',root/'planned-operation.json')",mode='eval').body
 if ast.dump(loop.iter,include_attributes=False)!=ast.dump(expected,include_attributes=False):raise ValueError('package_required_input_contract_changed')
 required=(here/'controller.py',here/'ordinary_retention.py',here/'bin/ssh',here/'public-source-manifest.json',root/'route-template.private.json',root/'planned-operation.json')
 held=[hold(p)for p in required]
 for path,digest in((here/'controller.py',controller_sha),(here/'ordinary_retention.py',retention_sha),(here/'bin/ssh',boundary_sha)):
  item=next(v for v in held if v.path==path)
  if hashlib.sha256(item.raw).hexdigest()!=digest:raise ValueError('package_fixed_input_changed')
 info=os.lstat(here/'bin/ssh')
 if not stat.S_ISREG(info.st_mode)or info.st_uid!=os.getuid()or info.st_nlink!=1 or stat.S_IMODE(info.st_mode)!=0o700:raise ValueError('package_executable_custody')
 manifest=json.loads(next(v.raw for v in held if v.path==here/'public-source-manifest.json'),object_pairs_hook=_pairs)['sources']
 if type(manifest)is not dict or not manifest:raise ValueError('package_manifest')
 for rel,digest in manifest.items():
  path=Path(rel)
  if type(rel)is not str or path.is_absolute()or'..'in path.parts or not path.parts or type(digest)is not str or len(digest)!=64:raise ValueError('package_manifest_scope')
  value=hold(root/path)
  if hashlib.sha256(value.raw).hexdigest()!=digest:raise ValueError('package_source_changed')
  held.append(value)
 for value in held:value.guard()
 return {'requiredControllerInputs':len(required),'manifestedSourceCopies':len(manifest),'boundaryExecutable':True,'noOwnerOrTransport':True}
