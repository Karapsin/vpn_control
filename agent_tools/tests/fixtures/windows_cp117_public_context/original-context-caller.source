def tls_valid_acl(acl,path,sid,*,directory):
 if type(acl)is not dict or set(acl)!={'path','protected','aces'} or acl['path']!=path or acl['protected']is not True or type(acl['aces'])is not list or len(acl['aces'])!=3:return False
