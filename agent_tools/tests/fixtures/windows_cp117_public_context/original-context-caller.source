    if bootstrap.count(call)!=1:raise ValueError('direct-download-parser-closure')
    bootstrap=bootstrap.replace(call,"$cp117Source=[Text.UTF8Encoding]::new($false,$true).GetString($v);$cp117Tokens=$null;$cp117ParseErrors=$null;[void][Management.Automation.Language.Parser]::ParseInput($cp117Source,[ref]$cp117Tokens,[ref]$cp117ParseErrors);if($cp117ParseErrors.Count -ne 0){throw 'DOWNLOAD_BODY_PARSE'};& ([ScriptBlock]::Create($cp117Source))")
    encoded=bootstrap
    if not bootstrap.isascii() or any(ord(c)<32 for c in bootstrap) or '"' in bootstrap or '\\' in bootstrap:raise ValueError('stage-command-shape')
    invocation='\"powershell.exe\" -NoProfile -NonInteractive -Command \"'+bootstrap+'\"'
    if len(invocation)>=30000:raise ValueError('stage-complete-command-cap')
