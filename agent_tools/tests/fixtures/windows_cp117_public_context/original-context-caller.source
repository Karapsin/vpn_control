  if type(row)is not dict or set(row)!={'sid','rights','type','inherited','inheritance','propagation'} or row['sid']not in ('S-1-5-18','S-1-5-32-544',sid) or row['sid']in seen or row['type']!='Allow' or row['inherited']is not False or any(type(row[k])is not int for k in ('rights','inheritance','propagation')) or row['rights']!=0x1F01FF or row['inheritance']!=(3 if directory else 0) or row['propagation']!=0:return False
  seen.add(row['sid'])
 return True

