    for before,after in((repr(oldencoded),repr(encoded)),('D='+repr(INSTALLED_CORR),'D='+repr(DOWNLOAD_CORRELATION)),('NONCE='+repr(installed.NONCE),'NONCE='+repr(DOWNLOAD_NONCE)),('BODY_SHA='+repr(oldsha),'BODY_SHA='+repr(sha))):
