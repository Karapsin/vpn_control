SERVER_PREFLIGHT_PROGRAMME="from pathlib import Path\nimport os,sys,json,hashlib,runpy,traceback,io\nstage=Path(STAGE);state=Path(STATE);phase='source'\nclass Capture(io.TextIOBase):\n def __init__(self):self.data='';self.overflow=False\n def write(self,value):\n  if not isinstance(value,str):raise TypeError('server-stream-type')\n  available=8192-len(self.data);self.data+=value[:available];self.overflow|=len(value)>available;return len(value)\n def flush(self):pass\nout=Capture();err=Capture();oldout=sys.stdout;olderr=sys.stderr;sys.stdout=out;sys.stderr=err;n=None\ntry:\n for relative,pin in EXPECTED.items():\n  raw=(stage/relative).read_bytes()\n  if len(raw)!=pin[0]or hashlib.sha256(raw).hexdigest()!=pin[1]:raise ValueError('server-module-drift')\n sys.path.insert(0,str(stage/'server'));n=runpy.run_path(str(stage/'server'/'prepare_desktop_update_fixture.py'),run_name='source_bound_server_preflight')\n phase='stageAcl';recipient=n['require_windows_private_acl'](stage,private=False,directory=True)\n phase='stateAcl';owner=n['require_windows_private_acl'](state,private=True,directory=True,establish=False)\n if owner!=recipient:raise ValueError('server-preflight-owner')\n phase='resources';n['load_resources'](stage)\n phase='serve';n['serve'](stage,Path(CERT),Path(KEY),state/'ready.json',True)\nexcept BaseException as e:\n sys.stdout=oldout;sys.stderr=olderr\n result={'version':1,'correlationId':CORR,'state':'server-failed','phase':phase,'exceptionType':type(e).__name__,'exceptionMessage':str(e)[:1024],'traceback':traceback.format_exc()[:8192],'stdout':out.data,'stderr':err.data,'stdoutOverflow':out.overflow,'stderrOverflow':err.overflow,'pid':os.getpid(),'serverReady':False,'installerAction':False,'runtimeAction':False,'replayAllowed':False}\n raw=json.dumps(result,sort_keys=True,separators=(',',':')).encode()\n if len(raw)>32768:raise ValueError('server-failure-bound')\n fd=os.open(state/'server-failure.private',os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)\n with os.fdopen(fd,'wb')as f:f.write(raw);f.flush();os.fsync(f.fileno())\n if n is not None:n['require_windows_private_acl'](state/'server-failure.private',private=True,directory=False)\n raise\nfinally:sys.stdout=oldout;sys.stderr=olderr\n"

