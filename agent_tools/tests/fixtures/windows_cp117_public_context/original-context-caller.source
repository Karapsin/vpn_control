def _tls_exact(n):
 raw=bytearray()
 while len(raw)<n:
  part=sys.stdin.buffer.read(min(4096,n-len(raw)))
  if not part:raise ValueError('TLS_PRIVATE_INPUT_EOF')
  raw.extend(part)
 return bytes(raw)
def _tls_unique(pairs):
 result={}
 for k,v in pairs:
  if k in result:raise ValueError('TLS_PRIVATE_DUPLICATE')
  result[k]=v
 return result
