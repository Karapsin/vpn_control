def _tls_exception(e):
 text=str(e)
 if isinstance(e,ValueError)and len(text)<=96 and __import__('re').fullmatch('[A-Za-z0-9_-]+',text)is not None and not any(marker in text.encode()for marker in _tls_sensitive):return text
