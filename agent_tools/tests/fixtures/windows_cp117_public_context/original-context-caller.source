def _server_acl_compact(source):
 data=source.encode();packed=base64.b64encode(gzip.compress(data,mtime=0)).decode()
 return "$cp117AclInput=[IO.MemoryStream]::new([Convert]::FromBase64String('"+packed+"'));$cp117AclZip=[IO.Compression.GZipStream]::new($cp117AclInput,[IO.Compression.CompressionMode]::Decompress);$cp117AclOut=[IO.MemoryStream]::new();try{$cp117AclBuffer=New-Object byte[] 4096;while(($cp117AclCount=$cp117AclZip.Read($cp117AclBuffer,0,$cp117AclBuffer.Length)) -gt 0){$cp117AclOut.Write($cp117AclBuffer,0,$cp117AclCount);if($cp117AclOut.Length -gt "+str(len(data))+ "){throw 'SERVER_ACL_SOURCE_BOUND'}};$cp117AclBytes=$cp117AclOut.ToArray();if($cp117AclBytes.Length -ne "+str(len(data))+" -or [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($cp117AclBytes)).Replace('-','').ToLowerInvariant() -cne '"+hashlib.sha256(data).hexdigest()+"'){throw 'SERVER_ACL_SOURCE_HASH'};. ([ScriptBlock]::Create([Text.UTF8Encoding]::new($false,$true).GetString($cp117AclBytes)))}finally{$cp117AclZip.Dispose();$cp117AclInput.Dispose();$cp117AclOut.Dispose()}\n"
