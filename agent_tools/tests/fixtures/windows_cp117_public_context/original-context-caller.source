    try:candidates.append(base64.b64decode(value[name],validate=True))
    except Exception:raise ValueError('TLS_PRIVATE_OUTPUT_SCHEMA')from None
 if any(marker in raw for marker in _tls_sensitive for raw in candidates):raise ValueError('TLS_PRIVATE_OUTPUT')
