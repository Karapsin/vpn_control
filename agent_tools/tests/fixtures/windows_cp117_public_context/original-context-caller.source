 before=bound(Path(transfer.__file__))
 if before['sha256']!=HTTP_SHA or hashlib.sha256(transfer._REMOTE_LISTEN_STATUS.encode()).hexdigest()!=worker.LISTENER_STATUS_SHA:raise ValueError('readback-listener-template')
