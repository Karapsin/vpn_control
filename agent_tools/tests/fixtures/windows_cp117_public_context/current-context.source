"""Authenticated original-context setup. No child or guest action in this function.
Derived from exact retained 5d107 old main: original proof and current guard setup
unchanged; consumed observation leaves and its dispatch removed. Whole driver pins
and retains the old module BEFORE executing these nodes.
"""
def prepare_public_context():
    global TLS_PUBLIC, TLS_RECORD
    root = Path.cwd().resolve(strict=True)
    r = installed.precise.owner.guest.recovery
    bound = r.authority._read_bound_file
    helper, hraw = bound(Path(worker.__file__), retain_bytes=True)
    test, traw = bound(root / 'agent_tools/tests/test_windows_cp117_base_source_refresh.py', retain_bytes=True)
    entry, eraw = bound(Path(__file__), private=True, retain_bytes=True)
    bindingTest, braw = bound(root / 'agent_tools/tests/test_windows_cp117_server_preflight.py', retain_bytes=True)
    if helper['sha256'] != HELPER_SHA or test['sha256'] != 'bee23d9115fde0e1985590988e2e9be2761df32b0aa5e2575af68537791b2c5d' or bindingTest['sha256'] != '4b6612464904b342ced0602d5fc5177ac7c8f8078506285cc0c45e64d4dba870':
        raise ValueError('readback-source')
    archiveRoot=root/'.runtime/parity-evidence/windows-public-context-testpin-successor'
    baseArchive,baseOld=bound(archiveRoot/'original-base-test-ec314.source',private=True,retain_bytes=True)
    serverArchive,serverOld=bound(archiveRoot/'original-server-test-f6d09.source',private=True,retain_bytes=True)
    verify_current_test_successor(baseOld,traw,TEST_SHA,test['sha256'],('ShortcutStdinCarrierTests.functions','ShortcutStdinCarrierTests.program','DirectFixtureTransferWholeMainPreflightTests.test_actual_main_current_local_authorities_bundle_factories_no_child_barrier'))
    verify_current_test_successor(serverOld,braw,READ_BINDING_TEST_SHA,bindingTest['sha256'],())
    tested = gzip.decompress(base64.b64decode(ast.literal_eval(next((n.value for n in ast.parse(braw).body if isinstance(n, ast.Assign) and any((isinstance(t, ast.Name) and t.id == 'SERVER_PREFLIGHT_FACTORY_GZIP' for t in n.targets))))))).decode()
    nodes = [n for n in ast.parse(eraw).body if not (isinstance(n, ast.FunctionDef) and n.name == 'main') and (not (isinstance(n, ast.If) and isinstance(n.test, ast.Compare))) and (not (isinstance(n, ast.Assign) and any((isinstance(t, ast.Name) and t.id in ('HELPER_SHA', 'TEST_SHA', 'HISTORY', 'READ_BINDING_TEST_SHA') for t in n.targets))))]
    actual = '\n\n'.join((('@contextmanager\n' if isinstance(n, ast.FunctionDef) and n.name == '_held_bundle' else '') + ast.get_source_segment(eraw.decode(), n) for n in nodes)) + '\n'
    for cp117A, cp117B, cp117Text in reversed(json.loads(gzip.decompress(base64.b64decode('')))):
        tested = tested[:cp117A] + cp117Text + tested[cp117B:]
    if actual != tested:
        raise ValueError('readback-tested-source')
    original = AuthorityCapture(root, 'windows-cp117-recovery-' + r.CORRELATION)
    prior = AuthorityCapture(root, PRIOR_LEAF)
    bundlehold = None
    try:
        tlsPath = root / '.runtime/parity-evidence/windows-direct-fixture-tls-bb2e85e5-4281-4f70-b70e-618f5604093b'
        tlsPrior = AuthorityCapture(root, tlsPath.name)
        raw = r._local_read(original, installed.precise.owner.guest.ORIGINAL['name'], installed.precise.owner.guest.ORIGINAL['pin'])
        record = json.loads(raw)
        sources = {str(path): bound(path) for path in (Path(transfer.__file__), Path(installed.__file__), Path(installed.precise.__file__), Path(installed.public.__file__), Path(flow.__file__), Path(installed.precise.owner.guest.__file__), Path(r.authority.closure.base.__file__))}

        def history_bound(path):
            path = Path(path)
            expected = HISTORY[str(path)]
            if path.parent.parent != root / '.runtime/parity-evidence':
                raise ValueError('readback-history-parent')
            held = AuthorityCapture(root, path.parent.name)
            try:
                r._local_read(held, path.name, expected)
                return expected
            finally:
                held.close()
        sources[str(archiveRoot/'original-base-test-ec314.source')]=baseArchive
        sources[str(archiveRoot/'original-server-test-f6d09.source')]=serverArchive
        for path, expected in HISTORY.items():
            sources[path] = history_bound(path)
        old_entry = Path(PRIOR_CALLER)
        oldpin, oldraw = bound(old_entry, private=True, retain_bytes=True)
        if oldpin != HISTORY[str(old_entry)]:
            raise ValueError('readback-prior-caller-drift')
        if hashlib.sha256(oldraw).hexdigest() != '1a040b2537ef2bef81019a6e2467a0bd62741a01bb1bd98b835016a6a312a209':
            raise ValueError('readback-original-caller')
        ns = {'__name__': 'authenticated_prior_without_main', '__file__': str(old_entry)}
        exec(compile(oldraw, str(old_entry), 'exec'), ns)
        oldvalue = json.loads(r._local_read(prior, 'result.json', HISTORY[str(root / '.runtime/parity-evidence' / PRIOR_LEAF / 'result.json')]))
        oldsource = r._local_read(prior, 'remote.py', HISTORY[str(root / '.runtime/parity-evidence' / PRIOR_LEAF / 'remote.py')]).decode()
        oldstatus = json.loads(r._local_read(prior, 'exit.json', HISTORY[str(root / '.runtime/parity-evidence' / PRIOR_LEAF / 'exit.json')]))
        oldsha = recorded_stage_body_sha(oldsource)
        ns['admit_download'](oldvalue['result'], oldvalue['events'], oldstatus, oldsource, ns['DOWNLOAD_NONCE'], oldsha, record['result']['qemu'], prior)
        originalMark = oldvalue['result']['facts']['facts']['download']
        if originalMark['state'] != 'staged' or originalMark['originalPreserved'] is not True or originalMark['originalZipIdentity'] != ORIGINAL_ZIP_ID or (originalMark['stage']['correlationId'] != STAGED_CORRELATION):
            raise ValueError('tls-original-stage')
        from scripts import windows_fixture_stage_acl as fixture_acl
        for path in (Path(STAGE_MODULE_PATH), Path(fixture_acl.__file__), Path(credentials.__file__), Path(fixture_server.__file__)):
            sources[str(path)] = bound(path)
        admitted = installed.pair(root)
        execution = flow._execution_source_proof(root, record)
        outer = r.authority._outer_authority(root)
        bundle_guard = lambda: None

        def verify():
            pins = dict(sources)
            pins.update({str(root / 'agent_tools/tests/test_windows_cp117_server_preflight.py'): bindingTest, str(Path(worker.__file__)): helper, str(root / 'agent_tools/tests/test_windows_cp117_base_source_refresh.py'): test, str(Path(__file__)): entry})
            held = {}
            parents = {}

            def gen(z):
                return [z.st_dev, z.st_ino, z.st_mode, z.st_uid, z.st_gid, z.st_nlink, z.st_size, z.st_mtime_ns, z.st_ctime_ns]
            try:
                for name, pin in pins.items():
                    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW)
                    held[name] = fd
                    if gen(os.fstat(fd)) != pin['generation']:
                        raise ValueError('server-held-source-drift')
                    parent = str(Path(name).parent)
                    if parent not in parents:
                        pfd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                        parents[parent] = (pfd, gen(os.fstat(pfd))[:5])
                if bound(root / 'agent_tools/tests/test_windows_cp117_server_preflight.py') != bindingTest or bound(Path(worker.__file__)) != helper or bound(root / 'agent_tools/tests/test_windows_cp117_base_source_refresh.py') != test or (bound(Path(__file__), private=True) != entry) or any(((history_bound(path) if path in HISTORY else bound(Path(path))) != pin for path, pin in sources.items())):
                    raise ValueError('readback-drift')
                if r._local_read(original, installed.precise.owner.guest.ORIGINAL['name'], installed.precise.owner.guest.ORIGINAL['pin']) != raw or flow._execution_source_proof(root, record) != execution or installed.pair(root) != admitted:
                    raise ValueError('readback-authority')
                for i, item in enumerate(record['authority']):
                    r._validate_frame(item['frame'], record['request'], record['authority'][:i])
                    if json.loads(r._local_read(original, 'authority-%d.json' % i, item['localPin'])) != item['frame']:
                        raise ValueError('readback-original-frame')
                r.authority._verify_outer(root, {'outerAuthority': outer})
                bundle_guard()
                for name, fd in held.items():
                    if gen(os.fstat(fd)) != pins[name]['generation'] or gen(Path(name).lstat()) != pins[name]['generation']:
                        raise ValueError('server-pure-source-drift')
                for parent, (pfd, pin) in parents.items():
                    if gen(os.fstat(pfd))[:5] != pin or gen(Path(parent).lstat())[:5] != pin:
                        raise ValueError('server-parent-drift')
                # Parent observations can yield after the first leaf pass.
                # Complete all parents, then close the entire leaf population.
                for name, fd in held.items():
                    if gen(os.fstat(fd)) != pins[name]['generation'] or gen(Path(name).lstat()) != pins[name]['generation']:
                        raise ValueError('server-terminal-source-drift')
            finally:
                for fd in held.values():
                    os.close(fd)
                for pfd, _ in parents.values():
                    os.close(pfd)
        verify()
        candidate = _held_bundle(Path(BUNDLE_PATH))
        bundle_stream, bundle_pin, bundle_guard = candidate.__enter__()
        bundlehold = candidate
        import zipfile
        with zipfile.ZipFile(bundle_stream) as archive:
            fixture_source = archive.read('server/prepare_desktop_update_fixture.py')
            fixture_receipt = json.loads(archive.read('fixture-receipt.json'))
        if hashlib.sha256(fixture_source).hexdigest() != MEMBERS['server/prepare_desktop_update_fixture.py'] or not fixture_server._has_windows_safe_probe_events_mkdir(fixture_source) or (not _server_strict_equal(fixture_receipt['manifest'], SERVER_MANIFEST)):
            raise ValueError('server-frozen-source')
        bundle_guard()
        TLS_PUBLIC = json.loads(r._local_read(tlsPrior, 'request.json', HISTORY[str(tlsPath / 'request.json')]))['tlsPublic']
        TLS_RECORD = record
        private_frame = b''
        private_markers_value = ()
        successorDecision = successor_stage_proof(root)
        priorDecision = server_tls_prior(root, record, HISTORY)
        if priorDecision['credentialHashes'] != TLS_PUBLIC['fileSha256']:
            raise ValueError('tls-historical-credentials')
        config, _, _ = r.authority.closure.base._descriptor(root)

        def argv(command):
            result = r.authority.closure.base.ssh_transport.build_ssh_argv(config, r.HOST, 60, command=command)
            if max((len(x.encode()) for x in result)) > 4096:
                raise ValueError('readback-argv')
            return result

        def close_context():
            if bundlehold is not None:
                bundlehold.__exit__(None, None, None)
            tlsPrior.close()
            prior.close()
            original.close()
        return dict(root=root, record=record, qemu=record['result']['qemu'], verify=verify, ssh_argv=argv, stdin_command=_stdin_shortcut_command, capture_class=AuthorityCapture, guest_collect=guest_collect, close=close_context, sources=sources, original_source=installed.program_current(record, admitted)[0], tlsPublic=TLS_PUBLIC, tlsRecord=TLS_RECORD, bundlePin=bundle_pin)
    except BaseException:
        if bundlehold is not None:
            bundlehold.__exit__(None, None, None)
        if 'tlsPrior' in locals():
            tlsPrior.close()
        prior.close()
        original.close()
        raise


# Recorded historical stage/attribute proof, independently from current admission.
def successor_stage_proof(root):
 r=installed.precise.owner.guest.recovery;cap=AuthorityCapture(root,RECOVERED_STAGE_LEAF)
 try:
  value=json.loads(r._local_read(cap,'result.json',HISTORY[str(root/'.runtime/parity-evidence'/RECOVERED_STAGE_LEAF/'result.json')]))
  source=r._local_read(cap,'remote.py',HISTORY[str(root/'.runtime/parity-evidence'/RECOVERED_STAGE_LEAF/'remote.py')]).decode('utf-8','strict')
  status=json.loads(r._local_read(cap,'exit.json',HISTORY[str(root/'.runtime/parity-evidence'/RECOVERED_STAGE_LEAF/'exit.json')]))
  oldPath=Path(PRIOR_ADMISSION_CALLER_PATH);oldCap=AuthorityCapture(root,oldPath.parent.name)
  try:oldBytes=r._local_read(oldCap,oldPath.name,HISTORY[str(oldPath)])
  finally:oldCap.close()
  oldns={'__name__':'held_original_stage_admission_no_main','__file__':str(oldPath)};exec(compile(oldBytes,str(oldPath),'exec'),oldns)
  oldns['admit_download'](value['result'],value['events'],status,source,RECOVERED_STAGE_NONCE,RECOVERED_STAGE_BODY_SHA,RECOVERED_STAGE_QEMU,cap)
  if value['state']!='observed' or not _server_strict_equal(value['result']['facts']['facts']['download'],RECOVERED_STAGE_RECORD):raise ValueError('server-complete-stage-proof')
 finally:cap.close()
 attrcap=AuthorityCapture(root,ATTRIBUTE_RECEIPT_LEAF);caller=Path(ATTRIBUTE_RECEIPT_CALLER);callcap=AuthorityCapture(root,caller.parent.name)
 try:
  sourcebytes=r._local_read(callcap,caller.name,HISTORY[str(caller)]);n={'__name__':'authenticated_attribute_no_main','__file__':str(caller)};exec(compile(sourcebytes,str(caller),'exec'),n)
  original=recorded_attribute_validator(root,r,n)
  value=json.loads(r._local_read(attrcap,'result.json',HISTORY[str(root/'.runtime/parity-evidence'/ATTRIBUTE_RECEIPT_LEAF/'result.json')]))
  status=json.loads(r._local_read(attrcap,'exit.json',HISTORY[str(root/'.runtime/parity-evidence'/ATTRIBUTE_RECEIPT_LEAF/'exit.json')]))
  observedsource=r._local_read(attrcap,'remote.py',HISTORY[str(root/'.runtime/parity-evidence'/ATTRIBUTE_RECEIPT_LEAF/'remote.py')]).decode()
  original['admit_download'](value['result'],value['events'],status,observedsource,ATTRIBUTE_RECEIPT_NONCE,ATTRIBUTE_RECEIPT_BODY_SHA,ATTRIBUTE_RECEIPT_QEMU,attrcap)
  if value['state']!='observed'or not _server_strict_equal(value['result']['facts']['facts']['download'],ATTRIBUTE_RECEIPT_RECORD):raise ValueError('server-attribute-proof')
 finally:callcap.close();attrcap.close()
 return {'state':'historical-stage-and-attribute-positive','receiptSha256':HISTORY[str(root/'.runtime/parity-evidence'/RECOVERED_STAGE_LEAF/'result.json')]['sha256'],'root':SUCCESSOR_ROOT,'publisherSha256':SUCCESSOR_SOURCE_SHA,'currentVmAdmission':False,'serverReady':False}


def recorded_attribute_validator(root,r,n):
 prior=Path(n['PRIOR_CALLER']);priorcap=AuthorityCapture(root,prior.parent.name)
 try:priorbytes=r._local_read(priorcap,prior.name,n['INPUTS'][str(prior)])
 finally:priorcap.close()
 original={'__name__':'authenticated_recorded_attribute_validator','__file__':str(prior)}
 exec(compile(priorbytes,str(prior),'exec'),original)
 bodypath=Path(n['BODY_PATH']);bodycap=AuthorityCapture(root,bodypath.parent.name)
 try:bodybytes=r._local_read(bodycap,bodypath.name,n['INPUTS'][str(bodypath)])
 finally:bodycap.close()
 if hashlib.sha256(bodybytes.decode('utf-8','strict').encode('utf-16le')).hexdigest()!=ATTRIBUTE_RECEIPT_BODY_SHA:raise ValueError('historical-attribute-body')
 return original

def recorded_stage_body_sha(source):
    tree=ast.parse(source)
    values={}
    for node in tree.body:
        if isinstance(node,ast.Assign):
            for target in node.targets:
                if isinstance(target,ast.Name) and target.id in ('ENCODED','BODY_SHA'):
                    if target.id in values:raise ValueError('historical-stage-body-duplicate')
                    values[target.id]=ast.literal_eval(node.value)
    if set(values)!= {'ENCODED','BODY_SHA'} or any(type(x)is not str for x in values.values()) or len(values['BODY_SHA'])!=64 or any(x not in '0123456789abcdef'for x in values['BODY_SHA']):raise ValueError('historical-stage-body-schema')
    import re,zlib
    encoded=values['ENCODED']
    if encoded.startswith("$ErrorActionPreference='Stop';$i=[IO.MemoryStream]::new([Convert]::FromBase64String('"):
        match=re.fullmatch(r"\$ErrorActionPreference='Stop';\$i=\[IO.MemoryStream\]::new\(\[Convert\]::FromBase64String\('([A-Za-z0-9+/=]+)'\)\);.*\$v.Length -ne ([1-9][0-9]{0,4}) .* -cne '([0-9a-f]{64})'.*",encoded)
        if match is None or int(match[2])>65536:raise ValueError('historical-stage-bootstrap-schema')
        decoder=zlib.decompressobj(16+zlib.MAX_WBITS);body=decoder.decompress(base64.b64decode(match[1],validate=True),int(match[2])+1)
        if not decoder.eof or decoder.unused_data or decoder.unconsumed_tail or len(body)!=int(match[2])or hashlib.sha256(body).hexdigest()!=match[3]:raise ValueError('historical-stage-bootstrap-hash')
        full=body.decode('utf-8','strict');header,separator,plain=full.partition('\n')
        marker=re.fullmatch(r"\[Console\]::Out.WriteLine\(\('CP117-READ ([0-9a-f-]{36}) ([0-9a-f]{64}) '\+\$PID\)\)",header)
        if not separator or marker is None or marker[2]!=values['BODY_SHA']:raise ValueError('historical-stage-read-header')
        raw=plain.encode('utf-16le')
    else:
        raw=base64.b64decode(encoded,validate=True);raw.decode('utf-16le','strict')
    if not raw or len(raw)>131072 or hashlib.sha256(raw).hexdigest()!=values['BODY_SHA']:raise ValueError('historical-stage-body-hash')
    return values['BODY_SHA']

def verify_current_test_successor(old_raw,current_raw,old_sha,current_sha,allowed_methods):
    if hashlib.sha256(old_raw).hexdigest()!=old_sha or hashlib.sha256(current_raw).hexdigest()!=current_sha:raise ValueError('current-test-successor-hash')
    old=ast.parse(old_raw);current=ast.parse(current_raw)
    imports=[n for n in current.body if isinstance(n,ast.ImportFrom)and n.module=='agent_tools.tests.fixtures.windows_cp117_historical_factory.context']
    if len(imports)!=1 or [(n.name,n.asname)for n in imports[0].names]!=[('HistoricalFactoryTestCase','HistoryCase'),('provider','historical_provider')]:raise ValueError('current-test-successor-import')
    current.body.remove(imports[0]);changed=set()
    for node in current.body:
        if not isinstance(node,ast.ClassDef):continue
        for index,base in enumerate(node.bases):
            if isinstance(base,ast.Name)and base.id=='HistoryCase':node.bases[index]=ast.Attribute(value=ast.Name(id='unittest',ctx=ast.Load()),attr='TestCase',ctx=ast.Load())
        old_class=next((n for n in old.body if isinstance(n,ast.ClassDef)and n.name==node.name),None)
        if old_class is None:raise ValueError('current-test-successor-class')
        for index,method in enumerate(node.body):
            if not isinstance(method,ast.FunctionDef):continue
            name=node.name+'.'+method.name
            if name in allowed_methods:
                prior=next(n for n in old_class.body if isinstance(n,ast.FunctionDef)and n.name==method.name)
                if ast.dump(method,include_attributes=False)==ast.dump(prior,include_attributes=False):raise ValueError('current-test-successor-declared-delta')
                node.body[index]=prior;changed.add(name)
    if changed!=set(allowed_methods)or ast.dump(current,include_attributes=False)!=ast.dump(old,include_attributes=False):raise ValueError('current-test-successor-undeclared-delta')
