 if source.count(repr(old))!=1:raise ValueError('readback-listener-arguments')
 source=source.replace(repr(old),repr(new))
 if bound(Path(transfer.__file__))!=before:raise ValueError('readback-listener-drift')
 compile(source,'fixed-original-listener-status','exec');return source

def admit_listener(value):
