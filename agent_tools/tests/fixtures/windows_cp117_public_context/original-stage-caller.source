  e=item['event']
  if any(e.get(k)!=v for k,v in {'diagnosticId':DOWNLOAD_CORRELATION,'nonce':nonce,'sourceSha256':sha,'qemu':qemu}.items()):raise ValueError('download-event-binding')
  if e.get('kind')=='submitted':submitted.append(e)
