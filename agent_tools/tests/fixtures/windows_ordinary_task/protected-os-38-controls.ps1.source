function Root-Exception($e) {
 while($null -ne $e.InnerException){$e=$e.InnerException}
 return $e
}
function Declare-Case([hashtable]$Override=@{}) {
 $c=@{attributes=[uint32]32;links=[uint32]2;volume=[uint32]17;indexHi=[uint32]2;indexLo=[uint32]43;sizeHi=[uint32]0;sizeLo=[uint32]511;creation=[long]133000000000000001;write=[long]133000000000000002;owner=$script:Owner;descriptorOwner=$script:Owner;protected=$true;dacl='common';ace='allow';trustee='S-1-5-32-545';mask=[int]0x1200a9;callback=$false}
 foreach($k in $Override.Keys){$c[$k]=$Override[$k]}
 $d=[DeclaredSecurity.RawSecurityDescriptor]::new()
 if($null -ne $c.descriptorOwner){$d.Owner=[DeclaredSecurity.Sid]::new($c.descriptorOwner)}
 if($c.protected){$d.ControlFlags=[DeclaredSecurity.ControlFlags]::DiscretionaryAclProtected}
 if($c.dacl -ne 'null'){
  $d.DiscretionaryAcl=[DeclaredSecurity.RawAcl]::new()
  if($c.dacl -ne 'empty'){
   if($c.ace -eq 'object'){$a=[DeclaredSecurity.ObjectAce]::new()}
   else{
    $a=[DeclaredSecurity.CommonAce]::new()
    $a.IsCallback=$c.callback
    $a.AceQualifier=if($c.ace -eq 'deny'){[DeclaredSecurity.AceQualifier]::AccessDenied}elseif($c.ace -eq 'audit'){[DeclaredSecurity.AceQualifier]::SystemAudit}else{[DeclaredSecurity.AceQualifier]::AccessAllowed}
    $a.SecurityIdentifier=[DeclaredSecurity.Sid]::new($c.trustee)
    $a.AccessMask=$c.mask
   }
   $d.DiscretionaryAcl.Add($a)
  }
 }
 [DeclaredSecurity.RawSecurityDescriptor]::Declared=$d
 # Security text is an explicitly declared boundary value, not parsed by the peer.
 $sddl='O:'+$script:Owner+'D:P(A;;0x1200a9;;;BU)'
 [BeforeDecisionBoundary]::Declare($c.attributes,$c.links,$c.volume,$c.indexHi,$c.indexLo,$c.sizeHi,$c.sizeLo,$c.creation,$c.write,$c.owner,$sddl)
 [CandidateDecisionBoundary]::Declare($c.attributes,$c.links,$c.volume,$c.indexHi,$c.indexLo,$c.sizeHi,$c.sizeLo,$c.creation,$c.write,$c.owner,$sddl)
}
function Expect-Rejection([string]$Name,[scriptblock]$Action,[string]$Message) {
 $caught=$null
 try{$null=&$Action}catch{$caught=Root-Exception $_.Exception}
 if($null -eq $caught){throw ('Expected rejection: '+$Name)}
 if($caught.Message -cne $Message){throw ('Wrong rejection '+$Name+': '+$caught.Message)}
 $script:Results.Add([ordered]@{name=$Name;expected='rejected';observed='rejected';exceptionType=$caught.GetType().FullName;message=$caught.Message;pass=$true})
}
function Expect-Identity([string]$Name,[string]$Path) {
 $value=[CandidateDecisionBoundary]::PinIdentity($script:Handle,$Path,$false)
 Assert-NativeIdentity $value $script:Expected
 $script:Results.Add([ordered]@{name=$Name;expected='accepted exact full identity';observed=$value;pass=$true})
}
