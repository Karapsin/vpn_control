"""Finite disconnected public-CLI cases for an admitted ordinary Windows owner.

No main, process launcher, timeout termination, automatic cleanup or replay lives
here. Owner.invoke/child/event retain original native handles and raw streams.
This module is preparation: its local qualification is not Windows acceptance.
"""
from __future__ import annotations

import base64
import hashlib
import json
from pathlib import Path
import stat
import time


PREPARED_QR_SHA256 = '2d4df67c32137fcac6dc8235809086702cf0c910f6c458af763fd9f67b7301d1'
PREPARED_QR_BASE64 = ''

ACTION = "disconnected-cli-config"
GROUPS = ("static-missing-owner", "source-mode-existing", "ordinary-reads",
          "safe-settings", "subscriptions", "locations", "routing-and-exports",
          "qr-transfer", "diagnostics-and-retained-result", "large-documents")


def require(value, reason):
    if not value:
        raise AssertionError(reason)


def metadata(body):
    return {key: body[key] for key in ("schemaVersion", "controllerId", "requestId",
        "operationId", "configurationRevision", "restartRequired", "code", "final")
        if key in body}


class Cases:
    """Only the fixed case functions below use these response/receipt helpers."""
    def __init__(self, owner, workspace, identity, harness, root):
        self.owner, self.workspace, self.identity = owner, Path(workspace), identity
        self.harness, self.root = harness, Path(root)

    def record(self, kind, value):
        self.owner.event("disconnected-" + kind, value)

    def recorded_invoke(self, workspace, *args, timeout=30):
        require(Path(workspace) == self.workspace, "case-workspace-changed")
        self.record("command-intent", {"workspace": str(self.workspace), "argv": list(args)})
        result = self.owner.invoke(workspace, *args, timeout=timeout)
        facts = {"exitCode": result.returncode,
                 "stdoutBytes": len(result.stdout.encode("utf-8")),
                 "stderrBytes": len(result.stderr.encode("utf-8"))}
        if len(result.stdout) <= 64 * 1024:
            try:
                body = json.loads(result.stdout)
                if type(body) is dict:
                    facts["response"] = metadata(body)
            except (ValueError, RecursionError):
                pass
        self.record("command-terminal", facts)
        return result

    def invoke(self, *args, json_output=True, revision=None):
        prefix = (["--json"] if json_output else []) + ["--controller-id", self.identity]
        if revision is not None:
            require(type(revision) is int and revision >= 0, "case-revision-type")
            prefix += ["--if-revision", str(revision)]
        return self.recorded_invoke(self.workspace, *prefix, *args)

    def body(self, result, expected_exit=0, expected_code="OK", final=True,
             allow_unbound=False):
        body = self.harness["envelope"](result, expected_exit, expected_code)
        require(result.stderr == "", "JSON-stderr-not-empty")
        require(type(body.get("configurationRevision")) is int
                and body["configurationRevision"] >= 0
                and type(body.get("restartRequired")) is bool
                and type(body.get("final")) is bool, "response-metadata-types")
        require(body.get("controllerId") == self.identity or
                (allow_unbound and body.get("controllerId") in (None, "")),
                "response-owner-epoch-changed")
        if final is not None:
            require(body["final"] is final, "response-completion-not-expected")
        if body.get("controllerId") == self.identity:
            require(type(body.get("requestId")) is str and bool(body["requestId"]),
                    "response-request-identity-missing")
        return body

    def json(self, *args, expected_exit=0, expected_code="OK", final=True,
             revision=None, allow_unbound=False):
        return self.body(self.invoke(*args, revision=revision), expected_exit,
                         expected_code, final, allow_unbound)

    def human(self, *args, expected_exit=0, expected_code="OK", revision=None,
              final=True):
        result = self.invoke(*args, json_output=False, revision=revision)
        require(result.returncode == expected_exit, "human-exit-code")
        if expected_exit:
            require(result.stdout == "" and result.stderr.splitlines()[:1] == [expected_code],
                    "human-error-stream-or-code")
        else:
            lines = result.stdout.splitlines()
            require(result.stderr == "" and lines[:1] == [expected_code]
                    and f"Controller: {self.identity}" in lines, "human-owner-metadata")
            if final:
                require("Completion: final" in lines, "human-not-final")
        return result

    def status(self):
        body = self.json("status")
        require(body["data"]["runtimeRunning"] is False
                and body["restartRequired"] is False, "disconnected-owner-changed")
        return body

    def mutate(self, *args, human=False, delta=1):
        before = self.status()
        revision = before["configurationRevision"]
        if human:
            result = self.human(*args, revision=revision)
            ids = [line[len("  id: "):] for line in result.stdout.splitlines()
                   if line.startswith("  id: ")]
            data = {"id": ids[0]} if len(ids) == 1 else {}
            body = {"data": data}
        else:
            body = self.json(*args, revision=revision)
        after = self.status()
        change = delta(before, body, after) if callable(delta) else delta
        require(type(change) is int and change in (0, 1)
                and after["configurationRevision"] == revision + change,
                "mutation-revision-not-exact")
        if human:
            require(f"Revision: {revision + change}" in result.stdout.splitlines(),
                    "human-commit-revision")
        else:
            require(body["configurationRevision"] == revision + change,
                    "JSON-commit-revision")
        self.record("commit-readback", {"argv": list(args), "human": human,
                    "before": metadata(before), "after": metadata(after)})
        return body

    def file(self, name, content):
        require(name not in ("", ".", "..") and Path(name).name == name,
                "fixture-name-not-leaf")
        path = self.root / name
        value = content.encode("utf-8") if type(content) is str else content
        require(type(value) is bytes, "fixture-content-type")
        with path.open("xb") as output:
            require(output.write(value) == len(value), "fixture-short-write")
        self.record("input", {"name": name, "bytes": len(value),
                    "sha256": hashlib.sha256(value).hexdigest()})
        return path

    def output(self, path):
        path = Path(path)
        require(path.parent == self.root, "output-outside-fixture-root")
        opening = path.lstat()
        require(stat.S_ISREG(opening.st_mode) and not path.is_symlink()
                and not getattr(opening, "st_file_attributes", 0) & 0x400,
                "output-not-regular-original-file")
        with path.open("rb") as stream:
            before = stream.read()
            import os
            held = os.fstat(stream.fileno())
            closing = path.lstat()
            fields = lambda value: (value.st_dev, value.st_ino, value.st_mode,
                value.st_size, value.st_mtime_ns, value.st_ctime_ns)
            require(fields(opening) == fields(held) == fields(closing)
                    and len(before) == held.st_size, "output-changed-during-read")
        result = {"bytes": len(before), "sha256": hashlib.sha256(before).hexdigest(),
                  "content": before}
        self.record("output", {"path": str(path), "bytes": result["bytes"],
                    "sha256": result["sha256"]})
        return result

    def group(self, name, **facts):
        require(name in GROUPS, "unexpected-case-group")
        self.status()
        self.record("group-complete", {"group": name, "facts": facts,
                    "fullMembershipAccepted": False, "fullWindowsAcceptance": False})


def static_cases(c):
    missing = c.owner.root / "未開始 missing workspace"
    require(not missing.exists(), "missing-workspace-already-exists")
    for args, exit_code, code in ((["--help"], 0, None), (["--version"], 0, None),
            (["--json", "capabilities"], 0, "OK"),
            (["--json", "status"], 2, "UNAVAILABLE"),
            (["--json", "settings", "show", "--unknown"], 1, "INVALID_ARGUMENT")):
        c.record("static-command-intent", {"workspace": str(missing), "argv": args})
        result = c.owner.invoke(missing, *args)
        if code is None:
            text = "Usage:" if args == ["--help"] else c.owner.request["productVersion"]
            require(result.returncode == exit_code and result.stderr == ""
                    and text in result.stdout, "static-launch-result")
        else:
            body = c.harness["envelope"](result, exit_code, code)
            if args[-1] == "capabilities":
                require(body["data"].get("runtimeReadinessChecked") is False,
                        "static-capability-readiness-claim")
        require(not missing.exists(), "static-probe-created-workspace")
        c.record("static-command-terminal", {"argv": args, "exitCode": result.returncode})
    for args, expected in ((["capabilities"], 0), (["status"], 2),
                           (["settings", "show", "--unknown"], 1)):
        result = c.owner.invoke(missing, *args)
        require(result.returncode == expected, "human-static-exit")
        require((result.stderr == "" and bool(result.stdout)) if expected == 0 else
                (result.stdout == "" and result.stderr.splitlines()[:1] ==
                 ["UNAVAILABLE" if expected == 2 else "INVALID_ARGUMENT"]),
                "human-static-streams")
        require(not missing.exists(), "human-static-created-workspace")
    c.group("static-missing-owner")


def source_cases(c):
    c.harness["source_mode_smoke"](c.workspace, c.identity, c.recorded_invoke)
    subscriptions = []
    for index in range(2):
        saved = c.mutate("subscriptions", "add", "--source",
            f"https://example.test/prepared-all-{index}.txt", "--name", f"All-mode dormant {index}")
        subscriptions.append(saved["data"]["id"])
    require(all(row["cachedLocations"] == 0 for row in
                c.json("subscriptions", "list")["data"]["subscriptions"]),
            "all-mode-dormant-fixture-fetched")
    for human in (True, False):
        c.mutate("source", "set", "all", human=human, delta=1)
        source = c.json("source", "show")["data"]
        require(source == {"mode": "subscription", "subscriptionId": "__all_subscriptions__"},
                "valid-all-source-not-committed")
        c.human("source", "show")
        c.mutate("source", "set", "all", human=human, delta=0)
        c.mutate("source", "set", "current-locations", human=human, delta=1)
    for identifier in subscriptions:
        c.mutate("subscriptions", "delete", identifier)
    require(c.json("subscriptions", "list")["data"]["subscriptions"] == [],
            "all-mode-fixture-not-removed")
    c.group("source-mode-existing", heldSourceModeSmoke=True, validAllAdded=True)


def read_cases(c):
    revision = c.status()["configurationRevision"]
    for args in (("status",), ("settings", "show"), ("settings", "languages"),
            ("source", "show"), ("locations", "list"), ("subscriptions", "list"),
            ("routing", "show"), ("ssh", "key", "status"), ("updates", "status"),
            ("stats",), ("logs", "--limit", "10"), ("operations", "list")):
        body = c.json(*args)
        require(body["configurationRevision"] == revision, "read-changed-revision")
        c.human(*args)
        require(c.status()["configurationRevision"] == revision, "human-read-changed-state")
    c.group("ordinary-reads", largerGatedGroupsAccepted=False)


def settings_cases(c):
    for human in (True, False):
        old = c.json("settings", "show")["data"]
        c.mutate("settings", "set", "validation.batch-size", "7", human=human,
                 delta=int(old["validation.batch-size"] != 7))
        require(c.json("settings", "show", "validation.batch-size")["data"] ==
                {"validation.batch-size": 7}, "setting-roundtrip")
        patch = {"validation.batch-size": 8, "validation.retry-count": 1}
        old = c.json("settings", "show")["data"]
        path = c.file(f"設定 patch {'human' if human else 'json'}.json", json.dumps(patch))
        c.mutate("settings", "apply", "--input", str(path), human=human,
                 delta=int(any(old[key] != value for key, value in patch.items())))
        saved = c.json("settings", "show")["data"]
        require(all(saved[key] == value for key, value in patch.items()), "settings-patch-roundtrip")
        c.human("settings", "show", "validation.batch-size")
        c.human("settings", "show")
    c.group("safe-settings", autostartOrRefreshChanged=False)


def subscription_cases(c):
    url = "https://example.test/packaged-mode-only.txt"
    for human in (True, False):
        suffix = "human" if human else "json"
        before = c.json("subscriptions", "list")["data"]["subscriptions"]
        c.mutate("subscriptions", "add", "--source", url, "--name", f"Dormant 東京 {suffix}",
                 human=human)
        rows = c.json("subscriptions", "list")["data"]["subscriptions"]
        new = [row for row in rows if row["id"] not in {old["id"] for old in before}]
        require(len(new) == 1 and new[0]["cachedLocations"] == 0, "dormant-subscription-admission")
        identifier = new[0]["id"]
        c.human("subscriptions", "list")
        c.human("subscriptions", "show", identifier)
        shown = c.json("subscriptions", "show", identifier)["data"]
        require(shown["source"] == url and shown["name"] == f"Dormant 東京 {suffix}",
                "explicit-subscription-show")
        c.mutate("subscriptions", "update", identifier, "--name", f"Renamed 東京 {suffix}",
                 human=human)
        require(c.json("subscriptions", "show", identifier)["data"]["name"] ==
                f"Renamed 東京 {suffix}", "subscription-update-readback")
        c.mutate("subscriptions", "delete", identifier, human=human)
        require(c.json("subscriptions", "list")["data"]["subscriptions"] == before,
                "subscription-delete-readback")
    c.group("subscriptions", noRefresh=True, noNetworkFixtureClaim=True)


def location_cases(c):
    for human in (True, False):
        label = "human" if human else "json"
        name, edited = f"Manual 東京 Ω {label}", f"Edited 東京 Ω {label}"
        source = c.file(f"location 東京 {label}.txt", f"socks://127.0.0.1:1080#{name}")
        c.mutate("locations", "add", "--input", str(source), human=human)
        rows = c.json("locations", "list")["data"]["locations"]
        row = next(row for row in rows if row["name"] == name)
        by_name = c.json("locations", "show", name)["data"]["configuration"]
        require(c.json("locations", "show", str(row["index"]))["data"]["configuration"] ==
                by_name and "1080" in by_name, "visible-location-selector-equivalence")
        c.human("locations", "show", name)
        c.human("locations", "show", str(row["index"]))
        c.human("locations", "list")
        def selected_delta(before, body, after):
            identifier = body["data"].get("id")
            require(type(identifier) is str and bool(identifier)
                    and after["data"]["selectedLocationId"] == identifier,
                    "selected-location-identity-readback")
            return int(before["data"]["selectedLocationId"] != identifier)
        c.mutate("locations", "select", name, human=human, delta=selected_delta)
        c.mutate("locations", "select", str(row["index"]), human=human, delta=0)
        update = c.file(f"edited 東京 {label}.txt", f"socks://127.0.0.1:1081#{edited}")
        c.mutate("locations", "update", name, "--input", str(update), human=human)
        rows = c.json("locations", "list")["data"]["locations"]
        require(name not in {row["name"] for row in rows}, "old-location-name-survived")
        row = next(row for row in rows if row["name"] == edited)
        require("1081" in c.json("locations", "show", edited)["data"]["configuration"],
                "location-update-content")
        c.mutate("locations", "delete", str(row["index"]), human=human)
        require(not c.json("locations", "list")["data"]["locations"], "location-delete-readback")
    c.group("locations", subscriptionReadOnlyRowsStillRequireControlledFixture=True)


def routing_cases(c):
    for human in (True, False):
        label = "human" if human else "json"
        rules = c.json("routing", "show")["data"]["routing"]["rules"]
        for key, field, value, rendered in (("ignore-rules", "ignore_rules", True, "true"),
                ("direct-domains", "direct_domain_suffixes", ["example.test"], '["Example.test"]'),
                ("block-quic-udp443", "block_quic_udp_443", True, "true")):
            c.mutate("routing", "set", key, rendered, human=human,
                     delta=int(rules[field] != value))
            rules = c.json("routing", "show")["data"]["routing"]["rules"]
            require(rules[field] == value, "routing-normalization-readback")
        desired = dict(ignore_rules=False, block_quic_udp_443=False,
                       proxy_packages=[], direct_domain_suffixes=["example.test"])
        path = c.file(f"routing 東京 {label}.json", json.dumps(
            dict(type="vpn_control_routing_rules", version=7, rules=desired)))
        c.mutate("routing", "import", "--input", str(path), human=human,
                 delta=int(rules != desired))
        require(c.json("routing", "show")["data"]["routing"]["rules"] == desired,
                "routing-import-readback")
        c.human("routing", "show")
        output = c.root / f"routing 東京 {label} export.json"
        if human:
            c.human("routing", "export", "--output", str(output))
        else:
            result = c.json("routing", "export", "--output", str(output))
            require("content" not in result["data"], "private-export-content-echo")
        saved = c.output(output)
        require(json.loads(saved["content"])["rules"] == desired, "routing-export-semantics")
        c.json("routing", "export", "--output", str(output),
               expected_exit=1, expected_code="PERSISTENCE_FAILED")
        require(c.output(output)["sha256"] == saved["sha256"], "export-overwrote-existing-file")
        raw = c.invoke("routing", "export", "--output", "-", json_output=False)
        require(raw.returncode == 0 and raw.stderr == ""
                and json.loads(raw.stdout)["rules"] == desired, "routing-raw-stdout")
    c.group("routing-and-exports", locationExportAndIndependentImportFollow=True)


def qr_and_transfer_cases(c):
    name = "PackagedQR 東京"
    text = c.file("東京 QR input.txt", f"socks://127.0.0.1:1080#{name}")
    c.mutate("locations", "add", "--input", str(text))
    document = c.root / "東京 locations export.json"
    c.json("locations", "export", "--output", str(document))
    original = c.output(document)
    human_document = c.root / "東京 locations human export.json"
    c.human("locations", "export", "--output", str(human_document))
    require(json.loads(c.output(human_document)["content"])["locations"] ==
            json.loads(original["content"])["locations"], "human-locations-export-semantics")
    require(name in json.dumps(json.loads(original["content"]), ensure_ascii=False),
            "location-export-lost-profile")
    raw = c.invoke("locations", "export", "--output", "-", json_output=False)
    raw_document = json.loads(raw.stdout)
    require(raw.returncode == 0 and raw.stderr == ""
            and raw_document["type"] == json.loads(original["content"])["type"]
            and name in json.dumps(raw_document, ensure_ascii=False), "locations-raw-stdout")
    c.json("locations", "export", "--output", str(document),
           expected_exit=1, expected_code="PERSISTENCE_FAILED")
    require(c.output(document)["sha256"] == original["sha256"], "locations-export-overwrite")
    png = c.root / "東京 locations QR.png"
    c.json("locations", "export", "--format", "qr-png", "--output", str(png))
    qr = c.output(png)
    require(qr["content"].startswith(b"\x89PNG\r\n\x1a\n"), "locations-QR-not-PNG")
    human_png = c.root / "東京 locations human QR.png"
    c.human("locations", "export", "--format", "qr-png", "--output", str(human_png))
    human_qr = c.output(human_png)
    require(human_qr["content"].startswith(b"\x89PNG\r\n\x1a\n"),
            "human-locations-QR-not-PNG")
    bare_png_bytes = base64.b64decode(PREPARED_QR_BASE64, validate=True)
    require(hashlib.sha256(bare_png_bytes).hexdigest() == PREPARED_QR_SHA256,
            "embedded-input-QR-digest")
    bare_png = c.file("入力 bare QR 東京.png", bare_png_bytes)
    for human in (True, False):
        c.mutate("locations", "add", "--qr-image", str(bare_png), human=human)
        require("PreparedQR" in {row["name"] for row in
                c.json("locations", "list")["data"]["locations"]}, "bare-QR-location-add")
        c.mutate("locations", "delete", "PreparedQR", human=human)
        require(c.output(bare_png)["sha256"] == PREPARED_QR_SHA256, "bare-QR-input-changed")
    for human in (True, False):
        c.mutate("locations", "delete", name)
        input_png, bound_qr = (human_png, human_qr) if human else (png, qr)
        c.mutate("locations", "import", "--qr-image", str(input_png), human=human)
        require(name in {row["name"] for row in
                c.json("locations", "list")["data"]["locations"]}, "QR-location-roundtrip")
        require(c.output(input_png)["sha256"] == bound_qr["sha256"], "QR-input-changed")
    routing_png = c.root / "東京 routing QR.png"
    desired = c.json("routing", "show")["data"]["routing"]["rules"]
    c.json("routing", "export", "--format", "qr-png", "--output", str(routing_png))
    require(c.output(routing_png)["content"].startswith(b"\x89PNG\r\n\x1a\n"),
            "routing-QR-not-PNG")
    human_routing_png = c.root / "東京 routing human QR.png"
    c.human("routing", "export", "--format", "qr-png", "--output", str(human_routing_png))
    require(c.output(human_routing_png)["content"].startswith(b"\x89PNG\r\n\x1a\n"),
            "human-routing-QR-not-PNG")
    c.mutate("routing", "set", "ignore-rules", "true", delta=int(not desired["ignore_rules"]))
    c.mutate("routing", "import", "--qr-image", str(routing_png), human=True,
             delta=int(not desired["ignore_rules"]))
    require(c.json("routing", "show")["data"]["routing"]["rules"] == desired,
            "routing-QR-roundtrip")
    c.mutate("routing", "import", "--qr-image", str(human_routing_png), delta=0)
    independent_transfer(c, document, original)
    c.mutate("locations", "delete", name)
    c.group("qr-transfer", exportedInputsBoundBeforeImport=True)


def independent_transfer(c, document, original):
    workspace = c.owner.root / "別 transfer destination workspace"
    require(workspace != c.workspace and workspace.parent == c.owner.root
            and not workspace.exists(), "independent-workspace-not-fresh")
    c.owner.guard()
    serve = c.owner.child("disconnected-transfer-serve",
        [c.owner.request["cliPath"], "--state-dir", str(workspace), "serve"])
    identity = None
    until = time.monotonic() + 30
    while time.monotonic() < until:
        require(serve.process.poll() is None, "independent-serve-ended-before-ready")
        result = c.owner.invoke(workspace, "--json", "status")
        if result.returncode == 0:
            body = c.harness["envelope"](result)
            require(body["data"]["runtimeRunning"] is False and body["final"] is True,
                    "independent-owner-not-disconnected")
            identity = body["controllerId"]
            break
        c.harness["envelope"](result, 2, "UNAVAILABLE")
        time.sleep(0.1)
    require(type(identity) is str and identity and identity != c.identity,
            "independent-owner-not-qualified")
    second = Cases(c.owner, workspace, identity, c.harness, c.root)
    require(second.json("settings", "show")["data"] == c.initial_settings,
            "configuration-crossed-workspace-boundary")
    expected = c.json("locations", "list")["data"]["locations"]
    for human in (True, False):
        require(second.json("locations", "list")["data"]["locations"] == [],
                "transfer-destination-not-empty")
        require(c.output(document)["sha256"] == original["sha256"], "source-export-changed")
        second.mutate("locations", "import", "--input", str(document), human=human)
        require(second.json("locations", "list")["data"]["locations"] == expected,
                "independent-transfer-visible-order")
        for row in expected:
            selector = row["name"]
            require(second.json("locations", "show", selector)["data"] ==
                    c.json("locations", "show", selector)["data"],
                    "independent-transfer-configuration-meaning")
            second.mutate("locations", "delete", selector)
        require(c.output(document)["sha256"] == original["sha256"], "import-mutated-source")
    second.status()
    second.json("quit")
    terminal = serve.wait()
    require(terminal["exitCode"] == 0 and not (workspace / "activation.port").exists(),
            "independent-owner-not-naturally-closed")
    c.owner.guard()
    c.record("independent-transfer-complete", {"sourceControllerId": c.identity,
        "destinationControllerId": identity, "sourceWorkspace": str(c.workspace),
        "destinationWorkspace": str(workspace), "sameAdmittedOrdinaryTokenAndPackage": True,
        "sameOriginalServeClosed": True,
        "fullMembershipAccepted": False})


def run(owner, workspace, identity, harness):
    require(owner.request["action"] == ACTION, "finite-case-action")
    require({"envelope", "source_mode_smoke", "large_transfer_smoke"} <= set(harness),
            "held-harness-functions-missing")
    root = Path(owner.root) / "切断 CLI fixture files"
    root.mkdir(exist_ok=False)
    c = Cases(owner, workspace, identity, harness, root)
    c.initial_settings = c.json("settings", "show")["data"]
    static_cases(c)
    source_cases(c)
    read_cases(c)
    settings_cases(c)
    subscription_cases(c)
    location_cases(c)
    routing_cases(c)
    qr_and_transfer_cases(c)
    diagnostics_cases(c, root)
    c.group("diagnostics-and-retained-result")
    harness["large_transfer_smoke"](c.workspace, root, identity, c.recorded_invoke)
    large_human_cases(c)
    c.group("large-documents", heldLargeTransferSmoke=True)
    c.status()
    c.record("cases-complete", {"groups": list(GROUPS), "action": ACTION,
        "baselineRerun": False, "fullWindowsAcceptance": False,
        "full64MembershipAcceptance": False,
        "remainingProcedures": ["HTTPS", "SSH", "runtime", "streaming", "GUI/UAC",
             "updates/install", "document-adversaries", "visuals"]})


def large_human_cases(c):
    """Reuse the exact large fixture after the held JSON helper has completed."""
    source = c.root / "large 東京 input.json"
    original = c.output(source)
    expected = json.loads(original["content"])["rules"]
    before = c.status()
    revision = before["configurationRevision"]
    result = c.human("routing", "import", "--input", str(source), revision=revision)
    operation = _diag_human_fields(result, c.identity, revision)["operationId"]
    retained = c.json("operations", "wait", operation)
    require(retained["operationId"] == operation and retained["configurationRevision"] == revision,
            "human-large-noop-retention")
    c.human("operations", "wait", operation)
    output = c.root / "large 東京 human export.json"
    c.human("routing", "export", "--output", str(output))
    saved = c.output(output)
    require(json.loads(saved["content"])["rules"] == expected, "human-large-export-semantics")
    c.human("routing", "export", "--output", str(output),
            expected_exit=1, expected_code="PERSISTENCE_FAILED")
    require(c.output(output)["sha256"] == saved["sha256"]
            and c.output(source)["sha256"] == original["sha256"]
            and c.status()["configurationRevision"] == revision, "human-large-readback-or-overwrite")
    c.record("large-human-complete", {"operationId": operation, "sameFixtureNoop": True,
             "bytes": saved["bytes"], "sha256": saved["sha256"]})


"""Private disconnected diagnostics cases; the caller owns every native handle.

No process is launched here.  ``core.invoke`` must retain the original process
through its known exit and both EOFs.  Text streams, when supplied instead of
bytes, must be exact strict UTF-8 decodes without newline conversion.
"""

import hashlib
import json
from pathlib import Path


def _diag_require(condition, message):
    if not condition:
        raise AssertionError(message)


def _diag_text(value):
    if isinstance(value, bytes):
        return value.decode("utf-8", "strict")
    _diag_require(isinstance(value, str), "Retained CLI stream is neither text nor bytes")
    return value


def _diag_bytes(value):
    if isinstance(value, bytes):
        return value
    return _diag_text(value).encode("utf-8", "strict")


def _diag_operation(body):
    operation = body.get("operationId")
    _diag_require(isinstance(operation, str) and bool(operation.strip()),
             "Diagnostics result lost its original operation ID")
    return operation


def _diag_human_fields(result, owner, revision, dynamic=False):
    """Validate one already-retained human response; never invoke it again."""
    stdout, stderr = _diag_text(result.stdout), _diag_text(result.stderr)
    _diag_require(result.returncode == 0, "Human diagnostics did not exit zero")
    if stdout:
        _diag_require(not stderr, "Final human diagnostics unexpectedly wrote stderr")
        rendered, code, final = stdout, "OK", True
    else:
        rendered, code, final = stderr, "ACCEPTED", False
    _diag_require(dynamic or final, "Synchronous diagnostics is not terminal")
    lines = rendered.splitlines()
    _diag_require(bool(lines) and lines[0] == code,
             "Human diagnostics code does not match its output channel")

    def one(label):
        prefix = label + ": "
        found = [line[len(prefix):] for line in lines if line.startswith(prefix)]
        _diag_require(len(found) == 1 and bool(found[0]),
                 "Human diagnostics lost unique " + label + " metadata")
        return found[0]

    _diag_require(one("Controller") == owner, "Human diagnostics changed controller")
    _diag_require(one("Revision") == str(revision), "Human diagnostics changed revision")
    _diag_require(one("Completion") == ("final" if final else "pending"),
             "Human diagnostics completion/code mismatch")
    _diag_require(one("Restart required") in ("yes", "no"),
             "Human diagnostics restart metadata is unavailable")
    request, operation = one("Request"), one("Operation")
    return {"operationId": operation, "requestId": request,
            "code": code, "final": final, "lines": lines}


def _diag_dynamic_json(core, *argv):
    result = core.invoke(*argv, json_output=True)
    observed = json.loads(_diag_text(result.stdout))
    _diag_require(isinstance(observed, dict), "Diagnostics did not return an envelope")
    code, final = observed.get("code"), observed.get("final")
    _diag_require((code, final) in (("ACCEPTED", False), ("OK", True)),
             "Diagnostics did not report accepted or known successful completion")
    return core.body(result, expected_code=code, final=final)


def _diag_report(content):
    text = content.decode("utf-8", "strict")
    lines = text.splitlines()
    _diag_require(lines and lines[0] == "VPN Control Desktop Diagnostics",
             "Diagnostics file is not the actual desktop report")
    _diag_require(any(line.startswith("generated_at=") and line != "generated_at="
                 for line in lines), "Diagnostics report lost its generation metadata")
    _diag_require("is_runtime_running=false" in lines,
             "Diagnostics does not describe the disconnected fixture")


def _diag_output(core, path):
    output = core.output(path)
    content = output.get("content")
    _diag_require(isinstance(content, bytes), "Output reader did not retain actual file bytes")
    _diag_require(output.get("bytes") == len(content)
             and output.get("sha256") == hashlib.sha256(content).hexdigest(),
             "Output reader count/hash differs from its retained file bytes")
    _diag_report(content)
    return output


def _diag_export_metadata(body, output):
    data = body.get("data")
    _diag_require(isinstance(data, dict), "Diagnostics export lost result data")
    _diag_require(data.get("format") == "text" and data.get("bytes") == output["bytes"],
             "Diagnostics export format/byte count differs from actual file")
    _diag_require("content" not in data, "File export echoed private report content")


def diagnostics_cases(core, root):
    """Exercise only diagnostics delivery/retention on one disconnected owner.

    Distinct reports contain generated_at and are never compared to one another.
    File/raw comparisons always use the same original retained operation.
    """
    root = Path(root)
    before = core.status()
    owner, revision = before["controllerId"], before["configurationRevision"]
    _diag_require(before["data"]["runtimeRunning"] is False,
             "Diagnostics fixture must remain disconnected")
    operations = []

    def destination(name):
        path = root / name
        _diag_require(not path.exists() and not path.is_symlink(),
                 "Diagnostics requires a fresh create-only destination")
        return path

    def retained(operation, expected_content=None):
        status = _diag_dynamic_json(core, "operations", "status", operation)
        _diag_require(_diag_operation(status) == operation,
                 "Diagnostics status changed original operation")
        terminal = core.json("operations", "wait", operation, revision=revision)
        _diag_require(_diag_operation(terminal) == operation,
                 "Diagnostics wait changed original operation")
        content = terminal.get("data", {}).get("content")
        _diag_require(isinstance(content, str), "Retained diagnostics result lost its report")
        encoded = content.encode("utf-8", "strict")
        _diag_report(encoded)
        if expected_content is not None:
            _diag_require(encoded == expected_content,
                     "Retained operation report differs from its original file export")
        if status["final"]:
            _diag_require(status["data"] == terminal["data"]
                     and status["configurationRevision"] == terminal["configurationRevision"],
                     "Terminal diagnostics status/wait changed retained result")
        return terminal, encoded

    for renderer in ("json", "human"):
        path = destination("diagnostics sync " + renderer + " 東京.txt")
        if renderer == "json":
            body = core.json("diagnostics", "export", "--output", str(path),
                             revision=revision)
            operation = _diag_operation(body)
        else:
            result = core.human("diagnostics", "export", "--output", str(path),
                                revision=revision)
            operation = _diag_human_fields(result, owner, revision)["operationId"]
        output = _diag_output(core, path)
        if renderer == "json":
            _diag_export_metadata(body, output)
        else:
            lines = _diag_text(result.stdout).splitlines()
            _diag_require("  format: text" in lines
                     and "  bytes: " + str(output["bytes"]) in lines
                     and not any(line.startswith("  content:") for line in lines),
                     "Human file export lost format/size or echoed private content")
        retained(operation, output["content"])
        method = core.json if renderer == "json" else core.human
        method("diagnostics", "export", "--output", str(path),
               expected_exit=1, expected_code="PERSISTENCE_FAILED", revision=revision)
        _diag_require(_diag_output(core, path)["content"] == output["content"],
                 "Rejected diagnostics overwrite changed the existing file")
        operations.append(operation)
        core.record("diagnostics-sync", {"renderer": renderer, "operationId": operation,
                    "bytes": output["bytes"], "sha256": output["sha256"],
                    "noOverwrite": True})

    for renderer in ("json", "human"):
        if renderer == "json":
            admitted = _diag_dynamic_json(core, "--async", "diagnostics", "export")
            operation, initial_final = _diag_operation(admitted), admitted["final"]
        else:
            result = core.invoke("--async", "diagnostics", "export", json_output=False)
            admitted_human = _diag_human_fields(result, owner, revision, dynamic=True)
            operation, initial_final = admitted_human["operationId"], admitted_human["final"]
        terminal, content = retained(operation)
        if renderer == "json" and initial_final:
            _diag_require(admitted["data"] == terminal["data"]
                     and admitted["configurationRevision"] == terminal["configurationRevision"],
                     "Already-final async diagnostics changed its retained report")
        if renderer == "human":
            for action in ("status", "wait"):
                result = core.human("operations", action, operation, revision=revision)
                _diag_require(_diag_human_fields(result, owner, revision)["operationId"] == operation,
                         "Human retained diagnostics changed original operation")
        path = destination("diagnostics retained " + renderer + " 東京.txt")
        method = core.json if renderer == "json" else core.human
        exported = method("operations", "wait", operation, "--output", str(path),
                          revision=revision)
        output = _diag_output(core, path)
        _diag_require(output["content"] == content,
                 "Retained diagnostics file differs from original operation content")
        if renderer == "json":
            _diag_require(_diag_operation(exported) == operation,
                     "Retained file export changed original operation")
            _diag_export_metadata(exported, output)
        else:
            _diag_require(_diag_human_fields(exported, owner, revision)["operationId"] == operation,
                     "Human retained file export changed original operation")
        method("operations", "wait", operation, "--output", str(path),
               expected_exit=1, expected_code="PERSISTENCE_FAILED", revision=revision)
        _diag_require(_diag_output(core, path)["content"] == content,
                 "Rejected retained export overwrite changed the original file")
        raw = core.invoke("operations", "wait", operation, "--output", "-",
                          json_output=False)
        _diag_require(raw.returncode == 0 and _diag_bytes(raw.stderr) == b""
                 and _diag_bytes(raw.stdout) == content,
                 "Raw retained diagnostics differs from exact original UTF-8 report")
        operations.append(operation)
        core.record("diagnostics-async-retained", {"renderer": renderer,
                    "operationId": operation, "initialFinal": initial_final,
                    "bytes": output["bytes"], "sha256": output["sha256"],
                    "fileRawContentEqual": True, "noOverwrite": True})

    after = core.status()
    _diag_require(after["controllerId"] == owner
             and after["configurationRevision"] == revision
             and after["data"]["runtimeRunning"] is False,
             "Diagnostics changed owner, configuration or disconnected runtime")
    _diag_require(len(operations) == len(set(operations)) == 4,
             "Separate diagnostics invocations reused an operation identity")
    result = {"scope": "disconnected-installed-cli-diagnostics-delivery",
              "operationIds": operations, "configurationRevision": revision,
              "rawUtf8StreamContract": "exact bytes or strict decode without newline conversion",
              "nativeAcceptance": False}
    core.record("diagnostics-cases-complete", result)
    return result
