def compose(program,own_raw,binding):
    tree=ast.parse(program)
    if ast.unparse(tree.body[-1])!='coldboot_dispatch()':raise RestoreError('restore_dispatch_changed')
    tree.body.pop();tree.body=[n for n in tree.body if not isinstance(n,ast.FunctionDef) or n.name not in ('observed_getter','probe_stage_command','probe_fence')]
    template=ast.literal_eval(next(n.value for n in ast.parse(own_raw).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='_REMOTE' for t in n.targets)))
    output=ast.unparse(tree)+'\n'+template.replace('__RESTORE__',repr(binding)).replace('__STEPS__',repr(_FIXED_RESTORE))+'\ncoldboot_dispatch()\n'
    compile(output,'<fixed-api35-proxy-restore>','exec');return output


def _write_local(path,value,prepared):
    if path.name not in ('intent.json','effect-fence.json','arm-ready.json','admission-ready.json') or path.parent.parent.name not in ('android-api35-owned-proxy-restore','android-api35-proxy-readmission-2e581948-3a05-4b75-a566-bbdee1d7c191') or path.parent.parent.parent.name!='.rag_index':raise RestoreError('restore_local_scope')
    source_path=Path(coldboot.__file__).absolute();snap=prepared['snapshots'][source_path]
    if hashlib.sha256(snap[1]).hexdigest()!='7d90c06070ffad1439e613c9ad5d63f979d43b738944f0630b2b15187f09fec6':raise RestoreError('restore_local_writer_changed')
    tree=ast.parse(snap[1]);function=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_write_local_intent')
    # Exact FD writer with only its closed local journal scope adapted. No
    # arbitrary writer or value-bearing source is accepted from a caller.
    if ast.unparse(function.body[2].test).split(' or ')[0]!="path.name != 'launch.json'":raise RestoreError('restore_local_writer_changed')
    function.body[2].test=ast.parse("path.name not in ('intent.json','effect-fence.json','arm-ready.json','admission-ready.json') or path.parent.parent.name not in ('android-api35-owned-proxy-restore','android-api35-proxy-readmission-2e581948-3a05-4b75-a566-bbdee1d7c191') or path.parent.parent.parent.name!='.rag_index' or str(uuid.UUID(path.parent.name))!=path.parent.name",mode='eval').body
    generation=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_local_generation')
    namespace=dict(os=os,sys=sys,stat=stat,re=re,json=json,Path=Path,uuid=uuid)
    exec(compile(ast.Module(body=[generation,function],type_ignores=[]),'<frozen-local-fd-writer>','exec'),namespace)
    namespace['_write_local_intent'](path,value)


def prepare(root,reservation,correlation,action='probe'):
    if not isinstance(correlation,str) or str(uuid.UUID(correlation))!=correlation or correlation in (HISTORY['correlationId'],PROBE_CORRELATION):raise RestoreError('new_correlation_required')
    if action not in ('probe','arm','restore','status'):raise RestoreError('restore_action_invalid')
    root=Path(root).absolute();path=Path(current.__file__).absolute();source=availability._snapshot(path)
    if hashlib.sha256(source[1]).hexdigest()!=CURRENT_SOURCE:raise RestoreError('current_source_changed')
    own=Path(__file__).absolute();own_snapshot=availability._snapshot(own)
    prepared=current.prepare(root,reservation,PROBE_CORRELATION)
    if availability._snapshot(path)!=source:raise RestoreError('current_source_changed')
    prepared['snapshots'][path]=source;prepared['snapshots'][own]=own_snapshot
    backend_path=Path(component.__file__).absolute();backend_snapshot=availability._snapshot(backend_path)
    if hashlib.sha256(backend_snapshot[1]).hexdigest()!=COMPONENT_SOURCE:raise RestoreError('restore_backend_source_changed')
    backend_binding=component.prepare_binding(root,prepared,'android-api35')
    if availability._snapshot(backend_path)!=backend_snapshot or prepared['snapshots'].get(backend_path)!=backend_snapshot:raise RestoreError('restore_backend_source_changed')
    component.install(prepared,backend_binding)
    if availability._snapshot(backend_path)!=backend_snapshot:raise RestoreError('restore_backend_source_changed')
    proof=_authority(root,prepared['snapshots'])
    authority={'componentBackend':backend_binding,'componentCalibrationOnly':True,'installedLauncherAccepted':False,'bundledRuntimeAccepted':False,'currentReceiptSha256':CURRENT_RECEIPT,'historical':HISTORY,'primary':PRIMARY,'historicalRowPresence':'unavailable','finalAbsentRepresentation':'new-proof-required','compiledProbeCorrelation':PROBE_CORRELATION,'dexSha256':DEX_SHA,'newSourceSha256':hashlib.sha256(own_snapshot[1]).hexdigest()}
    binding={'correlationId':correlation,'action':action,'sourceSha256':authority['newSourceSha256'],'authority':authority,'stageFence':proof['stageFence'],'deviceStageGeneration':proof['deviceStageGeneration']}
    local=root/'.rag_index/android-api35-owned-proxy-restore'/correlation
    if action=='arm':_write_local(local/'intent.json',authority,prepared)
    if action in ('arm','restore','status'):
        snap=availability._snapshot(local/'intent.json')
        if json.loads(snap[1])!=authority:raise RestoreError('restore_local_intent_changed')
        prepared['snapshots'][local/'intent.json']=snap
        authority={**authority,'localIntentPin':{'generation':list(snap[0]),'sha256':hashlib.sha256(snap[1]).hexdigest()}}
        binding['authority']=authority
    if action in ('restore','status'):
        ready=availability._snapshot(local/'arm-ready.json');value=json.loads(ready[1]);prepared['snapshots'][local/'arm-ready.json']=ready
        if value.get('correlationId')!=correlation or value.get('authority')!=authority or value.get('sourceSha256')!=binding['sourceSha256']:raise RestoreError('restore_local_arm_changed')
        binding['armPin']=value['armPin']
        if action=='restore':_write_local(local/'effect-fence.json',{'correlationId':correlation,'authority':authority,'armPin':binding['armPin'],'replayAllowed':False},prepared)
        if action=='restore':prepared['snapshots'][local/'effect-fence.json']=availability._snapshot(local/'effect-fence.json')
    prepared['restoreCorrelationId']=correlation;prepared['restoreAction']=action;prepared['restoreBinding']=binding
    prepared['program']=compose(prepared['program'],own_snapshot[1],binding)
    current.guard_prepared(prepared);return prepared


def retain_arm(root,prepared,raw):
    """Retain the exact completed arm response, never a caller boolean/command."""
    if prepared.get('restoreAction')!='arm' or not isinstance(raw,bytes) or len(raw)>4194304:raise RestoreError('restore_arm_response_invalid')
    guard_prepared(prepared);value=json.loads(raw);binding=prepared['restoreBinding']
    if value.get('state')!='restore-armed' or value.get('closingGuardsVerified')is not True or value.get('correlationId')!=binding['correlationId'] or value.get('historicalUnknownsPreserved')is not True or value.get('replayAllowed')is not False:raise RestoreError('restore_arm_response_invalid')
    record=value['result']['record'];content=record['value']
    if content.get('binding')!=binding['authority'] or content.get('correlationId')!=binding['correlationId'] or content.get('sourceSha256')!=binding['sourceSha256'] or type(content.get('schema'))is not int or content['schema']!=1:raise RestoreError('restore_arm_response_invalid')
    canonical=(json.dumps(content,sort_keys=True,separators=(',',':'))+'\n').encode()
    pin=record.get('generation')
    if not isinstance(pin,list) or len(pin)!=9 or any(type(item)is not int for item in pin) or pin[2]!=len(canonical) or not stat.S_ISREG(pin[5]) or stat.S_IMODE(pin[5])!=0o600 or pin[6:9]!=[0,0,1] or record.get('sha256')!=hashlib.sha256(canonical).hexdigest():raise RestoreError('restore_arm_response_invalid')
    path=Path(root).absolute()/'.rag_index/android-api35-owned-proxy-restore'/binding['correlationId']/'arm-ready.json'
    _write_local(path,{'correlationId':binding['correlationId'],'authority':binding['authority'],'sourceSha256':binding['sourceSha256'],'armPin':{'generation':pin,'sha256':record['sha256']},'responseSha256':hashlib.sha256(raw).hexdigest()},prepared)
    guard_prepared(prepared)
    return availability._snapshot(path)


def probe(root,reservation,correlation):return prepare(root,reservation,correlation,'probe')
def arm(root,reservation,correlation):return prepare(root,reservation,correlation,'arm')
def restore_once(root,reservation,correlation):return prepare(root,reservation,correlation,'restore')
def status(root,reservation,correlation):return prepare(root,reservation,correlation,'status')
def guard_prepared(prepared):current.guard_prepared(prepared)
def restore_carrier(prepared):
    if prepared.get('restoreAction')not in ('probe','arm','restore','status','metadata','readmission-admit','readmission-restore','readmission-status'):raise RestoreError('restore_prepared_required')
    guard_prepared(prepared);return current.ssh_carrier(prepared)


