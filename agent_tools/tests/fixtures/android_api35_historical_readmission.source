"""Fenced restore of the measured API35 owned global proxy; no transport here.

The current compiled getter is reused read-only.  A fresh correlation first
observes, then arms metadata, then consumes one restore fence. Unknown effects
never resume. Historical lifecycle/owner outcomes remain historical.
"""
from __future__ import annotations
import ast, hashlib, json, uuid, os, re, stat, sys
from pathlib import Path
from . import android_api35_current_proxy_probe as current
from . import android_device_availability as availability
