def _replace_restore(prepared,binding):
    tree=ast.parse(prepared['program']);count=0
    for node in tree.body:
        if isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='RESTORE' for t in node.targets):node.value=ast.parse(repr(binding),mode='eval').body;count+=1
    if count!=1:raise RestoreError('restore_interrupted_composition_changed')
    prepared['program']=ast.unparse(ast.fix_missing_locations(tree))+'\n';prepared['restoreBinding']=binding;prepared['restoreAction']=binding['action']

def _readmission_prepare(root,reservation,correlation,action):
    if not isinstance(correlation,str) or str(uuid.UUID(correlation))!=correlation or correlation==_INTERRUPTED:raise RestoreError('restore_readmission_correlation_invalid')
    root=Path(root).absolute();prepared=arm_metadata(root,reservation);binding=prepared['restoreBinding']
    path=root/'.runtime/parity-evidence'/ _METADATA_CAPSULE/'metadata-remote-stdout-0.private';snapshot=availability._snapshot(path)
    if hashlib.sha256(snapshot[1]).hexdigest()!=_METADATA_SHA:raise RestoreError('restore_metadata_proof_changed')
    value=json.loads(snapshot[1]);result=value['result'];record=result['record'];pin={key:record[key] for key in ('generation','sha256')}
    if value.get('state')!='arm-metadata-observed' or value.get('closingGuardsVerified')is not True or value.get('correlationId')!=_INTERRUPTED or result.get('effectFenceAbsent')is not True or result.get('terminalAbsent')is not True or result.get('originalOutcome')!='unknown' or result.get('readmissionGranted')is not False or pin!={'generation':_ORIGINAL_ARM_GEN,'sha256':_ORIGINAL_ARM_SHA}:raise RestoreError('restore_metadata_proof_changed')
    old=root/'.runtime/parity-evidence'/ _METADATA_CAPSULE/'helper.py';old_snapshot=availability._snapshot(old)
    if hashlib.sha256(old_snapshot[1]).hexdigest()!=_METADATA_SOURCE:raise RestoreError('restore_metadata_source_changed')
    prepared['snapshots'].update({path:snapshot,old:old_snapshot})
    authority={'correlationId':correlation,'sourceSha256':hashlib.sha256(prepared['snapshots'][Path(__file__).absolute()][1]).hexdigest(),'originalCorrelationId':_INTERRUPTED,'originalSourceSha256':_INTERRUPTED_SOURCE,'originalArmPin':pin,'metadataProofPin':{'generation':list(snapshot[0]),'sha256':_METADATA_SHA},'metadataSourceSha256':_METADATA_SOURCE,'originalAuthority':binding['authority'],'originalOutcome':'unknown','replayAllowed':False}
    local=root/'.rag_index'/('android-api35-proxy-readmission-'+_INTERRUPTED)/correlation
    if action=='admit':_write_local(local/'intent.json',authority,prepared)
    intent=availability._snapshot(local/'intent.json')
    if json.loads(intent[1])!=authority:raise RestoreError('restore_readmission_local_changed')
    prepared['snapshots'][local/'intent.json']=intent
    operation={**authority,'localIntentPin':{'generation':list(intent[0]),'sha256':hashlib.sha256(intent[1]).hexdigest()}}
    binding['readmission']=operation;binding['action']='readmission-'+action
    if action in ('restore','status'):
        ready=availability._snapshot(local/'admission-ready.json');v=json.loads(ready[1])
        if v.get('operation')!=operation or v.get('originalOutcome')!='unknown':raise RestoreError('restore_readmission_local_changed')
        _regular_root_pin(v['readmissionPin']);binding['readmissionPin']=v['readmissionPin'];prepared['snapshots'][local/'admission-ready.json']=ready
        if action=='restore':
            _write_local(local/'effect-fence.json',{'operation':operation,'readmissionPin':binding['readmissionPin'],'replayAllowed':False},prepared)
            prepared['snapshots'][local/'effect-fence.json']=availability._snapshot(local/'effect-fence.json')
    _replace_restore(prepared,binding);prepared['readmissionCorrelationId']=correlation;guard_prepared(prepared);return prepared

def _regular_root_pin(pin):
    generation=pin.get('generation');sha=pin.get('sha256')
    if not isinstance(generation,list) or len(generation)!=9 or any(type(x)is not int for x in generation) or not stat.S_ISREG(generation[5]) or stat.S_IMODE(generation[5])!=0o600 or generation[6:9]!=[0,0,1] or not 0<generation[2]<=262144 or not isinstance(sha,str) or re.fullmatch('[0-9a-f]{64}',sha)is None:raise RestoreError('restore_readmission_pin_invalid')

def readmission_admit(root,reservation,correlation):return _readmission_prepare(root,reservation,correlation,'admit')
def readmission_restore_once(root,reservation,correlation):return _readmission_prepare(root,reservation,correlation,'restore')
def readmission_status(root,reservation,correlation):return _readmission_prepare(root,reservation,correlation,'status')

def retain_readmission(root,prepared,raw):
    if prepared.get('restoreAction')!='readmission-admit' or not isinstance(raw,bytes) or len(raw)>4194304:raise RestoreError('restore_readmission_response_invalid')
    guard_prepared(prepared);value=json.loads(raw);binding=prepared['restoreBinding'];operation=binding['readmission']
    if value.get('state')!='restore-readmission-admitted' or value.get('closingGuardsVerified')is not True or value.get('correlationId')!=_INTERRUPTED or value.get('historicalUnknownsPreserved')is not True or value.get('replayAllowed')is not False:raise RestoreError('restore_readmission_response_invalid')
    record=value['result']['record'];pin={key:record[key] for key in ('generation','sha256')};_regular_root_pin(pin)
    expected={'schema':1,'operation':operation,'originalArmPin':operation['originalArmPin'],'originalOutcome':'unknown','replayAllowed':False}
    if record['value']!=expected:raise RestoreError('restore_readmission_response_invalid')
    encoded=(json.dumps(expected,sort_keys=True,separators=(',',':'))+'\n').encode()
    if hashlib.sha256(encoded).hexdigest()!=pin['sha256'] or len(encoded)!=pin['generation'][2]:raise RestoreError('restore_readmission_response_invalid')
    path=Path(root).absolute()/'.rag_index'/('android-api35-proxy-readmission-'+_INTERRUPTED)/operation['correlationId']/'admission-ready.json'
    _write_local(path,{'operation':operation,'readmissionPin':pin,'originalOutcome':'unknown','responseSha256':hashlib.sha256(raw).hexdigest()},prepared);guard_prepared(prepared);return availability._snapshot(path)
