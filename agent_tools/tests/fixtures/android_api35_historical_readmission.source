def arm_metadata(root,reservation):
    """Fixed read-only census of the consumed interrupted arm; no adoption."""
    root=Path(root).absolute()
    prepared=prepare(root,reservation,_INTERRUPTED,'probe')
    path=root/'.runtime/parity-evidence'/ _INTERRUPTED_CAPSULE/'arm-program.py'
    snapshot=availability._snapshot(path)
    if hashlib.sha256(snapshot[1]).hexdigest()!=_INTERRUPTED_PROGRAM:raise RestoreError('restore_interrupted_source_changed')
    tree=ast.parse(snapshot[1]);assignments=[n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='RESTORE' for t in n.targets)]
    if len(assignments)!=1:raise RestoreError('restore_interrupted_binding_changed')
    # JSON serialization was the measured original representation boundary.
    binding=json.loads(json.dumps(ast.literal_eval(assignments[0].value)))
    if binding['correlationId']!=_INTERRUPTED or binding['action']!='arm' or binding['sourceSha256']!=_INTERRUPTED_SOURCE:raise RestoreError('restore_interrupted_binding_changed')
    own=root/'.runtime/parity-evidence'/ _INTERRUPTED_CAPSULE/'helper.py';own_snapshot=availability._snapshot(own)
    if hashlib.sha256(own_snapshot[1]).hexdigest()!=_INTERRUPTED_SOURCE:raise RestoreError('restore_interrupted_source_changed')
    local=root/'.rag_index/android-api35-owned-proxy-restore'/ _INTERRUPTED/'intent.json';intent=availability._snapshot(local);pin={'generation':list(intent[0]),'sha256':hashlib.sha256(intent[1]).hexdigest()}
    if pin!=binding['authority']['localIntentPin'] or json.loads(intent[1])!={k:v for k,v in binding['authority'].items() if k!='localIntentPin'}:raise RestoreError('restore_interrupted_intent_changed')
    binding['action']='metadata';newtree=ast.parse(prepared['program']);count=0
    for node in newtree.body:
        if isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='RESTORE' for t in node.targets):node.value=ast.parse(repr(binding),mode='eval').body;count+=1
    if count!=1:raise RestoreError('restore_interrupted_composition_changed')
    prepared['program']=ast.unparse(ast.fix_missing_locations(newtree))+'\n';prepared['restoreAction']='metadata';prepared['restoreBinding']=binding
    prepared['snapshots'].update({path:snapshot,own:own_snapshot,local:intent});guard_prepared(prepared)
    return prepared


