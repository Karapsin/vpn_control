PRIMARY={'ProxyTracker':'80e1fca0d07e4adb44042b4dcac2b0cb9f318d24ea651e6369613dd3ad626cb0','ConnectivityService':'91b5d7a9922cd2386cae8284cc64b30dccbba180c55b098bea62756177937818'}
_FIXED_RESTORE=(('put','http_proxy',':0'),('delete','global_http_proxy_host',None),('delete','global_http_proxy_port',None),('delete','global_http_proxy_pac',None),('delete','http_proxy',None))
class RestoreError(ValueError):pass
HISTORY={'correlationId':'0dd55704-1e80-4d62-8d9d-2f0a123e0c3b','lifecycleSha256':'b550f7ae50f60bcf53c0d688efda2165a6c39b505a997235bd9d78c710757e59','setupSha256':'e5770bf62b8a67a6adb02b8c15c0d3690403a3080d7012045f527f62c0293d21','cleanupSha256':'527c817340526e7c4ac6e933ce10b907827e7c347af8dc117b6ee6a8479ac636','intentSha256':'1b1eba7b0744ae47adc98b6b7fd7cc1480bc62a5b2ed7d4902fb36de580d7656','dispatchSha256':'23e6c8babcf76401f099d4636d569c922064e8334da647d05e795a612b704412'}

_REMOTE=r'''
RESTORE=__RESTORE__
RESTORE_STEPS=__STEPS__
RESTORE_KEYS=('http_proxy','global_http_proxy_host','global_http_proxy_port','global_http_proxy_pac','global_http_proxy_exclusion_list')
RESTORE_OWNED={'http_proxy':'null','global_http_proxy_host':'127.0.0.1','global_http_proxy_port':'45635','global_http_proxy_pac':'null','global_http_proxy_exclusion_list':''}
RESTORE_NORMAL={'http_proxy':':0','global_http_proxy_host':'','global_http_proxy_port':'0','global_http_proxy_pac':'','global_http_proxy_exclusion_list':''}

def restore_read(command,mode):
 if not RESTORE_CLOSING and time.monotonic()>=RESTORE_DEADLINE:raise ValueError('restore_deadline_exceeded')
 case={'fd':3,'mode':mode,'command':command};PROBE_CASES.append(case)
 try:return probe_read(case)
 except BaseException:
  # The frozen reader retains bounded partial bytes in GETTER_RECORDS.
  raise

def restore_settings_command():
 # list distinguishes absent rows from a literal stored "null". Fixed keys only.
 return 'set -eu; test "$(/system/bin/id -u)" = 2000; rows=$(/system/bin/settings list global); printf "%s\\n" "$rows" | while IFS= read -r row; do case "$row" in http_proxy=*|global_http_proxy_host=*|global_http_proxy_port=*|global_http_proxy_pac=*|global_http_proxy_exclusion_list=*) printf "%s\\n" "$row";; esac; done' 

def restore_settings(reply):
 rows={}
 for line in probe_lines(reply):
  key,sep,value=line.partition('=')
  if key in RESTORE_KEYS:
   if not sep or key in rows:raise ValueError('restore_settings_schema_changed')
   rows[key]=value
 if any(len(value)>4096 for value in rows.values()):raise ValueError('restore_settings_unbounded')
 return {'rows':rows,'values':{key:rows.get(key,'null') for key in RESTORE_KEYS}}

def restore_proxy_kind(value):
 reads=value['reads']
 if len(reads)!=2:raise ValueError('restore_binder_reads_changed')
 if all(item=={'global':None,'defaultForShell':None} for item in reads):return 'clear'
 expected={'host':'127.0.0.1','port':45635,'exclusionList':[''],'pacUrl':''}
 if all(item=={'global':expected,'defaultForShell':expected} for item in reads):return 'owned'
 raise ValueError('restore_binder_foreign')

def restore_fixed_step(index):
 if type(index)is not int or not 0<=index<len(RESTORE_STEPS):raise ValueError('restore_step_invalid')
 op,key,value=RESTORE_STEPS[index];q=__import__('shlex').quote
 return 'set -eu; test "$(/system/bin/id -u)" = 2000; /system/bin/settings '+op+' global '+q(key)+(' '+q(value) if value is not None else '')

def restore_public_reply(record,kind):
 if type(record.get('returncode'))is not int or record['returncode']!=0 or record.get('stderrRaw')!='' or record.get('captureComplete')is not True or record.get('componentRuntime')!='EXTERNAL_JDK' or record.get('backendSourceSha256')!=RESTORE['authority']['componentBackend']['backendSourceSha256'] or record.get('installedLauncherAccepted')is not False or record.get('bundledRuntimeAccepted')is not False:raise ValueError('restore_public_transport_unknown')
 return fd_guard_reply(record,kind)

def restore_guard(directory,baseline_stage):
 global GETTER_APK_PASS
 if not RESTORE_CLOSING and time.monotonic()>=RESTORE_DEADLINE:raise ValueError('restore_deadline_exceeded')
 getter_generation(directory)
 if getter_stage()!=baseline_stage:raise ValueError('restore_cli_stage_changed')
 GETTER_APK_PASS='Current'
 if getter_apk()!=GETTER['packageSha256']:raise ValueError('restore_package_changed')
 status=getter_cli(['status'],FD_OWNER);GETTER_RECORDS.setdefault('restorePublic',[]).append(status);restore_public_reply(status,'status')
 operations=getter_cli(['operations','list'],FD_OWNER);GETTER_RECORDS['restorePublic'].append(operations);restore_public_reply(operations,'operations')
 # This also rechecks the authenticated compiled file and its parent full gens.
 generation_reply=restore_read(probe_generation_command(),'restore-dex-generation');GETTER_RECORDS.setdefault('restoreDex',[]).append(generation_reply)
 if probe_generation(generation_reply)!=RESTORE['deviceStageGeneration']:raise ValueError('restore_dex_changed')
 return status

def restore_census(directory,baseline_stage):
 restore_guard(directory,baseline_stage)
 first=restore_read(restore_settings_command(),'restore-settings-before');GETTER_RECORDS.setdefault('restoreSettings',[]).append(first);before=restore_settings(first)
 binder_reply=restore_read(probe_getter_command(RESTORE['deviceStageGeneration']['file']),'restore-binder');GETTER_RECORDS.setdefault('restoreBinder',[]).append(binder_reply);binder=parse_probe_current(binder_reply)
 second=restore_read(restore_settings_command(),'restore-settings-after');GETTER_RECORDS['restoreSettings'].append(second);after=restore_settings(second)
 if before!=after:raise ValueError('restore_settings_changed')
 restore_guard(directory,baseline_stage)
 return {'settings':after,'binder':binder,'kind':restore_proxy_kind(binder)}

def restore_expected(census,values,kind,absent=()):
 if census['settings']['values']!=values or census['kind']!=kind or any(key in census['settings']['rows'] for key in absent):raise ValueError('restore_proxy_changed')

# Remote journal is an authenticated child of the original e3 journal. The
# inherited dispatcher holds the original device lock for all actions.
def restore_journal(directory):return directory/('proxy-restore-'+RESTORE['correlationId'])

def restore_journal_open(directory):
 chain,leaf=parent_fds(restore_journal(directory)/'__record__');guard_parents(chain)
 fd=os.dup(chain[-1]['fd']);pin=fp(os.fstat(fd))
 if not stat.S_ISDIR(pin[5]) or stat.S_IMODE(pin[5])!=0o700 or pin[6:8]!=[0,0]:raise ValueError('restore_journal_unsafe')
 return chain,fd,pin

def restore_record(directory,name,value=None):
 if name not in ('arm.json','readmission.json','effect-fence.json','terminal.json'):raise ValueError('restore_record_invalid')
 chain,fd,pin=restore_journal_open(directory);record=None
 try:
  guard_parents(chain)
  flags=os.O_RDONLY|os.O_NOFOLLOW if value is None else os.O_RDWR|os.O_NOFOLLOW|os.O_CREAT|os.O_EXCL
  record=os.open(name,flags,0o600,dir_fd=fd)
  if value is not None:
   raw=(json.dumps(value,sort_keys=True,separators=(',',':'))+'\n').encode();at=0
   while at<len(raw):
    count=os.write(record,raw[at:])
    if count<=0:raise ValueError('restore_record_incomplete')
    at+=count
   os.fsync(record)
  before=fp(os.fstat(record))
  if not stat.S_ISREG(before[5]) or before[6:9]!=[0,0,1] or stat.S_IMODE(before[5])!=0o600 or before[2]>262144:raise ValueError('restore_record_unsafe')
  os.lseek(record,0,os.SEEK_SET);raw=os.read(record,262145)
  if len(raw)>262144 or before!=fp(os.fstat(record)) or before!=fp(os.stat(name,dir_fd=fd,follow_symlinks=False)):raise ValueError('restore_record_changed')
  after=fp(os.fstat(fd))
  if value is None:
   if after!=pin:raise ValueError('restore_journal_changed')
  elif any(after[n]!=pin[n] for n in (0,1,5,6,7,8)):raise ValueError('restore_journal_changed')
  chain[-1]['pin']=after;guard_parents(chain)
  if fp(os.stat(restore_journal(directory)))!=after:raise ValueError('restore_journal_changed')
  result=json.loads(raw)
  if value is not None and result!=value:raise ValueError('restore_record_changed')
  return {'value':result,'generation':before,'sha256':hashlib.sha256(raw).hexdigest()}
 finally:
  if record is not None:os.close(record)
  os.close(fd);close_parents(chain)

def restore_arm(directory,census):
 # Authenticate original fb44 stage-fence before permitting the single new
 # child. Only that controlled parent nlink/ctime progression is accepted.
 old=RESTORE['stageFence'];probe_fence_guard(directory,old)
 chain,leaf=parent_fds(directory/'__restore_child__');guard_parents(chain);fd=os.dup(chain[-1]['fd'])
 try:
  before=fp(os.fstat(fd));inventory=sorted(os.listdir(fd));original=probe_original_records(directory)
  if before!=old['parentGeneration'] or inventory!=old['parentInventory']:raise ValueError('restore_parent_changed')
  try:os.mkdir(restore_journal(directory).name,0o700,dir_fd=fd)
  except FileExistsError:raise ValueError('restore_correlation_consumed')
  after=fp(os.fstat(fd))
  if any(after[n]!=before[n] for n in (0,1,5,6,7)) or after[8]!=before[8]+1 or fp(directory.lstat())!=after or sorted(os.listdir(fd))!=sorted(inventory+[restore_journal(directory).name]) or probe_original_records(directory)!=original:raise ValueError('restore_parent_changed')
  chain[-1]['pin']=after;guard_parents(chain);os.fsync(fd)
  adjusted={**old,'parentGeneration':after,'parentInventory':sorted(inventory+[restore_journal(directory).name])};probe_fence_guard(directory,adjusted)
 finally:os.close(fd);close_parents(chain)
 journal_identity=fp(os.stat(restore_journal(directory),follow_symlinks=False))
 value={'journalIdentity':{str(n):journal_identity[n] for n in (0,1,5,6,7,8)},'schema':1,'correlationId':RESTORE['correlationId'],'sourceSha256':RESTORE['sourceSha256'],'binding':RESTORE['authority'],'stageFence':adjusted,'census':census,'replayAllowed':False}
 return restore_record(directory,'arm.json',value)

def restore_arm_guard(directory):
 record=restore_record(directory,'arm.json');value=record['value']
 if value.get('schema')!=1 or type(value.get('schema'))is not int or value.get('correlationId')!=RESTORE['correlationId'] or value.get('sourceSha256')!=RESTORE['sourceSha256'] or value.get('binding')!=RESTORE['authority'] or value.get('replayAllowed')is not False:raise ValueError('restore_arm_changed')
 identity=fp(os.stat(restore_journal(directory),follow_symlinks=False))
 if value.get('journalIdentity')!={str(n):identity[n] for n in (0,1,5,6,7,8)}:raise ValueError('restore_journal_changed')
 names=sorted(p.name for p in restore_journal(directory).iterdir())
 allowed=(['arm.json'],['arm.json','effect-fence.json'],['arm.json','effect-fence.json','terminal.json'])
 if RESTORE['action'].startswith('readmission-'):
  allowed=(['arm.json','readmission.json'],['arm.json','effect-fence.json','readmission.json'],['arm.json','effect-fence.json','readmission.json','terminal.json'])
  if RESTORE['action']=='readmission-admit':allowed=(['arm.json'],)
 if names not in allowed:raise ValueError('restore_journal_inventory_changed')
 probe_fence_guard(directory,value['stageFence']);restore_expected(value['census'],RESTORE_OWNED,'owned')
 if RESTORE['action']in ('restore','status') and {key:record[key] for key in ('generation','sha256')}!=RESTORE['armPin']:raise ValueError('restore_arm_changed')
 if RESTORE['action'].startswith('readmission-') and {key:record[key] for key in ('generation','sha256')}!=RESTORE['readmission']['originalArmPin']:raise ValueError('restore_readmission_arm_changed')
 return record

def restore_metadata(directory,census):
 # Original interrupted arm only: no mutation, no acceptance or ready adoption.
 record=restore_arm_guard(directory);value=record['value'];old=RESTORE['stageFence'];adjusted=value['stageFence']
 before=old['parentGeneration'];after=adjusted['parentGeneration'];name=restore_journal(directory).name
 if any(after[n]!=before[n] for n in (0,1,5,6,7)) or after[8]!=before[8]+1 or adjusted!={**old,'parentGeneration':after,'parentInventory':sorted(old['parentInventory']+[name])}:raise ValueError('restore_metadata_parent_changed')
 if value['census']!=census:raise ValueError('restore_metadata_census_changed')
 chain,fd,pin=restore_journal_open(directory)
 try:
  guard_parents(chain)
  if sorted(os.listdir(fd))!=['arm.json']:raise ValueError('restore_metadata_effect_unknown')
  for leaf in ('effect-fence.json','terminal.json'):
   try:os.stat(leaf,dir_fd=fd,follow_symlinks=False)
   except FileNotFoundError:pass
   else:raise ValueError('restore_metadata_effect_unknown')
  if fp(os.fstat(fd))!=pin:raise ValueError('restore_metadata_journal_changed')
  guard_parents(chain)
 finally:os.close(fd);close_parents(chain)
 if restore_arm_guard(directory)!=record:raise ValueError('restore_metadata_record_changed')
 return {'state':'arm-metadata-observed','record':record,'effectFenceAbsent':True,'terminalAbsent':True,'originalOutcome':'unknown','readmissionGranted':False}

def restore_readmission_guard(directory):
 readmission=restore_record(directory,'readmission.json');value=readmission['value'];operation=RESTORE['readmission']
 if value!={'schema':1,'operation':operation,'originalArmPin':operation['originalArmPin'],'originalOutcome':'unknown','replayAllowed':False}:raise ValueError('restore_readmission_changed')
 if RESTORE['action']!='readmission-admit' and {key:readmission[key] for key in ('generation','sha256')}!=RESTORE['readmissionPin']:raise ValueError('restore_readmission_pin_changed')
 restore_arm_guard(directory)
 return readmission

def restore_readmission_admit(directory,census):
 # The original consumed arm is only bridged by its independently observed pin.
 restore_metadata(directory,census)
 operation=RESTORE['readmission']
 value={'schema':1,'operation':operation,'originalArmPin':operation['originalArmPin'],'originalOutcome':'unknown','replayAllowed':False}
 return restore_record(directory,'readmission.json',value)

def restore_operation():
 return RESTORE.get('readmission',RESTORE)

def restore_transaction(directory,baseline_stage):
 arm=restore_arm_guard(directory);original=probe_original_records(directory)
 readmission=restore_readmission_guard(directory) if 'readmission' in RESTORE else None;operation=restore_operation()
 current=restore_census(directory,baseline_stage);restore_expected(current,RESTORE_OWNED,'owned')
 # Durable O_EXCL fence before the FIRST settings command. No resume exists.
 fence=restore_record(directory,'effect-fence.json',{'schema':1,'correlationId':operation['correlationId'],'sourceSha256':operation['sourceSha256'],'readmissionPin':RESTORE.get('readmissionPin'),'armPin':{k:arm[k] for k in ('generation','sha256')},'initial':current,'effect':'owned-global-proxy-restore','replayAllowed':False})
 expected=dict(RESTORE_OWNED);kind='owned';absent=[]
 for index,step in enumerate(RESTORE_STEPS):
  if probe_original_records(directory)!=original or restore_arm_guard(directory)!=arm or restore_record(directory,'effect-fence.json')!=fence:raise ValueError('restore_authority_changed')
  if readmission is not None and restore_readmission_guard(directory)!=readmission:raise ValueError('restore_readmission_changed')
  before=restore_census(directory,baseline_stage);restore_expected(before,expected,kind,absent)
  effect=restore_read(restore_fixed_step(index),'restore-effect-'+str(index));GETTER_RECORDS.setdefault('restoreEffects',[]).append(effect);probe_lines(effect)
  if index==0:
   # SettingsObserver delivery is asynchronous. Permit no subsequent effect
   # until the exact clear tuple and two NULL Binder reads are proven.
   cleared=None
   for poll in range(8):
    seen=restore_census(directory,baseline_stage)
    if seen['settings']['values']==RESTORE_NORMAL and seen['kind']=='clear':cleared=seen;break
    # Only the known pre/post values may appear while the internal four writes
    # progress. Any foreign setting/binder fails closed.
    if seen['kind']not in ('owned','clear') or any(seen['settings']['values'][key]not in (RESTORE_OWNED[key],RESTORE_NORMAL[key]) for key in RESTORE_KEYS):raise ValueError('restore_trigger_foreign')
    time.sleep(0.1)
   if cleared is None:raise ValueError('restore_trigger_not_observed')
   expected=dict(RESTORE_NORMAL);kind='clear'
  else:
   key=step[1];expected[key]='null';absent.append(key)
   after=restore_census(directory,baseline_stage);restore_expected(after,expected,'clear',absent)
 final=restore_census(directory,baseline_stage);restore_expected(final,{key:'' if key=='global_http_proxy_exclusion_list' else 'null' for key in RESTORE_KEYS},'clear',list(RESTORE_KEYS[:-1]))
 if final['settings']['rows']!={'global_http_proxy_exclusion_list':''}:raise ValueError('restore_final_rows_changed')
 if readmission is not None and restore_readmission_guard(directory)!=readmission:raise ValueError('restore_readmission_changed')
 terminal={'schema':1,'correlationId':operation['correlationId'],'sourceSha256':operation['sourceSha256'],'readmissionPin':RESTORE.get('readmissionPin'),'originalOutcome':'unknown','state':'owned-proxy-restored','final':final,'fenceSha256':fence['sha256'],'historicalUnknownsPreserved':True,'replayAllowed':False}
 return restore_record(directory,'terminal.json',terminal)

def observed_getter(directory):
 global GETTER_RECORDS,GETTER_APK_PASS,PROBE_CASES,RESTORE_CLOSING,RESTORE_DEADLINE
 RESTORE_CLOSING=False;RESTORE_DEADLINE=time.monotonic()+600
 GETTER_RECORDS={'shellFdReads':[]};PROBE_CASES=[];result=None;failure=None;closing=False;stage=None
 try:
  stage=getter_stage();initial=restore_census(directory,stage)
  if RESTORE['action']=='probe':
   probe_fence_guard(directory,RESTORE['stageFence']);restore_expected(initial,RESTORE_OWNED,'owned');result={'state':'owned-proxy-observed','census':initial}
  elif RESTORE['action']=='arm':
   restore_expected(initial,RESTORE_OWNED,'owned');record=restore_arm(directory,initial);result={'state':'restore-armed','record':record}
  elif RESTORE['action']=='metadata':
   restore_expected(initial,RESTORE_OWNED,'owned');result=restore_metadata(directory,initial)
  elif RESTORE['action']=='readmission-admit':
   restore_expected(initial,RESTORE_OWNED,'owned');record=restore_readmission_admit(directory,initial);result={'state':'restore-readmission-admitted','record':record}
  elif RESTORE['action']=='readmission-restore':result={'state':'owned-proxy-restored','record':restore_transaction(directory,stage)}
  elif RESTORE['action']=='readmission-status':
   restore_readmission_guard(directory);arm=restore_arm_guard(directory);operation=restore_operation()
   try:
    terminal=restore_record(directory,'terminal.json');fence=restore_record(directory,'effect-fence.json');value=terminal['value']
    if type(value.get('schema'))is not int or value['schema']!=1 or value.get('historicalUnknownsPreserved')is not True or value.get('correlationId')!=operation['correlationId'] or value.get('sourceSha256')!=operation['sourceSha256'] or value.get('readmissionPin')!=RESTORE['readmissionPin'] or value.get('state')!='owned-proxy-restored' or value.get('fenceSha256')!=fence['sha256'] or value.get('originalOutcome')!='unknown' or value.get('replayAllowed')is not False:raise ValueError('restore_readmission_terminal_changed')
    if type(fence['value'].get('schema'))is not int or fence['value']['schema']!=1 or fence['value'].get('armPin')!=operation['originalArmPin'] or fence['value'].get('replayAllowed')is not False or fence['value'].get('effect')!='owned-global-proxy-restore' or fence['value'].get('correlationId')!=operation['correlationId'] or fence['value'].get('sourceSha256')!=operation['sourceSha256'] or fence['value'].get('readmissionPin')!=RESTORE['readmissionPin']:raise ValueError('restore_readmission_fence_changed')
    final_values={key:'' if key=='global_http_proxy_exclusion_list' else 'null' for key in RESTORE_KEYS}
    restore_expected(initial,final_values,'clear',list(RESTORE_KEYS[:-1]));restore_expected(value['final'],final_values,'clear',list(RESTORE_KEYS[:-1]))
    if initial['settings']['rows']!={'global_http_proxy_exclusion_list':''} or initial!=value['final']:raise ValueError('restore_terminal_changed')
    result={'state':'owned-proxy-restored','record':terminal,'originalOutcome':'unknown'}
   except FileNotFoundError:result={'state':'unknown','reason':'restore_terminal_absent','arm':arm}
  elif RESTORE['action']=='restore':result={'state':'owned-proxy-restored','record':restore_transaction(directory,stage)}
  elif RESTORE['action']=='status':
   arm=restore_arm_guard(directory)
   try:
    terminal=restore_record(directory,'terminal.json');value=terminal['value'];fence=restore_record(directory,'effect-fence.json')
    if type(value.get('schema'))is not int or value.get('schema')!=1 or value.get('correlationId')!=RESTORE['correlationId'] or value.get('sourceSha256')!=RESTORE['sourceSha256'] or value.get('state')!='owned-proxy-restored' or value.get('fenceSha256')!=fence['sha256'] or value.get('historicalUnknownsPreserved')is not True or value.get('replayAllowed')is not False:raise ValueError('restore_terminal_changed')
    final_values={key:'' if key=='global_http_proxy_exclusion_list' else 'null' for key in RESTORE_KEYS}
    restore_expected(initial,final_values,'clear',list(RESTORE_KEYS[:-1]));restore_expected(value['final'],final_values,'clear',list(RESTORE_KEYS[:-1]))
    if initial['settings']['rows']!={'global_http_proxy_exclusion_list':''} or initial!=value['final']:raise ValueError('restore_terminal_changed')
    result={'state':'owned-proxy-restored','record':terminal}
   except FileNotFoundError:result={'state':'unknown','reason':'restore_terminal_absent','arm':arm}
  else:raise ValueError('restore_action_invalid')
 except (ValueError,OSError,KeyError,TypeError,UnicodeError,subprocess.TimeoutExpired) as error:
  failure=str(error) if isinstance(error,ValueError) and re.fullmatch(r'(?:restore|probe|getter|coldboot)_[a-z_]{1,72}',str(error)) else 'restore_execution_unknown'
 finally:
  RESTORE_CLOSING=True
  try:
   if stage is not None:restore_guard(directory,stage)
   else:raise ValueError('restore_stage_unobserved')
   closing=True
  except (ValueError,OSError,KeyError,TypeError,UnicodeError,subprocess.TimeoutExpired):failure='restore_closing_guard_rejected';result=None
 return {'state':result['state'] if result is not None and closing else 'unknown','reason':failure,'correlationId':RESTORE['correlationId'],'operationCorrelationId':RESTORE.get('readmission',{}).get('correlationId'),'result':result,'records':GETTER_RECORDS,'closingGuardsVerified':closing,'productAdmitted':False,'acceptanceComplete':False,'historicalUnknownsPreserved':True,'replayAllowed':False,'rootUsed':False,'stageRetained':True}
'''


def _authority(root, snapshots):
    def fixed(relative,sha):
        path=root/relative;snap=availability._snapshot(path)
        if hashlib.sha256(snap[1]).hexdigest()!=sha:raise RestoreError('historical_proof_changed')
        snapshots[path]=snap;return json.loads(snap[1])
    result=fixed('.runtime/parity-evidence/'+CAPSULE+'/result-0.private',CURRENT_RECEIPT)
    if result.get('state')!='current-os-proxy-observed' or result.get('closingGuardsVerified')is not True or result.get('correlationId')!=PROBE_CORRELATION or result.get('proxyObservationVerified')is not True:raise RestoreError('current_proof_changed')
    lifecycle=fixed('.runtime/parity-evidence/android-current/api35-update-0dd-lifecycle-receipt.json',HISTORY['lifecycleSha256'])
    retirement=fixed('.runtime/parity-evidence/android-current/api35-retirement-d0fb-native-receipt.json','96489c3073bb358ba9a51e61331c6dc67eefae5de7c13f0dd2cff727c0b04eba')
    base='.rag_index/android-installer-dispatch/'+HISTORY['correlationId']+'/'
