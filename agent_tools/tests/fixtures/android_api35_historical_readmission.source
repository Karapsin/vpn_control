CURRENT_SOURCE='415f6992a47d10c453f292c13889db1dbbc5426d0c818ce245d7bae215927d48'
COMPONENT_SOURCE='c466a58180280fc0606481b423f19e51f9900b82ea09718df4f3b8b504ad7782'
DEX_SHA='9d8166f140df3bff4223776345f9982a4b70b9f65c7eddb992f782f22aa5fa16'
