  names=sorted(os.listdir(directory));interval_need(len(names)<=INTERVAL_REPORT_COUNT_MAX,'interval_collection_report_count')
  total=0
  for name in names:
   interval_need(re.fullmatch('interval-[0-9a-f]{32}\.json',name),'interval_collection_foreign_name')
   info=os.stat(name,dir_fd=directory,follow_symlinks=False);interval_need(0<info.st_size<=INTERVAL_REPORT_FILE_MAX,'interval_collection_file_bound_or_principal');total+=info.st_size
  interval_need(total<=INTERVAL_REPORT_TOTAL_MAX,'interval_collection_aggregate_bound')
  refs=[];raws={}
  for name in names:
   reference,raw=interval_read_report(directory,name,identity);refs.append(reference);raws[reference['recordId']]=raw
  interval_references(refs,INTERVAL_REPORT_CONTEXT);interval_chain_guard(chain)
  interval_need(sorted(os.listdir(directory))==names and interval_pin(os.fstat(directory))==full_identity and interval_pin(os.stat('current-intervals',dir_fd=chain[-1][1],follow_symlinks=False))==full_identity,'interval_collection_directory_changed')
  return identity,refs,raws
 finally:
  if directory is not None:os.close(directory)
  for unused,fd,unused2 in reversed(chain):os.close(fd)
def interval_report_main():
 request=INTERVAL_REPORT_REQUEST
 interval_need(type(request)is dict and request.get('action')in('discover','slice'),'interval_collection_request_invalid')
 if request['action']=='discover':interval_need(set(request)=={'action'},'interval_collection_request_invalid')
 else:
  interval_need(set(request)=={'action','slices'} and type(request['slices'])is list and 1<=len(request['slices'])<=INTERVAL_REPORT_COUNT_MAX,'interval_collection_request_invalid')
  total=0;seen=set()
  for item in request['slices']:
   interval_need(type(item)is dict and set(item)=={'reference','offset','length'},'interval_collection_slice_invalid');ref=interval_reference(item['reference'],INTERVAL_REPORT_CONTEXT)
   interval_need(type(item['offset'])is int and type(item['length'])is int and 0<=item['offset']<ref['bytes'] and 0<item['length']<=INTERVAL_REPORT_SLICE_MAX and item['offset']+item['length']<=ref['bytes'] and ref['recordId']not in seen,'interval_collection_slice_invalid');seen.add(ref['recordId']);total+=item['length']
  interval_need(total<=INTERVAL_REPORT_SLICE_MAX,'interval_collection_slice_bound')
 identity,refs,raws=interval_read_catalog()
 if request['action']=='discover':
  result={'schema':1,'kind':'android-current1e15-report-catalog','state':'absent'if identity is None else'observed','operationId':INTERVAL_REPORT_CONTEXT['operationId'],'context':INTERVAL_REPORT_CONTEXT,'directoryIdentity':identity,'references':refs,'aggregateBytes':sum(ref['bytes']for ref in refs),'complete':True,'readOnly':True,'replayAllowed':False};interval_catalog(result,INTERVAL_REPORT_CONTEXT);return result
 indexed={ref['recordId']:ref for ref in refs};parts=[]
 for item in request['slices']:
  ref=item['reference'];interval_need(indexed.get(ref['recordId'])==ref,'interval_collection_requested_pin_changed');data=raws[ref['recordId']][item['offset']:item['offset']+item['length']]
  parts.append({'reference':ref,'offset':item['offset'],'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest(),'dataBase64':base64.b64encode(data).decode()})
 return {'schema':1,'kind':'android-current1e15-report-slices','operationId':INTERVAL_REPORT_CONTEXT['operationId'],'context':INTERVAL_REPORT_CONTEXT,'parts':parts,'aggregateBytes':sum(part['bytes']for part in parts),'complete':True,'readOnly':True,'replayAllowed':False}
try:INTERVAL_REPORT_RESULT=interval_report_main()
except Exception as error:
 reason=error.args[0]if type(error)is ValueError and len(error.args)==1 and type(error.args[0])is str and re.fullmatch('[a-z][a-z0-9_]{0,95}',error.args[0])else'interval_collection_read_failed'
 INTERVAL_REPORT_RESULT={'schema':1,'kind':'android-current1e15-report-read-unknown','operationId':INTERVAL_REPORT_CONTEXT['operationId'],'context':INTERVAL_REPORT_CONTEXT,'state':'unknown','reason':reason,'failureType':type(error).__name__,'complete':False,'readOnly':True,'replayAllowed':False}
print(json.dumps(INTERVAL_REPORT_RESULT,sort_keys=True,separators=(',',':')),flush=True)
'''


def _interval_report_namespace():
    namespace = {'re': re}
    exec(compile(_INTERVAL_REPORT_SHARED, '<closed-interval-report-validator>', 'exec'), namespace)
    return namespace


def interval_report_program(interval_storage, request):
    """Render only original report discovery/slices under the prepared root."""
    namespace = _interval_report_namespace()
    namespace['interval_context'](interval_storage)
    _need(type(request) is dict and len(_canonical(request)) <= 128 * 1024,
          'interval_collection_request_invalid')
    source = 'import os,stat,pathlib,json,hashlib,re,base64,time\n'
    source += 'INTERVAL_REPORT_CONTEXT=' + repr(copy.deepcopy(interval_storage)) + '\n'
    source += 'INTERVAL_REPORT_REQUEST=' + repr(copy.deepcopy(request)) + '\n'
    source += _INTERVAL_REPORT_SHARED + _INTERVAL_REPORT_READER
    compile(source, '<closed-original-interval-report-reader>', 'exec')
    return source


def validate_interval_report_catalog(value, interval_storage):
    return copy.deepcopy(_interval_report_namespace()['interval_catalog'](value, interval_storage))


def validate_interval_report_slices(value, interval_storage, requested):
    namespace = _interval_report_namespace()
    namespace['interval_context'](interval_storage)
    fields = {'schema', 'kind', 'operationId', 'context', 'parts', 'aggregateBytes', 'complete', 'readOnly', 'replayAllowed'}
    _need(type(value) is dict and set(value) == fields and type(value['schema']) is int and value['schema'] == 1 and
          value['kind'] == 'android-current1e15-report-slices' and value['operationId'] == interval_storage['operationId'] and
          value['context'] == interval_storage and value['complete'] is True and value['readOnly'] is True and
          value['replayAllowed'] is False and type(value['parts']) is list and len(value['parts']) == len(requested),
          'interval_collection_slices_invalid')
    parts = []
    for item, expected in zip(value['parts'], requested):
        _need(type(item) is dict and set(item) == {'reference', 'offset', 'bytes', 'sha256', 'dataBase64'} and
              item['reference'] == expected['reference'] and type(item['offset']) is int and item['offset'] == expected['offset'] and
              type(item['bytes']) is int and item['bytes'] == expected['length'] and type(item['dataBase64']) is str,
              'interval_collection_slice_changed')
        namespace['interval_reference'](item['reference'], interval_storage)
        raw = base64.b64decode(item['dataBase64'], validate=True)
        _need(len(raw) == item['bytes'] and hashlib.sha256(raw).hexdigest() == item['sha256'], 'interval_collection_slice_changed')
        parts.append((item['reference'], item['offset'], raw))
    _need(type(value['aggregateBytes']) is int and value['aggregateBytes'] == sum(len(raw) for _, _, raw in parts) and
          0 < value['aggregateBytes'] <= 4 * 1024 ** 2, 'interval_collection_slice_bound')
    return parts
