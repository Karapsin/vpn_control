 try:
  try:directory=os.open('current-intervals',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=chain[-1][1])
  except FileNotFoundError:
   interval_chain_guard(chain)
   try:os.stat('current-intervals',dir_fd=chain[-1][1],follow_symlinks=False)
   except FileNotFoundError:return None,[],{}
   raise ValueError('interval_collection_directory_changed')
  full_identity=interval_pin(os.fstat(directory));identity=full_identity[:5]
