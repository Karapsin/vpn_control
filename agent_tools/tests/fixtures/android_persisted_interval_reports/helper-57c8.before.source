 interval_need(interval_fixed('/proc/sys/kernel/random/boot_id',256).decode().strip()==c['hostBootId'] and hashlib.sha256(interval_fixed('/etc/machine-id',256)).hexdigest()==c['machineSha256'],'interval_collection_host_changed')
def interval_chain_guard(chain):
 for path,fd,identity in chain:
  interval_need(interval_pin(os.fstat(fd))[:5]==identity and interval_pin(os.stat(path,follow_symlinks=False))[:5]==identity,'interval_collection_parent_changed')
 interval_need(chain[-1][2]==INTERVAL_REPORT_CONTEXT['rootGeneration']+[16832,0,0],'interval_collection_root_changed')
 interval_host_guard()
def interval_open_root():
 interval_context(INTERVAL_REPORT_CONTEXT);interval_host_guard();chain=[]
 try:
  fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW);chain.append(('/',fd,interval_pin(os.fstat(fd))[:5]));current=''
  for name in pathlib.PurePosixPath(INTERVAL_REPORT_CONTEXT['root']).parts[1:]:
   current+='/'+name;fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=chain[-1][1]);identity=interval_pin(os.fstat(fd))[:5];chain.append((current,fd,identity))
   interval_need(identity[3:]==[0,0] and stat.S_ISDIR(identity[2]) and (not identity[2]&18 or identity[2]&stat.S_ISVTX),'interval_collection_parent_unsafe')
  interval_chain_guard(chain);return chain
 except BaseException:
  for unused,fd,unused2 in reversed(chain):os.close(fd)
  raise
def interval_read_report(directory,name,identity):
 interval_need(re.fullmatch('interval-[0-9a-f]{32}\.json',name),'interval_collection_foreign_name')
 fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=directory)
 try:
  generation=interval_pin(os.fstat(fd));interval_need(generation[2:6]==[33152,0,0,1] and 0<generation[6]<=INTERVAL_REPORT_FILE_MAX,'interval_collection_file_bound_or_principal')
  data=bytearray()
  while len(data)<=generation[6]:
   interval_deadline()
   part=os.read(fd,min(65536,generation[6]+1-len(data)))
   if not part:break
   data.extend(part)
  raw=bytes(data)
  interval_need(len(raw)==generation[6] and interval_pin(os.fstat(fd))==generation and interval_pin(os.stat(name,dir_fd=directory,follow_symlinks=False))==generation,'interval_collection_report_changed')
  document=json.loads(raw,object_pairs_hook=interval_unique)
  interval_need(type(document)is dict and type(document.get('schema'))is int and document['schema']==1 and document.get('kind')=='android-current1e15-unknown-interval' and document.get('operationId')==INTERVAL_REPORT_CONTEXT['operationId'] and document.get('recordId')==name[9:-5] and type(document.get('guardInvocationId'))is str and re.fullmatch('[0-9a-f]{32}',document['guardInvocationId']) and type(document.get('attempt'))is int and 0<=document['attempt']<=2 and type(document.get('retryable'))is bool and document.get('unknownInterval')is True and document.get('outcomesChanged')is False and document.get('nativeAction')is False and all(document.get(key)==expected for key,expected in INTERVAL_REPORT_HEADERS.items()),'interval_collection_foreign_report')
  ref={'schema':1,'kind':'android-current1e15-unknown-interval-reference','operationId':document['operationId'],'recordId':document['recordId'],'guardInvocationId':document['guardInvocationId'],'attempt':document['attempt'],'root':INTERVAL_REPORT_CONTEXT['root'],'rootGeneration':INTERVAL_REPORT_CONTEXT['rootGeneration'],'directoryIdentity':identity,'path':INTERVAL_REPORT_CONTEXT['root']+'/current-intervals/'+name,'generation':generation,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'retryable':document['retryable'],'unknownInterval':True}
  interval_reference(ref,INTERVAL_REPORT_CONTEXT);return ref,raw
 finally:os.close(fd)
def interval_read_catalog():
