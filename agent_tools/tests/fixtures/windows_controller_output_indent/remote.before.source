"""Finite Windows QMP/libvirt packets; source never contains protected inputs."""
import ast
import inspect
import json
import re
from pathlib import PurePosixPath
from urllib.parse import quote
from uuid import UUID

from . import windows_vm_instance as instance
from . import windows_vm_deploy_remote as deployment
from . import readiness_windows_guest as guest
from .native_vm_spec import FreshWindowsVmSpec
from .windows_vm_unattend import parse_setup

_EXECUTING_CODE=inspect.currentframe().f_code


def _main():
    _CANONICAL_INSTANCE_DEFINITIONS()
    import base64,fcntl
    from xml.etree import ElementTree as ET
    global wire,partial_wire,QGA_PEER_PID,QGA_GUARD
    lock=None;connection=None;domain=None;manager=None;socket_pin=None
    def epoch():
        require(pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()==CONTEXT['hostBootId'],'instance_host_epoch')
        instance_intent();closing()
    def actor():
        if PROVIDER=='raw-qemu-windows':
            row=read('qemu-started.json')
            try:process(row)
            except FileNotFoundError:return None
            except ValueError as error:
                if str(error)=='instance_process_dead':return None
                raise
            process(read('swtpm-started.json'));return row
        candidates=[]
        for path in pathlib.Path('/proc').iterdir():
            if not path.name.isdigit():continue
            try:
                if path.stat().st_uid!=os.geteuid():continue
                raw=(path/'cmdline').read_bytes();words=raw.split(b'\0')
                if b'-uuid' not in words:continue
                index=words.index(b'-uuid')
                if index+1>=len(words) or words[index+1].decode('ascii','ignore')!=SPEC['deploymentId']:continue
                pid=int(path.name);start=birth(pid)
                row={'pid':pid,'startTicks':start,'argv':[os.fsdecode(v) for v in words if v],
                     'commandSha256':hashlib.sha256(raw).hexdigest(),'executableGeneration':list(generation(os.stat(path/'exe')))}
                process(row);candidates.append(row)
            except FileNotFoundError:continue
        require(len(candidates)==1,'instance_libvirt_actor_unknown');row=candidates[0]
        owns(row['pid'],root/'disk.qcow2');owns(row['pid'],root/'uefi-vars.fd');return row
    def vm_guard():
        epoch()
        if PROVIDER=='libvirt-windows':
            require(connection.getURI()==URI and domain.UUIDString()==SPEC['deploymentId'] and domain.name()==DOMAIN,'instance_libvirt_identity')
            xml=domain.XMLDesc(libvirt.VIR_DOMAIN_XML_INACTIVE).encode()
            require(hashlib.sha256(xml).hexdigest()==XML_SHA,'instance_libvirt_xml_changed')
            tree=ET.fromstring(xml);sources=tree.findall("devices/disk[@device='disk']/source")
            require(len(sources)==1 and sources[0].get('file')==str(root/'disk.qcow2') and tree.findtext('os/nvram')==str(root/'uefi-vars.fd'),'instance_libvirt_artifacts')
            process(manager)
            actual=os.lstat(SOCKET_PATH)
            require(stat.S_ISSOCK(actual.st_mode) and actual.st_uid==os.geteuid() and not actual.st_mode&0o077 and structure(actual)==socket_pin,'instance_libvirt_socket_changed')
        if current_actor is not None:
            process(current_actor)
            if PROVIDER=='raw-qemu-windows':
                owns(current_actor['pid'],root/'qmp.sock',True)
                mutable=read('mutable-artifacts.json')
                require(set(mutable)=={'disk.qcow2','uefi-vars.fd'},'instance_mutable_receipt')
                for name,pin in mutable.items():
                    require(pin==list(structure(private(root/name))),'instance_mutable_changed')
                    owns(current_actor['pid'],root/name)
                tpm=read('swtpm-started.json');process(tpm);owns(tpm['pid'],root/'swtpm.sock',True)
    def monitor(command,arguments=None):
        vm_guard()
        if PROVIDER=='raw-qemu-windows':return qmp(command,arguments)
        request={'execute':command}
        if arguments is not None:request['arguments']=arguments
        raw=libvirt_qemu.qemuMonitorCommand(domain,json.dumps(request,separators=(',',':')),0)
        require(type(raw)is str and 0<len(raw.encode())<=65536,'instance_monitor_reply')
        value=json.loads(raw);require(type(value)is dict and 'return'in value and 'error'not in value,'instance_monitor_reply')
        vm_guard();return value['return']
    def machine_state():
        vm_guard()
        if PROVIDER=='raw-qemu-windows':
            if current_actor is None:return 'stopped'
            require(qmp('query-uuid')['UUID'].lower()==SPEC['deploymentId'],'instance_machine')
            return qmp('query-status')['status']
        value=domain.state()[0]
        return {1:'running',2:'booting',3:'paused',4:'shutdown',5:'stopped',6:'unhealthy',7:'suspended'}.get(value,'unknown')
    def rpc(command,arguments):
        vm_guard()
        if PROVIDER=='raw-qemu-windows':
            global QGA_PEER_PID,QGA_GUARD
            QGA_PEER_PID=current_actor['pid'];owns(QGA_PEER_PID,root/'qga.sock',True);named=os.lstat(root/'qga.sock')
            def guarded():
                vm_guard();require(os.lstat(root/'qga.sock').st_ino==named.st_ino,'instance_qga_changed')
            QGA_GUARD=guarded
            value=call(str(root/'qga.sock'),command,arguments,_deadline=time.monotonic()+8)
        else:
            request=json.dumps({'execute':command,'arguments':arguments},separators=(',',':'))
            require(len(request.encode())<=262144,'instance_guest_request_bound')
            raw=libvirt_qemu.qemuAgentCommand(domain,request,8,0)
            require(type(raw)is str and 0<len(raw.encode())<=262144,'instance_guest_reply_bound')
            answer=json.loads(raw);require(type(answer)is dict and 'return'in answer and 'error'not in answer,'instance_guest_reply')
            value=answer['return']
        vm_guard();return value
    def read_guest_terminal(name):
        # QGA's bounded base64 envelope is larger than ordinary metadata.
        # Hold the exact private file generation across the entire read.
        path=root/name;named=private(path)
        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
        try:
            info=os.fstat(fd)
            require(generation(info)==generation(named),'instance_receipt_changed')
            require(0<info.st_size<=262144,'instance_guest_reply_bound')
            raw=os.read(fd,262145)
            require(len(raw)==info.st_size and generation(os.fstat(fd))==generation(info)
                    and generation(os.lstat(path))==generation(info),'instance_receipt_changed')
            return json.loads(raw)
        finally:os.close(fd)
    def script(label,source,original=None):
        operation=OPERATION if original is None else original['operationId']
        source_sha=hashlib.sha256(source.encode()).hexdigest()if original is None else original['sourceSha256']
        require(re.fullmatch(r'[a-z][a-z0-9-]{0,79}',label)is not None,'instance_guest_label')
        prefix='readiness-'+operation+'-'+label
        intent_name=prefix+'.intent.json';ack_name=prefix+'.ack.json';terminal_name=prefix+'.terminal.json'
        # These fixed public programs never receive protected stdin. Login and
        # unknown extension modes cannot archive unvalidated controller output.
        retain_public=MODE in {'observe','idle-inventory','reboot','resume','wake_display',
                              'lease-acquire','lease-status','lease-cancel','lease-enroll','lease-enrollment-status',
                              'job-enroll','job-namespace-status','job-start','job-status','job-inventory'}
        observed_name=prefix+'.observed-terminal.json'
        if not os.path.lexists(root/intent_name):
            if original is not None:return {'state':'unsubmitted','reason':'original_admission_absent','replayAllowed':False}
            # New controllers correlate the retained result to this exact request.
            # A QGA PID alone is reusable after an agent/guest restart.
            lines=source.rstrip().splitlines();output=[i for i,line in enumerate(lines)if line.lstrip().startswith('[Console]::WriteLine(')]
            require(output==[len(lines)-1]and lines[-1].endswith(')'),'instance_guest_output_program')
            lines[-1]='$VcRaw='+lines[-1][len('[Console]::WriteLine('):-1]
            frame={'schemaVersion':1,'operationId':operation,'label':label,'sourceSha256':source_sha}
            framed='\n'.join(lines)+"\n$VcBody=($VcRaw|ConvertFrom-Json)\n$VcOwner=Get-Process -Id $PID\n"
            framed+="$VcFrame=('"+json.dumps(frame,separators=(',',':'))+"'|ConvertFrom-Json)\n"
            framed+="$VcFrame|Add-Member -NotePropertyName owner -NotePropertyValue (@{pid=$PID;birth=$VcOwner.StartTime.ToFileTimeUtc().ToString()})\n$VcFrame|Add-Member -NotePropertyName result -NotePropertyValue $VcBody\n[Console]::WriteLine(($VcFrame|ConvertTo-Json -Depth 24 -Compress))\n"
            save(intent_name,{'operationId':operation,'label':label,'sourceSha256':source_sha,
                              'hostBoot':CONTEXT['hostBootId'],'actor':current_actor,'replayAllowed':False,'controllerIdentity':frame})
            vm_guard()
            ack=rpc('guest-exec',{'path':'powershell.exe','arg':['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-Command',"$s=[Console]::In.ReadToEnd(); & ([ScriptBlock]::Create($s))"],
                                  'input-data':base64.b64encode(framed.encode()).decode(),'capture-output':True})
            require(type(ack)is dict and set(ack)=={'pid'} and type(ack['pid'])is int and ack['pid']>0,'instance_guest_exec_ack')
            save(ack_name,{'operationId':operation,'label':label,'ack':ack,'replayAllowed':False})
        intent=read(intent_name)
        retain_public=retain_public and type(intent.get('controllerIdentity'))is dict
        require(intent['operationId']==operation and intent['label']==label and intent['sourceSha256']==source_sha
                and intent['hostBoot']==CONTEXT['hostBootId'] and intent['actor']==current_actor,'instance_original_guest_request')
        # Lost admission acknowledgement is never permission to guest-exec again.
        require(os.path.lexists(root/ack_name),'instance_original_guest_ack_unknown')
        ack=read(ack_name);require(ack['operationId']==operation and ack['label']==label and ack['replayAllowed']is False,'instance_guest_exec_ack')
        if os.path.lexists(root/terminal_name):terminal=read_guest_terminal(terminal_name)
        elif retain_public and os.path.lexists(root/observed_name):terminal=read_guest_terminal(observed_name)
        else:
            require(type(intent.get('controllerIdentity'))is dict,'instance_legacy_guest_job_unresolved')
            deadline=time.monotonic()+20
            while True:
                terminal=rpc('guest-exec-status',ack['ack'])
                if terminal.get('exited')is True:break
                require(time.monotonic()<deadline,'instance_original_guest_pending');time.sleep(.2)
            # Validate correlation before admitting the terminal receipt.
        require(type(terminal)is dict and len((json.dumps(terminal,sort_keys=True)+'\n').encode())<=262144,'instance_guest_reply_bound')
        if retain_public and not os.path.lexists(root/observed_name):save(observed_name,terminal)
        require(terminal.get('exited')is True and type(terminal.get('exitcode'))is int and terminal['exitcode']==0 and not terminal.get('out-truncated',False)
                and not terminal.get('err-truncated',False)
                and all(type(terminal[key])is bool for key in ('out-truncated','err-truncated')if key in terminal),'instance_guest_program_failed')
        out=base64.b64decode(terminal.get('out-data',''),validate=True);err=base64.b64decode(terminal.get('err-data',''),validate=True)
        require(not err and 0<len(out)<=65536,'instance_guest_output_bound');value=json.loads(out.decode('utf-8-sig'))
        require(type(value)is dict,'instance_guest_output')
        frame=intent.get('controllerIdentity')
        if frame is not None:
            require(type(frame)is dict and type(frame.get('schemaVersion'))is int and set(frame)=={'schemaVersion','operationId','label','sourceSha256'}
                    and frame=={'schemaVersion':1,'operationId':operation,'label':label,'sourceSha256':source_sha},'instance_guest_controller_identity')
            require(set(value)==set(frame)|{'owner','result'}and type(value.get('schemaVersion'))is int and all(value.get(k)==v for k,v in frame.items())
                    and type(value['owner'])is dict and set(value['owner'])=={'pid','birth'}
                    and type(value['owner']['pid'])is int and value['owner']['pid']==ack['ack']['pid']
                    and type(value['owner']['birth'])is str and re.fullmatch(r'[1-9][0-9]{0,19}',value['owner']['birth'])is not None
                    and int(value['owner']['birth'])<2**64 and type(value['result'])is dict,'instance_guest_controller_identity')
            value=value['result']
        if not os.path.lexists(root/terminal_name):save(terminal_name,terminal)
        vm_guard();return value
    def host_work():
        """Finite original guest/lifecycle receipts; absence never means idle."""
        names=[path.name for path in root.iterdir()]
        require(len(names)<=8192,'instance_work_inventory_bound')
        unresolved=[];terminal_count=0
        guest_prefix=r'(?:qualification-[0-9a-f-]{36}|direct-guest-[0-9a-f-]{36}|readiness-[0-9a-f-]{36}-(?:session|interactive|display|wake-admission|lease-acquire|lease-status|lease-cancel|lease-enroll|idle|(?:job-enroll|job-namespace-status|job-start|job-status|job-inventory)-[0-9a-f]{16}|(?:login-session|login-account|login-admission|login-after)-[0-9a-f]{12}))'
        for name in names:
            if not name.endswith('.intent.json'):continue
            prefix=name.removesuffix('.intent.json')
            if re.fullmatch(guest_prefix,prefix):
                intent=read(name);operation=intent.get('operationId')
                try:
                    ack=read(prefix+'.ack.json');terminal=read_guest_terminal(prefix+'.terminal.json')
                    require(ack.get('operationId')==operation and ack.get('replayAllowed')is False
                            and type(ack.get('ack'))is dict and type(ack['ack'].get('pid'))is int
                            and terminal.get('exited')is True and type(terminal.get('exitcode'))is int,'instance_original_work_pending')
                    terminal_count+=1
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_guest_work_unresolved'})
            elif re.fullmatch(r'readiness-recovery-[0-9a-f]{64}',prefix):
                try:
                    intent=read(name);done=read(prefix+'.result.json')
                    require(done.get('state')=='submitted'and done.get('operationId')==intent.get('operationId'),'instance_original_work_pending')
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_lifecycle_unresolved'})
            elif re.fullmatch(r'direct-(?:pause-resume|resume)-[0-9a-f-]{36}',prefix):
                try:
                    intent=read(name);done=read('direct-pause-resume-'+intent['operationId']+'.result.json')
                    require(done.get('operationId')==intent['operationId']and done.get('sameQemuOwner')is True
                            and done.get('agentRecovered')is True and done.get('after',{}).get('status')=='running','instance_original_work_pending')
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_lifecycle_unresolved'})
            elif name in {'libvirt-start.intent.json','libvirt-define.intent.json','migration-graceful-stop.intent.json','migration-tpm-stop.intent.json'}:
                try:
                    mapped={'libvirt-start.intent.json':'libvirt-start.result.json','libvirt-define.intent.json':'libvirt-defined.result.json',
                            'migration-graceful-stop.intent.json':'migration-graceful-stop.result.json','migration-tpm-stop.intent.json':'migration-graceful-stop.result.json'}
                    done=read(mapped[name])
                    if name.startswith('migration-'):require(done.get('qemuPositiveAbsence')is True and done.get('tpmPositiveAbsence')is True,'instance_original_work_pending')
                    elif name=='libvirt-start.intent.json':require(done.get('state')=='running'and done.get('samePersistedArtifacts')is True,'instance_original_work_pending')
                    else:require(done.get('state')=='defined','instance_original_work_pending')
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_lifecycle_unresolved'})
            else:unresolved.append({'receipt':name,'reason':'unclassified_original_intent'})
        if os.path.lexists(root/'secure-intent.json'):
            try:
                original=read('secure-intent.json');ack=read('secure-ack.json');terminal=read('secure-terminal.json')
                require(original.get('operationId')==ack.get('operationId')and terminal.get('exited')is True
                        and type(terminal.get('exitcode'))is int,'instance_original_work_pending')
                terminal_count+=1
            except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':'secure-intent.json','reason':'original_credential_phase_unresolved'})
        return {'visibilityComplete':True,'terminalCount':terminal_count,'unresolved':unresolved}
    try:
        epoch();chain()
        lock=os.open(root/'intent.json',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);limit=time.monotonic()+5
        while True:
            try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);break
            except BlockingIOError:require(time.monotonic()<limit,'instance_operator_busy');time.sleep(.05)
        if PROVIDER=='libvirt-windows':
            import libvirt,libvirt_qemu
            libvirt.registerErrorHandler(lambda *_:None,None)
            connection=libvirt.open(URI);require(connection is not None,'instance_libvirt_connection')
            peer_rows=set()
            for name in os.listdir('/proc/self/fd'):
                try:
                    if not os.readlink('/proc/self/fd/'+name).startswith('socket:'):continue
                    with socket.fromfd(int(name),socket.AF_UNIX,socket.SOCK_STREAM) as channel:
                        if channel.getpeername()!=SOCKET_PATH:continue
                        peer_rows.add(struct.unpack('3i',channel.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12)))
                except OSError:continue
            require(len(peer_rows)==1,'instance_libvirt_peer')
            peer=next(iter(peer_rows));require(peer[1]==os.geteuid(),'instance_libvirt_peer')
            path=pathlib.Path('/proc',str(peer[0]));binary=os.stat(path/'exe')
            require(os.path.realpath(path/'exe')=='/usr/bin/virtqemud' and binary.st_uid==0 and not binary.st_mode&0o022,'instance_libvirt_manager_binary')
            raw=(path/'cmdline').read_bytes();manager={'pid':peer[0],'startTicks':birth(peer[0]),'argv':[os.fsdecode(v) for v in raw.split(b'\0')if v],
                'commandSha256':hashlib.sha256(raw).hexdigest(),'executableGeneration':list(generation(binary))}
            process(manager);actual=os.lstat(SOCKET_PATH)
            require(os.path.realpath(SOCKET_PATH)==SOCKET_PATH and stat.S_ISSOCK(actual.st_mode) and actual.st_uid==os.geteuid() and not actual.st_mode&0o077,'instance_libvirt_socket_owner')
            socket_pin=structure(actual)
            domain=connection.lookupByUUIDString(SPEC['deploymentId']);current_actor=actor() if domain.isActive() else None
        else:current_actor=actor()
        if PROVIDER=='raw-qemu-windows':
            suffix='readiness-'+OPERATION+'-'+MODE+'-'+os.urandom(8).hex()
            wire=os.open(root/(suffix+'.wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
            partial_wire=os.open(root/(suffix+'.partial-wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
        state=machine_state()
        result={'state':'observed','operationId':OPERATION,'provider':PROVIDER,'machine':SPEC['deploymentId'],
                'hostBoot':CONTEXT['hostBootId'],'guest':state,'actor':current_actor,
                'controlConnection':('libvirt:'+str(manager['pid'])+':'+str(manager['startTicks'])+':'+str(socket_pin[1]) if manager else 'qmp:'+str(os.lstat(root/'qmp.sock').st_ino)),'sessionFacts':None,'displayFacts':None,'guestAgent':False,'idleFacts':None,'hostWork':None}
        if MODE=='resume':
            require(state in {'paused','suspended'},'instance_recovery_state_changed')
            require(EXPECTED.get('actor')==current_actor and EXPECTED.get('hostBoot')==CONTEXT['hostBootId'],'instance_recovery_identity_changed')
            vm_guard();save('readiness-recovery-'+RECOVERY_ID+'.intent.json',{'action':'resume','recoveryId':RECOVERY_ID,'operationId':OPERATION,'before':result,'replayAllowed':False})
            if PROVIDER=='raw-qemu-windows':qmp('system_wakeup'if state=='suspended'else'cont')
            elif state=='suspended':domain.pMWakeup(0)
            else:domain.resume()
            vm_guard();result['guest']=machine_state();result['state']='submitted'
            save('readiness-recovery-'+RECOVERY_ID+'.result.json',result)
        elif MODE=='wake_display':
            require(state=='running' and EXPECTED.get('actor')==current_actor and EXPECTED.get('controlConnection')==result['controlConnection'],'instance_recovery_identity_changed')
            before=EXPECTED.get('sessionFacts');require(type(before)is dict,'instance_recovery_session_missing')
            fresh=script('wake-admission',SESSION_SCRIPT)
            require(fresh['machine'].lower()==SPEC['deploymentId'] and fresh['boot']==before['boot'] and fresh['console']==before['console']
                    and fresh['expectedSid']==before['expectedSid'] and fresh['tokenSid']==before['expectedSid'] and fresh['ordinary']is True
                    and fresh['session']['State']==0 and fresh['session']['Flags']in {0,1} and fresh['session']['Logon']==before['session']['Logon'],'instance_recovery_session_changed')
            mice=monitor('query-mice');require(type(mice)is list and len(mice)<=16,'instance_mouse_unrecognized')
            selected=[mouse for mouse in mice if type(mouse)is dict and mouse.get('current')is True]
            require(len(selected)==1 and type(selected[0].get('absolute'))is bool,'instance_mouse_unrecognized')
            absolute=selected[0]['absolute'];events=([{'type':'abs','data':{'axis':'x','value':16384}},{'type':'abs','data':{'axis':'y','value':16384}}]if absolute else[{'type':'rel','data':{'axis':'x','value':1}}])
            vm_guard();save('readiness-recovery-'+RECOVERY_ID+'.intent.json',{'action':'wake_display','recoveryId':RECOVERY_ID,'operationId':OPERATION,'boot':fresh['boot'],'account':fresh['expectedSid'],'session':str(fresh['console'])+':'+str(fresh['session']['Logon']),'before':result,'replayAllowed':False})
            monitor('input-send-event',{'events':events})
            result.update(state='submitted',wakeInputSubmitted=True,sessionFacts=fresh)
            save('readiness-recovery-'+RECOVERY_ID+'.result.json',result)
        elif MODE in {'observe','idle-inventory','reboot'}:
            if state=='running':
                try:rpc('guest-ping',{});result['guestAgent']=True
                except Exception:result['guest']='booting'
                if result['guestAgent']:
                    if INTERACTIVE_SCRIPT:
                        probe=script('interactive',INTERACTIVE_SCRIPT)
                        require(set(probe)==({'sessionFacts','displayFacts','idleFacts'}if IDLE_SCRIPT else{'sessionFacts','displayFacts'}),'instance_interactive_reply')
                        result.update(probe)
                    elif IDLE_SCRIPT:
                        result['idleFacts']=script('idle',IDLE_SCRIPT)
                        result['sessionFacts']=result['idleFacts']['sessionFacts']
                    else:result['sessionFacts']=script('session',SESSION_SCRIPT)
                    if IDLE_SCRIPT:result['hostWork']=host_work()
            if MODE=='reboot':
                require(result['guestAgent']and EXPECTED.get('actor')==current_actor and EXPECTED.get('hostBoot')==CONTEXT['hostBootId'],'instance_reboot_identity_changed')
                before=EXPECTED.get('sessionFacts');fresh=result['sessionFacts'];idle=result['idleFacts'];work=result['hostWork']
                require(type(before)is dict and fresh['machine'].lower()==SPEC['deploymentId']and fresh['boot']==before['boot']
                        and fresh['expectedSid']==before['expectedSid']and fresh['ordinary']is True
                        and fresh['console']==before['console']and all(fresh['session'][k]==before['session'][k]for k in ('SessionId','State','Flags','Logon','LastInput')),
                        'instance_reboot_session_changed')
                require(idle.get('visibilityComplete')is True and idle.get('blockers')==[]and all(idle.get('lifecycle',{}).values())
                        and idle.get('leaseFacts',{}).get('visibilityComplete')is True and idle['leaseFacts']['blockers']==[]
                        and idle.get('jobFacts',{}).get('visibilityComplete')is True and idle['jobFacts']['blockers']==[]
                        and all(row.get('self')is True or row.get('knownSystem')is True for row in idle['processes'])
                        and work['visibilityComplete']is True and work['unresolved']==[],'instance_positive_idle_required')
                require(type(RESERVATION)is dict and RESERVATION.get('visibilityComplete')is True and RESERVATION.get('blockers')==[]
                        and RESERVATION.get('machine')==SPEC['deploymentId']and RESERVATION.get('hostBoot')==CONTEXT['hostBootId']
                        and RESERVATION.get('actor')=={key:current_actor[key]for key in ('pid','startTicks')},'instance_reservation_visibility_missing')
                vm_guard();save('readiness-recovery-'+RECOVERY_ID+'.intent.json',{'action':'reboot','recoveryId':RECOVERY_ID,'operationId':OPERATION,'before':result,'reservation':RESERVATION,'replayAllowed':False})
                acknowledged=False
                try:rpc('guest-shutdown',{'mode':'reboot'});acknowledged=True
                except Exception:pass
                save('readiness-recovery-'+RECOVERY_ID+'.ack.json',{'operationId':OPERATION,'responseObserved':acknowledged,'replayAllowed':False})
                result.update(state='submitted',guest='booting',shutdownAcknowledged=acknowledged)
                save('readiness-recovery-'+RECOVERY_ID+'.result.json',result)
        elif MODE in {'lease-acquire','lease-status','lease-cancel','lease-enroll','lease-enrollment-status'}:
            require(state=='running','instance_guest_not_ready');rpc('guest-ping',{})
            require(EXPECTED.get('actor')==current_actor and EXPECTED.get('hostBoot')==CONTEXT['hostBootId']
                    and EXPECTED.get('controlConnection')==result['controlConnection'],'instance_original_lease_host_changed')
            result['lease']=script('lease-enroll',None,ORIGINAL_SCRIPT)if MODE=='lease-enrollment-status'else script(MODE,LEASE_SCRIPT)
        else:raise ValueError('instance_packet_action')
        vm_guard();print(json.dumps(result))
    except BaseException as error:
        reason=str(error) if type(error)is ValueError and re.fullmatch('instance_[a-z_]{1,64}',str(error)) else 'instance_observation_unknown'
        print(json.dumps({'state':'blocked','operationId':OPERATION,'reason':reason,'errorClass':type(error).__name__,'replayAllowed':False}))
    finally:
        if connection is not None:connection.close()
        if lock is not None:os.close(lock)
        for descriptor in (globals().get('wire',-1),globals().get('partial_wire',-1)):
            if descriptor!=-1:os.close(descriptor)
        for descriptor in reversed(held):os.close(descriptor)


def _interactive_source(user,machine,idle_source=None):
    """Discover WTS and display in one read-only, internally boot-bound probe."""
    from . import readiness_windows_display as display_module
    session=guest.powershell_source(user)if idle_source is None else idle_source
    marker='[Console]::WriteLine(($result|ConvertTo-Json -Depth 6 -Compress))'
    if idle_source is None:
        if session.count(marker)!=1:raise ValueError('windows_interactive_source')
        session=session.replace(marker,'$sessionFacts=$result')
    else:
        marker='[Console]::WriteLine(($result|ConvertTo-Json -Depth 10 -Compress))'
        if session.count(marker)!=1:raise ValueError('windows_interactive_source')
        session=session.replace(marker,'$idleFacts=$result;$sessionFacts=$result.sessionFacts')
    placeholder='2000-01-01T00:00:00.0000000Z'
    display=display_module.powershell_source(machine,placeholder)
    literal=repr(placeholder)
    if display.count(literal)!=2:raise ValueError('windows_interactive_source')
    display=display.replace(literal,'$sessionFacts.boot')
    last=display.splitlines()[-1]
    if not last.startswith('[Console]::WriteLine((@{schemaVersion=1;')or not last.endswith('|ConvertTo-Json -Compress))'):
        raise ValueError('windows_interactive_source')
    projection=last[len('[Console]::WriteLine(('):-len('|ConvertTo-Json -Compress))')]
    display=display.removesuffix(last+'\n')+'$displayFacts='+projection+'\n'
    display+='[Console]::WriteLine((@{sessionFacts=$sessionFacts;displayFacts=$displayFacts'+(''if idle_source is None else';idleFacts=$idleFacts')+'}|ConvertTo-Json -Depth 10 -Compress))\n'
    return session+display


def program(binding,mode,operation,*,expected=None,recovery_id=None,interactive=False,lease_binding=None,lease_operation=None,ttl_seconds=None,original_script=None,idle=False,expected_sid=None,lease_root_generation=None,job_root_generation=None,job_admission_generation=None,reservation=None):
    """Build only reviewed actions; no caller command/source or credential input."""
    if type(binding)is not dict or set(binding)!={'provider','spec','setup','context','uri','domain','xmlSha256'}:
        raise ValueError('windows_packet_binding')
    provider=binding['provider'];spec=FreshWindowsVmSpec.parse(binding['spec']);setup=parse_setup(binding['setup']);context=binding['context']
    if provider not in {'raw-qemu-windows','libvirt-windows'} or mode not in {'observe','idle-inventory','reboot','resume','wake_display','lease-acquire','lease-status','lease-cancel','lease-enroll','lease-enrollment-status'}:
        raise ValueError('windows_packet_action')
    if type(operation)is not str or str(UUID(operation))!=operation or type(interactive)is not bool:
        raise ValueError('windows_packet_identity')
    if type(context)is not dict or set(context)!={'hostBootId','pending'} or str(UUID(context['hostBootId']))!=context['hostBootId']:
        raise ValueError('windows_packet_context')
    if provider=='libvirt-windows':
        expected_uri='qemu+unix:///session?socket='+quote(str(PurePosixPath(spec.root).parent/'.cache/libvirt/virtqemud-sock'),safe='/')
        if binding['uri']!=expected_uri or binding['domain']!='vc-recovery-libvirt-'+spec.deployment_id[:8] or type(binding['xmlSha256'])is not str or re.fullmatch('[0-9a-f]{64}',binding['xmlSha256'])is None:
            raise ValueError('windows_packet_domain')
    elif any(binding[k]is not None for k in ('uri','domain','xmlSha256')):
        raise ValueError('windows_packet_domain')
    if mode in {'resume','wake_display','reboot'} and (type(expected)is not dict or type(recovery_id)is not str or re.fullmatch('[0-9a-f]{64}',recovery_id)is None):
        raise ValueError('windows_packet_recovery')
    interactive_source='';lease='';idle_script=''
    if type(idle)is not bool:raise ValueError('windows_idle_mode')
    if idle or mode in {'idle-inventory','reboot'}:
        from . import readiness_windows_idle as idle_module
        idle_script=idle_module.powershell_source(spec.deployment_id,None,setup['user'],expected_sid,lease_root_generation,
                                               job_root_generation,job_admission_generation)
    if interactive:
        if mode!='observe':raise ValueError('windows_display_binding')
        interactive_source=_interactive_source(setup['user'],spec.deployment_id,idle_script or None)
    if mode.startswith('lease-'):
        if type(expected)is not dict or set(expected)!={'actor','hostBoot','controlConnection'}:
            raise ValueError('windows_lease_host_binding')
    if mode=='lease-enrollment-status':
        if (type(original_script)is not dict or set(original_script)!={'operationId','sourceSha256'}
                or type(original_script['operationId'])is not str or str(UUID(original_script['operationId']))!=original_script['operationId']
                or type(original_script['sourceSha256'])is not str or re.fullmatch('[0-9a-f]{64}',original_script['sourceSha256'])is None):
            raise ValueError('windows_lease_original_script')
    elif mode.startswith('lease-'):
        from . import readiness_windows_leases as leases
        if type(lease_binding)is not leases.WindowsLeaseBinding or lease_binding.machine!=spec.deployment_id:
            raise ValueError('windows_lease_binding')
        if lease_operation is None:lease_operation=operation
        if type(lease_operation)is not str or str(UUID(lease_operation))!=lease_operation:
            raise ValueError('windows_lease_operation')
        lease=(leases.enrollment_source(lease_binding.machine,lease_binding.boot) if mode=='lease-enroll' else
               leases.program(mode.removeprefix('lease-'),lease_binding,lease_operation,
                              **({'ttl_seconds':ttl_seconds}if mode=='lease-acquire' else {})))
        lease=lease.decode()
    source=inspect.getsource(instance._vm_main);node=next(n for n in ast.parse(source).body if isinstance(n,ast.FunctionDef))
    nodes=[n for n in node.body if isinstance(n,(ast.Import,ast.ImportFrom,ast.Assign,ast.FunctionDef)) and not(isinstance(n,ast.FunctionDef) and n.name=='launch')]
    canonical='\n'.join(ast.get_source_segment(source,n)for n in nodes)
    text=inspect.getsource(_main);marker='    _CANONICAL_INSTANCE_DEFINITIONS()\n'
    if text.count(marker)!=1:raise ValueError('windows_packet_source')
    text=text.replace(marker,''.join('    '+line+'\n'for line in canonical.splitlines()))
    bindings={'SPEC':spec.as_dict(),'SETUP':setup,'CONTEXT':context,'PROVIDER':provider,'URI':binding['uri'],'DOMAIN':binding['domain'],'XML_SHA':binding['xmlSha256'],'SOCKET_PATH':str(PurePosixPath(spec.root).parent/'.cache/libvirt/virtqemud-sock')if provider=='libvirt-windows'else None,
              'OPERATION':operation,'MODE':mode,'EXPECTED':expected,'RECOVERY_ID':recovery_id,'SESSION_SCRIPT':guest.powershell_source(setup['user']),
              'INTERACTIVE_SCRIPT':interactive_source,'LEASE_SCRIPT':lease,'ORIGINAL_SCRIPT':original_script,'IDLE_SCRIPT':idle_script,'RESERVATION':reservation}
    packet='\n'.join(key+'='+repr(value)for key,value in bindings.items())+'\n'+deployment.guest_rpc_definitions()+'\nwire=partial_wire=-1\n'+text+'\n_main()\n'
    compile(packet,'finite Windows readiness packet','exec');return packet.encode()
