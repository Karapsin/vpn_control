"""SOURCE-ONLY fixed native-test owner. No SSH/provider/credential entry point.

Initialization is a separate explicit operation; controller packets NEVER initialize.
The caller must review a new exact packet before any future remote use. An old
foreground operation cannot be adopted by this adapter.
"""
from pathlib import Path
import ast, base64, fcntl, hashlib, inspect, json, os, re, stat, subprocess, sys, types, uuid

_EXECUTING_CODE = inspect.currentframe().f_code
PURPOSE = 'native-test-source-cohort'
LIMIT = 4 * 1024 * 1024
CHUNK = 65536
_ORIGINALS = {}


def need(value, reason='native_test_custody_refused'):
    if not value:
        raise ValueError(reason)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def gen(info):
    return [info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
            info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns]


def pairs(rows):
    result = {}
    for key, value in rows:
        need(key not in result)
        result[key] = value
    return result


def encoded(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode()


def absolute(path):
    path = Path(path)
    need(path.is_absolute() and '..' not in path.parts and str(path) == str(path.absolute()))
    return path


def directory(path, expected=None):
    path = absolute(path)
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for name in path.parts[1:]:
            other = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = other
        info = os.fstat(fd)
        need(info.st_uid == os.geteuid() and stat.S_IMODE(info.st_mode) == 0o700)
        need(expected is None or gen(info)[:5] == expected)
        return fd
    except BaseException:
        os.close(fd)
        raise


def read(path, expected=None, bound=LIMIT * 3, private=True):
    path = absolute(path)
    # Anchor every ancestor without requiring public source ancestors to be 0700.
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for name in path.parts[1:-1]:
            other = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = other
        item = os.open(path.name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=fd)
        try:
            before = gen(os.fstat(item))
            need(stat.S_ISREG(before[2]) and before[3] == os.geteuid() and before[5] == 1)
            need(stat.S_IMODE(before[2]) == 0o600 if private else not (before[2] & 0o022))
            need(0 <= before[6] <= bound)
            if expected is not None:
                need(set(expected) == {'generation', 'sha256'} and before == expected['generation'])
            chunks = []
            count = 0
            while True:
                chunk = os.read(item, min(65536, bound + 1 - count))
                if not chunk:
                    break
                chunks.append(chunk)
                count += len(chunk)
                need(count <= bound)
            raw = b''.join(chunks)
            need(gen(os.fstat(item)) == before == gen(os.stat(path.name, dir_fd=fd, follow_symlinks=False)))
            need(expected is None or sha(raw) == expected['sha256'])
            return raw, {'generation': before, 'sha256': sha(raw)}
        finally:
            os.close(item)
    finally:
        os.close(fd)


def atomic(fd, name, raw):
    """Complete create-only publication; no reader can adopt a partial final file."""
    need('/' not in name and name not in {'.', '..'})
    temporary = '.' + name + '.' + str(uuid.uuid4()) + '.tmp'
    out = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd)
    try:
        view = memoryview(raw)
        while view:
            count = os.write(out, view)
            need(count > 0)
            view = view[count:]
        os.fsync(out)
    finally:
        os.close(out)
    try:
        os.link(temporary, name, src_dir_fd=fd, dst_dir_fd=fd, follow_symlinks=False)
    finally:
        os.unlink(temporary, dir_fd=fd)
    os.fsync(fd)


def self_guard():
    raw, pin = read(Path(__file__).absolute(), private=False)
    code = compile(raw, str(Path(__file__).absolute()), 'exec', dont_inherit=True)
    need(code == _EXECUTING_CODE)
    functions = {item.co_name: item for item in code.co_consts if isinstance(item, types.CodeType)}
    for node in ast.parse(raw).body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            current = globals().get(node.name)
            need(type(current) is types.FunctionType and current.__code__ == functions[node.name])
        elif isinstance(node, ast.ClassDef):
            current = globals().get(node.name)
            need(type(current) is type)
            methods = {item.co_name: item for item in functions[node.name].co_consts if isinstance(item, types.CodeType)}
            for child in node.body:
                if isinstance(child, ast.FunctionDef):
                    method = current.__dict__.get(child.name)
                    need(type(method) is types.FunctionType and method.__code__ == methods[child.name])
    return raw, pin


def machine():
    if sys.platform.startswith('linux'):
        value = Path('/etc/machine-id').read_text().strip()
        need(re.fullmatch('[0-9a-f]{32}', value) is not None)
        return value
    need(sys.platform == 'darwin')
    value = subprocess.run(['/usr/sbin/ioreg', '-rd1', '-c', 'IOPlatformExpertDevice'],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5, check=True).stdout
    rows = re.findall(rb'"IOPlatformUUID" = "([0-9A-Fa-f-]{36})"', value)
    need(len(rows) == 1)
    return str(uuid.UUID(rows[0].decode()))


def load_owner(path, expected):
    raw, pin = read(path, expected)
    module = types.ModuleType('native_test_retained_durable_owner')
    module.__file__ = str(path)
    sys.modules[module.__name__] = module
    exec(compile(raw, str(path), 'exec', dont_inherit=True), module.__dict__)
    need(module.owner_source() == raw)
    return module


def initialize(root, target, owner_path, owner_sha):
    """Separate LOCAL-controlled initialization now; no remote initializer driver."""
    adapter, adapter_pin = self_guard()
    owner, owner_pin = read(owner_path, private=False)
    need(sha(owner) == owner_sha and re.fullmatch('[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}', target))
    root = absolute(root)
    parent = directory(root.parent)
    try:
        os.mkdir(root.name, 0o700, dir_fd=parent)  # Existing namespaces are never adopted.
        os.fsync(parent)
    finally:
        os.close(parent)
    fd = directory(root)
    try:
        for name in ('jobs', 'admissions'):
            os.mkdir(name, 0o700, dir_fd=fd)
        atomic(fd, 'adapter.py', adapter)
        atomic(fd, 'protocol.py', owner)
        atomic(fd, 'operator.lock', b'native-test-once-v1\n')
        retained = load_owner(root / 'protocol.py', read(root / 'protocol.py')[1])
        binding = retained.current_binding(target, machine())
        marker = {'kind': PURPOSE, 'schemaVersion': 1, 'binding': retained.asdict(binding),
                  'adapterSha256': sha(adapter), 'ownerSha256': owner_sha}
        atomic(fd, 'marker.json', encoded(marker))
        result = {'root': str(root), 'rootIdentity': gen(os.fstat(fd))[:5], 'binding': marker['binding'],
                  'files': {name: read(root / name)[1] for name in ('adapter.py', 'protocol.py', 'operator.lock', 'marker.json')},
                  'directories': {name: gen(os.stat(name, dir_fd=fd, follow_symlinks=False))[:5] for name in ('jobs', 'admissions')}}
        os.fsync(fd)
        return result
    finally:
        os.close(fd)


def namespace(value):
    self_guard()
    need(type(value) is dict and set(value) == {'root', 'rootIdentity', 'binding', 'files', 'directories'})
    root = absolute(value['root'])
    fd = directory(root, value['rootIdentity'])
    try:
        for name in ('adapter.py', 'protocol.py', 'operator.lock', 'marker.json'):
            read(root / name, value['files'][name])
        need(value['files']['adapter.py']['sha256'] == sha(read(Path(__file__).absolute(), private=False)[0]))
        marker = json.loads(read(root / 'marker.json', value['files']['marker.json'])[0], object_pairs_hook=pairs)
        need(marker == {'kind': PURPOSE, 'schemaVersion': 1, 'binding': value['binding'],
                        'adapterSha256': value['files']['adapter.py']['sha256'],
                        'ownerSha256': value['files']['protocol.py']['sha256']})
        for name in ('jobs', 'admissions'):
            child = directory(root / name, value['directories'][name])
            os.close(child)
        owner = load_owner(root / 'protocol.py', value['files']['protocol.py'])
        binding = owner.MachineBinding.from_dict(value['binding'])
        need(binding.machine == machine())
        owner._binding_live(binding)
        return root, fd, owner, binding
    except BaseException:
        os.close(fd)
        raise


class Original:
    __slots__ = ('directory', 'custody')

    def __init__(self, directory, custody):
        self.directory, self.custody = directory, custody


def retain(destination, ns, operation, caller_path, caller_sha, source_rows):
    self_guard()
    need(str(uuid.UUID(operation)) == operation)
    caller, caller_pin = read(caller_path, private=False)
    need(sha(caller) == caller_sha and len(caller) <= LIMIT)
    compile(caller, 'exact-native-test-caller', 'exec')
    # Exact public source manifest, including original caller and owner/adapter.
    rows = []
    for path, expected in source_rows:
        raw, actual = read(path, expected, private=False)
        rows.append({'path': str(path), **actual, 'bytes': len(raw)})
    root, nfd, owner, binding = namespace(ns)
    os.close(nfd)
    destination = absolute(destination)
    os.mkdir(destination, 0o700)
    fd = directory(destination)
    try:
        values = {'namespace.json': encoded(ns), 'caller.py': caller,
                  'sources.json': encoded(rows), 'operation.json': encoded({'operationId': operation,
                    'purpose': PURPOSE, 'callerSha256': caller_sha, 'callerBytes': len(caller),
                    'ownerSha256': ns['files']['protocol.py']['sha256'], 'binding': ns['binding']})}
        pins = {}
        for name, raw in values.items():
            atomic(fd, name, raw)
            pins[name] = read(destination / name)[1]
        value = {'schemaVersion': 1, 'directoryIdentity': gen(os.fstat(fd))[:5], 'files': pins}
        atomic(fd, 'custody.json', encoded(value))
        return reopen(destination, read(destination / 'custody.json')[1])
    finally:
        os.close(fd)


def reopen(path, custody_pin):
    self_guard()
    path = absolute(path)
    raw, actual = read(path / 'custody.json', custody_pin)
    value = json.loads(raw, object_pairs_hook=pairs)
    need(set(value) == {'schemaVersion', 'directoryIdentity', 'files'} and value['schemaVersion'] == 1)
    fd = directory(path, value['directoryIdentity'])
    os.close(fd)
    need(set(value['files']) == {'namespace.json', 'caller.py', 'sources.json', 'operation.json'})
    for name, pin in value['files'].items():
        read(path / name, pin)
    result = Original(path, actual)
    _ORIGINALS[id(result)] = (result, str(path), encoded(actual))
    original_data(result)
    return result


def original_data(original):
    self_guard()
    need(type(original) is Original and _ORIGINALS.get(id(original)) ==
         (original, str(original.directory), encoded(original.custody)))
    raw, _ = read(original.directory / 'custody.json', original.custody)
    custody = json.loads(raw, object_pairs_hook=pairs)
    fd = directory(original.directory, custody['directoryIdentity'])
    os.close(fd)
    values = {name: read(original.directory / name, pin)[0] for name, pin in custody['files'].items()}
    ns = json.loads(values['namespace.json'], object_pairs_hook=pairs)
    operation = json.loads(values['operation.json'], object_pairs_hook=pairs)
    need(operation == {'operationId': str(uuid.UUID(operation['operationId'])), 'purpose': PURPOSE,
                       'callerSha256': sha(values['caller.py']), 'callerBytes': len(values['caller.py']),
                       'ownerSha256': ns['files']['protocol.py']['sha256'], 'binding': ns['binding']})
    for row in json.loads(values['sources.json'], object_pairs_hook=pairs):
        raw, _ = read(row['path'], {key: row[key] for key in ('generation', 'sha256')}, private=False)
        need(len(raw) == row['bytes'])
    return ns, operation, values['caller.py']


def job_custody(root, ns, operation, caller, *, publish=False):
    """Pin original generic admission artifacts; an interrupted publication blocks.

    The trusted generic owner writes these complete artifacts before launch. If a
    controller dies before this adapter's custody receipt, observation is UNKNOWN
    rather than reconstructing/adopting a replacement generation.
    """
    op = operation['operationId']
    job = root / 'jobs' / op
    receipt = root / 'admissions' / (op + '.custody.json')
    if publish:
        files = {name: read(job / name)[1] for name in ('intent.json', 'program.py', 'owner.py')}
        need(files['program.py']['sha256'] == sha(caller))
        need(files['owner.py']['sha256'] == ns['files']['protocol.py']['sha256'])
        value = {'jobIdentity': gen(job.lstat())[:5], 'files': files,
                 'admissionPin': read(root / 'admissions' / (op + '.json'))[1]}
        ad = directory(root / 'admissions', ns['directories']['admissions'])
        try:
            atomic(ad, receipt.name, encoded(value))
        finally:
            os.close(ad)
    else:
        value = json.loads(read(receipt)[0], object_pairs_hook=pairs)
    fd = directory(job, value['jobIdentity'])
    os.close(fd)
    read(root / 'admissions' / (op + '.json'), value['admissionPin'])
    need(set(value) == {'jobIdentity', 'files', 'admissionPin'} and set(value['files']) == {'intent.json', 'program.py', 'owner.py'})
    for name, pin in value['files'].items():
        read(job / name, pin)
    need(value['files']['program.py']['sha256'] == sha(caller))
    need(value['files']['owner.py']['sha256'] == ns['files']['protocol.py']['sha256'])
    intent = json.loads(read(job / 'intent.json', value['files']['intent.json'])[0], object_pairs_hook=pairs)
    need(intent['programSha256'] == operation['callerSha256'] and intent['purpose'] == PURPOSE
         and intent['binding'] == ns['binding'] and intent['operationId'] == op and intent['streamLimit'] == LIMIT)
    return value


def run(ns, operation, caller, mode, stream=None, offset=0):
    """Fixed remote controller. Never initializes, scans, deletes, or signals."""
    need(mode in {'submit', 'observe', 'collect'})
    need(type(operation) is dict and operation['purpose'] == PURPOSE and
         operation['callerSha256'] == sha(caller) and operation['callerBytes'] == len(caller) and
         operation['binding'] == ns['binding'] and operation['ownerSha256'] == ns['files']['protocol.py']['sha256'])
    op = str(uuid.UUID(operation['operationId']))
    need(op == operation['operationId'])
    root, fd, owner, binding = namespace(ns)
    try:
        jobs_root = root / 'jobs'
        jobs_gen = tuple(ns['directories']['jobs'][:2])
        index = root / 'admissions' / (op + '.json')
        expected = {'schemaVersion': 1, 'operation': operation, 'namespace': ns,
                    'streamLimit': LIMIT, 'ownerSha256': ns['files']['protocol.py']['sha256']}
        if mode == 'submit':
            lock = os.open('operator.lock', os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                need(gen(os.fstat(lock)) == ns['files']['operator.lock']['generation'])
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                namespace_fd = namespace(ns)[1]
                os.close(namespace_fd)
                # Publish an independent complete index BEFORE generic admission.
                if index.exists() or index.is_symlink():
                    need(json.loads(read(index)[0], object_pairs_hook=pairs) == expected)
                    mode = 'observe'
                else:
                    ad = directory(root / 'admissions', ns['directories']['admissions'])
                    try:
                        atomic(ad, index.name, encoded(expected))
                    finally:
                        os.close(ad)
                    program = owner.Program(PURPOSE, caller, LIMIT)
                    result = owner.submit(jobs_root, op, binding, program, generation=jobs_gen)
                    try:
                        job_custody(root, ns, operation, caller, publish=True)
                    except (OSError, ValueError):
                        return {'state': 'unknown', 'reason': 'original_job_custody_unavailable', 'replayAllowed': False}
                    result['adapterSubmitted'] = True
                    return result
            finally:
                os.close(lock)
        if not index.exists() and not index.is_symlink():
            return {'state': 'unknown', 'reason': 'original_admission_unavailable', 'replayAllowed': False}
        need(json.loads(read(index)[0], object_pairs_hook=pairs) == expected)
        # Consumed index with no generic job stays UNKNOWN. NEVER call submit here.
        result = owner.observe(jobs_root, op, binding, generation=jobs_gen)
        if result['state'] == 'unsubmitted':
            result = {'state': 'unknown', 'reason': 'consumed_original_job_missing', 'replayAllowed': False}
        if result.get('reason') != 'consumed_original_job_missing':
            try:
                job_custody(root, ns, operation, caller)
            except (OSError, ValueError):
                return {'state': 'unknown', 'reason': 'original_job_custody_changed', 'replayAllowed': False}
        if mode == 'collect' and result['state'] == 'terminal':
            need(stream in {'stdout', 'stderr'} and type(offset) is int and offset >= 0)
            result, stdout, stderr = owner.collect(jobs_root, op, binding, generation=jobs_gen)
            body = stdout if stream == 'stdout' else stderr
            need(offset <= len(body))
            raw, pin = read(jobs_root / op / (stream + '.bin'))
            need(raw == body)
            chunk = body[offset:offset + CHUNK]
            result.update(stream=stream, offset=offset, nextOffset=offset + len(chunk),
                          complete=offset + len(chunk) == len(body), streamPin=pin,
                          chunkBase64=base64.b64encode(chunk).decode())
        return result
    finally:
        os.close(fd)


class SourceHold:
    """Keep original public descriptors open through a future admitted carrier.

    This object performs no carrier action. The future dispatcher MUST use this
    scope and retain a returned raw callback before invoking finish().
    """
    __slots__ = ('original', 'files', 'descriptors', 'closed')

    def __init__(self, original):
        self.original, self.files, self.descriptors, self.closed = original, {}, [], False

    def __enter__(self):
        self_guard()
        ns, operation, caller = original_data(self.original)
        custody_raw, _ = read(self.original.directory / 'custody.json', self.original.custody)
        custody = json.loads(custody_raw, object_pairs_hook=pairs)
        self.files[str(self.original.directory / 'custody.json')] = self.original.custody
        for name, pin in custody['files'].items():
            self.files[str(self.original.directory / name)] = pin
        rows = json.loads(read(self.original.directory / 'sources.json', custody['files']['sources.json'])[0], object_pairs_hook=pairs)
        for row in rows:
            self.files[row['path']] = {key: row[key] for key in ('generation', 'sha256')}
        for name, pin in ns['files'].items():
            self.files[str(Path(ns['root']) / name)] = pin
        try:
            root_fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            self.descriptors.append(root_fd)
            parents = {'/': root_fd}
            for path, pin in self.files.items():
                item_path = Path(path)
                fd = root_fd
                parent_path = Path('/')
                for name in item_path.parts[1:-1]:
                    parent_path = parent_path / name
                    key = str(parent_path)
                    if key not in parents:
                        parents[key] = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                        self.descriptors.append(parents[key])
                    fd = parents[key]
                fd = os.open(item_path.name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=fd)
                self.descriptors.append(fd)
                need(gen(os.fstat(fd)) == pin['generation'])
                raw = bytearray()
                while True:
                    part = os.read(fd, 65536)
                    if not part:
                        break
                    raw.extend(part)
                    need(len(raw) <= LIMIT * 3)
                need(sha(bytes(raw)) == pin['sha256'] and gen(os.fstat(fd)) == pin['generation'])
            self.finish()
            return self
        except BaseException:
            self.close()
            raise

    def finish(self):
        need(not self.closed)
        self_guard()
        original_data(self.original)
        for path, pin in self.files.items():
            read(path, pin, private=False)

    def close(self):
        for fd in reversed(self.descriptors):
            os.close(fd)
        self.descriptors.clear()
        self.closed = True

    def __exit__(self, kind, value, traceback):
        try:
            self.finish()
        finally:
            self.close()


def controller_source(original, mode, stream=None, offset=0):
    """Exact stored caller bytes; no current test graph reconstruction."""
    ns, operation, caller = original_data(original)
    need(mode in {'submit', 'observe', 'collect'})
    adapter_path = str(Path(ns['root']) / 'adapter.py')
    # Source authority is the held exact adapter file, not an arbitrary module import.
    loader = "import pathlib,hashlib,types,sys,json,base64,os\n"
    loader += "p=pathlib.Path(" + repr(adapter_path) + ")\n"
    loader += "fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW); before=os.fstat(fd); raw=b''\n"
    loader += "while True:\n c=os.read(fd,65536)\n if not c: break\n raw+=c\n if len(raw)>1048576: raise ValueError('adapter_bound')\n"
    loader += "assert hashlib.sha256(raw).hexdigest()==" + repr(ns['files']['adapter.py']['sha256']) + "\n"
    loader += "m=types.ModuleType('fixed_native_test_adapter');m.__file__=str(p);sys.modules[m.__name__]=m\n"
    loader += "exec(compile(raw,str(p),'exec',dont_inherit=True),m.__dict__)\n"
    loader += "assert m.gen(before)==" + repr(ns['files']['adapter.py']['generation']) + "==m.gen(os.fstat(fd))==m.gen(p.lstat())\n"
    loader += "value=m.run(" + repr(ns) + ',' + repr(operation) + ',base64.b64decode(' + repr(base64.b64encode(caller).decode()) + '),' + repr(mode) + ',' + repr(stream) + ',' + repr(offset) + ')\n'
    loader += "print(json.dumps(value,sort_keys=True));os.close(fd)\n"
    compile(loader, 'fixed-native-test-controller', 'exec')
    return loader.encode()


def admit_submit(original):
    """Complete local once fence BEFORE any future protected transport admission.

    Lost ACK, caller death, or uncertain submission always chooses observe next.
    This metadata creates no remote namespace and does not run a transport.
    """
    ns, operation, caller = original_data(original)
    expected = {'schemaVersion': 1, 'operation': operation, 'namespace': ns,
                'callerSha256': sha(caller), 'replayAllowed': False}
    fd = directory(original.directory)
    try:
        try:
            atomic(fd, 'transport-admission.json', encoded(expected))
            mode = 'submit'
        except FileExistsError:
            need(json.loads(read(original.directory / 'transport-admission.json')[0], object_pairs_hook=pairs) == expected)
            mode = 'observe'
        return mode, controller_source(original, mode)
    finally:
        os.close(fd)


def retain_returned(directory_path, label, stdout, stderr, returncode, final_guard):
    """Public bounded actual wire retained BEFORE any closing/semantic guard."""
    need(re.fullmatch('[a-z][a-z0-9-]{0,63}', label) is not None)
    need(type(stdout) is bytes and type(stderr) is bytes and (returncode is None or type(returncode) is int))
    fd = directory(directory_path)
    try:
        for name, raw in (('stdout', stdout), ('stderr', stderr)):
            atomic(fd, label + '.' + name, raw[:LIMIT])
        atomic(fd, label + '.callback.json', encoded({'returnCode': returncode,
            'stdoutBytes': len(stdout), 'stderrBytes': len(stderr), 'stdoutRetained': min(len(stdout), LIMIT),
            'stderrRetained': min(len(stderr), LIMIT), 'complete': returncode is not None, 'replayAllowed': False}))
        final_guard()
    finally:
        os.close(fd)
