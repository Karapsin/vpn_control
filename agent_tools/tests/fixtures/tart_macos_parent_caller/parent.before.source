    wake_complete=RUN/('native-known-session-wake-'+WAKE)/'complete.json';wake=parse(wake_complete.read_bytes());need(wake.get('operationId')==WAKE and wake.get('after',{}).get('display')=='ready'and wake.get('ordinaryCredentialReaderOpened')is False,'parent_wake_not_ready')
    need(remaining()>=100,'parent_benchmark_lease_budget_insufficient')
    await producer('macos-unlock-nonce-public-preflight.inert.py',['--target',TARGET,'--fixture-id',FIXTURE,'--operation-id',BENCH],90,'public136')
    complete=parse((RUN/('native-unlock-public-nonce-'+BENCH)/'complete.json').read_bytes());need(complete.get('operationId')==BENCH and len(complete.get('observations',[]))==136 and complete.get('ordinaryCredentialReaderOpened')is False and complete.get('observerActorAbsent')is True,'parent_public_benchmark_incomplete')
    record('public-phase-complete.json',{'wakeOperationId':WAKE,'benchmarkOperationId':BENCH,'remainingLowerBoundSeconds':remaining(),'checks':136,'ordinaryCredentialReaderOpened':False})
   except BaseException as error:
    failure=type(error).__name__;record('phase-failure.json',{'failureClass':failure,'originalObservationRequired':acquire_attempted,'acquireRetryForbidden':True,'otherInputForbidden':True})
   finally:
    if acquire_attempted:
     try:
      stop=time.monotonic()+240
      while True:
       result=await call('readiness-lease-status',base)
       if terminal(result):break
       if active(result)and not cancel_attempted:
        # Exact one original cancel, only after actual ACTIVE. If any phase
        # still has an original live child, let the finite lease expire.
        if all(J._birth(a['pid'])!=a['birth']for a in native_actors):
         record('cancel-dispatch-unknown.json',{'operationId':LEASE,'replacementForbidden':True});cancel_attempted=True;result=await call('readiness-lease-cancel',base)
         if terminal(result):break
       need(time.monotonic()<stop and result.get('nextAction',{}).get('kind')=='observe_original','parent_original_cleanup_blocked')
       await asyncio.sleep(.35)
      cleanup=await evidence();record('lease-terminal.json',result);record('source-capsule-closed.json',closure())
     except BaseException as error:
      record('cleanup-unknown.json',{'failureClass':type(error).__name__,'operationId':LEASE,'acquireRetryForbidden':True,'cancelRetryForbidden':cancel_attempted,'originalObservationRequired':True})
   actors=[{**a,'originalAbsent':J._birth(a['pid'])!=a['birth']}for a in native_actors]
   record('complete.json',{'phaseFailureClass':failure,'leaseOriginalClosed':cleanup is not None,'cleanup':cleanup,'cancelSubmittedOnce':cancel_attempted,'acquireSubmittedOnce':acquire_attempted,'producerActors':actors,'mcpServerActors':[{**a,'originalAbsent':J._birth(a['pid'])!=a['birth']}for a in mcp_actors],'allProducerActorsAbsent':all(a['originalAbsent']for a in actors),'ordinaryCredentialReaderOpened':False,'leaseOperationId':LEASE,'wakeOperationId':WAKE,'benchmarkOperationId':BENCH})
   print(json.dumps({'leaseOperationId':LEASE,'phaseFailureClass':failure,'leaseOriginalClosed':cleanup is not None,'allProducerActorsAbsent':all(a['originalAbsent']for a in actors)}))
   return 0 if failure is None and cleanup is not None else 1
  return asyncio.run(run())
