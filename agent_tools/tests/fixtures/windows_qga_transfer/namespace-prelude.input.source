EMITTER_SHA256='2938a7c6c25d23adc9683ced126fe2d3c0a88614dab59a7b134a624d6f8b0ee8'
EMITTER_ORIGIN='agent_tools/windows_artifact_transfer.py@2938a7c6c25d23adc9683ced126fe2d3c0a88614dab59a7b134a624d6f8b0ee8'
NATIVE_PHASE_IDS={'create': '5b566e87-f0a1-46b5-a234-b21141cc04c7', 'verify': 'e876cc06-a2de-4a76-9a98-1bbc68932fff'}
def command_bounds(path,args,input_bytes=None):
 require(type(path)is str and type(args)in (list,tuple) and all(type(x)is str and '\x00' not in x for x in (path,*args)),'instance_windows_argv')
 command_line=subprocess.list2cmdline([path,*args]);units=len(command_line.encode('utf-16le'))//2+1
 require(units<=32767,'instance_windows_command_chars')
 arguments={'path':path,'arg':list(args),'capture-output':True}
 if input_bytes is not None:
  require(type(input_bytes)is bytes and len(input_bytes)<=32768,'instance_windows_input_bound');arguments['input-data']=base64.b64encode(input_bytes).decode()
 request=(json.dumps({'execute':'guest-exec','arguments':arguments},separators=(',',':'))+'\n').encode()
 require(len(request)<=60000,'instance_windows_transport_bytes')
 return arguments,{'commandUtf16UnitsIncludingNul':units,'serializedRequestBytes':len(request),'commandSha256Utf16le':hashlib.sha256(command_line.encode('utf-16le')).hexdigest()}
# Execute the entire pinned canonical producer as a normally registered module.
# No private renderer/template copy or injected helper globals are authoritative.
import sys
import types
EMITTER_MODULE=None
EMITTER_RECORD=None
NATIVE_PLANS={}

def initialize_emitter():
 global EMITTER_MODULE,EMITTER_RECORD
 require(type(EMITTER_SOURCE)is bytes and hashlib.sha256(EMITTER_SOURCE).hexdigest()==EMITTER_SHA256,'transfer_emitter_source_sha256')
 module=types.ModuleType('_vpn_control_windows_artifact_transfer_'+EMITTER_SHA256)
 module.__name__+='_'+str(id(module));module.__file__=EMITTER_ORIGIN
 require(module.__name__ not in sys.modules,'transfer_emitter_module_preexisting');sys.modules[module.__name__]=module
 exec(compile(EMITTER_SOURCE,EMITTER_ORIGIN,'exec'),module.__dict__,module.__dict__)
 require(sys.modules[module.__name__]is module,'transfer_emitter_registration')
 for name in ('render_endpoint','render_verifier','build_guest_exec','decode_guest_result','render_probe_endpoint','render_probe_verifier'):
  function=getattr(module,name);require(function.__module__==module.__name__ and function.__globals__ is module.__dict__,'transfer_emitter_function_owner')
 EMITTER_MODULE=module
 EMITTER_RECORD={'sha256':EMITTER_SHA256,'bytes':len(EMITTER_SOURCE),'origin':EMITTER_ORIGIN,'moduleName':module.__name__,'registered':True,'completeNamespaceExecuted':True,'guestContextSha256':GUEST_CONTEXT_SHA256,'target':TARGET}
 return EMITTER_RECORD

def pin_emitter_source():
 require(EMITTER_MODULE is not None,'transfer_emitter_missing')
 digest=hold_generated_bytes(prefix+'.canonical-emitter.py',EMITTER_SOURCE)
 require(digest==EMITTER_SHA256,'transfer_emitter_held_sha256')
 save(prefix+'.canonical-emitter.json',EMITTER_RECORD)

def build_native_command(label,source):
 require(type(source)is bytes and source.startswith(b'\xef\xbb\xbf'),'transfer_native_source_bytes')
 source_sha=hold_generated_source(label,source)
 plan=EMITTER_MODULE.build_guest_exec(source,guest_context=GUEST_CONTEXT,phase_id=NATIVE_PHASE_IDS[label])
 require(type(plan)is dict and set(plan)=={'arguments','bounds','launchSource','transport','savedSource'},'transfer_emitter_command_fields')
 launch_sha=hold_generated_source(label+'.launch',plan['launchSource'])
 arguments=plan['arguments'];bounds=plan['bounds']
 input_bytes=base64.b64decode(arguments['input-data'],validate=True)if 'input-data'in arguments else None
 actual,independent=command_bounds(arguments['path'],arguments['arg'],input_bytes)
 require(actual==arguments and bounds['sourceSha256']==launch_sha and bounds['sourceBytes']==len(plan['launchSource']) and bounds['payloadSha256']==source_sha and bounds['payloadBytes']==len(source) and bounds['serializedRequestBytes']==independent['serializedRequestBytes'] and bounds['commandUtf16UnitsIncludingNul']==independent['commandUtf16UnitsIncludingNul'],'transfer_emitter_command_bounds')
 require(plan['transport']in ('saved-source','inline'),'transfer_emitter_transport')
 if plan['transport']=='saved-source':
  expected={'phaseId':NATIVE_PHASE_IDS[label],'path':GUEST_CONTEXT['sourceWorkspace']+'\\infra-'+NATIVE_PHASE_IDS[label]+'.ps1','workspace':GUEST_CONTEXT['sourceWorkspace'],'bytes':len(source),'sha256':source_sha}
  require(input_bytes==source and type(plan['savedSource'])is dict and plan['savedSource']==expected,'transfer_emitter_saved_binding')
 else:require(input_bytes is None and plan['savedSource']is None,'transfer_emitter_inline_binding')
 NATIVE_PLANS[label]=plan
 save(prefix+'.'+label+'.command.json',{'arguments':arguments,'transport':plan['transport'],'savedSource':plan['savedSource'],'canonicalEmitterSha256':EMITTER_SHA256,'guestContextSha256':GUEST_CONTEXT_SHA256,'target':TARGET,'sourceSha256':source_sha,'launchSourceSha256':launch_sha,'bounds':bounds,'independentBounds':independent})
 return plan,source_sha

def validate_boot_actor(proof):
 require(proof['guestBootClosing']is True and proof['bootstrapActorClosing']is True,'transfer_boot_actor_closing')
 fields={'pid','birthFileTimeUtc','sessionId','path','principalSid','is64BitProcess','powerShellMajor','powerShellEdition','boot','tokenElevation','tokenElevationType'}
 for name in ('bootstrapOpening','bootstrapClosing'):
  actor=proof[name]
  require(type(actor)is dict and set(actor)==fields,'transfer_boot_actor_fields')
  require(exact_int(actor['pid'],1) and type(actor['birthFileTimeUtc'])is str and re.fullmatch('[1-9][0-9]{16,19}',actor['birthFileTimeUtc'])is not None,'transfer_boot_actor_identity')
  require(type(actor['sessionId'])is int and actor['sessionId']==0 and actor['path']==GUEST_CONTEXT['powerShellPath'] and actor['principalSid']=='S-1-5-18' and actor['is64BitProcess']is True and type(actor['powerShellMajor'])is int and actor['powerShellMajor']==5 and actor['powerShellEdition']=='Desktop','transfer_boot_actor_context')
  require(type(actor['tokenElevation'])is int and actor['tokenElevation']==1 and type(actor['tokenElevationType'])is int and actor['tokenElevationType']in (1,2),'transfer_boot_actor_elevation')
  require(type(actor['boot'])is dict and set(actor['boot'])==set(GUEST_CONTEXT['boot']) and actor['boot']==GUEST_CONTEXT['boot'] and all(type(value)is str for value in actor['boot'].values()),'transfer_guest_boot')
 require(proof['bootstrapOpening']==proof['bootstrapClosing'],'transfer_boot_actor_changed')
