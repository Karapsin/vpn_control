 for name,raw in captured:
  key='_fixed_active_'+name[:-3];text+='m=types.ModuleType('+repr(key)+');m.__file__='+repr('<fixed-'+name+'>')+';sys.modules[m.__name__]=m\nexec(compile('+repr(raw)+',m.__file__,"exec"),m.__dict__);modules.append(m)\n'
 text+='modules[1].__dict__["__bsd_class__"]=modules[0]._Bsd\nmodules[-1].__dict__.update(__modules__=modules[:-2],__pipe_runtime__=modules[-2],__pipe_runtime_source__='+repr(dict(captured)['bounded_runtime.py'])+',__configuration__='+repr(cfg)+',__outer_file__=__file__,__outer_code__=_outer_code)\nraise SystemExit(modules[-1].main())\n'
