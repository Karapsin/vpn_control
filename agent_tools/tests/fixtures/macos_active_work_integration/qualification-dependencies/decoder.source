   before=os.stat(self.path.name,dir_fd=parent,follow_symlinks=False)
   need(stat.S_ISREG(before.st_mode)and before.st_uid==0 and not before.st_mode&0o022 and before.st_dev==volume.device and 0<before.st_size<=limit,'source_metadata')
   self.named.append((parent,self.path.name,generation(before)));self.fd=os.open(self.path.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent);self.fds.append((self.fd,generation(before)));need(generation(os.fstat(self.fd))==generation(before),'source_changed');self.raw=os.read(self.fd,before.st_size+1);need(len(self.raw)==before.st_size,'source_changed');self.guard()
