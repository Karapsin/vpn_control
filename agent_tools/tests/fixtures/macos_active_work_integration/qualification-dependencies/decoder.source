 captured=[]
 for name,path in files:
  fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
  try:
   a=os.fstat(fd);need(stat.S_ISREG(a.st_mode)and 0<a.st_size<=262144,'source_unavailable');raw=os.read(fd,a.st_size+1);need(len(raw)==a.st_size and generation(a)==generation(os.fstat(fd))==generation(path.lstat()),'source_changed')
