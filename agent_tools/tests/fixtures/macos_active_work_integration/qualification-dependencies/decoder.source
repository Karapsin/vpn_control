  need(domain.kind in('system','caller_user')and type(domain.uid)is int and ((domain.kind=='system'and domain.uid==0)or(domain.kind=='caller_user'and domain.uid>=501)),'domain_identity')
  answer=n.single(domain,row['Label']);need(type(answer)is dict and answer.get('Label')==row['Label']and type(answer.get('PID'))is int and answer['PID']==actor[0],'domain_changed')
  origin='/System/Library/LaunchDaemons'if domain.kind=='system'else'/System/Library/LaunchAgents';path=Path(origin)/(row['Label']+'.plist')
  try:
   with n.source(path,self.volume)as held:
    value=plistlib.loads(held.raw);need(type(value)is dict and value.get('Label')==row['Label'],'source_label')
    program=value.get('Program');args=value.get('ProgramArguments')
    if args is None and type(program)is str:args=[program] # launchd Program-only declaration, not a missing runtime default.
    need(type(args)is list and 0<len(args)<=4096 and all(type(a)is str for a in args),'source_arguments')
    if program is None:program=args[0]
    need(type(program)is str and program.startswith('/'),'source_program')
    expected=domain.uid if domain.kind=='caller_user'else 0
    if 'UserName'in value:
     need(type(value['UserName'])is str,'source_account')
     try:expected=pwd.getpwnam(value['UserName']).pw_uid
     except KeyError:raise Blocked('source_account')from None
     if domain.kind=='caller_user':need(expected==domain.uid,'source_account')
    need(actor[1]==expected and actor[2]==1,'source_account')
    if 'GroupName'in value:
     need(type(value['GroupName'])is str,'source_account')
     try:expected_gid=grp.getgrnam(value['GroupName']).gr_gid
     except KeyError:raise Blocked('source_account')from None
     need(n.credentials(actor)==expected_gid,'source_account')
    for source in (row,answer):
     need(source.get('Program')==program,'source_program')
     if 'ProgramArguments'in source:need(source['ProgramArguments']==args,'source_arguments')
     if 'UserName'in source:need(type(source['UserName'])is str and pwd.getpwnam(source['UserName']).pw_uid==expected,'source_account')
     if 'GroupName'in source:need(type(source['GroupName'])is str and grp.getgrnam(source['GroupName']).gr_gid==n.credentials(actor),'source_account')
    executable,actual=n.argv(actor);need(executable==os.fsencode(program)and actual==tuple(os.fsencode(a)for a in args),'source_arguments')
    with n.source(program,self.volume,64*1024*1024)as image:
     need(n.image_match(actor,program,image),'mapped_image_unavailable');image.guard();held.guard();n.guard(actor)
    declared=value.get('EnableTransactions')is True or value.get('EnablePressuredExit')is True
    # Loaded properties may be absent; if present they must agree with sealed source.
    for loaded in(row,answer):
     for key in ('EnableTransactions','EnablePressuredExit'):
      if key in loaded:need(type(loaded[key])is bool and loaded[key]==value.get(key,False),'unknown_source_semantics')
    return _SourceProof(actor,'declared_transaction_service'if declared else'purpose_unqualified',declared,_CAP)
  except Blocked:raise
  except (OSError,ValueError,TypeError,KeyError):raise Blocked('source_unavailable')from None

