class ActiveSources:
 """Native loaded-job authority selects only the corresponding active source.
 Unreadable unrelated inactive files are never traversed or presumed active.
 A selected source that cannot be authenticated always remains unresolved.
 """
 def __init__(self,native,volume,ordinary_uid):
  need(type(native)is Native and volume.source_eligible,'source_unavailable');self.native,self.volume,self.ordinary_uid=native,volume,ordinary_uid
