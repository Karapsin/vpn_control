if len(sys.argv)!=1 or os.geteuid()!=UID or __import__('pwd').getpwuid(UID).pw_name!=PRINCIPAL:raise SystemExit(3)
p=Path(__file__);fds=[];named=[]
def g(s):return tuple(getattr(s,k)for k in ('st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_mtime_ns','st_ctime_ns'))
def check():
