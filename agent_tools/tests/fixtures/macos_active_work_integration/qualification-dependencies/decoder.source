    else:
     need(proof.purpose=='declared_transaction_service'and activity=='tracked_clean_idle_exit','activity_unqualified');state='idle_declared_transaction_service';reason='source_bound_transaction_and_kernel_clean'
  except (Blocked,OSError,ValueError,TypeError,KeyError)as e:reason=safe_reason(e,'source_unavailable');errors.add(reason)
  reports.append({'pid':pid,'uid':actor[1],'birth':'darwin:'+str(actor[3])+':'+str(actor[4]),'role':role,'state':state,'reason':reason,'sourceJoined':joined,'activity':activity})
