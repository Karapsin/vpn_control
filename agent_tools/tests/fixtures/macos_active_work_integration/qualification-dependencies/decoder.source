  before=os.stat(name,dir_fd=parent,follow_symlinks=False)
  if before.st_uid!=0 or before.st_mode&0o022:raise SystemExit(3)
  flags=os.O_RDONLY|os.O_NOFOLLOW|(os.O_DIRECTORY if stat.S_ISDIR(before.st_mode)else os.O_NONBLOCK)
  if not (stat.S_ISDIR(before.st_mode)or stat.S_ISREG(before.st_mode)):raise SystemExit(3)
