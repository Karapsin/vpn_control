def merge_shapes(total,one):
 for key,value in one.items():
  if key=='fields':continue
  total[key]+=value
 for name,field in one['fields'].items():
  dest=total['fields'].setdefault(name,{'present':0,'missing':0,'activePresent':0,'types':{},'activeTypes':{},'containerValueTypes':{},'containerOverflow':0})
  for key in('present','activePresent','containerOverflow'):dest[key]+=field[key]
  for key in('types','activeTypes','containerValueTypes'):
   for kind,count in field[key].items():dest[key][kind]=dest[key].get(kind,0)+count
 for field in total['fields'].values():field['missing']=total['dictionaryRows']-field['present']
 return total

def observe_rows(rows,copy_one):
