  need(domain,'domain_constant_unavailable');owned=self.sm.SMCopyAllJobDictionaries(domain)
  need(owned,'domain_null_result');rows=self.base.value(owned)
  def single(label):
   # Only a label returned by that exact all-jobs snapshot reaches this API.
   text=self.base.cf.CFStringCreateWithCString(None,label.encode('utf-8','strict'),0x08000100);need(text,'job_label_unavailable')
   try:
    owned=self.sm.SMJobCopyDictionary(domain,text)
    return None if not owned else self.base.value(owned)
   finally:self.base.cf.CFRelease(text)
  return observe_rows(rows,single)

