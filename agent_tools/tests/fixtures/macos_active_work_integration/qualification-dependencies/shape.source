   same=type(answer.get('Label'))is str and answer['Label']==row['Label'];query['labelMatches'if same else'labelMismatches']+=1
   same=type(answer.get('PID'))is int and answer['PID']==row['PID'];query['pidMatches'if same else'pidMismatches']+=1
 query['descriptions']=descriptions;result['activeSingleJobQuery']=query
 return result

class NativeDomain:
 def __init__(self,base,sm):
  self.base,self.sm=base,sm;base._fn(sm,'SMJobCopyDictionary',C.c_void_p,[C.c_void_p,C.c_void_p])
