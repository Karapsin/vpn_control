COMPLETE_STAGE_OLD_COPY_LOOP="foreach($row in $cp117CopyRows){\n $destination=Join-Path $cp117NewContent $row.relative;$out=[IO.FileStream]::new($destination,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)\n try{$row.held.CopyTo($out);$out.Flush($true)}finally{$out.Dispose()}\n $after=[Cp117InstalledFile]::Read($row.source);$fresh=[Cp117InstalledFile]::Read($destination)\n if($after[0] -cne $row.before[0] -or $after[1] -cne $row.before[1] -or $fresh[0] -cne $row.sha256 -or (Get-Item -LiteralPath $destination -Force).Length -ne $row.size){throw 'COMPLETE_COPY_DRIFT'}\n [void]$cp117Copied.Add([pscustomobject]@{relative=$row.relative;size=[int64]$row.size;sha256=$fresh[0];identity=$fresh[1];sourceIdentity=$after[1];sourceSha256=$after[0];sourcePreserved=$true})\n}\n"
COMPLETE_STAGE_CURRENT_COPY_LOOP="foreach($row in $cp117CopyRows){\n $destination=Join-Path $cp117NewContent $row.relative;$out=[IO.FileStream]::new($destination,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)\n try{$row.held.CopyTo($out);$out.Flush($true)}finally{$out.Dispose()}\n $dstHold=[IO.FileStream]::new($destination,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read);[void]$cp117StageHandles.Add($dstHold);$row|Add-Member dstHeld $dstHold\n $after=[Cp117InstalledFile]::Read($row.source);$fresh=[Cp117InstalledFile]::Read($destination)\n if($after[0] -cne $row.before[0] -or $after[1] -cne $row.before[1] -or $fresh[0] -cne $row.sha256 -or (Get-Item -LiteralPath $destination -Force).Length -ne $row.size){throw 'COMPLETE_COPY_DRIFT'}\n [void]$cp117Copied.Add([pscustomobject]@{relative=$row.relative;size=[int64]$row.size;sha256=$fresh[0];identity=$fresh[1];sourceIdentity=$after[1];sourceSha256=$after[0];sourcePreserved=$true})\n}\n"
COMPLETE_STAGE_CURRENT_OUTPUT_CLOSING="$cp117OP=[Cp117InstalledFile].GetMethod('Pin',[Reflection.BindingFlags]'Static,NonPublic')\nfor($i=0;$i -lt 5;$i++){$dst=Join-Path $cp117NewContent $cp117CopyRows[$i].relative;$last=[Cp117InstalledFile]::Read($dst);$saved=$cp117Copied[$i];if($last[0] -cne $saved.sha256 -or $last[1] -cne $saved.identity -or (Get-Item -LiteralPath $dst).Length -ne $saved.size){throw 'COMPLETE_OUTPUT_DRIFT'}}\n# Pure native identity pass after all hash/body/catalogue/ACL reads.\nfor($i=0;$i -lt 5;$i++){$row=$cp117CopyRows[$i];$heldPin=[string]$cp117OP.Invoke($null,[object[]]@([IO.FileStream]$row.dstHeld));$named=[IO.FileStream]::new((Join-Path $cp117NewContent $row.relative),[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read);try{$namedPin=[string]$cp117OP.Invoke($null,[object[]]@([IO.FileStream]$named));if($heldPin -cne $cp117Copied[$i].identity -or $namedPin -cne $heldPin){throw 'COMPLETE_OUTPUT_ID'}}finally{$named.Dispose()}}\n"

COMPLETE_STAGE_CATALOGUE_ACL_GZIP=''
class CompleteStageOutputCustodyTests(HistoryCase):
 @unittest.skipUnless(__import__('os').name=='nt','actual Windows native sharing/FILE_CS requires Windows')
 def test_actual_old_copy_loop_can_publish_stale_earlier_destination(self):
  import subprocess,base64,tempfile,hashlib
  with tempfile.TemporaryDirectory()as td:
   root=Path(td);src=root/'source';dst=root/'destination';src.mkdir();dst.mkdir()
   for i in range(5):(src/('file%d'%i)).write_bytes(b'PUBLIC_A')
   literal=lambda x:"'"+str(x).replace("'","''")+"'"
   script="$ErrorActionPreference='Stop';Add-Type -TypeDefinition @'\n"+fixture.refresh.installed.FILE_CS+"\n'@;$cp117NewContent="+literal(dst)+";$cp117CopyHolds=New-Object System.Collections.ArrayList;$cp117Copied=New-Object System.Collections.ArrayList;$cp117CopyRows=New-Object System.Collections.ArrayList;try{"
   for i in range(5):
    script+="$p="+literal(src/('file%d'%i))+";$h=[IO.FileStream]::new($p,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read);[void]$cp117CopyHolds.Add($h);[void]$cp117CopyRows.Add([pscustomobject]@{relative='file"+str(i)+"';source=$p;size=8;sha256='"+hashlib.sha256(b'PUBLIC_A').hexdigest()+"';held=$h;before=[Cp117InstalledFile]::Read($p)})\n"
   script+=COMPLETE_STAGE_OLD_COPY_LOOP
   # Controlled real mutation after the actual loop's row readings, before publication.
   script+="[IO.File]::WriteAllBytes("+literal(dst/'file0')+",[Text.Encoding]::ASCII.GetBytes('CHANGED!'));$old=$cp117Copied[0];$current=[Cp117InstalledFile]::Read("+literal(dst/'file0')+");if($old.sha256 -ceq $current[0]){throw 'OLD_STALE_NOT_REPRODUCED'};Write-Output 'OLD_STALE_ROW_REPRODUCED'}finally{foreach($h in $cp117CopyHolds){$h.Dispose()}}"
   proc=subprocess.run(['powershell.exe','-NoProfile','-NonInteractive','-EncodedCommand',base64.b64encode(script.encode('utf-16le')).decode()],capture_output=True,timeout=20)
   self.assertEqual(proc.returncode,0,proc.stderr.decode(errors='replace'));self.assertIn(b'OLD_STALE_ROW_REPRODUCED',proc.stdout)
 @unittest.skipUnless(__import__('os').name=='nt','actual Windows native sharing/FILE_CS requires Windows')
 def test_actual_current_copy_loop_blocks_mutation_and_closes_all_outputs(self):
  import subprocess,base64,tempfile,hashlib
  with tempfile.TemporaryDirectory()as td:
   root=Path(td);src=root/'source';dst=root/'destination';src.mkdir();dst.mkdir()
   for i in range(5):(src/('file%d'%i)).write_bytes(b'PUBLIC_A')
   literal=lambda x:"'"+str(x).replace("'","''")+"'"
   script="$ErrorActionPreference='Stop';Add-Type -TypeDefinition @'\n"+fixture.refresh.installed.FILE_CS+"\n'@;$cp117NewContent="+literal(dst)+";$cp117CopyHolds=New-Object System.Collections.ArrayList;$cp117StageHandles=New-Object System.Collections.ArrayList;$cp117Copied=New-Object System.Collections.ArrayList;$cp117CopyRows=New-Object System.Collections.ArrayList;try{"
   for i in range(5):
    script+="$p="+literal(src/('file%d'%i))+";$h=[IO.FileStream]::new($p,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read);[void]$cp117CopyHolds.Add($h);[void]$cp117CopyRows.Add([pscustomobject]@{relative='file"+str(i)+"';source=$p;size=8;sha256='"+hashlib.sha256(b'PUBLIC_A').hexdigest()+"';held=$h;before=[Cp117InstalledFile]::Read($p)})\n"
   script+=COMPLETE_STAGE_CURRENT_COPY_LOOP
   script+="$refused=$false;try{[IO.File]::WriteAllBytes("+literal(dst/'file0')+",[Text.Encoding]::ASCII.GetBytes('CHANGED!'))}catch [IO.IOException]{$refused=$true};if(!$refused){throw 'CURRENT_MUTATION_NOT_REFUSED'};"
   script+=COMPLETE_STAGE_CURRENT_OUTPUT_CLOSING
   script+="Write-Output 'CURRENT_HELD_OUTPUTS_CLOSED'}finally{foreach($h in $cp117StageHandles){$h.Dispose()};foreach($h in $cp117CopyHolds){$h.Dispose()}}"
   proc=subprocess.run(['powershell.exe','-NoProfile','-NonInteractive','-EncodedCommand',base64.b64encode(script.encode('utf-16le')).decode()],capture_output=True,timeout=20)
   self.assertEqual(proc.returncode,0,proc.stderr.decode(errors='replace'));self.assertIn(b'CURRENT_HELD_OUTPUTS_CLOSED',proc.stdout)
