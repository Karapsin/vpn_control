"""One reviewed RAW62b creation, with fresh post-reservation global admission.

No execution on import. This is a source-bound direct native adapter around the
unchanged canonical start function; its only added hooks qualify the new ledger
after preparation and revalidate it at the canonical before_submit boundary.
"""
from pathlib import Path
import ast,base64,copy,hashlib,importlib.util,inspect,json,os,stat,subprocess,sys,time,uuid
from contextlib import closing
ROOT=Path(__file__).resolve().parents[5];sys.path.insert(0,str(ROOT))
from agent_tools import windows_vm_deploy as deploy,windows_vm_resources as facts,readiness_windows as windows,ssh_transport as transport,ssh_direct_nested_channel as direct,vm_workflow
from agent_tools.private_credential_file import SecretFile
from agent_tools.native_review_source_closure import _Held
BASE=Path(__file__).parent
PLAN=ROOT/'.runtime/tool-recovery/native-followup-20261027/windows/fresh-fixture-plan/e36408e1-8e7a-4066-95a0-c45871966a3e'
ALIASES=('windows-raw942cca12-current-v3-policy','windows-libvirt-6e848ad1-current-v4-policy')
DEPLOYMENT='62b489bc-81d5-4d3a-b87a-94fa2b90c57d'
EXPECTED_START_MODULE_SHA='f68dba905b48fa840cc6759e20fe402dc43e3aa50b157494a05a83f19bebb85b'
ORIGINAL_BRIDGE=ROOT/'.runtime/tool-recovery/android-windows-coverage-bridge-b933ce1b-7c45-4961-ba72-9a430392c871/bridge.py'
ORIGINAL_BRIDGE_SHA='efa93dc2592d23c8c43dd0e0d535ec0c6d57f812fdf461917f7da69e1346c1b7'
BRIDGE_GENERATOR=BASE/'bridge-current.py'
BRIDGE_GENERATOR_SHA='f2ecbeed5ccbd897b8db087db0cdae93ce2f542a71f6159e701d34bed033b77b'
QUALIFIED_TEMPLATE=BASE/'bridge-12932a24-eba4-49ef-8536-30277258018b/observer.source'
QUALIFIED_TEMPLATE_SHA='e4a122cf88735593623bfc5bbc40bcd1d4be1a6b6806314c6ec9c3fefc938fec'


def digest(raw):return hashlib.sha256(raw).hexdigest()
def save(directory,name,value):windows._save(directory/name,value)
def pin(s):return [s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
def stable(value):return {k:([{x:y for x,y in row.items()if x!='observedAtUnixMs'}for row in v]if k=='rows'else v)for k,v in value.items()if k!='observedAtUnixMs'}

def module_from_path(path,name):
    spec=importlib.util.spec_from_file_location(name,path);module=importlib.util.module_from_spec(spec);sys.modules[name]=module;spec.loader.exec_module(module);return module

def rebind_bridge(getter):
    raw=ORIGINAL_BRIDGE.read_bytes();assert digest(raw)==ORIGINAL_BRIDGE_SHA
    generator=BRIDGE_GENERATOR.read_bytes();assert digest(generator)==BRIDGE_GENERATOR_SHA
    node=next(n for n in ast.parse(generator).body if isinstance(n,ast.FunctionDef)and n.name=='rebind_child_bootstrap');namespace={'ast':ast,'hashlib':hashlib};exec(compile(ast.Module(body=[node],type_ignores=[]),'reviewed-complete-child-binding','exec'),namespace)
    lines=raw.decode().splitlines(keepends=True)
    for n in reversed(ast.parse(raw).body):
        if isinstance(n,ast.Assign)and isinstance(n.targets[0],ast.Name)and n.targets[0].id in ('GETTER_SOURCE','GETTER_SHA','CHILD_BOOTSTRAP'):
            key=n.targets[0].id;value=getter if key=='GETTER_SOURCE'else digest(getter)if key=='GETTER_SHA'else namespace['rebind_child_bootstrap'](ast.literal_eval(n.value),getter);lines[n.lineno-1:n.end_lineno]=[key+'='+repr(value)+'\n']
    result=''.join(lines).encode();compile(result,'reviewed-new-ledger-bridge','exec');return result


class GlobalFence:
    def __init__(self,out,spec):
        self.out=out;self.spec=spec;self.held=_Held();self.sources=windows._source_pins();self.prepared=None;self.epoch=None
        for path,p in self.sources.items():self.held.read(path,p['sha256'],max_bytes=1048576)
        from agent_tools import native_host_observation,readiness_fixture_registry,native_review_source_closure,source_module_loader,ssh_automatic_program
        builder_path=ROOT/'.runtime/tool-recovery/native-followup-20261027/windows/live-allocation-coverage-6e-942/coverage_builder.py'
        for path in (builder_path,*(Path(m.__file__).resolve()for m in (native_host_observation,readiness_fixture_registry,native_review_source_closure,source_module_loader,ssh_automatic_program,direct))):
            self.sources[str(path)]={'sha256':digest(path.read_bytes())}
        assert len(self.sources)==40
        for path,p in self.sources.items():self.held.read(path,p['sha256'],max_bytes=1048576)
        for path in (Path(vm_workflow.__file__),ROOT/'scripts/fixture_environment.py',Path(__file__),PLAN/'rw.draft-spec.json',PLAN/'rw.draft-setup.json',ORIGINAL_BRIDGE,BRIDGE_GENERATOR,QUALIFIED_TEMPLATE):self.held.read(str(path),digest(path.read_bytes()),max_bytes=1048576)
        expected_capacity=('SPEC='+repr(spec)+"\nMODE='host-resources'\n"+facts.definitions()+inspect.getsource(facts._main)+'\n_main()\n').encode()
        template_bindings={n.targets[0].id:ast.literal_eval(n.value)for n in ast.parse(QUALIFIED_TEMPLATE.read_bytes()).body if isinstance(n,ast.Assign)and isinstance(n.targets[0],ast.Name)and n.targets[0].id in ('CAPACITY',)}
        assert template_bindings=={'CAPACITY':expected_capacity}
        self.held.finish();self.held.final_identity_pass()
        save(out,'finite-source-pins.json',self.sources)
        assert digest(Path(deploy.__file__).read_bytes())==EXPECTED_START_MODULE_SHA
        self.initial=self.authority()
        save(out,'initial-both-ledger-authority.private.json',self.initial)
    def authority(self):
        records=[]
        with closing(_Held())as guards:
            for path in (ROOT/'.rag_index/native-environments/reservations.json',ROOT.parent/'vpn_control/.rag_index/native-environments/reservations.json'):
                parent=guards.directory(str(path.parent));fd=os.open(path.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=parent)
                try:
                    before=pin(os.fstat(fd));raw=os.read(fd,4*1024**2+1)
                    assert stat.S_ISREG(before[2])and len(raw)==before[6]and before[5]==1 and stat.S_IMODE(before[2])==0o600 and before[3]==os.getuid()and pin(os.fstat(fd))==before==pin(os.stat(path.name,dir_fd=parent,follow_symlinks=False))
                    value=json.loads(raw,object_pairs_hook=transport._reject_duplicate_keys)
                    assert type(value)is dict and set(value)=={'version','reservations'}and value['version']==1 and type(value['reservations'])is list
                    assert all(type(r)is dict and type(r.get('requestedMemoryBytes'))is int and r['requestedMemoryBytes']>0 for r in value['reservations'])
                    guards.read(str(path),digest(raw),tuple(before),max_bytes=4*1024**2)
                finally:os.close(fd)
                records.append({'path':str(path),'generation':before,'sha256':digest(raw),'rawBase64':base64.b64encode(raw).decode()})
            guards.finish();guards.final_identity_pass()
        return records
    def assert_only_own_claim_added(self,current,identity):
        for prior,now in zip(self.initial,current):
            a=json.loads(base64.b64decode(prior['rawBase64']));b=json.loads(base64.b64decode(now['rawBase64']))
            if prior['path']!=str(ROOT/'.rag_index/native-environments/reservations.json'):assert a==b;continue
            old={r['id']:r for r in a['reservations']};new={r['id']:r for r in b['reservations']};assert all(new.get(k)==v for k,v in old.items())
            added=[r for k,r in new.items()if k not in old];assert len(added)==1;own=added[0]
            from agent_tools import native_environment
            assert native_environment._identity(own)==identity and own['requestedMemoryBytes']==4*1024**3 and own['allocationState']=='pending'and own['environment']=='windows-'+DEPLOYMENT and own['operator']=='windows-vm-deploy'
    def after_prepare(self,prepared,spec):
        # This runs AFTER the actual normal reservation, BEFORE credentials,
        # the canonical VM intent and every VM effect. It does not reuse42GiB pins.
        self.prepared=prepared;current=self.authority();self.assert_only_own_claim_added(current,prepared['reservation']['identity']);save(self.out,'post-normal-claim-both-ledger-authority.private.json',current)
        builder=module_from_path(ROOT/'.runtime/tool-recovery/native-followup-20261027/windows/live-allocation-coverage-6e-942/coverage_builder.py','owned_raw62_postclaim_getter_builder');op=str(uuid.uuid4());getter_dir=self.out/('postclaim-getter-'+op)
        save(self.out,'postclaim-getter-dispatch.json',{'operationId':op,'purpose':'fresh-post-normal-readonly-getter','outputDirectory':str(getter_dir),'vmMutation':False,'claimMutation':False})
        print(json.dumps({'phase':'postclaim-getter-original','operationId':op,'outputDirectory':str(getter_dir)}),flush=True)
        result=builder.build_and_observe(ROOT,ALIASES,op,getter_dir,timeout=120);getter=result['getterSource'];bridge=rebind_bridge(getter)
        source=QUALIFIED_TEMPLATE.read_bytes();assert digest(source)==QUALIFIED_TEMPLATE_SHA
        lines=source.decode().splitlines(keepends=True);operation=str(uuid.uuid4())
        for n in reversed(ast.parse(source).body):
            if isinstance(n,ast.Assign)and isinstance(n.targets[0],ast.Name)and n.targets[0].id in ('OP','BRIDGE'):
                name=n.targets[0].id;value=operation if name=='OP'else bridge;lines[n.lineno-1:n.end_lineno]=[name+'='+repr(value)+'\n']
        observer=''.join(lines).encode();compile(observer,'fresh-postclaim-global-observer','exec');directory=self.out/('postclaim-bridge-'+operation);directory.mkdir(mode=0o700);save(directory,'bridge.source',bridge);save(directory,'observer.source',observer);save(directory,'intent.json',{'operationId':operation,'purpose':'post-normal-claim-readonly-capacity','sourceSha256':digest(observer),'vmMutation':False,'claimMutation':False})
        with transport.admitted_transport(ROOT,'archlinux',operation,deadline=time.monotonic()+120)as admission,direct.Guard(ROOT,host='archlinux')as authority,SecretFile(str(ROOT/'.codex/arch-sudo.local'))as credential:
            argv=transport.build_ssh_argv(authority.config,'archlinux',60,command=('sudo','-S','-p','','--','python3','-I','-B','-c',"import sys;exec(compile(sys.stdin.buffer.read(),'<fresh-raw62-postclaim-global>','exec'))"));admission.revalidate();authority.guard();self.held.finish();self.held.final_identity_pass();credential.guard()
            child=transport.popen_ssh(argv,cwd=ROOT,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE);save(directory,'local-child.json',{'operationId':operation,'pid':child.pid})
            print(json.dumps({'phase':'postclaim-bridge-accepted-original','operationId':operation,'pid':child.pid,'outputDirectory':str(directory)}),flush=True)
            payload=credential.text.encode()+b'\n'+observer
            try:stdout,stderr=child.communicate(payload,timeout=90)
            except subprocess.TimeoutExpired:save(directory,'pending.json',{'operationId':operation,'pid':child.pid,'originalOnly':True});stdout,stderr=child.communicate()
            payload=None;assert credential.text.encode()not in stdout+stderr;save(directory,'stdout.private',stdout);save(directory,'stderr.private',stderr);save(directory,'callback.json',{'returnCode':child.returncode,'reaped':True,'stdoutBytes':len(stdout),'stderrBytes':len(stderr)});assert child.returncode==0 and not stderr;credential.guard();admission.revalidate();authority.guard()
        value=json.loads(stdout);save(directory,'result.private.json',value);assert value['failure']is None and value['parentPrincipal']==value['closingParentPrincipal']==[0,0,0,0,[0]]
        assert stable(result['observation'])==stable(value['before'])==stable(value['after'])
        assert len(value['bridgeRecords'])==2 and all(r['complete']and r['returncode']==0 and r['childPrincipal']==[1000,1000,1000,1000,[1000]]for r in value['bridgeRecords'])
        measurement=facts.measurement(value['capacity']);covered=0;allrows=[r for a in current for r in json.loads(base64.b64decode(a['rawBase64']))['reservations']]
        for row in value['before']['rows']:
            matches=[r for r in value['capacity']['vms']if (r['pid'],r['startTicks'],r['configuredMemoryBytes'])==(row['pid'],row['startTicks'],row['configuredMemoryBytes'])];assert len(matches)==1
            for key in ('uid','sessionId','commandSha256'):assert matches[0][key]==row[key]
            g=row['executableGeneration'];v=matches[0]['executableGeneration'];assert g==v[:5]+[v[8]]+v[5:8]
            claims=[r for r in allrows if r['id']==row['reservationId']];assert len(claims)==1 and claims[0]['requestedMemoryBytes']==row['configuredMemoryBytes'];covered+=row['configuredMemoryBytes']
        held=sum(r['requestedMemoryBytes']for r in allrows);supplied=dict(measurement,runningConfiguredMemoryBytes=measurement['runningConfiguredMemoryBytes']-covered+held)
        # Own4GiB pending claim is deliberately kept AND request4GiB counted;
        # no special exclusion or inference is needed for this first fresh VM.
        plan=vm_workflow.admit_plan(supplied,requested_memory_bytes=4*1024**3,headroom_bytes=8*1024**3,reservations=())
        after=self.authority();assert after==current
        save(directory,'closing.json',{'schemaVersion':1,'state':'qualified','operationId':operation,'sourceClosing':True,'streamsComplete':True,'rootParentUnchanged':True,'ordinaryChildrenReaped':True,'full7Join':True,'all9GenerationFields':True,'bothLedgersExact':True,'historicalOutcomesChanged':False})
        self.epoch={'authority':current,'measurement':supplied,'plan':plan,'getterDirectory':str(getter_dir),'bridgeDirectory':str(directory),'getterSha256':result['getterSha256'],'bridgeSha256':digest(bridge),'operationId':operation};save(self.out,'post-normal-current-global-admission.private.json',self.epoch)
        for path,p in result['rawPins'].items():
            if path!=str(ROOT/'.rag_index/native-environments/reservations.json'):self.held.read(path,p['sha256'],max_bytes=262144)
        self.held.finish();self.held.final_identity_pass()
    def before_submit(self,prepared):
        assert self.prepared is prepared and self.epoch is not None;self.held.finish();self.held.final_identity_pass()
        assert self.authority()==self.epoch['authority']
        plan=vm_workflow.admit_plan(self.epoch['measurement'],requested_memory_bytes=4*1024**3,headroom_bytes=8*1024**3,reservations=())
        print(json.dumps({'phase':'before-one-vm-submit-current-global-admitted','deploymentId':DEPLOYMENT,'normalReservationId':prepared['reservation']['identity']['reservationId'],'requiredGiB':plan['requiredMemoryBytes']/1024**3,'freshnessClockShifted':False}),flush=True)
        save(self.out,'before-submit-current-global-admission.private.json',{'sourceClosing':True,'bothLedgerExact':True,'normalReservationId':prepared['reservation']['identity']['reservationId'],'globalPlan':plan,'freshnessClockShifted':False,'maxVmSubmissions':1})
    def close(self):self.held.close()


def adapted_canonical_start():
    source=inspect.getsource(deploy.start)
    before=source
    needle='    parent=_runtime_group(root,\'windows-vm-credentials\')\n'
    assert source.count(needle)==1;source=source.replace(needle,'    _GLOBAL.after_prepare(prepared,spec)\n'+needle)
    needle='    def submitting():\n';assert source.count(needle)==1;source=source.replace(needle,needle+'        _GLOBAL.before_submit(prepared)\n')
    namespace=dict(vars(deploy));exec(compile(source,'reviewed-raw62-canonical-start-with-extra-global-fences','exec'),namespace)
    return namespace,namespace['start'],before.encode(),source.encode()


def main():
    spec=json.loads((PLAN/'rw.draft-spec.json').read_text());setup=json.loads((PLAN/'rw.draft-setup.json').read_text());assert spec['deploymentId']==DEPLOYMENT
    out=BASE/('raw62-execution-'+str(uuid.uuid4()));out.mkdir(mode=0o700);namespace,start,before,after=adapted_canonical_start();save(out,'canonical-start.before.source',before);save(out,'reviewed-launch-adapter.source',after);save(out,'spec.json',spec);save(out,'setup.json',setup)
    # One source-owned local fence. Never delete it or rerun an uncertain start.
    fence=GlobalFence(out,spec);namespace['_GLOBAL']=fence
    save(BASE,'raw62-launch-once.json',{'deploymentId':DEPLOYMENT,'controllerSha256':digest(Path(__file__).read_bytes()),'out':str(out),'maxSubmissions':1,'oldInstancesPreserved':True})
    try:
        print(json.dumps({'phase':'one-original-launch-controller','deploymentId':DEPLOYMENT,'outputDirectory':str(out),'controllerSha256':digest(Path(__file__).read_bytes())}),flush=True)
        result=start(ROOT,spec,setup,str(ROOT/'.codex/arch-sudo.local'));fence.held.finish();fence.held.final_identity_pass();save(out,'result.private.json',result)
        print(json.dumps({'deploymentId':DEPLOYMENT,'state':result.get('state'),'reason':result.get('reason'),'out':str(out),'vmSubmissionMayHaveOccurred':True,'productReady':False}),flush=True)
    except BaseException as error:
        save(out,'unknown.json',{'deploymentId':DEPLOYMENT,'state':'original-observation-required','errorClass':type(error).__name__,'replayAllowed':False,'claimAndDisksPreserved':True});raise
    finally:fence.close()
if __name__=='__main__':main()
