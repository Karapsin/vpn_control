for path in (pathlib.Path('/home'),pathlib.Path('/home/kardinal'),root):need(stat.S_ISDIR(os.lstat(path).st_mode),'new_storage_ancestor')
need(os.lstat(root).st_uid==1000 and stat.S_IMODE(os.lstat(root).st_mode)==0o700,'new_storage_root_owner')
intent_raw,intent_pin=private(root/'intent.json',65536);intent=json.loads(intent_raw);need(intent['spec']==SPEC and intent['setup']==SETUP and intent['hostBootId']==BOOT and intent['rootIdentity']==structure(os.lstat(root)),'new_storage_original_intent')
