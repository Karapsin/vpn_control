modules={}
for filename,raw in SOURCES.items():
 name='owned_new_storage_'+filename.removesuffix('.py');module=types.ModuleType(name);module.__file__='<captured:'+filename+':'+hashlib.sha256(raw).hexdigest()+'>';sys.modules[name]=module;exec(compile(raw,module.__file__,'exec',dont_inherit=True),vars(module));modules[filename]=module
