)\\n                for sequence,(name,args) in enumerate(((\\\'qmp_capabilities\\\',None),(command,arguments))):\\n                    request={\\\'execute\\\':name,\\\'id\\\':sequence}\\n                    if args is not None:request[\\\'arguments\\\']=args\\n                    stream.write((json.dumps(request)+\\\'\\\\n\\\').encode())\\n                    for _ in range(32):\\n                        value=receive()\\n                        if value.get(\\\'id\\\')==sequence:break\\n                    else:raise ValueError(\\\'instance_qmp_response\\\')\\n                    require(\\\'return\\\' in value,\\\'instance_qmp_error\\\')\\n                process(row);require(os.lstat(root/\\\'qmp.sock\\\').st_ino==named.st_ino,\\\'instance_qmp_changed\\\')\\n                return value[\\\'return\\\']\\n            finally:client.close()\\n    def guest_state(pid):\\n            state={\\\'guestAgentReady\\\':False,\\\'ordinarySessionObserved\\\':False,\\\'osName\\\':None}\\n            client=socket.socket(socket.AF_UNIX);client.settimeout(1)\\n            try:\\n                owns(pid,root/\\\'qga.sock\\\',True);named=os.lstat(root/\\\'qga.sock\\\');client.connect(str(root/\\\'qga.sock\\\'))\\n                peer=struct.unpack(\\\'3i\\\',client.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))\\n                require(peer[:2]==(pid,os.geteuid()) and os.lstat(root/\\\'qga.sock\\\').st_ino==named.st_ino,\\\'instance_qga_peer\\\')\\n                stream=client.makefile(\\\'rwb\\\',buffering=0)\\n                nonce=int.from_bytes(os.urandom(8),\\\'big\\\')&((1<<63)-1)\\n                stream.write(b\\\'\\\\xff\\\'+(json.dumps({\\\'execute\\\':\\\'guest-sync-delimited\\\',\\\'arguments\\\':{\\\'id\\\':nonce}})+\\\'\\\\n\\\').encode())\\n                def receive():\\n                    line=stream.readline(65537);require(0<len(line)<=65536,\\\'instance_qga_bound\\\')\\n                    return json.loads(line.lstrip(b\\\'\\\\xff\\\'))\\n                # The flush sentinel can itself produce an error; stale complete\\n                # replies and partial JSON may also precede the real response.\\n                # QGA requires ignoring all input until a delimited matching nonce.\\n                deadline=time.monotonic()+3;consumed=0\\n                for _ in range(32):\\n                    remaining=deadline-time.monotonic();require(remaining>0,\\\'instance_qga_sync\\\')\\n                    client.settimeout(min(1,remaining));line=stream.readline(65537)\\n                    consumed+=len(line);require(0<len(line)<=65536 and consumed<=262144,\\\'instance_qga_bound\\\')\\n                    marker=line.rfind(b\\\'\\\\xff\\\')\\n                    if marker<0:continue\\n                    try:reply=json.loads(line[marker+1:])\\n                    except (ValueError,UnicodeError):continue\\n                    if type(reply)is dict and type(reply.get(\\\'return\\\'))is int and reply[\\\'return\\\']==nonce:break\\n                else:raise ValueError(\\\'instance_qga_sync\\\')\\n                client.settimeout(1)\\n                def query(command):\\n                    stream.write((json.dumps({\\\'execute\\\':command})+\\\'\\\\n\\\').encode());response=receive()\\n                    require(\\\'return\\\' in response,\\\'instance_qga_query\\\');return response[\\\'return\\\']\\n                query(\\\'guest-ping\\\');state[\\\'guestAgentReady\\\']=True\\n                osinfo=query(\\\'guest-get-osinfo\\\');name=osinfo.get(\\\'pretty-name\\\') or osinfo.get(\\\'name\\\')\\n                if type(name)is str and 0<len(name)<=256 and not any(ord(c)<32 for c in name):state[\\\'osName\\\']=name\\n                try:\\n                    users=query(\\\'guest-get-users\\\')\\n                    if type(users)is list and len(users)<=128:\\n                        state[\\\'ordinarySessionObserved\\\']=any(type(u)is dict and type(u.get(\\\'user\\\'))is str and u[\\\'user\\\'].rsplit(\\\'\\\\\\\\\\\',1)[-1].casefold()==SETUP[\\\'user\\\'].casefold() for u in users)\\n                except (OSError,ValueError):pass\\n                require(os.lstat(root/\\\'qga.sock\\\').st_ino==named.st_ino,\\\'instance_qga_changed\\\')\\n            except (OSError,ValueError,KeyError,TypeError):\\n                state={\\\'guestAgentReady\\\':False,\\\'ordinarySessionObserved\\\':False,\\\'osName\\\':None}\\n            finally:client.close()\\n            return state\\n    def instance_intent():\\n            private(root,True);intent=read(\\\'intent.json\\\')\\n            require(type(intent)is dict and set(intent)=={\\\'schemaVersion\\\',\\\'spec\\\',\\\'setup\\\',\\\'hostBootId\\\',\\\'rootIdentity\\\',\\\'assetIdentities\\\'} and type(intent[\\\'schemaVersion\\\'])is int and intent[\\\'schemaVersion\\\']==1,\\\'instance_intent_fields\\\')\\n            require(intent[\\\'spec\\\']==SPEC and intent[\\\'setup\\\']==SETUP and intent[\\\'hostBootId\\\']==CONTEXT[\\\'hostBootId\\\'] and intent[\\\'rootIdentity\\\']==list(structure(os.lstat(root))),\\\'instance_intent\\\')\\n            require(type(intent[\\\'assetIdentities\\\'])is dict and set(intent[\\\'assetIdentities\\\'])=={\\\'firmwareCode\\\',\\\'installer\\\',\\\'drivers\\\'},\\\'instance_asset_receipt\\\')\\n            return intent\\n    def observed():\\n            intent=instance_intent()\\n            q=read(\\\'qemu-started.json\\\');t=read(\\\'swtpm-started.json\\\');pid=process(q);tpid=process(t)\\n            mutable=read(\\\'mutable-artifacts.json\\\')\\n            require(type(mutable)is dict and set(mutable)=={\\\'disk.qcow2\\\',\\\'uefi-vars.fd\\\'},\\\'instance_mutable_receipt\\\')\\n            for name,identity in mutable.items():\\n                require(type(identity)is list and len(identity)==5 and list(structure(private(root/name)))==identity,\\\'instance_mutable_changed\\\')\\n                owns(pid,root/name)\\n            owns(pid,root/\\\'qmp.sock\\\',True);owns(tpid,root/\\\'swtpm.sock\\\',True)\\n            state=qmp(\\\'query-status\\\');sets=qmp(\\\'query-fdsets\\\')\\n            require(type(sets)is list,\\\'instance_asset_descriptors\\\')\\n            for name,expected in intent[\\\'assetIdentities\\\'].items():\\n                require(type(expected)is dict and set(expected)=={\\\'set\\\',\\\'generation\\\'} and type(expected[\\\'set\\\'])is int and\\n                        expected[\\\'set\\\']==(\\\'firmwareCode\\\',\\\'installer\\\',\\\'drivers\\\').index(name)+1 and type(expected[\\\'generation\\\'])is list and\\n                        len(expected[\\\'generation\\\'])==9 and all(type(x)is int and x>=0 for x in expected[\\\'generation\\\']) and\\n                        expected[\\\'generation\\\'][6]==SPEC[\\\'assets\\\'][name][\\\'bytes\\\'],\\\'instance_asset_receipt\\\')\\n                selected=[s for s in sets if s.get(\\\'fdset-id\\\')==expected[\\\'set\\\']]\\n                require(len(selected)==1 and len(selected[0].get(\\\'fds\\\',[]))==1,\\\'instance_asset_descriptors\\\')\\n                item=selected[0][\\\'fds\\\'][0];require(item.get(\\\'opaque\\\')==\\\'asset:\\\'+name and type(item.get(\\\'fd\\\'))is int and item[\\\'fd\\\']>2,\\\'instance_asset_descriptors\\\')\\n                require(list(generation(os.stat(\\\'/proc/\\\'+str(pid)+\\\'/fd/\\\'+str(item[\\\'fd\\\']))))==expected[\\\'generation\\\'],\\\'instance_asset_changed\\\')\\n            guest=guest_state(pid);process(q);process(t);closing()\\n            return {\\\'qemu\\\':{\\\'pid\\\':q[\\\'pid\\\'],\\\'startTicks\\\':q[\\\'startTicks\\\']},\\\'swtpm\\\':{\\\'pid\\\':t[\\\'pid\\\'],\\\'startTicks\\\':t[\\\'startTicks\\\']},\\\'qemuStatus\\\':state.get(\\\'status\\\'),**guest,\\\'productReady\\\':False}\\n    import base64,fcntl\\n    from xml.etree import ElementTree as ET\\n    global wire,partial_wire,QGA_PEER_PID,QGA_GUARD\\n    lock=None;connection=None;domain=None;manager=None;socket_pin=None\\n    def epoch():\\n        require(pathlib.Path(\\\'/proc/sys/kernel/random/boot_id\\\').read_text().strip()==CONTEXT[\\\'hostBootId\\\'],\\\'instance_host_epoch\\\')\\n        instance_intent();closing()\\n    def actor():\\n        if PROVIDER==\\\'raw-qemu-windows\\\':\\n            row=read(\\\'qemu-started.json\\\')\\n            try:process(row)\\n            except FileNotFoundError:return None\\n            except ValueError as error:\\n                if str(error)==\\\'instance_process_dead\\\':return None\\n                raise\\n            process(read(\\\'swtpm-started.json\\\'));return row\\n        candidates=[]\\n        for path in pathlib.Path(\\\'/proc\\\').iterdir():\\n            if not path.name.isdigit():continue\\n            try:\\n                if path.stat().st_uid!=os.geteuid():continue\\n                raw=(path/\\\'cmdline\\\').read_bytes();words=raw.split(b\\\'\\\\0\\\')\\n                if b\\\'-uuid\\\' not in words:continue\\n                index=words.index(b\\\'-uuid\\\')\\n                if index+1>=len(words) or words[index+1].decode(\\\'ascii\\\',\\\'ignore\\\')!=SPEC[\\\'deploymentId\\\']:continue\\n                pid=int(path.name);start=birth(pid)\\n                row={\\\'pid\\\':pid,\\\'startTicks\\\':start,\\\'argv\\\':[os.fsdecode(v) for v in words if v],\\n                     \\\'commandSha256\\\':hashlib.sha256(raw).hexdigest(),\\\'executableGeneration\\\':list(generation(os.stat(path/\\\'exe\\\')))}\\n                process(row);candidates.append(row)\\n            except FileNotFoundError:continue\\n        require(len(candidates)==1,\\\'instance_libvirt_actor_unknown\\\');row=candidates[0]\\n        owns(row[\\\'pid\\\'],root/\\\'disk.qcow2\\\');owns(row[\\\'pid\\\'],root/\\\'uefi-vars.fd\\\');return row\\n    def vm_guard():\\n        epoch()\\n        if PROVIDER==\\\'libvirt-windows\\\':\\n            require(connection.getURI()==URI and domain.UUIDString()==SPEC[\\\'deploymentId\\\'] and domain.name()==DOMAIN,\\\'instance_libvirt_identity\\\')\\n            xml=domain.XMLDesc(libvirt.VIR_DOMAIN_XML_INACTIVE).encode()\\n            require(hashlib.sha256(xml).hexdigest()==XML_SHA,\\\'instance_libvirt_xml_changed\\\')\\n            tree=ET.fromstring(xml);sources=tree.findall("devices/disk[@device=\\\'disk\\\']/source")\\n            require(len(sources)==1 and sources[0].get(\\\'file\\\')==str(root/\\\'disk.qcow2\\\') and tree.findtext(\\\'os/nvram\\\')==str(root/\\\'uefi-vars.fd\\\'),\\\'instance_libvirt_artifacts\\\')\\n            process(manager)\\n            actual=os.lstat(SOCKET_PATH)\\n            require(stat.S_ISSOCK(actual.st_mode) and actual.st_uid==os.geteuid() and not actual.st_mode&0o077 and structure(actual)==socket_pin,\\\'instance_libvirt_socket_changed\\\')\\n        if current_actor is not None:\\n            process(current_actor)\\n            if PROVIDER==\\\'raw-qemu-windows\\\':\\n                owns(current_actor[\\\'pid\\\'],root/\\\'qmp.sock\\\',True)\\n                mutable=read(\\\'mutable-artifacts.json\\\')\\n                require(set(mutable)=={\\\'disk.qcow2\\\',\\\'uefi-vars.fd\\\'},\\\'instance_mutable_receipt\\\')\\n                for name,pin in mutable.items():\\n                    require(pin==list(structure(private(root/name))),\\\'instance_mutable_changed\\\')\\n                    owns(current_actor[\\\'pid\\\'],root/name)\\n                tpm=read(\\\'swtpm-started.json\\\');process(tpm);owns(tpm[\\\'pid\\\'],root/\\\'swtpm.sock\\\',True)\\n    def monitor(command,arguments=None):\\n        vm_guard()\\n        if PROVIDER==\\\'raw-qemu-windows\\\':return qmp(command,arguments)\\n        request={\\\'execute\\\':command}\\n        if arguments is not None:request[\\\'arguments\\\']=arguments\\n        raw=libvirt_qemu.qemuMonitorCommand(domain,json.dumps(request,separators=(\\\',\\\',\\\':\\\')),0)\\n        require(type(raw)is str and 0<len(raw.encode())<=65536,\\\'instance_monitor_reply\\\')\\n        value=json.loads(raw);require(type(value)is dict and \\\'return\\\'in value and \\\'error\\\'not in value,\\\'instance_monitor_reply\\\')\\n        vm_guard();return value[\\\'return\\\']\\n    def machine_state():\\n        vm_guard()\\n        if PROVIDER==\\\'raw-qemu-windows\\\':\\n            if current_actor is None:return \\\'stopped\\\'\\n            require(qmp(\\\'query-uuid\\\')[\\\'UUID\\\'].lower()==SPEC[\\\'deploymentId\\\'],\\\'instance_machine\\\')\\n            return qmp(\\\'query-status\\\')[\\\'status\\\']\\n        value=domain.state()[0]\\n        return {1:\\\'running\\\',2:\\\'booting\\\',3:\\\'paused\\\',4:\\\'shutdown\\\',5:\\\'stopped\\\',6:\\\'unhealthy\\\',7:\\\'suspended\\\'}.get(value,\\\'unknown\\\')\\n    def rpc(command,arguments):\\n        raise ValueError(\\\'instance_coverage_guest_rpc_forbidden\\\')\\n        vm_guard()\\n        if PROVIDER==\\\'raw-qemu-windows\\\':\\n            global QGA_PEER_PID,QGA_GUARD\\n            QGA_PEER_PID=current_actor[\\\'pid\\\'];owns(QGA_PEER_PID,root/\\\'qga.sock\\\',True);named=os.lstat(root/\\\'qga.sock\\\')\\n            def guarded():\\n                vm_guard();require(os.lstat(root/\\\'qga.sock\\\').st_ino==named.st_ino,\\\'instance_qga_changed\\\')\\n            QGA_GUARD=guarded\\n            value=call(str(root/\\\'qga.sock\\\'),command,arguments,_deadline=time.monotonic()+8)\\n        else:\\n            request=json.dumps({\\\'execute\\\':command,\\\'arguments\\\':arguments},separators=(\\\',\\\',\\\':\\\'))\\n            require(len(request.encode())<=262144,\\\'instance_guest_request_bound\\\')\\n            raw=libvirt_qemu.qemuAgentCommand(domain,request,8,0)\\n            require(type(raw)is str and 0<len(raw.encode())<=262144,\\\'instance_guest_reply_bound\\\')\\n            answer=json.loads(raw);require(type(answer)is dict and \\\'return\\\'in answer and \\\'error\\\'not in answer,\\\'instance_guest_reply\\\')\\n            value=answer[\\\'return\\\']\\n        vm_guard();return value\\n    def read_guest_terminal(name):\\n        # QGA\\\'s bounded base64 envelope is larger than ordinary metadata.\\n        # Hold the exact private file generation across the entire read.\\n        path=root/name;named=private(path)\\n        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)\\n        try:\\n            info=os.fstat(fd)\\n            require(generation(info)==generation(named),\\\'instance_receipt_changed\\\')\\n            require(0<info.st_size<=262144,\\\'instance_guest_reply_bound\\\')\\n            raw=os.read(fd,262145)\\n            require(len(raw)==info.st_size and generation(os.fstat(fd))==generation(info)\\n                    and generation(os.lstat(path))==generation(info),\\\'instance_receipt_changed\\\')\\n            return json.loads(raw)\\n        finally:os.close(fd)\\n    def script(label,source,original=None):\\n        operation=OPERATION if original is None else original[\\\'operationId\\\']\\n        source_sha=hashlib.sha256(source.encode()).hexdigest()if original is None else original[\\\'sourceSha256\\\']\\n        require(re.fullmatch(r\\\'[a-z][a-z0-9-]{0,79}\\\',label)is not None,\\\'instance_guest_label\\\')\\n        prefix=\\\'readiness-\\\'+operation+\\\'-\\\'+label\\n        intent_name=prefix+\\\'.intent.json\\\';ack_name=prefix+\\\'.ack.json\\\';terminal_name=prefix+\\\'.terminal.json\\\'\\n        # These fixed public programs never receive protected stdin. Login and\\n        # unknown extension modes cannot archive unvalidated controller output.\\n        retain_public=MODE in {\\\'observe\\\',\\\'idle-inventory\\\',\\\'reboot\\\',\\\'resume\\\',\\\'wake_display\\\',\\n                              \\\'lease-acquire\\\',\\\'lease-status\\\',\\\'lease-cancel\\\',\\\'lease-enroll\\\',\\\'lease-enrollment-status\\\',\\n                              \\\'job-enroll\\\',\\\'job-namespace-status\\\',\\\'job-start\\\',\\\'job-status\\\',\\\'job-inventory\\\'}\\n        observed_name=prefix+\\\'.observed-terminal.json\\\'\\n        if not os.path.lexists(root/intent_name):\\n            if original is not None:return {\\\'state\\\':\\\'unsubmitted\\\',\\\'reason\\\':\\\'original_admission_absent\\\',\\\'replayAllowed\\\':False}\\n            # New controllers correlate the retained result to this exact request.\\n            # A QGA PID alone is reusable after an agent/guest restart.\\n            lines=source.rstrip().splitlines();output=[i for i,line in enumerate(lines)if line.lstrip().startswith(\\\'[Console]::WriteLine(\\\')]\\n            require(output==[len(lines)-1]and lines[-1].startswith(\\\'[Console]::WriteLine(\\\')and lines[-1].endswith(\\\')\\\'),\\\'instance_guest_output_program\\\')\\n            lines[-1]=\\\'$VcRaw=\\\'+lines[-1][len(\\\'[Console]::WriteLine(\\\'):-1]\\n            frame={\\\'schemaVersion\\\':1,\\\'operationId\\\':operation,\\\'label\\\':label,\\\'sourceSha256\\\':source_sha}\\n            framed=\\\'\\\\n\\\'.join(lines)+"\\\\n$VcBody=($VcRaw|ConvertFrom-Json)\\\\n$VcOwner=Get-Process -Id $PID\\\\n"\\n            framed+="$VcFrame=(\\\'"+json.dumps(frame,separators=(\\\',\\\',\\\':\\\'))+"\\\'|ConvertFrom-Json)\\\\n"\\n            framed+="$VcFrame|Add-Member -NotePropertyName owner -NotePropertyValue (@{pid=$PID;birth=$VcOwner.StartTime.ToFileTimeUtc().ToString()})\\\\n$VcFrame|Add-Member -NotePropertyName result -NotePropertyValue $VcBody\\\\n[Console]::WriteLine(($VcFrame|ConvertTo-Json -Depth 24 -Compress))\\\\n"\\n            save(intent_name,{\\\'operationId\\\':operation,\\\'label\\\':label,\\\'sourceSha256\\\':source_sha,\\n                              \\\'hostBoot\\\':CONTEXT[\\\'hostBootId\\\'],\\\'actor\\\':current_actor,\\\'replayAllowed\\\':False,\\\'controllerIdentity\\\':frame})\\n            vm_guard()\\n            ack=rpc(\\\'guest-exec\\\',{\\\'path\\\':\\\'powershell.exe\\\',\\\'arg\\\':[\\\'-NoProfile\\\',\\\'-NonInteractive\\\',\\\'-ExecutionPolicy\\\',\\\'Bypass\\\',\\\'-Command\\\',"$s=[Console]::In.ReadToEnd(); & ([ScriptBlock]::Create($s))"],\\n                                  \\\'input-data\\\':base64.b64encode(framed.encode()).decode(),\\\'capture-output\\\':True})\\n            require(type(ack)is dict and set(ack)=={\\\'pid\\\'} and type(ack[\\\'pid\\\'])is int and ack[\\\'pid\\\']>0,\\\'instance_guest_exec_ack\\\')\\n            save(ack_name,{\\\'operationId\\\':operation,\\\'label\\\':label,\\\'ack\\\':ack,\\\'replayAllowed\\\':False})\\n        intent=read(intent_name)\\n        retain_public=retain_public and type(intent.get(\\\'controllerIdentity\\\'))is dict\\n        require(intent[\\\'operationId\\\']==operation and intent[\\\'label\\\']==label and intent[\\\'sourceSha256\\\']==source_sha\\n                and intent[\\\'hostBoot\\\']==CONTEXT[\\\'hostBootId\\\'] and intent[\\\'actor\\\']==current_actor,\\\'instance_original_guest_request\\\')\\n        # Lost admission acknowledgement is never permission to guest-exec again.\\n        require(os.path.lexists(root/ack_name),\\\'instance_original_guest_ack_unknown\\\')\\n        ack=read(ack_name);require(ack[\\\'operationId\\\']==operation and ack[\\\'label\\\']==label and ack[\\\'replayAllowed\\\']is False,\\\'instance_guest_exec_ack\\\')\\n        if os.path.lexists(root/terminal_name):terminal=read_guest_terminal(terminal_name)\\n        elif retain_public and os.path.lexists(root/observed_name):terminal=read_guest_terminal(observed_name)\\n        else:\\n            require(type(intent.get(\\\'controllerIdentity\\\'))is dict,\\\'instance_legacy_guest_job_unresolved\\\')\\n            deadline=time.monotonic()+20\\n            while True:\\n                terminal=rpc(\\\'guest-exec-status\\\',ack[\\\'ack\\\'])\\n                if terminal.get(\\\'exited\\\')is True:break\\n                require(time.monotonic()<deadline,\\\'instance_original_guest_pending\\\');time.sleep(.2)\\n            # Validate correlation before admitting the terminal receipt.\\n        require(type(terminal)is dict and len((json.dumps(terminal