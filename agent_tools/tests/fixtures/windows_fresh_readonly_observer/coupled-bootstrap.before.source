PYTHON_PIN=[66306, 1227482, 33261, 0, 0, 1, 14424, 1786348016000000000, 1786804189213449734]
PYTHON_SHA='d78f9cf7178ecff09963551399855543c297f37ac207e626228bfe43cb26a70c'
EXPECTED_BOOT='25515f23-b966-4c3a-ae63-d38452375578'
CHILD_BOOTSTRAP="import hashlib,json,os,sys\ndef principal():return [os.getuid(),os.geteuid(),os.getgid(),os.getegid(),sorted(os.getgroups())]\nexpected=[1000,1000,1000,1000,[1000]]\nif principal()!=expected:raise ValueError('ordinary_coverage_principal_changed')\nraw=sys.stdin.buffer.read(114728)\nif len(raw)!=114727 or hashlib.sha256(raw).hexdigest()!='a2f99c1972d9f72a1641c69b0df5628de513ca18037aecb0e97fd796634e8268':raise ValueError('ordinary_coverage_source_changed')\nnamespace={'__name__':'source_held_ordinary_windows_coverage'}\nexec(compile(raw,'source-held-ordinary-windows-coverage','exec'),namespace)\ncoverage=namespace['get_windows_allocation_coverage']()\nif principal()!=expected:raise ValueError('ordinary_coverage_principal_changed')\nprint(json.dumps({'principal':principal(),'coverage':coverage},sort_keys=True,separators=(',',':')),flush=True)\n"
ORDINARY_ENV={'PATH': '/usr/bin:/bin', 'HOME': '/home/kardinal', 'USER': 'kardinal', 'LOGNAME': 'kardinal', 'LANG': 'C', 'LC_ALL': 'C'}
BRIDGE_RECORDS=[]
def drop_identity():
    os.setgroups([1000])
    os.setgid(1000)
    os.setuid(1000)

def _bridge_pin(info):
 return [info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid,info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns]
def _bridge_principal():return [os.getuid(),os.geteuid(),os.getgid(),os.getegid(),sorted(os.getgroups())]
def get_windows_allocation_coverage():
 if not sys.platform.startswith('linux') or _bridge_principal()[:4]!=[0,0,0,0]:raise ValueError('ordinary_bridge_linux_root_required')
 if pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()!=EXPECTED_BOOT:raise ValueError('ordinary_bridge_host_boot_changed')
 parent=_bridge_principal();path=pathlib.Path(PYTHON_PATH);fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
 try:
  if _bridge_pin(os.fstat(fd))!=PYTHON_PIN or _bridge_pin(path.lstat())!=PYTHON_PIN:raise ValueError('ordinary_bridge_python_changed')
  raw=os.read(fd,PYTHON_PIN[6]+1)
  if len(raw)!=PYTHON_PIN[6] or hashlib.sha256(raw).hexdigest()!=PYTHON_SHA or _bridge_pin(os.fstat(fd))!=PYTHON_PIN or _bridge_pin(path.lstat())!=PYTHON_PIN:raise ValueError('ordinary_bridge_python_changed')
  try:
   result=subprocess.run([PYTHON_PATH,'-I','-B','-c',CHILD_BOOTSTRAP],executable='/proc/self/fd/'+str(fd),pass_fds=(fd,),close_fds=True,input=GETTER_SOURCE,preexec_fn=drop_identity,env=ORDINARY_ENV,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=20,check=False)
  except subprocess.TimeoutExpired as error:
   output=error.stdout or b'';errors=error.stderr or b''
   BRIDGE_RECORDS.append({'kind':'ordinary-windows-coverage-child','complete':False,'sourceSha256':GETTER_SHA,'stdoutBase64':base64.b64encode(output).decode(),'stderrBase64':base64.b64encode(errors).decode(),'stdoutSha256':hashlib.sha256(output).hexdigest(),'stderrSha256':hashlib.sha256(errors).hexdigest(),'parentPrincipal':parent,'parentClosingPrincipal':_bridge_principal(),'observedAtNs':time.time_ns(),'vmMutation':False,'claimMutation':False})
   raise ValueError('ordinary_bridge_observation_timeout')from None
  record={'kind':'ordinary-windows-coverage-child','complete':True,'returncode':result.returncode,'sourceSha256':GETTER_SHA,'pythonSha256':PYTHON_SHA,'stdoutBase64':base64.b64encode(result.stdout).decode(),'stderrBase64':base64.b64encode(result.stderr).decode(),'stdoutSha256':hashlib.sha256(result.stdout).hexdigest(),'stderrSha256':hashlib.sha256(result.stderr).hexdigest(),'parentPrincipal':parent,'parentClosingPrincipal':_bridge_principal(),'observedAtNs':time.time_ns(),'vmMutation':False,'claimMutation':False}
  BRIDGE_RECORDS.append(record)
  if _bridge_principal()!=parent or _bridge_pin(os.fstat(fd))!=PYTHON_PIN or _bridge_pin(path.lstat())!=PYTHON_PIN:raise ValueError('ordinary_bridge_parent_or_python_changed')
  if result.returncode!=0 or result.stderr or not 0<len(result.stdout)<=262144:raise ValueError('ordinary_bridge_observation_unqualified')
  def unique(pairs):
   value={}
   for name,item in pairs:
    if name in value:raise ValueError('ordinary_bridge_duplicate_reply')
    value[name]=item
   return value
  value=json.loads(result.stdout,object_pairs_hook=unique)
  if type(value)is not dict or set(value)!={'principal','coverage'} or value['principal']!=[1000,1000,1000,1000,[1000]]:raise ValueError('ordinary_bridge_child_identity_changed')
  coverage=value['coverage']
  if type(coverage)is not dict or coverage.get('state')!='qualified' or coverage.get('hostBootId')!=EXPECTED_BOOT or any(row.get('uid')!=1000 for row in coverage.get('rows',[])):raise ValueError('ordinary_bridge_coverage_unqualified')
  record['childPrincipal']=value['principal']
  return coverage
 finally:os.close(fd)
