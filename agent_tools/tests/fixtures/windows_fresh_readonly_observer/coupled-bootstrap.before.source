ut_unavailable")\n        value = json.loads(text)\n        row = value.get("allocationCoverage")\n        if value.get("state") != "observed" or type(row) is not dict or row.get("state") != "qualified":\n            raise ValueError("windows_allocation_original_unavailable")\n        expected = _COVERAGE_EXPECTED[index]\n        if any(row.get(key) != expected[key] for key in\n               ("reservationId", "configuredMemoryBytes", "machine", "provider", "root", "hostBootId")):\n            raise ValueError("windows_allocation_identity_changed")\n        if any(row.get(key) is not False for key in ("guestRpc", "vmMutation", "claimMutation")):\n            raise ValueError("windows_allocation_side_effect_boundary")\n        if boot is not None and boot != row["hostBootId"]:\n            raise ValueError("windows_allocation_host_epoch_changed")\n        boot = row["hostBootId"]\n        rows.append(row)\n    if len(rows) != 2 or len({row["pid"] for row in rows}) != 2 or len({row["reservationId"] for row in rows}) != 2:\n        raise ValueError("windows_allocation_ambiguous")\n    return {"schemaVersion": 1, "state": "qualified", "hostBootId": boot, "rows": rows,\n            "sourcePins": dict(_COVERAGE_SOURCE_PINS), "observedAtUnixMs": time.time_ns() // 1000000,\n            "guestRpc": False, "vmMutation": False, "claimMutation": False}\n'
GETTER_SHA='b08a63b11d765e8f9bc1ca67d1f9fe64b3d1c2e4e91b7f411f312af4c5273b27'
