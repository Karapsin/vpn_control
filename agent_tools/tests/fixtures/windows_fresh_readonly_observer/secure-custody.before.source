from pathlib import Path
from contextlib import closing
import hashlib,inspect,json,os,sys
ROOT=Path('/Users/karapsin_de/projects/vpn_control_tool_recovery');sys.path.insert(0,str(ROOT))
from agent_tools import readiness_windows as windows,windows_vm_deploy as deploy,readiness_windows_managed_admission as admission
from agent_tools.native_review_source_closure import _Held
from agent_tools.private_credential_file import SecretFile
OUT=Path(__file__).parent;OP='d546cbd2-b89a-410f-8154-0910ede3befb';DEPLOYMENT='62b489bc-81d5-4d3a-b87a-94fa2b90c57d'
def save(name,value):windows._save(OUT/name,value)
review=json.loads((OUT/'custody-review.json').read_text())
if os.path.lexists(ROOT/'.rag_index/windows-vm-deploy-secure'/(DEPLOYMENT+'.intent.json')):raise ValueError('fresh_secure_original_exists_observe_only')
class QualifiedSecretFile(SecretFile):
 def __init__(self,path):
  expected=review['credentialsMetadataOnly'].get(path)
  if expected is None or list(admission.credential_metadata(path))!=expected:raise ValueError('fresh_secure_credential_generation_changed')
  super().__init__(path)
  if list(self.pin)!=expected:self.close();raise ValueError('fresh_secure_credential_generation_changed')
with closing(_Held())as held:
 for path,pin in review['sourcePins'].items():held.read(path,pin['sha256'],max_bytes=1048576)
 for path in (Path(__file__),OUT/'custody-review.json',Path(review['setupProof']['path']),Path(review['originalIntentPath'])):held.read(str(path),hashlib.sha256(path.read_bytes()).hexdigest(),max_bytes=1048576)
 for path,pin in review['credentialsMetadataOnly'].items():
  if list(admission.credential_metadata(path))!=pin:raise ValueError('fresh_secure_credential_generation_changed')
 actual=inspect.getsource(deploy.secure);assert hashlib.sha256(actual.encode()).hexdigest()==review['canonicalSecureFunctionSha256']
 namespace=dict(vars(deploy));namespace['SecretFile']=QualifiedSecretFile;exec(compile(actual,'actual-canonical-secure-with-stricter-credential-pin','exec',dont_inherit=True),namespace)
 save('dispatch.intent.json',{'operationId':OP,'deploymentId':DEPLOYMENT,'privateInput':True,'expectedAdministratorSid':review['recipient']['administrator']['sid'],'pid':os.getpid(),'replayAllowed':False});held.finish();held.final_identity_pass()
 print(json.dumps({'operationId':OP,'pid':os.getpid(),'out':str(OUT),'phase':'accepted-one-original-secure'}),flush=True)
 result=namespace['secure'](ROOT,DEPLOYMENT,OP,review['hostSudoInput']);save('result.private.json',result)
 for path,pin in review['credentialsMetadataOnly'].items():
  if list(admission.credential_metadata(path))!=pin:raise ValueError('fresh_secure_credential_generation_changed')
 held.finish();held.final_identity_pass();save('closing.json',{'operationId':OP,'state':'original-secure-closed','sourceClosing':True,'credentialGenerationUnchanged':True,'resultState':result['state'],'credentialBytesWrittenByController':False,'productAcceptance':False})
 print(json.dumps({'operationId':OP,'state':result['state'],'setupSecured':result.get('setupSecured'),'out':str(OUT)}),flush=True)
