visual-tests/baselines/**/*.png filter=lfs diff=lfs merge=lfs -text

# These reviewed inputs are hashed byte-for-byte into native helper manifests.
/desktopApp/native/windows/import-policy.json text eol=lf
/desktopApp/native/windows/InstallHelper/loader.manifest text eol=lf
/desktopApp/native/windows/VpnBroker/loader.manifest text eol=lf

# Tool loaders and their preserved Python beforeimages authenticate exact bytes.
# Keep Git blobs intact when Windows enables automatic line-ending conversion.
/agent_tools/**/*.py -text
/agent_tools/ssh_source_file_gateway.source -text

