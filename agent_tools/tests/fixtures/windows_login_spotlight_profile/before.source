import os,re,hashlib
def _rename_create_only(directory_fd, source, destination):
    """Same-directory atomic publication, with no overwrite/link fallback.

    Linux renameat2(2) RENAME_NOREPLACE and Darwin sys/stdio.h RENAME_EXCL
    both reject an existing destination, including unsafe files and symlinks.
    Unsupported coordinators/filesystems refuse instead of weakening this.
    """
    import ctypes
    import errno
    import sys
    library = ctypes.CDLL(None, use_errno=True)
    if sys.platform == "darwin":
        function = getattr(library, "renameatx_np", None); flag = 4
    elif sys.platform.startswith("linux"):
        function = getattr(library, "renameat2", None); flag = 1
    else:
        function = None; flag = 0
    if function is None:
        raise ValueError("atomic ownership lock publication unavailable")
    function.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    function.restype = ctypes.c_int
    if function(directory_fd, os.fsencode(source), directory_fd, os.fsencode(destination), flag):
        code = ctypes.get_errno()
        if code == errno.EEXIST:
            raise FileExistsError(code, "ownership lock already exists")
        raise OSError(code, "atomic ownership lock publication failed")

def validate_session(value, expected_sid, user, expected_machine):
    """Refuse unrecognized WTS identity instead of interpreting zeroes as lock."""
    def need(condition, reason):
        if not condition:
            raise ValueError(reason)
    need(type(value) is dict and set(value) == {'machine','boot','console','infoLevel','session','tokenSid','expectedSid','ordinary','sessions','explorers'}, 'windows_session_fields')
    need(type(expected_sid) is str and re.fullmatch('S-1-5-21-[0-9]+-[0-9]+-[0-9]+-[0-9]+',expected_sid) is not None, 'windows_expected_sid')
    need(value['expectedSid'] == expected_sid and value['ordinary'] is True, 'windows_account_mismatch')
    need(type(value['boot']) is str and re.fullmatch('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z',value['boot']) is not None, 'windows_boot_unrecognized')
    need(type(value['machine']) is str and value['machine'].lower() == expected_machine, 'windows_machine_mismatch')
    session = value['session']
    need(type(value['console']) is int and 0 <= value['console'] < 2**32-1 and value['infoLevel'] == 1 and type(value['infoLevel']) is int, 'windows_session_unrecognized')
    need(type(session) is dict and set(session) == {'SessionId','State','Flags','Station','User','Domain','Logon','Connect','Disconnect','LastInput','Current','InBytes','OutBytes','InFrames','OutFrames','InCompressed','OutCompressed'}, 'windows_session_unrecognized')
    need(type(session['SessionId']) is int and session['SessionId'] == value['console'] and type(session['State']) is int and 0 <= session['State'] <= 9 and type(session['Flags']) is int and session['Flags'] in {0,1}, 'windows_session_unrecognized')
    need(session['Station'] == 'Console' and type(session['User']) is str and type(session['Domain']) is str, 'windows_session_unrecognized')
    need(type(session['Logon']) is int and session['Logon'] >= 0, 'windows_session_unrecognized')
    need(type(value['sessions']) is list and 1 <= len(value['sessions']) <= 128 and type(value['explorers']) is list and len(value['explorers']) <= 128, 'windows_session_unrecognized')
    for row in value['sessions']:
        need(type(row) is dict and set(row)=={'Id','Name','State'} and type(row['Id']) is int and type(row['Name']) is str and type(row['State']) is int, 'windows_session_unrecognized')
    for row in value['explorers']:
        need(type(row) is dict and set(row)=={'Id','SessionId'} and type(row['Id']) is int and row['Id']>0 and type(row['SessionId']) is int, 'windows_session_unrecognized')
    need(len(json.dumps(value)) <= 65536, 'windows_session_bound')
    if not session['User']:
        need(value['tokenSid'] is None, 'windows_session_unrecognized')
        state = 'signed_out'
    elif session['User'].casefold() != user.casefold() or value['tokenSid'] != expected_sid:
        state = 'wrong_account'
    elif session['State'] != 0:
        state = 'unknown'
    elif session['Flags'] == 0:
        state = 'locked'
    else:
        need(sum(row['SessionId']==value['console'] for row in value['explorers']) == 1, 'windows_desktop_shell_unrecognized')
        state = 'ready'
    return {'ordinary_session':state,'boot':value['boot'],'account':expected_sid,'session':str(value['console'])+':'+str(session['Logon']),
            'competingSessions':any(row['Id'] not in {0,value['console']} for row in value['sessions'])}

def ppm(raw):
    if type(raw)is not bytes or len(raw)>16*1024**2:raise ValueError('instance_login_screen_bound')
    parts=raw.split(b'\n',3)
    if len(parts)!=4 or parts[0]!=b'P6'or parts[2]!=b'255':raise ValueError('instance_login_screen_unrecognized')
    fields=parts[1].split()
    if len(fields)!=2 or any(not x.isdigit()for x in fields):raise ValueError('instance_login_screen_unrecognized')
    w,h=map(int,fields)
    if not 320<=w<=4096 or not 200<=h<=2160 or len(parts[3])!=w*h*3:raise ValueError('instance_login_screen_unrecognized')
    return w,h,parts[3]

def screen_gate(raw,profile):
    w,h,pixels=ppm(raw)
    if type(profile)is not dict or set(profile)!={'width','height','crops'}or (w,h)!=(profile['width'],profile['height'])or type(profile['crops'])is not list or not 1<=len(profile['crops'])<=8:raise ValueError('instance_login_screen_unrecognized')
    for row in profile['crops']:
        if type(row)is not dict or set(row)!={'rect','sha256'}or type(row['rect'])is not list or len(row['rect'])!=4 or any(type(v)is not int for v in row['rect'])or type(row['sha256'])is not str or re.fullmatch('[0-9a-f]{64}',row['sha256'])is None:raise ValueError('instance_login_screen_profile')
        x0,y0,x1,y1=row['rect']
        if not 0<=x0<x1<=w or not 0<=y0<y1<=h:raise ValueError('instance_login_screen_profile')
        crop=b''.join(pixels[(y*w+x0)*3:(y*w+x1)*3]for y in range(y0,y1))
        if hashlib.sha256(crop).hexdigest()!=row['sha256']:raise ValueError('instance_login_screen_unrecognized')
    return True


def _profile_known_screen(root,prefix,monitor,fence,profile):
 import os,stat,time
 def pin(s):return(s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
 path=root/(prefix+'-review-lockscreen.ppm');fence()
 if os.path.lexists(path):raise ValueError('instance_fixture_frame_exists')
 monitor('screendump',{'filename':str(path),'format':'ppm'});fence();fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
 try:
  info=os.fstat(fd)
  if not(stat.S_ISREG(info.st_mode)and info.st_uid==os.geteuid()and stat.S_IMODE(info.st_mode)==0o600 and info.st_nlink==1 and 32<=info.st_size<=16*1024**2 and pin(info)==pin(os.lstat(path))):raise ValueError('instance_fixture_frame_identity')
  raw=b''
  while len(raw)<=16*1024**2:
   chunk=os.read(fd,65536)
   if not chunk:break
   raw+=chunk
  if len(raw)!=info.st_size or pin(os.fstat(fd))!=pin(info)or pin(os.lstat(path))!=pin(info):raise ValueError('instance_fixture_frame_identity')
  fence();screen_gate(raw,profile);fence()
 finally:os.close(fd)

def _fixture_profile(root,read,monitor,guard,script,result,lock,birth):
 import os,time,json,uuid,stat,hashlib,base64,struct
 def need(value,reason):
  if not value:raise ValueError(reason)
 def gen(info):return [info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid,info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns]
 prefix='fixture-profile-'+OPERATION
 lock_generation=gen(os.fstat(lock));owner={'pid':os.getpid(),'startTicks':birth(os.getpid())}
 need(type(owner['pid'])is int and owner['pid']>0 and type(owner['startTicks'])is int and owner['startTicks']>0,'instance_fixture_owner_changed')
 def fence():
  guard();info=os.fstat(lock)
  need(gen(info)==lock_generation==gen(os.lstat(root/'intent.json'))and stat.S_ISREG(info.st_mode)and info.st_uid==os.geteuid()and stat.S_IMODE(info.st_mode)==0o600 and info.st_nlink==1,'instance_fixture_lock_changed')
  need(owner=={'pid':os.getpid(),'startTicks':birth(os.getpid())},'instance_fixture_owner_changed')
 def retain(suffix,value):
  fence();directory=os.open(root,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW);temporary='.'+prefix+uuid.uuid4().hex+'.tmp'
  try:
   fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=directory)
   with os.fdopen(fd,'wb')as stream:stream.write(json.dumps(value,sort_keys=True,separators=(',',':')).encode());stream.flush();os.fsync(stream.fileno())
   fence();_rename_create_only(directory,temporary,prefix+suffix);os.fsync(directory);fence()
  finally:
   try:os.unlink(temporary,dir_fd=directory)
   except FileNotFoundError:pass
   os.close(directory)
 def exists(suffix):return os.path.lexists(root/(prefix+suffix))
 def session():
  value=script('fixture-lock-session-'+os.urandom(6).hex(),SESSION_SCRIPT);valid=validate_session(value,FIXTURE_SID,SETUP['user'],SPEC['deploymentId'])
  need(valid['boot']==FIXTURE_EXPECTED['boot']and not valid['competingSessions']and value['console']==FIXTURE_EXPECTED['console']and value['session']['Logon']==FIXTURE_EXPECTED['logon']and value['session']['User'].casefold()==FIXTURE_EXPECTED['user'].casefold(),'instance_fixture_session_changed')
  return value,valid
 identity={'schemaVersion':1,'operationId':OPERATION,'expected':FIXTURE_EXPECTED,'account':FIXTURE_SID,'phaseSourceSha256':FIXTURE_PHASE_SHA,'rootFlockGeneration':lock_generation,'owner':owner,'lockOriginal':LOCK_TERMINAL,'lockscreenProfile':LOCKSCREEN_PROFILE,'replayAllowed':False}
 need({k:result[k]for k in ('actor','hostBoot','controlConnection')}=={k:FIXTURE_EXPECTED[k]for k in ('actor','hostBoot','controlConnection')},'instance_fixture_host_changed');fence()
 if exists('.intent.json'):
  old=read(prefix+'.intent.json')
  need(type(old)is dict and set(old)==set(identity)and all(old[k]==identity[k]for k in identity if k!='owner')and type(old['owner'])is dict and set(old['owner'])=={'pid','startTicks'}and all(type(old['owner'][k])is int and old['owner'][k]>0 for k in old['owner']),'instance_fixture_original_changed')
  terminal=read(prefix+'.terminal.json')if exists('.terminal.json')else None
  if terminal is not None:
   fields={'identity','state','submittedPhases','settingsChanged','replayAllowed'}
   need(type(terminal)is dict and set(terminal)in (fields|{'frame'},fields|{'reason'})and terminal['identity']==old and terminal['settingsChanged']is False and terminal['replayAllowed']is False,'instance_fixture_terminal_changed')
   if terminal['state']=='profile-field-captured':
    need(set(terminal)==fields|{'frame'}and terminal['submittedPhases']==['wake','dismiss']and read(prefix+'.wake.intent.json')=={'identity':old,'phase':'wake','replayAllowed':False}and read(prefix+'.wake.terminal.json')=={'identity':old,'phase':'wake','state':'pointer-acknowledged','replayAllowed':False}and read(prefix+'.dismiss.intent.json')=={'identity':old,'phase':'dismiss','replayAllowed':False}and read(prefix+'.dismiss.terminal.json')==terminal,'instance_fixture_terminal_changed')
   else:need(terminal['state']in {'blocked-before-effect','unknown'}and set(terminal)==fields|{'reason'}and ((terminal['state']=='blocked-before-effect'and terminal['submittedPhases']==[])or(terminal['state']=='unknown'and terminal['submittedPhases']in [['wake'],['wake','dismiss']]))and type(terminal['reason'])is str and __import__('re').fullmatch('instance_[a-z_]{1,64}',terminal['reason']),'instance_fixture_terminal_changed')
  value,valid=session()
  return {'state':'observed-original','originalOperationId':OPERATION,'historicalTerminal':terminal,'sessionFacts':value,'effectReplayed':False}
 need(not any(x.name.startswith(('login-credential-','login-owner-'))and x.name.endswith('.intent.json')for x in root.iterdir()),'instance_fixture_credential_admitted')
 need(read('fixture-lock-1dde6cf8-092c-4277-8159-2deb588a889e.intent.json')==LOCK_TERMINAL['identity']and read('fixture-lock-1dde6cf8-092c-4277-8159-2deb588a889e.terminal.json')==LOCK_TERMINAL and LOCK_TERMINAL['identity']['rootFlockGeneration']==lock_generation,'instance_fixture_original_changed')
 retain('.intent.json',identity);submitted=[]
 try:
  fresh,valid=session();need(valid['ordinary_session']=='locked','instance_fixture_session_changed')
  account=script('fixture-lock-account-'+os.urandom(6).hex(),FIXTURE_ACCOUNT)
  need(account['sid']==FIXTURE_SID and account['name'].casefold()==SETUP['user'].casefold()and account['enabled']is True and account['loginKeyboard']=='00000409','instance_fixture_account_changed')
  mice=monitor('query-mice');selected=[x for x in mice if type(x)is dict and x.get('current')is True]
  need(len(selected)==1 and type(selected[0].get('absolute'))is bool,'instance_fixture_pointer_unknown')
  events=[{'type':'abs','data':{'axis':'x','value':16384}},{'type':'abs','data':{'axis':'y','value':16384}}]if selected[0]['absolute']else[{'type':'rel','data':{'axis':'x','value':1}}]
  retain('.wake.intent.json',{'identity':identity,'phase':'wake','replayAllowed':False});submitted.append('wake');fence();monitor('input-send-event',{'events':events});fence()
  retain('.wake.terminal.json',{'identity':identity,'phase':'wake','state':'pointer-acknowledged','replayAllowed':False})
  fresh,valid=session();need(valid['ordinary_session']=='locked','instance_fixture_session_changed')
  _profile_known_screen(root,prefix,monitor,fence,LOCKSCREEN_PROFILE)
  retain('.dismiss.intent.json',{'identity':identity,'phase':'dismiss','replayAllowed':False});submitted.append('dismiss');fence();monitor('send-key',{'keys':[{'type':'qcode','data':'ret'}],'hold-time':80});fence();time.sleep(2)
  limit=time.monotonic()+20
  while True:
   after,valid=session()
   if valid['ordinary_session']=='locked':break
   need(time.monotonic()<limit,'instance_fixture_lock_unresolved');time.sleep(.25)
  # This one public frame is captured only before ANY protected owner or
  # credential admission on this isolated root. There is no post-input capture.
  fence();need(not any(x.name.startswith(('login-credential-','login-owner-'))and x.name.endswith('.intent.json')for x in root.iterdir()),'instance_fixture_credential_admitted')
  name=prefix+'-precredential.png';path=root/name;need(not os.path.lexists(path),'instance_fixture_frame_exists')
  monitor('screendump',{'filename':str(path),'format':'png'});fence()
  fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
  try:
   info=os.fstat(fd);generation=gen(info)
   need(stat.S_ISREG(info.st_mode)and info.st_uid==os.geteuid()and stat.S_IMODE(info.st_mode)==0o600 and info.st_nlink==1 and 32<=info.st_size<=2*1024**2 and generation==gen(os.lstat(path)),'instance_fixture_frame_identity')
   raw=b''
   while len(raw)<=2*1024**2:
    block=os.read(fd,65536)
    if not block:break
    raw+=block
   need(len(raw)==info.st_size and raw.startswith(bytes((137,80,78,71,13,10,26,10)))and raw[12:16]==b'IHDR'and gen(os.fstat(fd))==generation==gen(os.lstat(path)),'instance_fixture_frame_identity')
   width,height=struct.unpack('>II',raw[16:24]);need(320<=width<=4096 and 200<=height<=2160,'instance_fixture_frame_bound');fence()
   frame={'name':name,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'generation':generation,'width':width,'height':height,'precredentialOnly':True}
  finally:os.close(fd)
  terminal={'identity':identity,'state':'profile-field-captured','submittedPhases':submitted,'settingsChanged':False,'replayAllowed':False,'frame':frame}
  retain('.dismiss.terminal.json',terminal);retain('.terminal.json',terminal)
  return {'state':'profile-field-captured','originalOperationId':OPERATION,'sessionFacts':after,'effectReplayed':False,'historicalTerminal':terminal,'precredentialFrame':{**frame,'pngBase64':base64.b64encode(raw).decode()}}
 except BaseException as error:
  reason=str(error)if type(error)is ValueError and __import__('re').fullmatch('instance_[a-z_]{1,64}',str(error))else'instance_fixture_original_unknown'
  # Any journaled phase may have been submitted. A missing acknowledgement never permits replay.
  terminal={'identity':identity,'state':'blocked-before-effect'if not submitted else'unknown','submittedPhases':submitted,'reason':reason,'settingsChanged':False,'replayAllowed':False}
  if not exists('.terminal.json'):retain('.terminal.json',terminal)
  raise
