"""Actual fixed caller ACTORS and helper ASTs; native boundaries supplied by tests."""
ACTORS = {'worker': (1169929, 72285068), 'fixture': (1172004, 72288190)}

def procraw(pid, name, limit):
    fd = os.open('/proc/' + str(pid) + '/' + name, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        raw = os.read(fd, limit + 1)
        if len(raw) > limit:
            raise ValueError('actor_capture_bounds')
        return raw
    finally:
        os.close(fd)

def actor(name, pin):
    pid, ticks = pin
    try:
        raw = procraw(pid, 'stat', 4096)
        fields = raw.rsplit(b')', 1)[1].split()
        start = int(fields[19])
        ppid = int(fields[1])
        session = int(fields[3])
        cmd = procraw(pid, 'cmdline', 16384)
        status = procraw(pid, 'status', 16384)
        if procraw(pid, 'stat', 4096).rsplit(b')', 1)[1].split()[19] != str(start).encode():
            raise ValueError('actor_identity_changed')
        rows = dict((line.split(b':', 1) for line in status.splitlines() if b':' in line))
        uid = [int(x) for x in rows[b'Uid'].split()]
        gid = [int(x) for x in rows[b'Gid'].split()]
        return {'state': 'matching' if start == ticks else 'reused', 'pid': pid, 'startTicks': start, 'expectedStartTicks': ticks, 'ppid': ppid, 'session': session, 'uid': uid, 'gid': gid, 'commandBytes': len(cmd), 'commandSha256': hashlib.sha256(cmd).hexdigest(), 'commandBase64': base64.b64encode(cmd).decode()}
    except FileNotFoundError:
        if os.path.lexists('/proc/' + str(pid)):
            raise ValueError('actor_partial')
        return {'state': 'absent', 'pid': pid, 'expectedStartTicks': ticks}

def original_actor_pin_guard():
    expected = {'worker': (1169929, 72285068), 'fixture': (1172004, 72288190)}
    if type(ACTORS) is not dict or set(ACTORS) != set(expected) or any((type(pin) is not tuple or len(pin) != 2 or any((type(x) is not int or x <= 0 for x in pin)) or (pin != expected[name]) for name, pin in ACTORS.items())):
        raise ValueError('original_actor_pin_invalid')
    if os.getuid() != 1000 or Path('/proc/sys/kernel/random/boot_id').read_text().strip() != '25515f23-b966-4c3a-ae63-d38452375578':
        raise ValueError('original_actor_host_guard')
