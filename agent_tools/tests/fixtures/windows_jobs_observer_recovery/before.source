"""Finite durable SYSTEM/session-zero counter jobs for owned Windows fixtures.

There is no arbitrary source, credential, desktop or lifecycle API. A separate
create-only admission index survives loss of an operation directory. Consumed
UUIDs are observed, never launched again after an acknowledgement is lost.
"""
from dataclasses import dataclass, asdict
import base64
import hashlib
import inspect
import json
import math
import re
from uuid import UUID

_EXECUTING_CODE = inspect.currentframe().f_code
_BOOT = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z\Z")
_ROOT = re.compile(r"[0-9a-f]{8}:[0-9a-f]{16}:[0-9a-f]{16}\Z")
_BLOCKERS = frozenset("windows_job_" + item for item in (
    "guest_identity_changed", "root_generation_changed", "root_owner", "root_acl", "reparse_point",
    "file_identity", "file_handle", "root_handle", "root_identity", "system_required", "record_bound",
    "original_identity_changed", "job_generation_changed", "source_integrity", "owner_account_changed",
    "terminal_exit_changed", "stream_bound", "stream_incomplete", "stream_integrity", "admission_index_missing",
    "action_invalid", "enrollment_already_consumed", "enrollment_identity_changed", "directory_security"))


def _need(yes, reason):
    if not yes:
        raise ValueError(reason)


def _uuid(value):
    try:
        _need(type(value) is str and str(UUID(value)) == value, "windows_job_identity_invalid")
    except (ValueError, TypeError, AttributeError):
        raise ValueError("windows_job_identity_invalid") from None
    return value


def _identity(machine, boot):
    _uuid(machine)
    _need(type(boot) is str and _BOOT.fullmatch(boot), "windows_job_boot_invalid")


@dataclass(frozen=True)
class WindowsJobBinding:
    machine: str
    boot: str
    root_generation: str
    admission_generation: str

    def __post_init__(self):
        _identity(self.machine, self.boot)
        for value in (self.root_generation, self.admission_generation):
            _need(type(value) is str and _ROOT.fullmatch(value), "windows_job_root_invalid")


def _literal(value):
    raw = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return "([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" + base64.b64encode(raw).decode() + "')))"


def _prefix():
    source = ("using System;using System.IO;using System.Diagnostics;using System.Collections.Generic;"
              "using System.Text;using System.Threading;using System.Management;using System.Runtime.InteropServices;"
              "using System.Security.AccessControl;using System.Security.Principal;using System.Security.Cryptography;"
              "using System.Web.Script.Serialization;\n" + _NATIVE)
    return ("$ErrorActionPreference='Stop';$ProgressPreference='SilentlyContinue'\n"
            "[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false)\n"
            "Add-Type -TypeDefinition @'\n" + source + "\n'@ -ReferencedAssemblies @('System','System.Core','System.Management','System.Web.Extensions')\n")


def enrollment_source(machine, boot, operation, nonce, *, observe=False):
    _identity(machine, boot)
    config = {"machine": machine, "boot": boot, "enrollmentOperation": _uuid(operation), "enrollmentNonce": _uuid(nonce)}
    method = "NamespaceStatus" if observe else "Enroll"
    return (_prefix() + "[Console]::WriteLine([NativeJob]::" + method + "(" + _literal(config) + "))\n").encode()


def validate_enrollment(value, machine, boot, operation, nonce):
    _identity(machine, boot)
    if type(value) is dict and value.get("state") == "blocked":
        reason = value.get("reason")
        raise ValueError(reason if type(reason) is str and reason in _BLOCKERS else "windows_job_namespace_unknown")
    _need(type(value) is dict and set(value) == {"schemaVersion", "machine", "boot", "rootGeneration", "admissionGeneration", "enrollmentOperation", "enrollmentNonce"}
          and type(value["schemaVersion"]) is int and value["schemaVersion"] == 1
          and value["machine"] == machine and value["boot"] == boot and value["enrollmentOperation"] == _uuid(operation)
          and value["enrollmentNonce"] == _uuid(nonce), "windows_job_enrollment_invalid")
    return WindowsJobBinding(machine, boot, value["rootGeneration"], value["admissionGeneration"])


def _config(binding, operation, count=80, interval_seconds=.25):
    _need(type(binding) is WindowsJobBinding, "windows_job_binding_invalid")
    _need(type(count) is int and 1 <= count <= 1000 and type(interval_seconds) in (int, float)
          and math.isfinite(interval_seconds) and .01 <= interval_seconds <= 1, "windows_job_spec_invalid")
    return {"schemaVersion": 1, "machine": binding.machine, "boot": binding.boot,
            "rootGeneration": binding.root_generation, "admissionGeneration": binding.admission_generation,
            "operationId": _uuid(operation), "count": count, "intervalMilliseconds": round(interval_seconds * 1000)}


def program(action, binding, operation, *, count=80, interval_seconds=.25):
    _need(action in {"start", "status"}, "windows_job_action_invalid")
    config = _config(binding, operation, count, interval_seconds)
    prefix = _prefix()
    owner = (prefix + "[NativeJob]::Own(" + _literal(config) + ")\n").encode()
    return (prefix + "[Console]::WriteLine([NativeJob]::Control('" + action + "'," + _literal(config) +
            (",'" + base64.b64encode(owner).decode() + "','" + hashlib.sha256(owner).hexdigest() + "'" if action == "start" else ",$null,$null") + "))\n").encode()


def inventory_source(machine, boot, root_generation=None, admission_generation=None):
    _identity(machine, boot)
    _need((root_generation is None) == (admission_generation is None), "windows_job_root_invalid")
    if root_generation is not None:
        WindowsJobBinding(machine, boot, root_generation, admission_generation)
    return (_prefix() + "[Console]::WriteLine([NativeJob]::Inventory(" + _literal({"machine": machine, "boot": boot,
            "rootGeneration": root_generation, "admissionGeneration": admission_generation}) + "))\n").encode()


_NATIVE = r'''
public static class NativeJob {
 static JavaScriptSerializer Json=new JavaScriptSerializer(){MaxJsonLength=262144};
 [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern bool CreateDirectoryW(string path,IntPtr security);
 [DllImport("advapi32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern bool ConvertStringSecurityDescriptorToSecurityDescriptorW(string source,UInt32 revision,out IntPtr descriptor,out UInt32 length);
 [DllImport("kernel32.dll")]static extern IntPtr LocalFree(IntPtr value);
 [StructLayout(LayoutKind.Sequential)]struct DirectorySecurityAttributes {public int Length;public IntPtr Descriptor;[MarshalAs(UnmanagedType.Bool)]public bool Inherit;}
 static bool CreatePrivateDirectory(string path){
  IntPtr descriptor=IntPtr.Zero,attributes=IntPtr.Zero;UInt32 length;
  Need(ConvertStringSecurityDescriptorToSecurityDescriptorW("O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)",1,out descriptor,out length)&&descriptor!=IntPtr.Zero,"DIRECTORY_SECURITY");
  try{
   var security=new DirectorySecurityAttributes{Length=Marshal.SizeOf(typeof(DirectorySecurityAttributes)),Descriptor=descriptor,Inherit=false};
   attributes=Marshal.AllocHGlobal(security.Length);Marshal.StructureToPtr(security,attributes,false);
   return CreateDirectoryW(path,attributes);
  }finally{if(attributes!=IntPtr.Zero)Marshal.FreeHGlobal(attributes);LocalFree(descriptor);}
 }
 [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern IntPtr CreateFileW(string path,UInt32 access,UInt32 share,IntPtr security,UInt32 disposition,UInt32 flags,IntPtr template);
 [DllImport("kernel32.dll",SetLastError=true)]static extern bool GetFileInformationByHandle(IntPtr handle,out FileInfoNative info);
 [DllImport("kernel32.dll")]static extern bool CloseHandle(IntPtr handle);
 [StructLayout(LayoutKind.Sequential)]struct FileInfoNative {public UInt32 Attributes;public System.Runtime.InteropServices.ComTypes.FILETIME Created,Accessed,Written;public UInt32 Volume,SizeHigh,SizeLow,Links,IndexHigh,IndexLow;}
 static void Need(bool yes,string reason){if(!yes)throw new Exception(reason);}
 static Dictionary<string,object> Read(string path){Need(new FileInfo(path).Length<=262144,"RECORD_BOUND");NoLink(path);FileTag(path);return Json.Deserialize<Dictionary<string,object>>(File.ReadAllText(path,Encoding.UTF8));}
 static string S(Dictionary<string,object> v,string key){return Convert.ToString(v[key],System.Globalization.CultureInfo.InvariantCulture);}
 static string Hash(byte[] value){using(var h=SHA256.Create())return BitConverter.ToString(h.ComputeHash(value)).Replace("-","").ToLowerInvariant();}
 static void Write(string path,Dictionary<string,object> value){byte[] raw=Encoding.UTF8.GetBytes(Json.Serialize(value));string temp=path+".pending-"+Guid.NewGuid().ToString("N");using(var f=new FileStream(temp,FileMode.CreateNew,FileAccess.Write,FileShare.None)){f.Write(raw,0,raw.Length);f.Flush(true);}File.Move(temp,path);}
 static void NoLink(string path){Need((File.GetAttributes(path)&FileAttributes.ReparsePoint)==0,"REPARSE_POINT");}
 static void Private(string path,bool create=false){
  if(!Directory.Exists(path)){
   Need(create,"ROOT_GENERATION_CHANGED");
   var acl=new DirectorySecurity();var system=new SecurityIdentifier("S-1-5-18");acl.SetOwner(system);acl.SetAccessRuleProtection(true,false);
   foreach(string sid in new[]{"S-1-5-18","S-1-5-32-544"})acl.AddAccessRule(new FileSystemAccessRule(new SecurityIdentifier(sid),FileSystemRights.FullControl,InheritanceFlags.ContainerInherit|InheritanceFlags.ObjectInherit,PropagationFlags.None,AccessControlType.Allow));
   Directory.CreateDirectory(path,acl);
  }
  NoLink(path);var actual=Directory.GetAccessControl(path);Need(actual.GetOwner(typeof(SecurityIdentifier)).Value=="S-1-5-18","ROOT_OWNER");
  foreach(FileSystemAccessRule row in actual.GetAccessRules(true,true,typeof(SecurityIdentifier)))Need(row.AccessControlType==AccessControlType.Allow&&(row.IdentityReference.Value=="S-1-5-18"||row.IdentityReference.Value=="S-1-5-32-544"),"ROOT_ACL");
 }
 static string Root(Dictionary<string,object> c){return Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData),"VPNControlRecoveryJobs-v1",S(c,"machine"));}
 static string Tag(string path){
  NoLink(path);IntPtr h=CreateFileW(path,0,7,IntPtr.Zero,3,0x02000000,IntPtr.Zero);Need(h!=new IntPtr(-1),"ROOT_HANDLE");
  try{FileInfoNative i;Need(GetFileInformationByHandle(h,out i),"ROOT_IDENTITY");UInt64 birth=((UInt64)(UInt32)i.Created.dwHighDateTime<<32)|(UInt32)i.Created.dwLowDateTime;
   return i.Volume.ToString("x8")+":"+i.IndexHigh.ToString("x8")+i.IndexLow.ToString("x8")+":"+birth.ToString("x16");}finally{CloseHandle(h);}
 }
 static bool Machine(Dictionary<string,object> c,bool terminalHistory=false){
  Need(WindowsIdentity.GetCurrent().User.Value=="S-1-5-18","SYSTEM_REQUIRED");
  string machine=null,boot=null;
  using(var q=new ManagementObjectSearcher("SELECT UUID FROM Win32_ComputerSystemProduct"))foreach(ManagementObject row in q.Get())machine=new Guid(Convert.ToString(row["UUID"])).ToString("D");
  using(var q=new ManagementObjectSearcher("SELECT LastBootUpTime FROM Win32_OperatingSystem"))foreach(ManagementObject row in q.Get())boot=ManagementDateTimeConverter.ToDateTime(Convert.ToString(row["LastBootUpTime"])).ToUniversalTime().ToString("o");
  bool sameBoot=boot==S(c,"boot");Need(machine==S(c,"machine")&&(terminalHistory||sameBoot),"GUEST_IDENTITY_CHANGED");return sameBoot;
 }
 [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern bool CreateProcessW(string app,StringBuilder command,IntPtr processSecurity,IntPtr threadSecurity,bool inherit,UInt32 flags,IntPtr environment,string directory,ref Startup startup,out ProcessInfo result);
 [StructLayout(LayoutKind.Sequential,CharSet=CharSet.Unicode)]struct Startup {public int Size;public string Reserved,Desktop,Title;public UInt32 X,Y,Width,Height,CharsX,CharsY,Fill,Flags;public UInt16 Show,ReservedBytes;public IntPtr ReservedPtr,Input,Output,Error;}
 [StructLayout(LayoutKind.Sequential)]struct ProcessInfo {public IntPtr Process,Thread;public UInt32 Pid,Tid;}
 static void FileTag(string path){NoLink(path);IntPtr h=CreateFileW(path,0,7,IntPtr.Zero,3,0,IntPtr.Zero);Need(h!=new IntPtr(-1),"FILE_HANDLE");try{FileInfoNative i;Need(GetFileInformationByHandle(h,out i)&&i.Links==1&&(i.Attributes&0x10)==0,"FILE_IDENTITY");}finally{CloseHandle(h);}}
 static bool Exists(string path){try{File.GetAttributes(path);return true;}catch(FileNotFoundException){return false;}catch(DirectoryNotFoundException){return false;}}
 static string Index(string root){return Path.Combine(root,"admissions");}
 static string RootGuard(Dictionary<string,object> c){
  NoLink(Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData));string root=Root(c);Private(Path.GetDirectoryName(root));Private(root);Private(Index(root));Private(Path.Combine(root,"operations"));
  Need(Tag(root)==S(c,"rootGeneration")&&Tag(Index(root))==S(c,"admissionGeneration"),"ROOT_GENERATION_CHANGED");return root;
 }
