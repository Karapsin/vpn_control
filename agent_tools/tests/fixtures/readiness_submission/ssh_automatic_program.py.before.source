"""Internal automatic file transport for oversized, configured Python carriers.

The builder only binds immutable data. Network submission belongs to the existing
operation owner, which must already have admitted its original durable intent.
This module neither invents a route nor retries a submitted/unknown operation.
"""
from __future__ import annotations

import errno
import base64
from contextlib import contextmanager
from dataclasses import asdict, dataclass, field
import hashlib
import json
import os
from pathlib import Path
import selectors
import stat
import subprocess
import sys
import time
import types
import uuid
import zlib

COMMAND_BYTES = 60000
CHUNK_BYTES = 65536
MAX_PROGRAM_BYTES = 8 * 1024 * 1024
_EXECUTING_CODE = sys._getframe().f_code
_SOURCE_SHA = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
_CLOSURE_PATH = Path(__file__).with_name('native_review_source_closure.py')
_CLOSURE_SHA = hashlib.sha256(_CLOSURE_PATH.read_bytes()).hexdigest()
_PRIVATE_CONFIG_PATH = Path(__file__).with_name('private_config_custody.py')
_PRIVATE_CONFIG_SHA = 'efc4b40e1f455444bd80ad3bbb5cb8753cad1d4cf737853010f1bccea32ea040'
_PRIVILEGED_PATH = Path(__file__).with_name('ssh_privileged_program.py')
_PRIVILEGED_SHA = 'd52e7e725ff4f4c5d6fa94a0e8fb33d0accb247949eec9daf721c5d21c160f04'


class AutomaticProgramError(ValueError):
    """No original program may be submitted after this refusal."""


def _sha(raw):
    return hashlib.sha256(raw).hexdigest()


def _json(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def command_bytes(argv):
    # Include separators and the whole local argv, so every nested quoted remote
    # command and each individual exec argument is bounded by this same limit.
    return sum(len(part.encode("utf-8")) + 1 for part in argv)


@dataclass(frozen=True)
class PlannedArgv:
    original_argv: tuple[str, ...]
    command: tuple[str, ...]
    root: str
    host: str
    timeout_seconds: int
    ssh_binary: str
    nested_ssh_binary: str
    correlation: str
    config_sha: str
    source_pins: tuple[tuple[str, str], ...]
    route_sha: str
    dispatch_admission: object = None
    config_custody: object = field(default=None, repr=False, compare=False)
    fresh_direct: bool = False

    def check_source_lifetime(self):
        # SourceSession instruments this pure method when a plan crosses its
        # adapter boundary. A closed source request cannot be reacquired later.
        if self.dispatch_admission is not None:
            self.dispatch_admission.revalidate()

    def __len__(self):
        return len(self.original_argv)

    def __getitem__(self, index):
        # A slice must retain the refusal rather than silently discard custody.
        if isinstance(index, slice):
            raise AutomaticProgramError("oversized_argv_requires_automatic_submission")
        return self.original_argv[index]

    def __iter__(self):
        raise AutomaticProgramError("oversized_argv_requires_automatic_submission")

    def __setitem__(self, index, value):
        raise AutomaticProgramError('oversized_argv_mutation_requires_reconstruction')


def _bound_helper(path, digest, name):
    # Never import a helper before authenticating its executable bytes. A
    # timestamp-valid pyc or an old sys.modules entry is not source authority.
    held = _new_custody()
    try:
        raw = held.read(str(path), digest, max_bytes=MAX_PROGRAM_BYTES)
        held.finish(); held.final_identity_pass()
        module = types.ModuleType((__package__ or 'agent_tools') + '._automatic_' + name)
        module.__file__ = str(path)
        module.__package__ = __package__
        exec(compile(raw, str(path), 'exec', dont_inherit=True), module.__dict__)
        held.finish(); held.final_identity_pass()
        return module
    finally:
        held.close()


def _private_config():
    return _bound_helper(_PRIVATE_CONFIG_PATH, _PRIVATE_CONFIG_SHA, 'private_config')


def _privileged():
    return _bound_helper(_PRIVILEGED_PATH, _PRIVILEGED_SHA, 'privileged_program')


def _transport():
    from . import ssh_transport
    return ssh_transport


def _config_sha(config):
    # Only public route selectors are fingerprinted. Credential equality is
    # checked by the retained private file owner, never a password derivative.
    value = asdict(config)
    for host in value['hosts'].values():
        host['password'] = '<protected>' if host['password'] is not None else None
    return _sha(repr(value).encode())


def _route_sha(config, host, fresh_direct=False):
    transport = _transport()
    if fresh_direct:
        return _sha(_json(['configured-existing-nested-with-fresh-outer', host]))
    rows = []
    for entry in transport._route_hosts(config.hosts, host):
        if os.path.lexists(config.root / ".rag_index" / "ssh-channel-selection"):
            selection = transport._selection_module()
            if selection.selection_present(config.root, entry.alias):
                rows.append((entry.alias, selection.selected_route_options(config.root, entry.alias, config)))
    return _sha(_json(rows))


def _new_custody():
    # This is the only bootstrap primitive. Authenticate its lexical ancestry,
    # nofollow file, full generation and bytes before executing any source.
    path = _CLOSURE_PATH
    text = str(path)
    parts = text.split('/')[1:]
    if not text.startswith('/') or not parts or any(part in ('', '.', '..') for part in parts):
        raise AutomaticProgramError('automatic_custody_path')
    descriptors = []
    directories = []
    held = None
    def generation(info):
        return (info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid,
                info.st_nlink,info.st_size,info.st_mtime_ns,info.st_ctime_ns)
    def structure(info):
        return (info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_gid)
    try:
        directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        descriptors.append(directory)
        directories.append((None, '/', directory, structure(os.fstat(directory))))
        for name in parts[:-1]:
            parent = directory
            directory = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            descriptors.append(directory)
            directories.append((parent, name, directory, structure(os.fstat(directory))))
        descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
        descriptors.append(descriptor)
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1
                or not 0 < info.st_size <= MAX_PROGRAM_BYTES):
            raise AutomaticProgramError('automatic_custody_source_shape')
        before = generation(info)
        chunks = []; total = 0
        while total <= info.st_size:
            block = os.read(descriptor, min(CHUNK_BYTES, info.st_size + 1 - total))
            if not block:
                break
            chunks.append(block); total += len(block)
        raw = b''.join(chunks)
        if len(raw) != info.st_size or _sha(raw) != _CLOSURE_SHA:
            raise AutomaticProgramError('automatic_custody_source_changed')
        def guard():
            for parent, name, fd, expected in directories:
                if structure(os.fstat(fd)) != expected:
                    raise AutomaticProgramError('automatic_custody_ancestry_changed')
                physical = os.stat('/',follow_symlinks=False) if parent is None else os.stat(name,dir_fd=parent,follow_symlinks=False)
                if structure(physical) != expected:
                    raise AutomaticProgramError('automatic_custody_ancestry_changed')
            if (generation(os.fstat(descriptor)) != before or
                    generation(os.stat(parts[-1],dir_fd=directory,follow_symlinks=False)) != before):
                raise AutomaticProgramError('automatic_custody_source_changed')
            digest = hashlib.sha256(); offset = 0
            while offset < len(raw):
                block = os.pread(descriptor, min(CHUNK_BYTES,len(raw)-offset), offset)
                if not block:
                    raise AutomaticProgramError('automatic_custody_source_changed')
                digest.update(block); offset += len(block)
            if digest.hexdigest() != _CLOSURE_SHA:
                raise AutomaticProgramError('automatic_custody_source_changed')
        guard()
        module = types.ModuleType(__package__ + '._automatic_custody')
        module.__file__ = str(path)
        exec(compile(raw, str(path), 'exec', dont_inherit=True), module.__dict__)
        held = module._Held()
        held.read(str(path), _sha(raw), gen=before, max_bytes=MAX_PROGRAM_BYTES)
        held.finish(); held.final_identity_pass(); guard()
        result = held; held = None
        return result
    finally:
        if held is not None:
            held.close()
        for descriptor in reversed(descriptors):
            os.close(descriptor)


def _pins(config, host, *, privileged=False):
    transport = _transport()
    source = Path(transport.__file__)
    expected = getattr(transport, "_LOADED_SOURCE_SHA", None)
    if (expected is None or _sha(source.read_bytes()) != expected or
            getattr(transport, '_EXECUTING_CODE', None) != compile(source.read_bytes(), str(source), 'exec', dont_inherit=True)):
        raise AutomaticProgramError("automatic_transport_source_changed")
    if (_sha(Path(__file__).read_bytes()) != _SOURCE_SHA or
            _EXECUTING_CODE != compile(Path(__file__).read_bytes(), __file__, 'exec', dont_inherit=True) or
            _sha(_CLOSURE_PATH.read_bytes()) != _CLOSURE_SHA):
        raise AutomaticProgramError("automatic_transport_source_changed")
    _private_config()
    paths = [(str(source), expected), (str(Path(__file__)), _SOURCE_SHA), (str(_CLOSURE_PATH), _CLOSURE_SHA),
             (str(_PRIVATE_CONFIG_PATH), _PRIVATE_CONFIG_SHA)]
    if privileged:
        _privileged()
        paths.append((str(_PRIVILEGED_PATH), _PRIVILEGED_SHA))
    outer = transport.connection_host(config, host)
    if outer.password is not None:
        raise AutomaticProgramError("automatic_program_requires_key_route")
    for path in (outer.identity_file, outer.known_hosts_file):
        if not isinstance(path, Path):
            raise AutomaticProgramError("automatic_program_local_route_files")
        paths.append((str(path), _sha(path.read_bytes())))
    return tuple(paths)


def coordinator_capable():
    return (os.name == 'posix' and all(hasattr(os, name) for name in
            ('getuid','geteuid','O_NOFOLLOW','O_DIRECTORY','O_NONBLOCK','pread')))


def bind(config, host, timeout_seconds, command, ssh_binary, nested_ssh_binary, argv, *, force_file=False, fresh_direct=False):
    """Pure local binding; ordinary argv remains a plain list."""
    if type(fresh_direct) is not bool:
        raise AutomaticProgramError('automatic_fresh_direct_mode')
    if type(force_file) is not bool:
        raise AutomaticProgramError('automatic_force_file_mode')
    if not force_file and command_bytes(argv) <= COMMAND_BYTES:
        return argv
    if not coordinator_capable():
        raise AutomaticProgramError('automatic_unsupported_coordinator')
    custody = _private_config().PrivateConfigCustody(_transport()._private_config_path(config.root))
    current = _transport().load_config(config.root)
    if (_config_sha(current) != _config_sha(config) or
            any(current.hosts[key].password != config.hosts[key].password for key in current.hosts) or
            not custody.matches_text(_transport()._read_private_config(_transport()._private_config_path(config.root)))):
        raise AutomaticProgramError("automatic_configuration_changed")
    prefix, raw, arguments = _program(tuple(command))
    correlation = uuid.uuid4().hex
    _preflight(config, host, timeout_seconds, prefix, arguments, len(raw), _sha(raw),
               correlation, ssh_binary, nested_ssh_binary, fresh_direct=fresh_direct)
    return PlannedArgv(tuple(argv), tuple(command), str(config.root), host, timeout_seconds,
                       ssh_binary, nested_ssh_binary, correlation,
                       _config_sha(config), _pins(config, host, privileged=prefix[0] in ('sudo', '/usr/bin/sudo')), _route_sha(config, host, fresh_direct),
                       _transport()._dispatch_binding(config, host), custody, fresh_direct)


def password_carrier(command):
    """Pure recognition used to refuse unsupported password sudo shapes."""
    command = tuple(command)
    if not command or command[0] not in ('sudo', '/usr/bin/sudo'):
        return False
    prefix = command[:command.index('-c')] if '-c' in command else command
    return '-S' in prefix


def _program(command):
    if command and command[0] in ('sudo', '/usr/bin/sudo'):
        privileged = _privileged()
        try:
            prefix, raw, arguments = privileged.program(command)
        except privileged.PrivilegedProgramError:
            raise AutomaticProgramError("oversized_command_form_unsupported") from None
        if not 0 < len(raw) <= MAX_PROGRAM_BYTES:
            raise AutomaticProgramError("automatic_program_size")
        return prefix, raw, arguments
    if not command or command[0] not in ("python3", "/usr/bin/python3"):
        raise AutomaticProgramError("oversized_command_form_unsupported")
    index = 1
    while index < len(command) and command[index] in ("-I", "-B", "-u"):
        index += 1
    if index + 1 >= len(command) or command[index] != "-c":
        raise AutomaticProgramError("oversized_command_form_unsupported")
    raw = command[index + 1].encode("utf-8", "strict")
    if not 0 < len(raw) <= MAX_PROGRAM_BYTES:
        raise AutomaticProgramError("automatic_program_size")
    return command[:index], raw, command[index + 2:]


_COMMON = r'''import hashlib,json,os,pwd,stat,subprocess,sys,tempfile
def identity():
 p=pwd.getpwuid(os.geteuid())
 if sys.platform.startswith('linux'):
  with open('/proc/sys/kernel/random/boot_id') as f:boot=f.read(128).strip()
 elif sys.platform=='darwin':
  r=subprocess.run(['/usr/sbin/sysctl','-n','kern.bootsessionuuid'],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,timeout=3,check=True);boot=r.stdout.decode().strip().lower()
 else:raise ValueError('automatic_guest_platform')
 if len(boot)!=36 or len(p.pw_dir)>4096 or len(p.pw_name)>64:raise ValueError('automatic_guest_identity')
 return {'uid':os.geteuid(),'principal':p.pw_name,'home':p.pw_dir,'boot':boot}
def gen(s):return [s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
def anchored(path):
 if not path.startswith('/') or any(p in ('','.','..') for p in path.split('/')[1:]):raise ValueError('automatic_path')
 f=os.open('/',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW);held=[f]
 for p in path.split('/')[1:]:
  f=os.open(p,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=f);held.append(f)
 return f,held
def same_path(path,held):
 f,again=anchored(path)
 try:
  if [(os.fstat(x).st_dev,os.fstat(x).st_ino) for x in held]!=[(os.fstat(x).st_dev,os.fstat(x).st_ino) for x in again]:raise ValueError('automatic_ancestry_changed')
 finally:
  for x in reversed(again):os.close(x)
def read_program(directory,size,digest,expected=None):
 f=os.open('program.source',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=directory);s=os.fstat(f)
 try:
  if not stat.S_ISREG(s.st_mode) or s.st_uid!=os.geteuid() or stat.S_IMODE(s.st_mode)!=0o600 or s.st_nlink!=1 or s.st_size!=size or expected is not None and gen(s)!=expected:raise ValueError('automatic_program_metadata')
  chunks=[];n=0;h=hashlib.sha256()
  while n<size:
   b=os.read(f,min(65536,size-n))
   if not b:raise ValueError('automatic_program_short')
   n+=len(b);h.update(b);chunks.append(b)
  if os.read(f,1) or h.hexdigest()!=digest:raise ValueError('automatic_program_hash')
  physical=os.stat('program.source',dir_fd=directory,follow_symlinks=False)
  if gen(os.fstat(f))!=gen(s) or gen(physical)!=gen(s):raise ValueError('automatic_program_changed')
  return f,s,b''.join(chunks)
 except BaseException:os.close(f);raise
def create(directory,name,raw):
 f=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=directory)
 try:
  view=memoryview(raw)
  while view:
   n=os.write(f,view[:65536])
   if n<=0:raise ValueError('automatic_short_write')
   view=view[n:]
  os.fsync(f)
 finally:os.close(f)
'''

_RECEIVER = _COMMON + r'''
corr,size,digest=sys.argv[1:4];size=int(size)
if len(corr)!=32 or any(x not in '0123456789abcdef' for x in corr) or not 0<size<=8388608 or len(digest)!=64:raise ValueError('automatic_request')
before=identity();parent=os.path.realpath(tempfile.gettempdir())
if len(parent)+len('/vpn-control-auto-')+len(corr)>4096:raise ValueError('automatic_path_bound')
root,parents=anchored(parent)
try:
 s=os.fstat(root)
 if not (s.st_uid==os.geteuid() and not s.st_mode&0o022 or s.st_uid==0 and s.st_mode&stat.S_ISVTX):raise ValueError('automatic_parent')
 leaf='vpn-control-auto-'+corr;os.mkdir(leaf,0o700,dir_fd=root);directory=os.open(leaf,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=root)
 try:
  ds=os.fstat(directory)
  if ds.st_uid!=before['uid'] or stat.S_IMODE(ds.st_mode)!=0o700:raise ValueError('automatic_directory')
  f=os.open('program.source',os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=directory)
  try:
   remaining=size
   while remaining:
    b=sys.stdin.buffer.read(min(65536,remaining))
    if not b:raise ValueError('automatic_source_truncated')
    remaining-=len(b);v=memoryview(b)
    while v:
     n=os.write(f,v)
     if n<=0:raise ValueError('automatic_short_write')
     v=v[n:]
   if sys.stdin.buffer.read(1):raise ValueError('automatic_source_trailing')
   os.fsync(f)
  finally:os.close(f)
  f,s,raw=read_program(directory,size,digest);os.close(f)
  path=parent+'/'+leaf
  if identity()!=before:raise ValueError('automatic_identity_changed')
  same_path(parent,parents)
  if gen(os.stat(leaf,dir_fd=root,follow_symlinks=False))[:5]!=gen(ds)[:5]:raise ValueError('automatic_directory_changed')
  receipt={'schemaVersion':1,'correlationId':corr,'directory':path,'identity':before,'programSha256':digest,'programBytes':size,'generation':gen(s),'directoryIdentity':gen(ds)[:5]}
  create(directory,'receipt.json',json.dumps(receipt,sort_keys=True,separators=(',',':')).encode())
  print(json.dumps(receipt,sort_keys=True,separators=(',',':')))
 finally:os.close(directory)
finally:
 for f in reversed(parents):os.close(f)
'''

_LOADER = _COMMON + r'''
expected=json.loads(sys.argv[1]);arguments=sys.argv[2:];path=expected['directory'];before=identity()
if before!=expected['identity']:raise ValueError('automatic_identity_changed')
if path!=os.path.realpath(tempfile.gettempdir())+'/vpn-control-auto-'+expected['correlationId']:raise ValueError('automatic_filename')
directory,parents=anchored(path)
try:
 if gen(os.fstat(directory))[:5]!=expected['directoryIdentity'] or stat.S_IMODE(os.fstat(directory).st_mode)!=0o700:raise ValueError('automatic_directory_changed')
 f,s,raw=read_program(directory,expected['programBytes'],expected['programSha256'],expected['generation'])
 try:
  # The claim precedes the single original program execution. An interrupted
  # loader keeps this claim and cannot be replayed from its saved filename.
  create(directory,'execution-intent.json',json.dumps(expected,sort_keys=True,separators=(',',':')).encode())
  same_path(path,parents)
  if identity()!=before:raise ValueError('automatic_identity_changed')
  sys.argv=['-c',*arguments]
  scope={'__name__':'__main__','__package__':None,'__spec__':None,'__loader__':__loader__,'__doc__':None,'__builtins__':__builtins__}
  try:exec(compile(raw,path+'/program.source','exec'),scope)
  finally:
   check,after,_=read_program(directory,expected['programBytes'],expected['programSha256'],expected['generation']);os.close(check)
   if gen(os.fstat(f))!=gen(s) or identity()!=before:raise ValueError('automatic_closing_changed')
   same_path(path,parents)
 finally:os.close(f)
finally:
 for f in reversed(parents):os.close(f)
'''


def _carrier(program):
    encoded = base64.b64encode(zlib.compress(program.encode(), 9)).decode()
    return "import base64,zlib;exec(compile(zlib.decompress(base64.b64decode(" + repr(encoded) + ")), '<automatic-file-transport>', 'exec'))"


def _preflight(config, host, timeout, prefix, arguments, size, digest, correlation, ssh_binary, nested_ssh_binary, *, fresh_direct=False):
    # These are byte-budget placeholders, never identity or execution authority.
    # Bound maximum admitted guest path/home and numeric receipt metadata before
    # any local intent, upload or original program submission can occur.
    maximum = 2**64 - 1
    receipt = {'schemaVersion':1,'correlationId':correlation,
        'directory':'/'+'x'*4095,'identity':{'uid':2**32-1,'principal':'u'*64,
            'home':'/'+'h'*4095,'boot':'f'*36},'programSha256':digest,'programBytes':size,
        'generation':[maximum]*9,'directoryIdentity':[maximum]*5}
    is_privileged = prefix[0] in ('sudo', '/usr/bin/sudo')
    ordinary_prefix = _privileged().receiver_prefix(prefix) if is_privileged else prefix
    receiver = (*ordinary_prefix, '-c', _carrier(_RECEIVER), correlation, str(size), digest)
    if not is_privileged:
        execution = (*prefix, '-c', _carrier(_LOADER), _json(receipt).decode(), *arguments)
    else:
        privileged = _privileged()
        password = privileged.split_prefix(prefix)[2]
        execution = privileged.execution_command(prefix, privileged.loader(_COMMON, password=password),
            _json(receipt).decode(), arguments, correlation, timeout)
    for command in (receiver, execution):
        argv = _transport()._build_ssh_argv(config, host, timeout, command, ssh_binary, nested_ssh_binary,
            **({'fresh_direct':True} if fresh_direct else {}))
        if command_bytes(argv) > COMMAND_BYTES:
            raise AutomaticProgramError('oversized_residual_arguments_unsupported')


def _private_directory(path, parent_fd):
    try:
        os.mkdir(path.name, mode=0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    descriptor = os.open(path.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise AutomaticProgramError('automatic_journal_directory')
        return (info.st_dev, info.st_ino)
    finally:
        os.close(descriptor)


def _write(directory, name, raw, *, directory_fd=None):
    fd = os.open(directory / name if directory_fd is None else name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory_fd)
    try:
        view = memoryview(raw)
        while view:
            count = os.write(fd, view[:CHUNK_BYTES])
            if count <= 0:
                raise AutomaticProgramError("automatic_local_short_write")
            view = view[count:]
        os.fsync(fd)
    finally:
        os.close(fd)


def _stage(argv, payload, timeout):
    """Bounded full-duplex stage only; no original product program executes."""
    if command_bytes(argv) > COMMAND_BYTES:
        raise AutomaticProgramError("automatic_bootstrap_command_size")
    process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0)
    selector = selectors.DefaultSelector()
    output = {"stdout": bytearray(), "stderr": bytearray()}
    pending = memoryview(payload)
    sent = 0
    send_error = None
    counts = {"stdout": 0, "stderr": 0}
    eof = {"stdout": False, "stderr": False}
    deadline = time.monotonic() + timeout
    failure = None
    try:
        for name in output:
            pipe = getattr(process, name); os.set_blocking(pipe.fileno(), False)
            selector.register(pipe, selectors.EVENT_READ, name)
        os.set_blocking(process.stdin.fileno(), False)
        selector.register(process.stdin, selectors.EVENT_WRITE, "stdin")
        while selector.get_map():
            if time.monotonic() >= deadline:
                raise AutomaticProgramError("automatic_stage_unknown_timeout")
            for key, _ in selector.select(min(.1, max(0, deadline - time.monotonic()))):
                if key.data == "stdin":
                    try: count = os.write(key.fd, pending[:CHUNK_BYTES])
                    except BlockingIOError: continue
                    except OSError as error:
                        send_error = type(error).__name__
                        selector.unregister(key.fileobj); key.fileobj.close()
                        continue
                    if count <= 0:
                        send_error = 'short_write'
                        selector.unregister(key.fileobj); key.fileobj.close()
                        continue
                    pending = pending[count:]; sent += count
                    if not pending:
                        selector.unregister(key.fileobj); key.fileobj.close()
                else:
                    try: block = os.read(key.fd, 4096)
                    except BlockingIOError: continue
                    if not block:
                        eof[key.data] = True
                        selector.unregister(key.fileobj); continue
                    counts[key.data] += len(block)
                    target = output[key.data]; target.extend(block[:65537-len(target)])
                    if len(target) > 65536: raise AutomaticProgramError("automatic_stage_unknown_output")
        code = process.wait(timeout=max(.001, deadline-time.monotonic()))
        if code != 0 or output['stderr'] or sent != len(payload) or send_error is not None:
            raise AutomaticProgramError("automatic_stage_unknown_transport")
        return bytes(output['stdout'])
    except BaseException as error:
        # This is this call's owned local SSH client only. Remote stage failures
        # are retained as unknown and are never resubmitted.
        if process.poll() is None: process.kill()
        process.wait()
        failure = AutomaticProgramError(str(error))
        failure.stage_evidence = (bytes(output['stdout']), bytes(output['stderr']),
            {'returnCode':process.returncode,'sentBytes':sent,'inputBytes':len(payload),
             'counts':counts,'eof':eof,'complete':all(eof.values()),
             'exception':type(error).__name__,'sendError':send_error,'replayAllowed':False})
        raise failure from error
    finally:
        selector.close()
        for pipe in (process.stdin, process.stdout, process.stderr):
            if not pipe.closed: pipe.close()


def _raw(argv):
    if isinstance(argv, PlannedArgv):
        raise AutomaticProgramError("automatic_bootstrap_command_size")
    if command_bytes(argv) > COMMAND_BYTES:
        raise AutomaticProgramError("unbound_oversized_command")
    return argv


@contextmanager
def automatic_submission(argv, *, prelaunch_refusal=None):
    """Stage a bound long carrier before its existing owner's one submission."""
    if not isinstance(argv, PlannedArgv):
        yield _raw(argv)
        return
    argv.check_source_lifetime()
    if not coordinator_capable():
        raise AutomaticProgramError('automatic_unsupported_coordinator')
    transport = _transport()
    config = transport.load_config(Path(argv.root))
    prefix, raw, arguments = _program(argv.command)
    held = _new_custody()
    try:
        for path, digest in argv.source_pins:
            held.read(path, digest, max_bytes=MAX_PROGRAM_BYTES)
        def guard():
            argv.check_source_lifetime()
            if argv.config_custody is None:
                raise AutomaticProgramError('automatic_private_config_custody_missing')
            argv.config_custody.check()
            held.finish(); held.final_identity_pass()
            current = transport.load_config(Path(argv.root))
            if _config_sha(current) != argv.config_sha or _route_sha(current, argv.host, argv.fresh_direct) != argv.route_sha:
                raise AutomaticProgramError("automatic_configuration_changed")
            rebuilt = transport.build_ssh_argv(current, argv.host, argv.timeout_seconds, argv.command,
                                               argv.ssh_binary, argv.nested_ssh_binary, **({'fresh_direct':True} if argv.fresh_direct else {}))
            actual = rebuilt.original_argv if isinstance(rebuilt, PlannedArgv) else tuple(rebuilt)
            if actual != argv.original_argv:
                raise AutomaticProgramError("automatic_route_changed")
            held.finish(); held.final_identity_pass()
            argv.config_custody.check()
            argv.check_source_lifetime()
        guard()
        root = Path(argv.root)
        parent_fd = held.directory(str(root))
        for path in (root / '.rag_index', root / '.rag_index' / 'ssh-automatic-program'):
            physical = _private_directory(path, parent_fd)
            parent_fd = held.directory(str(path))
            if (os.fstat(parent_fd).st_dev, os.fstat(parent_fd).st_ino) != physical:
                raise AutomaticProgramError('automatic_journal_directory_changed')
            held.finish(); held.final_identity_pass()
        directory = root / '.rag_index' / 'ssh-automatic-program' / argv.correlation
        # A repeated or interrupted automatic submission is never assigned a
        # fresh identity. The original operation retains its own admission too.
        os.mkdir(argv.correlation, mode=0o700, dir_fd=parent_fd)
        directory_fd = held.directory(str(directory))
        held.finish(); held.final_identity_pass()
        def write(name, contents):
            _write(directory, name, contents, directory_fd=directory_fd)
        if prelaunch_refusal is not None:
            proof = prelaunch_refusal
            if (not isinstance(proof, transport.PrelaunchE2Big) or proof.errno != errno.E2BIG or
                    proof.child_handle_returned is not False or proof.executable_started is not False or
                    proof.argv_sha256 != transport.argv_sha256(argv)):
                raise AutomaticProgramError('automatic_prelaunch_refusal_invalid')
            evidence = {'errno':proof.errno,'childCreated':False,'programStarted':False,
                'originalArgvSha256':proof.argv_sha256,'replayAllowed':False}
            write('prelaunch-refusal.json', _json(evidence))
            write('file-fallback-intent.json', _json({'correlationId':argv.correlation,
                'refusalSha256':_sha(_json(evidence)),'programSha256':_sha(raw),'programBytes':len(raw),
                'originalArgvBytes':command_bytes(argv.original_argv),
                'originalArgumentBytes':transport.argv_byte_sizes(argv),'replayAllowed':False}))
        write('program.source', raw)
        held.read(str(directory / 'program.source'), _sha(raw), max_bytes=MAX_PROGRAM_BYTES)
        write('intent.json', _json({'schemaVersion':1,'correlationId':argv.correlation,
                 'host':argv.host,'programSha256':_sha(raw),'programBytes':len(raw),
                 'originalArgvSha256':_sha(_json(argv.original_argv)), 'replayAllowed':False}))
        is_privileged = prefix[0] in ('sudo', '/usr/bin/sudo')
        ordinary_prefix = _privileged().receiver_prefix(prefix) if is_privileged else prefix
        stage_command = (*ordinary_prefix, '-c', _carrier(_RECEIVER), argv.correlation, str(len(raw)), _sha(raw))
        stage_argv = _raw(transport.build_ssh_argv(config, argv.host, argv.timeout_seconds, stage_command,
                                                  argv.ssh_binary, argv.nested_ssh_binary, **({'fresh_direct':True} if argv.fresh_direct else {})))
        guard()
        try:
            receipt_raw = _stage(stage_argv, raw, max(30, argv.timeout_seconds))
            write('stage.stdout', receipt_raw)
            write('stage.stderr', b'')
            write('stage.observation.json', _json({'returnCode':0,'sentBytes':len(raw),
                'inputBytes':len(raw),'counts':{'stdout':len(receipt_raw),'stderr':0},
                'eof':{'stdout':True,'stderr':True},'complete':True,'replayAllowed':False}))
            guard()
            receipt = json.loads(receipt_raw)
            expected = {'schemaVersion','correlationId','directory','identity','programSha256','programBytes','generation','directoryIdentity'}
            identity = receipt.get('identity') if isinstance(receipt, dict) else None
            if (not isinstance(receipt, dict) or set(receipt) != expected or receipt['schemaVersion'] != 1
                    or receipt['correlationId'] != argv.correlation or receipt['programSha256'] != _sha(raw)
                    or receipt['programBytes'] != len(raw) or not isinstance(identity, dict)
                    or set(identity) != {'uid','principal','home','boot'}
                    or type(identity['uid']) is not int or identity['uid'] < 0
                    or identity['principal'] != config.hosts[argv.host].user
                    or not isinstance(identity['home'],str) or not identity['home'].startswith('/') or len(identity['home'])>4096
                    or not isinstance(identity['boot'],str) or len(identity['boot']) != 36
                    or not isinstance(receipt['generation'], list) or len(receipt['generation']) != 9
                    or not isinstance(receipt['directoryIdentity'], list) or len(receipt['directoryIdentity']) != 5
                    or not isinstance(receipt['directory'], str) or len(receipt['directory'])>4096
                    or not receipt['directory'].endswith('/vpn-control-auto-'+argv.correlation)):
                raise AutomaticProgramError('automatic_stage_unknown_receipt')
            write('staged.json', _json(receipt))
            if not is_privileged:
                execution = (*prefix, '-c', _carrier(_LOADER), _json(receipt).decode(), *arguments)
            else:
                privileged = _privileged()
                password = privileged.split_prefix(prefix)[2]
                execution = privileged.execution_command(prefix, privileged.loader(_COMMON, password=password),
                    _json(receipt).decode(), arguments, argv.correlation, argv.timeout_seconds)
            submitted = _raw(transport.build_ssh_argv(config, argv.host, argv.timeout_seconds,
                execution, argv.ssh_binary, argv.nested_ssh_binary, **({'fresh_direct':True} if argv.fresh_direct else {})))
            guard()
            write('execution-intent.json', _json({'replayAllowed':False,'receiptSha256':_sha(_json(receipt))}))
            guard()
            yield submitted
            guard()
            write('submission-returned.json', _json({'replayAllowed':False}))
        except BaseException as error:
            evidence = getattr(error, 'stage_evidence', None)
            if evidence is not None:
                write('stage.stdout', evidence[0])
                write('stage.stderr', evidence[1])
                write('stage.observation.json', _json(evidence[2]))
            write('unknown.json', _json({'state':'unknown','replayAllowed':False}))
            raise
    finally:
        held.close()


class SubmittedProcess:
    """One child; the collector explicitly closes custody after its own drain."""
    def __init__(self, argv, *, prelaunch_refusal=None, **kwargs):
        self._context = automatic_submission(argv, prelaunch_refusal=prelaunch_refusal)
        self._closed = False
        self._unknown = False
        self._pipe_names = tuple(name for name in ('stdin','stdout','stderr') if kwargs.get(name) == subprocess.PIPE)
        submitted = self._context.__enter__()
        try:
            self._child = subprocess.Popen(submitted, **kwargs)
        except BaseException as error:
            self._closed = True
            self._unknown = True
            self._context.__exit__(type(error), error, error.__traceback__)
            raise

    def finish(self, *, failed=False):
        if self._closed:
            if self._unknown and not failed:
                raise AutomaticProgramError('automatic_execution_unknown')
            return
        # Child exit alone does not establish complete stdout/stderr custody.
        # The existing collector calls finish only after it seals those streams.
        requested_failure = failed
        failed = (failed or self._unknown or self._child.poll() is None or
                  any(not getattr(self._child, name).closed for name in self._pipe_names))
        self._closed = True
        self._unknown = failed
        if failed:
            error = AutomaticProgramError('automatic_execution_unknown')
            self._context.__exit__(type(error), error, None)
            if not requested_failure:
                raise error
            return
        try:
            self._context.__exit__(None, None, None)
        except BaseException:
            self._unknown = True
            raise

    def __getattr__(self, name):
        return getattr(self._child, name)

    def poll(self):
        return self._child.poll()

    def wait(self, *args, **kwargs):
        try:
            return self._child.wait(*args, **kwargs)
        except BaseException:
            self._unknown = True
            raise

    def communicate(self, *args, **kwargs):
        try:
            return self._child.communicate(*args, **kwargs)
        except BaseException:
            self._unknown = True
            raise

    def kill(self):
        self._unknown = True
        return self._child.kill()

    def terminate(self):
        self._unknown = True
        return self._child.terminate()

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        try:
            return self._child.__exit__(*exc)
        finally:
            self.finish(failed=exc[0] is not None)

    def __del__(self):
        # Abandonment never signals a remote actor or advertises complete output.
        # Preserve the unknown local journal; the original child is not replayed.
        try:
            if not self._closed:
                self.finish(failed=True)
        except BaseException:
            pass
