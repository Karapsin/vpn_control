                if index+1>=len(words) or words[index+1].decode('ascii','ignore')!=SPEC['deploymentId']:continue
                pid=int(path.name);start=birth(pid)
                row={'pid':pid,'startTicks':start,'argv':[os.fsdecode(v) for v in words if v],
                     'commandSha256':hashlib.sha256(raw).hexdigest(),'executableGeneration':list(generation(os.stat(path/'exe')))}
                process(row);candidates.append(row)
            except FileNotFoundError:continue
        require(len(candidates)==1,'instance_libvirt_actor_unknown');row=candidates[0]
        owns(row['pid'],root/'disk.qcow2');owns(row['pid'],root/'uefi-vars.fd');return row
    def vm_guard():
        epoch()
        if PROVIDER=='libvirt-windows':
            require(connection.getURI()==URI and domain.UUIDString()==SPEC['deploymentId'] and domain.name()==DOMAIN,'instance_libvirt_identity')
            xml=domain.XMLDesc(libvirt.VIR_DOMAIN_XML_INACTIVE).encode()
            require(hashlib.sha256(xml).hexdigest()==XML_SHA,'instance_libvirt_xml_changed')
            tree=ET.fromstring(xml);sources=tree.findall("devices/disk[@device='disk']/source")
            require(len(sources)==1 and sources[0].get('file')==str(root/'disk.qcow2') and tree.findtext('os/nvram')==str(root/'uefi-vars.fd'),'instance_libvirt_artifacts')
            process(manager)
            actual=os.lstat(SOCKET_PATH)
            require(stat.S_ISSOCK(actual.st_mode) and actual.st_uid==os.geteuid() and not actual.st_mode&0o077 and structure(actual)==socket_pin,'instance_libvirt_socket_changed')
        if current_actor is not None:
            process(current_actor)
            if PROVIDER=='raw-qemu-windows':
                owns(current_actor['pid'],root/'qmp.sock',True)
                mutable=read('mutable-artifacts.json')
                require(set(mutable)=={'disk.qcow2','uefi-vars.fd'},'instance_mutable_receipt')
                for name,pin in mutable.items():
                    require(pin==list(structure(private(root/name))),'instance_mutable_changed')
                    owns(current_actor['pid'],root/name)
                tpm=read('swtpm-started.json');process(tpm);owns(tpm['pid'],root/'swtpm.sock',True)
    def monitor(command,arguments=None):
        vm_guard()
        if PROVIDER=='raw-qemu-windows':return qmp(command,arguments)
        request={'execute':command}
        if arguments is not None:request['arguments']=arguments
        raw=libvirt_qemu.qemuMonitorCommand(domain,json.dumps(request,separators=(',',':')),0)
        require(type(raw)is str and 0<len(raw.encode())<=65536,'instance_monitor_reply')
        value=json.loads(raw);require(type(value)is dict and 'return'in value and 'error'not in value,'instance_monitor_reply')
        vm_guard();return value['return']
    def machine_state():
        vm_guard()
        if PROVIDER=='raw-qemu-windows':
            if current_actor is None:return 'stopped'
            require(qmp('query-uuid')['UUID'].lower()==SPEC['deploymentId'],'instance_machine')
            return qmp('query-status')['status']
        value=domain.state()[0]
        return {1:'running',2:'booting',3:'paused',4:'shutdown',5:'stopped',6:'unhealthy',7:'suspended'}.get(value,'unknown')
    def rpc(command,arguments):
        vm_guard()
        if PROVIDER=='raw-qemu-windows':
            global QGA_PEER_PID,QGA_GUARD
            QGA_PEER_PID=current_actor['pid'];owns(QGA_PEER_PID,root/'qga.sock',True);named=os.lstat(root/'qga.sock')
            def guarded():
                vm_guard();require(os.lstat(root/'qga.sock').st_ino==named.st_ino,'instance_qga_changed')
            QGA_GUARD=guarded
            value=call(str(root/'qga.sock'),command,arguments,_deadline=time.monotonic()+8)
        else:
            request=json.dumps({'execute':command,'arguments':arguments},separators=(',',':'))
            require(len(request.encode())<=262144,'instance_guest_request_bound')
            raw=libvirt_qemu.qemuAgentCommand(domain,request,8,0)
            require(type(raw)is str and 0<len(raw.encode())<=262144,'instance_guest_reply_bound')
            answer=json.loads(raw);require(type(answer)is dict and 'return'in answer and 'error'not in answer,'instance_guest_reply')
            value=answer['return']
        vm_guard();return value
    def read_guest_terminal(name):
        # QGA's bounded base64 envelope is larger than ordinary metadata.
        # Hold the exact private file generation across the entire read.
        path=root/name;named=private(path)
        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
        try:
            info=os.fstat(fd)
            require(generation(info)==generation(named),'instance_receipt_changed')
            require(0<info.st_size<=262144,'instance_guest_reply_bound')
            raw=os.read(fd,262145)
            require(len(raw)==info.st_size and generation(os.fstat(fd))==generation(info)
                    and generation(os.lstat(path))==generation(info),'instance_receipt_changed')
            return json.loads(raw)
        finally:os.close(fd)
    def script(label,source,original=None):
        operation=OPERATION if original is None else original['operationId']
        source_sha=hashlib.sha256(source.encode()).hexdigest()if original is None else original['sourceSha256']
        require(re.fullmatch(r'[a-z][a-z0-9-]{0,79}',label)is not None,'instance_guest_label')
        prefix='readiness-'+operation+'-'+label
        intent_name=prefix+'.intent.json';ack_name=prefix+'.ack.json';terminal_name=prefix+'.terminal.json'
        # These fixed public programs never receive protected stdin. Login and
        # unknown extension modes cannot archive unvalidated controller output.
        retain_public=MODE in {'observe','idle-inventory','reboot','resume','wake_display',
                              'lease-acquire','lease-status','lease-cancel','lease-enroll','lease-enrollment-status',
                              'job-enroll','job-namespace-status','job-start','job-status','job-inventory'}
        observed_name=prefix+'.observed-terminal.json'
        if not os.path.lexists(root/intent_name):
            if original is not None:return {'state':'unsubmitted','reason':'original_admission_absent','replayAllowed':False}
            # New controllers correlate the retained result to this exact request.
            # A QGA PID alone is reusable after an agent/guest restart.
            lines=source.rstrip().splitlines();output=[i for i,line in enumerate(lines)if line.lstrip().startswith('[Console]::WriteLine(')]
            require(output==[len(lines)-1]and lines[-1].startswith('[Console]::WriteLine(')and lines[-1].endswith(')'),'instance_guest_output_program')
            lines[-1]='$VcRaw='+lines[-1][len('[Console]::WriteLine('):-1]
            frame={'schemaVersion':1,'operationId':operation,'label':label,'sourceSha256':source_sha}
            framed='\n'.join(lines)+"\n$VcBody=($VcRaw|ConvertFrom-Json)\n$VcOwner=Get-Process -Id $PID\n"
            framed+="$VcFrame=('"+json.dumps(frame,separators=(',',':'))+"'|ConvertFrom-Json)\n"
            framed+="$VcFrame|Add-Member -NotePropertyName owner -NotePropertyValue (@{pid=$PID;birth=$VcOwner.StartTime.ToFileTimeUtc().ToString()})\n$VcFrame|Add-Member -NotePropertyName result -NotePropertyValue $VcBody\n[Console]::WriteLine(($VcFrame|ConvertTo-Json -Depth 24 -Compress))\n"
            save(intent_name,{'operationId':operation,'label':label,'sourceSha256':source_sha,
                              'hostBoot':CONTEXT['hostBootId'],'actor':current_actor,'replayAllowed':False,'controllerIdentity':frame})
            vm_guard()
            ack=rpc('guest-exec',{'path':'powershell.exe','arg':['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-Command',"$s=[Console]::In.ReadToEnd(); & ([ScriptBlock]::Create($s))"],
                                  'input-data':base64.b64encode(framed.encode()).decode(),'capture-output':True})
            require(type(ack)is dict and set(ack)=={'pid'} and type(ack['pid'])is int and ack['pid']>0,'instance_guest_exec_ack')
            save(ack_name,{'operationId':operation,'label':label,'ack':ack,'replayAllowed':False})
        intent=read(intent_name)
        retain_public=retain_public and type(intent.get('controllerIdentity'))is dict
        require(intent['operationId']==operation and intent['label']==label and intent['sourceSha256']==source_sha
                and intent['hostBoot']==CONTEXT['hostBootId'] and intent['actor']==current_actor,'instance_original_guest_request')
        # Lost admission acknowledgement is never permission to guest-exec again.
        require(os.path.lexists(root/ack_name),'instance_original_guest_ack_unknown')
        ack=read(ack_name);require(ack['operationId']==operation and ack['label']==label and ack['replayAllowed']is False,'instance_guest_exec_ack')
        if os.path.lexists(root/terminal_name):terminal=read_guest_terminal(terminal_name)
        elif retain_public and os.path.lexists(root/observed_name):terminal=read_guest_terminal(observed_name)
        else:
            require(type(intent.get('controllerIdentity'))is dict,'instance_legacy_guest_job_unresolved')
            deadline=time.monotonic()+20
            while True:
                terminal=rpc('guest-exec-status',ack['ack'])
                if terminal.get('exited')is True:break
                require(time.monotonic()<deadline,'instance_original_guest_pending');time.sleep(.2)
            # Validate correlation before admitting the terminal receipt.
        require(type(terminal)is dict and len((json.dumps(terminal,sort_keys=True)+'\n').encode())<=262144,'instance_guest_reply_bound')
        if retain_public and not os.path.lexists(root/observed_name):save(observed_name,terminal)
        require(terminal.get('exited')is True and type(terminal.get('exitcode'))is int and terminal['exitcode']==0 and not terminal.get('out-truncated',False)
                and not terminal.get('err-truncated',False)
                and all(type(terminal[key])is bool for key in ('out-truncated','err-truncated')if key in terminal),'instance_guest_program_failed')
        out=base64.b64decode(terminal.get('out-data',''),validate=True);err=base64.b64decode(terminal.get('err-data',''),validate=True)
        require(not err and 0<len(out)<=65536,'instance_guest_output_bound');value=json.loads(out.decode('utf-8-sig'))
        require(type(value)is dict,'instance_guest_output')
        frame=intent.get('controllerIdentity')
        if frame is not None:
            require(type(frame)is dict and type(frame.get('schemaVersion'))is int and set(frame)=={'schemaVersion','operationId','label','sourceSha256'}
                    and frame=={'schemaVersion':1,'operationId':operation,'label':label,'sourceSha256':source_sha},'instance_guest_controller_identity')
            require(set(value)==set(frame)|{'owner','result'}and type(value.get('schemaVersion'))is int and all(value.get(k)==v for k,v in frame.items())
                    and type(value['owner'])is dict and set(value['owner'])=={'pid','birth'}
                    and type(value['owner']['pid'])is int and value['owner']['pid']==ack['ack']['pid']
                    and type(value['owner']['birth'])is str and re.fullmatch(r'[1-9][0-9]{0,19}',value['owner']['birth'])is not None
                    and int(value['owner']['birth'])<2**64 and type(value['result'])is dict,'instance_guest_controller_identity')
            value=value['result']
        if not os.path.lexists(root/terminal_name):save(terminal_name,terminal)
        vm_guard();return value
    def host_work():
        """Finite original guest/lifecycle receipts; absence never means idle."""
        names=[path.name for path in root.iterdir()]
        require(len(names)<=8192,'instance_work_inventory_bound')
        unresolved=[];terminal_count=0
        guest_prefix=r'(?:qualification-[0-9a-f-]{36}|direct-guest-[0-9a-f-]{36}|readiness-[0-9a-f-]{36}-(?:session|interactive|display|wake-admission|lease-acquire|lease-status|lease-cancel|lease-enroll|idle|(?:job-enroll|job-namespace-status|job-start|job-status|job-inventory)-[0-9a-f]{16}|(?:login-session|login-account|login-admission|login-after)-[0-9a-f]{12}))'
        for name in names:
            if not name.endswith('.intent.json'):continue
            prefix=name.removesuffix('.intent.json')
            if re.fullmatch(guest_prefix,prefix):
                intent=read(name);operation=intent.get('operationId')
                try:
                    ack=read(prefix+'.ack.json');terminal=read_guest_terminal(prefix+'.terminal.json')
                    require(ack.get('operationId')==operation and ack.get('replayAllowed')is False
                            and type(ack.get('ack'))is dict and type(ack['ack'].get('pid'))is int
                            and terminal.get('exited')is True and type(terminal.get('exitcode'))is int,'instance_original_work_pending')
                    terminal_count+=1
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_guest_work_unresolved'})
            elif re.fullmatch(r'readiness-recovery-[0-9a-f]{64}',prefix):
                try:
                    intent=read(name);done=read(prefix+'.result.json')
                    require(done.get('state')=='submitted'and done.get('operationId')==intent.get('operationId'),'instance_original_work_pending')
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_lifecycle_unresolved'})
            elif re.fullmatch(r'direct-(?:pause-resume|resume)-[0-9a-f-]{36}',prefix):
                try:
                    intent=read(name);done=read('direct-pause-resume-'+intent['operationId']+'.result.json')
                    require(done.get('operationId')==intent['operationId']and done.get('sameQemuOwner')is True
                            and done.get('agentRecovered')is True and done.get('after',{}).get('status')=='running','instance_original_work_pending')
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_lifecycle_unresolved'})
            elif name in {'libvirt-start.intent.json','libvirt-define.intent.json','migration-graceful-stop.intent.json','migration-tpm-stop.intent.json'}:
                try:
                    mapped={'libvirt-start.intent.json':'libvirt-start.result.json','libvirt-define.intent.json':'libvirt-defined.result.json',
                            'migration-graceful-stop.intent.json':'migration-graceful-stop.result.json','migration-tpm-stop.intent.json':'migration-graceful-stop.result.json'}
                    done=read(mapped[name])
                    if name.startswith('migration-'):require(done.get('qemuPositiveAbsence')is True and done.get('tpmPositiveAbsence')is True,'instance_original_work_pending')
                    elif name=='libvirt-start.intent.json':require(done.get('state')=='running'and done.get('samePersistedArtifacts')is True,'instance_original_work_pending')
                    else:require(done.get('state')=='defined','instance_original_work_pending')
                except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':name,'reason':'original_lifecycle_unresolved'})
            else:unresolved.append({'receipt':name,'reason':'unclassified_original_intent'})
        if os.path.lexists(root/'secure-intent.json'):
            try:
                original=read('secure-intent.json');ack=read('secure-ack.json');terminal=read('secure-terminal.json')
                require(original.get('operationId')==ack.get('operationId')and terminal.get('exited')is True
                        and type(terminal.get('exitcode'))is int,'instance_original_work_pending')
                terminal_count+=1
            except (OSError,ValueError,KeyError,TypeError):unresolved.append({'receipt':'secure-intent.json','reason':'original_credential_phase_unresolved'})
        return {'visibilityComplete':True,'terminalCount':terminal_count,'unresolved':unresolved}

    def safe_summary(value):
        require(type(value)is dict,'instance_metadata_shape')
        result={}
        for name in ('exited','replayAllowed','settingsChanged'):
            if name in value:require(type(value[name])is bool,'instance_metadata_shape');result[name]=value[name]
        for name in ('exitcode','console','logon'):
            if name in value and value[name]is not None:
                require(type(value[name])is int and -(2**63)<=value[name]<2**64,'instance_metadata_shape');result[name]=value[name]
        for name in ('operationId','recoveryId'):
            if name in value and value[name]is not None:
                require(type(value[name])is str and re.fullmatch(r'[0-9a-f-]{36}|[0-9a-f]{64}',value[name]),'instance_metadata_shape');result[name]=value[name]
        for name,pattern in (('boot',r'[0-9TZ:.-]{20,40}'),('account',r'S-[0-9-]{3,100}')):
            if name in value and value[name]is not None:
                require(type(value[name])is str and re.fullmatch(pattern,value[name]),'instance_metadata_shape');result[name]=value[name]
        for name,allowed in (('state',{'ready','ready-observed','submitted','defined','running','blocked','unknown','credential-submitted','wake-observed','dismiss-observed'}),('phase',{'wake','dismiss'}),('action',{'wake','dismiss'})):
            if name in value:
                result[name]=value[name]if type(value[name])is str and value[name]in allowed else 'unclassified'
        if type(value.get('ack'))is dict and type(value['ack'].get('pid'))is int:
            result['ackPid']=value['ack']['pid']
        if type(value.get('expected'))is dict:
            expected=value['expected'];summary={}
            if type(expected.get('actor'))is dict:
                actor=expected['actor']
                summary['actor']={k:actor[k]for k in ('pid','startTicks')if type(actor.get(k))is int}
            for k in ('hostBoot','controlConnection','boot','console','logon'):
                if k in expected and (type(expected[k])is int or type(expected[k])is str and len(expected[k])<=160):summary[k]=expected[k]
            result['expected']=summary
        # Never emit, decode or hash protected input, protected response bytes,
        # unknown string values, exception messages, or arbitrary metadata keys.
        return result
    def item(name,is_public):
        path=root/name
        if not os.path.lexists(path):return {'name':name,'present':False}
        named=private(path);fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
        try:
            info=os.fstat(fd);require(generation(info)==generation(named)and 0<info.st_size<=262144,'instance_metadata_bound')
            data=os.read(fd,262145)
            require(len(data)==info.st_size and generation(os.fstat(fd))==generation(info)==generation(os.lstat(path)),'instance_metadata_changed')
            value=json.loads(data)
            row={'name':name,'present':True,'generation':list(generation(info)),'summary':safe_summary(value)}
            if is_public:
                row['publicSha256']=hashlib.sha256(data).hexdigest();row['publicBody']=value
            return row
        finally:os.close(fd)
    try:
        epoch();chain()
        lock=os.open(root/'intent.json',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK);limit=time.monotonic()+5
        while True:
            try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);break
            except BlockingIOError:require(time.monotonic()<limit,'instance_operator_busy');time.sleep(.05)
        current_actor=actor();require(current_actor==DIAGNOSTIC_EXPECTED_ACTOR,'instance_original_host_changed')
        held_lock_generation=generation(os.fstat(lock));require(held_lock_generation==generation(os.lstat(root/'intent.json')),'instance_original_lock_changed')
        os.lseek(lock,0,os.SEEK_SET);root_intent_raw=os.read(lock,65537);require(len(root_intent_raw)==held_lock_generation[6]and len(root_intent_raw)<=65536,'instance_original_lock_changed')
        rows=[]
        for intent_name in DIAGNOSTIC_RECEIPTS:
            prefix=intent_name.removesuffix('.intent.json');public=intent_name in DIAGNOSTIC_PUBLIC
            names=[prefix+suffix for suffix in ('.intent.json','.ack.json','.terminal.json','.observed-terminal.json','.result.json','.done.json','.unknown.json','.receipt.json')]
            if intent_name=='libvirt-define.intent.json':names.append('libvirt-defined.result.json')
            values=[]
            for name in names:
                try:values.append(item(name,public))
                except (OSError,ValueError,KeyError,TypeError):values.append({'name':name,'present':os.path.lexists(root/name),'inspection':'unavailable'})
            rows.append({'intent':intent_name,'classification':'unresolved-until-original-protocol-joined','files':values})
        epoch();process(current_actor);closing()
        require(generation(os.fstat(lock))==held_lock_generation==generation(os.lstat(root/'intent.json')),'instance_original_lock_changed')
        print(json.dumps({'schemaVersion':1,'state':'host-metadata-observed','operationId':OPERATION,'machine':SPEC['deploymentId'],'hostBoot':CONTEXT['hostBootId'],'actor':current_actor,'noGuestCalls':True,'noHistoryWrites':True,'rootLockGeneration':list(held_lock_generation),'rootIntentPublicSha256':hashlib.sha256(root_intent_raw).hexdigest(),'records':rows},sort_keys=True))
        return
    except BaseException as error:
        reason=str(error) if type(error)is ValueError and re.fullmatch('instance_[a-z_]{1,64}',str(error)) else 'instance_observation_unknown'
        print(json.dumps({'state':'blocked','operationId':OPERATION,'reason':reason,'errorClass':type(error).__name__,'replayAllowed':False}))
    finally:
        if connection is not None:connection.close()
        if lock is not None:os.close(lock)
        for descriptor in (globals().get('wire',-1),globals().get('partial_wire',-1)):
            if descriptor!=-1:os.close(descriptor)
        for descriptor in reversed(held):os.close(descriptor)

_main()
