def collect_public_failure(cap,request,binding_guard,admitted,transport,failure,module,D,deadline):
 # PUBLIC-only finite source catalogue has already regenerated this exact
 # producer; this is an existing HOST receipt read, never a guest/status call.
 source=failure['source'];command=['python3','-I','-B','-c','import base64;exec(base64.b64decode('+repr(base64.b64encode(source).decode())+'))']
 argv=request.session.hold_result(transport.build_ssh_argv(transport.load_config(D.ROOT),'archlinux',command=command));request.guard();cap.guard();binding_guard();admitted.revalidate()
 cap.save('public-failure-read.intent.json',{'operationId':OP,'sourceSha256':failure['sourceSha256'],'guestSourceSha256':failure['guestSourceSha256'],'hostOnly':True,'guestCall':False,'inputAuthority':False})
 result=None;error=None
 try:
  try:result=transport.run_ssh(argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=min(50,max(.1,deadline-time.monotonic())),check=False)
  except transport.SubmittedResultReadinessChanged as changed:result=changed.take_submitted_result()
 except BaseException as caught:error=caught
 # Every raw callback is saved before parsing or closing guards, with explicit
 # bounds; oversized or lost capture stays unresolved and is never a rerun.
 if result is not None:
  cap.save('public-failure-read.stdout.public',result.stdout[:2097152]);cap.save('public-failure-read.stderr.public',result.stderr[:2097152])
 cap.save('public-failure-read.callback.json',{'returncode':None if result is None else result.returncode,'stdoutBytes':None if result is None else len(result.stdout),'stderrBytes':None if result is None else len(result.stderr),'captureBound':2097152,'overflow':result is not None and (len(result.stdout)>2097152 or len(result.stderr)>2097152),'errorClass':None if error is None else type(error).__name__,'inputAuthority':False,'guestCall':False})
 if error is not None:raise error
 request.guard();cap.guard();binding_guard();admitted.revalidate();need(result is not None and result.returncode==0 and not result.stderr and len(result.stdout)<=1048576,'public_failure_host_read_unknown')
 value=D._json(result.stdout);cap.save('public-failure-read.result.json',value)
 qualification,out,err,records=module.validate(failure,value)
 cap.save('original-failed-guest-stdout.public',out);cap.save('original-failed-guest-stderr.public',err)
 for role,body in records.items():cap.save('original-failed-'+role+'.public.json',body)
 cap.save('public-failure-qualification.json',qualification);request.guard();cap.guard();binding_guard();return qualification
