              "exec(compile(" + repr(bundle_source) + ",'original-installer-host-readers','exec'),COMPONENT_BUNDLE.__dict__)\n")
    values = {"CLAIM_ORIGINAL": original, "HOST_ORIGINAL_SOURCE_SHA": original_sha256,
