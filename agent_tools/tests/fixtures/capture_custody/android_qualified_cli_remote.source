def reject_pairs(pairs):
    value={}
    for k,v in pairs:
        if k in value:raise ValueError('duplicate')
        value[k]=v
    return value

def bounded_envelope(stream, seconds=5):
    fd=stream.fileno();os.set_blocking(fd,False);sel=selectors.DefaultSelector();sel.register(fd,selectors.EVENT_READ)
    raw=bytearray();end=time.monotonic()+seconds
    try:
        while True:
            left=end-time.monotonic()
            if left<=0:raise ValueError('input_deadline')
            if not sel.select(min(.05,left)):continue
            chunk=os.read(fd,min(4097-len(raw),4096))
            if not chunk:break
            raw.extend(chunk)
            if len(raw)>4096:raise ValueError('input_cap')
        return json.loads(bytes(raw),object_pairs_hook=reject_pairs)
    finally:sel.close()

def fixed_inner(config_file,profile):
    return ['ssh','-T','-F',config_file,'-S','none','-o','ControlMaster=no','-o','ControlPersist=no','-o','ProxyCommand=none','-o','PermitLocalCommand=no','-o','ClearAllForwardings=yes','-o','UpdateHostKeys=no','-o','StrictHostKeyChecking=yes','-o','IdentitiesOnly=yes','-o','BatchMode=no','-o','NumberOfPasswordPrompts=1','-o','IdentityAgent=none','-o','PreferredAuthentications=publickey','-o','PasswordAuthentication=no','-o','KbdInteractiveAuthentication=no','-o','ConnectTimeout=10',profile,shlex.join(('python3','-I','-B','-c',PROBE))]

def private_inner(custody,secret_bytes):
    # Private only. Equal-length NUL masking keeps each retained stream <=4096.
    streams={}
    for name in ('stdout','tty'):
        raw=bytes(custody.raw[name])
        if len(raw)>CAP:raise ValueError('inner_capture_cap')
        redactions=raw.count(secret_bytes) if secret_bytes else 0
        if secret_bytes:raw=raw.replace(secret_bytes,b'\0'*len(secret_bytes))
        streams[name]={'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'redactions':redactions,'base64':base64.b64encode(raw).decode('ascii')}
    return streams

def append_final_inner(value,custody,secret_bytes,initial_private):
 # Both snapshots are immutable values for the same original. Keep the initial
 # UNKNOWN/refusal and caps; final evidence does not confer observation success.
 custody.finish_naturally()
 final=custody.snapshot()
 if not custody.closed or not final['complete']:raise ValueError('final_capture_not_terminal')
 value.update(finalInnerCapture=final,
              _operatorPrivateCapture={'initial':initial_private,'final':private_inner(custody,secret_bytes)})
 return value

def remote_main():
 custody=None;secret_bytes=None;phase='input';corr=None;initial_capture=None;initial_private=None
 try:
  corr,config_file,profile,source_sha=sys.argv[1:]
  if re.fullmatch('[0-9a-f]{32}',corr)is None or source_sha!=_DECODED_SOURCE_SHA:raise ValueError('source_binding')
  request=bounded_envelope(sys.stdin.buffer)
  if type(request)is not dict or set(request)!={'passphrase'}:raise ValueError('request_shape')
  secret=request.pop('passphrase')
  if type(secret)is not str or not 0<len(secret.encode())<=512 or any(c in secret for c in ('\r','\n','\0')):raise ValueError('secret_shape')
  phase='gateway_admission';config_file=config_file or str(Path.home()/'.ssh/config')
  spec={'configFile':config_file,'controlPath':'none','remoteHostAlias':profile}
  config_pin=file_pin(config_file,body=True)
  if config_pin['unsupportedConfigDirectives']:raise ValueError('config_dependencies')
  route_pin=effective_route(spec)
  def guard():
   if file_pin(config_file,body=True)!=config_pin or effective_route(spec)!=route_pin:raise ValueError('config_or_keys_changed')
  guard();gateway={'uid':os.getuid(),'boot':Path('/proc/sys/kernel/random/boot_id').read_text().strip()}
  if type(gateway['uid'])is not int or re.fullmatch('[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}',gateway['boot'])is None:raise ValueError('gateway_identity')
  phase='inner_connection';secret_bytes=secret.encode();custody=start_fixed(fixed_inner(config_file,profile),secret_bytes,route_pin['keyMetadata']);secret=None
  result=custody.observe(30);initial_capture=result;initial_private=private_inner(custody,secret_bytes)
  if not result['complete'] or result['refusal']:
   value={'state':'unknown','correlationId':corr,'phase':phase,'innerCapture':result,'gateway':gateway,'nativeActionAllowed':False,'replayAllowed':False}
   value=append_final_inner(value,custody,secret_bytes,initial_private);guard()
   print(json.dumps(value,sort_keys=True),flush=True);return 3
  if result['returnCode']!=0:
   wire=bytes(custody.raw['tty']).lower()
   phase='host_key' if b'host key verification failed' in wire or b'remote host identification has changed'in wire else ('network'if any(x in wire for x in(b'connection refused',b'connection timed out',b'could not resolve',b'no route to host'))else('authentication'if b'permission denied'in wire and(b'publickey'in wire or b'password'in wire)else'unclassified'))
   raise ValueError('fixed_probe_failed')
  if result['credentialSent']is not True:raise ValueError('key_prompt_not_observed')
  arch=json.loads(bytes(custody.raw['stdout']),object_pairs_hook=reject_pairs)
  if type(arch)is not dict or set(arch)!={'uid','boot','androidObservation'}or type(arch['uid'])is not int or arch['uid']!=1000 or type(arch['boot'])is not str or re.fullmatch('[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}',arch['boot'])is None:raise ValueError('arch_identity')
  phase='closing';guard()
  print(json.dumps({'state':'observed','correlationId':corr,'gateway':gateway,'arch':arch,'capture':result,'nativeActionAllowed':False,'replayAllowed':False,'appOrGuestCommands':True,'journalAccess':False},sort_keys=True),flush=True);return 0
 except (OSError,ValueError,KeyError,subprocess.SubprocessError)as e:
  value={'state':'unknown','correlationId':corr,'phase':phase,'errorClass':type(e).__name__,'reason':str(e)if type(e)is ValueError and re.fullmatch('[a-z_]{1,64}',str(e))else'unclassified','errno':getattr(e,'errno',None),'nativeActionAllowed':False,'replayAllowed':False}
  if custody is not None:
   value['innerCapture']=initial_capture if initial_capture is not None else custody.observe(.01)
   if initial_private is None:initial_private=private_inner(custody,secret_bytes)
   value=append_final_inner(value,custody,secret_bytes,initial_private)
  print(json.dumps(value,sort_keys=True),flush=True)
  return 3
if __name__=='__main__':sys.exit(remote_main())
