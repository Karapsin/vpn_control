"""Source packaging and actual durable-owner/QMP once-effect boundaries."""
import ast
import base64
import copy
import hashlib
import inspect
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import threading
import time
import types
import unittest
from uuid import uuid4
from unittest import mock
from agent_tools import readiness_windows_display_phase as phase,readiness_windows_login as login,readiness_windows_login_continuation as continuation


class DisplayPhasePackaging(unittest.TestCase):
    def fixture(self):
        from agent_tools.tests.test_native_vm_spec import request
        spec=request();binding={'provider':'raw-qemu-windows','spec':spec,'setup':{'imageName':'Windows 11 Pro','locale':'en-US','user':'recovery','administrator':'recoveryadmin'},'context':{'hostBootId':str(uuid4()),'pending':[]},'uri':None,'domain':None,'xmlSha256':None}
        operation=str(uuid4());expected={'actor':{'pid':1,'startTicks':2},'hostBoot':binding['context']['hostBootId'],'controlConnection':'qmp:123','boot':'2026-01-01T00:00:00.0000000Z','console':2,'logon':123,'user':'recovery'};sid='S-1-5-21-1-2-3-1000';profile={}
        original=login.program(binding,'login-submit',operation,expected_sid=sid,profile=profile,expected=expected)
        identity={'binding':binding,'operationId':operation,'expectedSid':sid,'profile':profile,'expected':expected}
        barrier={'schemaVersion':1,'operationId':operation,'originalSourceSha256':hashlib.sha256(original).hexdigest(),'originalIdentity':{'expected':expected,'profile':profile,'account':sid,'machine':spec['deploymentId'],'hostBoot':binding['context']['hostBootId'],'user':'recovery'},'root':[1]*5,'lock':[1]*9,'records':{},'wholeAttemptUnsubmitted':False,'credentialOnly':True,'replayAllowed':False}
        return continuation._AuthenticatedOriginal(original,identity,lambda:None),barrier
    def test_complete_parameterized_producer_compiles_and_global_closure(self):
        original,barrier=self.fixture()
        with mock.patch('agent_tools.private_credential_file.SecretFile',side_effect=AssertionError('private open')),mock.patch('agent_tools.ssh_transport.run_ssh',side_effect=AssertionError('remote execution')):wrapper=phase.program(original,barrier)
        tree=ast.parse(wrapper);body=base64.b64decode(ast.literal_eval(tree.body[1].value.args[0]));inner=ast.parse(body);compile(inner,'full display owner','exec')
        self.assertIn(b"'type':'rel'",body.replace(b' ',b''));self.assertNotIn(b'eeb329b5',body);self.assertNotIn(b'942cca12',body)
        inner.body.pop();env={'__name__':'display_owner_preflight','DISPLAY_PRODUCER':body};exec(compile(inner,'display definitions','exec'),env)
        import builtins,dis
        seen=set();missing={}
        def scan(code):
            if code in seen:return
            seen.add(code);names={i.argval for i in dis.get_instructions(code)if i.opname in ('LOAD_GLOBAL','LOAD_NAME')};absent=names-set(env)-set(vars(builtins))
            if absent:missing[code.co_qualname]=sorted(absent)
            for name in names:
                value=env.get(name)
                if isinstance(value,types.FunctionType):scan(value.__code__)
                elif isinstance(value,type)and value.__module__=='display_owner_preflight':
                    for member in vars(value).values():
                        if isinstance(member,staticmethod):member=member.__func__
                        if isinstance(member,types.FunctionType):scan(member.__code__)
            for child in code.co_consts:
                if isinstance(child,types.CodeType):scan(child)
        env['DISPLAY_OWNER']=None
        for helper in ('_display_wake_flow','_display_phase_guard','_display_facts','_DisplayWakeOwner'):value=env[helper];scan(value.__code__)if isinstance(value,types.FunctionType)else[scan(m.__code__)for m in vars(value).values()if isinstance(m,types.FunctionType)]
        self.assertEqual({},missing)
    def test_source_binding_and_typed_schema_are_not_caller_json_overrides(self):
        original,barrier=self.fixture();self.assertEqual(phase.relation(original.identity['operationId']),phase.relation(original.identity['operationId']))
        for key,value in [('schemaVersion',1.0),('originalSourceSha256','0'*64),('originalIdentity',{})]:
            changed=copy.deepcopy(barrier);changed[key]=value
            with self.assertRaises(ValueError):phase.program(original,changed)
        with self.assertRaises(ValueError):phase.program(types.SimpleNamespace(source=original.source,identity=original.identity,guard=lambda:None),barrier)
        for budget in (True,0,181,1.0):
            with self.assertRaises(ValueError):phase.program(original,barrier,budget_seconds=budget)


    def test_original_fixture_complete_global_dependency_preflight(self):
        fixture=object.__new__(DisplayWakeSocketExecution);fixture.root=Path('/owned-disposable-preflight');source=fixture.common();env={'__name__':'original_fixture_preflight'};exec(compile(source,'full original fixture definitions','exec'),env)
        import builtins,dis
        codes=[env['_ProtectedOwner'].start.__code__,env['private_keys'].__code__]
        missing={code.co_qualname:sorted({i.argval for i in dis.get_instructions(code)if i.opname=='LOAD_GLOBAL'}-set(env)-set(vars(builtins)))for code in codes}
        self.assertTrue(all(not values for values in missing.values()),missing)
    def test_loaded_code_mismatch_is_refused_before_build(self):
        original,barrier=self.fixture()
        with mock.patch.object(phase,'_EXECUTING_CODE',None),self.assertRaisesRegex(ValueError,'producer_code_changed'):phase.program(original,barrier)
    def test_source_capsule_rejects_noncanonical_or_identical_inode_replacement(self):
        with tempfile.TemporaryDirectory()as temporary:
            root=Path(temporary);identity={'relation':phase.relation(str(uuid4()))};owner=phase._DisplayWakeOwner(root,identity,b'public fixed producer')
            path=root/(owner.prefix+'.producer.json');canonical=json.dumps({'schemaVersion':1,'source':'public fixed producer'},sort_keys=True,separators=(',',':')).encode();path.write_bytes(canonical+b' ');path.chmod(0o600)
            with self.assertRaisesRegex(ValueError,'source_changed'):owner._source_read()
            path.write_bytes(canonical);owner._source_read()
            try:
                replacement=root/'replacement';replacement.write_bytes(canonical);replacement.chmod(0o600);replacement.replace(path)
                with self.assertRaisesRegex(ValueError,'source_changed'):owner._source_read()
            finally:os.close(owner.source_fd)


@unittest.skipUnless(sys.platform.startswith('linux'),'actual Linux process birth, flock and Unix QMP peer')
class DisplayWakeSocketExecution(unittest.TestCase):
    def setUp(self):
        self.temp=tempfile.TemporaryDirectory(dir='/tmp');self.addCleanup(self.temp.cleanup);self.root=Path(self.temp.name);self.root.chmod(0o700)
        (self.root/'intent.json').write_text('{"owned":"controlled"}\n');(self.root/'intent.json').chmod(0o600)
        self.original=str(uuid4());self.expected={'actor':{'pid':os.getpid(),'startTicks':self.birth(os.getpid())},'hostBoot':Path('/proc/sys/kernel/random/boot_id').read_text().strip(),'controlConnection':'owned-qmp-peer','boot':'2026-01-01T00:00:00.0000000Z','console':2,'logon':123,'user':'recovery'}
        self.sid='S-1-5-21-1-2-3-1000';self.identity={'expected':self.expected,'profile':{},'account':self.sid,'machine':str(uuid4()),'hostBoot':self.expected['hostBoot'],'user':'recovery'}
        tree=ast.parse(self.common());catalog=next(ast.literal_eval(n.value)for n in tree.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='LOGIN_PUBLIC_REASONS'for t in n.targets))
        reason_patch=mock.patch.object(login,'LOGIN_PUBLIC_REASONS',catalog,create=True);reason_patch.start();self.addCleanup(reason_patch.stop)
        self.make_original();self.relation=phase.relation(self.original);self.phase_identity={'relation':self.relation,'expected':self.expected,'account':self.sid,'hostBoot':self.expected['hostBoot'],'barrierSha256':continuation._identity_digest(self.barrier)}
        self.count=0;self.received=threading.Event();self.release=threading.Event();self.release.set();self.stop=threading.Event();self.ack_lost=False;self.errors=[]
        self.listener=socket.socket(socket.AF_UNIX);self.path=self.root/'qmp.sock';self.listener.bind(str(self.path));self.listener.listen();self.listener.settimeout(.1);self.addCleanup(self.listener.close);self.addCleanup(self.stop.set)
        self.state(0)
        def serve():
            try:
                while not self.stop.is_set():
                    try:client,_=self.listener.accept()
                    except socket.timeout:continue
                    with client:
                        wire=client.makefile('rwb',buffering=0);wire.write(b'{"QMP":{"version":{}}}\n')
                        row=json.loads(wire.readline());self.assertEqual({'execute':'qmp_capabilities'},row);wire.write(b'{"return":{}}\n')
                        row=json.loads(wire.readline());self.assertEqual({'execute':'input-send-event','arguments':{'events':[{'type':'rel','data':{'axis':'x','value':1}}]}},row)
                        self.count+=1;self.state(1);self.received.set();self.release.wait(4)
                        if not self.ack_lost:wire.write(b'{"return":{}}\n')
            except (OSError,ValueError,AssertionError)as error:
                if not self.stop.is_set():self.errors.append(type(error).__name__)
        self.thread=threading.Thread(target=serve,daemon=True);self.thread.start();self.addCleanup(self.release.set)
    @staticmethod
    def birth(pid):return int(Path('/proc',str(pid),'stat').read_text().rsplit(')',1)[1].split()[19])
    def state(self,state):
        value={'sessionFacts':{'machine':self.identity['machine'],'ordinary':True,'expectedSid':self.sid,'tokenSid':self.sid,'boot':self.expected['boot'],'console':2,'session':{'SessionId':2,'Logon':123,'User':'recovery','Flags':0,'State':0}},'accountFacts':{'name':'recovery','fullName':'recovery','sid':self.sid,'enabled':True,'loginKeyboard':'00000409'},'displayFacts':{'schemaVersion':1,'machine':self.identity['machine'],'boot':self.expected['boot'],'displayState':state}}
        temporary=self.root/'facts.tmp';temporary.write_text(json.dumps(value));temporary.replace(self.root/'facts.json')
    def common(self):
        value='import os,sys,json,time,fcntl,socket,hashlib,re\nfrom pathlib import Path\n'+login._publication_source()+'\n'
        for helper in (login.PrivateInputUnknown,login.private_keys,login.enter_private,login._ProtectedOwner):value+=inspect.getsource(helper)+'\n'
        value+="LOGIN_PUBLIC_REASONS={'instance_login_screen_unrecognized','instance_login_entry_unknown'}\n_OriginalProtectedOwner=_ProtectedOwner\n"+inspect.getsource(continuation._original_phase)+'\n'
        return value+'root=Path('+repr(str(self.root))+')\n'
    def run_process(self,path,action='start'):
        process=subprocess.Popen([sys.executable,'-I','-B',str(path),action],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        self.addCleanup(lambda:process.poll()is None and process.kill());return process
    def make_original(self):
        source=self.common()+"LOGIN_PUBLIC_REASONS={'instance_login_screen_unrecognized'}\nidentity="+repr(self.identity)+'\noperation='+repr(self.original)+'\n'
        source+="lock=os.open(root/'intent.json',os.O_RDONLY|os.O_NOFOLLOW);fcntl.flock(lock,fcntl.LOCK_EX)\nowner=_ProtectedOwner(root,operation,identity,sys.argv[1],sys.argv[1]);owner.lock=lock\n"
        source+="import io\nvalue=owner.start(lock,[],io.BytesIO(b'\\0\\0\\0\\3A!9'),wait_seconds=2)\nif type(value)is dict:print(json.dumps(value));sys.exit()\n"
        source+="for name in ('wake','dismiss'):\n admitted={'operationId':operation,'phase':name,'expected':identity['expected'],'replayAllowed':False}\n if name=='dismiss':admitted['profile']=identity['profile']['lockscreen']if 'lockscreen'in identity['profile']else{}\n prefix=owner.prefix;owner.prefix='login-preparation-'+operation+'-'+name;owner._save('.intent.json',admitted);owner.prefix=prefix;owner.phase(name)\n"
        self.identity['profile']={'lockscreen':{}};source=source.replace('identity='+repr({**self.identity,'profile':{}}),'identity='+repr(self.identity))
        source+="owner.finish({'state':'blocked','operationId':operation,'reason':'instance_login_screen_unrecognized'});os._exit(0)\n"
        path=self.root/'original.py';path.write_text(source);sha=hashlib.sha256(source.encode()).hexdigest();result=subprocess.run([sys.executable,'-I','-B',str(path),sha],capture_output=True,timeout=4);self.assertEqual(0,result.returncode,result.stderr)
        self.original_terminal=(self.root/('login-owner-'+self.original+'.terminal.json')).read_bytes()
        import fcntl
        lock=os.open(self.root/'intent.json',os.O_RDONLY)
        try:fcntl.flock(lock,fcntl.LOCK_EX);self.barrier=continuation._original_phase(self.root,self.original,self.identity,sha,lock)
        finally:os.close(lock)
    def packet(self,extra=''):
        source=self.common()+inspect.getsource(phase._DisplayWakeOwner).replace('class _DisplayWakeOwner(login._ProtectedOwner):','class _DisplayWakeOwner(_ProtectedOwner):')+'\n'
        for helper in (phase._display_phase_guard,phase._display_facts,phase._display_wake_flow):source+=inspect.getsource(helper)+'\n'
        source+='DISPLAY_IDENTITY='+repr(self.phase_identity)+'\nDISPLAY_BARRIER='+repr(self.barrier)+'\nSPEC='+repr({'deploymentId':self.identity['machine']})+"\nSETUP={'user':'recovery'}\nDISPLAY_SCRIPT='fixed readonly test controller'\n"
        source+="owner=_DisplayWakeOwner(root,DISPLAY_IDENTITY,Path(__file__).read_bytes());DISPLAY_OWNER=owner\nvalue=owner.existing()\nif value is not None:\n if sys.argv[1]=='cancel'and value['state']!='terminal':owner.cancel()\n print(json.dumps(owner.existing()));sys.exit()\nif sys.argv[1]!='start':print(json.dumps({'state':'unsubmitted'}));sys.exit()\nlock=os.open(root/'intent.json',os.O_RDONLY|os.O_NOFOLLOW);fcntl.flock(lock,fcntl.LOCK_EX)\nvalue=owner.start(lock,[],wait_seconds=3,budget_seconds=10)\nif value is not None:print(json.dumps(value));sys.exit()\n"
        source+="def guard():\n peer=Path('/proc',str(DISPLAY_IDENTITY['expected']['actor']['pid']),'stat').read_text().rsplit(')',1)[1].split()\n if int(peer[19])!=DISPLAY_IDENTITY['expected']['actor']['startTicks']:raise ValueError('instance_display_wake_target_changed')\n"
        source+="def script(*args):\n while (root/'getter.gate').exists():owner.guard();time.sleep(.01)\n return json.loads((root/'facts.json').read_text())\n"
        source+="def monitor(command,arguments):\n with socket.socket(socket.AF_UNIX)as sock:\n  sock.settimeout(3);sock.connect(str(root/'qmp.sock'))\n  import struct\n  peer=struct.unpack('3i',sock.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))\n  if peer[0]!=DISPLAY_IDENTITY['expected']['actor']['pid']or peer[1]!=os.getuid():raise ValueError('instance_display_wake_target_changed')\n  wire=sock.makefile('rwb',buffering=0);json.loads(wire.readline());wire.write(b'{\"execute\":\"qmp_capabilities\"}\\n');json.loads(wire.readline());wire.write(json.dumps({'execute':command,'arguments':arguments}).encode()+b'\\n')\n  reply=wire.readline()\n  if not reply:raise EOFError('lost acknowledgement')\n  return json.loads(reply)['return']\n"
        source+='before='+repr({k:self.expected[k]for k in ('actor','hostBoot','controlConnection')})+'\n'+extra+'\n'
        source+="try:packet=_display_wake_flow(root,guard,script,monitor,before)\nexcept BaseException as error:packet={'relation':DISPLAY_IDENTITY['relation'],'state':'cancelled'if str(error)=='instance_display_wake_cancelled'else'blocked','reason':str(error)if type(error)is ValueError else'instance_display_wake_unknown','wakeAttempted':owner.attempted,'inputFieldAuthority':False,'replayAllowed':False}\ntry:owner.finish(packet)\nfinally:os._exit(0)\n"
        compile(source,'complete controlled public display owner','exec');path=self.root/'display.py';path.write_text(source);return path
    def result(self,process):
        out,err=process.communicate(timeout=5);self.assertEqual(0,process.returncode,err);return json.loads(out)
    def terminal(self):
        path=self.root/('display-wake-'+self.relation['operationId']+'.terminal.json');deadline=time.monotonic()+5
        while not path.exists():self.assertLess(time.monotonic(),deadline);time.sleep(.01)
        return json.loads(path.read_text())['packet']
    def test_once_real_qmp_and_status_never_repeat(self):
        path=self.packet();value=self.result(self.run_process(path));self.assertEqual('awake',value['packet']['state']);self.assertEqual(1,self.count)
        self.assertEqual(value,self.result(self.run_process(path,'status')));self.assertEqual(value,self.result(self.run_process(path)));self.assertEqual(1,self.count);self.assertEqual(self.original_terminal,(self.root/('login-owner-'+self.original+'.terminal.json')).read_bytes());self.assertEqual([],self.errors)
    def test_lost_qmp_ack_uses_fresh_facts_without_second_event(self):
        self.ack_lost=True;value=self.result(self.run_process(self.packet()));self.assertEqual('awake',value['packet']['state']);self.assertEqual('lost',value['packet']['acknowledgement']);self.assertEqual(1,self.count)
    def test_client_death_retains_owner_and_terminal(self):
        self.release.clear();process=self.run_process(self.packet());self.assertTrue(self.received.wait(3));process.kill();process.communicate(timeout=2);self.release.set();self.assertEqual('awake',self.terminal()['state']);self.assertEqual(1,self.count)
    def test_cancel_before_pointer_has_no_event(self):
        gate=self.root/'getter.gate';gate.write_text('pause before current getter');path=self.packet();process=self.run_process(path);deadline=time.monotonic()+3
        while not(self.root/('display-wake-'+self.relation['operationId']+'.owner.json')).exists():self.assertLess(time.monotonic(),deadline);time.sleep(.01)
        self.result(self.run_process(path,'cancel'));gate.unlink();self.assertEqual('cancelled',self.result(process)['packet']['state']);self.assertEqual(0,self.count)
    def test_changed_target_refuses_before_pointer_and_changed_source_status_refuses(self):
        path=self.packet("before['actor']={}");value=self.result(self.run_process(path));self.assertEqual('blocked',value['packet']['state']);self.assertEqual(0,self.count)
        path.write_text(path.read_text()+'\n# changed producer\n');process=self.run_process(path,'status');out,err=process.communicate(timeout=3);self.assertNotEqual(0,process.returncode);self.assertEqual(b'',out);self.assertEqual(0,self.count)
    def test_dead_admitted_owner_unknown_never_restarts(self):
        gate=self.root/'getter.gate';gate.write_text('pause');path=self.packet();process=self.run_process(path);owner_path=self.root/('display-wake-'+self.relation['operationId']+'.owner.json');deadline=time.monotonic()+3
        while not owner_path.exists():self.assertLess(time.monotonic(),deadline);time.sleep(.01)
        owner=json.loads(owner_path.read_text());os.kill(owner['pid'],9);self.result(process);value=self.result(self.run_process(path));self.assertEqual('unknown',value['state']);self.assertEqual(0,self.count)

if __name__=='__main__':unittest.main()
