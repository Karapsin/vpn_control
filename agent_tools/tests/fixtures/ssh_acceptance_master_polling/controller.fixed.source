def fingerprint(s):return(s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
def save(path,value):
 fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
 with os.fdopen(fd,'w')as f:json.dump(value,f,sort_keys=True,indent=2);f.flush();os.fsync(f.fileno())
def read(path):return json.loads(Path(path).read_bytes())
def until(predicate,deadline,reason):
 while time.monotonic()<deadline:
  value=predicate()
  if value:return value
  time.sleep(.15)
 raise ValueError(reason)
class SourceHold:
 def __init__(self,path):
  self.path=Path(path);self.fd=os.open(self.path,os.O_RDONLY|os.O_NOFOLLOW)
  try:
   self.info=os.fstat(self.fd);self.raw=os.read(self.fd,self.info.st_size+1)
   if not stat.S_ISREG(self.info.st_mode)or self.info.st_uid!=os.getuid()or self.info.st_nlink!=1 or self.info.st_mode&0o022:raise ValueError('acceptance_public_source_shape')
   self.guard()
  except BaseException:os.close(self.fd);raise
 def guard(self):
  if len(self.raw)!=self.info.st_size or fingerprint(self.info)!=fingerprint(os.fstat(self.fd))or fingerprint(self.info)!=fingerprint(os.lstat(self.path))or os.pread(self.fd,len(self.raw)+1,0)!=self.raw:raise ValueError('acceptance_source_changed')
 def close(self):os.close(self.fd)
class Proxy:
 # Diagnostic receipts contain only bounded phases/counts/numeric errno. Raw
 # forwarded bytes and error strings are never retained by this observer.
 DIAGNOSTIC_LIMIT=32
 def __init__(self,host,port):
  self.upstream=(host,port);self.server=socket.socket();self.server.bind(('127.0.0.1',0));self.server.listen();self.server.settimeout(.1);self.port=self.server.getsockname()[1];self.pairs=[];self.lock=threading.Lock();self.stopped=False
  self.attempt_count=0;self.attempts=[];self.diagnostic_overflow=False
  self.threads=[];self.thread=threading.Thread(target=self.accept,daemon=True);self.thread.start()
 def _attempt(self):
  with self.lock:
   self.attempt_count+=1
   row={'index':self.attempt_count,'connectPhase':'connecting','connectErrno':None,'forwardPhase':'not-started','forwardErrno':None,'direction':None,'eofDirection':None,'clientReads':0,'upstreamReads':0,'clientReadBytes':0,'upstreamReadBytes':0,'forwardErrorClass':None,'clientToUpstreamBytes':0,'upstreamToClientBytes':0,'closed':False}
   if len(self.attempts)<self.DIAGNOSTIC_LIMIT:self.attempts.append(row)
   else:self.diagnostic_overflow=True
   return row
 def _update(self,row,**values):
  with self.lock:row.update(values)
 @staticmethod
 def _errno(error):
  value=getattr(error,'errno',None)
  return value if type(value)is int and 0<=value<=2147483647 else None
 def diagnostic_snapshot(self):
  with self.lock:
   rows=[dict(row)for row in self.attempts]
   return {'schemaVersion':1,'attemptCount':self.attempt_count,'attempts':rows,'capped':self.diagnostic_overflow,'stopped':self.stopped,'listenerClosed':self.server.fileno()==-1,'acceptThreadClosed':not self.thread.is_alive(),'forwardThreadCount':len(self.threads),'liveForwardThreadCount':sum(thread.is_alive()for thread in self.threads),'trafficRetained':False,'forwardedByteCountMeaning':'completed-sendall-only'}
 def accept(self):
  while not self.stopped:
   try:client,_=self.server.accept()
   except socket.timeout:continue
   except OSError:return
   diagnostic=self._attempt()
   try:upstream=socket.create_connection(self.upstream,timeout=10);upstream.settimeout(None)
   except OSError as error:
    self._update(diagnostic,connectPhase='failed',connectErrno=self._errno(error),closed=True);client.close();continue
   self._update(diagnostic,connectPhase='connected')
   pair={'client':client,'upstream':upstream,'closed':False,'peer':list(client.getpeername()),'local':list(client.getsockname()),'diagnostic':diagnostic}
   with self.lock:self.pairs.append(pair)
   thread=threading.Thread(target=self.forward,args=(pair,),daemon=True);self.threads.append(thread);thread.start()
 def forward(self,pair):
  diagnostic=pair['diagnostic'];direction=None;phase='register';selector=None;self._update(diagnostic,forwardPhase=phase)
  try:
   selector=selectors.DefaultSelector()
   selector.register(pair['client'],selectors.EVENT_READ)
   selector.register(pair['upstream'],selectors.EVENT_READ)
   while not self.stopped:
    phase='select';direction=None;self._update(diagnostic,forwardPhase=phase,direction=direction)
    ready=selector.select(.1)
    for key,_ in ready:
     s=key.fileobj
     direction='client-to-upstream'if s is pair['client']else'upstream-to-client';phase='read';self._update(diagnostic,forwardPhase=phase,direction=direction)
     raw=s.recv(65536)
     with self.lock:
      key='clientReads'if s is pair['client']else'upstreamReads';diagnostic[key]+=1
      key='clientReadBytes'if s is pair['client']else'upstreamReadBytes';diagnostic[key]+=len(raw)
     if not raw:self._update(diagnostic,forwardPhase='eof',eofDirection=direction);return
     phase='write';self._update(diagnostic,forwardPhase=phase,direction=direction)
     (pair['upstream']if s is pair['client']else pair['client']).sendall(raw)
     with self.lock:
      key='clientToUpstreamBytes'if s is pair['client']else'upstreamToClientBytes';diagnostic[key]+=len(raw)
  except (OSError,ValueError)as error:self._update(diagnostic,forwardPhase=phase,direction=direction,forwardErrno=self._errno(error),forwardErrorClass='os-error'if isinstance(error,OSError)else'value-error')
  finally:
   if selector is not None:selector.close()
   pair['closed']=True
   for s in (pair['client'],pair['upstream']):
    try:s.close()
    except OSError:pass
   self._update(diagnostic,closed=True)
 def drop_once(self,path,master):
  with self.lock:live=[p for p in self.pairs if not p['closed']]
  if len(live)!=1:raise ValueError('private_proxy_original_pair_unresolved')
  pair=live[0]
  save(path,{'mode':'direct','masterRecoveryId':master['recoveryId'],'masterActor':master['child']['actor'],'socketPath':master['socketPath'],'proxyLocal':pair['local'],'proxyPeer':pair['peer'],'faultCount':1,'remoteJobSignalAllowed':False})
  for s in (pair['client'],pair['upstream']):
   try:s.shutdown(socket.SHUT_RDWR)
   except OSError:pass
   s.close()
 def close_owned_route(self):
  self.stopped=True;self.server.close()
  for pair in self.pairs:
   for s in (pair['client'],pair['upstream']):
    try:s.close()
    except OSError:pass
  self.thread.join(timeout=1)
  for thread in self.threads:thread.join(timeout=1)
