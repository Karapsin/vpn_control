  save(root/'result.json',{'passed':True,'mode':mode,'operationId':operation,'remoteOwner':original_owner,'originalConnection':old_connection,'renewedConnection':new_connection,'beforeConnectionLoss':before['lines'],'afterConnectionLoss':after['lines'],'afterClientLoss':continued['lines'],'afterServerAndObserverLoss':progressed['lines'],'executions':1,'stdoutLines':args.count,'exactRetainedStreams':True,'freshSdkAndCliEquivalent':True,'terminalSshAcknowledgementLostExactlyOnce':read(root/'ack-loss-once.json'),'rpcActions':all_calls,'currentProductionSourcePins':CRITICAL,'retentionHelperSha256':RETENTION_SHA,'normalSdkRunningGate':True,'allPublicRemoteObservationsRetained':True,'serverSha256':server_sha,'originalHistoriesUnchanged':True,'sharedControlUntouched':True,'noVMOrLifecycleActions':True,'elapsedSeconds':time.monotonic()-started})
  # Every local actor/stream and owned proxy is finally journaled below.
  # Shared/remote masters and remote durable owners are never signalled here.
  print(json.dumps({'passed':True,'mode':mode,'operationId':operation,'receipt':str(root/'result.json'),'elapsedSeconds':time.monotonic()-started}))
 finally:
  finish_local_scope(root,locals())
if __name__=='__main__':
 parser=argparse.ArgumentParser();parser.add_argument('--mode',choices=('direct','nested'),required=True);parser.add_argument('--native-go',action='store_true');parser.add_argument('--budget',type=int,default=600);parser.add_argument('--count',type=int,default=1200);parser.add_argument('--interval',type=float,default=.15);args=parser.parse_args()
 if not 1<=args.count<=2400 or not .1<=args.interval<=.25 or not 120<=args.count*args.interval<=360 or not 240<=args.budget<=900:raise ValueError('acceptance_resource_budget')
 main(args)
