def bounded_cli(argv,root,deadline,keeper,operation,*,source_guard):
 import selectors
 environment={**os.environ,'PYTHONPATH':str(root)}
 source_guard()
 remaining=deadline-time.monotonic()
 if remaining<SDK_RPC_SECONDS:raise ValueError('cli_rpc_budget_exhausted_before_child')
 process=subprocess.Popen(argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,cwd=root,env=environment)
 identity=keeper.actor(process.pid);save(root/'cli-intent.json',{'operationId':operation,'actor':identity,'action':'program-collect','targetReplayAllowed':False})
 selector=selectors.DefaultSelector();buffers={'stdout':bytearray(),'stderr':bytearray()};eof={name:False for name in buffers};limits={'stdout':2097152,'stderr':65536};reason=None
 for name in buffers:
  stream=getattr(process,name);os.set_blocking(stream.fileno(),False);selector.register(stream,selectors.EVENT_READ,name)
 end=min(deadline,time.monotonic()+60)
 try:
  while selector.get_map():
   if time.monotonic()>=end:reason='timeout';break
   for key,_ in selector.select(min(.1,end-time.monotonic())):
    raw=os.read(key.fileobj.fileno(),65536);name=key.data
    if not raw:selector.unregister(key.fileobj);eof[name]=True;continue
    if len(buffers[name])+len(raw)>limits[name]:reason='overflow';break
    buffers[name].extend(raw)
   if reason:break
  if reason:
   # This exact own CLI is observation-only. No remote owner/master signal.
   if process.poll()is None:
    if keeper.actor(process.pid)!=identity:raise ValueError('cli_actor_changed')
    process.terminate()
   try:process.wait(timeout=3)
   except subprocess.TimeoutExpired:
    if keeper.actor(process.pid)!=identity:raise ValueError('cli_actor_changed')
    process.kill();process.wait(timeout=3)
  else:process.wait(timeout=max(.001,end-time.monotonic()))
 finally:
  selector.close()
  for name in buffers:getattr(process,name).close()
  # Fixed harmless program/collect protocol only: no protected input is sent.
  for name,body in buffers.items():
   fd=os.open(root/('cli.'+name),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
   with os.fdopen(fd,'wb')as f:f.write(body);f.flush();os.fsync(f.fileno())
  terminal={'operationId':operation,'actor':identity,'returnCode':process.poll(),'eof':eof,'complete':all(eof.values())and reason is None,'reason':reason,'counts':{name:len(raw)for name,raw in buffers.items()},'parentDescriptorsClosed':True,'remoteJobSignalCount':0}
  save(root/'cli-terminal.json',terminal)
 if reason:raise ValueError('bounded_cli_'+reason)
 return terminal

def finish_local_scope(root,scope):
 """Always seal facts about owned local actors/streams, never infer job death."""
 report={'operationId':scope.get('operation'),'sourceClosing':False,'clients':[],'servers':[],'localObservers':[],'proxy':None,'remoteOwnerSignalled':False,'sharedMasterSignalled':False,'targetReplayAllowed':False}
 proxy_cleanup_attempted=False
 try:
  keeper=scope.get('keeper');producer=scope.get('producer_actor')
  def state(expected,producer_format=False):
   try:
    actual=(producer if producer_format else keeper.actor)(expected['pid'])
    return 'present-original'if actual==expected else 'foreign-generation'
   except (OSError,ValueError,subprocess.SubprocessError):
    check=subprocess.run(['/bin/ps','-p',str(expected['pid']),'-o','pid='],stdin=subprocess.DEVNULL,capture_output=True,timeout=3)
    return 'absent-positive'if check.returncode==1 and check.stdout==check.stderr==b''else'unknown'
  try:
   guard=scope.get('guard')
   if guard is not None:guard();report['sourceClosing']=True
   consumers=scope.get('current_consumers')
   manifest=scope.get('manifest',{})
   report['consumedSources']={}if consumers is None else{relative:manifest[relative]for relative in sorted(consumers())}
   report['capsulePublicFilesHeld']=len(scope.get('capsule_holders',{}))
  except BaseException:report['sourceClosing']=False;report['sourceClosingReason']='held-custody-refused'
  # Parent closes only its own retained log descriptors. A live client/server is
  # recorded UNKNOWN and preserved; this function never signals such actors.
  for process,out,err,label in scope.get('clients',[]):
   row={'label':label,'pid':process.pid,'returnCode':process.poll(),'state':'terminal-reaped'if process.poll()is not None else'live-original-unknown','parentStreamsClosed':False}
   row['parentStreamsClosed']=out.closed and err.closed;report['clients'].append(row)
  for file in sorted(root.glob('*/server-intent.json'))+sorted(root.glob('*/relay-recovery-*/server-intent.json')):
   try:
    value=read(file)
    for role in('serverActor','relayActor'):
     expected=value[role];report['servers'].append({'record':str(file),'role':role,'actor':expected,'state':state(expected,True)})
   except BaseException:report['servers'].append({'record':str(file),'state':'unknown'})
  operation=scope.get('operation');directory=scope.get('directory')
  if directory is not None and(directory/'owner.json').exists():
   try:
    value=read(directory/'owner.json')
    if value['operationId']!=operation:raise ValueError('owner_binding')
    expected=value['actor'];report['localObservers'].append({'record':str(directory/'owner.json'),'actor':expected,'state':state(expected)})
   except BaseException:report['localObservers'].append({'state':'unknown'})
  proxy=scope.get('proxy')
  if proxy is not None:
   # Closing this owned route after success or a failed controller assertion is
   # itself recorded; a failed sentinel remains UNKNOWN, never re-submitted.
   proxy_cleanup_attempted=True
   proxy.close_owned_route();report['proxy']={'listenerAddress':['127.0.0.1',proxy.port],'listenerClosed':proxy.server.fileno()==-1,'acceptThreadClosed':not proxy.thread.is_alive(),'forwardThreadsClosed':all(not t.is_alive()for t in proxy.threads),'pairs':[{'local':pair['local'],'peer':pair['peer'],'clientSocketClosed':pair['client'].fileno()==-1,'upstreamSocketClosed':pair['upstream'].fileno()==-1}for pair in proxy.pairs],'originalJobState':'terminal-verified'if(root/'result.json').exists()else'unknown-preserved','routeEndedDoesNotProveJobEnded':True}
   try:
    snapshot=proxy.diagnostic_snapshot();encoded=json.dumps(snapshot,sort_keys=True,allow_nan=False)
    if len(encoded.encode())>65536:raise ValueError('proxy_diagnostic_bound')
    report['proxy']['diagnostics']=json.loads(encoded)
   except BaseException:report['proxy']['diagnosticsUnavailable']=True;report['proxy']['diagnosticReason']='metadata-observation-failed'
  if(root/'cli-terminal.json').exists():
   try:report['cli']=read(root/'cli-terminal.json')
   except BaseException:report['cli']={'state':'unknown'}
  elif(root/'cli-intent.json').exists():report['cli']={'state':'unknown-original-client','intentRetained':True}
  try:
   own_master=scope.get('master')
   if own_master is not None and(root/'.vm-hosts.local.json').exists():
    observed=own_master.status(root,'gateway');report['ownGatewayMaster']={k:observed.get(k)for k in('state','recoveryId','child','socketPath')}
   if scope.get('mode')=='nested':
    pointer=root/'.rag_index/readiness-nested-channel/archlinux/current.json'
    if pointer.exists():report['ownNestedSelectedReceipt']={'state':'local-receipt-only','pointer':read(pointer),'remoteActorState':'not-probed-during-finally'}
  except BaseException:report['ownMasterState']='unknown-preserved'
 except BaseException:
  report['observationIncomplete']=True;report['observationReason']='owned-observation-failed'
 finally:
  if not proxy_cleanup_attempted and scope.get('proxy')is not None:
   try:scope['proxy'].close_owned_route();report['proxy']={'state':'closed-after-observation-failure'}
   except BaseException:report['proxy']={'state':'owned-close-unresolved'}
  try:
   if scope.get('guard')is not None:scope['guard']()
  except BaseException:report['sourceClosing']=False;report['sourceClosingReason']='final-held-custody-refused'
  client_streams_closed=True;report['clientStreams']=[]
  entries=scope.get('clients',())
  if type(entries)not in(list,tuple):entries=();client_streams_closed=False;report['clientStreamsVisibilityIncomplete']=True
  for index,entry in enumerate(entries):
   pair={'index':index,'streams':{}};pair_closed=True
   for name,position in(('stdout',1),('stderr',2)):
    flags={'flushFailed':False,'fsyncFailed':False,'closeFailed':False,'closed':False}
    try:stream=entry[position]
    except BaseException:pair_closed=False;pair['streams'][name]={'closed':False,'visibilityIncomplete':True};report['clientStreamsVisibilityIncomplete']=True;continue
    try:
     if not stream.closed:stream.flush()
    except BaseException:flags['flushFailed']=True
    try:
     if not stream.closed:os.fsync(stream.fileno())
    except BaseException:flags['fsyncFailed']=True
    try:stream.close()
    except BaseException:flags['closeFailed']=True
    try:flags['closed']=stream.closed is True
    except BaseException:pass
    pair['streams'][name]=flags;pair_closed=pair_closed and flags['closed']
   pair['parentStreamsClosed']=pair_closed;report['clientStreams'].append(pair);client_streams_closed=client_streams_closed and pair_closed
   if index<len(report['clients']):report['clients'][index]['parentStreamsClosed']=pair_closed
  for h in reversed(scope.get('secret_holders',[])):
   try:h.close()
   except BaseException:report['privateCustodyCloseFailed']=True
  for h in reversed(scope.get('holders',[])):
   try:h.close()
   except BaseException:report['publicCustodyCloseFailed']=True
  report['allParentDescriptorsClosed']=not report.get('privateCustodyCloseFailed',False)and not report.get('publicCustodyCloseFailed',False)and client_streams_closed
  # This journal is append-only and finite even if every original outcome remains
  # UNKNOWN. It has no raw exception, private bytes, private length or digest.
  save(root/'final-closure.json',report)

def retained_public_observation(retention,operation,host,prepare,invoke,guard,output_root,label,returned_error_type):
 """Only this controller's fixed public probes; output custody is independent."""
 retention._identity(operation,host)
 with retention._OutputCapture(output_root,label)as capture:
  guard()
  with prepare():
   try:result=invoke()
   except Exception as error:
    if type(error)is returned_error_type:
     result=error.take_submitted_result()
     retention._retain(capture,operation,result)
     raise ValueError('completed_public_observation_readiness_refused')from None
    raise
   receipt=retention._retain(capture,operation,result)
  # Both transport-context cleanup and source closing happen after retention.
  if not receipt['namedCustody']or not capture.named_custody():raise ValueError('public_observation_output_route_changed')
  guard();capture.guard_data()
  if not capture.named_custody():raise ValueError('public_observation_output_route_changed')
  if not receipt['complete']:raise ValueError('public_observation_capture_limit')
  if result.returncode or result.stderr:raise ValueError('owned_readonly_observation_failed')
  return json.loads(result.stdout)

def exact_normal_sdk_status(records,operation,host,server_sha,client_pid):
 """Join the newly spawned normal SDK's immutable request and returned result."""
 expected={'action':'program-status','host':host,'timeout_seconds':15,'identity':{'operationId':operation}}
 if(type(records)is not dict or set(records)!={'client-intent.json','call-intent-00000000.json','call-result-00000000.json','client-result.json'}
    or any(type(value)is not dict for value in records.values())or type(client_pid)is not int or client_pid<=0):raise ValueError('fresh_status_record_scope')
 client=records['client-intent.json'];call=records['call-intent-00000000.json'];wire=records['call-result-00000000.json'];terminal=records['client-result.json']
 if(client.get('request')!=expected or client.get('serverSha256')!=server_sha or type(client.get('clientPid'))is not int or client['clientPid']!=client_pid or client.get('automaticReplay')is not False
    or call.get('request')!=expected or call.get('operationId')!=operation or call.get('automaticReplay')is not False or type(call.get('relayAttempt'))is not int or call['relayAttempt']!=0):raise ValueError('fresh_status_original_request_changed')
 if(terminal.get('state')!='rpc_returned'or terminal.get('operationId')!=operation or terminal.get('host')!=host or terminal.get('toolError')is not False
    or any(type(terminal.get(key))is not int or terminal[key]!=1 for key in('attemptedToolCalls','returnedToolCalls','relayAttempts'))or terminal.get('allRelayAttemptsClosed')is not True):raise ValueError('fresh_status_sdk_terminal_unresolved')
 value=wire.get('structuredContent');content=wire.get('content')
 if(wire.get('isError')is not False or type(value)is not dict or value.get('operationId')!=operation or value.get('host')!=host or value.get('replayAllowed')is not False
    or type(content)is not list or len(content)!=1 or type(content[0])is not dict or content[0].get('type')!='text'or type(content[0].get('text'))is not str or json.loads(content[0]['text'])!=value
