    def test_backend_rederives_fixed_program_before_any_rpc(self):
        obj,qga = self.backend_fixture()
        packet = s.render(self.render_input,U[7],"4"*64)
        packet["program"] += "\nWrite-Output 'foreign'\n"
        packet["programUtf8Sha256"] = b.sha(packet["program"].encode())
