HERE = Path(__file__).resolve().parent
HISTORY = HERE.parent / "windows-main-input-bridge-preparation-v1"
def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path, loader=__import__("importlib.machinery",fromlist=["SourceFileLoader"]).SourceFileLoader(name, str(path)))
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module

b_source = HERE / "main_input_bridge.py"
s_source = HERE / "secure_observer.py"
if os.environ.get("VPN_MAIN_INPUT_BRIDGE_BEFORE") == "1":
    b_source = HISTORY / "initial-local-control-failure-v1/main_input_bridge.py.before.source"
if os.environ.get("VPN_MAIN_INPUT_PARTIAL_BEFORE") == "1":
