    def test_installer_native_file_observer_with_real_files_and_declared_win32_peer(self):
        # Native identity, DACL and GetFinalPathNameByHandle are explicit Win32
        # fixtures. Byte reading, hashing, descriptor ownership and closes use
        # actual owned temporary files. This is not Windows admission.
        from pathlib import PureWindowsPath
        workspace=r"C:\Users\u\workspace";local=r"C:\Users\u\AppData\Local"
        binding=self.expected["taskBinding"];job=U[4]
        cpath,record=pending_module.correlation_path_and_record(workspace,binding,job)
        root=PureWindowsPath(local)/"vpn-control-install-inputs"/job
        package=b"owned finite fixture MSI bytes"
        target=dict(sha256=hashlib.sha256(package).hexdigest(),sizeBytes=len(package),
                    launcher=r"C:\Users\u\VPN\vpn-control.exe",frontendPid=12,frontendStartedAtEpochMillis=3)
        birth="134369000000000011"
        request=dict(version=1,jobId=job,principalSid=SID,ownerPid=11,
            ownerStartedAtEpochMillis=int(birth)//10000-11644473600000,launcher=target["launcher"],
            packageFile=str(root/"package.msi"),packageSha256=target["sha256"],packageSize=len(package),
            stateDirectory=workspace,frontendPid=12,frontendStartedAtEpochMillis=3)
        mapping={};handles={};closed=[]
        def mapped(name):
            name=str(name)
            if name not in mapping:
                mapping[name]=self.directory/("path-"+hashlib.sha256(name.encode()).hexdigest())
            return mapping[name]
        for name,raw in ((cpath,json.dumps(record,separators=(",",":")).encode()),
                         (str(root/"request.json"),json.dumps(request).encode()),(str(root/"package.msi"),package)):
            mapped(name).write_bytes(raw)
        for path in [workspace,*[str(p) for p in PureWindowsPath(cpath).parents],*[str(p) for p in root.parents],str(root)]:
            mapped(path).mkdir(exist_ok=True)
        def create(name,access,share,security,creation,flags,template):
            path=mapped(name);fd=os.open(path,os.O_RDONLY);handles[fd]=str(name);return fd
        def final(fd,buffer,size,flags):
            buffer.value="\\\\?\\"+handles[fd];return len(buffer.value)
        def close(fd):
            os.close(fd);closed.append(fd);return 1
        api=types.SimpleNamespace(CreateFileW=create,GetFinalPathNameByHandleW=final,CloseHandle=close)
        class NativePeer:
            k=api
            def birth(self,handle):return birth
            def identity(self,handle,directory=False):
                st=os.fstat(handle)
                result=dict(volumeSerial=st.st_dev,fileIndex=st.st_ino,attributes=16 if directory else 128)
                if not directory:result.update(sizeBytes=st.st_size,links=st.st_nlink,creationFileTime=str(st.st_ctime_ns),lastWriteFileTime=str(st.st_mtime_ns))
                return result
            def security(self,handle):return dict(ownerSid=SID,sddl="O:"+SID+"D:P(A;;FA;;;"+SID+")")
            def read_blocks(self,handle):
                os.lseek(handle,0,os.SEEK_SET)
                while True:
                    block=os.read(handle,7)
                    if not block:return
                    yield block
        class Owner:
            request=dict(cliPath="fixture-cli",context=dict(ordinarySid=SID,localAppData=local))
            native=NativePeer()
            children=[]
            def guard(self):pass
            def event(self,kind,value):self.observed=(kind,value)
            def park(self,code):raise AssertionError(code)
        owner=Owner();serve=types.SimpleNamespace(owner=owner,pid=11,birth=birth,
            process=types.SimpleNamespace(_handle=1,poll=lambda:None));owner.children=[serve]
        observed=pending_module.observe_installer_files(owner,binding,workspace,serve,target)
        self.assertEqual(observed["correlationRecord"]["record"],record)
        self.assertEqual(observed["packageFile"]["sha256"],target["sha256"])
        self.assertEqual(observed["pendingRequest"]["ownerPid"],11)
        self.assertTrue(owner.pending_installer_read_leases[0]["closed"])
        self.assertEqual(len(closed),len(handles))


