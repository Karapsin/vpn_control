    def test_backend_unknown_parks_original_once_and_preserves_run(self):
        obj,qga = self.backend_fixture()
        packet = s.render(self.render_input,U[7],"4"*64)
        with self.assertRaises(b.Unknown):
            obj.run_current_main_read_only_observer_once(packet)
