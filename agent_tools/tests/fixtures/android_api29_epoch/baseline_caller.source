def encoded(value):return (json.dumps(value,sort_keys=True,separators=(',',':'))+'\n').encode()
def digest(raw):return hashlib.sha256(raw).hexdigest()


def archive(capture,name,raw):
    """Every local evidence file is <=512KiB; the manifest binds full bytes."""
    chunks=[]
    for index,offset in enumerate(range(0,len(raw),CHUNK)):
        child=name+'-'+str(index)+'.private';pin=capture.create(child,raw[offset:offset+CHUNK])
        chunks.append({'name':child,'pin':pin})
    manifest={'bytes':len(raw),'sha256':digest(raw),'chunks':chunks}
    capture.create(name+'-manifest.json',encoded(manifest))
    return manifest


def prepared_only(root,correlation=None):
    """Local factory/archive admission only. It never launches an SSH process."""
    root=Path(root).absolute();correlation=correlation or str(uuid.uuid4())
    uuid.UUID(correlation)
    leaf='android-api29-installer-component-baseline-'+correlation
    folder=root/'.runtime/parity-evidence'/leaf;folder.mkdir(mode=0o700,exist_ok=False)
    capture=authority.AuthorityCapture(root,leaf)
    try:
        paths=set(bundle.FILES)|set(FROZEN)|{
            'agent_tools/tests/test_android_component_command_transport.py',
            'agent_tools/tests/test_android_installer_component_adapter.py',
            'agent_tools/tests/test_android_external_java_component_transport.py',
            'agent_tools/tests/test_android_api29_current_owner_observation.py',
            'agent_tools/ssh_transport.py','agent_tools/windows_diagnostic_authority_capture.py',
            '.runtime/run-api29-installer-component-baseline-once.py',PROOF,
            '.rag_index/native-environments/reservations.json',ssh_transport.CONFIG_FILENAME}
        local={root/name:bundle._read(root/name) for name in sorted(paths)}
        credential_path=root/'.codex/arch-sudo.local'
        credential_raw,credential_pin=bundle._read(credential_path,True)
        if not 0<len(credential_raw)<=513 or b'\0' in credential_raw or b'\r' in credential_raw or b'\n' in credential_raw.rstrip(b'\n'):
            raise ValueError('baseline_credential_unadmitted')
        credential_raw=b''
        for name,sha in FROZEN.items():
            if local[root/name][1]['sha256']!=sha:raise ValueError('baseline_frozen_source_changed')
        raw_proof=local[root/PROOF][0]
        if digest(raw_proof)!=PROOF_SHA:raise ValueError('baseline_original_epoch_proof_changed')
        proof=json.loads(raw_proof)
        if (proof.get('controllerId')!=OWNER or type(proof.get('configurationRevision'))is not int or proof['configurationRevision']!=0 or
            proof.get('correlationId')!='79ed4085-5ed1-4b5d-8bcd-6f642adc86fb' or proof.get('closingGuardsVerified')is not True or
            proof.get('permissionObserved')is not True or proof.get('ownedOperation',{}).get('id')!=OPERATION or
            proof['ownedOperation'].get('final')is not True or proof['ownedOperation'].get('phase')!='succeeded'):
            raise ValueError('baseline_original_current_owner_unproven')
        expected_ledger=proof['records']['operationsAfter']['stdout']['data']['operations']
        if not expected_ledger or any(type(row)is not dict or row.get('final')is not True or row.get('controllerId')!=OWNER for row in expected_ledger):
            raise ValueError('baseline_original_terminal_ledger_unknown')
        registry=json.loads(local[root/'.rag_index/native-environments/reservations.json'][0])
        rows=[row for row in registry['reservations'] if row['id']==RESERVATION]
        if len(rows)!=1:raise ValueError('baseline_owned_reservation_unknown')
        row=rows[0]
        if (row['hostAlias']!='archlinux' or row['environment']!='owned-android-api29-coldboot' or
            row['operator']!='root-android' or row['allocationState'] not in ('pending','running')):
            raise ValueError('baseline_owned_reservation_crossed')
        identity={key:row[{'reservationId':'id'}.get(key,key)] for key in ('reservationId','token','hostAlias','environment','operator')}
        owned=observer.prepare(root,identity)
        owned,binding=command.prepare(root,owned,'android-api29')
        tree=ast.parse(owned['program'])
        launch=command.readonly._assignment(tree,'LAUNCH');getter=command.readonly._assignment(tree,'GETTER')
        if launch['intent']['reservation']!=identity or launch['device']!='api29':raise ValueError('baseline_original_launch_crossed')
        review=bundle.reviewed_tree(root);receipt=bundle.prepare(root,folder/'tools',review['treeSha256'])
        request={'host':'archlinux','device':'android-api29','correlationId':correlation,'sourceSha':PRODUCT,
                 'expectedOwner':OWNER,'expectedRevision':0,'expectedAvd':launch['avd'],'expectedApi':29,
                 'packageSha256':getter['packageSha256'],'reservation':identity}
        program=bundle.carrier_source(receipt,owned,correlation)
        root_node=next(node for node in ast.parse(program).body if isinstance(node,ast.Assign) and any(isinstance(target,ast.Name) and target.id=='ROOT' for target in node.targets))
        remote_root=ast.literal_eval(root_node.value.args[0])
        # Fixed result and complete raw evidence collection, even after a failed read.
        suffix='''
