            'originalEpochProofSha256':PROOF_SHA,'toolReceipt':receipt,'commandBinding':binding,
            'programBytes':len(source),'programSha256':digest(source),'argvBytes':sum(len(x.encode())+1 for x in argv),'credentialPin':credential_pin,'rootFileBudget':8388608,
            'installedLauncherAccepted':False,'bundledRuntimeAccepted':False,'acceptanceComplete':False,'replayAllowed':False}))
        os.fsync(capture.fd)
        return {'root':root,'capture':capture,'leaf':leaf,'local':local,'prepared':owned,'receipt':receipt,
                'argv':argv,'source':source,'request':request,'ledger':expected_ledger,'historicalOperation':proof['ownedOperation'],'credentialPath':credential_path,'credentialPin':credential_pin}
    except BaseException:capture.close();raise


def guard(state):
    command.readonly.guard(state['prepared']);bundle.load(state['receipt'])
    for path,pin in state['local'].items():
        if bundle._read(path)!=pin:raise ValueError('baseline_local_source_or_authority_changed')
    if bundle._read(state['credentialPath'],True)[1]!=state['credentialPin']:raise ValueError('baseline_credential_generation_changed')
    state['capture']._check()


def collect(state,credential):
    capture=state['capture'];streams={};process=None;failure=None;payload=bytearray(credential)+state['source'];credential=b''
    try:
        process=subprocess.Popen(state['argv'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        streams={process.stdout:bytearray(),process.stderr:bytearray()}
        deadline=time.monotonic()+1250
        capture.create('handle.json',encoded({'pid':process.pid,'started':time.time(),'deadlineSeconds':1250}))
        os.set_blocking(process.stdin.fileno(),False);opened=list(streams);offset=0;writer=process.stdin
        while opened or writer is not None:
            remaining=deadline-time.monotonic()
            if remaining<=0:raise ValueError('baseline_local_collection_timeout')
            ready,writable,_=select.select(opened,[writer] if writer is not None else [],[],min(remaining,1))
            if writable:
                end=min(offset+65536,len(payload));sent=os.write(writer.fileno(),payload[offset:end])
                if sent<=0:raise ValueError('baseline_stdin_transfer_unknown')
                payload[offset:offset+sent]=b'\0'*sent;offset+=sent
                if offset==len(payload):writer.close();writer=None;payload.clear()
            for stream in ready:
                part=os.read(stream.fileno(),65536)
                if not part:opened.remove(stream);continue
                streams[stream].extend(part)
                if sum(map(len,streams.values()))>STREAM_LIMIT:raise ValueError('baseline_local_collection_limit')
        process.wait(timeout=max(.01,deadline-time.monotonic()))
    except Exception as error:failure=type(error).__name__
    finally:
        payload.clear()
        if process is not None:
            if process.stdin is not None and not process.stdin.closed:process.stdin.close()
            if process.poll()is None:process.kill();process.wait(timeout=5)
            # Retain bytes already in both pipes after a timeout or writer loss.
            remaining_streams=[stream for stream in streams if not stream.closed]
            drain_deadline=time.monotonic()+5
            while remaining_streams and time.monotonic()<drain_deadline:
                ready,_,_=select.select(remaining_streams,[],[],.1)
                for stream in ready:
                    part=os.read(stream.fileno(),65536)
                    if not part:remaining_streams.remove(stream);continue
                    streams[stream].extend(part)
                    if sum(map(len,streams.values()))>STREAM_LIMIT:failure='baseline_local_collection_limit';remaining_streams=[];break
        for name,stream in [('stdout',getattr(process,'stdout',None)),('stderr',getattr(process,'stderr',None))]:
            archive(capture,name,bytes(streams.get(stream,b'')))
            if stream is not None:stream.close()
        capture.create('exit.json',encoded({'returncode':process.returncode if process is not None else None,'failure':failure}))
        os.fsync(capture.fd)
    if process is None or failure is not None or type(process.returncode)is not int or process.returncode!=0:
        raise ValueError('baseline_transport_unknown_raw_retained')
    if streams[process.stderr]:raise ValueError('baseline_ssh_stderr_unknown_raw_retained')
    return bytes(streams[process.stdout])


def parse_terminal(raw,state):
    lines=raw.splitlines()
    if not lines:raise ValueError('baseline_remote_terminal_missing')
    header=json.loads(lines[0]);required={'schema','kind','returncode','failure','hostIdentity','sourceBytes','sourceSha256','stdoutBytes','stdoutSha256','stderrBytes','stderrSha256'}
    if (type(header)is not dict or set(header)!=required or type(header['schema'])is not int or header['schema']!=1 or
        header['kind']!='api29-component-baseline-terminal' or header['sourceBytes']!=len(state['source']) or header['sourceSha256']!=digest(state['source'])):
        raise ValueError('baseline_remote_terminal_unknown_raw_retained')
    identity=header['hostIdentity']
    if type(identity)is not dict or set(identity)!={'uid','euid','gid','egid','groups'} or any(type(identity[key])is not int or identity[key]!=1000 for key in ('uid','euid','gid','egid')) or type(identity['groups'])is not list or len(identity['groups'])>64 or any(type(x)is not int or x<0 for x in identity['groups']):
        raise ValueError('baseline_remote_host_unknown')
    decoded={};offset=1
    for name,label in [('out','stdout'),('err','stderr')]:
        count=header[label+'Bytes']
        if type(count)is not int or not 0<=count<=STREAM_LIMIT:raise ValueError('baseline_remote_stream_size_unknown')
        rows=[]
        for _ in range(math.ceil(count/CHUNK)):
            if offset>=len(lines) or not lines[offset].startswith((name+':').encode()):raise ValueError('baseline_remote_stream_frame_unknown')
            part=base64.b64decode(lines[offset][len(name)+1:],validate=True);offset+=1
            if len(part)>CHUNK:raise ValueError('baseline_remote_stream_chunk_unknown')
            rows.append(part)
        value=b''.join(rows)
        if len(value)!=count or digest(value)!=header[label+'Sha256']:raise ValueError('baseline_remote_stream_changed')
        archive(state['capture'],'remote-'+label,value);decoded[name]=value
    if offset!=len(lines):raise ValueError('baseline_remote_extra_frame_unknown')
    state['capture'].create('remote-terminal.json',encoded(header))
    if type(header['returncode'])is not int or header['returncode']!=0 or header['failure']is not None or decoded['err']:
        raise ValueError('baseline_component_terminal_unknown_raw_retained')
    return decoded['out']


def validate_proof(raw,state):
    value=json.loads(raw)
    if (type(value)is not dict or value.get('schema')!=1 or value.get('kind')!='api29-installer-component-baseline-proof' or
        value.get('request')!=state['request'] or value.get('failure')is not None or value.get('failureDetail')is not None or
        value.get('installedLauncherAccepted')is not False or value.get('bundledRuntimeAccepted')is not False or
        value.get('acceptanceComplete')is not False or type(value.get('records'))is not list):
        raise ValueError('baseline_component_proof_unknown')
    stdin_pin=value.get('carrierSourceStdinPin');initial_pin=value.get('carrierInitialStdinPin')
    if type(initial_pin)is not list or len(initial_pin)!=9 or type(stdin_pin)is not list or len(stdin_pin)!=9 or initial_pin[:6]!=stdin_pin[:6] or stdin_pin[3:6]!=[1000,1000,1] or not stat.S_ISFIFO(stdin_pin[2]) or value.get('admittedFileLimit')!=[8388608,8388608] or type(value.get('originalFileLimit'))is not list or len(value['originalFileLimit'])!=2:
        raise ValueError('baseline_carrier_limits_or_stdin_unknown')
    result=value.get('baseline')
    if (type(result)is not dict or result.get('state')!='component-installed-baseline-observed' or result.get('phase')!='baseline-read-only' or
        result.get('owner')!=OWNER or type(result.get('revision'))is not int or result['revision']!=0 or
        any(result.get(key)is not False for key in ('installerLeaseGranted','guestMutationPerformed','installedLauncherAccepted','bundledRuntimeAccepted','acceptanceComplete','replayAllowed'))):
        raise ValueError('baseline_component_result_unknown')
    replies=[];seen=set();current_ledgers=[]
    for index,row in enumerate(value['records']):
        if type(row)is not dict or set(row)!={'name','bytes','sha256','pin','rawBase64'} or row['name'] in seen or not re.fullmatch(r'component-guard-(?:read-[0-9]{5}|current-admission)\.json',row['name']):raise ValueError('baseline_evidence_inventory_unknown')
        seen.add(row['name']);content=base64.b64decode(row['rawBase64'],validate=True)
        if type(row['bytes'])is not int or len(content)!=row['bytes'] or digest(content)!=row['sha256'] or row['pin'].get('sha256')!=row['sha256']:
            raise ValueError('baseline_evidence_bytes_changed')
        archive(state['capture'],'guard-record-'+str(index),content)
        evidence=json.loads(content)
        if evidence.get('binding')!=state['request'] or evidence.get('phase')!='baseline-read-only' or evidence.get('installerLeaseGranted')is not False:
            raise ValueError('baseline_evidence_binding_unknown')
        record=evidence.get('record',{})
        if record.get('phase')=='baseline' and record.get('words') in (['status'],['operations','list']):
            reply=json.loads(record['stdoutRaw'])
            if (type(record.get('returncode'))is not int or record['returncode']!=0 or record.get('stderrRaw')!='' or
                reply.get('ok')is not True or reply.get('final')is not True or reply.get('code')!='OK' or
                reply.get('controllerId')!=OWNER or type(reply.get('configurationRevision'))is not int or reply['configurationRevision']!=0):
                raise ValueError('baseline_public_owner_unknown')
            data=reply.get('data')
            if type(data)is not dict:raise ValueError('baseline_public_data_unknown')
            if record['words']==['status']:
                if data.get('runtimeRunning')is not False or data.get('runtimeObservation')!='stopped':raise ValueError('baseline_runtime_not_off')
            else:
                if set(data)!={'scope','operations'} or data['scope']!='android-provider-operations':
                    raise ValueError('baseline_owned_terminal_ledger_unknown')
                current_ledgers.append(data['operations'])
            replies.append(record['words'])
    if 'component-guard-current-admission.json' not in seen or replies.count(['status'])<2 or replies.count(['operations','list'])<1:
        raise ValueError('baseline_public_read_set_incomplete')
    history=operation_history.validate(current_ledgers,owner=OWNER,revision=0,
        historical_operation=state['historicalOperation'])
    return {'state':'read-only-component-baseline-verified','leaf':state['leaf'],'owner':OWNER,'revision':0,
            'operationHistory':history,'historicalEpochProofSha256':PROOF_SHA,'historicalTerminalOperation':OPERATION,'resultSha256':digest(raw),'recordCount':len(seen),
            'installedLauncherAccepted':False,'bundledRuntimeAccepted':False,'acceptanceComplete':False,'replayAllowed':False}


def main():
    state=prepared_only(ROOT);capture=state['capture']
    try:
        print(json.dumps({'state':'prepared-read-only-baseline','leaf':state['leaf']}),flush=True)
        credential,credential_pin=bundle._read(state['credentialPath'],True)
        if credential_pin!=state['credentialPin']:raise ValueError('baseline_credential_generation_changed')
        credential=credential.rstrip(b'\n')+b'\n'
        if not 1<len(credential)<=513:raise ValueError('baseline_credential_unadmitted')
        guard(state)
        capture.create('before-dispatch-fence.json',encoded({'request':state['request'],'programBytes':len(state['source']),
            'programSha256':digest(state['source']),'phase':'baseline-read-only','replayAllowed':False}))
        os.fsync(capture.fd)
        raw=collect(state,credential)  # Every stream is durably retained before checks below.
        credential=b''
        proof=parse_terminal(raw,state)
        guard(state)
        summary=validate_proof(proof,state)
        guard(state);capture.create('summary.json',encoded(summary));os.fsync(capture.fd)
        print(json.dumps(summary,sort_keys=True),flush=True)
    finally:
        credential=b''
        capture.close()


if __name__=='__main__':main()
