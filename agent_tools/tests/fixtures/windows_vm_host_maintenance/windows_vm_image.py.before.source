"""Reusable generalized Windows fixture images.

A qualified blank fixture can be generalized once with Windows sysprep and
published read-only on its host. Later fixtures with the same pinned installer,
driver and firmware assets start as copy-on-write clones of that image and run
the exact blank-install specialize/oobeSystem answer file, setup task and guest
agent installation, so qualification and custody stay unchanged. Without a
matching image the caller performs a normal blank installation instead.

The template removes its fixture and temporary OOBE accounts, profiles, setup
state, cached answer files, guest agent and serial driver before generalizing;
nothing that held a fixture credential is captured. Sysprep never runs as SYSTEM
(unsupported; clones then fail their first sign-in): after one restart it runs in
the elevated interactive session of the built-in Administrator, whose one-shot
random logon password is cleared and replaced before sysprep. Images are
identified by their manifest digest and immutable file identities (not rehashed
per clone).
"""
import hashlib,json,re,uuid

STORE_NAME='vpn-control-windows-images'
MAX_IMAGE_AGE_MS=30*24*3600*1000
FINAL_DELAY_SECONDS=180
PROBE_AFTER_SECONDS=FINAL_DELAY_SECONDS+900
# Guest refusals raised before the first guest modification. Only these let a
# later generalize operation retire a refused attempt; everything else is final.
PRE_EFFECT_REFUSALS=('FIXTURE_SYSTEM_REQUIRED','FIXTURE_SETUP_INCOMPLETE','TEMPLATE_INPUT','TEMPLATE_FINAL_SOURCE','TEMPLATE_ANSWER_SOURCE','TEMPLATE_WORK_EXISTS',
                     'TEMPLATE_TASK_EXISTS','TEMPLATE_REBOOT_PENDING','TEMPLATE_VOLUME_ENCRYPTED','TEMPLATE_VOLUME_PROTECTED','TEMPLATE_ADMIN_ACCOUNT',
                     'TEMPLATE_ACCOUNT_UNEXPECTED')
# Schema 6 (F3d): the setup step (SYSTEM, through the guest agent) removes the
# fixture and temporary OOBE accounts, arms one automatic logon of the built-in
# Administrator and restarts; the final step runs sysprep in that elevated
# interactive session after asserting a clean built-in baseline. The host-side
# functions are shipped by source, so they spell this value literally.
SYSPREP_PRINCIPAL='builtin-administrator-interactive'
MAX_IMAGES=32
BOOT_BLANK='order=c,once=d,menu=off'
BOOT_CLONE='order=c,menu=off'

GENERALIZE_FINAL=r'''$ErrorActionPreference='Stop'
$ProgressPreference='SilentlyContinue'
$work=Join-Path $env:WINDIR 'Temp\VpnControlGeneralize'
Start-Transcript -Path (Join-Path $work 'final.log') -NoClobber | Out-Null
$msi=$null;$serial=$null
$key='HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
try {
 # Sysprep is unsupported as SYSTEM: it then skips XAML AppX registration and
 # Explorer fails at the clone's first sign-in (F3d). Only the elevated
 # interactive session of the built-in Administrator generalizes.
 $identity=[Security.Principal.WindowsIdentity]::GetCurrent()
 $session=(Get-Process -Id $PID).SessionId
 if($identity.User.Value -notmatch '^S-1-5-21-\d+-\d+-\d+-500$' -or $session -eq 0 -or -not ([Security.Principal.WindowsPrincipal]::new($identity)).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)){throw 'TEMPLATE_SYSPREP_CONTEXT'}
 Unregister-ScheduledTask -TaskName 'VpnControlGeneralize' -Confirm:$false
 # The one-shot automatic logon and its password leave the template first,
 # including any LSA DefaultPassword secret (an administrator cannot read
 # HKLM\SECURITY, so the documented LSA API clears and then proves absence).
 Set-ItemProperty -LiteralPath $key -Name AutoAdminLogon -Value '0'
 foreach($name in @('DefaultPassword','AutoLogonCount','DefaultUserName','AutoLogonSID')){
  if((Get-ItemProperty -LiteralPath $key).PSObject.Properties.Name -contains $name){Remove-ItemProperty -LiteralPath $key -Name $name}
 }
 Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class VcLogonSecret {
 [StructLayout(LayoutKind.Sequential)] struct Attributes { public int Length; public IntPtr RootDirectory; public IntPtr ObjectName; public int Flags; public IntPtr SecurityDescriptor; public IntPtr QualityOfService; }
 [StructLayout(LayoutKind.Sequential,CharSet=CharSet.Unicode)] struct Name { public ushort Length; public ushort MaximumLength; [MarshalAs(UnmanagedType.LPWStr)] public string Buffer; }
 [DllImport("advapi32.dll")] static extern uint LsaOpenPolicy(IntPtr system,ref Attributes attributes,int access,out IntPtr policy);
 [DllImport("advapi32.dll")] static extern uint LsaStorePrivateData(IntPtr policy,ref Name key,IntPtr data);
 [DllImport("advapi32.dll")] static extern uint LsaRetrievePrivateData(IntPtr policy,ref Name key,out IntPtr data);
 [DllImport("advapi32.dll")] static extern uint LsaFreeMemory(IntPtr buffer);
 [DllImport("advapi32.dll")] static extern uint LsaClose(IntPtr policy);
 public static bool Clear() {
  Attributes attributes=new Attributes();attributes.Length=Marshal.SizeOf(typeof(Attributes));
  IntPtr policy;
  // POLICY_CREATE_SECRET | POLICY_GET_PRIVATE_INFORMATION
  if(LsaOpenPolicy(IntPtr.Zero,ref attributes,0x24,out policy)!=0){return false;}
  try {
   Name key=new Name();key.Buffer="DefaultPassword";key.Length=(ushort)(key.Buffer.Length*2);key.MaximumLength=(ushort)(key.Length+2);
   LsaStorePrivateData(policy,ref key,IntPtr.Zero);
   IntPtr data;uint status=LsaRetrievePrivateData(policy,ref key,out data);
   if(data!=IntPtr.Zero){LsaFreeMemory(data);}
   // STATUS_OBJECT_NAME_NOT_FOUND: no automatic logon secret remains.
   return status==0xC0000034;
  } finally {LsaClose(policy);}
 }
}
'@
 if(-not [VcLogonSecret]::Clear()){throw 'FIXTURE_AUTOLOGON_REMAINS'}
 $bytes=[byte[]]::new(24);[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
 Set-LocalUser -SID $identity.User -Password (ConvertTo-SecureString -String ('Vc1!'+[Convert]::ToBase64String($bytes)) -AsPlainText -Force)
 $bytes=$null
 $setup=Get-Content -LiteralPath (Join-Path $work 'setup.json') -Raw | ConvertFrom-Json
 $bootMs=([DateTimeOffset](Get-CimInstance Win32_OperatingSystem).LastBootUpTime).ToUnixTimeMilliseconds()
 if($bootMs -le [int64]$setup.setupUnixMs){throw 'TEMPLATE_NOT_REBOOTED'}
 foreach($path in @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending','HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired')){
  if(Test-Path -LiteralPath $path){throw 'TEMPLATE_REBOOT_PENDING'}
 }
 # Windows' temporary OOBE account is never captured; one whose profile was
 # still loaded before the restart is removed now (F3d).
 $removed=@()
 foreach($account in @(Get-LocalUser | Where-Object {$_.Name -match '^defaultuser\d+$'})){
  $deadline=[DateTime]::UtcNow.AddSeconds(120)
  while($true){
   $profile=Get-CimInstance Win32_UserProfile -Filter ("SID='"+$account.SID.Value+"'")
   if($null -eq $profile){break}
   if(-not $profile.Loaded){try{Remove-CimInstance -InputObject $profile}catch{}}
   if([DateTime]::UtcNow -ge $deadline){throw 'TEMPLATE_PROFILE_REMAINS'}
   Start-Sleep -Seconds 2
  }
  Remove-LocalUser -SID $account.SID
  $removed+=$account.Name
 }
 # The XAML packages that SYSTEM-context sysprep skips are registered for this user.
 $xaml=@('MicrosoftWindows.Client.CBS','Microsoft.UI.Xaml.CBS','MicrosoftWindows.Client.Core')
 $deadline=[DateTime]::UtcNow.AddMinutes(15)
 while(@($xaml | Where-Object {$name=$_;@(Get-AppxPackage -Name $name | Where-Object {[string]$_.Status -eq 'Ok'}).Count -eq 0}).Count -ne 0){
  if([DateTime]::UtcNow -ge $deadline){throw 'TEMPLATE_XAML_UNREGISTERED'}
  Start-Sleep -Seconds 10
 }
 $deadline=[DateTime]::UtcNow.AddMinutes(100)
 while($true){
  $volume=$null
  try{$volume=Get-CimInstance -Namespace 'root\cimv2\Security\MicrosoftVolumeEncryption' -ClassName Win32_EncryptableVolume -Filter "DriveLetter='C:'"}catch{$volume=$null}
  if($null -eq $volume -or (Invoke-CimMethod -InputObject $volume -MethodName GetConversionStatus).ConversionStatus -eq 0){break}
  if([DateTime]::UtcNow -ge $deadline){throw 'TEMPLATE_DECRYPTION_TIMEOUT'}
  Start-Sleep -Seconds 20
 }
 $msis=@(Get-Volume | Where-Object DriveLetter | ForEach-Object { Join-Path ($_.DriveLetter+':\') 'guest-agent\qemu-ga-x86_64.msi' } | Where-Object { Test-Path -LiteralPath $_ })
 if($msis.Count -ne 1){throw 'GUEST_AGENT_MEDIA'}
 $msi=$msis[0];$serial=Join-Path (Split-Path (Split-Path $msi)) 'vioserial\w11\amd64\vioser.inf'
 if(-not (Test-Path -LiteralPath $serial)){throw 'GUEST_SERIAL_DRIVER'}
 $p=Start-Process msiexec.exe -ArgumentList @('/x',('"'+$msi+'"'),'/qn','/norestart','/l*v',(Join-Path $work 'qga-uninstall.log')) -PassThru -Wait
 if($p.ExitCode -notin @(0,3010)){throw 'TEMPLATE_AGENT_UNINSTALL'}
 foreach($driver in @(Get-WindowsDriver -Online | Where-Object {(Split-Path $_.OriginalFileName -Leaf) -eq 'vioser.inf'})){
  & pnputil.exe /delete-driver $driver.Driver /uninstall /force | Out-Null
  if($LASTEXITCODE -ne 0){throw 'TEMPLATE_SERIAL_REMOVE'}
 }
 if(@(Get-WindowsDriver -Online | Where-Object {(Split-Path $_.OriginalFileName -Leaf) -eq 'vioser.inf'}).Count -ne 0){throw 'TEMPLATE_SERIAL_REMAINS'}
 Remove-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Policies\Microsoft\WindowsStore' -Name AutoDownload -ErrorAction SilentlyContinue
 # Clean built-in baseline, asserted last: only RID 500/501/503/504 accounts,
 # only this Administrator enabled and only its profile, no automatic logon.
 $accounts=@(Get-LocalUser)
 if(@($accounts | Where-Object {$_.SID.Value -notmatch '^S-1-5-21-\d+-\d+-\d+-(500|501|503|504)$' -or ($_.Enabled -and $_.SID.Value -ne $identity.User.Value)}).Count -ne 0){throw 'TEMPLATE_ACCOUNT_REMAINS'}
 $profiles=@(Get-CimInstance Win32_UserProfile | Where-Object {$_.SID -like 'S-1-5-21-*'})
 $listed=@(Get-ChildItem -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList' | Where-Object {$_.PSChildName -like 'S-1-5-21-*'} | ForEach-Object {$_.PSChildName})
 if($profiles.Count -ne 1 -or $profiles[0].SID -ne $identity.User.Value -or $listed.Count -ne 1 -or $listed[0] -ne $identity.User.Value){throw 'TEMPLATE_PROFILE_REMAINS'}
 $folders=@(Get-ChildItem -LiteralPath (Join-Path $env:SystemDrive 'Users') -Force | ForEach-Object {$_.Name})
 if(@($folders | Where-Object {$_ -notin @('All Users','Default','Default User','Public','desktop.ini',(Split-Path -Leaf $profiles[0].LocalPath))}).Count -ne 0){throw 'TEMPLATE_PROFILE_REMAINS'}
 $winlogon=Get-ItemProperty -LiteralPath $key
 if($winlogon.AutoAdminLogon -ne '0' -or @(@('DefaultPassword','AutoLogonCount') | Where-Object {$winlogon.PSObject.Properties.Name -contains $_}).Count -ne 0 -or -not [VcLogonSecret]::Clear()){throw 'FIXTURE_AUTOLOGON_REMAINS'}
 if(Get-ScheduledTask -TaskName 'VpnControlGeneralize' -ErrorAction SilentlyContinue){throw 'TEMPLATE_TASK_REMAINS'}
 $context=[ordered]@{sid=$identity.User.Value;elevated=$true;sessionId=$session;bootUnixMs=$bootMs;setupUnixMs=[int64]$setup.setupUnixMs;temporaryAccountsRemoved=$removed
  accounts=@($accounts | ForEach-Object {$_.Name+':'+$_.SID.Value.Split('-')[-1]+':'+$_.Enabled});usersFolder=$folders;xaml=$xaml}
 [IO.File]::WriteAllText((Join-Path $work 'final-context.json'),($context | ConvertTo-Json -Depth 3),[Text.UTF8Encoding]::new($false))
 $sysprep=Join-Path $env:WINDIR 'System32\Sysprep\sysprep.exe'
 $log=Join-Path $env:WINDIR 'System32\Sysprep\Panther\setuperr.log'
 for($attempt=1;$attempt -le 3;$attempt++){
  # Sysprep powers the machine off only after a successful generalize pass.
  Start-Process -FilePath $sysprep -ArgumentList @('/generalize','/oobe','/shutdown','/quiet','/mode:vm',('/unattend:'+(Join-Path $work 'image-unattend.xml'))) -Wait
  Start-Sleep -Seconds 180
  $names=@()
  if(Test-Path -LiteralPath $log){$names=@(Select-String -LiteralPath $log -Pattern 'Package (\S+) was installed for a user, but not provisioned for all users' | ForEach-Object {$_.Matches[0].Groups[1].Value} | Sort-Object -Unique)}
  if($names.Count -eq 0){break}
  foreach($name in $names){Remove-AppxPackage -Package $name -AllUsers -ErrorAction Continue}
 }
 throw 'TEMPLATE_SYSPREP_REFUSED'
} catch {
 @{state='failed';reason=[string]$_.Exception.Message;time=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json -Compress | Set-Content -LiteralPath (Join-Path $work 'failure.json') -Encoding UTF8
 # Restore observability for the host; the failure record is never success.
 if($serial){& pnputil.exe /add-driver $serial /install | Out-Null}
 if($msi){Start-Process msiexec.exe -ArgumentList @('/i',('"'+$msi+'"'),'/qn','/norestart') -Wait}
 Set-Service -Name QEMU-GA -StartupType Automatic -ErrorAction SilentlyContinue
 Start-Service -Name QEMU-GA -ErrorAction SilentlyContinue
 # Never leave a usable automatic logon behind.
 Set-ItemProperty -LiteralPath $key -Name AutoAdminLogon -Value '0' -ErrorAction SilentlyContinue
 Remove-ItemProperty -LiteralPath $key -Name DefaultPassword -ErrorAction SilentlyContinue
}
'''
GENERALIZE_FINAL_SHA256=hashlib.sha256(GENERALIZE_FINAL.encode('utf-8')).hexdigest()

GENERALIZE_SETUP=r'''$ErrorActionPreference='Stop'
[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false)
if([Security.Principal.WindowsIdentity]::GetCurrent().User.Value -ne 'S-1-5-18'){throw 'FIXTURE_SYSTEM_REQUIRED'}
$state=Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\Setup'
if($state.SystemSetupInProgress -ne 0 -or $state.OOBEInProgress -ne 0){throw 'FIXTURE_SETUP_INCOMPLETE'}
$data=[Console]::In.ReadToEnd() | ConvertFrom-Json
if($data.operationId -cne $OperationId -or $data.finalScript -isnot [string]){throw 'TEMPLATE_INPUT'}
$digest=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($data.finalScript))).Replace('-','').ToLowerInvariant()
if($digest -cne $FinalSha256){throw 'TEMPLATE_FINAL_SOURCE'}
if($data.imageAnswer -isnot [string]){throw 'TEMPLATE_ANSWER_SOURCE'}
$answerDigest=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($data.imageAnswer))).Replace('-','').ToLowerInvariant()
if($answerDigest -cne $AnswerSha256){throw 'TEMPLATE_ANSWER_SOURCE'}
$work=Join-Path $env:WINDIR 'Temp\VpnControlGeneralize'
if(Test-Path -LiteralPath $work){throw 'TEMPLATE_WORK_EXISTS'}
if(Get-ScheduledTask -TaskName 'VpnControlGeneralize' -ErrorAction SilentlyContinue){throw 'TEMPLATE_TASK_EXISTS'}
foreach($path in @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending','HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired')){
 if(Test-Path -LiteralPath $path){throw 'TEMPLATE_REBOOT_PENDING'}
}
# Only the built-in, fixture and temporary OOBE (defaultuserN) accounts may exist.
$admin=@(Get-LocalUser | Where-Object {$_.SID.Value -match '^S-1-5-21-\d+-\d+-\d+-500$'})
if($admin.Count -ne 1){throw 'TEMPLATE_ADMIN_ACCOUNT'}
$admin=$admin[0]
$temporary=@(Get-LocalUser | Where-Object {$_.Name -match '^defaultuser\d+$' -and $_.Name -notin @($ExpectedUser,$ExpectedAdministrator)} | ForEach-Object {$_.Name})
if(@(Get-LocalUser | Where-Object {[int64]($_.SID.Value.Split('-')[-1]) -ge 1000 -and $_.Name -notin (@($ExpectedUser,$ExpectedAdministrator)+$temporary)}).Count -ne 0){throw 'TEMPLATE_ACCOUNT_UNEXPECTED'}
# A generalized image cannot carry volume encryption bound to this TPM.
# Windows 11 enables device encryption by itself; prevent it for every clone
# and start decryption now. The delayed final step waits for full decryption.
$bitlocker='HKLM:\SYSTEM\CurrentControlSet\Control\BitLocker'
if(-not (Test-Path -LiteralPath $bitlocker)){New-Item -Path $bitlocker -Force | Out-Null}
New-ItemProperty -LiteralPath $bitlocker -Name PreventDeviceEncryption -PropertyType DWord -Value 1 -Force | Out-Null
$decrypting=$false
$volume=$null
try{$volume=Get-CimInstance -Namespace 'root\cimv2\Security\MicrosoftVolumeEncryption' -ClassName Win32_EncryptableVolume -Filter "DriveLetter='C:'"}catch{$volume=$null}
if($null -ne $volume -and (Invoke-CimMethod -InputObject $volume -MethodName GetConversionStatus).ConversionStatus -ne 0){
 $started=Invoke-CimMethod -InputObject $volume -MethodName Decrypt
 if($started.ReturnValue -ne 0){throw 'TEMPLATE_DECRYPTION_REFUSED'}
 $decrypting=$true
}
$store='HKLM:\SOFTWARE\Policies\Microsoft\WindowsStore'
if(-not (Test-Path -LiteralPath $store)){New-Item -Path $store -Force | Out-Null}
New-ItemProperty -LiteralPath $store -Name AutoDownload -PropertyType DWord -Value 2 -Force | Out-Null
$key='HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
Set-ItemProperty -LiteralPath $key -Name AutoAdminLogon -Value '0'
foreach($name in @('DefaultPassword','AutoLogonCount','DefaultUserName','AutoLogonSID')){
 if((Get-ItemProperty -LiteralPath $key).PSObject.Properties.Name -contains $name){Remove-ItemProperty -LiteralPath $key -Name $name}
}
# Setup keeps the fixture's answer-file logon password as this LSA secret.
$lsa='HKLM:\SECURITY\Policy\Secrets\DefaultPassword'
if(Test-Path -LiteralPath $lsa){Remove-Item -LiteralPath $lsa -Recurse -Force}
Add-Type -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
public static class FixtureSessions {
 [StructLayout(LayoutKind.Sequential)] struct Info { public int SessionId; public IntPtr Name; public int State; }
 [DllImport("wtsapi32.dll",SetLastError=true,CharSet=CharSet.Unicode,EntryPoint="WTSEnumerateSessionsW")] static extern bool Enumerate(IntPtr server,int reserved,int version,out IntPtr info,out int count);
 [DllImport("wtsapi32.dll",SetLastError=true,CharSet=CharSet.Unicode,EntryPoint="WTSQuerySessionInformationW")] static extern bool Query(IntPtr server,int id,int kind,out IntPtr buffer,out int bytes);
 [DllImport("wtsapi32.dll")] static extern void WTSFreeMemory(IntPtr memory);
 [DllImport("wtsapi32.dll",SetLastError=true)] public static extern bool WTSLogoffSession(IntPtr server,int id,bool wait);
 public static int[] Users() {
  IntPtr info;int count;var result=new List<int>();
  if(!Enumerate(IntPtr.Zero,0,1,out info,out count)){throw new System.ComponentModel.Win32Exception();}
  try {
   int size=Marshal.SizeOf(typeof(Info));
   for(int i=0;i<count;i++){
    var row=(Info)Marshal.PtrToStructure(new IntPtr(info.ToInt64()+i*size),typeof(Info));
    IntPtr buffer;int bytes;
    if(Query(IntPtr.Zero,row.SessionId,5,out buffer,out bytes)){
     try {if(!String.IsNullOrEmpty(Marshal.PtrToStringUni(buffer))){result.Add(row.SessionId);}} finally {WTSFreeMemory(buffer);}
    }
   }
  } finally {WTSFreeMemory(info);}
  return result.ToArray();
 }
}
'@
foreach($id in [FixtureSessions]::Users()){if(-not [FixtureSessions]::WTSLogoffSession([IntPtr]::Zero,$id,$true)){throw 'TEMPLATE_LOGOFF'}}
$deadline=[DateTime]::UtcNow.AddSeconds(90)
while(@([FixtureSessions]::Users()).Count -ne 0){if([DateTime]::UtcNow -ge $deadline){throw 'TEMPLATE_SESSIONS_REMAIN'};Start-Sleep -Seconds 2}
$removed=@()
foreach($name in @($ExpectedUser,$ExpectedAdministrator)){
 $account=Get-LocalUser -Name $name
 $sid=$account.SID.Value
 $deadline=[DateTime]::UtcNow.AddSeconds(120)
 while($true){
  $profile=Get-CimInstance Win32_UserProfile -Filter ("SID='"+$sid+"'")
  if($null -eq $profile){break}
  if(-not $profile.Loaded){try{Remove-CimInstance -InputObject $profile}catch{}}
  if([DateTime]::UtcNow -ge $deadline){throw 'TEMPLATE_PROFILE_REMAINS'}
  Start-Sleep -Seconds 2
 }
 Remove-LocalUser -SID $account.SID
 $removed+=$name
}
# OOBE's defaultuserN is never captured (F3d); a loaded profile waits for the final step.
$temporaryRemoved=@();$temporaryDeferred=@()
foreach($name in $temporary){
 $account=Get-LocalUser -Name $name
 $deadline=[DateTime]::UtcNow.AddSeconds(60)
 while($true){
  $profile=Get-CimInstance Win32_UserProfile -Filter ("SID='"+$account.SID.Value+"'")
  if($null -eq $profile){break}
  $late=[DateTime]::UtcNow -ge $deadline
  if($profile.Loaded){if($late){break}}
  else{try{Remove-CimInstance -InputObject $profile}catch{};if($late){throw 'TEMPLATE_PROFILE_REMAINS'}}
  Start-Sleep -Seconds 2
 }
 if($null -ne $profile){$temporaryDeferred+=$name}else{Remove-LocalUser -SID $account.SID;$temporaryRemoved+=$name}
}
if(@(Get-LocalUser | Where-Object {[int64]($_.SID.Value.Split('-')[-1]) -ge 1000 -and $_.Name -notin $temporaryDeferred}).Count -ne 0){throw 'TEMPLATE_ACCOUNT_REMAINS'}
if(Get-ScheduledTask -TaskName 'VpnControlFixtureInitialize' -ErrorAction SilentlyContinue){Unregister-ScheduledTask -TaskName 'VpnControlFixtureInitialize' -Confirm:$false}
$logs=Join-Path $env:ProgramData 'VpnControlFixture'
if(Test-Path -LiteralPath $logs){Remove-Item -LiteralPath $logs -Recurse -Force}
$caches=@((Join-Path $env:WINDIR 'Panther\unattend.xml'),(Join-Path $env:WINDIR 'Panther\autounattend.xml'),(Join-Path $env:WINDIR 'Panther\Unattend\unattend.xml'),(Join-Path $env:WINDIR 'Panther\Unattend\autounattend.xml'),(Join-Path $env:WINDIR 'System32\Sysprep\unattend.xml'))
foreach($path in $caches){if(Test-Path -LiteralPath $path){Remove-Item -LiteralPath $path -Force}}
if(Get-ScheduledTask -TaskName 'VpnControlFixtureInitialize' -ErrorAction SilentlyContinue){throw 'TEMPLATE_SETUP_TASK_REMAINS'}
if(Test-Path -LiteralPath $logs){throw 'TEMPLATE_SETUP_STATE_REMAINS'}
if(@($caches | Where-Object {Test-Path -LiteralPath $_}).Count -ne 0){throw 'FIXTURE_SETUP_CACHE_REMAINS'}
$winlogon=Get-ItemProperty -LiteralPath $key
if($winlogon.AutoAdminLogon -ne '0' -or $winlogon.PSObject.Properties.Name -contains 'DefaultPassword' -or (Test-Path -LiteralPath $lsa)){throw 'FIXTURE_AUTOLOGON_REMAINS'}
New-Item -ItemType Directory $work | Out-Null
& icacls.exe $work /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)(F)' '*S-1-5-32-544:(OI)(CI)(F)' | Out-Null
if($LASTEXITCODE -ne 0){throw 'TEMPLATE_WORK_ACL'}
$final=Join-Path $work 'final.ps1'
[IO.File]::WriteAllText($final,$data.finalScript,[Text.UTF8Encoding]::new($false))
if((Get-FileHash -LiteralPath $final -Algorithm SHA256).Hash.ToLowerInvariant() -cne $FinalSha256){throw 'TEMPLATE_FINAL_COPY'}
$answer=Join-Path $work 'image-unattend.xml'
[IO.File]::WriteAllText($answer,$data.imageAnswer,[Text.UTF8Encoding]::new($false))
if((Get-FileHash -LiteralPath $answer -Algorithm SHA256).Hash.ToLowerInvariant() -cne $AnswerSha256){throw 'TEMPLATE_ANSWER_COPY'}
[IO.File]::WriteAllText((Join-Path $work 'setup.json'),(@{setupUnixMs=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds();temporaryAccountsDeferred=$temporaryDeferred} | ConvertTo-Json -Compress),[Text.UTF8Encoding]::new($false))
# Sysprep is unsupported as SYSTEM (F3d): the built-in Administrator logs on once after
# a restart (random password made here, never output) and runs the final step.
$bytes=[byte[]]::new(24);[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
$secret='Vc1!'+[Convert]::ToBase64String($bytes);$bytes=$null
Set-LocalUser -SID $admin.SID -Password (ConvertTo-SecureString -String $secret -AsPlainText -Force)
Enable-LocalUser -SID $admin.SID
$computer=(Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\ComputerName\ComputerName').ComputerName
New-ItemProperty -LiteralPath $key -Name DefaultUserName -PropertyType String -Value $admin.Name -Force | Out-Null
New-ItemProperty -LiteralPath $key -Name DefaultDomainName -PropertyType String -Value $computer -Force | Out-Null
New-ItemProperty -LiteralPath $key -Name DefaultPassword -PropertyType String -Value $secret -Force | Out-Null
New-ItemProperty -LiteralPath $key -Name AutoLogonCount -PropertyType DWord -Value 1 -Force | Out-Null
Set-ItemProperty -LiteralPath $key -Name AutoAdminLogon -Value '1'
$secret=$null
$action=New-ScheduledTaskAction -Execute (Join-Path $PSHOME 'powershell.exe') -Argument ('-NoProfile -ExecutionPolicy Bypass -File "'+$final+'"')
$principal=New-ScheduledTaskPrincipal -UserId $admin.SID.Value -LogonType Interactive -RunLevel Highest
$settings=New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Minutes 150)
Register-ScheduledTask -TaskName 'VpnControlGeneralize' -Action $action -Trigger (New-ScheduledTaskTrigger -AtLogOn) -Principal $principal -Settings $settings | Out-Null
& shutdown.exe /r /t $FinalDelaySeconds /c 'VpnControl template restart before sysprep' | Out-Null
if($LASTEXITCODE -ne 0){throw 'TEMPLATE_RESTART'}
[Console]::WriteLine((@{nonce=$OperationId;sysprepPrincipal='builtin-administrator-interactive';accountsRemoved=$removed;temporaryAccountsRemoved=$temporaryRemoved;temporaryAccountsDeferred=$temporaryDeferred;sessionsSignedOut=$true;fixtureAutomaticLogonRemoved=$true;setupStateRemoved=$true;setupCachesRemoved=$true;volumeDecryptionStarted=$decrypting;finalSha256=$digest;finalScheduled=$true;restartScheduled=$true} | ConvertTo-Json -Compress))
'''

GENERALIZE_PROBE=r'''$ErrorActionPreference='Stop'
[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false)
$work=Join-Path $env:WINDIR 'Temp\VpnControlGeneralize'
$failure=$null
if(Test-Path -LiteralPath (Join-Path $work 'failure.json')){$failure=Get-Content -LiteralPath (Join-Path $work 'failure.json') -Raw | ConvertFrom-Json}
$errors=@()
$log=Join-Path $env:WINDIR 'System32\Sysprep\Panther\setuperr.log'
if(Test-Path -LiteralPath $log){$errors=@(Get-Content -LiteralPath $log -Tail 20 | ForEach-Object {[string]$_})}
$percent=$null
try{$volume=Get-CimInstance -Namespace 'root\cimv2\Security\MicrosoftVolumeEncryption' -ClassName Win32_EncryptableVolume -Filter "DriveLetter='C:'";if($null -ne $volume){$percent=(Invoke-CimMethod -InputObject $volume -MethodName GetConversionStatus).EncryptionPercentage}}catch{$percent=$null}
[Console]::WriteLine((@{nonce=$OperationId;failure=$failure;sysprepErrors=$errors;encryptionPercentage=$percent} | ConvertTo-Json -Depth 4 -Compress))
'''


IMAGE_SCHEMA_VERSION=6
# Sysprep does not read a clone's removable-media answer file after
# generalization. The image therefore carries one fixed, secret-free answer file
# (sysprep /unattend) whose specialize step only runs the clone's own
# clone-specialize.ps1 from the VCSETUP volume. That per-clone script embeds the
# clone answer at %WINDIR%\\Panther\\Unattend\\Unattend.xml (discovered at the
# beginning of oobeSystem) and stages the unchanged fixture setup for
# SetupComplete.cmd, because Task Scheduler is not running during this pass.
# RunSynchronousCommand Path is limited to 259 characters (schemas 2/3 failed).
RUN_SYNCHRONOUS_PATH_LIMIT=259
IMAGE_HOOK=("powershell.exe -NoP -EP Bypass -C \"$v=@(Get-Volume -FileSystemLabel VCSETUP);if($v.Count-1){exit 91};"
            "& ($v[0].DriveLetter+':\\clone-specialize.ps1')\"")
IMAGE_FILES=('disk.qcow2','manifest.json','tpm2-00.permall','uefi-vars.fd')
NETWORK_MODES=('restricted',)
CLONE_SPECIALIZE=r'''$ErrorActionPreference='Stop'
$seed=$PSScriptRoot
$answer=Join-Path $env:WINDIR 'Panther\Unattend'
New-Item -ItemType Directory -Force $answer | Out-Null
Copy-Item -LiteralPath (Join-Path $seed 'Autounattend.xml') -Destination (Join-Path $answer 'Unattend.xml') -Force
# Task Scheduler is not running in this pass; the unchanged fixture setup runs
# from SetupComplete.cmd as SYSTEM once Windows Setup has completed.
$scripts=Join-Path $env:WINDIR 'Setup\Scripts'
New-Item -ItemType Directory -Force $scripts | Out-Null
foreach($name in @('initialize.ps1','install-agent.ps1')){Copy-Item -LiteralPath (Join-Path $seed $name) -Destination (Join-Path $scripts $name) -Force}
# Setup no longer needs the clone answer afterwards; its credentials leave the disk.
$command="@echo off`r`npowershell.exe -NoProfile -ExecutionPolicy Bypass -File ""%~dp0initialize.ps1"" > ""%~dp0initialize.log"" 2>&1`r`ndel /f /q ""%WINDIR%\Panther\Unattend\Unattend.xml""`r`n"
[IO.File]::WriteAllText((Join-Path $scripts 'SetupComplete.cmd'),$command,[Text.Encoding]::ASCII)
'''


def image_answer_file(setup):
    """The fixed image answer file; locale settings only, never an account."""
    from xml.etree import ElementTree as ET
    from .windows_vm_unattend import parse_setup
    setup=parse_setup(setup)
    ns='urn:schemas-microsoft-com:unattend';wcm='http://schemas.microsoft.com/WMIConfig/2002/State'
    ET.register_namespace('',ns);ET.register_namespace('wcm',wcm)
    def node(parent,tag,text=None,**attrs):
        e=ET.SubElement(parent,'{'+ns+'}'+tag,attrs)
        if text is not None:e.text=str(text)
        return e
    def component(settings,name):return node(settings,'component',name=name,processorArchitecture='amd64',publicKeyToken='31bf3856ad364e35',language='neutral',versionScope='nonSxS')
    root=ET.Element('{'+ns+'}unattend')
    specialize=node(root,'settings',**{'pass':'specialize'});deploy=component(specialize,'Microsoft-Windows-Deployment')
    command=node(node(deploy,'RunSynchronous'),'RunSynchronousCommand',**{'{'+wcm+'}action':'add'});node(command,'Order',1);node(command,'Path',IMAGE_HOOK)
    oobe=node(root,'settings',**{'pass':'oobeSystem'})
    international=component(oobe,'Microsoft-Windows-International-Core')
    for name in ('InputLocale','SystemLocale','UILanguage','UserLocale'):node(international,name,setup['locale'])
    shell=component(oobe,'Microsoft-Windows-Shell-Setup');screen=node(shell,'OOBE');node(shell,'TimeZone','UTC')
    for name in ('HideEULAPage','HideOnlineAccountScreens','HideWirelessSetupInOOBE'):node(screen,name,'true')
    node(screen,'ProtectYourPC',3)
    return ET.tostring(root,encoding='utf-8',xml_declaration=True).decode('utf-8')


def generalize_source(setup,operation_id):
    """Bind the validated account names and nonce; no credential is involved."""
    from .windows_vm_unattend import parse_setup
    from .windows_vm_guest import quiet_source
    setup=parse_setup(setup)
    if type(operation_id)is not str or str(uuid.UUID(operation_id))!=operation_id:raise ValueError('generalize_identity')
    return quiet_source('$ExpectedUser='+repr(setup['user'])+'\n$ExpectedAdministrator='+repr(setup['administrator'])+'\n$OperationId='+repr(operation_id)
                        +'\n$FinalSha256='+repr(GENERALIZE_FINAL_SHA256)+'\n$AnswerSha256='+repr(hashlib.sha256(image_answer_file(setup).encode('utf-8')).hexdigest())
                        +'\n$FinalDelaySeconds='+str(FINAL_DELAY_SECONDS)+'\n'+GENERALIZE_SETUP)


def probe_template():
    """Read-only failure probe; the host binds one fresh nonce per probe."""
    from .windows_vm_guest import quiet_source
    return quiet_source("$OperationId='__PROBE_ID__'\n"+GENERALIZE_PROBE)


def validate_context_network(value):
    if value not in NETWORK_MODES:raise ValueError('deployment_network')
    return value


def validate_context_image(value):
    if type(value)is not dict or set(value)!={'imageId','manifestSha256'}:raise ValueError('deployment_image')
    if type(value['imageId'])is not str or str(uuid.UUID(value['imageId']))!=value['imageId']:raise ValueError('deployment_image')
    if type(value['manifestSha256'])is not str or re.fullmatch('[0-9a-f]{64}',value['manifestSha256'])is None:raise ValueError('deployment_image')
    return dict(value)


def refusal_token(terminal):
    """Fixed refusal token of a failed guest script's first error message, or None."""
    import base64,re
    if type(terminal)is not dict or terminal.get('exited')is not True or terminal.get('exitcode')in (0,None):return None
    err=base64.b64decode(terminal.get('err-data',''),validate=True)[:65536]
    if err.startswith(b'#< CLIXML'):
        match=re.search(rb'<S S="Error">(.*?)</S>',err,re.S);first=match.group(1) if match else b''
        first=re.sub(rb'_x([0-9A-Fa-f]{4})_',lambda m:bytes([int(m.group(1),16)]) if int(m.group(1),16)<128 else b'?',first).split(b'\n',1)[0]
    else:first=err.split(b'\n',1)[0]
    tokens=re.findall(rb'\b((?:TEMPLATE|FIXTURE|GUEST)_[A-Z_]{2,48})\b',first)
    return tokens[0].decode() if tokens else None


def generalize_instance(spec,setup,operation_id,status_only,root,read,save,process,owns,instance_intent,closing,observed,birth):
    """Prepare and generalize one qualified fixture; the guest powers itself off.

    One create-only intent and guest-exec acknowledgement; status never replays
    them. The guest result must be collected before its agent is removed.
    """
    import base64,hashlib,json,os,re,time,uuid
    global wire,partial_wire,QGA_PEER_PID,QGA_GUARD
    def require(value,reason):
        if not value:raise ValueError(reason)
    def guard_epoch():
        with open('/proc/sys/kernel/random/boot_id')as stream:boot=stream.read(128).strip()
        require(boot==CONTEXT['hostBootId'],'instance_host_epoch');instance_intent();closing()
    def absent(row):
        return _actor_absent(row,process,birth)
    def collect(prefix,script,payload,seconds):
        """Return a retained terminal, or None while the guest command runs."""
        global wire,partial_wire,QGA_PEER_PID,QGA_GUARD
        row=read('qemu-started.json');process(row);owns(row['pid'],root/'qga.sock',True);named=os.lstat(root/'qga.sock')
        wire=partial_wire=-1
        try:
            suffix=os.urandom(12).hex()
            wire=os.open(root/(prefix+'.'+suffix+'.wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
            partial_wire=os.open(root/(prefix+'.'+suffix+'.partial-wire'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
            QGA_PEER_PID=row['pid']
            def guard():
                process(row);require(os.lstat(root/'qga.sock').st_ino==named.st_ino,'instance_qga_changed');guard_epoch()
            QGA_GUARD=guard
            if not os.path.lexists(root/(prefix+'.ack.json')):
                require(script is not None,'instance_guest_exec_ack')
                arguments={'path':'powershell.exe','arg':['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-EncodedCommand',base64.b64encode(script.encode('utf-16le')).decode()],'capture-output':True}
                if payload is not None:arguments['input-data']=base64.b64encode(json.dumps(payload).encode()).decode()
                ack=call(str(root/'qga.sock'),'guest-exec',arguments)
                require(type(ack)is dict and set(ack)=={'pid'} and type(ack['pid'])is int and ack['pid']>0,'instance_guest_exec_ack')
                save(prefix+'.ack.json',{'operationId':operation_id,'ack':ack,'replayAllowed':False})
            receipt=read(prefix+'.ack.json');require(receipt['operationId']==operation_id and receipt['replayAllowed']is False,'instance_guest_exec_ack')
            deadline=time.monotonic()+seconds
            while True:
                terminal=call(str(root/'qga.sock'),'guest-exec-status',receipt['ack'],_deadline=deadline)
                if terminal.get('exited')is True:break
                if time.monotonic()>=deadline:guard();return None
                time.sleep(.2)
            save(prefix+'.terminal.json',terminal);guard();return terminal
        finally:
            for fd in (wire,partial_wire):
                if fd>=0:os.close(fd)
    def output(terminal,bound):
        out=base64.b64decode(terminal.get('out-data',''),validate=True);err=base64.b64decode(terminal.get('err-data',''),validate=True)
        if terminal.get('exited')is True and terminal.get('exitcode')!=0:
            # Project only the script's own fixed refusal token, never free text.
            token=refusal_token(terminal)
            require(False,'instance_generalize_'+(token.lower() if token else 'guest_error'))
        require(terminal.get('exited')is True and terminal.get('exitcode')==0 and not terminal.get('out-truncated',False)
                and not terminal.get('err-truncated',False) and not err and len(out)<=bound,'instance_generalize_output')
        return json.loads(out.decode('utf-8-sig'))
    if not status_only and os.path.lexists(root/'generalize-intent.json'):
        # A previous attempt may be retired only after the guest positively
        # refused it before its first modification; its records are kept.
        prior=read('generalize-intent.json')
        require(prior['operationId']!=operation_id and os.path.lexists(root/'generalize.terminal.json'),'instance_generalize_original_exists')
        require(refusal_token(read('generalize.terminal.json'))in PRE_EFFECT_REFUSALS,'instance_generalize_original_exists')
        retired=root/('generalize-refused-'+prior['operationId']);os.mkdir(retired,0o700)
        for name in ('generalize-intent.json','generalize.ps1','generalize.ack.json','generalize.terminal.json','generalize-submitted.json'):
            if os.path.lexists(root/name):os.rename(root/name,retired/name)
    if not status_only:
        require(not os.path.lexists(root/'generalize-intent.json'),'instance_generalize_original_exists')
        check_id=str(uuid.uuid5(uuid.UUID(operation_id),'generalize-setup-admission'))
        check=qualify_instance(spec,setup,check_id,False,root,read,save,process,owns,instance_intent,closing,observed,GENERALIZE_CHECK_SCRIPT)
        require(check['state']=='setup-observed' and check['setupReady']is True,'instance_generalize_admission')
        save('generalize-intent.json',{'operationId':operation_id,'qualificationId':check_id,'os':check['result']['os'],
                                       'powerShellSha256':hashlib.sha256(GENERALIZE_SCRIPT.encode()).hexdigest(),'finalSha256':GENERALIZE_FINAL_SHA256})
        save('generalize.ps1',GENERALIZE_SCRIPT.encode())
    intent=read('generalize-intent.json');require(intent['operationId']==operation_id,'instance_generalize_identity')
    qemu=read('qemu-started.json');tpm=read('swtpm-started.json')
    if os.path.lexists(root/'generalize-failed.json'):
        # A guest-reported failure is final; a later power-off never turns it into success.
        failed=read('generalize-failed.json');require(failed['operationId']==operation_id,'instance_generalize_identity')
        return {'state':'generalize-failed','operationId':operation_id,'failure':failed['failure'],'sysprepErrors':failed['sysprepErrors'],'productReady':False}
    if os.path.lexists(root/'generalize-stopped.json'):
        stopped=read('generalize-stopped.json');require(stopped['operationId']==operation_id,'instance_generalize_identity')
        return {'state':'generalized-stopped','operationId':operation_id,'qemu':stopped['qemu'],'swtpm':stopped['swtpm'],'positiveAbsence':True,'productReady':False}
    if os.path.lexists(root/'generalize.terminal.json'):terminal=read('generalize.terminal.json')
    else:
        require(not absent(qemu),'instance_generalize_result_unknown')
        guard_epoch()
        terminal=collect('generalize',None if status_only else GENERALIZE_SCRIPT,
                         None if status_only else {'operationId':operation_id,'finalScript':GENERALIZE_FINAL,'imageAnswer':IMAGE_ANSWER},40 if status_only else 25)
        if terminal is None:return {'state':'generalize-pending','operationId':operation_id,'productReady':False}
        save('generalize-submitted.json',{'operationId':operation_id,'collectedAtUnixMs':time.time_ns()//1_000_000})
    result=output(terminal,4096)
    # Sysprep runs in the built-in Administrator's interactive session after a
    # restart, never as SYSTEM (F3d); temporary OOBE accounts are removed.
    temporary=('temporaryAccountsRemoved','temporaryAccountsDeferred')
    require(type(result)is dict and type(result.get('volumeDecryptionStarted'))is bool
            and all(type(result.get(k))is list and all(type(n)is str and re.fullmatch('defaultuser[0-9]{1,9}',n,re.I) for n in result[k]) for k in temporary)
            and len({n.lower() for k in temporary for n in result[k]})==sum(len(result[k]) for k in temporary) and
            {k:v for k,v in result.items()if k not in ('volumeDecryptionStarted',*temporary)}=={'nonce':operation_id,'sysprepPrincipal':'builtin-administrator-interactive',
            'accountsRemoved':[setup['user'],setup['administrator']],'sessionsSignedOut':True,'fixtureAutomaticLogonRemoved':True,'setupStateRemoved':True,
            'setupCachesRemoved':True,'finalSha256':GENERALIZE_FINAL_SHA256,'finalScheduled':True,'restartScheduled':True},
            'instance_generalize_result')
    submitted=read('generalize-submitted.json');require(submitted['operationId']==operation_id,'instance_generalize_identity')
    if absent(qemu):
        # Only the guest's own sysprep power-off counts. A host stop (its intent is
        # saved before QMP quit) also ends QEMU; that disk is never generalized.
        require(not os.path.lexists(root/'stop-intent.json'),'instance_generalize_host_stopped')
        if not absent(tpm):
            # QEMU ended; release only the exact original TPM emulator.
            import signal
            fd=os.pidfd_open(tpm['pid'],0)
            try:process(tpm);signal.pidfd_send_signal(fd,signal.SIGTERM,None,0)
            finally:os.close(fd)
            deadline=time.monotonic()+5
            while not absent(tpm):
                require(time.monotonic()<deadline,'instance_generalize_tpm_running');time.sleep(.05)
        stopped={'operationId':operation_id,'qemu':{k:qemu[k] for k in ('pid','startTicks')},'swtpm':{k:tpm[k] for k in ('pid','startTicks')},
                 'observedAtUnixMs':time.time_ns()//1_000_000}
        save('generalize-stopped.json',stopped)
        return {'state':'generalized-stopped','operationId':operation_id,'qemu':stopped['qemu'],'swtpm':stopped['swtpm'],'positiveAbsence':True,'productReady':False}
    if not status_only:return {'state':'generalize-submitted','operationId':operation_id,'productReady':False}
    guard_epoch();value=observed()
    elapsed=time.time_ns()//1_000_000-submitted['collectedAtUnixMs']
    if value['guestAgentReady'] and elapsed>PROBE_AFTER_SECONDS*1000:
        # The final step restores the agent only after a failure. Read its
        # bounded record with a fresh read-only probe; nothing is retried.
        probe=str(uuid.uuid4());saved=collect('generalize-probe-'+probe,GENERALIZE_PROBE_TEMPLATE.replace('__PROBE_ID__',probe),None,25)
        if saved is not None:
            report=output(saved,16384);require(type(report)is dict and report.get('nonce')==probe,'instance_generalize_probe')
            if report.get('failure')is not None:
                save('generalize-failed.json',{'operationId':operation_id,'failure':report.get('failure'),'sysprepErrors':report.get('sysprepErrors')})
                return {'state':'generalize-failed','operationId':operation_id,'failure':report.get('failure'),'sysprepErrors':report.get('sysprepErrors'),'productReady':False}
    return {'state':'generalize-running','operationId':operation_id,'guestAgentReady':value['guestAgentReady'],'productReady':False}


def template_evidence_ok(result,setup):
    """True only when a read-only disk-logs result of the stopped template shows a
    successful sysprep run by the final step in the built-in Administrator's
    elevated interactive session, and no fixture or temporary OOBE profile (F3d).

    Capture runs without root, so this gate is evaluated on the root-only
    read-only disk-logs observation taken after the generalized power-off.
    """
    import json,re
    if type(result)is not dict or result.get('state')!='disk-logs-observed' or type(result.get('logs'))is not dict:return False
    files=result['logs'].get('files');presence=result['logs'].get('presence')
    if type(files)is not dict or type(presence)is not dict:return False
    work='Windows/Temp/VpnControlGeneralize/'
    def rows(name):
        value=files.get(name)
        return value.get('tail') if type(value)is dict and type(value.get('tail'))is list else None
    if presence.get('Windows/System32/Sysprep/Sysprep_succeeded.tag')is None or work+'failure.json' not in files or files[work+'failure.json']is not None:return False
    context_rows=rows(work+'final-context.json');transcript=rows(work+'final.log')
    listings=files.get('listings');users=listings.get('Users') if type(listings)is dict else None
    if context_rows is None or transcript is None or type(users)is not list or not users:return False
    try:context=json.loads('\n'.join(context_rows).lstrip('\ufeff'))
    except ValueError:return False
    if type(context)is not dict:return False
    heads=[line.strip() for line in transcript[:24] if re.match(r'\s*(Username|RunAs User):',line.lstrip('\ufeff'))]
    numbers=[context.get(k) for k in ('sessionId','bootUnixMs','setupUnixMs')]
    names=[str(name).rstrip('/@').lower() for name in users];fixtures={setup['user'].lower(),setup['administrator'].lower()}
    return (re.fullmatch(r'S-1-5-21-[0-9]+-[0-9]+-[0-9]+-500',str(context.get('sid')))is not None and context.get('elevated')is True
            and all(type(n)is int for n in numbers) and numbers[0]>0 and numbers[1]>numbers[2]
            and len(heads)==2 and not any(h.upper().endswith('\\SYSTEM') for h in heads)
            and not any(n.startswith('defaultuser') or n in fixtures for n in names))


def capture_image_instance(spec,setup,operation_id,root,read,save,process,birth,binaries):
    """Publish the generalized, stopped disk read-only as one new image."""
    import base64,hashlib,json,os,pathlib,stat,subprocess,time
    def require(value,reason):
        if not value:raise ValueError(reason)
    def identity(s):return [s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
    def run(arguments,timeout=120,limit=1048576):
        fd=binaries['qemu-img']
        p=subprocess.run(['/proc/self/fd/'+str(fd),*arguments],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout,
                         pass_fds=(fd,),env={'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C'})
        require(p.returncode==0 and len(p.stdout)<=limit and not p.stderr,'instance_capture_command');return p.stdout
    stopped=read('generalize-stopped.json');intent=read('generalize-intent.json')
    require(stopped['operationId']==intent['operationId'],'instance_capture_generalize')
    qemu=read('qemu-started.json');tpm=read('swtpm-started.json')
    require(_actor_absent(qemu,process,birth) and _actor_absent(tpm,process,birth),'instance_capture_actor_alive')
    # Only a template that never reached update or store services becomes an image.
    netdev=[qemu['argv'][index+1] for index,value in enumerate(qemu['argv'][:-1]) if value=='-netdev']
    require(netdev==['user,id=net0,restrict=on'],'instance_capture_template_network')
    # Only a template whose recorded setup result armed the Administrator-session
    # sysprep (never SYSTEM, F3d) is published under this schema.
    terminal=read('generalize.terminal.json')
    generalized=json.loads(base64.b64decode(terminal.get('out-data',''),validate=True).decode('utf-8-sig'))
    require(type(generalized)is dict and generalized.get('nonce')==intent['operationId'] and generalized.get('sysprepPrincipal')=='builtin-administrator-interactive'
            and generalized.get('restartScheduled')is True,'instance_capture_sysprep_context')
    # A host stop or a guest-reported failure is never a generalized template.
    require(not os.path.lexists(root/'stop-intent.json') and not os.path.lexists(root/'generalize-failed.json'),'instance_capture_generalize')
    require(not os.path.lexists(root/'capture-intent.json'),'instance_capture_original_exists')
    mutable=read('mutable-artifacts.json');disk=root/'disk.qcow2';firmware=root/'uefi-vars.fd'
    for name in ('disk.qcow2','uefi-vars.fd'):
        s=os.lstat(root/name)
        require(stat.S_ISREG(s.st_mode) and s.st_uid==os.geteuid() and stat.S_IMODE(s.st_mode)==0o600 and s.st_nlink==1
                and [s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid]==mutable[name],'instance_capture_mutable_changed')
    check=json.loads(run(['check','-f','qcow2','--output=json',str(disk)],timeout=50))
    require(type(check)is dict and check.get('check-errors')==0 and not check.get('corruptions') and not check.get('leaks'),'instance_capture_disk_check')
    store=root.parent/STORE_NAME
    if not os.path.lexists(store):os.mkdir(store,0o700)
    s=os.lstat(store);require(stat.S_ISDIR(s.st_mode) and s.st_uid==os.geteuid() and stat.S_IMODE(s.st_mode)==0o700,'instance_capture_store')
    require(s.st_dev==os.lstat(disk).st_dev,'instance_capture_store_filesystem')
    image_id=operation_id;partial=store/('.'+image_id+'.partial');final=store/image_id
    require(not os.path.lexists(final),'instance_capture_image_exists')
    save('capture-intent.json',{'operationId':operation_id,'imageId':image_id,'image':str(final),'diskMovedFrom':str(disk)})
    os.mkdir(partial,0o700)
    os.rename(disk,partial/'disk.qcow2')
    source=os.open(firmware,os.O_RDONLY|os.O_NOFOLLOW);target=os.open(partial/'uefi-vars.fd',os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
    try:
        while True:
            block=os.read(source,1048576)
            if not block:break
            view=memoryview(block)
            while view:view=view[os.write(target,view):]
        os.fsync(target)
    finally:os.close(source);os.close(target)
    info=json.loads(run(['info','--output=json',str(partial/'disk.qcow2')],timeout=30))
    require(info.get('format')=='qcow2' and info.get('virtual-size')==SPEC['diskGiB']*1024**3 and not info.get('backing-filename'),'instance_capture_disk_format')
    tpm_source=root/'tpm'/'tpm2-00.permall';s=os.lstat(tpm_source)
    require(stat.S_ISREG(s.st_mode) and s.st_uid==os.geteuid() and 0<s.st_size<=16*1024**2,'instance_capture_tpm')
    with open(tpm_source,'rb')as stream:tpm_raw=stream.read(16*1024**2+1)
    fd=os.open(partial/'tpm2-00.permall',os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
    try:
        view=memoryview(tpm_raw)
        while view:view=view[os.write(fd,view):]
        os.fsync(fd)
    finally:os.close(fd)
    for name in ('disk.qcow2','uefi-vars.fd','tpm2-00.permall'):os.chmod(partial/name,0o400)
    with open(partial/'uefi-vars.fd','rb')as stream:firmware_raw=stream.read(64*1024**2+1)
    require(0<len(firmware_raw)<=64*1024**2,'instance_capture_firmware')
    installer=read('installer-image.json')
    manifest={'schemaVersion':IMAGE_SCHEMA_VERSION,'kind':'windows-generalized-image','imageId':image_id,'answerHook':'panther-unattend-embedded','createdAtUnixMs':time.time_ns()//1_000_000,
              'hostBootId':CONTEXT['hostBootId'],'source':{'deploymentId':SPEC['deploymentId'],'generalizeOperationId':intent['operationId'],'captureOperationId':operation_id},
              'assets':{name:{'sha256':asset['sha256'],'bytes':asset['bytes']} for name,asset in SPEC['assets'].items()},'diskGiB':SPEC['diskGiB'],
              'setup':{'imageName':SETUP['imageName'],'locale':SETUP['locale']},'installerImage':installer,'os':intent['os'],'templateNetwork':'restricted',
              'sysprepPrincipal':'builtin-administrator-interactive',
              'files':{'disk.qcow2':{'identity':identity(os.lstat(partial/'disk.qcow2')),'format':'qcow2','virtualSize':info['virtual-size']},
                       'uefi-vars.fd':{'identity':identity(os.lstat(partial/'uefi-vars.fd')),'sha256':hashlib.sha256(firmware_raw).hexdigest()},
                       'tpm2-00.permall':{'identity':identity(os.lstat(partial/'tpm2-00.permall')),'sha256':hashlib.sha256(tpm_raw).hexdigest()}}}
    raw=(json.dumps(manifest,sort_keys=True)+'\n').encode()
    fd=os.open(partial/'manifest.json',os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400)
    try:
        view=memoryview(raw)
        while view:view=view[os.write(fd,view):]
        os.fsync(fd)
    finally:os.close(fd)
    os.chmod(partial,0o500);os.rename(partial,final)
    directory=os.open(store,os.O_RDONLY|os.O_DIRECTORY)
    try:os.fsync(directory)
    finally:os.close(directory)
    digest=hashlib.sha256(raw).hexdigest()
    save('capture-result.json',{'operationId':operation_id,'imageId':image_id,'image':str(final),'manifestSha256':digest})
    return {'state':'image-captured','operationId':operation_id,'imageId':image_id,'manifestSha256':digest,'productReady':False}


def read_image(store,image_id,expected_sha256=None):
    """Read one published image manifest and prove its files are unchanged."""
    import hashlib,json,os,stat
    def require(value,reason):
        if not value:raise ValueError(reason)
    def identity(s):return [s.st_ino,s.st_mode,s.st_uid,s.st_gid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
    s=os.lstat(store);require(stat.S_ISDIR(s.st_mode) and s.st_uid==os.geteuid() and stat.S_IMODE(s.st_mode)==0o700,'instance_image_store')
    directory=store/image_id;s=os.lstat(directory)
    require(stat.S_ISDIR(s.st_mode) and s.st_uid==os.geteuid() and stat.S_IMODE(s.st_mode)==0o500,'instance_image_directory')
    require(sorted(os.listdir(directory))==sorted(IMAGE_FILES),'instance_image_directory')
    fd=os.open(directory/'manifest.json',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    try:
        info=os.fstat(fd);require(stat.S_ISREG(info.st_mode) and info.st_uid==os.geteuid() and stat.S_IMODE(info.st_mode)==0o400 and 0<info.st_size<=65536,'instance_image_manifest')
        raw=os.read(fd,65537);require(len(raw)==info.st_size,'instance_image_manifest')
    finally:os.close(fd)
    digest=hashlib.sha256(raw).hexdigest();require(expected_sha256 is None or digest==expected_sha256,'instance_image_manifest_changed')
    manifest=json.loads(raw)
    require(type(manifest)is dict and manifest.get('schemaVersion')==IMAGE_SCHEMA_VERSION and manifest.get('kind')=='windows-generalized-image' and manifest.get('imageId')==image_id
            and type(manifest.get('files'))is dict and set(manifest['files'])==set(IMAGE_FILES)-{'manifest.json'},'instance_image_manifest')
    for name,meta in manifest['files'].items():
        s=os.lstat(directory/name)
        require(stat.S_ISREG(s.st_mode) and stat.S_IMODE(s.st_mode)==0o400 and identity(s)==meta.get('identity'),'instance_image_file_changed')
    return manifest,digest


def images_main():
    """List published images for this host; read-only, no hashing of disks."""
    import json,os,pathlib,uuid
    store=pathlib.Path(SPEC['root']).parent/STORE_NAME;rows=[];refused=0
    if os.path.lexists(store):
        names=sorted(n for n in os.listdir(store) if not n.startswith('.'))
        for name in names[:MAX_IMAGES]:
            try:
                if str(uuid.UUID(name))!=name:raise ValueError('instance_image_name')
                manifest,digest=read_image(store,name)
                rows.append({'imageId':name,'manifestSha256':digest,'manifest':manifest})
            except (OSError,ValueError,KeyError,TypeError):refused+=1
        refused+=max(0,len(names)-MAX_IMAGES)
    print(json.dumps({'schemaVersion':1,'deploymentId':SPEC['deploymentId'],'mode':'images','state':'images-observed','reason':None,
                      'images':rows,'refusedImages':refused,'nativeActionAllowed':False,'replayAllowed':False},separators=(',',':')))


def open_file_identities():
    """(st_dev, st_ino) of every file a visible process holds open (Linux /proc)."""
    import os
    held=set()
    for pid in os.listdir('/proc'):
        if not pid.isdigit():continue
        try:names=os.listdir('/proc/'+pid+'/fd')
        except OSError:continue
        for name in names:
            try:s=os.stat('/proc/'+pid+'/fd/'+name)
            except OSError:continue
            held.add((s.st_dev,s.st_ino))
    return held


def retire_images_main():
    """Delete exact superseded images: never the current schema, never one held open."""
    import json,os,pathlib,stat,uuid
    def require(value,reason):
        if not value:raise ValueError(reason)
    store=pathlib.Path(SPEC['root']).parent/STORE_NAME;retired=[];refused=[]
    s=os.lstat(store);require(stat.S_ISDIR(s.st_mode) and s.st_uid==os.geteuid() and stat.S_IMODE(s.st_mode)==0o700,'instance_image_store')
    held=open_file_identities()
    for image_id in IMAGE_IDS:
        try:
            require(str(uuid.UUID(image_id))==image_id,'instance_image_name')
            directory=store/image_id;d=os.lstat(directory)
            require(stat.S_ISDIR(d.st_mode) and d.st_uid==os.geteuid() and stat.S_IMODE(d.st_mode)==0o500,'instance_image_directory')
            names=sorted(os.listdir(directory));require(set(names)<={'disk.qcow2','manifest.json','uefi-vars.fd','tpm2-00.permall'} and 'manifest.json' in names,'instance_image_directory')
            with open(directory/'manifest.json','rb')as stream:raw=stream.read(65537)
            manifest=json.loads(raw);require(len(raw)<=65536 and manifest.get('imageId')==image_id,'instance_image_manifest')
            require(manifest.get('schemaVersion')!=IMAGE_SCHEMA_VERSION,'instance_image_current_schema')
            size=0
            for name in names:
                f=os.lstat(directory/name);require(stat.S_ISREG(f.st_mode) and f.st_uid==os.geteuid() and f.st_nlink==1,'instance_image_file')
                require((f.st_dev,f.st_ino)not in held,'instance_image_in_use');size+=f.st_size
            os.chmod(directory,0o700)
            for name in names:os.unlink(directory/name)
            os.rmdir(directory);retired.append({'imageId':image_id,'schemaVersion':manifest.get('schemaVersion'),'bytes':size})
        except (OSError,ValueError,KeyError,TypeError) as error:
            refused.append({'imageId':image_id,'reason':str(error) if type(error)is ValueError and str(error).startswith('instance_') else type(error).__name__})
    print(json.dumps({'schemaVersion':1,'deploymentId':SPEC['deploymentId'],'mode':'retire-images','state':'images-retired','reason':None,
                      'retired':retired,'refused':refused,'nativeActionAllowed':False,'replayAllowed':False},separators=(',',':')))


VM_PROCESS_NAMES=('qemu','swtpm','emulator','virtqemud','libvirtd')
# Only guest-running processes block cleanup; libvirt daemons alone do not.
VM_GUEST_PROCESS_NAMES=('qemu','swtpm','emulator')
INVENTORY_DETAIL=('.local','.local/share','.cache','.config','.config/libvirt','.config/libvirt/qemu','.android','.android/avd','libvirt-vms',
                  'vpn-control-fixture-archive-checkpoint50','.vpn-control-linux-package-fixture','.vpn-control-mcp-fixtures','vpn-control-windows-images')


def vm_processes():
    """Visible running VM-related processes (QEMU, TPM, emulator, libvirt)."""
    import os
    rows=[]
    for pid in os.listdir('/proc'):
        if not pid.isdigit():continue
        try:
            with open('/proc/'+pid+'/cmdline','rb')as stream:argv=stream.read(4096).split(b'\0')
        except OSError:continue
        name=os.path.basename(argv[0].decode('utf-8','replace'))
        if any(key in name for key in VM_PROCESS_NAMES):rows.append({'pid':int(pid),'name':name[:64]})
    return rows


def vm_inventory_main():
    """Read-only sizes of every home entry and every disk-like file; no effect."""
    import json,os,stat
    home=str(__import__('pathlib').Path(SPEC['root']).parent)
    def usage(path,limit=200000):
        total=files=0
        s=os.lstat(path)
        if not stat.S_ISDIR(s.st_mode):return s.st_blocks*512,1
        for base,dirs,names in os.walk(path,followlinks=False):
            for name in names:
                try:total+=os.lstat(os.path.join(base,name)).st_blocks*512;files+=1
                except OSError:pass
            if files>limit:break
        return total,files
    entries=[]
    for name in sorted(os.listdir(home))[:512]:
        path=os.path.join(home,name)
        try:s=os.lstat(path);used,files=usage(path)
        except OSError:continue
        entries.append({'path':path,'directory':stat.S_ISDIR(s.st_mode),'bytes':used,'files':files,'uid':s.st_uid})
    disks=[]
    for base,dirs,names in os.walk(home,followlinks=False):
        dirs[:]=[d for d in dirs if d not in ('.cargo','.rustup','go','node_modules','.npm','.git','.gradle','.m2')]
        for name in names:
            if name.endswith(('.qcow2','.img','.raw','.vmdk','.iso','.fd','.permall')) and len(disks)<2048:
                path=os.path.join(base,name)
                try:s=os.lstat(path);disks.append({'path':path,'bytes':s.st_blocks*512,'apparent':s.st_size,'uid':s.st_uid})
                except OSError:pass
    st=os.statvfs(home)
    # Bounded response: the largest entries and disk-like files only.
    entries=sorted(entries,key=lambda e:-e['bytes'])[:80];disks=sorted((d for d in disks if d['bytes']>=256*1024**2),key=lambda d:-d['bytes'])[:150]
    details=[]
    for relative in INVENTORY_DETAIL:
        base=os.path.join(home,relative)
        try:names=sorted(os.listdir(base))[:200]
        except OSError:continue
        rows=[]
        for name in names:
            path=os.path.join(base,name)
            try:used,files=usage(path,limit=100000)
            except OSError:continue
            rows.append({'path':path,'bytes':used,'files':files})
        details.extend(sorted(rows,key=lambda e:-e['bytes'])[:25])
    for row in entries+disks+details:row['path']=row['path'][:240]
    print(json.dumps({'schemaVersion':1,'deploymentId':SPEC['deploymentId'],'mode':'vm-inventory','state':'vm-inventory-observed','reason':None,
                      'inventory':{'home':home,'freeBytes':st.f_bavail*st.f_frsize,'entries':entries,'diskFiles':disks,'details':details,
                                   'names':sorted(os.listdir(home))[:1024],'processes':vm_processes()},
                      'nativeActionAllowed':False,'replayAllowed':False},separators=(',',':')))


def vm_cleanup_main():
    """Delete an exact approved path list under home while no VM process runs."""
    import json,os,shutil,stat
    home=str(__import__('pathlib').Path(SPEC['root']).parent)
    def require(value,reason):
        if not value:raise ValueError(reason)
    running=[row for row in vm_processes() if any(key in row['name'] for key in VM_GUEST_PROCESS_NAMES)];results=[]
    if running:
        print(json.dumps({'schemaVersion':1,'deploymentId':SPEC['deploymentId'],'mode':'vm-cleanup','state':'vm-cleanup-refused','reason':None,
                          'results':[],'processes':running,'nativeActionAllowed':False,'replayAllowed':False},separators=(',',':')));return
    held=open_file_identities()
    def writable(function,path,_):
        os.chmod(os.path.dirname(path),0o700)
        if os.path.isdir(path)and not os.path.islink(path):os.chmod(path,0o700)
        function(path)
    for path in CLEANUP_PATHS:
        try:
            require(os.path.dirname(path).startswith(home) and path!=home and os.path.realpath(path)==path,'instance_cleanup_path')
            require(not any(path==keep or keep.startswith(path+'/') or path.startswith(keep+'/') for keep in CLEANUP_KEEP),'instance_cleanup_keep')
            s=os.lstat(path);require(s.st_uid==os.geteuid(),'instance_cleanup_owner')
            used=0
            if stat.S_ISDIR(s.st_mode):
                for base,dirs,names in os.walk(path,followlinks=False):
                    for name in names:
                        f=os.lstat(os.path.join(base,name));require((f.st_dev,f.st_ino)not in held,'instance_cleanup_in_use');used+=f.st_blocks*512
                os.chmod(path,0o700);shutil.rmtree(path,onerror=writable)
            else:
                require((s.st_dev,s.st_ino)not in held,'instance_cleanup_in_use');used=s.st_blocks*512
                os.chmod(os.path.dirname(path),os.lstat(os.path.dirname(path)).st_mode|0o700);os.unlink(path)
            results.append({'path':path,'state':'deleted','bytes':used})
        except (OSError,ValueError) as error:
            results.append({'path':path,'state':'refused','reason':str(error)[:80] if type(error)is ValueError else type(error).__name__,'bytes':0})
    st=os.statvfs(home)
    print(json.dumps({'schemaVersion':1,'deploymentId':SPEC['deploymentId'],'mode':'vm-cleanup','state':'vm-cleanup-done','reason':None,
                      'results':results,'freeBytes':st.f_bavail*st.f_frsize,'nativeActionAllowed':False,'replayAllowed':False},separators=(',',':')))


DISK_LOG_FILES=('Windows/Panther/UnattendGC/setupact.log','Windows/Panther/UnattendGC/setuperr.log','Windows/Panther/UnattendGC/diagerr.xml',
                'Windows/Panther/setupact.log','Windows/Panther/setuperr.log','Windows/Panther/diagerr.xml',
                'Windows/System32/Sysprep/Panther/setupact.log','Windows/System32/Sysprep/Panther/setuperr.log',
                'Windows/Temp/VpnControlGeneralize/final.log','Windows/Temp/VpnControlGeneralize/failure.json',
                'Windows/Temp/VpnControlGeneralize/setup.json','Windows/Temp/VpnControlGeneralize/final-context.json',
                'ProgramData/VpnControlFixture/setup.log')
DISK_LOG_FULL=('Windows/Panther/UnattendGC/setupact.log','Windows/Temp/VpnControlGeneralize/final.log')
DISK_LOG_REPORTS=('ProgramData/Microsoft/Windows/WER/ReportQueue/*/Report.wer','ProgramData/Microsoft/Windows/WER/ReportArchive/*/Report.wer')
# Binary event logs: only bounded printable UTF-16 strings that look diagnostic.
DISK_LOG_EVENTS=('Windows/System32/winevt/Logs/Microsoft-Windows-Shell-Core%4Operational.evtx','Windows/System32/winevt/Logs/Application.evtx',
                 'Windows/System32/winevt/Logs/Microsoft-Windows-AppXDeploymentServer%4Operational.evtx',
                 'Windows/System32/winevt/Logs/Microsoft-Windows-User Device Registration%4Admin.evtx',
                 'Windows/System32/winevt/Logs/Microsoft-Windows-User Profile Service%4Operational.evtx',
                 'Windows/System32/winevt/Logs/Microsoft-Windows-AppReadiness%4Admin.evtx',
                 'Windows/System32/winevt/Logs/System.evtx')
# Entry names only, never contents: leftover or temporary profiles show here.
DISK_LOG_LISTINGS=('Users',)
# Existence and size only: these may hold answer-file credentials.
DISK_LOG_PRESENCE=('Windows/Panther/Unattend/Unattend.xml','Windows/Panther/unattend.xml','Windows/System32/Sysprep/Sysprep_succeeded.tag')


EVTX_PATTERN=(r'error|fail|0x[0-9a-f]{4,}|exception|CloudExperience|Cxh|OOBE|denied|terminat|\.exe|\.dll|faulting|APPCRASH|BEX|stack'
              r'|defaultuser|\\Users\\|profil|\bTEMP\b|restart|shutdown')


def evtx_records(raw,pattern=EVTX_PATTERN):
    """UTC time, record number and printable strings of each matching event record.

    Standard library only: an EVTX record is '**\\0\\0', its size, record number and
    FILETIME, binary XML, and its size again; strings are UTF-16 runs inside it.
    """
    import datetime,re,struct
    wanted=re.compile(pattern,re.I);rows=[];offset=raw.find(b'**\x00\x00')
    while 0<=offset<=len(raw)-28:
        size=struct.unpack_from('<I',raw,offset+4)[0]
        if 28<=size<=65024 and offset+size<=len(raw) and struct.unpack_from('<I',raw,offset+size-4)[0]==size:
            number,stamp=struct.unpack_from('<QQ',raw,offset+8);seconds=(stamp-116444736000000000)/1e7
            if 1.5e9<seconds<2.2e9:
                strings=[s.decode('utf-16-le','replace') for s in re.findall(rb'(?:[\x20-\x7e]\x00){4,}',raw[offset+24:offset+size-4])]
                if any(wanted.search(s) for s in strings):
                    at=datetime.datetime.fromtimestamp(seconds,datetime.timezone.utc).strftime('%Y-%m-%d %H:%M:%S')
                    rows.append((at+' #'+str(number)+' '+' | '.join(s[:160] for s in strings))[:700])
                offset=raw.find(b'**\x00\x00',offset+size);continue
        offset=raw.find(b'**\x00\x00',offset+4)
    return rows


def list_entries(path,limit=64):
    """Sorted entry names of one real directory: '/' directory, '@' link; never contents."""
    import os
    if not os.path.isdir(path) or os.path.islink(path):return None
    rows=[]
    with os.scandir(path)as entries:
        for entry in entries:
            rows.append(entry.name[:120]+('@' if entry.is_symlink() else '/' if entry.is_dir(follow_symlinks=False) else ''))
    return sorted(rows)[:limit]


def disk_logs_main():
    """Read Windows setup logs from a stopped instance disk; read-only, as root."""
    import json,os,pathlib,re,subprocess,time,uuid
    def require(value,reason):
        if not value:raise ValueError(reason)
    def run(argv,timeout=60):
        return subprocess.run(argv,stdin=subprocess.DEVNULL,capture_output=True,timeout=timeout,env={'PATH':'/usr/bin:/bin:/usr/sbin:/sbin','LANG':'C','LC_ALL':'C'})
    state={'deploymentId':SPEC['deploymentId']}
    try:
        require(os.geteuid()==0,'instance_disk_logs_privilege')
        disk=pathlib.Path(SPEC['root'])/'disk.qcow2';s=os.lstat(disk)
        require(not os.path.islink(disk) and __import__('stat').S_ISREG(s.st_mode),'instance_disk_logs_disk')
        require((s.st_dev,s.st_ino)not in open_file_identities(),'instance_disk_logs_in_use')
        run(['modprobe','nbd','max_part=16'])
        device=None
        for number in range(16):
            try:
                with open('/sys/block/nbd%d/size'%number)as stream:size=stream.read().strip()
            except OSError:continue
            if size=='0' and not os.path.exists('/sys/block/nbd%d/pid'%number):device='/dev/nbd%d'%number;break
        require(device is not None,'instance_disk_logs_nbd')
        mount=pathlib.Path('/run/vc-disk-logs-'+uuid.uuid4().hex);os.mkdir(mount,0o700);connected=mounted=False;files={};presence={}
        try:
            p=run(['qemu-nbd','--read-only','--format=qcow2','--connect='+device,str(disk)]);require(p.returncode==0,'instance_disk_logs_connect');connected=True
            part=device+'p3'
            for _ in range(100):
                if os.path.exists(part):break
                time.sleep(.1)
            if not os.path.exists(part):run(['partprobe',device]);time.sleep(1)
            require(os.path.exists(part),'instance_disk_logs_partition')
            p=run(['mount','-t','ntfs3','-o','ro',part,str(mount)])
            if p.returncode!=0:p=run(['mount','-t','ntfs3','-o','ro,force',part,str(mount)])
            require(p.returncode==0,'instance_disk_logs_mount');mounted=True
            for relative in DISK_LOG_FILES:
                path=mount/relative
                if not path.is_file():files[relative]=None;continue
                size=path.stat().st_size
                with open(path,'rb')as stream:
                    stream.seek(max(0,size-400000));raw=stream.read(400000)
                text=raw.decode('utf-16','replace') if raw[:2]in(b'\xff\xfe',b'\xfe\xff') else raw.decode('utf-8','replace')
                lines=[line[:400] for line in text.splitlines()]
                files[relative]={'bytes':size,'tail':lines[-(4000 if relative in DISK_LOG_FULL else 90):],'errors':[l for l in lines if re.search(r'error|fail|0x8[0-9a-f]{7}',l,re.I)][-150:]}
            for relative in DISK_LOG_EVENTS:
                path=mount/relative
                if not path.is_file():files[relative]=None;continue
                size=path.stat().st_size
                with open(path,'rb')as stream:
                    stream.seek(max(0,size-8*1024**2));raw=stream.read(8*1024**2)
                files[relative]={'bytes':size,'tail':evtx_records(raw)[-300:],'errors':[]}
            reports=[]
            for pattern in DISK_LOG_REPORTS:
                for path in sorted(mount.glob(pattern))[:12]:
                    try:
                        raw=path.read_bytes()[:65536]
                        text=raw.decode('utf-16','replace') if raw[:2]in(b'\xff\xfe',b'\xfe\xff') else raw.decode('utf-8','replace')
                        keys=[line[:200] for line in text.splitlines() if re.match(r'(Sig\[\d+\]\.(Name|Value)|AppName|FriendlyEventName|EventType|EventTime|NsAppName|OriginalFilename)=',line)]
                        reports.append({'path':str(path.relative_to(mount))[:240],'keys':keys[:40]})
                    except OSError:continue
            files['reports']=reports
            listings={}
            for relative in DISK_LOG_LISTINGS:
                path=mount/relative
                listings[relative]=list_entries(path)
            files['listings']=listings
            for relative in DISK_LOG_PRESENCE:
                path=mount/relative;presence[relative]=path.stat().st_size if path.is_file() else None
        finally:
            if mounted:run(['umount',str(mount)])
            if connected:run(['qemu-nbd','--disconnect',device])
            try:os.rmdir(mount)
            except OSError:pass
        state.update(state='disk-logs-observed',logs={'files':files,'presence':presence})
    except (OSError,ValueError,subprocess.SubprocessError) as error:
        state.update(state='disk-logs-refused',logs={'reason':str(error)[:120] if type(error)is ValueError else type(error).__name__})
    print(json.dumps({'schemaVersion':1,'mode':'disk-logs','reason':None,'nativeActionAllowed':False,'replayAllowed':False,**state},separators=(',',':')))


def clone_manifest_matches(manifest,spec,setup,selected_image):
    """Exact equality between an image and the requested fixture."""
    return (type(manifest)is dict
            and manifest.get('assets')=={name:{'sha256':asset['sha256'],'bytes':asset['bytes']} for name,asset in spec['assets'].items()}
            and manifest.get('diskGiB')==spec['diskGiB'] and manifest.get('templateNetwork')=='restricted'
            and manifest.get('sysprepPrincipal')=='builtin-administrator-interactive'
            and manifest.get('setup')=={'imageName':setup['imageName'],'locale':setup['locale']}
            and (selected_image is None or manifest.get('installerImage')=={'installerSha256':spec['assets']['installer']['sha256'],'image':selected_image}))


def choose_image(listing,spec,setup,now_ms):
    """Newest unexpired matching image, or None (then install from scratch)."""
    if type(listing)is not dict or listing.get('state')!='images-observed' or type(listing.get('images'))is not list:raise ValueError('deployment_images_response')
    if type(now_ms)is not int or now_ms<=0:raise ValueError('deployment_images_clock')
    candidates=[]
    for row in listing['images']:
        manifest=row.get('manifest') if type(row)is dict else None
        if type(manifest)is not dict or type(manifest.get('createdAtUnixMs'))is not int:continue
        age=now_ms-manifest['createdAtUnixMs']
        if not 0<=age<=MAX_IMAGE_AGE_MS:continue
        if not clone_manifest_matches(manifest,spec,setup,None):continue
        candidates.append((manifest['createdAtUnixMs'],row['imageId'],row['manifestSha256']))
    if not candidates:return None
    _,image_id,digest=max(candidates)
    return validate_context_image({'imageId':image_id,'manifestSha256':digest})
