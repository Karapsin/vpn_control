  $intent=[Text.UTF8Encoding]::new($false,$true).GetString([Convert]::FromBase64String($observed[$name]))|ConvertFrom-Json
  if(@($m.childStdoutLabels) -ccontains [string]$intent.value.label){
   $raw='child-{0:D4}.stdout.raw' -f [int]$intent.value.child
   if($names -ccontains $raw){$observed[$raw]=Read-Bounded (Join-Path $m.operationRoot $raw) 65536}
