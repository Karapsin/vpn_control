  $r=[ordered]@{schemaVersion=1;state='ordinary-publication-read-directories';operationId=$m.operationId;directoryPins=@($read.ToArray())}
 }elseif($m.action -ceq 'list-tree'){$r=[ordered]@{schemaVersion=1;state='ordinary-tree-listing';operationId=$m.operationId;treeRoot=$m.treeRoot;listing=(Get-TreeListing $m.treeRoot)}
 }elseif($m.action -ceq 'installer-signer'){$r=[ordered]@{schemaVersion=1;state='ordinary-installer-signer';operationId=$m.operationId;signer=(Get-InstallerSigner $m.installerPath)}
 }elseif($m.action -ceq 'msi-properties'){$r=[ordered]@{schemaVersion=1;state='ordinary-msi-properties';operationId=$m.operationId;package=(Get-MsiProperties $m.packagePath)}
 }elseif($m.action -ceq 'msi-registration'){$r=[ordered]@{schemaVersion=1;state='ordinary-msi-registration';operationId=$m.operationId;products=@(Get-MsiRegistration $m.productName)}
