$pins=[Collections.Generic.List[object]]::new();$files=[Collections.Generic.List[object]]::new();$createdPins=[Collections.Generic.List[object]]::new()
function As-Object($value){return ($value|ConvertTo-Json -Compress|ConvertFrom-Json)}
function Read-Hash([IO.Stream]$stream){$stream.Position=0;$h=[Security.Cryptography.SHA256]::Create();try{return ([BitConverter]::ToString($h.ComputeHash($stream))).Replace('-','').ToLowerInvariant()}finally{$h.Dispose()}}
function Get-CreatedPinHash($pin) {
 if(-not $createdPins.Contains($pin) -or -not $pin.stream.CanRead -or $pin.stream.CanWrite -or $pin.stream.SafeFileHandle.IsClosed -or $pin.stream.SafeFileHandle.IsInvalid){throw 'PUB_CREATED_HELD_CAPABILITY'}
 $named=$null
 try{
  $named=[IO.File]::Open($pin.record.path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::ReadWrite)
  foreach($stream in @($pin.stream,$named)){
   foreach($closing in @($false,$true)){
    Assert-NativeIdentity ([OrdinaryNativeFacts]::Identity($stream.SafeFileHandle,$false)) $pin.record.nativeIdentity
    $security=[OrdinaryNativeFacts]::Security($stream.SafeFileHandle)
    if($security[0] -cne $pin.record.security.ownerSid -or $security[1] -cne $pin.record.security.sddl){throw 'TASK_PIN_SECURITY_CHANGED'}
    if(-not $closing -and (Read-Hash $stream) -cne $pin.record.sha256){throw 'TASK_PIN_DIGEST_CHANGED'}
   }
  }
 }finally{if($null -ne $named){$named.Dispose()}}
}
function Assert-Context {
 if(([OrdinaryNativeFacts]::Token() -join '|') -cne ($m.systemToken -join '|')){throw 'PUB_SYSTEM_TOKEN'}
 if([OrdinaryNativeFacts]::BootIdentifier() -cne $m.kernelBootIdentifier){throw 'PUB_KERNEL_BOOT'}
 foreach($pin in $pins){Assert-Pin $pin}
 foreach($pin in $files){[void](Get-PinHash $pin)}
 foreach($pin in $createdPins){[void](Get-CreatedPinHash $pin)}
}
function Hold-Directory([string]$path,$expected) {
 $h=[OrdinaryNativeFacts]::OpenDirectory($path);$pin=@{directory=$true;handle=$h;record=$null};$pins.Add($pin)
 $s=[OrdinaryNativeFacts]::Security($h)
 $record=[pscustomobject]@{path=$path;nativeIdentity=(As-Object ([OrdinaryNativeFacts]::Identity($h,$true)));security=[pscustomobject]@{ownerSid=$s[0];sddl=$s[1]}}
 $pin.record=if($null -eq $expected){$record}else{$expected};Assert-Pin $pin
 return $pin.record
}
function Assert-OwnedAcl([string]$path,[bool]$directory,[int]$userRights) {
 $a=Get-Acl -LiteralPath $path;$rules=@($a.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier]))
 if($a.GetOwner([Security.Principal.SecurityIdentifier]).Value -cne 'S-1-5-18' -or -not $a.AreAccessRulesProtected -or $rules.Count -ne 3){throw 'PUB_OWNED_ACL'}
 $seen=@{};foreach($rule in $rules){
  $sid=$rule.IdentityReference.Value
  if($seen.ContainsKey($sid) -or $rule.AccessControlType -ne 'Allow' -or $rule.IsInherited){throw 'PUB_ACL_RULE'};$seen[$sid]=$true
  $rights=if($sid -ceq 'S-1-5-18' -or $sid -ceq 'S-1-5-32-544'){0x1f01ff}elseif($sid -ceq $m.ordinarySid){$userRights}else{throw 'PUB_ACL_TRUSTEE'}
  $inherit=if($directory){3}else{0}
  if([int]$rule.FileSystemRights -ne $rights -or [int]$rule.InheritanceFlags -ne $inherit -or [int]$rule.PropagationFlags -ne 0){throw 'PUB_ACL_RIGHTS'}
 }
}
function Directory-Sddl([string]$userRights) {return ('O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;'+$userRights+';;;'+$m.ordinarySid+')')}
function File-Sddl {return ('O:SYG:SYD:P(A;;FA;;;SY)(A;;FA;;;BA)(A;;0x1200a9;;;'+$m.ordinarySid+')')}
function Set-OwnedFileAcl([string]$path) {$a=[Security.AccessControl.FileSecurity]::new();$a.SetSecurityDescriptorSddlForm((File-Sddl));[IO.File]::SetAccessControl($path,$a)}
function Assert-OwnedPath([string]$path) {
 if($path -cnotlike ($m.workspace+'\*') -and $path -cnotlike ($m.operationRoot+'\*')){throw 'PUB_TARGET_OUTSIDE_OPERATION_ROOTS'}
}
function New-Endpoint($target) {
 Assert-OwnedPath $target.path
 $writer=$null;$reader=$null;$duplicate=$null
 try{
  $writer=[IO.File]::Open($target.path,[IO.FileMode]::CreateNew,[IO.FileAccess]::ReadWrite,[IO.FileShare]::Read)
  Set-OwnedFileAcl $target.path;$writer.Flush($true)
  $duplicate=[VpnPublisherFile]::ReadOnly($writer.SafeFileHandle);$writer.Dispose();$writer=$null
  $reader=[IO.FileStream]::new($duplicate,[IO.FileAccess]::Read,6144,$false);$duplicate=$null
  if(-not $reader.CanRead -or $reader.CanWrite){throw 'PUB_READONLY_CAPABILITY'}
  $s=[OrdinaryNativeFacts]::Security($reader.SafeFileHandle)
  $record=[pscustomobject]@{path=$target.path;nativeIdentity=(As-Object ([OrdinaryNativeFacts]::Identity($reader.SafeFileHandle,$false)));security=[pscustomobject]@{ownerSid=$s[0];sddl=$s[1]};sha256=(Read-Hash $reader)}
  if($reader.Length -ne 0 -or $record.sha256 -cne 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'){throw 'PUB_EMPTY_ENDPOINT'}
  Assert-OwnedAcl $target.path $false 0x1200a9
  $pin=@{directory=$false;stream=$reader;record=$record};$createdPins.Add($pin);$reader=$null;[void](Get-CreatedPinHash $pin)
  $wr=[VpnPublisherFile]::Refusal($target.path,0x40000000);$dr=[VpnPublisherFile]::Refusal($target.path,0x10000)
  if($wr -ne 32 -or $dr -ne 32){throw 'PUB_ENDPOINT_SHARING'}
  return [ordered]@{schemaVersion=1;state='ordinary-publication-created';operationId=$m.operationId;role=$target.role;filePin=$record;expectedBytes=$target.bytes;expectedSha256=$target.sha256;createNew=$true;heldReadOnly=$true;writeOpenError=$wr;deleteOpenError=$dr}
 }finally{foreach($owned in @($writer,$reader,$duplicate)){if($null -ne $owned){$owned.Dispose()}}}
}
function Verify-Target($target) {
 Assert-OwnedPath $target.path
 $stream=$null;$named=$null
 try{
  $stream=[IO.File]::Open($target.path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
  $actual=As-Object ([OrdinaryNativeFacts]::Identity($stream.SafeFileHandle,$false))
  foreach($key in @('attributes','volumeSerial','fileIndex','links','creationFileTime')){if([string]$actual.$key -cne [string]$target.endpointPin.nativeIdentity.$key){throw 'PUB_ENDPOINT_IDENTITY_CHANGED'}}
  $s=[OrdinaryNativeFacts]::Security($stream.SafeFileHandle)
  if($s[0] -cne $target.endpointPin.security.ownerSid -or $s[1] -cne $target.endpointPin.security.sddl){throw 'PUB_FILE_SECURITY_CHANGED'}
  Assert-OwnedAcl $target.path $false 0x1200a9
  if($stream.Length -ne $target.bytes -or (Read-Hash $stream) -cne $target.sha256){throw 'PUB_FILE_HASH_OR_SIZE'}
  if($target.kind -ceq 'powershell'){
   $stream.Position=0;$bytes=[byte[]]::new($target.bytes);$offset=0
   while($offset -lt $bytes.Length){$n=$stream.Read($bytes,$offset,$bytes.Length-$offset);if($n -le 0){throw 'PUB_SOURCE_SHORT_READ'};$offset+=$n}
   if($bytes.Length -lt 3 -or $bytes[0] -ne 239 -or $bytes[1] -ne 187 -or $bytes[2] -ne 191){throw 'PUB_SOURCE_BOM'}
   $text=[Text.UTF8Encoding]::new($false,$true).GetString($bytes,3,$bytes.Length-3);$tokens=$null;$errors=$null
   [void][Management.Automation.Language.Parser]::ParseInput($text,[ref]$tokens,[ref]$errors);if(@($errors).Count){throw 'PUB_SOURCE_PARSE'}
  }elseif($target.kind -cne 'data'){throw 'PUB_TARGET_KIND'}
  $named=[IO.File]::Open($target.path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
  foreach($file in @($stream,$named)){
   Assert-NativeIdentity ([OrdinaryNativeFacts]::Identity($file.SafeFileHandle,$false)) $actual
   $security=[OrdinaryNativeFacts]::Security($file.SafeFileHandle)
   if($security[0] -cne $target.endpointPin.security.ownerSid -or $security[1] -cne $target.endpointPin.security.sddl){throw 'PUB_NAMED_SECURITY_CHANGED'}
   if((Read-Hash $file) -cne $target.sha256){throw 'PUB_CLOSING_HASH'}
  }
  $record=[pscustomobject]@{path=$target.path;nativeIdentity=$actual;security=$target.endpointPin.security;sha256=$target.sha256}
  return [ordered]@{schemaVersion=1;state='ordinary-publication-verified';operationId=$m.operationId;role=$target.role;filePin=$record;heldPhysicalRead=$true}
 }finally{foreach($owned in @($stream,$named)){if($null -ne $owned){$owned.Dispose()}}}
}
function New-ReadPin([string]$path) {
 $stream=[OrdinaryNativeFacts]::OpenHeld($path);$pin=@{directory=$false;stream=$stream;record=$null};$files.Add($pin)
 $s=[OrdinaryNativeFacts]::Security($stream.SafeFileHandle)
 $pin.record=[pscustomobject]@{path=$path;nativeIdentity=(As-Object ([OrdinaryNativeFacts]::PinIdentity($stream.SafeFileHandle,$path,$false)));security=[pscustomobject]@{ownerSid=$s[0];sddl=$s[1]};sha256=(Read-Hash $stream)}
 [void](Get-PinHash $pin)
 return $pin.record
}
function Assert-ProfileTree([string]$path) {
 # Read-only listings stay inside the ordinary profile: the Python runtime and the installed product.
 if($path -cnotlike ($m.localAppData+'\*') -or $path.Contains('\..') -or $path.EndsWith('\')){throw 'PUB_TREE_ROOT'}
}
function Get-TreeListing([string]$root) {
 Assert-ProfileTree $root
 if(-not [IO.Directory]::Exists($root)){return [ordered]@{present=$false;files=@();directories=@()}}
 $found=[Collections.Generic.List[string]]::new();$folders=[Collections.Generic.List[string]]::new()
 $todo=[Collections.Generic.Stack[IO.DirectoryInfo]]::new();$todo.Push([IO.DirectoryInfo]::new($root))
 while($todo.Count -gt 0){
  $directory=$todo.Pop();if(($directory.Attributes -band [IO.FileAttributes]::ReparsePoint)-ne 0){throw 'PUB_TREE_REPARSE'}
  foreach($item in $directory.GetFileSystemInfos()){
   if(($item.Attributes -band [IO.FileAttributes]::ReparsePoint)-ne 0){throw 'PUB_TREE_REPARSE'}
   $relative=$item.FullName.Substring($root.Length+1).Replace('\','/')
   if($item -is [IO.DirectoryInfo]){$folders.Add($relative);$todo.Push($item)}else{$found.Add($relative)}
   if($found.Count+$folders.Count -gt 8192){throw 'PUB_TREE_BOUND'}
  }
 }
 return [ordered]@{present=$true;files=@($found.ToArray());directories=@($folders.ToArray())}
}
function Get-InstallerSigner([string]$path) {
 Assert-OwnedPath $path
 $pin=New-ReadPin $path;$signature=Get-AuthenticodeSignature -LiteralPath $path -ErrorAction Stop
 $certificate=$null;if($null -ne $signature.SignerCertificate){$h=[Security.Cryptography.SHA256]::Create();try{$certificate=([BitConverter]::ToString($h.ComputeHash($signature.SignerCertificate.RawData))).Replace('-','').ToLowerInvariant()}finally{$h.Dispose()}}
 return [ordered]@{filePin=$pin;status=[string]$signature.Status;subject=$(if($null -eq $signature.SignerCertificate){$null}else{[string]$signature.SignerCertificate.Subject});certificateSha256=$certificate}
}
function Get-MsiProperties([string]$path) {
 # The held read pin is hashed again by Assert-Context after COM has read the same bytes.
 Assert-OwnedPath $path
 $pin=New-ReadPin $path;$installer=New-Object -ComObject WindowsInstaller.Installer;$database=$null;$values=[ordered]@{}
 try{
  $database=$installer.OpenDatabase($path,0)
  foreach($name in @('ProductCode','ProductName','ProductVersion','UpgradeCode')){
   $view=$database.OpenView('SELECT `Value` FROM `Property` WHERE `Property`='+[char]39+$name+[char]39);$view.Execute();$row=$view.Fetch()
   try{if($null -eq $row){$values[$name]=$null}else{$values[$name]=[string]$row.StringData(1);if($null -ne $view.Fetch()){throw 'PUB_MSI_PROPERTY'}}}finally{$view.Close()}
  }
 }finally{if($null -ne $database){[void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($database)};[void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($installer)}
 return [ordered]@{filePin=$pin;properties=$values}
}
function Get-MsiRegistration([string]$name) {
 Add-Type -TypeDefinition @'
using System;using System.Text;using System.Collections.Generic;using System.Runtime.InteropServices;
public static class VpnScenarioMsiRegistration {
 [DllImport("msi.dll",CharSet=CharSet.Unicode,ExactSpelling=true)]static extern uint MsiEnumProductsExW(string product,string user,uint contexts,uint index,StringBuilder code,out uint context,StringBuilder sid,ref uint size);
 [DllImport("msi.dll",CharSet=CharSet.Unicode,ExactSpelling=true)]static extern uint MsiGetProductInfoExW(string product,string user,uint context,string property,StringBuilder value,ref uint size);
 public static string[] Codes(string user,uint context){var found=new List<string>();for(uint index=0;index<4096;index++){var code=new StringBuilder(39);var sid=new StringBuilder(185);uint actual,size=184;uint rc=MsiEnumProductsExW(null,context==4?null:user,context,index,code,out actual,sid,ref size);if(rc==259)return found.ToArray();if(rc!=0||actual!=context)throw new InvalidOperationException("PUB_MSI_ENUM:"+rc);found.Add(code.ToString());}throw new InvalidOperationException("PUB_MSI_ENUM_BOUND");}
 public static string Name(string code,string user,uint context){uint size=1024;var value=new StringBuilder(1025);uint rc=MsiGetProductInfoExW(code,context==4?null:user,context,"ProductName",value,ref size);return rc==0&&size<=1024?value.ToString():null;}
 public static string Info(string code,string user,uint context,string property){uint size=1024;var value=new StringBuilder(1025);uint rc=MsiGetProductInfoExW(code,context==4?null:user,context,property,value,ref size);if(rc!=0||size>1024)throw new InvalidOperationException("PUB_MSI_INFO:"+property+":"+rc);return value.ToString();}
}
'@ -ReferencedAssemblies @('System','System.Core')
 # SYSTEM reads the ordinary user's contexts by explicit SID; the machine context takes none.
 $rows=[Collections.Generic.List[object]]::new()
 foreach($context in @(1,2,4)){
  foreach($code in @([VpnScenarioMsiRegistration]::Codes($m.ordinarySid,[uint32]$context))){
   if([VpnScenarioMsiRegistration]::Name($code,$m.ordinarySid,[uint32]$context) -cne $name){continue}
   $rows.Add([ordered]@{productCode=$code;context=$context;productName=$name;version=[VpnScenarioMsiRegistration]::Info($code,$m.ordinarySid,[uint32]$context,'VersionString');installLocation=[VpnScenarioMsiRegistration]::Info($code,$m.ordinarySid,[uint32]$context,'InstallLocation')})
   if($rows.Count -gt 8){throw 'PUB_MSI_ROWS'}
  }
 }
 return @($rows.ToArray())
}
function New-EvidenceZip([int]$number) {
 # Closed top-level names only: this listing never enters a folder, and
 # ReadWrite+Delete sharing leaves a parked owner's live files alone.
 Add-Type -AssemblyName System.IO.Compression
 $allowed='\A@@EVIDENCE_NAME@@\z'
 $path=Join-Path $m.workspace ('evidence-'+$number+'.zip');$count=0
 $output=[IO.File]::Open($path,[IO.FileMode]::CreateNew,[IO.FileAccess]::ReadWrite,[IO.FileShare]::Read)
 try{
  $zip=[IO.Compression.ZipArchive]::new($output,[IO.Compression.ZipArchiveMode]::Create,$true)
  try{
   foreach($item in @(Get-ChildItem -LiteralPath $m.operationRoot -File -Force|Sort-Object Name)){
    if($item.Name -cnotmatch $allowed){continue}
    if($count -ge 8192){throw 'PUB_EVIDENCE_COUNT'}
    $source=[IO.File]::Open($item.FullName,[IO.FileMode]::Open,[IO.FileAccess]::Read,([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete))
    try{
     $entry=$zip.CreateEntry($item.Name);$sink=$entry.Open()
     try{$source.CopyTo($sink)}finally{$sink.Dispose()}
     $count++
    }finally{$source.Dispose()}
   }
  }finally{$zip.Dispose()}
  $output.Flush($true);$zipHash=Read-Hash $output;$zipBytes=$output.Length
 }finally{$output.Dispose()}
 return [ordered]@{schemaVersion=1;state='ordinary-evidence-zip';operationId=$m.operationId;zipPath=$path;zipBytes=$zipBytes;zipSha256=$zipHash;entries=$count}
}
$r=$null
try{
 Assert-Context
 foreach($record in @($m.directoryPins)){[void](Hold-Directory $record.path $record)}
 Assert-Context
 if($m.action -ceq 'initialize'){
  foreach($path in @($m.existingDirectories)){[void](Hold-Directory $path $null)}
  Assert-Context
  foreach($path in @($m.workspace,$m.operationRoot)){if(Test-Path -LiteralPath $path){throw 'PUB_ROOT_EXISTS'}}
  [VpnCreateArtifactDirectory]::CreateExclusive($m.workspace,(Directory-Sddl '0x1200a9'))
  [void](Hold-Directory $m.workspace $null);Assert-OwnedAcl $m.workspace $true 0x1200a9
  foreach($name in @($m.subfolders)){
   if($name -cnotmatch '\A[A-Za-z0-9_-]{1,64}\z'){throw 'PUB_SUBFOLDER_NAME'}
   $folder=Join-Path $m.workspace $name
   [VpnCreateArtifactDirectory]::CreateExclusive($folder,(Directory-Sddl '0x1200a9'))
   [void](Hold-Directory $folder $null);Assert-OwnedAcl $folder $true 0x1200a9
  }
  [VpnCreateArtifactDirectory]::CreateExclusive($m.operationRoot,(Directory-Sddl '0x1301bf'))
  [void](Hold-Directory $m.operationRoot $null);Assert-OwnedAcl $m.operationRoot $true 0x1301bf
  $r=[ordered]@{schemaVersion=1;state='ordinary-publication-initialized';operationId=$m.operationId;workspace=$m.workspace;operationRoot=$m.operationRoot;createNew=$true;directoryPins=@($pins|ForEach-Object {$_.record})}
 }elseif($m.action -ceq 'endpoints'){
