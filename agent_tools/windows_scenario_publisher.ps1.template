 [Console]::WriteLine(($r|ConvertTo-Json -Depth 8 -Compress))
}finally{foreach($pin in $createdPins){$pin.stream.Dispose()};foreach($pin in $files){$pin.stream.Dispose()};foreach($pin in $pins){$pin.handle.Dispose()}}
